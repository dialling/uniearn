<view class="flow-page requests-page"><view class="orders-header"><view class="flow-title">My orders</view><view class="flow-sub">{{tab==='running'?'Jobs you took for other students':'Things you asked other students to bring'}}</view><view class="service-tabs"><button class="service-tab {{tab==='requested'?'active':''}}" data-value="requested" bindtap="switchTab">I requested {{requestedCount}}</button><button class="service-tab {{tab==='running'?'active':''}}" data-value="running" bindtap="switchTab">I’m running {{running.length}}</button></view></view><view class="orders-content">
<block wx:if="{{tab==='running'}}"><view wx:if="{{running.length}}" class="section">Running now</view><view wx:for="{{running}}" wx:key="id" class="flow-card running-card" data-id="{{item.id}}" bindtap="trip"><view class="row"><view><text class="badge {{item.category}}">{{item.type}}</text><view class="route">{{item.route}}</view></view><text class="value">¥{{item.total}}</text></view><view class="open-job">Open the job ›</view></view><view wx:if="{{!running.length && !runningPast.length}}" class="orders-empty runner-empty"><view class="runner-empty-icon"><image src="/assets/box-outline.svg" mode="aspectFit"/></view><view class="empty-title">You haven’t run any jobs</view><view class="hint">Bring other students’ takeaway or parcels when you’re going that way anyway, and earn the price shown on each job.</view><button class="btn find-job" bindtap="findJob">Find a job</button></view><view wx:elif="{{!running.length}}" class="hint center">No jobs running right now. Your completed trips are below.</view><view wx:if="{{runningPast.length}}" class="section">Completed trips</view><view wx:for="{{runningPast}}" wx:key="id" class="flow-card" data-id="{{item.id}}" bindtap="trip"><view class="row strong"><text>{{item.route}}</text><text>¥{{item.total}}</text></view><view class="hint">Completed · view details ›</view></view></block>
<block wx:else><block wx:if="{{!hasRequests}}"><view class="orders-empty"><image src="/assets/yuni-party.png" mode="aspectFit"/><view class="empty-title">No orders yet</view><view class="hint">When you post one, you’ll follow it here step by step: posted, taken, picked up, delivered. Finished orders keep their receipt.</view></view><view class="post-entry takeaway-entry" bindtap="post"><text class="badge takeout">Takeaway</text><text class="strong">Bring my takeaway</text><text class="entry-price">¥4 a bag</text></view><view class="post-entry" bindtap="parcelPost"><text class="badge parcel">Parcel</text><text class="strong">Bring my parcel</text><text class="entry-price">from ¥3 a box</text></view><view class="post-entry" bindtap="taskPost"><text class="badge task">Task</text><text class="strong">Post any task</text><text class="entry-price">your price</text></view></block>
<block wx:else><view wx:if="{{active.length}}" class="section">Active</view><view wx:for="{{active}}" wx:key="id" class="flow-card order-card" data-id="{{item.id}}" bindtap="open"><view class="row"><text class="strong status-{{item.status}}">○ {{item.statusLabel}}</text><text class="hint">Posted {{item.createdTime}}</text></view><view class="order-route"><text class="badge {{item.category}}">{{item.category==='task'?'Task':item.category==='takeout'?'Takeaway':'Parcel'}}</text><text class="strong">{{item.category==='task'?item.title:item.station+' → '+item.dorm}}</text></view><view class="progress-strip"><view wx:for="{{item.progress}}" wx:for-item="step" wx:key="label" class="{{step.done?'complete':''}}">{{step.label}}</view></view><view class="row hint"><text>{{item.boxes}} {{item.unit}}<text wx:if="{{item.category==='takeout'}}"> · food arrives {{item.arrivalTime}}</text></text><text class="value">¥{{item.total}}</text></view></view><view class="section row"><text>Past</text><text class="hint">Tap ↻ to post again</text></view><view class="final-tabs"><text wx:for="{{filters}}" wx:key="*this" class="{{pastFilter===item?'active':''}}" data-value="{{item}}" bindtap="filter">{{item}}</text></view><view class="flow-card" wx:if="{{past.length}}"><view wx:for="{{past}}" wx:key="id" class="timeline"><view data-id="{{item.id}}" bindtap="open"><view class="strong">{{item.category==='task'?item.title:item.sizeLabel+' → '+item.dorm}}</view><view class="hint">{{item.boxes}} {{item.unit}} · {{item.statusLabel}}</view></view><view><view class="strong">¥{{item.status==='cancelled'||item.status==='refunded'?'0.00':item.total}}</view><text class="link" data-id="{{item.id}}" data-category="{{item.category}}" bindtap="repeat">↻ Post again</text></view></view></view></block></block></view><app-nav active="requests"/></view><yuni-assistant topic=""/>
<view class="v8-page" wx:if="{{request}}"><view class="flow-card center"><view class="big-check">✓</view><view class="flow-title">{{request.category==='takeout'?'Posted':'Parcel added'}}</view><view class="hint">{{request.category==='takeout'?'Your request is on the job board.':'In the queue at '+request.station}}</view></view><view class="flow-card"><view class="row"><text>Route</text><text class="strong">{{request.station}} → {{request.dorm}}</text></view><view class="row hint" wx:if="{{request.category==='takeout'}}"><text>Food arrives</text><text class="strong">{{request.arrivalLabel}}</text></view><view class="row hint"><text>{{request.category==='takeout'?'Bags':'Parcels'}}</text><text>{{request.boxes}}</text></view><view class="row hint"><text>{{request.category==='takeout'?'Order closes':'Deliver by'}}</text><text>{{request.closeTime==='—'?request.deadline:request.closeTime}}</text></view><view class="divider"/><view class="row strong"><text>Test total</text><text>¥{{request.total}}</text></view></view><button wx:if="{{request.category==='takeout'}}" class="btn orange" bindtap="track">Track my order</button><block wx:else><view wx:if="{{stage==='choice'}}" class="flow-card"><view class="hint">{{otherCount}} other requests at {{request.station}} for {{request.dorm}}</view><view class="flow-title">Getting it yourself?</view><view class="hint">Bring others’ parcels back too. Your own request is cancelled when you start the trip.</view><view class="strong">Up to ¥{{otherReward}} waiting on this route</view><button class="btn" bindtap="go">Yes, I’m going now</button><button class="btn outline" bindtap="notNow">Not this time</button></view><block wx:else><view class="flow-card"><view class="strong">Keep me updated</view><view class="menu-row"><text>When someone takes my parcel</text><switch color="#31584f" checked="{{notifications.orderUpdates!==false}}" data-key="orderUpdates" bindchange="preference"/></view><view class="menu-row"><text>And again when it’s delivered</text><switch color="#31584f" checked="{{notifications.deliveredUpdates!==false}}" data-key="deliveredUpdates" bindchange="preference"/></view><view class="menu-row"><text>When a runner is on this route</text><switch color="#31584f" checked="{{notifications.nearbyTrip}}" data-key="nearbyTrip" bindchange="preference"/></view><view class="hint">In-app preferences. WeChat subscription delivery requires an approved message template.</view></view><button class="btn orange" bindtap="done">Done</button></block></block></view><app-nav active="requests"/><yuni-assistant topic=""/>
<view class="flow-page"><view class="flow-title">Job progress</view><view class="flow-sub">Public progress · no personal details</view><view wx:if="{{job}}" class="flow-card"><view class="route">{{job.label}}</view><view class="row"><text class="badge green">{{job.status==='confirmed'?'Completed':job.status==='delivered'?'Delivered':job.status==='collected'?'On the way':'Taken'}}</text><text class="money">¥{{job.rewardText}}</text></view><view wx:for="{{steps}}" wx:key="name" class="timeline"><text>{{item.done?'●':'○'}}</text><text>{{item.name}}</text><text>{{item.at}}</text></view><view class="hint">Photos, names, rooms and phone numbers are private to the order participants.</view></view><view wx:else class="flow-card empty">This job is no longer available.</view><button class="btn" bindtap="jobs">See open jobs</button></view><yuni-assistant topic=""/>
<view class="sms-page">
 <view class="heading">{{heading}}</view>
 <view class="intro">{{mode==='sms'?'Choose a screenshot of your pickup messages.':'Upload the full screenshot. Review the pickup point and select your parcels.'}}</view>
 <view class="actions"><button disabled="{{busy}}" data-source="album" bindtap="capture">Choose screenshot</button></view>
 <view wx:if="{{busy}}" class="note">Reading messages…</view>
 <view wx:if="{{error}}" class="error">{{error}}</view>
 <view wx:if="{{note}}" class="note">{{note}} You can select, deselect and edit codes.</view>
 <view wx:if="{{candidates.length}}" class="row"><text class="strong">{{selectedCount}} selected</text><text>Maximum 5 per request</text></view>
 <view wx:for="{{candidates}}" wx:key="id" class="candidate {{item.selected?'selected':''}}">
  <view class="row"><view class="pick" data-i="{{index}}" bindtap="toggle"><text class="box">{{item.selected?'☑':'☐'}}</text><text>{{item.label}}</text></view></view>
  <input value="{{item.code}}" data-i="{{index}}" bindinput="editCode" placeholder="Pickup code" maxlength="40"/>
  <view class="point">{{item.point || 'Pickup point unclear'}}</view>
 </view>
 <view wx:if="{{candidates.length}}" class="paste-box"><view>Pickup point</view><input value="{{pickupPoint}}" data-field="pickupPoint" bindinput="field" placeholder="Confirm the station or shop"/><view>Address (optional)</view><input value="{{pickupAddress}}" data-field="pickupAddress" bindinput="field" placeholder="Add any address details"/></view>
 <button class="confirm" bindtap="confirm" disabled="{{busy || !selectedCount || selectedCount > 5}}">Use {{selectedCount}} codes</button>
 <view class="intro">This replaces the codes currently in your request. Check the parcel sizes after confirming.</view>
</view>
<yuni-assistant topic=""/>
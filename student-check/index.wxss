.auth-steps{display:flex;gap:12rpx;margin-top:25rpx;font-size:22rpx;font-weight:700;color:#41775b}.auth-steps view{flex:1;border-top:8rpx solid #41775b;padding-top:12rpx}.auth-steps view+view{border-color:#e3e1d9;color:#888}.auth-steps .active{border-color:#41775b;color:#41775b}.auth-methods{display:flex;gap:16rpx}.auth-methods .flow-card{flex:1;min-width:0;padding:20rpx}.method-active{border:2rpx solid #41775b;background:#f4f8f6}.email-row{display:flex;align-items:center;gap:10rpx}.email-row input{flex:1;min-width:0;font-family:monospace}.email-row text{font-family:monospace;font-size:21rpx;flex:none}.rule-card{display:flex;gap:18rpx}.rule-check{font-size:35rpx;color:#41775b}.all-rules{border:2rpx solid #41775b;color:#41775b;font-weight:800}.all-checked{background:#41775b;color:white}.checked-rule{background:#f4f8f6;border-color:#b8cfc3}
.student-check-page.success-page{padding-bottom:250rpx}.success-actions{position:fixed;left:0;right:0;bottom:0;z-index:20;background:#fff;border-top:1rpx solid #e6e4dc;padding:18rpx 30rpx calc(20rpx + env(safe-area-inset-bottom));box-shadow:0 -6rpx 24rpx #0000000d}.success-actions .btn{display:block;width:100%;margin:0 auto 14rpx}.success-actions .btn:last-child{margin-bottom:0}.success-actions .primary-action{min-height:92rpx}

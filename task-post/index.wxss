@import "../../utils/flow.wxss";
.task-post-page{padding:0 0 230rpx}.task-header{background:#fff;padding:28rpx 38rpx 18rpx}.task-header .flow-title{margin:0}.task-header .flow-sub{margin:6rpx 0 0}.task-content{padding:12rpx 38rpx}.task-post-page .flow-card{padding:26rpx;border-radius:26rpx}.task-post-page .step{background:#3e4ad8;border:2rpx solid #555652;width:46rpx;min-width:46rpx;height:46rpx;line-height:42rpx;border-radius:10rpx}.task-post-page .flow-head{font-size:28rpx}.task-copy{min-height:130rpx;font-size:26rpx}.task-post-page .pill{font-size:22rpx;padding:17rpx 21rpx}.example-label{font-weight:700;color:#62645c}.photo-entry{display:flex;align-items:center;gap:11rpx;background:#f6f6f2;border-color:#d8d6cc;padding:24rpx;font-weight:700;color:#55564e}.photo-entry image{width:30rpx;height:30rpx}.photo-entry .hint{font-weight:400;margin:0}.deadline-inputs>view:first-child{flex:1.5}.deadline-inputs .field-label{margin-top:0;color:#62645c;font-size:22rpx}.deadline-inputs .field{display:flex;justify-content:space-between;padding:20rpx;font-size:25rpx;min-height:78rpx}.deadline-summary{background:#e8edff;color:#3543c7;padding:23rpx;border-radius:18rpx;font-weight:700;font-size:24rpx;line-height:1.45}.time-shortcuts{gap:10rpx;flex-wrap:wrap}.minimum{margin-left:auto;background:#f0f0ec;border-radius:13rpx;padding:7rpx 14rpx;white-space:nowrap;font-size:18rpx;color:#606158}.price-control{display:flex;align-items:center;justify-content:space-between;margin:35rpx 0 0}.price-control button{display:flex;align-items:center;justify-content:center;flex:0 0 85rpx;width:85rpx;min-width:85rpx;height:85rpx;min-height:85rpx;border-radius:50%;background:#f0efea;margin:0;padding:0;line-height:1;font-size:36rpx;color:#191b1d}.price-entry{display:flex;align-items:center;justify-content:center;gap:12rpx}.price-entry>text{font-size:25rpx;font-weight:750;color:#939087}.task-price{height:70rpx;width:180rpx;border:0;border-bottom:3rpx dashed #dedbd0;font-size:60rpx;font-weight:800;text-align:center;padding:0;background:transparent;line-height:1.2}.price-help{font-size:20rpx;margin:10rpx 0 30rpx}.price-presets{justify-content:center}.task-post-page .pill.selected{background:#3e4ad8;border-color:#3e4ad8;color:#fff}.total-card .total-line{margin:25rpx 0;font-size:30rpx}.task-bottom{padding:22rpx 38rpx calc(22rpx + env(safe-area-inset-bottom));z-index:20}.task-bottom .check{border-radius:3rpx;flex:none}.task-bottom .check.checked{background:#3e4ad8;border-color:#3e4ad8}.task-post-page .link{color:#3e4ad8}.task-bottom .btn{background:#3e4ad8;border-radius:23rpx;width:100%;margin:16rpx 0 0}.task-bottom .btn[disabled]{background:#e4e2db;color:#99988f}.task-bottom .agreement-row{font-size:21rpx;line-height:1.5;align-items:center;margin:0}

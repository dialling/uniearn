<view class="flow-page task-post-page"><view class="task-header"><view class="flow-title">Post a task</view><view class="flow-sub">Anything another student can help with</view></view><view class="task-content"><yuni-tip tip-key="task-post" pose="think" text="Say what ‘done’ looks like, like ‘a photo of the return slip’. Clear tasks get taken faster."/>
<view class="flow-card"><view class="flow-head"><text class="step">1</text><text>What do you need?</text></view><textarea class="field task-copy" value="{{title}}" data-field="title" bindinput="text" maxlength="4000" auto-height placeholder="e.g. Return 2 books to the library before it closes"/><view class="hint task-location-hint">Include where to go or meet in your task description.</view><view class="hint example-label">Or start from an example</view><view class="pills"><text wx:for="{{examples}}" wx:key="*this" class="pill" data-value="{{item}}" bindtap="example">{{item}}</text></view><view class="dash photo-entry" bindtap="handlePhoto"><image src="/assets/photo.svg"/><text>{{photo?'1 photo added · replace':'Add a photo'}}</text><text class="hint" wx:if="{{!photo}}">· optional</text></view><image wx:if="{{photo}}" class="thumb" src="{{photo}}" mode="aspectFill"/><text wx:if="{{photo}}" class="link" bindtap="remove">Remove</text></view>
<view class="flow-card"><view class="flow-head"><text class="step">2</text><text>Done by</text></view><view class="two-cols deadline-inputs"><view><view class="field-label">Date</view><picker mode="date" value="{{date}}" start="{{today}}" bindchange="handleDate"><view class="field">{{date}}<text>▣</text></view></picker></view><view><view class="field-label">Time</view><picker mode="time" value="{{time}}" bindchange="handleTime"><view class="field">{{time}}<text>◷</text></view></picker></view></view><view class="deadline-summary">◷　{{dueLabel}}</view><view class="pills time-shortcuts"><text class="pill" data-value="hour" bindtap="shortcut">In 1 hour</text><text class="pill" data-value="tonight" bindtap="shortcut">Tonight 21:00</text><text class="pill" data-value="tomorrow" bindtap="shortcut">Tomorrow 12:00</text></view><view class="hint">If nobody takes it by then, the task closes with a full simulated refund.</view></view>
<view class="flow-card"><view class="flow-head"><text class="step">3</text><text>Your price</text><text class="minimum">Minimum ¥3</text></view><view class="price-control"><button data-delta="-1" bindtap="changePrice">−</button><view class="price-entry"><text>¥</text><input class="task-price" type="digit" value="{{priceText}}" bindinput="priceInput" bindblur="priceBlur" maxlength="9"/></view><button data-delta="1" bindtap="changePrice">＋</button></view><view class="hint center price-help">Tap the number to type any price</view><view class="pills price-presets"><text wx:for="{{prices}}" wx:key="*this" class="pill {{price===item?'selected':''}}" data-value="{{item}}" bindtap="handlePrice">¥{{item}}</text></view><view class="hint center">{{trusted?'Above ¥10, Trusted or Top runners can take it.':'Any runner can take it. Higher prices get taken faster.'}}</view></view>
<view class="flow-card total-card"><view class="row hint"><text>Your price</text><text class="strong">¥{{priceLabel}}</text></view><view class="row hint"><text>Service fee · ¥0.50 per task</text><text class="strong">¥0.50</text></view><view class="hint">The service fee supports payment processing and running Uniearn, while runners keep 100% of your price.</view><view class="divider"/><view class="row total-line"><text>Total</text><text>¥{{total}}</text></view><view class="green-note">♙　Team test · no real payment is taken. Cancel for free until a runner takes it.</view></view></view>
<view class="flow-bottom task-bottom"><view class="agreement-row" bindtap="agree"><text class="check {{agreed?'checked':''}}">{{agreed?'✓':''}}</text><view>I agree to the <text class="link" catchtap="rules">platform rules and user agreement</text>.</view></view><button class="btn" disabled="{{!agreed||busy||!validTitle||!validDeadline||!validPrice}}" loading="{{busy}}" bindtap="post">{{postLabel}}</button></view></view><yuni-assistant topic=""/>

/* Flexible bilingual text; business amounts and native font scaling stay unchanged. */
page{font-family:-apple-system,BlinkMacSystemFont,"PingFang SC","Microsoft YaHei",sans-serif}
button{white-space:normal;word-break:normal;overflow-wrap:break-word;line-height:1.5}
.hint,.muted,.field-label,.notice-error,.rule-copy,.menu-copy{overflow-wrap:break-word;line-height:1.6}
.pills{flex-wrap:wrap}.pill{white-space:normal;line-height:1.5}


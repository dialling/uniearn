@import "utils/v8.wxss";
@import "utils/final.wxss";
page{background:#f7f7f4;color:#202126;font-family:-apple-system,BlinkMacSystemFont,"Helvetica Neue",sans-serif;font-size:29rpx}view,text,input,textarea,button{box-sizing:border-box}button{font-size:29rpx;border-radius:23rpx}button::after{border:0}.page{min-height:100vh;padding:34rpx 34rpx 160rpx}.page.navpage{padding-bottom:175rpx}.title{font-size:44rpx;font-weight:800;margin:14rpx 0 5rpx}.subtitle{font-size:25rpx;color:#777;margin-bottom:28rpx}.section{font-size:26rpx;font-weight:750;margin:34rpx 0 18rpx}.card{background:white;border-radius:24rpx;padding:27rpx;margin-bottom:18rpx}.row{display:flex;align-items:center;justify-content:space-between;gap:15rpx}.muted{color:#858681;font-size:24rpx}.tiny{color:#858681;font-size:22rpx}.strong{font-weight:750}.route{font-size:33rpx;font-weight:800;margin:17rpx 0}.money{font-family:monospace;font-weight:800;color:#41775b;font-size:35rpx}.btn{background:#41775b;color:white;font-weight:700;margin:16rpx 0}.btn.light{background:#eff6f4;color:#41775b}.btn.outline{background:white;color:#a65737;border:1rpx solid #ddd}.btn.orange{background:#ad5a35}.btn.disabled{background:#e6e4df;color:#888}.chip{padding:10rpx 18rpx;background:#f0f1ed;border-radius:40rpx;font-size:23rpx}.chip.green{background:#e8f3f0;color:#41775b}.chip.orange{background:#fbefe9;color:#a65737}.field{background:#fff;border:1rpx solid #e7e7e2;border-radius:18rpx;padding:22rpx;margin:12rpx 0;min-height:84rpx}.field-label{font-size:24rpx;font-weight:750;margin-top:18rpx}.bottom{position:fixed;bottom:0;left:0;right:0;background:white;padding:14rpx 34rpx calc(16rpx + env(safe-area-inset-bottom));box-shadow:0 -4rpx 20rpx #0000000d}.bottom button{margin:0}.link{color:#ad5b38}.divider{height:1rpx;background:#eee;margin:16rpx 0}.banner{background:#41775b;color:white;border-radius:24rpx;padding:30rpx;margin:16rpx 0}.empty{text-align:center;color:#81857f;padding:75rpx 30rpx}

.service-tabs{display:flex;background:#eceee9;border-radius:22rpx;padding:6rpx;margin:22rpx 0;gap:6rpx}.service-tab{flex:1;margin:0;background:transparent;color:#777;font-weight:700;line-height:2.8;border-radius:18rpx}.service-tab.active{background:#41775b;color:white}.create-page .service-tab.active{background:#ad5a35}.service-tab[disabled]{opacity:.65}.service-tab.active[disabled]{color:white}

.half{width:49%}.notice-error{background:#fff0e7;color:#934c2b;padding:22rpx;border-radius:18rpx;margin:18rpx 0;line-height:1.5}.btn{background:#41775b}.btn.orange{background:#ad5a35}

page{background:#eeede8}.btn{background:#41775b}.btn.orange{background:#ad5a35}

/* Flexible bilingual text; business amounts and native font scaling stay unchanged. */
page{font-family:-apple-system,BlinkMacSystemFont,"PingFang SC","Microsoft YaHei",sans-serif}
button{white-space:normal;word-break:normal;overflow-wrap:break-word;line-height:1.5}
.hint,.muted,.field-label,.notice-error,.rule-copy,.menu-copy{overflow-wrap:break-word;line-height:1.6}
.pills{flex-wrap:wrap}.pill{white-space:normal;line-height:1.5}

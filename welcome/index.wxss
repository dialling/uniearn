@import "../../utils/flow.wxss";
.welcome{min-height:100vh;padding:45rpx 40rpx 45rpx;background:white;display:flex;flex-direction:column}.brand{display:flex;align-items:center;gap:22rpx;font-size:40rpx;font-weight:800}.logo{background:#41775b;color:white;width:73rpx;height:73rpx;border-radius:22rpx;text-align:center;line-height:73rpx;font-size:49rpx;position:relative}.logo text{font-size:13rpx;color:#d6b770;position:absolute;right:19rpx;top:-10rpx}.green-word{color:#41775b}.welcome-yuni{display:flex;align-items:center;gap:24rpx;margin:38rpx 0 20rpx}.welcome-yuni image{width:160rpx;height:180rpx;flex:none}.hello{background:#e8f3ed;border:1rpx solid #d2e5d9;border-radius:28rpx;padding:22rpx;font-size:27rpx;line-height:1.6}.yuni-name{color:#41775b;font-weight:700;font-size:22rpx}.headline{font-size:47rpx;font-weight:800;line-height:1.2;margin:16rpx 0}.intro{font-size:28rpx;line-height:1.7;color:#555850;margin-bottom:26rpx}.feature{display:flex;align-items:center;gap:22rpx;background:#f5f5f2;border-radius:24rpx;padding:22rpx 26rpx;margin-bottom:18rpx}.feature-icon{width:64rpx;height:70rpx;border-radius:18rpx;text-align:center;line-height:70rpx;font-size:36rpx;flex:none}.orange{background:#fcf1e6;color:#ad5a35}.gold{background:#f6f0df;color:#897132}.green{background:#e8f3ed;color:#41775b}.welcome-footer{margin-top:auto;padding-top:60rpx}.manual-link{text-align:center;font-size:22rpx;color:#777;padding:12rpx} 
.welcome{box-sizing:border-box}.welcome-header{display:flex;align-items:center;justify-content:space-between;gap:20rpx}.language-switch{flex:none;margin:0;background:#f3f5f1;border-radius:32rpx;padding:10rpx 24rpx;line-height:1.6;color:#41775b;font-size:24rpx;font-weight:650}.language-switch::after{border:0}.welcome-enter{width:100%;min-height:96rpx;display:flex;align-items:center;justify-content:center;white-space:nowrap}

.welcome-header{position:relative;min-height:62rpx;padding-right:140rpx}.welcome-header .language-switch{position:absolute;right:0;top:0;display:inline-flex;align-items:center;justify-content:center;width:120rpx;min-width:0;max-width:120rpx;height:54rpx;min-height:0;margin:0;padding:0;flex:0 0 120rpx;font-size:22rpx;line-height:54rpx;border-radius:28rpx;white-space:nowrap}

.welcome-agreement{text-align:center;color:#85857d;font-size:22rpx;line-height:1.6;margin-top:24rpx}.welcome-agreement .link{text-decoration:underline}

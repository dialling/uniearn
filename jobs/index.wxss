@import "../../utils/flow.wxss";
.jobs-page{padding:0 0 160rpx;background:#eeede8}.jobs-header{background:#fff;padding:28rpx 42rpx 18rpx}.jobs-header .flow-title{margin:0;font-size:38rpx}.jobs-header .flow-sub{margin:6rpx 0 0}.filter-trigger{display:flex;align-items:center;gap:10rpx;border:1rpx solid #deddd8;border-radius:50rpx;padding:14rpx 25rpx;white-space:nowrap;font-size:26rpx;color:#202126}.filter-trigger.open{border-color:#202126}.filter-icon{font-size:35rpx;line-height:25rpx;transform:rotate(180deg)}.filter-panel{margin-top:26rpx}.filter-row{display:flex;align-items:center;min-width:0;gap:14rpx;margin:12rpx 0}.filter-name{width:77rpx;flex:none;font-size:23rpx;font-weight:750;color:#474742}.filter-row .scroll-pills{flex:1;width:0;margin:0}.filter-row .pill{font-size:23rpx;padding:13rpx 20rpx}.clear-filter{text-align:right;font-size:23rpx;margin:10rpx 0 0}.jobs-content{padding:20rpx 40rpx 0}.jobs-hint{color:#777771;font-size:24rpx;line-height:1.55;margin:6rpx 0 26rpx}.jobs-page .flow-card{margin:20rpx 0;padding:27rpx}.jobs-page .flow-card .btn{width:100%;margin:18rpx 0 0}.jobs-page .amount{font-size:40rpx}.jobs-page .route{font-size:30rpx}.jobs-page .green-note{padding:20rpx}.jobs-page .badge{font-size:21rpx}

.jobs-page .own-post{border:2rpx dashed #b44b22}.jobs-page .taken-card{border:1rpx dashed #d6d5ce;background:#f8f8f5}.jobs-page .done-card{border-color:#b1cebf}.jobs-page .own-badge{background:#b44b22;color:#fff}.jobs-page .done-badge{background:#41775b;color:#fff}.jobs-page .taken-badge{background:#fbefe5;color:#843e27}.jobs-page .badge.takeout{background:#fbefe5;color:#873766}.jobs-page .badge.parcel{background:#eceef8;color:#454d7d}.jobs-page .badge.task{background:#e8edff;color:#3545af}.job-timing{padding:22rpx;background:#f3f3ef;border-radius:20rpx;margin:20rpx 0;font-size:24rpx;font-weight:700;color:#54554d}.taken-card .job-timing{background:#eae9e3}.done-card .job-timing{background:#e8f3ed;color:#41775b}.jobs-page .own-order{background:#fcf0e5;color:#833f28}.done-proof{border-radius:27rpx;padding:30rpx;background:#41775b;color:#fff;font-size:22rpx;line-height:1.55;margin:24rpx 0}.proof-count{font-weight:700;margin:20rpx 0}.proof-count text{font-size:60rpx;margin-right:15rpx}.date-heading{font-size:25rpx;font-weight:700;margin:28rpx 4rpx 0}.date-heading .hint{font-weight:400}

.guide-modal{top:16%;max-height:calc(100vh - 210rpx);overflow-y:auto;box-sizing:border-box}.guide-modal.bottom-modal{top:auto;bottom:190rpx;max-height:calc(100vh - 230rpx)}.guide-modal .guide-text{font-size:25rpx;line-height:1.6}.guide-example{border:2rpx dashed #b1cebf;border-radius:22rpx;padding:22rpx;margin:18rpx 0}.guide-example .route{margin:16rpx 0;font-size:27rpx}.example-button{pointer-events:none;text-align:center}.guide-complete{position:fixed;bottom:180rpx;left:26rpx;right:26rpx;z-index:100;background:#16181c;color:#fff;padding:24rpx;border-radius:24rpx;font-size:25rpx;line-height:1.5}.empty-reminder{margin-top:22rpx}.jobs-page .empty-post{background:#ad4821;width:auto;padding:0 40rpx}.nav .item text{white-space:nowrap}

.order-toggle-row{margin:20rpx 0;gap:16rpx}.order-toggle{flex:none;font-size:24rpx;font-weight:700;color:#55574f;padding:12rpx 0 12rpx 24rpx}.selectable-order{display:flex;align-items:center;gap:18rpx;padding:22rpx;border:1rpx solid #e4e4de;border-radius:20rpx;background:#fafaf7;margin:12rpx 0}.order-check{flex:none;width:34rpx;height:34rpx;border:2rpx solid #c7c7bd;border-radius:50%;background:white;display:flex;align-items:center;justify-content:center;color:white;font-size:23rpx}.order-check.checked{background:#41775b;border-color:#41775b}.order-summary{flex:1;min-width:0}.order-summary .hint{margin:6rpx 0 0}.individual-parcels{display:block;color:#41775b;text-align:center;font-size:23rpx;padding:18rpx 0 0}.jobs-page .btn[disabled]{background:#e5e5df;color:#999a91}

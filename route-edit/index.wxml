<view class="post-page route-editor">
 <view class="editor-heading"><view class="editor-title">{{title}}</view><view class="hint">{{subtitle}}</view></view>
 <view wx:if="{{mode==='order'}}" class="order-only">Only this order changes. Your saved route stays the same.</view>
 <view class="flow-card">
  <block wx:if="{{form.destinationType==='place' && mode==='saved'}}"><view class="field-label">Save as</view><view class="pills"><text wx:for="{{names}}" wx:key="*this" class="pill {{form.name===item?'selected':''}}" data-field="name" data-value="{{item}}" bindtap="select">{{item}}</text></view></block>
  <block wx:if="{{!parcel}}"><view class="field-label">Collect from</view><view class="pills"><text wx:for="{{stations}}" wx:key="*this" class="pill {{form.station===item?'selected':''}}" data-field="station" data-value="{{item}}" bindtap="select">{{item}}</text></view></block>
  <block wx:if="{{form.destinationType==='dorm'}}"><view class="row"><view class="destination-column"><view class="field-label">Deliver to</view><picker range="{{dorms}}" value="{{dormIndex}}" disabled="{{routeLocked}}" bindchange="dorm"><view class="field">{{form.dorm||'Choose building'}}　⌄</view></picker></view><view class="room-column"><view class="field-label">Room</view><input class="field" value="{{form.room}}" data-field="room" bindinput="field" placeholder="Room" maxlength="100"/></view></view></block>
  <block wx:else><view class="field-label">Deliver to: where exactly?</view><textarea class="field address-area" value="{{form.deliveryAddress}}" data-field="deliveryAddress" bindinput="field" maxlength="500" placeholder="e.g. Library, front desk on the ground floor"/><view class="pills suggestions"><text wx:for="{{suggestions}}" wx:key="*this" class="pill" data-field="deliveryAddress" data-value="{{item}}" bindtap="select">{{item}}</text></view><view class="hint">The runner hands it to you there, so there’s no door or lobby to choose.</view></block>
  <view class="field-label">Delivery instructions (optional)</view><input class="field" value="{{form.deliveryNote}}" data-field="deliveryNote" bindinput="field" maxlength="500" placeholder="e.g. leave at the desk"/><view class="row"><view class="half"><view class="field-label">Name on the order</view><input class="field" value="{{form.owner}}" data-field="owner" bindinput="field" maxlength="60"/></view><view class="half"><view class="field-label">Phone</view><input class="field {{phoneError?'phone-invalid':''}}" type="number" value="{{form.phone}}" data-field="phone" bindinput="field" bindblur="phoneBlur" maxlength="11" placeholder="11-digit number" focus="{{phoneFocus}}"/></view></view>
  <view wx:if="{{!phoneError}}" class="hint phone-format-hint">{{phoneHint}}</view>
  <button wx:if="{{form.destinationType==='dorm' && wechatPhone}}" class="wechat-number" bindtap="usePhone">Use my WeChat number　{{wechatMask}}</button><button wx:elif="{{form.destinationType==='dorm'}}" class="wechat-number" open-type="getPhoneNumber" bindgetphonenumber="authorizePhone" loading="{{phoneBusy}}">Use my WeChat number</button>
  <block wx:if="{{form.destinationType==='dorm'}}"><view class="field-label">When the runner arrives</view><view class="pills"><text class="pill {{form.dropMode==='door'?'selected':''}}" data-field="dropMode" data-value="door" bindtap="select">At my door</text><text class="pill {{form.dropMode==='lobby'?'selected':''}}" data-field="dropMode" data-value="lobby" bindtap="select">Lobby · I’ll come down</text></view></block>
 </view><view wx:if="{{phoneError}}" class="phone-error">{{phoneError}}</view><button class="btn" bindtap="save" disabled="{{saving}}" loading="{{saving}}">{{mode==='order'?'Use for this order':parcel?'Save address':'Save route'}}</button><button class="cancel-button" bindtap="cancel" disabled="{{saving}}">Cancel</button>
</view><yuni-assistant topic=""/>

<view class="flow-page" wx:if="{{request}}"><view class="flow-title">{{request.isMine?'My task':'Your task'}}</view><view class="flow-sub">Done by {{request.due}}</view><yuni-tip tip-key="task-track" pose="work" text="Clear tasks get done faster. Use Messages if something needs explaining."/><view class="flow-card status-card"><view class="flow-title">{{request.status==='taken'?'A runner took the task':request.status==='delivered'?'Photo and note sent':request.status==='confirmed'?'Task completed':request.statusLabel}}</view><view class="hint">{{request.status==='delivered'?'Waiting for the student to check. Automatically confirms after 24 hours.':request.status==='disputed'?'Your report is under review; settlement is paused.':''}}</view></view><view class="flow-card"><text class="badge task">Task</text><view class="route task-title">{{request.title}}</view><image wx:for="{{request.pictures}}" wx:key="*this" class="thumb" src="{{item}}" mode="aspectFill" data-photo="{{item}}" bindtap="preview"/><view class="row hint"><text>Done by</text><text>{{request.due}}</text></view><view class="row"><text>{{request.isMine?'Your price':'You get'}}</text><text class="money">¥{{request.rewardText}}</text></view><view wx:if="{{request.runnerId}}" class="action-row"><button class="btn light" bindtap="chat">Messages {{request.unread||''}}</button><button wx:if="{{request.isMine?request.runnerPhone:request.phone}}" class="btn light" bindtap="phone">Call</button></view><view wx:if="{{request.isRunner}}" class="hint">{{request.owner}} · See the task description for the location</view></view><view wx:if="{{request.isMine && request.status==='waiting'}}" class="flow-card"><view class="strong">Nobody yet? Raise it</view><view class="action-row"><button class="btn light" data-amount="1" bindtap="raise">+ ¥1</button><button class="btn light" data-amount="2" bindtap="raise">+ ¥2</button></view><view class="link" bindtap="cancel">Cancel · free until a runner takes it</view></view><view wx:if="{{request.isRunner && request.status==='taken'}}" class="flow-card"><view class="strong">When it’s done</view><view class="hint">Send a photo that shows the task is done, and a short note.</view><view class="dash" bindtap="handlePhoto">{{photo?'Retake photo':'Take a photo · needed'}}</view><image wx:if="{{photo}}" class="proof" src="{{photo}}" mode="aspectFill"/><textarea class="field" data-field="note" bindinput="field" maxlength="500" value="{{note}}" placeholder="Short completion note"/><button class="btn" disabled="{{!photo||!note}}" bindtap="done">Send photo and note</button><view class="link" bindtap="giveBack">Can’t do it? Give it back</view><view class="hint link" data-reason="mismatch" bindtap="giveBack">Task isn’t what was written</view></view><view wx:if="{{request.photo}}" class="flow-card"><image class="proof" src="{{request.photo}}" mode="aspectFill" data-photo="{{request.photo}}" bindtap="preview"/><view class="hint">Completion photo · {{request.deliveredTime}}</view><view class="value">“{{request.completionNote}}”</view></view><view wx:if="{{request.isMine && request.status==='delivered'}}" class="flow-card"><button class="btn" bindtap="confirm">It’s done · confirm ¥{{request.rewardText}}</button><button class="btn light" bindtap="issue">Something’s wrong</button><view class="hint">With no answer, this confirms automatically after 24 hours. Reports pause settlement.</view><block wx:if="{{reporting}}"><view class="pills"><view wx:for="{{reasons}}" wx:key="*this" class="pill {{reason===item?'selected':''}}" data-value="{{item}}" bindtap="handleReason">{{item}}</view></view><view class="dash" bindtap="chooseIssuePhoto">{{issuePhoto?'Photo added':'Add evidence photo'}}</view><textarea class="field" value="{{issueNote}}" data-field="issueNote" bindinput="field" placeholder="What went wrong?"/><button class="btn" disabled="{{!reason}}" bindtap="report">Send to Uniearn</button></block></view><view class="flow-card"><view class="strong">Progress</view><view wx:for="{{request.progress}}" wx:key="label" class="timeline"><text>{{item.done?'●':'○'}}</text><text>{{item.label}}</text></view><view class="row hint"><text>Service fee</text><text>¥{{request.fee}}</text></view><view class="row strong"><text>Total (simulated)</text><text>¥{{request.total}}</text></view><view wx:if="{{request.status==='refunded'||request.status==='cancelled'}}" class="hint">Full simulated refund ¥{{request.refundAmount}}</view></view><button wx:if="{{request.isMine && (request.status==='confirmed'||request.status==='cancelled'||request.status==='refunded')}}" class="btn light" bindtap="repeat">Post it again</button><button class="btn light" bindtap="help">Need help with this task?</button></view><view wx:else class="empty">Task unavailable. Refresh My orders.</view><yuni-assistant topic=""/>
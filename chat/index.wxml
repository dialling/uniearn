<view class="v8-page chat-page" wx:if="{{request}}"><view class="summary-head row"><view><view class="flow-title">{{name}}</view><view class="hint">Student · {{request.dorm}}</view></view><view class="contact-button" bindtap="call"><image src="/assets/phone.svg"/></view></view><view class="green-note" bindtap="order">{{request.sizeLabel}} · {{request.boxes}} {{request.unit}} · {{request.station}} → {{request.dorm}}<view class="strong">View order ›</view></view><view class="hint center">Chat opens after acceptance and closes 24 hours after delivery.</view><view wx:for="{{messages}}" wx:key="id" class="message-row {{item.mine?'mine':''}}"><view class="bubble">{{item.text}}<view class="message-time">{{item.time}}</view></view></view><view wx:if="{{!messages.length}}" class="hint center">Your conversation starts here.</view><view class="chat-compose"><view class="pills"><text wx:for="{{quick}}" wx:key="*this" class="pill" data-text="{{item}}" bindtap="quickReply">{{item}}</text></view><view class="row"><input class="field" value="{{text}}" bindinput="input" maxlength="500" placeholder="{{closed?'Chat closed':'Message…'}}" disabled="{{closed}}"/><button class="btn" disabled="{{closed||!text}}" bindtap="send">Send</button></view></view></view><view wx:else class="empty">This conversation is unavailable.</view>
<yuni-assistant topic=""/>
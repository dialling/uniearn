<view class="v8-page rewards-page"><view class="summary-head"><view class="flow-title">News</view><view class="flow-sub">{{ready}} coupons ready · {{toCollect}} to collect</view></view>
<view wx:if="{{event}}" class="event-banner"><text class="event-tag">{{event.bannerLabel}}</text><view class="event-title">{{event.headline}}</view><view>{{event.blurb}}</view><button wx:if="{{!registered}}" class="collect-event" bindtap="register">Register to collect</button><button wx:elif="{{!event.collected}}" class="collect-event" data-id="{{event.id}}" bindtap="collect" disabled="{{!event.eligible}}">{{event.eligible?'Collect':'Ended'}}</button><view wx:else class="collected">✓ Collected · added to your coupons</view></view>
<view id="my-coupons" class="section row"><text>My coupons · {{ready}}</text><text class="hint">one per order</text></view><view wx:for="{{coupons}}" wx:key="id" class="coupon"><view class="coupon-face {{item.cash?'cash':''}}"><view>{{item.face}}</view><text>{{item.sub}}</text></view><view class="coupon-info"><view class="strong">{{item.title}}</view><view class="hint">{{item.description}}</view><view class="coupon-end">Ends {{item.displayEnd}}</view></view><button class="use" data-id="{{item.id}}" bindtap="use">Use</button></view>
<view wx:if="{{showExamples}}" class="examples"><view class="examples-title">Example welcome coupons</view><view class="hint examples-note">Register to receive your own coupons. These examples cannot be used yet.</view><view wx:for="{{examples}}" wx:key="id" class="coupon example-coupon"><view class="coupon-face {{item.cash?'cash':''}}"><view>{{item.face}}</view><text>{{item.sub}}</text></view><view class="coupon-info"><view class="strong">{{item.title}}</view><view class="hint">{{item.description}}</view><view class="coupon-end">Available {{item.endLabel}}</view></view><button class="use" bindtap="register">Register</button></view></view><view wx:elif="{{!ready}}" class="hint">No available coupons right now. Check the event above or collect more below.</view>
<view class="section">Collect more</view><view wx:if="{{returning.eligible || returning.collected}}" class="flow-card collect-card"><view class="collect-copy"><view class="strong">¥1 off × 3 orders</view><view class="hint">Welcome back · for students who ordered last month</view></view><button class="small-outline" disabled="{{returning.collected}}" data-id="{{returning.id}}" bindtap="collect">{{returning.collected?'Collected':'Collect'}}</button></view><view class="flow-card collect-card"><view class="invite-icon"><image src="/assets/coupon-outline.svg"/></view><view class="collect-copy"><view class="strong">Invite a classmate</view><view class="hint">When their first order is confirmed, you both get free delivery</view></view><button class="small-outline" bindtap="invite">Invite</button></view>
<view class="section row"><text>For runners</text><text class="link" bindtap="jobs">Open jobs ›</text></view><view class="flow-card runner-card"><view class="row strong"><text>This week: {{weekly.target||5}} jobs → +¥{{weekly.amount||5}} bonus</text><text>{{weekly.count||0}}/{{weekly.target||5}}</text></view><view class="segments"><view wx:for="{{weekly.segments}}" wx:key="index" class="{{item?'filled':''}}"/></view><view class="hint">{{weekly.earned?'Target reached':'Complete more jobs by Sunday 23:59'}} · test reward recorded with your account.</view></view><view class="flow-card runner-card"><view class="strong">Lunch rush · +¥{{rush.amount||1}} per job</view><view class="hint">Takeaway from {{rush.station||'North gate'}}, {{rush.timeLabel}}. Added on top of the student’s fee.</view></view>
<view class="section">News</view><view class="flow-card"><view wx:for="{{news}}" wx:key="title" class="menu-row"><view><view class="strong">• {{item.title}}</view><view class="hint">{{item.body}}</view><view class="hint">{{item.date}}</view></view></view></view><view class="hint center">One coupon per order · XJTLU students only. UniEarn covers the coupon part; runners keep their full delivery fee.</view><view class="test-note">Team test: payments, subsidies and bonuses are simulated.</view></view><app-nav active="rewards"/>
<block wx:if="{{inviting}}"><view class="sheet-shade" bindtap="close"/><view class="flow-sheet"><view class="flow-title">Invite a classmate</view><view class="hint">Your invitation code</view><view class="strong">{{inviteCode}}</view><button class="btn" open-type="share">Share invitation</button><button class="btn outline" bindtap="copy">Copy code</button><input class="field" value="{{inviteInput}}" bindinput="input" placeholder="A classmate’s invitation code"/><button class="btn" bindtap="redeem">Use invitation</button><button class="btn outline" bindtap="close">Done</button></view></block>
<yuni-assistant topic=""/>
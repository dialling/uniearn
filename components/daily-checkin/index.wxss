 .checkin-mask{position:fixed;inset:0;z-index:1100;background:rgba(22,35,28,.52);display:flex;align-items:center;justify-content:center;padding:28rpx;animation:var(--ue-animation,checkin-fade .25s ease both)}
.checkin-card{position:relative;width:660rpx;max-height:calc(100vh - 90rpx);overflow-y:auto;padding:30rpx 32rpx 28rpx;border-radius:34rpx;background:#fffdfa;color:#1d2a22;text-align:center;box-shadow:0 24rpx 70rpx rgba(24,44,34,.24);animation:var(--ue-animation,checkin-in .45s cubic-bezier(.2,.8,.3,1.15) both);box-sizing:border-box}
.checkin-close{position:absolute;right:16rpx;top:12rpx;width:60rpx;height:60rpx;padding:0;margin:0;line-height:60rpx;border:0;background:transparent;color:#7b897f;font-size:40rpx;font-weight:400}.checkin-close::after,.checkin-cta::after{border:0}
.checkin-eyebrow{display:inline-block;padding:7rpx 20rpx;border-radius:99rpx;background:#fdf3db;color:#8a5a14;font-size:18rpx;font-weight:700;letter-spacing:3rpx}
.checkin-title{margin-top:14rpx;font-size:46rpx;line-height:1.2;font-weight:800;letter-spacing:2rpx}.checkin-sub{margin-top:10rpx;font-size:24rpx;color:#7b897f}.checkin-streak-value{color:#8a5a14;font-weight:800}
.checkin-stage{width:100%;height:432rpx;margin-top:22rpx;border-radius:24rpx;overflow:hidden;background:#e8f3ed}.checkin-video,.checkin-still{display:block;width:100%;height:100%}
.checkin-days{display:flex;gap:8rpx;margin-top:18rpx}.checkin-day{flex:1;min-width:0;padding:10rpx 0 8rpx;border-radius:12rpx;background:#f2f5f2;color:#9aa69d;font-size:27rpx;line-height:1.3}.checkin-day.done{background:#e8f3ed;color:#2f5f47}.checkin-day.today{background:#41775b;color:#fff}.checkin-day-label{display:block;margin-top:4rpx;font-size:16rpx}
.checkin-result{display:flex;align-items:center;gap:16rpx;margin-top:18rpx;padding:18rpx 20rpx;border:1rpx solid #e1efe6;border-radius:20rpx;background:#f3f9f5;text-align:left}.checkin-result-copy{flex:1;min-width:0}.checkin-result-title{font-size:26rpx;font-weight:750}.checkin-result-sub{margin-top:6rpx;font-size:21rpx;line-height:1.5;color:#6d766e}.checkin-points{flex:none;padding:8rpx 16rpx;border-radius:99rpx;background:#fff5dc;color:#8a5a14;font-size:30rpx;font-weight:800}.checkin-rule{margin:14rpx 0;font-size:20rpx;line-height:1.5;color:#7b897f}
.checkin-cta{display:flex;align-items:center;justify-content:center;gap:14rpx;width:100%;min-height:84rpx;margin:0;padding:18rpx 24rpx;border-radius:20rpx;background:#41775b;color:#fff;font-size:29rpx;font-weight:750;line-height:1.5}.checkin-cta-arrow{font-size:34rpx}
@keyframes checkin-fade{from{opacity:0}to{opacity:1}}@keyframes checkin-in{from{opacity:0;transform:translateY(45rpx) scale(.96)}to{opacity:1;transform:none}}

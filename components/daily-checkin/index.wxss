.checkin-mask{position:fixed;inset:0;z-index:1100;background:rgba(22,35,28,.52);display:flex;align-items:center;justify-content:center;padding:24rpx;animation:var(--ue-animation,checkin-fade .2s ease both)}
.checkin-card{position:relative;width:660rpx;max-height:calc(100vh - 80rpx);overflow-y:auto;padding:28rpx 30rpx;border-radius:34rpx;background:#fffdfa;color:#23382f;box-sizing:border-box;box-shadow:0 24rpx 70rpx rgba(24,44,34,.24);animation:var(--ue-animation,checkin-in .3s ease both)}
.checkin-close{position:absolute;left:8rpx;top:4rpx;width:88rpx;height:88rpx;line-height:88rpx;padding:0;margin:0;background:transparent;border:0;color:#617164;font-size:38rpx}.checkin-close::after,.checkin-feed::after,.checkin-cta::after{border:0}
.checkin-eyebrow{width:max-content;margin:0 auto 24rpx;padding:7rpx 20rpx;border-radius:99rpx;background:#fbf3df;color:#816022;font-size:17rpx;letter-spacing:2rpx}
.checkin-heading{display:flex;align-items:center;justify-content:space-between;gap:12rpx}.checkin-title{font-size:40rpx;font-weight:750}.checkin-streak{padding:10rpx 15rpx;border-radius:40rpx;background:#e7efe3;color:#42654c;font-size:21rpx;white-space:nowrap}.checkin-sub{margin:10rpx 0 20rpx;font-size:23rpx;line-height:1.5;color:#647165}
.checkin-stage{position:relative;width:100%;height:410rpx;border-radius:25rpx;overflow:hidden;background:linear-gradient(145deg,#f1f7f3,#e5eee5)}.checkin-platform{position:absolute;left:60rpx;right:40rpx;bottom:22rpx;height:68rpx;border-radius:50%;background:#fffdf2;box-shadow:0 5rpx 0 #e4e8da}
.checkin-yuni{position:absolute;left:50%;bottom:36rpx;width:360rpx;height:360rpx;transform:translateX(-50%);transform-origin:50% 88%;z-index:2}.checkin-pose{position:absolute;inset:0;overflow:hidden;opacity:0;transition:var(--ue-transition,opacity .17s ease)}.checkin-pose.visible{opacity:1}.checkin-sprite{position:absolute;top:0;width:300%;height:100%}
.checkin-speech{position:absolute;right:14rpx;top:18rpx;z-index:5;max-width:58%;padding:13rpx 16rpx;border-radius:20rpx 20rpx 20rpx 3rpx;background:#fffefb;color:#405d46;font-size:23rpx;font-weight:650;line-height:1.4}.checkin-bucket{position:absolute;left:12rpx;bottom:14rpx;width:100rpx;height:100rpx;z-index:3;text-align:center}.bucket-handle{position:absolute;left:30rpx;top:5rpx;width:34rpx;height:32rpx;border:5rpx solid #a87932;border-bottom:0;border-radius:50% 50% 0 0}.bucket-snack{position:absolute;left:25rpx;top:21rpx;width:49rpx;height:24rpx;transform:rotate(-12deg)}.bucket-body{position:absolute;left:21rpx;top:34rpx;width:59rpx;height:43rpx;border-radius:3rpx 3rpx 9rpx 9rpx;background:#d4a451;border-top:6rpx solid #edce86}.bucket-label{position:absolute;bottom:0;left:-8rpx;right:-8rpx;white-space:nowrap;font-size:16rpx;color:#685831}
.checkin-flying-fish{position:absolute;left:36rpx;bottom:54rpx;width:34rpx;height:18rpx;z-index:6;animation:var(--ue-animation,fish-flight .82s cubic-bezier(.3,0,.35,1) both)}.chewing .checkin-yuni{animation:var(--ue-animation,yuni-chew .36s ease-in-out 3)}.checkin-float{position:absolute;left:66%;top:31%;z-index:6;font-weight:750;color:#326647;font-size:30rpx;white-space:nowrap;animation:var(--ue-animation,reward-float 1s ease both)}
.checkin-feed,.checkin-cta{display:flex;align-items:center;justify-content:center;gap:14rpx;width:100%;min-height:92rpx;margin:22rpx 0 0;padding:18rpx 15rpx;line-height:1.5;border:0;border-radius:20rpx;background:#496f56;color:#fff;font-size:27rpx;font-weight:700;box-sizing:border-box}.feed-icon{width:36rpx;height:19rpx;flex-shrink:0}.checkin-feed[disabled]{background:#deeadf;color:#315b40;opacity:1}.checkin-cta{min-height:88rpx;margin-top:14rpx}
.checkin-days{display:flex;gap:8rpx;margin-top:20rpx}.checkin-day{flex:1;min-width:0;text-align:center}.checkin-tile{position:relative;display:flex;align-items:center;justify-content:center;height:68rpx;border:2rpx solid transparent;border-radius:14rpx;background:#edf0e9}.tile-icon{width:45rpx;height:23rpx}.checkin-day.done .checkin-tile{background:#e1ebde}.checkin-day.today .checkin-tile{background:#fff4dc;border-color:#b49556}.checkin-day.today.done .checkin-tile{background:#52745b;border-color:#52745b}.checkin-day.bonus-day .checkin-tile{background:#f8efd6}.checkin-day.bonus-day.today.done .checkin-tile{background:#52745b}.checkin-bonus{position:absolute;bottom:1rpx;right:3rpx;font-size:16rpx;color:#725319}.today.done .checkin-bonus{color:#fff}.checkin-day-label{display:block;margin-top:8rpx;font-size:16rpx;color:#647165;white-space:nowrap}.checkin-week-foot{display:flex;justify-content:space-between;gap:10rpx;margin:15rpx 0;color:#647165;font-size:18rpx}
.checkin-result{display:flex;align-items:center;gap:15rpx;padding:18rpx;border:1rpx solid #e2eadd;border-radius:18rpx;background:#f2f6ef}.checkin-result-copy{flex:1;min-width:0}.checkin-result-title{font-size:25rpx;font-weight:700}.checkin-result-sub{margin-top:6rpx;font-size:21rpx;line-height:1.5;color:#627064}.checkin-points{flex:none;padding:8rpx 13rpx;border-radius:40rpx;background:#fff3d5;color:#77541f;font-size:28rpx;font-weight:750}.checkin-rule{text-align:center;margin-top:16rpx;color:#647165;font-size:20rpx;line-height:1.5}.checkin-cash{text-align:center;color:#647165;font-size:18rpx;margin-top:6rpx}
@keyframes fish-flight{0%{transform:translate(0,0) scale(1) rotate(-12deg);opacity:1}55%{transform:translate(136rpx,-142rpx) scale(.95) rotate(-5deg);opacity:1}90%{transform:translate(223rpx,-164rpx) scale(.6);opacity:1}100%{transform:translate(248rpx,-165rpx) scale(.2);opacity:0}}
@keyframes yuni-chew{0%,100%{transform:translateX(-50%) scale(1,1)}50%{transform:translateX(-50%) scale(1.008,.99)}}
@keyframes reward-float{0%{opacity:0;transform:translateY(16rpx)}20%,70%{opacity:1}100%{opacity:0;transform:translateY(-25rpx)}}@keyframes checkin-fade{from{opacity:0}to{opacity:1}}@keyframes checkin-in{from{opacity:0;transform:translateY(16rpx)}to{opacity:1;transform:none}}
.checkin-feed,.checkin-cta{min-height:44px}.checkin-close{min-width:44px;min-height:44px}.checkin-float.bonus{animation:var(--ue-animation,reward-bonus 1s ease both)}
@keyframes reward-bonus{0%{opacity:0;transform:translateY(16rpx)}20%,70%{opacity:1}100%{opacity:0;transform:translateY(-25rpx)}}
.checkin-cta.collected[disabled]{background:#222;color:#fff;opacity:1}

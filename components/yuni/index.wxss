.yuni-strip{display:flex;align-items:center;gap:18rpx;margin:8rpx 0 26rpx}.yuni-strip .yuni-avatar{width:82rpx;height:94rpx;flex:none}.yuni-bubble{background:#fff;border:1rpx solid #e2e0d9;border-radius:26rpx;padding:20rpx 24rpx;flex:1;font-size:25rpx;line-height:1.6}.yuni-name{font-weight:700;color:#8b1e2b;font-size:22rpx}.yuni-help{font-weight:650;color:#8b1e2b;margin-top:10rpx}.yuni-close{font-size:38rpx;color:#8a877e;padding:8rpx}
@keyframes yuni-rise{from{opacity:0;transform:translate3d(0,20rpx,0)}to{opacity:1;transform:translate3d(0,0,0)}}
@keyframes yuni-wave{0%{opacity:0;transform:scale(.8) rotate(-8deg)}60%{opacity:1;transform:scale(1.06) rotate(3deg)}100%{opacity:1;transform:scale(1) rotate(0)}}
@keyframes yuni-float{0%,100%{transform:translate3d(0,0,0)}50%{transform:translate3d(0,-6rpx,0)}}
.yuni-strip{animation:yuni-rise .42s cubic-bezier(.22,.8,.3,1) backwards}
.yuni-strip .yuni-avatar{animation:yuni-wave .6s cubic-bezier(.3,1.4,.5,1) .1s backwards,yuni-float 3.4s ease-in-out .7s infinite}

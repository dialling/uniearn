/* 2026-11-16: first-time tips, the same look as the Jobs page app guide (dim, white-ringed spotlight, Yuni card). */
.cg-shade{position:fixed;inset:0;background:rgba(0,0,0,.6);z-index:2000}
.cg-focus{position:fixed;z-index:2000;border:4rpx solid #fff;box-shadow:0 0 0 2000rpx rgba(0,0,0,.6);pointer-events:none;box-sizing:border-box;transition:top .42s cubic-bezier(.3,.9,.25,1),left .42s cubic-bezier(.3,.9,.25,1),width .42s cubic-bezier(.3,.9,.25,1),height .42s cubic-bezier(.3,.9,.25,1);animation:cg-spot-in .45s cubic-bezier(.3,.9,.25,1) backwards}
.cg-ring{position:absolute;left:-4rpx;top:-4rpx;right:-4rpx;bottom:-4rpx;border:4rpx solid #fff;border-radius:inherit;animation:cg-ring 1.8s ease-out .45s infinite}
.cg-blocker{position:fixed;inset:0;z-index:2001}
.cg-card{position:fixed;transition:top .38s cubic-bezier(.3,.9,.25,1);left:32rpx;right:32rpx;bottom:calc(170rpx + env(safe-area-inset-bottom));z-index:2002;padding:30rpx;border-radius:30rpx;background:#fff;color:#16181c;box-sizing:border-box;box-shadow:0 20rpx 50rpx rgba(22,24,28,.18);animation:cg-card-in .46s cubic-bezier(.22,.9,.3,1) backwards}
.cg-head{display:flex;align-items:center;justify-content:space-between}
.cg-dots{display:flex;align-items:center;gap:8rpx}
.cg-dot{width:12rpx;height:12rpx;border-radius:12rpx;background:#e2e0d9;transition:width .32s cubic-bezier(.3,.9,.25,1),background-color .32s ease}
.cg-dot.past{background:#0b7a55;opacity:.4}
.cg-dot.on{width:36rpx;background:#0b7a55}
.cg-skip{font-size:24rpx;font-weight:700;color:#6b6860;padding:6rpx 4rpx}
.cg-step{animation:cg-from-right .34s cubic-bezier(.22,.8,.3,1) backwards}
.cg-step.from-left{animation-name:cg-from-left}
.cg-body{display:flex;gap:22rpx;margin:24rpx 0}
.cg-card .cg-step:first-child .cg-body{margin-top:0}
.cg-yuni{flex:none;width:116rpx;height:116rpx;animation:cg-yuni-in .6s cubic-bezier(.3,1.3,.5,1) .06s backwards,cg-float 3.2s ease-in-out .7s infinite}
.cg-copy{flex:1;min-width:0}
.cg-name{font-size:24rpx;font-weight:800;color:#0b7a55}
.cg-title{margin:8rpx 0;font-size:30rpx;font-weight:800}
.cg-text{font-size:25rpx;line-height:1.6;color:#44423c}
.cg-actions{display:flex;gap:16rpx}
.cg-btn{flex:1;height:88rpx;line-height:88rpx;margin:0!important;padding:0;border-radius:26rpx;font-size:28rpx;font-weight:800}
.cg-btn::after{border:0}
.cg-next{background:#0b7a55;color:#fff;box-shadow:0 6rpx 0 #08603f}
.cg-back{background:#e3f3ea;color:#0b7a55}
@keyframes cg-spot-in{from{transform:scale(1.35)}to{transform:scale(1)}}
@keyframes cg-ring{0%{opacity:.85;transform:scale(1)}80%,100%{opacity:0;transform:scale(1.22)}}
@keyframes cg-card-in{0%{opacity:0;transform:translate3d(0,40rpx,0) scale(.96)}70%{opacity:1;transform:translate3d(0,-4rpx,0) scale(1.005)}100%{opacity:1;transform:none}}
@keyframes cg-from-right{from{opacity:0;transform:translate3d(40rpx,0,0)}to{opacity:1;transform:none}}
@keyframes cg-from-left{from{opacity:0;transform:translate3d(-40rpx,0,0)}to{opacity:1;transform:none}}
@keyframes cg-yuni-in{0%{opacity:0;transform:translate3d(0,24rpx,0) scale(.7) rotate(-8deg)}60%{opacity:1;transform:translate3d(0,-6rpx,0) scale(1.08) rotate(3deg)}100%{opacity:1;transform:none}}
@keyframes cg-float{0%,100%{transform:translate3d(0,0,0)}50%{transform:translate3d(0,-8rpx,0)}}
@media(prefers-reduced-motion:reduce){.cg-focus,.cg-ring,.cg-card,.cg-step,.cg-yuni{animation:none}}

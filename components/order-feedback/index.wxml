<view wx:if="{{resolvable}}" class="feedback-inline {{dark}}"><view class="feedback-inline-note {{unread>0?'has-reply':''}}" role="button" bindtap="open"><view wx:if="{{unread>0}}" class="feedback-inline-dot"/><text>{{unread>0?(zh?'Uniearn 已回复':'Uniearn replied'):(zh?'你报告的问题处理中':'Your report is open')}} ›</text></view><button class="feedback-inline-action" bindtap="resolve" disabled="{{resolving}}" loading="{{resolving}}">{{zh?'问题已解决':'Issue resolved'}}</button></view>

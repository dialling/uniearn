.feedback-inline{display:flex;align-items:center;justify-content:space-between;gap:16rpx;margin:16rpx 0 4rpx;padding:14rpx 20rpx;border-radius:16rpx;background:#f5f4ef}.feedback-inline-note{flex:1;min-width:0;color:#6b6860;font-size:24rpx}.feedback-inline button.feedback-inline-action{flex:none;width:auto!important;min-width:0;margin:0;padding:8rpx 22rpx;border:1rpx solid #c9d8cd;border-radius:999rpx;background:#fff;color:#0b7a55;font-size:24rpx;font-weight:700;line-height:1.5}.feedback-inline-action::after{border:0}.feedback-inline-action[disabled]{opacity:.6}.feedback-inline.page-dark{background:#2b2d29}.feedback-inline.page-dark .feedback-inline-note{color:#a9a69c}.feedback-inline.page-dark button.feedback-inline-action{background:#242522;color:#6fd0a8;border-color:#3a4a40}
.feedback-inline-note{display:flex;align-items:center;gap:10rpx}.feedback-inline-note.has-reply{color:#0b7a55;font-weight:700}.feedback-inline-dot{flex:none;width:14rpx;height:14rpx;border-radius:50%;background:#e5484d}

.feedback-entry{margin:20rpx 0}.feedback-button{box-sizing:border-box;display:flex;align-items:center;gap:16rpx;width:100%;min-height:88rpx;margin:0;padding:21rpx 24rpx;border:1rpx solid #dce2d9;border-radius:18rpx;background:#fff;color:#405847;font-size:25rpx;font-weight:600;line-height:1.5;text-align:left}.feedback-button::after{border:0}.feedback-button image{width:34rpx;height:34rpx;flex:none}.feedback-arrow{margin-left:auto;color:#85907f;font-size:34rpx;line-height:1}.page-dark .feedback-button{background:#242d26;color:#b8d3bc;border-color:#435246}

.feedback-resolve-spacer{height:calc(130rpx + env(safe-area-inset-bottom))}.feedback-resolve-bar{box-sizing:border-box;position:fixed;bottom:0;left:0;right:0;z-index:90;padding:18rpx 28rpx calc(18rpx + env(safe-area-inset-bottom));background:#fff;border-top:1rpx solid #e3e7dd;box-shadow:0 -4rpx 18rpx #26332a08}.feedback-resolve-bar button.feedback-resolve-button{box-sizing:border-box;display:block;width:100%!important;max-width:none;min-width:0;min-height:88rpx;margin:0;padding:20rpx;border-radius:18rpx;background:#41775b;color:#fff;font-size:28rpx;font-weight:700;line-height:1.5}.feedback-resolve-button::after{border:0}.feedback-resolve-button[disabled]{opacity:.6}.page-dark .feedback-resolve-bar{background:#242d26;border-color:#435246}

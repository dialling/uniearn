<view wx:if="{{open}}" class="lv-mask" bindtap="close" catchtouchmove="noop"><view class="lv-pop" catchtap="noop"><view class="lv-eyebrow">✦ LEVEL UP</view><view class="lv-title">{{ui.title}}</view><view class="lv-sub">{{ui.sub}}</view><view class="lv-stage"><video wx:if="{{videoSrc&&!videoFailed}}" class="lv-video" src="{{videoSrc}}" autoplay muted loop="{{false}}" controls="{{false}}" show-center-play-btn="{{false}}" show-play-btn="{{false}}" show-fullscreen-btn="{{false}}" show-progress="{{false}}" show-mute-btn="{{false}}" enable-progress-gesture="{{false}}" object-fit="cover" binderror="videoError"/><image wx:if="{{videoFailed}}" class="lv-still" src="/assets/yuni-party.png" mode="aspectFit"/></view><view class="lv-xp"><text>{{ui.jobs}}</text><text class="lv-xp-num">{{jobs}}{{ui.unit}}</text></view><view class="lv-bar"><view class="lv-fill"/></view><view class="lv-tagline"><view class="lv-chip">Lv.{{levelNo}}</view><text class="lv-tag-name">{{name}}</text><text class="lv-tag-done">{{ui.done}}</text></view><view class="lv-result"><view class="lv-medal">✦</view><view class="lv-result-main"><view class="lv-result-title">Lv.{{levelNo}} · {{name}}</view><view class="lv-result-sub">{{ui.jobs}} · {{jobs}}{{ui.unit}}</view></view><view class="lv-plus">{{ui.plus}}</view></view><view class="lv-cta" bindtap="close">{{ui.cta}}<text class="lv-arrow">›</text></view></view></view>

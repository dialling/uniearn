<view wx:if="{{open}}" class="lv-mask" bindtap="close" catchtouchmove="noop"><view class="lv-pop" catchtap="noop"><view class="lv-eyebrow">{{noticeType==='weekly'?'✦ 7 DAY STREAK':'✦ LEVEL UP'}}</view><view class="lv-title">{{noticeType==='weekly'?ui.weekTitle:ui.title}}</view><view class="lv-sub">{{noticeType==='weekly'?ui.weekSub:ui.sub}}</view><view class="lv-stage"><video wx:if="{{noticeType==='level'&&videoSrc&&!videoFailed}}" class="lv-video" src="{{videoSrc}}" autoplay muted loop="{{false}}" controls="{{false}}" show-center-play-btn="{{false}}" show-play-btn="{{false}}" show-fullscreen-btn="{{false}}" show-progress="{{false}}" show-mute-btn="{{false}}" enable-progress-gesture="{{false}}" object-fit="cover" binderror="videoError"/><image wx:if="{{noticeType==='weekly'||videoFailed}}" class="lv-still" src="/assets/yuni-party.png" mode="aspectFit"/></view><view class="lv-xp"><text>{{noticeType==='weekly'?ui.weekPoints:ui.points}}</text><text class="lv-xp-num">{{noticeType==='weekly'?'+':''}}{{noticeType==='weekly'?bonusPoints:points}} {{noticeType==='weekly'?'':'积分'}}</text></view><view wx:if="{{noticeType==='level'}}" class="lv-bar"><view class="lv-fill"/></view><view class="lv-tagline"><view class="lv-chip">Lv.{{levelNo}}</view><text class="lv-tag-name">{{noticeType==='weekly'?'Yuni':name}}</text><text class="lv-tag-done">{{noticeType==='weekly'?ui.weekPoints:ui.done}}</text></view><view class="lv-result"><view class="lv-medal">✦</view><view class="lv-result-main"><view class="lv-result-title">{{noticeType==='weekly'?ui.weekTitle:'Lv.'+levelNo+' · '+name}}</view><view class="lv-result-sub">{{noticeType==='weekly'?'+'+bonusPoints+' 积分':ui.points+' · '+points+' 积分'}}</view></view><view class="lv-plus">{{noticeType==='weekly'?'+20':ui.plus}}</view></view><view class="lv-cta" bindtap="close">{{ui.cta}}<text class="lv-arrow">›</text></view></view></view>

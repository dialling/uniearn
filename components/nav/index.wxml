<view wx:if="{{showCreateSheet}}" class="sheet-backdrop" bindtap="closeCreateSheet"></view>
<view wx:if="{{showCreateSheet}}" class="create-sheet cs-v2" catchtap="stopSheetTap">
 <image class="sheet-yuni" src="/assets/yuni-work.png" mode="aspectFit"/>
 <view class="sheet-handle"></view>
 <view class="sheet-header"><text>{{zh?"你想做什么？":"What do you want to do?"}}</text><view class="sheet-close" hover-class="choice-press" bindtap="closeCreateSheet"><image class="sheet-close-icon" mode="aspectFit" src="{{dark?'/assets/icons/x-light.svg':'/assets/icons/x-muted.svg'}}"/></view></view>
 <view class="sheet-audience">{{zh?"为顾客":"For customers"}}</view>
 <view id="csPickup" class="sheet-choice parcel" data-mode="request" data-category="parcel" hover-class="choice-press" hover-stay-time="90" bindtap="create"><view class="sheet-icon sheet-icon-3d"><image class="nav-sheet-icon" mode="aspectFit" src="/assets/icons3d/pickup.svg"/></view><view class="sheet-copy"><view class="sheet-name">{{zh?"我需要！发布代取":"Post a pick-up"}}</view><view class="sheet-description">{{zh?"请跑手取外卖、拿快递，送到你的门口。":"Food from the gate or a package from the station, delivered to your door."}}</view></view><text class="sheet-arrow">›</text></view>
 <view id="csTask" class="sheet-choice task" data-mode="task" data-category="task" hover-class="choice-press" hover-stay-time="90" bindtap="create"><view class="sheet-icon sheet-icon-3d"><image class="nav-sheet-icon" mode="aspectFit" src="/assets/icons3d/task.svg"/></view><view class="sheet-copy"><view class="sheet-name">{{zh?"其他需求":"Post any task"}}<text class="sheet-new">{{zh?"新":"New"}}</text></view><view class="sheet-description">{{zh?"买枕头、取课本、找老师、代签到…… 想到什么就发什么，时间赏金自己定。":"Need anything else? Post any task with your own time and price."}}</view></view><text class="sheet-arrow">›</text></view>
 <view class="sheet-audience sheet-runner-audience">{{zh?"为跑手":"For runners"}}</view>
 <view id="csTrip" class="sheet-choice trip" data-mode="trip" data-category="parcel" hover-class="choice-press" hover-stay-time="90" bindtap="create"><view class="sheet-icon sheet-icon-3d"><image class="nav-sheet-icon" mode="aspectFit" src="/assets/icons3d/trip.svg"/></view><view class="sheet-copy"><view class="sheet-name">{{zh?"我顺路！发起行程":"Start a trip!"}}<text class="sheet-new sheet-new-trip">{{zh?"新":"New"}}</text></view><view class="sheet-description">{{zh?"刚好去取外卖或快递？顺路帮同学带回来，赚点零花钱。":"Share your trip and earn money along the way."}}</view></view><text class="sheet-arrow">›</text><view class="cs-spark cs-s1"/><view class="cs-spark cs-s2"/><view class="cs-spark cs-s3"/><view class="cs-spark cs-s4"/><view class="cs-spark cs-s5"/></view>
</view>
<level-up/>
<view class="nav {{active==='profile'?'me-nav':''}} {{dark?'nav-dark':''}}">
 <view class="item {{active==='jobs'?'selected':''}}" data-key="jobs" hover-class="nav-press" hover-stay-time="90" bindtap="go"><image class="nav-icon" mode="aspectFit" src="{{active==='jobs'?'/assets/jobs-active.png':'/assets/jobs.png'}}"/><text class="nav-label">{{zh?"接单大厅":"Jobs"}}</text></view>
 <view class="item nav-orders {{active==='requests'?'selected':''}}" data-key="requests" hover-class="nav-press" hover-stay-time="90" bindtap="go"><image class="nav-icon" mode="aspectFit" src="{{active==='requests'?'/assets/orders-active.png':'/assets/orders.png'}}"/><view wx:if="{{hasUnread}}" class="nav-unread-dot" aria-label="{{zh?'有未读消息':'Unread messages'}}"/><text class="nav-label">{{zh?"我的订单":"My orders"}}</text></view>
 <view class="item nav-create" data-key="create" role="button" aria-label="{{zh?'发布':'Post'}}" hover-class="nav-press" hover-stay-time="120" bindtap="go"><view class="plus nav-plus"><image class="plus-icon" mode="aspectFit" src="/assets/icons/plus-white.svg"/></view><text class="nav-label">{{zh?"发布":"Post"}}</text></view>
 <view class="item nav-rewards {{active==='rewards'?'selected':''}}" data-key="rewards" hover-class="nav-press" hover-stay-time="90" bindtap="go"><image class="nav-icon" mode="aspectFit" src="{{active==='rewards'?(dark?'/assets/rewards-blue-dark.svg':'/assets/rewards-blue.svg'):'/assets/rewards.png'}}"/><text class="nav-label">{{zh?"动态":"News"}}</text></view>
 <view class="item nav-me {{active==='profile'?'selected':''}}" data-key="profile" hover-class="nav-press" hover-stay-time="90" bindtap="go"><image class="nav-icon" mode="aspectFit" src="{{active==='profile'?'/assets/profile-green.svg':'/assets/profile.png'}}"/><text class="nav-label">{{zh?"我的":"Me"}}</text></view>
</view>
<coach-tip name="post" when="{{showCreateSheet}}"/>

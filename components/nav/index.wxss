.nav{position:fixed;left:0;right:0;bottom:0;z-index:99;min-height:112rpx;background:#fff;border-top:1rpx solid #e8e8e2;display:flex;align-items:center;justify-content:space-around;padding-bottom:env(safe-area-inset-bottom)}.item{width:125rpx;text-align:center;color:#999;font-size:21rpx;display:flex;flex-direction:column;gap:3rpx}.glyph{font-size:43rpx;line-height:48rpx}.selected{color:#41775b;font-weight:bold}.plus{width:98rpx;height:98rpx;border-radius:50%;background:#ad5a35;color:white;font-size:65rpx;line-height:88rpx;text-align:center;box-shadow:0 5rpx 16rpx #ad5a3555;margin-top:-34rpx;border:7rpx solid white}
.sheet-backdrop{position:fixed;inset:0;background:rgba(0,0,0,.46);z-index:100}.create-sheet{position:fixed;bottom:0;left:0;right:0;z-index:101;background:#fff;border-radius:40rpx 40rpx 0 0;padding:20rpx 34rpx calc(32rpx + env(safe-area-inset-bottom));max-height:78vh;overflow-y:auto;box-shadow:0 -10rpx 35rpx #0002}.sheet-handle{width:80rpx;height:8rpx;background:#d8d7cf;border-radius:20rpx;margin:0 auto 30rpx}.sheet-header{display:flex;justify-content:space-between;align-items:center;font-size:36rpx;font-weight:800;line-height:1.2;margin-bottom:26rpx}.sheet-close{width:62rpx;height:62rpx;border-radius:50%;background:#f3f2ef;text-align:center;line-height:58rpx;font-size:42rpx;font-weight:400}.sheet-choice{display:flex;align-items:center;gap:20rpx;padding:22rpx;border:2rpx solid;border-radius:26rpx;margin:0 0 16rpx;min-height:135rpx}.sheet-choice.parcel{border-color:#c7532b;background:#fbf1eb;color:#c7532b}.sheet-choice.takeaway{border-color:#bc753d;background:#fcf5eb;color:#a85b2c}.sheet-choice.trip{border-color:#41775b;background:#e9f2ef;color:#41775b}.sheet-icon{width:74rpx;height:74rpx;flex:none;border-radius:22rpx;display:flex;align-items:center;justify-content:center}.parcel .sheet-icon{background:#c7532b}.takeaway .sheet-icon{background:#a85b2c}.trip .sheet-icon{background:#41775b}.sheet-icon text{color:white;font-size:40rpx}.sheet-copy{flex:1;min-width:0;color:#242424}.sheet-name{font-size:27rpx;font-weight:800}.sheet-description{font-size:22rpx;color:#74736f;line-height:1.45;margin-top:5rpx}.sheet-arrow{font-size:44rpx}.sheet-soon-heading{display:flex;justify-content:space-between;gap:10rpx;align-items:center;margin:25rpx 0 14rpx;font-size:25rpx;font-weight:700}.sheet-soon-heading text+text{font-size:19rpx;color:#9b9a95;font-weight:400}.sheet-soon-grid{display:flex;gap:10rpx}.soon-tile{flex:1;min-width:0;text-align:center;background:#fafaf8;border:1rpx solid #eeeae3;border-radius:24rpx;padding:17rpx 3rpx;font-size:21rpx}.soon-tile text{display:block;background:#f0efec;border-radius:16rpx;width:52rpx;height:52rpx;line-height:52rpx;color:#92918b;margin:0 auto 12rpx;font-size:27rpx}.soon-label{color:#aaa6a0;margin-top:8rpx;font-size:19rpx}

.nav-icon{display:block;width:44rpx;height:44rpx;margin:0 auto 5rpx;flex:none}.item{align-items:center;justify-content:center}.item text{white-space:nowrap;line-height:29rpx}.selected{color:#ad5a35}.plus{background:#ad5a35}

/* Create menu matched to the final reference. Keep the mascot outside the sheet. */
.create-sheet{overflow:visible;padding:20rpx 38rpx calc(36rpx + env(safe-area-inset-bottom))}
.sheet-yuni{position:absolute;right:38rpx;top:-142rpx;width:150rpx;height:142rpx;pointer-events:none}
.sheet-handle{width:78rpx;height:9rpx;margin-bottom:30rpx}
.sheet-header{font-size:39rpx;margin-bottom:26rpx;gap:20rpx}
.sheet-close{flex:none;width:74rpx;height:74rpx;line-height:70rpx;background:#f0efea}
.sheet-choice{gap:24rpx;padding:26rpx;min-height:122rpx;border-radius:28rpx;margin-bottom:22rpx}
.sheet-choice.parcel{border:1rpx solid #deddd6;background:#fff;color:#ad4920}
.parcel .sheet-icon{background:#ad4920}
.sheet-choice.task{border:2rpx solid #a6afff;background:#f5f5ff;color:#3e4bdc}
.task .sheet-icon{background:#3e4bdc}
.sheet-choice.trip{border:2rpx solid #417b5d;background:#eaf3ee;color:#417b5d;margin-bottom:0}
.trip .sheet-icon{background:#417b5d}
.sheet-icon{width:88rpx;height:88rpx;border-radius:25rpx}
.sheet-icon image{width:40rpx;height:40rpx}
.sheet-name{font-size:29rpx;line-height:1.4}
.sheet-description{font-size:23rpx;line-height:1.55;color:#64635f;margin-top:9rpx}
.sheet-new{display:inline-block;vertical-align:middle;margin-left:10rpx;padding:3rpx 14rpx;border-radius:24rpx;background:#3e4bdc;color:#fff;font-size:20rpx;font-weight:700;line-height:1.45}
.sheet-arrow{font-size:36rpx}
.sheet-soon-heading{margin:32rpx 4rpx 28rpx;color:#55544f;font-size:23rpx;letter-spacing:1rpx}
@media(max-height:650px){.create-sheet{padding-top:12rpx;padding-bottom:calc(20rpx + env(safe-area-inset-bottom))}.sheet-choice{min-height:94rpx;padding:18rpx;margin-bottom:14rpx}.sheet-header{font-size:33rpx;margin-bottom:18rpx}.sheet-handle{margin-bottom:18rpx}.sheet-soon-heading{margin:18rpx 4rpx}.sheet-description{font-size:21rpx}.sheet-yuni{width:124rpx;height:118rpx;top:-118rpx}}

.me-nav .plus{background:#41775b;box-shadow:0 5rpx 20rpx #41775b44}.me-nav .selected{color:#41775b}

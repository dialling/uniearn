.nav{position:fixed;left:0;right:0;bottom:0;z-index:99;min-height:112rpx;background:#fff;border-top:1rpx solid #e2e0d9;display:flex;align-items:center;justify-content:space-around;padding-bottom:env(safe-area-inset-bottom)}.item{width:125rpx;text-align:center;color:#8a877e;font-size:21rpx;display:flex;flex-direction:column;gap:3rpx}.glyph{font-size:43rpx;line-height:48rpx}.selected{color:#0b7a55;font-weight:bold}.plus{width:98rpx;height:98rpx;border-radius:50%;background:#c2410c;color:white;font-size:65rpx;line-height:88rpx;text-align:center;box-shadow:0 5rpx 16rpx #c2410c55;margin-top:-34rpx;border:7rpx solid white}
.sheet-backdrop{position:fixed;inset:0;background:rgba(22,24,28,.46);z-index:100}.create-sheet{position:fixed;bottom:0;left:0;right:0;z-index:101;background:#fff;border-radius:40rpx 40rpx 0 0;padding:20rpx 34rpx calc(32rpx + env(safe-area-inset-bottom));max-height:78vh;overflow-y:auto;box-shadow:0 -10rpx 35rpx #0002}.sheet-handle{width:80rpx;height:8rpx;background:#d6d2c6;border-radius:20rpx;margin:0 auto 30rpx}.sheet-header{display:flex;justify-content:space-between;align-items:center;font-size:36rpx;font-weight:800;line-height:1.2;margin-bottom:26rpx}.sheet-close{width:62rpx;height:62rpx;border-radius:50%;background:#f0efea;text-align:center;line-height:58rpx;font-size:42rpx;font-weight:400}.sheet-choice{display:flex;align-items:center;gap:20rpx;padding:22rpx;border:2rpx solid;border-radius:26rpx;margin:0 0 16rpx;min-height:135rpx}.sheet-choice.parcel{border-color:#dc2626;background:#fff1f0;color:#dc2626}.sheet-choice.takeaway{border-color:#0b7a55;background:#fff1e6;color:#c2410c}.sheet-choice.trip{border-color:#0b7a55;background:#e7f3ed;color:#0b7a55}.sheet-icon{width:74rpx;height:74rpx;flex:none;border-radius:22rpx;display:flex;align-items:center;justify-content:center}.parcel .sheet-icon{background:#dc2626}.takeaway .sheet-icon{background:#c2410c}.trip .sheet-icon{background:#0b7a55}.sheet-copy{flex:1;min-width:0;color:#16181c}.sheet-name{font-size:27rpx;font-weight:800}.sheet-description{font-size:22rpx;color:#6b6860;line-height:1.45;margin-top:5rpx}.sheet-arrow{font-size:44rpx}.sheet-soon-heading{display:flex;justify-content:space-between;gap:10rpx;align-items:center;margin:25rpx 0 14rpx;font-size:25rpx;font-weight:700}.sheet-soon-grid{display:flex;gap:10rpx}.soon-tile{flex:1;min-width:0;text-align:center;background:#fafaf7;border:1rpx solid #e2e0d9;border-radius:24rpx;padding:17rpx 3rpx;font-size:21rpx}.soon-label{color:#c9c5b8;margin-top:8rpx;font-size:19rpx}

.nav-icon{display:block;width:44rpx;height:44rpx;margin:0 auto 5rpx;flex:none}.item{align-items:center;justify-content:center}.item .nav-label{white-space:nowrap;line-height:29rpx}.selected{color:#0b7a55}.plus{background:#c2410c}

/* Create menu matched to the final reference. Keep the mascot outside the sheet. */
.create-sheet{overflow:visible;padding:20rpx 38rpx calc(36rpx + env(safe-area-inset-bottom))}
.sheet-yuni{position:absolute;right:38rpx;top:-142rpx;width:150rpx;height:142rpx;pointer-events:none}
.sheet-handle{width:78rpx;height:9rpx;margin-bottom:30rpx}
.sheet-header{font-size:39rpx;margin-bottom:26rpx;gap:20rpx}
.sheet-audience{margin:0 4rpx 12rpx;color:#6b6860;font-size:22rpx;font-weight:700;letter-spacing:1rpx}
.sheet-runner-audience{margin-top:8rpx}
.sheet-close{flex:none;width:74rpx;height:74rpx;line-height:70rpx;background:#f0efea}
.sheet-choice{gap:24rpx;padding:26rpx;min-height:122rpx;border-radius:28rpx;margin-bottom:22rpx}
.sheet-choice.parcel{border:1rpx solid #dc2626;background:#fff1f0;color:#dc2626}
.parcel .sheet-icon{background:#dc2626}
.sheet-choice.task{border:2rpx solid #9db4f0;background:#e6edfc;color:#1d4ed8}
.task .sheet-icon{background:#1d4ed8}
.sheet-choice.trip{border:2rpx solid #0b7a55;background:#e7f3ed;color:#0b7a55}
.sheet-choice.trip{margin-bottom:0}
.trip .sheet-icon{background:#0b7a55}
.sheet-icon{width:88rpx;height:88rpx;border-radius:25rpx}
.sheet-icon .nav-sheet-icon{width:40rpx;height:40rpx}
.sheet-name{font-size:29rpx;line-height:1.4}
.sheet-description{font-size:23rpx;line-height:1.55;color:#5e5c55;margin-top:9rpx}
.sheet-new{display:inline-block;vertical-align:middle;margin-left:10rpx;padding:3rpx 14rpx;border-radius:24rpx;background:#1d4ed8;color:#fff;font-size:20rpx;font-weight:700;line-height:1.45}
.sheet-arrow{font-size:36rpx}
.sheet-soon-heading{margin:32rpx 4rpx 28rpx;color:#44423c;font-size:23rpx;letter-spacing:1rpx}
@media(max-height:650px){.create-sheet{padding-top:12rpx;padding-bottom:calc(20rpx + env(safe-area-inset-bottom))}.sheet-choice{min-height:94rpx;padding:18rpx;margin-bottom:14rpx}.sheet-header{font-size:33rpx;margin-bottom:18rpx}.sheet-handle{margin-bottom:18rpx}.sheet-soon-heading{margin:18rpx 4rpx}.sheet-description{font-size:21rpx}.sheet-yuni{width:124rpx;height:118rpx;top:-118rpx}}

.me-nav .plus{background:#c2410c;box-shadow:0 5rpx 20rpx #c2410c44}.me-nav .selected{color:#0b7a55}

/* Motion. fill-mode "backwards" leaves no transform behind once finished. */
@keyframes nav-pop{0%{transform:scale(.72)}55%{transform:scale(1.14)}100%{transform:scale(1)}}
@keyframes nav-fade{from{opacity:0}to{opacity:1}}
@keyframes nav-sheet-up{from{transform:translate3d(0,100%,0)}to{transform:translate3d(0,0,0)}}
@keyframes nav-rise{from{opacity:0;transform:translate3d(0,26rpx,0)}to{opacity:1;transform:translate3d(0,0,0)}}
@keyframes nav-yuni{0%{opacity:0;transform:translate3d(0,40rpx,0) rotate(-6deg)}70%{opacity:1;transform:translate3d(0,-6rpx,0) rotate(2deg)}100%{opacity:1;transform:translate3d(0,0,0) rotate(0)}}
.item,.plus,.sheet-choice,.sheet-close{transition:transform .16s ease,opacity .16s ease}
.nav-press{transform:scale(.9);opacity:.8}
.plus.nav-press{transform:scale(.9) rotate(90deg);opacity:1}
.plus{transition:transform .22s cubic-bezier(.3,1.4,.5,1)}
.selected .nav-icon{animation:nav-pop .42s cubic-bezier(.3,1.4,.5,1) backwards}
.selected .nav-label{animation:nav-fade .3s ease-out backwards}
.sheet-backdrop{animation:nav-fade .22s ease-out backwards}
.create-sheet{animation:nav-sheet-up .36s cubic-bezier(.2,.9,.3,1) backwards}
.sheet-yuni{animation:nav-yuni .6s cubic-bezier(.3,1.3,.5,1) .18s backwards}
.sheet-choice{animation:nav-rise .36s cubic-bezier(.22,.8,.3,1) backwards}
.sheet-choice.parcel{animation-delay:.08s}.sheet-choice.task{animation-delay:.13s}.sheet-choice.trip{animation-delay:.2s}
.sheet-choice.choice-press{transform:scale(.98);opacity:.85}
.sheet-close.choice-press{transform:scale(.9)}

/* Dark appearance (Me → Appearance). The bottom bar and the create sheet follow it. */
.nav.nav-dark{background:#242522;border-top-color:#3a3b37}
.nav-dark .item{color:#a9a69c}
.nav-dark .item.selected .nav-label{color:#6fd0a8}
.nav-dark .plus{border-color:#1b1c1a}
.nav-dark .create-sheet{background:#242522;color:#edebe4}
.nav-dark .sheet-handle{background:#3a3b37}
.nav-dark .sheet-close{background:#3a3b37;color:#edebe4}
.nav-dark .sheet-soon-heading{color:#a9a69c}
.nav-dark .sheet-audience{color:#a9a69c}
.nav-dark .sheet-copy{color:#edebe4}
.nav-dark .sheet-description{color:#a9a69c}
.nav-dark .sheet-choice.parcel{background:#3d2020;border-color:#dc2626;color:#fca5a5}
.nav-dark .sheet-choice.task{background:#1f2b4d;border-color:#9db4f0;color:#9db4f0}
.nav-dark .sheet-choice.trip{background:#16332a;border-color:#0b7a55;color:#6fd0a8}

/* Keep the post label aligned with the other navigation labels. */
.nav-create{gap:4rpx;margin-top:-50rpx;color:#c2410c}
.nav-create .plus{margin-top:0;flex:none}
.nav-create.nav-press .plus{transform:rotate(90deg)}
.nav-dark .nav-create{color:#f4a06e}

.nav-orders.selected{color:#c2410c}
.nav-dark .plus{background:#f4a06e;color:#16181c}
.nav-dark .nav-orders.selected .nav-label{color:#f4a06e}
.selected .nav-icon{filter:brightness(0) saturate(100%) invert(45.37%) sepia(2.50%) saturate(5078.05%) hue-rotate(108.73deg) brightness(95.70%) contrast(196.17%)}
.nav-orders.selected .nav-icon{filter:brightness(0) saturate(100%) invert(39.60%) sepia(48.26%) saturate(6193.06%) hue-rotate(360.00deg) brightness(78.82%) contrast(90.52%)}
.nav-dark .selected .nav-icon{filter:brightness(0) saturate(100%) invert(86.63%) sepia(18.71%) saturate(1169.50%) hue-rotate(87.84deg) brightness(104.89%) contrast(63.13%)}
.nav-dark .nav-orders.selected .nav-icon{filter:brightness(0) saturate(100%) invert(59.78%) sepia(38.64%) saturate(509.16%) hue-rotate(338.62deg) brightness(106.84%) contrast(95.57%)}

/* Stroke icons replace the text glyphs, so they stay sharp and centred at any size. */
.plus{display:flex;align-items:center;justify-content:center;line-height:0}
.plus-icon{width:42rpx;height:42rpx;display:block}
.sheet-close{display:flex;align-items:center;justify-content:center}
.sheet-close-icon{width:30rpx;height:30rpx;display:block}

/* The close mark unfolds from a plus, echoing the morph the icon set is built for. */
@keyframes sheet-close-unfold{from{opacity:0;transform:rotate(-45deg) scale(.55)}to{opacity:1;transform:rotate(0) scale(1)}}
.sheet-close-icon{transform-origin:50% 50%;animation:sheet-close-unfold .3s cubic-bezier(.3,1.4,.5,1) backwards}

/* Preserve the reference's slot sizes: compact second option, larger third option. */
.create-sheet .sheet-choice{box-sizing:border-box;width:100%;height:184rpx;min-height:184rpx;padding:18rpx 22rpx;gap:20rpx;border-width:2rpx;flex-shrink:0}
.create-sheet .sheet-choice.trip{height:220rpx;min-height:220rpx}
.create-sheet .sheet-icon{box-sizing:border-box;width:80rpx;height:80rpx;flex:0 0 80rpx;border-radius:22rpx}
.create-sheet .sheet-icon .nav-sheet-icon{width:40rpx;height:40rpx}
.create-sheet .sheet-name{font-size:27rpx;line-height:1.4}
.create-sheet .sheet-description{font-size:21rpx;line-height:1.4;margin-top:7rpx}
@media(max-height:650px){.create-sheet .sheet-choice{padding:16rpx 18rpx;gap:18rpx}}

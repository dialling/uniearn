<view wx:if="{{guidance && tips && !floating}}" class="guidance {{topic==='runner'?'runner-guidance':''}}"><image class="ya-avatar" src="/assets/yuni-{{guidePose}}.png" mode="aspectFit"/><view class="guide-bubble"><view class="green">Yuni · {{zh?'第 '+step+' / 3 步':'step '+step+' of 3'}}</view><view>{{guidance}}</view><view class="green how" bindtap="openHelp">{{zh?'如何使用？':'How does it work?'}} ›</view></view></view>
<!-- Yuni 悬浮入口暂时停用，保留组件逻辑供以后恢复。 -->
<block wx:if="{{event}}"><view wx:if="{{!event.small}}" class="event-shade" bindtap="closeEvent"/><view wx:if="{{!event.small}}" class="event-card" bindtap="closeEvent"><image class="ya-event-avatar" src="/assets/yuni-{{event.pose}}.png" mode="aspectFit"/><view class="event-title">{{event.title}}</view><view class="event-text">{{event.text}}</view></view><view wx:if="{{toast}}" class="event-toast" bindtap="closeEvent"><image class="ya-toast-avatar" src="/assets/yuni-{{event.pose}}.png" mode="aspectFit"/><text>{{event.title}} {{event.text}}</text></view></block>
<block wx:if="{{helpOpen}}"><view class="help-shade" bindtap="closeHelp"/><view class="help-sheet" catchtap="noop"><view class="sheet-head"><image class="ya-sheet-avatar" src="/assets/yuni-wave.png" mode="aspectFit"/><view><view class="green">{{zh?'Yuni 为你解释':'Yuni explains'}}</view><view class="sheet-title">{{helpTitle}}</view></view><view class="close" hover-class="ya-press" bindtap="closeHelp">×</view></view><scroll-view scroll-y class="sheet-content"><view class="summary">{{helpSummary}}</view><view class="label">{{zh?'使用方法':'HOW IT WORKS'}}</view><view wx:for="{{steps}}" wx:key="index" class="step"><text class="ya-step-n">{{index+1}}</text><view>{{item}}</view></view><view class="label">{{zh?'常见问题':'QUESTIONS'}}</view><view wx:for="{{questions}}" wx:key="id" class="question"><view class="question-title" data-id="{{item.id}}" bindtap="toggle"><text>{{item.title}}</text><text class="ya-q-toggle">{{expanded[item.id]?'−':'+'}}</text></view><view wx:if="{{expanded[item.id]}}" class="answer">{{item.answer}}</view></view><view class="still" hover-class="ya-press" bindtap="support">{{zh?'仍有问题？联系 Uniearn':'Still stuck? Chat with Uniearn'}}</view></scroll-view><button class="got" bindtap="closeHelp">{{zh?'知道了':'Got it'}}</button></view></block>
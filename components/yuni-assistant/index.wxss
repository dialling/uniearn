.guidance{display:flex;gap:20rpx;margin:20rpx 0 25rpx;align-items:center}.guidance>.ya-avatar{width:78rpx;height:95rpx;flex:none}.guide-bubble{border:1rpx solid #d0e3d7;background:#f4faf6;border-radius:28rpx;padding:22rpx;line-height:1.55;font-size:25rpx;flex:1}.green{color:#41775b;font-weight:750;font-size:22rpx}.how{margin-top:18rpx}.ask{position:fixed;right:22rpx;bottom:calc(150rpx + env(safe-area-inset-bottom));z-index:98;display:flex;align-items:center;gap:12rpx;padding:6rpx 20rpx 6rpx 10rpx;background:#fff;border:1rpx solid #d0e3d7;border-radius:70rpx;box-shadow:0 8rpx 24rpx #0002;color:#41775b;font-size:24rpx;font-weight:750}.ask .ya-ask-avatar{width:64rpx;height:73rpx}.event-shade,.help-shade{position:fixed;inset:0;background:#0006;z-index:200}.event-card{position:fixed;z-index:201;top:26%;left:55rpx;right:55rpx;background:#fff;border-radius:45rpx;padding:150rpx 32rpx 38rpx;text-align:center;box-shadow:0 20rpx 45rpx #0003}.event-card .ya-event-avatar{position:absolute;top:-65rpx;left:50%;transform:translateX(-50%);width:170rpx;height:200rpx}.event-title{font-size:38rpx;font-weight:800;line-height:1.3;margin:12rpx 0 24rpx}.event-text{font-size:27rpx;color:#595b53;line-height:1.5}.event-toast{position:fixed;z-index:202;left:36rpx;right:36rpx;bottom:calc(180rpx + env(safe-area-inset-bottom));background:#17191c;color:#fff;border-radius:25rpx;display:flex;align-items:center;gap:20rpx;padding:16rpx;font-size:24rpx;line-height:1.5;box-shadow:0 15rpx 40rpx #0003}.event-toast .ya-toast-avatar{width:57rpx;height:67rpx;background:white;border-radius:14rpx;flex:none}.help-sheet{position:fixed;left:0;right:0;bottom:0;z-index:210;background:white;border-radius:40rpx 40rpx 0 0;padding:0 38rpx calc(26rpx + env(safe-area-inset-bottom));max-height:85vh}.sheet-head{display:flex;align-items:center;gap:22rpx;min-height:108rpx;position:relative;padding-left:135rpx}.sheet-head>.ya-sheet-avatar{position:absolute;left:5rpx;bottom:6rpx;width:100rpx;height:140rpx}.sheet-title{font-size:35rpx;font-weight:800;margin-top:8rpx}.close{margin-left:auto;width:66rpx;height:66rpx;border-radius:50%;background:#efeee9;text-align:center;line-height:62rpx;font-size:43rpx;flex:none}.sheet-content{max-height:57vh}.summary{background:#e9f3ed;border-radius:22rpx;padding:22rpx;margin:15rpx 0 30rpx;font-size:26rpx;line-height:1.5}.label{font-size:21rpx;color:#929086;font-weight:750;letter-spacing:1rpx;margin:30rpx 0 22rpx}.step{display:flex;align-items:flex-start;gap:20rpx;font-size:26rpx;line-height:1.55;margin:20rpx 0}.step>.ya-step-n{background:#41775b;color:white;border-radius:50%;width:41rpx;height:41rpx;text-align:center;line-height:41rpx;flex:none;font-weight:750}.question{border-top:1rpx solid #eeeee8}.question-title{display:flex;justify-content:space-between;gap:15rpx;font-size:25rpx;font-weight:750;padding:25rpx 0}.question-title>.ya-q-toggle{color:#929086}.answer{font-size:24rpx;color:#64665d;line-height:1.6;padding-bottom:22rpx}.still{text-align:center;color:#41775b;font-weight:750;font-size:25rpx;padding:30rpx 0;border-top:1rpx solid #eeeee8}.got{background:#17191c;color:#fff;border-radius:24rpx;font-size:27rpx;font-weight:750;margin:16rpx 0 0;padding:23rpx}
/* Motion. fill-mode "backwards" leaves no transform behind once finished. */
@keyframes ya-fade{from{opacity:0}to{opacity:1}}
@keyframes ya-sheet{from{transform:translate3d(0,100%,0)}to{transform:translate3d(0,0,0)}}
@keyframes ya-pop{0%{opacity:0;transform:translate3d(0,30rpx,0) scale(.92)}70%{opacity:1;transform:translate3d(0,-4rpx,0) scale(1.01)}100%{opacity:1;transform:translate3d(0,0,0) scale(1)}}
@keyframes ya-toast{from{opacity:0;transform:translate3d(0,30rpx,0)}to{opacity:1;transform:translate3d(0,0,0)}}
@keyframes ya-rise{from{opacity:0;transform:translate3d(0,18rpx,0)}to{opacity:1;transform:translate3d(0,0,0)}}
@keyframes ya-bounce{0%{opacity:0;transform:translate(-50%,40rpx) scale(.8)}65%{opacity:1;transform:translate(-50%,-10rpx) scale(1.04)}100%{opacity:1;transform:translate(-50%,0) scale(1)}}
@keyframes ya-float{0%,100%{transform:translate3d(0,0,0)}50%{transform:translate3d(0,-6rpx,0)}}
.guidance{animation:ya-rise .4s ease-out backwards}.guidance>.ya-avatar{animation:ya-float 3.4s ease-in-out .4s infinite}
.ask{animation:ya-pop .45s cubic-bezier(.3,1.3,.5,1) .3s backwards;transition:transform .16s ease,opacity .16s ease}
.ya-press{transform:scale(.94);opacity:.85}
.event-shade,.help-shade{animation:ya-fade .22s ease-out backwards}
.event-card{animation:ya-pop .42s cubic-bezier(.3,1.3,.5,1) backwards}
.event-card .ya-event-avatar{animation:ya-bounce .6s cubic-bezier(.3,1.3,.5,1) .12s backwards}
.event-toast{animation:ya-toast .34s cubic-bezier(.2,.9,.3,1.15) backwards}
.help-sheet{animation:ya-sheet .36s cubic-bezier(.2,.9,.3,1) backwards}
.step{animation:ya-rise .32s ease-out backwards}.step:nth-child(4){animation-delay:.06s}.step:nth-child(5){animation-delay:.12s}.step:nth-child(6){animation-delay:.18s}
.answer{animation:ya-fade .25s ease-out backwards}
.question-title>.ya-q-toggle{transition:transform .2s ease}
.close,.got,.still{transition:transform .16s ease,opacity .16s ease}

.trip-ask{bottom:calc(170rpx + env(safe-area-inset-bottom));z-index:20}

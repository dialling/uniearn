/* more scenes (2026-11-15): cherry blossom, snowfall, starry night, rainbow sky */
.ys-rainbow,.ys-moon,.ys-fall{display:none;position:absolute;pointer-events:none}
.ys-fall{left:0;top:0;right:0;bottom:300rpx;overflow:hidden}

.ys-fishshadow.circling{animation:ys-circle var(--circle,4s) ease-in-out both}
.ys-fishshadow.hooked{animation:ys-hooked .12s ease-in-out infinite alternate;transform:translate(-10rpx,60rpx) rotate(70deg) scale(1.6)}
.ys-fishshadow.flee{transition:transform .65s ease-in,opacity .65s;transform:translate(-420rpx,260rpx) scale(1.5);opacity:0}
.ys-line{position:absolute;height:2rpx;transform-origin:0 50%;z-index:4;pointer-events:none}
.ys-bob{position:absolute;width:0;height:0;z-index:5;pointer-events:none;transition:left .65s linear,top .65s cubic-bezier(.3,-.7,.75,1)}
.ys-bob-img{position:absolute;left:-28rpx;top:-40rpx;width:56rpx;height:70rpx;background-size:100% 100%}
.ys-bob.bobbing .ys-bob-img{animation:var(--ue-animation,ys-bobber 1.6s ease-in-out infinite)}
.ys-bob.nibble .ys-bob-img{animation:ys-nibble .28s ease-in-out}
.ys-bob.dip .ys-bob-img{animation:ys-dip .22s ease-in-out infinite alternate}
.ys-bob.gone .ys-bob-img{opacity:0}
.ys-bang{position:absolute;left:-14rpx;top:-110rpx;font-size:56rpx;font-weight:900;color:#ffe08a;text-shadow:0 3rpx 0 #1c2a5488;animation:ys-pulse .2s ease-in-out infinite alternate}
.ys-splash{position:absolute;width:0;height:0;z-index:6;pointer-events:none}
.ys-ring{position:absolute;left:-10rpx;top:-4rpx;width:20rpx;height:8rpx;border:3rpx solid #fff;border-radius:50%;animation:ys-ring .9s ease-out both}
.ys-ring2{animation-duration:.7s}
.ys-drop{position:absolute;left:-6rpx;top:-6rpx;width:12rpx;height:12rpx;border-radius:50%;background:#fff;animation:ys-drop .6s ease-out both}
.ys-d1{--dx:-50rpx;--dy:-70rpx}.ys-d2{--dx:44rpx;--dy:-84rpx}.ys-d3{--dx:-18rpx;--dy:-104rpx}.ys-d4{--dx:70rpx;--dy:-48rpx}
.ys-prize{position:absolute;left:0;top:0;width:0;height:0;z-index:10;pointer-events:none;animation:ys-prize .86s cubic-bezier(.3,.1,.4,1) both}
.ys-prize-feed{animation-name:ys-prize-feed;animation-duration:.76s}

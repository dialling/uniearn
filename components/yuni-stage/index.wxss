@keyframes ys-whirl{0%{transform:translateY(0) scale(1)}12%{transform:translateY(10rpx) scale(1.14,.84)}28%{transform:translateY(-130rpx) scale(.94,1.08)}37%{transform:translateY(-160rpx) scale(-1,1.04)}46%{transform:translateY(-175rpx) scale(1,1.04)}55%{transform:translateY(-170rpx) scale(-1,1.04)}64%{transform:translateY(-150rpx) scale(1,1.04)}78%{transform:translateY(0) scale(1.16,.82)}88%{transform:translateY(-18rpx) scale(.97,1.04)}100%{transform:translateY(0) scale(1)}}
@keyframes ys-whirlb{0%{transform:translateY(0) scale(1)}12%{transform:translateY(10rpx) scale(1.14,.84)}28%{transform:translateY(-130rpx) scale(.94,1.08)}37%{transform:translateY(-160rpx) scale(-1,1.04)}46%{transform:translateY(-175rpx) scale(1,1.04)}55%{transform:translateY(-170rpx) scale(-1,1.04)}64%{transform:translateY(-150rpx) scale(1,1.04)}78%{transform:translateY(0) scale(1.16,.82)}88%{transform:translateY(-18rpx) scale(.97,1.04)}100%{transform:translateY(0) scale(1)}}
@keyframes ys-shake{0%,100%{transform:none}20%{transform:translate(-7rpx,4rpx)}40%{transform:translate(6rpx,-5rpx)}60%{transform:translate(-5rpx,3rpx)}80%{transform:translate(3rpx,-2rpx)}}
@keyframes ys-flash{0%{transform:translate(-50%,-50%) scale(.3);opacity:1}100%{transform:translate(-50%,-50%) scale(1.5);opacity:0}}
@keyframes ys-slapring{0%{transform:translate(-50%,-50%) scale(.3);opacity:1}100%{transform:translate(-50%,-50%) scale(calc(3.2 * var(--s,1)));opacity:0}}
@keyframes ys-star{0%{transform:translate(-50%,-50%) scale(.4) rotate(0);opacity:0}15%{opacity:1}100%{transform:translate(calc(-50% + var(--dx)),calc(-50% + var(--dy))) scale(.5) rotate(var(--rot));opacity:0}}
@keyframes ys-combo{0%{transform:translate(-50%,-50%) scale(2.6) rotate(-14deg);opacity:0}22%{transform:translate(-50%,-50%) scale(.9) rotate(-8deg);opacity:1}34%{transform:translate(-50%,-50%) scale(1.08) rotate(-8deg)}72%{transform:translate(-50%,-60%) scale(1) rotate(-8deg);opacity:1}100%{transform:translate(-50%,-150%) scale(.9) rotate(-8deg);opacity:0}}
@keyframes ys-whirlfx{0%{transform:translate(-50%,-50%) scaleY(.26) rotate(0) scale(.6);opacity:0}15%{opacity:1}100%{transform:translate(-50%,-50%) scaleY(.26) rotate(900deg) scale(1.15);opacity:0}}
@keyframes ys-spark{0%{transform:translate(-50%,-50%) scale(.3);opacity:0}20%{opacity:1}100%{transform:translate(calc(-50% + var(--dx)),calc(-50% + var(--dy))) scale(1) rotate(200deg);opacity:0}}
@keyframes ys-dust{0%{transform:translate(-50%,-50%) scale(.4);opacity:.9}100%{transform:translate(calc(-50% + var(--dx)),calc(-50% + var(--dy))) scale(1.6);opacity:0}}
.ys-still .ys-shake{animation:none}

/* 2026-11-16: sound on/off, a round speaker above the Shop button */
.ys-sound-btn{position:absolute;right:24rpx;bottom:172rpx;z-index:5;width:72rpx;height:72rpx;display:flex;align-items:center;justify-content:center;border-radius:50%;background:#fff;box-shadow:0 5rpx 0 #1c2a5422}
.ys-sound-btn .ys-img{width:46rpx;height:46rpx}
.ys-sound-btn.is-off{background:#eef0f5}

/* 2026-11-16: fishing timing bar. A navy rope track, a green sweet spot, and a red-and-white float as the marker. */
.ys-meter{position:absolute;left:50%;top:12%;z-index:9;width:76%;transform:translateX(-50%);display:flex;flex-direction:column;align-items:center;gap:12rpx;pointer-events:none}
.ys-meter-label{padding:6rpx 20rpx;border-radius:99rpx;background:#fff;color:#1c2a54;font-size:24rpx;font-weight:800;box-shadow:0 4rpx 0 rgba(28,42,84,.18)}
.ys-meter-track{position:relative;width:100%;height:34rpx;border-radius:99rpx;background:linear-gradient(180deg,#2a3a6b,#1c2a54);border:5rpx solid #fff;box-sizing:border-box;box-shadow:0 6rpx 0 rgba(28,42,84,.25),inset 0 4rpx 6rpx rgba(0,0,0,.25)}
.ys-meter-zone{position:absolute;top:0;bottom:0;border-radius:99rpx;background:linear-gradient(180deg,#7fe9b8,#14a26c);box-shadow:0 0 14rpx rgba(127,233,184,.8)}
/* the marker layer spans the track; it slides with a GPU transform (translateX of its own width = the track), not left, so it stays smooth while the scene updates */
.ys-meter-mark{position:absolute;top:50%;left:0;right:0;height:0;will-change:transform;transform:translate3d(0,0,0);backface-visibility:hidden}
.ys-meter-mark.is-run{animation:ys-slide var(--leg,700ms) linear 4 alternate both}
.ys-meter-float{position:absolute;left:-17rpx;top:-30rpx;width:34rpx;height:60rpx;border-radius:17rpx;background:linear-gradient(180deg,#ff5a5f 0%,#ff5a5f 48%,#ffffff 52%,#ffffff 100%);border:4rpx solid #1c2a54;box-sizing:border-box;box-shadow:0 4rpx 0 rgba(28,42,84,.3)}
.ys-meter-hit .ys-meter-zone{animation:ys-zonehit .5s ease-out}
.ys-meter-hit .ys-meter-label{background:#14a26c;color:#fff}
.ys-meter-miss .ys-meter-label{background:#fff1e6;color:#b4501f}
.ys-meter-miss .ys-meter-float{filter:grayscale(.7)}
@keyframes ys-slide{from{transform:translate3d(0,0,0)}to{transform:translate3d(100%,0,0)}}
@keyframes ys-zonehit{0%{box-shadow:0 0 0 rgba(127,233,184,1)}40%{box-shadow:0 0 40rpx rgba(127,233,184,1);transform:scaleY(1.25)}100%{box-shadow:0 0 14rpx rgba(127,233,184,.8);transform:none}}
.ys-meter-mark.is-paused{animation-play-state:paused}

/* 2026-11-16: fishing bucket, opposite the fish book on the other side of Cast */
.ys-bucket-btn{position:absolute;right:36rpx;top:60rpx;display:flex;flex-direction:column;align-items:center;color:#fff;font-size:21rpx;font-weight:800;font-variant-numeric:tabular-nums}
.ys-bucket-btn .ys-img{width:84rpx;height:84rpx}
.ys-bucket-btn.has-fish .ys-img{filter:drop-shadow(0 0 10rpx rgba(255,224,138,.9))}
.ys-bucket-btn.is-bump .ys-img{animation:ys-bucketbump .42s cubic-bezier(.3,1.6,.5,1)}
@keyframes ys-bucketbump{0%{transform:scale(1)}35%{transform:scale(1.22,.86)}70%{transform:scale(.94,1.08)}100%{transform:scale(1)}}

/* 2026-11-16: very rare coupon catch. A gold ticket card with a notched edge and the coupon face stamped big. */
.ys-card-coupon{position:absolute;overflow:visible;background:linear-gradient(160deg,#fff6d6 0%,#ffe08a 60%,#f2b233 100%);border:4rpx solid #fff;box-shadow:0 14rpx 0 rgba(122,78,0,.25),0 0 40rpx rgba(255,224,138,.9);animation:ys-pop .32s cubic-bezier(.3,1.5,.5,1),ys-couponglow 1.6s ease-in-out .4s infinite}
.ys-card-coupon::before,.ys-card-coupon::after{content:'';position:absolute;top:50%;width:30rpx;height:30rpx;margin-top:-15rpx;border-radius:50%;background:rgba(11,122,85,.85)}
.ys-card-coupon::before{left:-17rpx}.ys-card-coupon::after{right:-17rpx}
.ys-card-face{font-size:76rpx;font-weight:900;line-height:1;color:#7a4e00;letter-spacing:-2rpx;text-shadow:0 3rpx 0 #fff}
.ys-card-coupon .ys-img{width:270rpx;height:142rpx;margin:2rpx 0 -6rpx}
.ys-card-coupon .ys-card-name{color:#5a3a00}
.ys-card-coupon .ys-card-sub{color:#6b4a10;font-weight:700}
.ys-card-coupon .ys-card-pts{background:#0b7a55;color:#fff}
@keyframes ys-couponglow{0%,100%{box-shadow:0 14rpx 0 rgba(122,78,0,.25),0 0 30rpx rgba(255,224,138,.7)}50%{box-shadow:0 14rpx 0 rgba(122,78,0,.25),0 0 60rpx rgba(255,224,138,1)}}

/* 2026-11-16: Share and My coupons on the coupon card */
.ys-card-actions{display:flex;gap:12rpx;margin-top:14rpx}
.ys-card-share,.ys-card-view{flex:1;height:64rpx;line-height:64rpx;border-radius:99rpx;font-size:23rpx;font-weight:800;text-align:center}
.ys-card-share{background:#0b7a55;color:#fff;box-shadow:0 5rpx 0 #08603f}
.ys-card-view{background:#fff;color:#5a3a00}
.ys-card-coupon .ys-card-pts{background:transparent;color:#6b4a10;padding:0;font-size:21rpx;font-weight:700}

/* 2026-11-16: the eagle friend perches beside Yuni (in the anchor, so it bobs with the floe) */
/* 2026-11-16: the eagle soars a 20 s loop across the sky (right, then back left), swooping down beside Yuni at 60% */
/* free flight: position comes from code (a transform transition per leg); facing and tilt ease smoothly */
.ys-friend{position:absolute;left:0;top:0;width:220rpx;height:132rpx;z-index:4;will-change:transform;transform:translate3d(-240rpx,180rpx,0)}
.ys-friend-face{width:100%;height:100%;transition:transform .35s ease-in-out}
.ys-friend-tilt{width:100%;height:100%;transition:transform .7s ease-in-out}
.ys-friend-trick{position:relative;width:100%;height:100%}
.ys-friend-trick.is-loop{animation:ys-loop 1.05s cubic-bezier(.4,0,.2,1)}
.ys-eg{position:absolute;left:0;top:0;width:100%;height:100%}
.ys-eg-near,.ys-eg-far{transform-origin:50% 46.7%}
/* gliding: wings held up with a slow sway; flapping: quick strong beats */
.ys-eg-near{animation:var(--ue-animation,ys-glide 3.2s ease-in-out infinite)}
.ys-eg-far{animation:var(--ue-animation,ys-glide 3.2s ease-in-out .08s infinite)}
.ys-friend.is-flap .ys-eg-near{animation:var(--ue-animation,ys-beat .5s ease-in-out infinite)}
.ys-friend.is-flap .ys-eg-far{animation:var(--ue-animation,ys-beat .5s ease-in-out .04s infinite)}
@keyframes ys-glide{0%,100%{transform:rotate(-4deg)}50%{transform:rotate(3deg)}}
@keyframes ys-beat{0%,100%{transform:rotate(2deg)}45%{transform:rotate(-56deg)}}
@keyframes ys-loop{0%{transform:rotate(0) translateY(0)}50%{transform:rotate(-200deg) translateY(-40rpx) scale(1.1)}100%{transform:rotate(-360deg) translateY(0)}}
.ys-still .ys-friend{animation:none;transform:translate(470rpx,170rpx)}
.ys-still .ys-friend-face,.ys-still .ys-eg-near,.ys-still .ys-eg-far{animation:none}
/* the dive: perch -> water (grab) -> bucket, with the fish appearing under the eagle after the grab */
.ys-eagle-dive{position:absolute;left:0;top:0;width:0;height:0;z-index:12;pointer-events:none;animation:ys-dive 1.7s cubic-bezier(.45,.05,.4,1) both}
.ys-eagle-bird{position:absolute;left:-110rpx;top:-70rpx;width:220rpx;height:132rpx}
.ys-eagle-fish{position:absolute;left:-50rpx;top:20rpx;width:100rpx;height:52rpx;opacity:0;animation:ys-divefish 1.7s linear both}
@keyframes ys-dive{0%{transform:translate(var(--sx),var(--sy)) scale(1)}42%{transform:translate(var(--wx),var(--wy)) scale(1.15) rotate(12deg)}52%{transform:translate(var(--wx),calc(var(--wy) - 30px)) scale(1.1)}100%{transform:translate(var(--tx),var(--ty)) scale(.7)}}
@keyframes ys-divefish{0%,44%{opacity:0}48%,92%{opacity:1}100%{opacity:0}}

/* 2026-11-16: resting on Yuni's hat: upright, wings folded along the body, a small settle and breathing */
.ys-friend.is-perch .ys-friend-tilt{transform:rotate(-55deg)!important;transition:transform .5s ease-out}
.ys-friend.is-perch .ys-eg-near,.ys-friend.is-perch .ys-eg-far{animation:ys-fold .5s ease-out both,ys-eg-breathe 3s ease-in-out .5s infinite}
.ys-friend.is-perch .ys-friend-trick{animation:ys-settle .45s cubic-bezier(.3,1.5,.5,1)}
@keyframes ys-fold{from{transform:rotate(-20deg)}to{transform:rotate(-40deg) scale(.8)}}
@keyframes ys-eg-breathe{0%,100%{transform:rotate(-40deg) scale(.8)}50%{transform:rotate(-37deg) scale(.82)}}
@keyframes ys-settle{0%{transform:translateY(-10rpx)}60%{transform:translateY(4rpx)}100%{transform:none}}

/* 2026-11-16: today's dried fish waits on the Feed button; tapping opens the Feed Yuni sheet */
/* 2026-11-16: high five, dance and spin grouped (one spotlight in the Yuni guide). Basis = 2 gaps (28rpx) + 3 buttons side padding (24rpx), so all five buttons stay the same width. */
.ys-trio{flex-grow:3;flex-shrink:1;flex-basis:52rpx;min-width:0;display:flex;gap:14rpx}
/* 2026-11-17: a dried fish or a fish from an order is waiting: the Feed count turns amber and gives a soft pulse (no second fish picture) */
.ys-count-gift{background:#ff9d2e;color:#fff;box-shadow:0 0 0 4rpx #fff;animation:var(--ue-animation,ys-count-pulse 1.8s ease-in-out infinite)}
.ys-still .ys-count-gift{animation:none}
@keyframes ys-count-pulse{0%,100%{transform:scale(1)}50%{transform:scale(1.14)}}
.ys-pts-bump{animation:var(--ue-animation,ys-pts-pop .6s cubic-bezier(.3,1.6,.5,1))}
@keyframes ys-pts-pop{0%{transform:scale(1)}35%{transform:scale(1.16)}100%{transform:scale(1)}}
/* 2026-11-18: catch = the fish leaps into the card first, then flies from the card into the bucket. */
.ys-prize-leap{animation:ys-prize-leap .56s cubic-bezier(.25,.8,.35,1) both}
.ys-prize-stash{z-index:12;animation:ys-prize-stash .7s cubic-bezier(.45,0,.6,1) both}
@keyframes ys-prize-leap{0%{transform:translate(var(--fx),var(--fy)) rotate(-70deg) scale(.6)}60%{transform:translate(calc(var(--fx) * .3 + var(--sx) * .7),calc(var(--sy) - 60rpx)) rotate(12deg) scale(1.5)}100%{transform:translate(var(--sx),var(--sy)) rotate(0) scale(1.375)}}
@keyframes ys-prize-stash{0%{transform:translate(var(--sx),var(--sy)) rotate(0) scale(1.375)}30%{transform:translate(var(--sx),calc(var(--sy) - 34rpx)) rotate(-14deg) scale(1.45)}100%{transform:translate(var(--tx),var(--ty)) rotate(30deg) scale(.45)}}
.ys-card.is-leaving{animation:ys-card-leave .32s ease-in both}
.ys-card.is-leaving .ys-img{opacity:0}
@keyframes ys-card-leave{from{opacity:1;transform:scale(1)}to{opacity:0;transform:scale(.92)}}

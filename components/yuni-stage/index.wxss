/* Yuni's stage (2026-11-15). Design: design/me-preview/index.html */
.ys{--navy:#1c2a54;--gold:#f2b233;--sea:#0b7a55;--deep:#085c41;--foam:#e7f3ed;color:#16181c}
.ys-stage{position:relative;height:820rpx;overflow:hidden;background:var(--sky)}
.ys-night{position:absolute;left:0;top:0;right:0;bottom:0;background:linear-gradient(#131d3f,#27407a 70%);opacity:0;transition:opacity 1.6s}
.ys-asleep .ys-night{opacity:.86}
.ys-sun{position:absolute;right:72rpx;top:150rpx;width:96rpx;height:96rpx;border-radius:50%;background:radial-gradient(circle at 38% 36%,#ffe9a8,#f2b233);box-shadow:0 0 0 22rpx #f2b23326,0 0 0 46rpx #f2b23314}
.ys-asleep .ys-sun,.ys-sc-aurora .ys-sun{background:radial-gradient(circle at 38% 36%,#fff,#dfe6ff);box-shadow:0 0 0 22rpx #ffffff1c}
.ys-sc-sunset .ys-sun{top:230rpx;right:110rpx;width:130rpx;height:130rpx;background:radial-gradient(circle at 40% 36%,#fff3c2,#ff9a3d);box-shadow:0 0 0 24rpx #ffb45c33,0 0 0 56rpx #ffb45c1a}
.ys-cloud{position:absolute;height:36rpx;border-radius:36rpx;background:#ffffffd9;animation:var(--ue-animation,ys-drift 46s linear infinite)}
.ys-c1{top:150rpx;width:130rpx;left:-140rpx}.ys-c2{top:230rpx;width:92rpx;left:-100rpx;animation-duration:64s;animation-delay:-30s;opacity:.8}
.ys-sc-aurora .ys-cloud{opacity:.25}
.ys-berg{position:absolute;bottom:278rpx;background:linear-gradient(var(--berg-a),var(--berg-b));clip-path:polygon(0 100%,22% 30%,38% 52%,58% 0,78% 44%,100% 100%)}
.ys-b1{left:-28rpx;width:290rpx;height:142rpx}.ys-b2{right:-50rpx;width:366rpx;height:186rpx;opacity:.9}
.ys-sc-lagoon .ys-berg{display:none}
.ys-island{display:none;position:absolute;right:-18rpx;bottom:290rpx;width:270rpx;height:216rpx}
.ys-sc-lagoon .ys-island{display:block}
.ys-aurora{display:none;position:absolute;left:0;top:0;right:0;bottom:0}
.ys-sc-aurora .ys-aurora{display:block}
.ys-au1,.ys-au2{position:absolute;left:-20%;width:140%;height:160rpx;top:120rpx;border-radius:50%;background:linear-gradient(90deg,transparent,#5dffb0aa 30%,#7fb6ffaa 60%,transparent);filter:blur(28rpx);animation:var(--ue-animation,ys-aurora 7s ease-in-out infinite alternate)}
.ys-au2{top:210rpx;height:120rpx;background:linear-gradient(90deg,transparent,#b98bffaa 40%,#5dffd0aa 70%,transparent);animation-duration:9s;animation-direction:alternate-reverse}
.ys-sea{position:absolute;left:0;right:0;bottom:0;height:308rpx;background:linear-gradient(var(--sea-a),var(--sea-b) 55%,var(--sea-c))}
.ys-wave{position:absolute;left:0;top:-16rpx;width:200%;height:32rpx;background-image:var(--wave);background-size:180rpx 32rpx;background-repeat:repeat-x;animation:var(--ue-animation,ys-swell 7s linear infinite)}
.ys-wave2{top:60rpx;opacity:.3;animation-duration:11s;animation-direction:reverse;filter:brightness(2.2)}

/* Yuni: every layer fills the same box */
.ys-anchor{position:absolute;left:50%;bottom:170rpx;width:0;height:0;animation:var(--ue-animation,ys-bob 4.6s ease-in-out infinite)}
.ys-ride-img{position:absolute;left:-200rpx;top:-50rpx;width:400rpx;height:117rpx;background-size:100% 100%;background-repeat:no-repeat;pointer-events:none}
.ys-shadow{position:absolute;left:-100rpx;top:-16rpx;width:200rpx;height:34rpx;border-radius:50%;background:#1c2a5426}
.ys-ride-boat .ys-shadow,.ys-ride-ring .ys-shadow{display:none}
.ys-yuni{position:absolute;left:-200rpx;top:-410rpx;width:400rpx;height:444rpx;transform-origin:50% 92%}
.ys-ride-boat .ys-yuni{top:-396rpx}.ys-ride-ring .ys-yuni{top:-386rpx}
.ys-l{position:absolute;left:0;top:0;width:100%;height:100%;background-size:100% 100%;background-repeat:no-repeat;pointer-events:none}
.ys-headwrap{transform-origin:50% 59.8%;transition:transform .2s cubic-bezier(.3,.9,.4,1)}
.ys-eyes{transition:transform .12s ease-out}
.ys-lid{transform-origin:50% 48%}
.ys-blink{animation:ys-blink .16s}
.ys-wl{transform-origin:32.07% 65.2%;transform:rotate(18deg);transition:transform .42s cubic-bezier(.34,1.4,.5,1)}
.ys-wr{transform-origin:67.93% 65.2%;transform:rotate(-18deg);transition:transform .42s cubic-bezier(.34,1.4,.5,1)}
.ys-w-shy .ys-wl{transform:rotate(-124deg)}.ys-w-shy .ys-wr{transform:rotate(124deg)}
.ys-w-shy .ys-headwrap{animation:var(--ue-animation,ys-wiggle .6s ease-in-out infinite)}
.ys-w-love .ys-wl{animation:var(--ue-animation,ys-loveL .5s ease-in-out infinite alternate)}.ys-w-love .ys-wr{animation:var(--ue-animation,ys-loveR .5s ease-in-out infinite alternate)}
.ys-w-wave .ys-wr{animation:var(--ue-animation,ys-waveR .42s ease-in-out infinite alternate)}
.ys-w-cheer .ys-wl{animation:var(--ue-animation,ys-cheerL .42s ease-in-out infinite alternate)}.ys-w-cheer .ys-wr{animation:var(--ue-animation,ys-cheerR .42s ease-in-out infinite alternate)}
.ys-w-reach .ys-wl{transform:rotate(165deg)}.ys-w-reach .ys-wr{transform:rotate(-165deg)}
.ys-w-five .ys-wr{animation:var(--ue-animation,ys-fiveR 1.25s cubic-bezier(.4,0,.2,1) both)}.ys-w-five .ys-wl{animation:var(--ue-animation,ys-fiveL 1.25s cubic-bezier(.4,0,.2,1) both)}
.ys-w-dance .ys-wl{animation:var(--ue-animation,ys-danceL 1.2s ease-in-out infinite)}.ys-w-dance .ys-wr{animation:var(--ue-animation,ys-danceR 1.2s ease-in-out infinite)}
.ys-w-dance .ys-headwrap{animation:var(--ue-animation,ys-danceHead 1.2s ease-in-out infinite)}
.ys-b-idle{animation:ys-breathe 3.2s ease-in-out infinite}
.ys-b-squash{animation:ys-squash .42s}
.ys-b-jump{animation:ys-jump .7s}.ys-b-hop{animation:ys-jump .6s}
.ys-b-dizzy{animation:ys-dizzy .9s}
.ys-b-snooze{animation:ys-snooze 3.6s ease-in-out infinite}
.ys-b-munch{animation:ys-munch .28s 4}
.ys-b-bounce{animation:ys-bounce .5s ease-in-out 6}
.ys-drool{position:absolute;left:53.2%;top:57.6%;width:4.6%;height:13%;z-index:2;pointer-events:none}
.ys-drip{position:absolute;left:0;top:0;width:100%;height:100%;border-radius:40% 40% 50% 50%/20% 20% 80% 80%;background:linear-gradient(#ffffffcc,#a7dcff);box-shadow:inset -2rpx -3rpx 0 #7cc4f2;transform-origin:50% 0;animation:var(--ue-animation,ys-drip 1.6s ease-in infinite)}
.ys-drop{position:absolute;left:12%;top:80%;width:76%;height:22%;border-radius:50%;background:#a7dcff;opacity:0;animation:var(--ue-animation,ys-dropfall 1.6s ease-in infinite)}
.ys-b-rumble{animation:ys-rumble .12s ease-in-out 8}
.ys-b-stretch{animation:ys-stretch 1.4s ease-in-out}
.ys-b-hum{animation:ys-hum .8s ease-in-out 3}
.ys-b-peek{animation:ys-peek 1.7s ease-in-out}
.ys-w-belly .ys-wl{animation:var(--ue-animation,ys-bellyL .5s ease-in-out infinite alternate)}.ys-w-belly .ys-wr{animation:var(--ue-animation,ys-bellyR .5s ease-in-out infinite alternate)}
.ys-fx-note{color:#fff;font-weight:800;font-size:30rpx;text-shadow:0 2rpx 0 #1c2a5466;white-space:nowrap;animation:ys-float 1.3s cubic-bezier(.2,.7,.3,1) both}
.ys-btn-hungry .ys-img{animation:var(--ue-animation,ys-wiggle-btn 1.4s ease-in-out infinite)}
.ys-hungry-dot{position:absolute;right:10rpx;top:8rpx;width:18rpx;height:18rpx;border-radius:50%;background:#e8604c;box-shadow:0 0 0 4rpx #fff}
.ys-b-spin{animation:ys-spin 1s ease-in-out}
.ys-b-five{animation:ys-five 1.25s cubic-bezier(.4,0,.2,1)}
.ys-b-groove{animation:ys-groove 1.2s ease-in-out 2}

.ys-bubble{position:absolute;left:50%;bottom:560rpx;width:max-content;max-width:560rpx;box-sizing:border-box;transform:translateX(-50%) scale(.6);transform-origin:50% 100%;background:#fff;color:var(--navy);font-weight:650;font-size:25rpx;line-height:1.3;text-align:center;padding:14rpx 24rpx;border-radius:28rpx;box-shadow:0 7rpx 0 #1c2a541f;opacity:0;transition:opacity .18s,transform .22s cubic-bezier(.3,1.5,.5,1);z-index:5;pointer-events:none;white-space:normal;overflow-wrap:break-word}
.ys-bubble.on{opacity:1;transform:translateX(-50%) scale(1)}
.ys-zz{position:absolute;left:50%;bottom:540rpx;margin-left:80rpx;color:#fff;font-weight:800;font-size:36rpx;animation:ys-zz 2.8s ease-out infinite;z-index:5}
.ys-mood{position:absolute;left:24rpx;bottom:86rpx;z-index:5;color:#fff;font-size:21rpx;font-weight:650}
.ys-mood-row{display:flex;gap:5rpx;margin-top:2rpx;font-size:30rpx;line-height:1;color:#ffffff55}
.ys-mood-row .full{color:#ff8a8a}
.ys-shop-btn{position:absolute;right:24rpx;bottom:86rpx;z-index:5;display:flex;align-items:center;gap:10rpx;background:#fff;color:var(--navy);font-weight:800;font-size:26rpx;padding:10rpx 24rpx 10rpx 12rpx;border-radius:99rpx;box-shadow:0 5rpx 0 #1c2a5422}
.ys-shop-btn .ys-img{width:52rpx;height:52rpx}
.ys-shop-pts{background:var(--foam);color:var(--deep);border-radius:99rpx;padding:2rpx 12rpx;font-size:20rpx}
.ys-press{transform:translateY(4rpx);opacity:.9}
.ys-fx{position:absolute;z-index:8;pointer-events:none}
.ys-fx-heart{color:#ff5c7a;font-size:40rpx;animation:ys-float 1.1s cubic-bezier(.2,.7,.3,1) both}
.ys-fx-text{color:#ffe08a;font-weight:800;font-size:34rpx;text-shadow:0 3rpx 0 #1c2a5455;white-space:nowrap;animation:ys-rise 1.3s cubic-bezier(.2,.7,.3,1) both}
.ys-fx-bit{width:14rpx;height:20rpx;border-radius:4rpx;animation:ys-bit 1.6s cubic-bezier(.2,.7,.3,1) both}

/* play buttons */
.ys-play{position:relative;z-index:7;display:flex;gap:14rpx;margin-top:-60rpx;padding:0 32rpx}
.ys-btn{position:relative;flex:1;min-width:0;background:#fff;border-radius:36rpx;padding:18rpx 4rpx 16rpx;display:flex;flex-direction:column;align-items:center;gap:4rpx;font-size:24rpx;font-weight:700;color:var(--navy);box-shadow:0 8rpx 0 #cfd3c8;white-space:nowrap}
.ys-btn .ys-img{width:76rpx;height:76rpx}
.ys-btn-gold{background:#fff8e6;box-shadow:0 6rpx 0 #e6cf8a}
.ys-count{position:absolute;right:8rpx;top:6rpx;min-width:34rpx;height:34rpx;border-radius:17rpx;background:var(--gold);color:var(--navy);font-size:20rpx;font-weight:800;line-height:34rpx;text-align:center;padding:0 8rpx;box-sizing:border-box}
.ys-who{position:absolute;left:36rpx;right:36rpx;top:36rpx;display:flex;justify-content:space-between;align-items:flex-start;z-index:6}
.ys-who-main{min-width:0;flex:1}
.ys-name{display:flex;align-items:center;gap:12rpx;color:var(--navy)}
.ys-name-text{font-size:42rpx;font-weight:800;letter-spacing:-.4rpx;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:400rpx}
.ys-name .ys-img{width:30rpx;height:30rpx;opacity:.6;flex:none}
.ys-check{display:inline-block;margin-top:6rpx;font-size:25rpx;font-weight:600;color:var(--deep)}
.ys-check-todo{background:#ffffffcc;border-radius:20rpx;padding:6rpx 16rpx;color:var(--navy);font-size:23rpx;line-height:1.35}
.ys-asleep .ys-name,.ys-asleep .ys-check,.ys-dark .ys-name,.ys-dark .ys-check{color:#fff}
.ys-pts{display:flex;align-items:center;gap:10rpx;background:#fff;border-radius:99rpx;padding:12rpx 24rpx 12rpx 14rpx;font-weight:800;color:var(--navy);box-shadow:0 6rpx 0 #1c2a5422;font-variant-numeric:tabular-nums;font-size:29rpx;flex:none}
.ys-pts .ys-img{width:60rpx;height:28rpx}
.ys-pts-unit{font-size:25rpx}

/* shop */
.ys-sheet{position:fixed;left:0;right:0;bottom:0;height:54vh;z-index:950;background:#fff;border-radius:40rpx 40rpx 0 0;box-shadow:0 -16rpx 50rpx rgba(28,42,84,.18);display:flex;flex-direction:column;padding-bottom:env(safe-area-inset-bottom);animation:ys-sheet .3s cubic-bezier(.3,1,.4,1)}
.ys-sheet-head{display:flex;align-items:center;gap:16rpx;padding:26rpx 28rpx 14rpx}
.ys-sheet-title{flex:1;font-size:31rpx;font-weight:800}
.ys-sheet-pts{display:flex;align-items:center;gap:8rpx;font-weight:800;color:var(--navy);background:var(--foam);padding:6rpx 18rpx 6rpx 10rpx;border-radius:99rpx;font-size:24rpx}
.ys-sheet-pts .ys-img{width:46rpx;height:22rpx}
.ys-test-pts{flex:none;padding:8rpx 16rpx;border-radius:99rpx;background:#fff3cf;color:#7a5200;font-size:21rpx;font-weight:800;box-shadow:inset 0 0 0 2rpx #f2c95c}
.ys-done{font-weight:700;color:var(--sea);padding:6rpx 4rpx 6rpx 12rpx;font-size:26rpx}
.ys-tabs{white-space:nowrap;padding:0 28rpx 16rpx;box-sizing:border-box;width:100%;flex:none;height:76rpx}
.ys-tab{display:inline-block;margin-right:10rpx;padding:10rpx 24rpx;border-radius:99rpx;background:#f1f0eb;font-weight:650;font-size:24rpx;color:#4c5148}
.ys-tab.on{background:var(--navy);color:#fff}
.ys-tab.star{background:#fff3cf;color:#7a5200;box-shadow:inset 0 0 0 3rpx var(--gold);font-weight:800}
.ys-tab.star.on{background:var(--gold);color:var(--navy)}
.ys-grid-scroll{flex:1;min-height:0;padding:0 28rpx;box-sizing:border-box}
.ys-rod-note{background:#fff8e6;border-radius:20rpx;padding:14rpx 18rpx;font-size:22rpx;line-height:1.35;color:#5c4a12;margin-bottom:14rpx}
.ys-strong{font-weight:800;color:var(--navy)}
.ys-grid{display:flex;flex-wrap:wrap;gap:14rpx;padding-bottom:16rpx}
.ys-item{position:relative;width:calc((100% - 28rpx) / 3);box-sizing:border-box;background:#f6f5f1;border-radius:28rpx;padding:12rpx 8rpx 14rpx;text-align:center;border:4rpx solid transparent;overflow:hidden}
.ys-item.sel{border-color:var(--gold);background:#fff8e6}
.ys-pic{height:116rpx;display:flex;align-items:center;justify-content:center}
.ys-pic .ys-img{width:140rpx;height:112rpx}
.ys-tier-1 .ys-pic,.ys-tier-2 .ys-pic,.ys-tier-3 .ys-pic,.ys-tier-4 .ys-pic{height:140rpx}
.ys-tier-1 .ys-pic .ys-img,.ys-tier-2 .ys-pic .ys-img,.ys-tier-3 .ys-pic .ys-img,.ys-tier-4 .ys-pic .ys-img{width:140rpx;height:140rpx}
.ys-swatch{width:124rpx;height:86rpx;border-radius:18rpx}
.ys-item-name{font-size:22rpx;font-weight:650;line-height:1.2;margin-top:6rpx}
.ys-odds{font-size:20rpx;font-weight:700;color:#b6790a;margin-top:4rpx}
.ys-tag{margin-top:6rpx;font-size:20rpx;font-weight:700;color:#6b6860}
.ys-tag.price{color:var(--navy)}.ys-tag.worn{color:var(--sea)}
.ys-item.locked .ys-pic{opacity:.5}
.ys-tier-2{background:linear-gradient(160deg,#e9f0ff,#f6f5f1 70%)}
.ys-tier-3{background:linear-gradient(160deg,#fff1c2,#fffaf0 75%);box-shadow:inset 0 0 0 3rpx #f2c95c}
.ys-tier-4{background:linear-gradient(160deg,#24366b,#1c2a54)}
.ys-tier-4 .ys-item-name{color:#fff}.ys-tier-4 .ys-odds{color:#ffd35c}.ys-tier-4 .ys-tag{color:#c9d3f0}
.ys-tier-4.locked .ys-pic{opacity:.8}
.ys-buy{display:flex;align-items:center;gap:20rpx;padding:18rpx 28rpx 26rpx;border-top:1rpx solid #e2e0d9}
.ys-buy-copy{flex:1;min-width:0}
.ys-buy-name{font-size:26rpx;font-weight:700}
.ys-buy-note{font-size:22rpx;color:#6b6860}
.ys-buy-btn{flex:none;min-width:236rpx;text-align:center;padding:20rpx 28rpx;border-radius:26rpx;background:var(--sea);color:#fff;font-weight:800;font-size:26rpx;box-shadow:0 6rpx 0 var(--deep);box-sizing:border-box}
.ys-buy-btn.disabled{background:#e4e1d8;color:#8a877e;box-shadow:none}
.ys-buy-btn.plain{background:var(--foam);color:var(--deep);box-shadow:0 6rpx 0 #cfe3d8}

/* fishing game mode: the scene fills the screen */
.ys-game .ys-stage{position:fixed;left:0;top:0;right:0;bottom:0;height:auto;z-index:900;border-radius:0}
.ys-game .ys-sea{height:50%}
.ys-game .ys-berg{bottom:calc(50% - 30rpx)}
.ys-game .ys-island{bottom:calc(50% - 20rpx)}
.ys-game .ys-anchor{left:38%;bottom:calc(50% - 76rpx)}
.ys-game .ys-yuni{left:-230rpx;top:-470rpx;width:460rpx;height:510rpx}
.ys-game .ys-ride-img{left:-300rpx;top:-66rpx;width:600rpx;height:175rpx}
.ys-game .ys-shadow{left:-125rpx;top:-20rpx;width:250rpx;height:42rpx}
.ys-game .ys-bubble{left:40%;bottom:calc(50% + 430rpx)}
.ys-swimmers{position:absolute;left:0;right:0;bottom:0;height:42%;overflow:hidden;pointer-events:none}
/* Shadows of fish under the water: a real fish outline, soft edges, a tail that wiggles, and fainter when deeper. */
.ys-swim{position:absolute;left:-150rpx;width:130rpx;height:52rpx;opacity:.22;animation:var(--ue-animation,ys-swim 14s linear infinite)}
.ys-swim-left{left:auto;right:-150rpx;animation-name:ys-swim-left}
.ys-swim-body{width:100%;height:100%;background-image:url("data:image/svg+xml;charset=utf-8,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%20100%2040%22%3E%3Cpath%20fill%3D%22%2304261d%22%20d%3D%22M16%2020C26%207%2050%204%2070%209c12%203%2022%207%2028%2011-6%204-16%208-28%2011-20%205-44%202-54-11z%22%2F%3E%3Cpath%20fill%3D%22%2304261d%22%20d%3D%22M18%2020L2%207c4%206%205%209%205%2013s-1%207-5%2013z%22%2F%3E%3Cpath%20fill%3D%22%2304261d%22%20d%3D%22M44%209c4-6%2012-9%2020-7-4%202-6%205-6%209zM50%2031c3%205%208%207%2013%206-3-2-4-4-4-8z%22%2F%3E%3C%2Fsvg%3E");background-size:100% 100%;filter:blur(1.5rpx);transform-origin:70% 50%;animation:var(--ue-animation,ys-tail .5s ease-in-out infinite alternate)}
.ys-swim-left .ys-swim-body{transform:scaleX(-1);animation-name:ys-tail-left}
.ys-s1{top:16%}.ys-s2{top:40%;width:100rpx;height:40rpx;animation-duration:18s;animation-delay:-7s;opacity:.16}.ys-s3{top:64%;width:170rpx;height:68rpx;animation-duration:24s;animation-delay:-14s;opacity:.12}.ys-s4{top:84%;width:84rpx;height:34rpx;animation-duration:12s;animation-delay:-3s;opacity:.1}
.ys-s3 .ys-swim-body,.ys-s4 .ys-swim-body{filter:blur(3rpx)}
.ys-game-top{position:absolute;left:24rpx;right:24rpx;top:24rpx;display:flex;align-items:center;gap:12rpx;z-index:9}
.ys-pill{background:#fff;color:var(--navy);font-weight:800;font-size:24rpx;padding:12rpx 22rpx;border-radius:99rpx;box-shadow:0 5rpx 0 #1c2a5422;display:flex;align-items:center;gap:8rpx}
.ys-left{background:#ffffffd9;font-weight:700;font-size:22rpx;box-shadow:none;flex:1;justify-content:center}
.ys-bal .ys-img{width:52rpx;height:24rpx}
.ys-bucket{position:absolute;left:0;right:0;bottom:330rpx;display:flex;gap:12rpx;justify-content:center;flex-wrap:wrap;padding:0 28rpx;z-index:9}
.ys-chip{background:#fff;border-radius:26rpx;padding:8rpx 16rpx 6rpx;box-shadow:0 6rpx 0 #04261d55;display:flex;flex-direction:column;align-items:center;font-size:20rpx;font-weight:800;color:var(--navy);animation:ys-pop .4s cubic-bezier(.3,1.6,.5,1)}
.ys-chip .ys-img{width:110rpx;height:56rpx}
.ys-bucket-tip{width:100%;text-align:center;color:#fff;font-size:22rpx;font-weight:650;opacity:.9}
.ys-game-bottom{position:absolute;left:0;right:0;bottom:calc(env(safe-area-inset-bottom) + 40rpx);height:270rpx;z-index:9}
.ys-cast{position:absolute;left:50%;top:10rpx;margin-left:-95rpx;width:190rpx;height:190rpx;z-index:1;border-radius:50%;background:radial-gradient(circle at 36% 30%,#fff3c2,#f2b233);color:var(--navy);box-shadow:0 12rpx 0 #c98a12,0 0 0 14rpx #ffffff33;display:flex;flex-direction:column;align-items:center;justify-content:center;line-height:1.15}
.ys-cast-label{font-size:36rpx;font-weight:900}
.ys-cast-sub{font-size:26rpx;font-weight:800;opacity:.85}
.ys-cast-press{transform:translateY(8rpx);box-shadow:0 4rpx 0 #c98a12,0 0 0 14rpx #ffffff33}
.ys-cast.waiting{background:radial-gradient(circle at 36% 30%,#fff,#cfe9dc);box-shadow:0 12rpx 0 #8fbfaa,0 0 0 14rpx #ffffff22}
.ys-cast.waiting .ys-cast-label{font-size:30rpx}

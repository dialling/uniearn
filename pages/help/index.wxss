.help-page{background:#eeede8;min-height:100vh;padding-bottom:calc(40rpx + env(safe-area-inset-bottom))}
.help-hero{padding:28rpx 40rpx 8rpx}
.help-title{font-size:40rpx;font-weight:800;letter-spacing:.2rpx;color:#16181c}
.help-lead{margin-top:8rpx;font-size:24rpx;line-height:1.5;color:#6b6860}
.help-body{padding:18rpx 32rpx 8rpx}
.help-test-note{background:#f4f1e8;border:1rpx solid #e6e0d2;border-radius:18rpx;padding:16rpx 20rpx;margin-bottom:20rpx;font-size:22rpx;line-height:1.55;color:#6b6860}

.support-card,.faq-card{background:#fff;border:1rpx solid #e4e1d8;border-radius:28rpx;overflow:hidden;box-shadow:0 8rpx 28rpx rgba(22,24,28,.04)}
.support-card{padding:28rpx 26rpx 24rpx;background:linear-gradient(180deg,#f7fbf8 0%,#fff 56%)}
.support-head{display:flex;align-items:center;gap:20rpx}
.support-avatar{flex:none;width:92rpx;height:92rpx;border-radius:28rpx;background:#e7f3ed;display:flex;align-items:center;justify-content:center}
.support-avatar image{width:68rpx;height:82rpx}
.support-head-copy{flex:1;min-width:0}
.support-head .strong{font-size:30rpx;font-weight:800;color:#16181c;line-height:1.3}
.support-hours{margin-top:6rpx;font-size:22rpx;line-height:1.45;color:#6b6860}
.support-start{display:block;width:100%;margin:22rpx 0 0;height:80rpx;line-height:80rpx;padding:0;font-size:28rpx;font-weight:750;border-radius:22rpx;background:#0b7a55;color:#fff}
.support-card .notice-error{margin:16rpx 0 0}

.help-body .section{font-size:26rpx;font-weight:750;margin:36rpx 6rpx 16rpx;color:#16181c}
.faq-item{border-bottom:1rpx solid #f0eee8}
.faq-item:last-child{border-bottom:0}
.faq-title{display:flex;align-items:center;justify-content:space-between;gap:20rpx;padding:28rpx 28rpx;font-size:27rpx;font-weight:700;line-height:1.4;color:#16181c}
.faq-item.open .faq-title{padding-bottom:10rpx}
.faq-chevron{flex:none;color:#8a877e;font-size:30rpx;font-weight:400;line-height:1;transition:transform .2s ease}
.faq-chevron.link{font-size:34rpx;color:#0b7a55}
.faq-chevron.open{transform:rotate(180deg);color:#0b7a55}
.guide-item .faq-title{font-weight:750}
.faq-answer{font-size:25rpx;line-height:1.7;color:#5e5c55;padding:0 28rpx 28rpx}
.rules-link{text-align:center;font-weight:750;color:#0b7a55;font-size:25rpx;padding:40rpx 0 8rpx}

.page-dark.help-page,.page-dark .help-page{background:#1b1c1a}
.page-dark .help-title,.page-dark .help-body .section,.page-dark .faq-title{color:#fff7ed}
.page-dark .help-lead,.page-dark .support-hours,.page-dark .help-test-note,.page-dark .faq-answer{color:#a9a69c}
.page-dark .help-test-note{background:#242522;border-color:#3a3b37}
.page-dark .support-card,.page-dark .faq-card{background:#242522;border-color:#3a3b37;box-shadow:none}
.page-dark .support-card{background:linear-gradient(180deg,#1f2a24 0%,#242522 56%)}
.page-dark .support-avatar{background:#1a2c24}
.page-dark .support-head .strong{color:#fff7ed}
.page-dark .faq-item{border-color:#2f2f2c}
.page-dark .faq-chevron{color:#8a877e}
.page-dark .faq-chevron.link,.page-dark .faq-chevron.open,.page-dark .rules-link{color:#6fd0a8}

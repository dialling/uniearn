.help-page{background:#f1e7da;min-height:100vh;padding-bottom:env(safe-area-inset-bottom)}.help-header{background:transparent;padding:22rpx 38rpx 27rpx}.help-title{font-size:37rpx;font-weight:800}.help-header .hint{font-size:23rpx;margin-bottom:0}.help-body{padding:25rpx 38rpx}.support-card,.faq-card{background:white;border:1rpx solid #e7d9cb;border-radius:28rpx;overflow:hidden}.support-card{padding:27rpx}.support-head{display:flex;align-items:center;gap:25rpx}.support-head>image{width:85rpx;height:105rpx;flex:none}.support-head .strong{font-size:29rpx}.support-head .hint{font-size:24rpx;line-height:1.65;margin-bottom:0}.support-card .btn{margin:27rpx 0 0;border-radius:20rpx;padding:25rpx}.conversation{background:#f5f5f1;border-radius:22rpx;padding:20rpx;margin-top:26rpx}.message{font-size:26rpx;line-height:1.5;padding:18rpx 22rpx;border-radius:25rpx;margin-bottom:16rpx;max-width:94%;box-sizing:border-box}.team{background:white;border:1rpx solid #e7d9cb;border-bottom-left-radius:6rpx}.mine{background:#dcdbd2;margin-left:auto;width:fit-content;border-bottom-right-radius:6rpx}.topic{display:inline-block;border:1rpx solid #b4d3bf;border-radius:40rpx;padding:15rpx 23rpx;background:white;color:#8b1e2b;font-weight:750;font-size:23rpx;line-height:1.3;margin:0 10rpx 12rpx 0}.ticket-id{color:#8a7768;font-size:20rpx}.help-body .section{font-size:26rpx;margin:36rpx 3rpx 26rpx}.faq-title{display:flex;justify-content:space-between;gap:20rpx;padding:29rpx 27rpx;font-size:27rpx;font-weight:750;line-height:1.4}.faq-title>text:last-child{color:#8a7768;flex:none}.faq-item{border-bottom:1rpx solid #f2e8db}.faq-item:last-child{border-bottom:0}.faq-answer{font-size:25rpx;line-height:1.65;color:#8a7768;padding:0 27rpx 30rpx}.rules-link{text-align:center;font-weight:750;color:#5e6058;font-size:25rpx;padding:36rpx 0}
.help-test-note{font-size:20rpx;color:#8a7768;line-height:1.5;margin:0 3rpx 18rpx}

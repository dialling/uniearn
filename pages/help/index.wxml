<view class="help-page">
<view class="help-header">
<view class="help-title">Help</view>
<view class="hint">{{labels.label1}}</view>
</view>
<view class="help-body">
<view class="help-test-note">{{labels.label2}}</view>
<view class="support-card">
<view class="support-head">
<image src="/assets/yuni-work.png" mode="aspectFit"/>
<view>
<view class="strong">{{labels.label3}}</view>
<view class="hint">{{labels.label4}}</view>
</view>
</view>
<button wx:if="{{!chatStarted}}" class="btn" bindtap="start">{{labels.label5}}</button>
<view wx:else class="conversation">
<view class="message team">{{hello}}</view>
<block wx:if="{{!selected}}">
<button wx:for="{{options}}" wx:key="id" class="topic" data-id="{{item.id}}" bindtap="choose" disabled="{{submitting}}">{{item.label}}</button>
</block>
<block wx:else>
<view class="message mine">{{selected}}</view>
<view class="message team">{{ack}}</view>
<view class="ticket-id">{{ticketId}}</view>
</block>
</view>
<view wx:if="{{error}}" class="notice-error">{{error}}</view>
</view>
<view class="section">{{labels.label6}}</view>
<view class="faq-card">
<view wx:for="{{faqs}}" wx:key="id" class="faq-item">
<view class="faq-title" data-id="{{item.id}}" bindtap="toggle">
<text>{{item.title}}</text>
<text wx:if="{{expanded[item.id]}}">⌃</text>
<text wx:else>⌄</text>
</view>
<view wx:if="{{expanded[item.id]}}" class="faq-answer">{{item.answer}}</view>
</view>
</view>
<view class="rules-link" bindtap="rules">{{labels.label7}} ›</view>
</view>
</view>
<yuni-assistant/>

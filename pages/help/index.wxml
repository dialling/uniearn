<view style="{{motionStyle}}">
<lang-switch></lang-switch>
<view class="help-page {{darkClass}}">
<view class="help-hero">
<view class="help-title">{{labels.title}}</view>
<view class="help-lead">{{labels.label1}}</view>
</view>
<view class="help-body">
<view class="help-test-note">{{labels.label2}}</view>
<view class="support-card">
<view class="support-head">
<view class="support-avatar"><image src="/assets/yuni-work.png" mode="aspectFit"/></view>
<view class="support-head-copy">
<view class="strong">{{labels.label3}}</view>
<view class="support-hours">{{labels.label4}}</view>
</view>
</view>
<button class="btn support-start" bindtap="start">{{labels.label5}}</button>
<view wx:if="{{error}}" class="notice-error">{{error}}</view>
</view>
<view class="section">{{labels.label6}}</view>
<view class="faq-card">
<view class="faq-item guide-item" bindtap="guide">
<view class="faq-title"><text>{{labels.label8}}</text><text class="faq-chevron link">›</text></view>
</view>
<view wx:for="{{faqs}}" wx:key="id" class="faq-item {{expanded[item.id]?'open':''}}">
<view class="faq-title" data-id="{{item.id}}" bindtap="toggle">
<text>{{item.title}}</text>
<text class="faq-chevron {{expanded[item.id]?'open':''}}">⌄</text>
</view>
<view wx:if="{{expanded[item.id]}}" class="faq-answer">{{item.answer}}</view>
</view>
</view>
<view class="rules-link" bindtap="rules">{{labels.label7}} ›</view>
</view>
</view>
<yuni-assistant/>

</view>

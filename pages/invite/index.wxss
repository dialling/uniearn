page{background:#070807}
.iv-page{position:relative;min-height:100vh;padding-bottom:calc(260rpx + env(safe-area-inset-bottom));color:#fff;overflow:hidden}

.iv-bg{position:fixed;left:0;top:0;right:0;bottom:0;overflow:hidden;pointer-events:none;z-index:0}
.iv-mark{position:absolute;white-space:nowrap;font-weight:900;letter-spacing:-6rpx;color:#fff;line-height:1}
.iv-mark.m1{top:40rpx;left:780rpx;font-size:300rpx;opacity:.07;transform:rotate(90deg);transform-origin:left top;filter:blur(10rpx)}
.iv-mark.m2{top:330rpx;left:-60rpx;font-size:230rpx;opacity:.05;filter:blur(16rpx)}
.iv-mark.m3{top:700rpx;left:180rpx;font-size:200rpx;opacity:.045;filter:blur(6rpx)}
.iv-streaks{position:absolute;left:0;top:0;right:0;height:1100rpx;background:repeating-linear-gradient(90deg,rgba(255,255,255,.035) 0,rgba(255,255,255,.035) 3rpx,transparent 3rpx,transparent 46rpx,rgba(255,255,255,.02) 46rpx,rgba(255,255,255,.02) 50rpx,transparent 50rpx,transparent 118rpx);filter:blur(4rpx);-webkit-mask-image:linear-gradient(180deg,#000 0%,#000 55%,transparent 100%);mask-image:linear-gradient(180deg,#000 0%,#000 55%,transparent 100%)}
.iv-glow{position:absolute;left:-200rpx;top:260rpx;width:720rpx;height:720rpx;border-radius:50%;background:radial-gradient(circle,rgba(201,242,107,.10) 0%,rgba(201,242,107,0) 70%)}

.iv-nav{position:relative;z-index:2;display:flex;align-items:center;padding-left:24rpx;box-sizing:content-box}
.iv-back{width:64rpx;height:64rpx;display:flex;align-items:center;justify-content:center}
.iv-back-arrow{width:22rpx;height:22rpx;border-left:4rpx solid #fff;border-bottom:4rpx solid #fff;transform:rotate(45deg);margin-left:8rpx}

.iv-body{position:relative;z-index:1;padding:28rpx 44rpx 0}
.iv-title{font-size:52rpx;font-weight:800;line-height:1.3;letter-spacing:1rpx}
.iv-label{margin-top:44rpx;font-size:30rpx;font-weight:700;color:#c9f26b}
.iv-big{margin-top:-6rpx;font-size:260rpx;font-weight:600;line-height:1;letter-spacing:-8rpx;color:#c9f26b;font-family:-apple-system,"Helvetica Neue",Arial,sans-serif}
.iv-unit{margin-top:6rpx;font-size:64rpx;font-weight:700;color:#c9f26b;letter-spacing:2rpx}

.iv-rows{margin-top:44rpx}
.iv-row{display:flex;align-items:flex-start;gap:14rpx;margin-bottom:18rpx;font-size:25rpx;line-height:1.5;color:#b8bdb8}
.iv-row-icon{flex:none;width:30rpx;height:30rpx;margin-top:4rpx}

.iv-line{height:1rpx;margin:40rpx 0 36rpx;background:rgba(255,255,255,.12)}
.iv-sub{margin:0 0 16rpx;font-size:25rpx;color:#9aa09a}
.iv-card{display:flex;align-items:center;gap:20rpx;margin-bottom:34rpx;padding:26rpx 28rpx;border-radius:28rpx;background:rgba(255,255,255,.06);border:1rpx solid rgba(255,255,255,.1)}
.iv-code{flex:1;min-width:0;font-family:monospace;font-size:40rpx;font-weight:700;letter-spacing:4rpx;color:#fff;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.iv-muted{flex:1;font-size:26rpx;color:#9aa09a}
.iv-input{flex:1;min-width:0;height:60rpx;font-size:30rpx;color:#fff;letter-spacing:2rpx}
.iv-ph{color:#6d726d}
.iv-chip{flex:none;height:60rpx;line-height:60rpx;padding:0 30rpx;border-radius:30rpx;border:2rpx solid #c9f26b;color:#c9f26b;font-size:25rpx;font-weight:700;transition:transform .15s ease,opacity .15s ease}
.iv-chip.solid{background:#c9f26b;color:#101210}
.iv-chip.busy{opacity:.5}

.iv-dock{position:fixed;left:0;right:0;bottom:0;z-index:3;display:flex;justify-content:center;gap:120rpx;padding:34rpx 0 calc(30rpx + env(safe-area-inset-bottom));background:linear-gradient(180deg,rgba(7,8,7,0) 0%,rgba(7,8,7,.92) 30%,#070807 100%)}
.iv-action{display:flex;flex-direction:column;align-items:center;gap:14rpx;font-size:24rpx;color:#e6e9e6}
.iv-circle{width:112rpx!important;height:112rpx;min-height:0;margin:0;padding:0;border-radius:50%;background:#c9f26b;display:flex;align-items:center;justify-content:center;line-height:1;box-shadow:0 10rpx 30rpx rgba(201,242,107,.18)}
.iv-circle::after{border:0}
.iv-circle image{width:52rpx;height:52rpx}
.iv-press{transform:scale(.94);opacity:.85}

/* Serif 700 and 800 are the same file, loaded once from /assets/invite-serif.woff2. */
/* Display and Sans stay inline: a standalone .wxss under assets/ breaks the WXSS build. */
/* WXSS cannot parse format() or variable weight ranges, so each weight is declared on its own. */
@font-face{font-family:"Invite Serif";font-style:normal;font-weight:700;font-display:swap;src:url("/assets/invite-serif.woff2")}
@font-face{font-family:"Invite Serif";font-style:normal;font-weight:800;font-display:swap;src:url("/assets/invite-serif.woff2")}
@font-face{font-family:"Invite Display";font-style:normal;font-weight:400;font-display:swap;src:url("data:font/woff2;base64,")}
@font-face{font-family:"Invite Sans";font-style:normal;font-weight:700;font-display:swap;src:url("data:font/woff2;base64,")}
page{background:#f3ecd9}
.iv-page{position:relative;min-height:100vh;padding-bottom:calc(260rpx + env(safe-area-inset-bottom));color:#22221d;overflow:hidden}

.iv-bg{background:linear-gradient(135deg,rgba(255,255,255,.22),rgba(215,196,151,.1));position:fixed;left:0;top:0;right:0;bottom:0;overflow:hidden;pointer-events:none;z-index:0}
.iv-mark{position:absolute;white-space:nowrap;font-weight:900;letter-spacing:-6rpx;color:#22221d;line-height:1}
.iv-mark.m1{top:40rpx;left:780rpx;font-size:300rpx;opacity:.07;transform:rotate(90deg);transform-origin:left top;filter:blur(10rpx)}
.iv-mark.m2{top:330rpx;left:-100rpx;font-size:230rpx;opacity:.045;filter:blur(16rpx)}
.iv-mark.m3{top:700rpx;left:140rpx;font-size:200rpx;opacity:.045;filter:blur(6rpx)}
.iv-streaks{position:absolute;left:0;top:0;right:0;height:1100rpx;background:repeating-linear-gradient(90deg,rgba(124,119,104,.02) 0,rgba(124,119,104,.02) 3rpx,transparent 3rpx,transparent 46rpx,rgba(124,119,104,.01) 46rpx,rgba(124,119,104,.01) 50rpx,transparent 50rpx,transparent 118rpx);filter:blur(4rpx);-webkit-mask-image:linear-gradient(180deg,#000 0%,#000 55%,transparent 100%);mask-image:linear-gradient(180deg,#000 0%,#000 55%,transparent 100%)}
.iv-glow{position:absolute;left:-200rpx;top:260rpx;width:720rpx;height:720rpx;border-radius:50%;background:radial-gradient(circle,rgba(230,202,128,.12) 0%,rgba(230,202,128,0) 70%)}

.iv-nav{position:relative;z-index:2;display:flex;align-items:center;padding-left:24rpx;box-sizing:content-box}
.iv-back{width:64rpx;height:64rpx;display:flex;align-items:center;justify-content:center}
.iv-back-arrow{width:22rpx;height:22rpx;border-left:4rpx solid #22221d;border-bottom:4rpx solid #22221d;transform:rotate(45deg);margin-left:8rpx}

.iv-body{position:relative;z-index:1;padding:28rpx 44rpx 0}
.iv-title{font-family:"Invite Serif","Songti SC","STSong","SimSun",serif;font-size:52rpx;font-weight:800;line-height:1.3;letter-spacing:1rpx;transform:rotate(-3deg);transform-origin:left center}
.iv-label{font-family:"Invite Serif","Songti SC",serif;margin-top:44rpx;font-size:30rpx;font-weight:700;color:#c83d29;transform:rotate(-2deg);transform-origin:left center}
.iv-reward{position:relative;display:flex;align-items:flex-end;justify-content:space-between;gap:24rpx;padding-top:6rpx}
.iv-primary{flex:1;min-width:0}
.iv-discount{display:flex;align-items:baseline;gap:12rpx;transform:rotate(-6deg);transform-origin:45% 65%;white-space:nowrap}
.iv-big{font-size:250rpx;font-weight:400;line-height:1;letter-spacing:-8rpx;color:#e7472f;-webkit-text-stroke:.6rpx rgba(36,34,27,.45);text-shadow:2rpx 3rpx 0 #343126,4rpx 6rpx 0 #343126,6rpx 9rpx 0 #343126,8rpx 11rpx 0 #343126;font-family:"Invite Display","Georgia",serif}
.iv-discount-unit{font-family:"Invite Serif","Songti SC","STSong","SimSun",serif;font-size:100rpx;font-weight:700;color:#e7472f;-webkit-text-stroke:.6rpx rgba(36,34,27,.45);text-shadow:1rpx 1rpx 0 #343126,2rpx 3rpx 0 #343126,3rpx 4rpx 0 #343126,4rpx 6rpx 0 #343126}
.iv-unit{font-family:"Invite Serif","Songti SC",serif;margin-top:10rpx;font-size:58rpx;font-weight:700;line-height:1.2;color:#22221d;letter-spacing:3rpx;transform:rotate(2deg);transform-origin:left center}
.iv-points{flex:none;width:240rpx;padding-bottom:10rpx;transform:rotate(-3deg);transform-origin:center}
.iv-points-label{font-size:23rpx;line-height:1.5;color:#7c7768}
.iv-points-value{display:flex;align-items:baseline;gap:10rpx;margin-top:8rpx;white-space:nowrap;color:#22221d}
.iv-points-number{font-family:"Invite Display","Georgia",serif;font-size:78rpx;font-weight:400;line-height:1;color:#c83d29;text-shadow:none}
.iv-points-unit{font-family:"Invite Serif","Songti SC",serif;font-size:32rpx;font-weight:700}
.iv-reward-en .iv-big{font-size:180rpx;letter-spacing:-6rpx}
.iv-reward-en .iv-discount{gap:6rpx}
.iv-reward-en .iv-discount-unit{font-size:76rpx}
.iv-reward-en .iv-unit{font-size:34rpx;letter-spacing:0}
.iv-reward-en .iv-points{width:220rpx}

.iv-rows{margin-top:44rpx}
.iv-row{display:flex;align-items:flex-start;gap:14rpx;margin-bottom:18rpx;font-size:25rpx;line-height:1.5;color:#22221d}
.iv-row-icon{flex:none;width:30rpx;height:30rpx;margin-top:4rpx}

.iv-line{height:1rpx;margin:40rpx 0 36rpx;background:rgba(124,119,104,.26)}
.iv-sub{margin:0 0 16rpx;font-size:25rpx;color:#7c7768}
.iv-card{display:flex;align-items:center;gap:20rpx;margin-bottom:34rpx;padding:26rpx 28rpx;border-radius:8rpx;background:rgba(255,255,255,.48);border:1rpx solid rgba(255,255,255,.8);box-shadow:inset 0 1rpx 0 rgba(255,255,255,.85),0 5rpx 22rpx rgba(113,88,65,.035);-webkit-backdrop-filter:blur(16rpx);backdrop-filter:blur(16rpx)}
.iv-code{flex:1;min-width:0;font-family:"Invite Sans",monospace;font-size:40rpx;font-weight:700;letter-spacing:4rpx;color:#22221d;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.iv-muted{flex:1;font-size:26rpx;color:#7c7768}
.iv-input{flex:1;min-width:0;height:60rpx;font-size:30rpx;color:#22221d;letter-spacing:2rpx}
.iv-ph{color:#7c7768}
.iv-chip{flex:none;height:60rpx;line-height:60rpx;padding:0 30rpx;border-radius:6rpx;border:2rpx solid #a66a56;color:#a66a56;font-size:25rpx;font-weight:700;transition:var(--ue-transition,transform .15s ease,opacity .15s ease)}
.iv-chip.solid{background:#a66a56;color:#22221d}
.iv-chip.busy{opacity:.5}

.iv-dock{position:fixed;left:0;right:0;bottom:0;z-index:3;display:flex;justify-content:center;gap:120rpx;padding:34rpx 0 calc(30rpx + env(safe-area-inset-bottom));background:linear-gradient(180deg,rgba(243,236,217,0) 0%,rgba(243,236,217,.94) 30%,#f3ecd9 100%)}
.iv-action{display:flex;flex-direction:column;align-items:center;gap:14rpx;font-size:24rpx;color:#22221d}
.iv-circle{width:112rpx!important;height:112rpx;min-height:0;margin:0;padding:0;border-radius:50%;background:#22221d;display:flex;align-items:center;justify-content:center;line-height:1;box-shadow:0 0 0 7rpx #f3ecd9,0 0 0 9rpx rgba(230,202,128,.75)}
.iv-circle::after{border:0}
.iv-circle image{width:52rpx;height:52rpx}
.iv-press{transform:scale(.94);opacity:.85}

/* Cream paper, vermilion rewards and charcoal typography. */
.iv-card .iv-code,.iv-card .iv-input{color:#22221d}
.iv-card .iv-muted,.iv-ph{color:#7c7768}
.iv-card .iv-chip{border-color:rgba(200,61,41,.45);color:#c83d29;background:rgba(231,71,47,.04)}
.iv-card .iv-chip.solid{background:#c83d29;border-color:#c83d29;color:#fff8e9}
.iv-circle{background:rgba(255,255,255,.6);border:1rpx solid rgba(255,255,255,.9);-webkit-backdrop-filter:blur(14rpx);backdrop-filter:blur(14rpx);box-shadow:0 0 0 7rpx #f3ecd9,0 0 0 9rpx rgba(200,61,41,.28)}

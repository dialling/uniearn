<import src="../../utils/customer-cancel-sheet.wxml"/>
<import src="../../utils/contact-identity.wxml"/>
<import src="../../utils/waiting-ticket.wxml"/>
<view style="{{motionStyle}}">
<lang-switch></lang-switch>
<view class="flow-page journey-page {{darkClass}}" wx:if="{{request}}">
<view class="flow-title">{{zh?(request.isMine?'我的订单':'订单详情'):request.isMine?'My request':'Order details'}}</view>
<view class="flow-sub">{{request.sizeLabel}} · {{request.boxes}} {{request.unitLabel}} · {{request.destinationDisplay}}</view>
<view class="journey-ticket">
 <view class="journey-ticket-band"><text class="journey-brand">UniEarn</text><text class="journey-band-divider">|</text><text class="journey-band-title">{{zh?'订单旅程':'Order journey'}}</text><image class="journey-anchor" src="/assets/journey-anchor.svg" mode="aspectFit"/></view>
 <view class="journey-ticket-body">
  <view class="journey-hero"><image class="journey-mascot" src="{{journey.mascot}}" mode="aspectFit"/><view class="journey-status"><view class="journey-status-title">{{journey.title}}</view><view class="journey-status-note">{{journey.note}}</view></view></view>
  <view class="journey-progress" aria-label="{{zh?'订单进度':'Order progress'}}"><view wx:for="{{steps}}" wx:key="name" class="journey-step {{item.done?'done':''}} {{item.current?'current':''}}"><view class="journey-step-dot">{{item.done||item.current?'✓':''}}</view><view class="journey-step-name">{{item.name}}</view><view class="journey-step-time">{{item.current?item.time:''}}</view></view></view>
  <view class="journey-route-section"><view class="journey-route"><view class="journey-route-point"><image class="journey-pin" src="/assets/journey-location.svg" mode="aspectFit"/><text aria-label="{{request.pickupDisplay||request.pickupPointDisplay||request.station}}">{{journey.pickupShort}}</text></view><text class="journey-route-arrow">→</text><view class="journey-route-point journey-destination"><image class="journey-pin" src="/assets/journey-location.svg" mode="aspectFit"/><text>{{request.destinationType==='place'?request.deliveryAddress:request.dorm}}</text></view></view><view class="journey-times"><view><text>{{zh?'发布：':'Posted: '}}</text><text>{{journey.posted}}</text></view><view wx:if="{{request.closesAt}}"><text>{{zh?'截止：':'Deadline: '}}</text><text>{{request.closeTime}}</text></view></view></view>
  <view wx:if="{{request.isMine && (request.status==='waiting'||cancelWindow.phase!=='hidden')}}" class="journey-ticket-footer"><view class="journey-cancel-copy"><view wx:if="{{request.status==='waiting' && request.closesAt}}" class="journey-refund-note"><text class="journey-bullet">•</text><text>{{zh?'若 '+request.closeTime+' 前无人接单，将全额退款。':'Auto-refund if not taken by '+request.closeTime+'.'}}</text></view><view wx:if="{{request.status!=='waiting' && cancelWindow.phase!=='hidden'}}" class="cancel-tip {{cancelWindow.phase==='grace'?'cancel-tip-live':''}}"><text class="journey-bullet">•</text><text>{{cancelWindow.tip}}</text></view></view><view wx:if="{{request.isMine && request.status==='waiting'}}" class="journey-offer-panel offer-card"><view class="offer-heading"><text class="strong">{{zh?'提高赏金':'Add to your offer'}}</text><text class="offer-current">{{zh?'当前赏金':'Your offer'}} <text>¥{{request.rewardText}}</text></text></view><view class="hint offer-hint">{{zh?'加价仅对整笔订单计算一次，接单后不可加价。':'Added once to the whole order. Available before acceptance only.'}}</view><view class="offer-options"><button wx:for="{{offerAmounts}}" wx:key="*this" class="offer-option" hover-class="offer-option-press" data-amount="{{item}}" bindtap="raise" disabled="{{raising}}">+¥{{item}}</button><button class="offer-option offer-custom" hover-class="offer-option-press" bindtap="customRaise" disabled="{{raising}}">{{zh?'自定义':'Custom'}}</button></view></view><view class="journey-ticket-actions"><button wx:if="{{cancelWindow.canCancel}}" class="offer-cancel journey-cancel" hover-class="journey-cancel-press" disabled="{{cancelling}}" loading="{{cancelling}}" bindtap="cancel">{{cancelWindow.button}}</button></view></view>
 </view>
</view>

<view wx:if="{{request.category==='takeout' && request.night}}" class="flow-card">
<view class="strong">{{zh?'订单状态':'Order status'}}</view>
<view class="hint">{{request.purchaseStatus==='needs_purchase'?(zh?'未下单（需跑手垫付）':'Not ordered · runner pays upfront'):(zh?'已下单':'Already ordered')}}</view>
</view>
<view wx:if="{{request.runnerId}}" class="flow-card row">
<view class="contact-person"><contact-avatar name="{{runner}}"/><view class="contact-person-copy value">{{runner}}</view></view>
<view class="contact-actions">
<view class="contact-button" bindtap="chat">
<image src="/assets/message.svg"/>
<view wx:if="{{request.unread}}" class="chat-dot"/>
</view>
<view class="contact-button" bindtap="phone">
<image src="/assets/phone.svg"/>
</view>
</view>
</view>
<view wx:if="{{request.isMine && request.category==='takeout' && (request.status==='waiting'||request.status==='taken')}}" class="flow-card rider-photo-card">
<view wx:if="{{!request.riderPhotos.length}}" class="rider-photo-action rider-photo-empty" bindtap="riderPhoto" hover-class="rider-photo-press">
<view class="rider-photo-media">
<image class="rider-photo-placeholder" src="/assets/photo-green.svg" mode="aspectFit"/>
</view>
<view class="rider-photo-copy">
<view class="strong rider-photo-title">
<text wx:if="{{request.night}}" class="rider-photo-title-line">{{zh?'上传相关订单照片':'Upload related order photos'}}</text>
<block wx:else>
<block wx:if="{{zh}}">
<text class="rider-photo-title-line">外卖已送达？</text>
<text class="rider-photo-title-line">添加取件照片</text>
</block>
<block wx:else>
<text class="rider-photo-title-line">Food arrived?</text>
<text class="rider-photo-title-line">Add pickup photos</text>
</block>
</block>
</view>
<view class="rider-photo-help">{{request.night?(zh?'可选':'Optional'):(zh?'选填 · 告诉跑手外卖放在哪里':'Optional · Show where the bag is')}}</view>
</view>
<button class="journey-upload" catchtap="riderPhoto" disabled="{{photoBusy}}" loading="{{photoBusy}}"><text>＋</text><text>{{zh?'上传':'Upload'}}</text></button>
</view>
<view wx:else class="rider-photo-action rider-photo-filled">
<view class="upload-head" data-mode="append" bindtap="riderPhoto" role="button">
<view class="rider-photo-media"><image class="rider-photo-placeholder" src="/assets/photo-green.svg" mode="aspectFit"/></view>
<view class="rider-photo-copy">
<view class="strong rider-photo-title">
<text wx:if="{{request.night}}" class="rider-photo-title-line">{{zh?'上传相关订单照片':'Upload related order photos'}}</text>
<block wx:else>
<block wx:if="{{zh}}">
<text class="rider-photo-title-line">外卖已送达？</text>
<text class="rider-photo-title-line">添加取件照片</text>
</block>
<block wx:else>
<text class="rider-photo-title-line">Food arrived?</text>
<text class="rider-photo-title-line">Add pickup photos</text>
</block>
</block>
</view>
<view class="rider-photo-help">{{request.night?(zh?'可选':'Optional'):(zh?'选填 · 告诉跑手外卖放在哪里':'Optional · Show where the bag is')}}</view>
</view>
</view>
<text class="rider-photo-count">{{request.riderPhotos.length}}/3</text>
<view class="rider-photo-gallery">
<view wx:for="{{request.riderPhotos}}" wx:key="*this" class="rider-photo-thumb" data-index="{{index}}" bindtap="previewRider" hover-class="rider-photo-press">
<image class="rider-photo-preview" src="{{item}}" mode="aspectFill"/>
</view>
<view wx:if="{{request.riderPhotos.length<3}}" class="rider-photo-add-more" data-mode="append" bindtap="riderPhoto" hover-class="rider-photo-press">
<text>＋</text>
</view>
</view>
</view>
<view class="rider-photo-foot">{{zh?'相册上传 · 最多 3 张':'Album · up to 3 photos'}}</view>
</view>
<view wx:if="{{request.orderPictures.length}}" class="flow-card">
<view class="strong">{{zh?'订单图片':'Order photos'}}</view>
<view class="order-picture-list">
<image wx:for="{{request.orderPictures}}" wx:for-item="picture" wx:key="*this" class="order-picture" src="{{picture}}" mode="aspectFill" data-index="{{index}}" bindtap="previewPictures"/>
</view>
</view>
<view wx:if="{{request.photo}}" class="flow-card">
<image class="proof" src="{{request.photo}}" mode="aspectFill" bindtap="preview"/>
<view class="hint">{{zh?'送达照片':'Delivery photo'}} · {{request.deliveredTime}} · {{request.deliveryLocationLabel}}</view>
</view>
<view wx:if="{{request.isMine && request.status==='delivered'}}" class="flow-card">
<view class="soft hint">{{zh?'模拟合计 ¥'+request.total+'。确认后，预览版将向跑手结算 ¥'+request.rewardText+'。':'Demo total ¥'+request.total+'. Confirming settles ¥'+request.rewardText+' to the runner in this preview.'}}</view>

<button class="btn orange" bindtap="confirm">{{zh?'已收到 · 确认 ¥':'Got it · confirm ¥'}}{{request.rewardText}}</button>

<view class="hint">{{zh?'送达 '+request.autoHours+' 小时后（'+request.autoTime+'）自动确认入账。':'Automatically confirms '+request.autoHours+' '+(request.autoHours===1?'hour':'hours')+' after delivery ('+request.autoTime+').'}}</view>

</view>
<view wx:if="{{request.dispute}}" class="flow-card">
<view class="strong">{{request.disputeReason}}</view>
<view class="hint">{{request.dispute.note}}</view>
</view>
<view class="flow-card journey-details">
 <view class="journey-details-title">{{zh?'订单详情':'Order details'}}</view>
 <view class="journey-detail-row"><view class="journey-detail-label"><text class="journey-detail-icon">▣</text><text>{{zh?'取件点':'Pickup'}}</text></view><text class="journey-detail-value">{{request.pickupDisplay||request.pickupPointDisplay||request.station}}</text></view>
 <view class="journey-detail-row"><view class="journey-detail-label"><text class="journey-detail-icon">⌖</text><text>{{zh?'送达地点':'Deliver to'}}</text></view><text class="journey-detail-value">{{request.destinationDisplay}}</text></view>
 <view wx:if="{{request.category==='takeout'}}" class="journey-detail-row"><view class="journey-detail-label"><text class="journey-detail-icon">♧</text><text>{{zh?'外卖到达':'Food arrival'}}</text></view><text class="journey-detail-value">{{request.arrivalLabel}}</text></view>
 <view wx:if="{{request.category==='parcel' && request.isMine}}" wx:for="{{request.parcelItems}}" wx:key="index" class="journey-parcel-detail">{{zh?'包裹 ':'Parcel '}}{{index+1}} · {{item.pickupPoint||request.station}} · {{item.code}}</view>
 <view class="journey-detail-row journey-price-row"><view class="journey-detail-label"><text class="journey-detail-icon">◉</text><text>{{zh?'赏金':'Price'}}</text></view><text class="journey-price">¥{{request.rewardText}}</text></view>
 <view wx:if="{{request.discount}}" class="journey-detail-row"><text>{{zh?'优惠券':'Coupon'}}</text><text>−¥{{request.discount}}</text></view>
 <view wx:if="{{request.discount || request.fee!=='0.00'}}" class="journey-detail-row journey-net-total"><text>{{zh?'模拟合计':'Demo total'}}</text><text>¥{{request.total}}</text></view>
 <view wx:if="{{request.note}}" class="journey-order-note">{{request.note}}</view>
</view>

<order-feedback order-id="{{request.id}}" resolvable="{{request.canResolveFeedback}}" completes="{{request.feedbackResolutionCompletes}}" zh="{{zh}}" dark="{{darkClass}}"/>
<button wx:if="{{request.isMine && (request.status==='confirmed'||request.status==='cancelled'||request.status==='refunded')}}" class="btn outline" bindtap="repeat">{{zh?'再来一单':'Post again'}}</button>
</view>
<view wx:else class="empty">{{zh?'订单暂不可用，请检查网络和账号。':'Request unavailable. Check your connection and account.'}}</view>
<yuni-assistant topic=""/>
<view wx:if="{{celebrate&&request}}" class="yuni-mask" bindtap="closeCelebrate" catchtouchmove="noop">
<view class="yuni-pop" catchtap="noop">
<view class="yuni-badge">{{request.night?successUI.typeNight:request.category==='takeout'?successUI.typeTakeout:successUI.typeParcel}}</view>
<view class="yuni-mark">
<view class="yuni-tick"/>
</view>
<view class="yuni-title">{{successUI.success}}</view>
<view class="yuni-sub">{{successUI.waitingRunner}}</view>
<view class="yuni-stage">
<video wx:if="{{videoSrc&&!videoFailed}}" class="yuni-video" src="{{videoSrc}}" autoplay muted loop="{{false}}" controls="{{false}}" show-center-play-btn="{{false}}" show-play-btn="{{false}}" show-fullscreen-btn="{{false}}" show-progress="{{false}}" show-mute-btn="{{false}}" enable-progress-gesture="{{false}}" object-fit="cover" binderror="videoError"/>
<image wx:if="{{videoFailed}}" class="yuni-still" src="/assets/yuni-happy.png" mode="aspectFit"/>
</view>
<view class="yuni-foot">
<view class="yuni-foot-main">
<view class="yuni-route">{{request.pickupDisplay||successUI.labels[request.station]||request.station}} → {{successUI.labels[request.dorm]||request.dorm}}</view>
<view class="yuni-meta">{{request.night?successUI.typeNight:request.category==='takeout'?successUI.typeTakeout:successUI.typeParcel}} · {{request.boxes}}{{request.category==='takeout'?successUI.bagUnit:successUI.parcelUnit}} · ¥{{request.total}}</view>
</view>
<view class="yuni-pill">{{successUI.pending}}</view>
</view>
<view class="yuni-cta" bindtap="track">{{successUI.viewOrder}}<text class="yuni-arrow">›</text>
</view>
</view>
</view>
</view>

<template is="customerCancelSheet" data="{{cancelOpen,cancelOptions,cancelReason,cancelNote,cancelNoteOpen,cancelReady,cancelling,zh}}"/>

<view wx:if="{{request.cancelReasonLabel}}" class="flow-card"><view class="strong">{{zh?'取消原因':'Cancellation reason'}}</view><view>{{request.cancelReasonLabel}}</view></view>

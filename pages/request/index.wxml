<view class="flow-page" wx:if="{{request}}"><view class="flow-title">{{zh?(request.isMine?'我的订单':'订单详情'):request.isMine?'My request':'Order details'}}</view><view class="flow-sub">{{request.sizeLabel}} · {{request.boxes}} {{request.unitLabel}} · {{request.destinationDisplay}}</view>
<view class="flow-card status-card"><image class="status-yuni" src="/assets/yuni-wave.png" mode="aspectFit"/><view class="flow-title status-{{request.status}}">{{request.status==='taken'?runner+(zh?' 已接单':' took your request'):request.statusLabel}}</view><view class="hint" wx:if="{{request.cancellation && request.status==='waiting'}}">{{zh?request.cancellation.runner+' 已取消。你的订单已按原赏金重新发布，不额外收费。':request.cancellation.runner+' cancelled. Your order is back on the board at the same offer. No extra charge.'}}</view><view class="hint" wx:elif="{{request.status==='delivered'}}">{{zh?runner+' 已于 '+request.deliveredTime+' 送达：'+request.deliveryLocationLabel+'。':runner+' left it '+request.deliveryLocationLabel+' at '+request.deliveredTime+'.'}}</view><view class="hint" wx:elif="{{request.status==='disputed'}}">{{zh?'结算已暂停。你的反馈已保存到云端；测试版暂未提供客服后台。':'Settlement is paused. Your report is saved in the cloud; this test has no support dashboard yet.'}}</view><view class="hint" wx:elif="{{request.status==='refunded'||request.status==='cancelled'}}">{{zh?'模拟退款：':'Demo refund: '}}¥{{request.refundAmount}}</view></view>
<view wx:if="{{request.runnerId}}" class="flow-card row"><view class="value">{{runner}}</view><view class="contact-actions"><view class="contact-button" bindtap="chat"><image src="/assets/message.svg"/><text wx:if="{{request.unread}}" class="unread">{{request.unread}}</text></view><view class="contact-button" bindtap="phone"><image src="/assets/phone.svg"/></view></view></view>
<view wx:if="{{request.isMine && request.status==='waiting'}}" class="flow-card"><view class="row"><text class="strong">{{zh?'暂无跑手接单':'No runner yet'}}</text><text wx:if="{{request.closesAt}}" class="link">{{zh?request.closeTime+' 关闭':'closes '+request.closeTime}}</text></view><view class="hint">{{zh?'你的赏金为 ¥'+request.rewardText+'。加价只对整笔订单计算一次，不按袋计算。':'You’re offering ¥'+request.rewardText+'. A raise is added once to the whole order, not per bag.'}}</view><view class="pill-row"><text class="pill" data-amount="1.88" bindtap="raise">＋ ¥1.88</text><text class="pill" data-amount="2.66" bindtap="raise">＋ ¥2.66</text><text class="pill" data-amount="5.55" bindtap="raise">＋ ¥5.55</text><text class="pill" data-amount="6.66" bindtap="raise">＋ ¥6.66</text><text class="pill" data-amount="8.88" bindtap="raise">＋ ¥8.88</text></view><view class="hint" wx:if="{{request.closesAt}}">{{zh?'如果 '+request.closeTime+' 前无人接单，订单将关闭并全额模拟退款。':'If nobody takes it by '+request.closeTime+', it closes with a full demo refund.'}}</view><view class="cancel-link" bindtap="cancel">{{zh?'取消订单 · 接单前免费':'Cancel · free until a runner takes it'}}</view></view>
<view wx:if="{{request.isMine && request.category==='takeout' && (request.status==='waiting'||request.status==='taken')}}" class="flow-card"><view class="strong">{{zh?'外卖晚到了？':'Food running late?'}}</view><view class="hint">{{zh?'如果外卖晚到，可以修改一次预计送达时间。':'If your food arrives later, move the ETA once.'}}</view><picker mode="time" disabled="{{!request.canMoveEta}}" bindchange="late"><button class="btn outline" disabled="{{!request.canMoveEta}}">{{zh?(request.etaMoved?'已更新送达时间':'我的外卖晚到了'):request.etaMoved?'Arrival time updated':'My food is late'}}</button></picker></view><view wx:if="{{request.isMine && request.category==='takeout' && (request.status==='waiting'||request.status==='taken')}}" class="dash" bindtap="riderPhoto"><view class="strong">{{zh?(request.riderPhoto?'更换骑手送达照片':'外卖到了？添加骑手送达照片'):request.riderPhoto?'Replace the rider’s photo':'Food arrived? Add the rider’s photo'}}</view><view class="hint">{{zh?'来自美团或饿了么，用来显示外卖放在哪里。':'From Meituan or Ele.me. It shows where the bag is.'}}</view></view><image wx:if="{{request.riderPhoto}}" class="thumb" src="{{request.riderPhoto}}" mode="aspectFill" bindtap="previewRider"/>
<view wx:if="{{request.photo}}" class="flow-card"><image class="proof" src="{{request.photo}}" mode="aspectFill" bindtap="preview"/><view class="hint">{{zh?'送达照片':'Delivery photo'}} · {{request.deliveredTime}} · {{request.deliveryLocationLabel}}</view></view>
<view wx:if="{{request.isMine && request.status==='delivered'}}" class="flow-card"><view class="soft hint">{{zh?'模拟合计 ¥'+request.total+'。确认后，预览版将向跑手结算 ¥'+request.rewardText+'。':'Demo total ¥'+request.total+'. Confirming settles ¥'+request.rewardText+' to the runner in this preview.'}}</view><block wx:if="{{!reporting}}"><button class="btn orange" bindtap="confirm">{{zh?'已收到 · 确认 ¥':'Got it · confirm ¥'}}{{request.rewardText}}</button><button class="btn outline" disabled="{{!request.canReport}}" bindtap="issue">{{zh?'有问题':'Something’s wrong'}}</button><view class="hint">{{zh?'送达 '+request.autoHours+' 小时后（'+request.autoTime+'）自动确认。预览版只在打开小程序时检查。':'Automatically confirms '+request.autoHours+' '+(request.autoHours===1?'hour':'hours')+' after delivery ('+request.autoTime+'). In this preview, the check runs when the app is open.'}}</view></block><block wx:else><view class="strong">{{zh?'遇到了什么问题？':'What went wrong?'}}</view><view wx:for="{{reasons}}" wx:key="*this" class="pill" style="margin-top:14rpx" data-value="{{item}}" bindtap="chooseReason">{{reason===item?'◉':'○'}} {{reasonLabels[index]||item}}</view><view class="dash" bindtap="addIssuePhoto">{{zh?(issuePhoto?'✓ 已添加照片 · 更换':'添加照片（洒漏时必填）'):issuePhoto?'✓ Photo added · replace':'Add a photo (needed for spilled food)'}}</view><textarea class="field" placeholder="{{zh?'描述一下问题':'Describe the issue'}}" value="{{issueNote}}" bindinput="note" maxlength="500"/><view class="action-row"><button class="btn outline" bindtap="backIssue">{{zh?'返回':'Back'}}</button><button class="btn" disabled="{{!reason}}" bindtap="report">{{zh?'提交反馈':'Submit report'}}</button></view></block></view>
<view wx:if="{{request.dispute}}" class="flow-card"><view class="strong">{{request.disputeReason}}</view><view class="hint">{{request.dispute.note}}</view></view>
<view class="flow-card"><view class="strong">{{zh?'进度':'Progress'}}</view><view wx:for="{{steps}}" wx:key="name" class="timeline"><text style="color:{{item.done?'#31584f':'#ccc'}}">{{item.done?'●':'○'}}</text><text>{{item.name}}</text><text>{{item.time}}</text></view><view wx:for="{{request.history}}" wx:key="index" class="hint">{{item.time}} · {{item.label}}</view></view>
<view class="flow-card"><view class="strong">{{zh?'详情':'Details'}}</view><view class="row hint"><text>{{zh?'路线':'Route'}}</text><text>{{request.station}} → {{request.destinationDisplay}}</text></view><view class="row hint" wx:if="{{request.category==='takeout'}}"><text>{{zh?'外卖送达':'Food arrives'}}</text><text>{{request.arrivalLabel}}</text></view><view wx:if="{{request.closesAt}}" class="row hint"><text>{{zh?'无人接单关闭时间':'Closes if no one takes it'}}</text><text>{{request.closeTime}}</text></view><view class="row hint"><text>{{zh?'你的赏金':'Your offer'}}</text><text class="strong">¥{{request.rewardText}} + ¥{{request.fee}} {{zh?'服务费':'service'}}</text></view><view wx:if="{{request.discount}}" class="row hint"><text>{{zh?'优惠券':'Coupon'}}</text><text>−¥{{request.discount}}</text></view><view class="divider"/><view class="row strong"><text>{{zh?'模拟合计':'Demo total'}}</text><text>¥{{request.total}}</text></view><view class="hint">{{request.note}}</view></view><button wx:if="{{request.isMine && (request.status==='confirmed'||request.status==='cancelled'||request.status==='refunded')}}" class="btn outline" bindtap="repeat">{{zh?'再来一单':'Post again'}}</button></view><view wx:else class="empty">{{zh?'订单暂不可用，请检查网络和账号。':'Request unavailable. Check your connection and account.'}}</view>
<yuni-assistant topic=""/>
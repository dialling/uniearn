<view style="{{motionStyle}}">
<lang-switch/>
<view class="flow-page {{darkClass}}" wx:if="{{request}}"><view class="flow-title">{{zh?(request.isMine?'我的订单':'订单详情'):request.isMine?'My request':'Order details'}}</view><view class="flow-sub">{{request.sizeLabel}} · {{request.boxes}} {{request.unitLabel}} · {{request.destinationDisplay}}</view><view wx:if="{{request.category==='takeout' && request.night}}" class="flow-card"><view class="strong">{{zh?'订单状态':'Order status'}}</view><view class="hint">{{request.purchaseStatus==='needs_purchase'?(zh?'未下单（需跑手垫付）':'Not ordered · runner pays upfront'):(zh?'已下单':'Already ordered')}}</view></view><view class="flow-card status-card"><image class="status-yuni" src="/assets/yuni-wave.png" mode="aspectFit"/><view class="flow-title status-{{request.status}}">{{request.status==='taken'?runner+(zh?' 已接单':' took your request'):request.statusLabel}}</view><view class="hint" wx:if="{{request.cancellation && request.status==='waiting'}}">{{zh?request.cancellation.runner+' 已取消。你的订单已按原赏金重新发布，不额外收费。':request.cancellation.runner+' cancelled. Your order is back on the board at the same offer. No extra charge.'}}</view><view class="hint" wx:elif="{{request.status==='delivered'}}">{{zh?runner+' 已于 '+request.deliveredTime+' 送达：'+request.deliveryLocationLabel+'。':runner+' left it '+request.deliveryLocationLabel+' at '+request.deliveredTime+'.'}}</view><view class="hint" wx:elif="{{request.status==='disputed'}}">{{zh?'结算已暂停。你的反馈已保存到云端；测试版暂未提供客服后台。':'Settlement is paused. Your report is saved in the cloud; this test has no support dashboard yet.'}}</view><view class="hint" wx:elif="{{request.status==='refunded'||request.status==='cancelled'}}">{{zh?'模拟退款：':'Demo refund: '}}¥{{request.refundAmount}}</view></view><view wx:if="{{request.runnerId}}" class="flow-card row"><view class="value">{{runner}}</view><view class="contact-actions"><view class="contact-button" bindtap="chat"><image src="/assets/message.svg"/><text wx:if="{{request.unread}}" class="unread">{{request.unread}}</text></view><view class="contact-button" bindtap="phone"><image src="/assets/phone.svg"/></view></view></view><view wx:if="{{request.isMine && request.status==='waiting'}}" class="flow-card"><view class="row"><text class="strong">{{zh?'暂无跑手接单':'No runner yet'}}</text><text wx:if="{{request.closesAt}}" class="link">{{zh?request.closeTime+' 关闭':'closes '+request.closeTime}}</text></view><view class="hint">{{zh?'你的赏金为 ¥'+request.rewardText+'。加价只对整笔订单计算一次，不按袋计算。':'You’re offering ¥'+request.rewardText+'. A raise is added once to the whole order, not per bag.'}}</view><view class="pill-row"><text class="pill" data-amount="1.88" bindtap="raise">＋ ¥1.88</text><text class="pill" data-amount="2.66" bindtap="raise">＋ ¥2.66</text><text class="pill" data-amount="5.55" bindtap="raise">＋ ¥5.55</text><text class="pill" data-amount="6.66" bindtap="raise">＋ ¥6.66</text><text class="pill" data-amount="8.88" bindtap="raise">＋ ¥8.88</text></view><view class="hint" wx:if="{{request.closesAt}}">{{zh?'如果 '+request.closeTime+' 前无人接单，订单将关闭并全额模拟退款。':'If nobody takes it by '+request.closeTime+', it closes with a full demo refund.'}}</view><button class="cancel-order-button" hover-class="cancel-order-press" bindtap="cancel">{{zh?'取消订单':'Cancel order'}}</button></view><view wx:if="{{request.isMine && request.category==='takeout' && (request.status==='waiting'||request.status==='taken')}}" class="flow-card customer-arrival-card"><view class="strong">{{zh?(request.arrived?'外卖已送达':'外卖提前送达了？'):request.arrived?'Food has arrived':'Food arrived early?'}}</view><view class="hint">{{zh?(request.arrived?'已由你确认送达取件点，跑手可以据此安排取餐。':'外卖已放到取件点时，更新状态，方便跑手安排取餐。也可以与跑手交流。'):request.arrived?'You confirmed that the food is at the pickup point. Your runner can plan pickup.':'Once your food is at the pickup point, update its status so your runner can plan pickup. You can also message your runner.'}}</view><button class="btn outline customer-status-button" hover-class="customer-status-button-press" disabled="{{request.arrived}}" bindtap="foodArrived">{{zh?'外卖已送达取件点':'Food is at the pickup point'}}</button></view><view wx:if="{{request.isMine && request.category==='takeout' && !request.arrived && (request.status==='waiting'||request.status==='taken')}}" class="flow-card customer-late-card"><view class="strong">{{zh?'外卖晚到了？':'Food running late?'}}</view><view class="hint">{{zh?'如果外卖晚到，可以修改一次预计送达时间。':'If your food arrives later, move the ETA once.'}}</view><button class="btn outline customer-status-button" hover-class="customer-status-button-press" disabled="{{!request.canMoveEta}}" bindtap="openLateOptions">{{zh?(request.etaMoved?'已更新送达时间':'我的外卖晚到了'):request.etaMoved?'Arrival time updated':'My food is late'}}</button><view wx:if="{{lateOptionsOpen && request.canMoveEta}}" class="late-options-panel"><view class="late-options-title">{{zh?'预计晚到多久？':'How late will it be?'}}</view><view class="late-options-grid"><button wx:for="{{latePresets}}" wx:key="*this" class="late-option" hover-class="late-option-press" data-minutes="{{item}}" bindtap="chooseLatePreset">+{{item}}</button><button class="late-option late-option-other {{lateCustomOpen?'selected':''}}" hover-class="late-option-press" bindtap="chooseLateOther">＋</button></view><view wx:if="{{lateCustomOpen}}" class="late-custom-row"><view class="late-custom-field"><input always-embed type="number" value="{{lateMinutes}}" bindinput="inputLateMinutes" placeholder="{{zh?'输入分钟数':'Minutes'}}"/><text>{{zh?'分钟':'min'}}</text></view><button class="late-custom-confirm" hover-class="late-option-press" disabled="{{!lateMinutes}}" bindtap="confirmLateCustom">{{zh?'确认':'Confirm'}}</button></view><view class="hint late-options-hint">{{zh?'可自行填写预计晚到时长，且只能修改一次。':'Choose any delay in minutes. You can change it once.'}}</view></view></view><view wx:if="{{request.isMine && request.category==='takeout' && (request.status==='waiting'||request.status==='taken')}}" class="flow-card rider-photo-card"><view wx:if="{{!request.riderPhotos.length}}" class="rider-photo-action rider-photo-empty" bindtap="riderPhoto" hover-class="rider-photo-press"><view class="rider-photo-media"><image class="rider-photo-placeholder" src="/assets/photo-orange.svg" mode="aspectFit"/></view><view class="rider-photo-copy"><view class="strong rider-photo-title"><block wx:if="{{zh}}"><text class="rider-photo-title-line">外卖已送达？</text><text class="rider-photo-title-line">添加骑手照片（选填）</text></block><block wx:else><text class="rider-photo-title-line">Food arrived?</text><text class="rider-photo-title-line">Add the rider’s photo (optional)</text></block></view><view class="rider-photo-help">{{zh?'用于告诉跑手外卖袋放置的位置。':'It shows your runner where the bag is.'}}</view></view><text class="rider-photo-count">0/3</text></view><view wx:else class="rider-photo-action rider-photo-filled"><view class="rider-photo-copy"><view class="strong rider-photo-title"><block wx:if="{{zh}}"><text class="rider-photo-title-line">外卖已送达？</text><text class="rider-photo-title-line">添加骑手照片（选填）</text></block><block wx:else><text class="rider-photo-title-line">Food arrived?</text><text class="rider-photo-title-line">Add the rider’s photo (optional)</text></block></view><view class="rider-photo-help">{{zh?'用于告诉跑手外卖袋放置的位置。':'It shows your runner where the bag is.'}}</view></view><text class="rider-photo-count">{{request.riderPhotos.length}}/3</text><view class="rider-photo-gallery"><view wx:for="{{request.riderPhotos}}" wx:key="*this" class="rider-photo-thumb" data-index="{{index}}" bindtap="previewRider" hover-class="rider-photo-press"><image class="rider-photo-preview" src="{{item}}" mode="aspectFill"/></view><view wx:if="{{request.riderPhotos.length<3}}" class="rider-photo-add-more" data-mode="append" bindtap="riderPhoto" hover-class="rider-photo-press"><text>＋</text></view></view></view><view class="rider-photo-foot">{{zh?'相册上传 · 最多 3 张':'Album · up to 3 photos'}}</view></view><view wx:if="{{request.orderPictures.length}}" class="flow-card"><view class="strong">{{zh?'订单图片':'Order photos'}}</view><view class="order-picture-list"><image wx:for="{{request.orderPictures}}" wx:for-item="picture" wx:key="*this" class="order-picture" src="{{picture}}" mode="aspectFill" data-index="{{index}}" bindtap="previewPictures"/></view></view><view wx:if="{{request.photo}}" class="flow-card"><image class="proof" src="{{request.photo}}" mode="aspectFill" bindtap="preview"/><view class="hint">{{zh?'送达照片':'Delivery photo'}} · {{request.deliveredTime}} · {{request.deliveryLocationLabel}}</view></view><view wx:if="{{request.isMine && request.status==='delivered'}}" class="flow-card"><view class="soft hint">{{zh?'模拟合计 ¥'+request.total+'。确认后，预览版将向跑手结算 ¥'+request.rewardText+'。':'Demo total ¥'+request.total+'. Confirming settles ¥'+request.rewardText+' to the runner in this preview.'}}</view><block wx:if="{{!reporting}}"><button class="btn orange" bindtap="confirm">{{zh?'已收到 · 确认 ¥':'Got it · confirm ¥'}}{{request.rewardText}}</button><button class="btn outline" disabled="{{!request.canReport}}" bindtap="issue">{{zh?'有问题':'Something’s wrong'}}</button><view class="hint">{{zh?'送达 '+request.autoHours+' 小时后（'+request.autoTime+'）自动确认入账。':'Automatically confirms '+request.autoHours+' '+(request.autoHours===1?'hour':'hours')+' after delivery ('+request.autoTime+').'}}</view></block><block wx:else><view class="strong">{{zh?'遇到了什么问题？':'What went wrong?'}}</view><view wx:for="{{reasons}}" wx:key="*this" class="pill" style="margin-top:14rpx" data-value="{{item}}" bindtap="chooseReason">{{reason===item?'◉':'○'}} {{reasonLabels[index]||item}}</view><view class="dash" bindtap="addIssuePhoto">{{zh?(issuePhoto?'✓ 已添加照片 · 更换':'添加照片（洒漏时必填）'):issuePhoto?'✓ Photo added · replace':'Add a photo (needed for spilled food)'}}</view><textarea class="field" placeholder="{{zh?'描述一下问题':'Describe the issue'}}" value="{{issueNote}}" bindinput="note" maxlength="500"/><view class="action-row"><button class="btn outline" bindtap="backIssue">{{zh?'返回':'Back'}}</button><button class="btn" disabled="{{!reason}}" bindtap="report">{{zh?'提交反馈':'Submit report'}}</button></view></block></view><view wx:if="{{request.dispute}}" class="flow-card"><view class="strong">{{request.disputeReason}}</view><view class="hint">{{request.dispute.note}}</view></view><view class="flow-card"><view class="strong">{{zh?'进度':'Progress'}}</view><view wx:for="{{steps}}" wx:key="name" class="timeline"><text style="color:{{item.done?'#c2410c':'#d6d2c6'}}">{{item.done?'●':'○'}}</text><text>{{item.name}}</text><text>{{item.time}}</text></view><view wx:for="{{request.history}}" wx:key="index" class="hint">{{item.time}} · {{item.label}}</view></view><view class="flow-card"><view class="strong">{{zh?'详情':'Details'}}</view><view wx:if="{{request.category==='takeout' && !request.night && request.pickupPoint}}" class="row hint"><text>{{zh?'外卖柜':'Takeaway locker'}}</text><text>{{request.pickupPointDisplay}}</text></view><view wx:if="{{request.category==='parcel' && request.isMine}}" wx:for="{{request.parcelItems}}" wx:key="index" class="hint">{{zh?'包裹 ':'Parcel '}}{{index+1}} · {{item.pickupPoint||request.station}} · {{item.code}}</view><view class="row hint"><text>{{zh?'路线':'Route'}}</text><text>{{request.station}} → {{request.destinationDisplay}}</text></view><view class="row hint" wx:if="{{request.category==='takeout'}}"><text>{{zh?'外卖送达':'Food arrives'}}</text><text>{{request.arrivalLabel}}</text></view><view wx:if="{{request.closesAt}}" class="row hint"><text>{{zh?'无人接单关闭时间':'Closes if no one takes it'}}</text><text>{{request.closeTime}}</text></view><view class="row hint"><text>{{zh?'你的赏金':'Your offer'}}</text><text class="strong">¥{{request.rewardText}} + ¥{{request.fee}} {{zh?'服务费':'service'}}</text></view><view wx:if="{{request.discount}}" class="row hint"><text>{{zh?'优惠券':'Coupon'}}</text><text>−¥{{request.discount}}</text></view><view class="divider"/><view class="row strong"><text>{{zh?'模拟合计':'Demo total'}}</text><text>¥{{request.total}}</text></view><view class="hint">{{request.note}}</view></view><button wx:if="{{request.isMine && (request.status==='confirmed'||request.status==='cancelled'||request.status==='refunded')}}" class="btn outline" bindtap="repeat">{{zh?'再来一单':'Post again'}}</button></view><view wx:else class="empty">{{zh?'订单暂不可用，请检查网络和账号。':'Request unavailable. Check your connection and account.'}}</view><yuni-assistant topic=""/><view wx:if="{{celebrate&&request}}" class="yuni-mask" bindtap="closeCelebrate" catchtouchmove="noop"><view class="yuni-pop" catchtap="noop"><view class="yuni-badge">{{request.night?successUI.typeNight:request.category==='takeout'?successUI.typeTakeout:successUI.typeParcel}}</view><view class="yuni-mark"><view class="yuni-tick"/></view><view class="yuni-title">{{successUI.success}}</view><view class="yuni-sub">{{successUI.waitingRunner}}</view><view class="yuni-stage"><video wx:if="{{videoSrc&&!videoFailed}}" class="yuni-video" src="{{videoSrc}}" autoplay muted loop="{{false}}" controls="{{false}}" show-center-play-btn="{{false}}" show-play-btn="{{false}}" show-fullscreen-btn="{{false}}" show-progress="{{false}}" show-mute-btn="{{false}}" enable-progress-gesture="{{false}}" object-fit="cover" binderror="videoError"/><image wx:if="{{videoFailed}}" class="yuni-still" src="/assets/yuni-happy.png" mode="aspectFit"/></view><view class="yuni-foot"><view class="yuni-foot-main"><view class="yuni-route">{{successUI.labels[request.station]||request.station}} → {{successUI.labels[request.dorm]||request.dorm}}</view><view class="yuni-meta">{{request.night?successUI.typeNight:request.category==='takeout'?successUI.typeTakeout:successUI.typeParcel}} · {{request.boxes}}{{request.category==='takeout'?successUI.bagUnit:successUI.parcelUnit}} · ¥{{request.total}}</view></view><view class="yuni-pill">{{successUI.pending}}</view></view><view class="yuni-cta" bindtap="track">{{successUI.viewOrder}}<text class="yuni-arrow">›</text></view></view></view>
</view>

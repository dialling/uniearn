.page-dark .journey-pin{filter:brightness(0) invert(1)}

/* Expanded waiting-offer controls reuse the shared offer layout. */
.journey-ticket-actions{display:flex;margin-top:20rpx}.journey-ticket-actions>button.journey-cancel{flex:1;min-width:0;width:100%;margin:0;padding:15rpx 12rpx;font-size:25rpx;line-height:1.5;border-radius:15rpx}.journey-offer-panel.offer-card{padding:22rpx 0 0;margin-top:16rpx;border-top:1rpx dashed #d8cfbd}.journey-offer-panel .offer-hint{font-size:21rpx;line-height:1.6;color:#787b6e}.journey-offer-panel button.offer-option[disabled]{opacity:.5}.journey-offer-panel button.offer-option::after{border:0}.page-dark .journey-offer-panel{border-color:#56634e}.page-dark .journey-offer-panel .offer-hint{color:#a9b3a3}

/* 取消原因弹层：选项变多后按钮可能被挤出可视区，操作区固定在底部 */
.cancel-sheet{background:#fff;max-height:70vh;overflow-y:auto}
.cancel-sheet .soft{padding:14rpx 0}
.cancel-sheet .action-row{position:sticky;bottom:-30rpx;background:inherit;padding:16rpx 0 4rpx}.cancel-sheet>button.btn{position:sticky;bottom:0;z-index:1}
.page-dark .cancel-sheet{background:#242522}
.confirm-row{display:flex;align-items:center;gap:16rpx;margin-top:16rpx}.confirm-row .btn{flex:1;min-width:0;margin:0}.confirm-row .btn.confirm-main{background:#0b7a55;color:#fff}.confirm-row .btn.report-btn{background:#fff;color:#c2410c;border:2rpx solid #f2c4a8}.confirm-row .btn.report-btn[disabled]{color:#c9b8ab;border-color:#eee3da}.confirm-info{flex:none;display:flex;align-items:center;justify-content:center;width:64rpx;height:64rpx;border-radius:50%;background:#f0efea}.confirm-info image{width:34rpx;height:34rpx}.confirm-info-press{opacity:.6}.page-dark .confirm-row .btn.confirm-main{background:#6fd0a8;color:#16181c}.page-dark .confirm-row .btn.report-btn{background:#242522;color:#f4a06e;border-color:#5a3a26}.page-dark .confirm-info{background:#2b2d29}
.contact-button.contact-3d{background:#fff;border:0;box-shadow:0 4rpx 12rpx rgba(22,24,28,.08),inset 0 0 0 1rpx rgba(22,24,28,.05)}.contact-button.contact-3d image{width:46rpx;height:46rpx}.page-dark .contact-button.contact-3d{background:#2b2d29!important}
.report-link{display:flex;align-items:center;justify-content:center;gap:10rpx;margin:18rpx 0 4rpx;padding:12rpx 0;color:#8a877e;font-size:24rpx}.report-link image{width:28rpx;height:28rpx}.report-link-press{opacity:.55}.page-dark .report-link{color:#a9a69c}
.report-link.has-reply{color:#0b7a55;font-weight:700}.report-dot{width:14rpx;height:14rpx;border-radius:50%;background:#e5484d}
.report-nudge{margin:14rpx 0 6rpx;padding:14rpx 20rpx;border-radius:16rpx;background:#fff4e2;color:#8a4b13;font-size:24rpx;line-height:1.45}.page-dark .report-nudge{background:#3a2a1a;color:#f4c79a}
.report-contact{margin:18rpx 0 8rpx}.report-contact .report-nudge{margin:0 0 12rpx}.report-contact button.report-contact-btn{display:flex;align-items:center;justify-content:center;gap:10rpx;width:100%!important;max-width:none;margin:0;padding:0;height:84rpx;line-height:84rpx;border:2rpx solid #0b7a55;border-radius:20rpx;background:#fff;color:#0b7a55;font-size:27rpx;font-weight:700}.report-contact-btn::after{border:0}.report-contact-press{background:#eef6f1!important}.page-dark .report-contact button.report-contact-btn{background:#242522;border-color:#6fd0a8;color:#6fd0a8}
.order-no{text-transform:uppercase;font-variant-numeric:tabular-nums;letter-spacing:.5rpx}

@import "../../utils/contact-identity.wxss";
@import "../../utils/order-success.wxss";
@import "../../utils/order-pictures.wxss";
@import "../../utils/flow.wxss";

@import "../../utils/order-detail-cards.wxss";
.contact-actions{display:flex;gap:16rpx}
.contact-button{position:relative;width:66rpx;height:66rpx;border:1rpx solid #e2e0d9;border-radius:50%;display:flex;align-items:center;justify-content:center}
.contact-button image{width:30rpx;height:30rpx}


.flow-page .btn.orange{background:#c2410c}

.page-dark.flow-page .btn.orange{background:#f4a06e;color:#16181c}


.rider-photo-card{padding:28rpx}
.rider-photo-action{position:relative;display:flex;flex-direction:column;align-items:stretch;gap:22rpx;min-height:176rpx;padding:24rpx;border:2rpx dashed #f2a678;border-radius:28rpx;background:#fff;transition:var(--ue-transition,transform .16s ease,background .16s ease)}
.rider-photo-empty{flex-direction:row;align-items:center;gap:24rpx}
.rider-photo-empty .rider-photo-copy{flex:1}
.rider-photo-press{transform:scale(.985);background:#fff7f0}
.rider-photo-media{flex:0 0 104rpx;width:104rpx;height:104rpx;border-radius:24rpx;background:#fff1e6;overflow:hidden;display:flex;align-items:center;justify-content:center}
.rider-photo-preview{display:block;width:100%;height:100%}
.rider-photo-placeholder{width:52rpx;height:52rpx;opacity:1}
.rider-photo-copy{min-width:0;padding-right:64rpx}
.rider-photo-copy .strong{font-size:28rpx;line-height:1.35}
.rider-photo-title{color:#16181c}
.rider-photo-title-line{display:block;white-space:nowrap}
.rider-photo-help{margin-top:12rpx;color:#77746c;font-size:23rpx;line-height:1.5}
.rider-photo-count{position:absolute;right:18rpx;top:18rpx;padding:5rpx 12rpx;border-radius:18rpx;background:#fff1e6;color:#c2410c;font-size:20rpx;font-weight:700}
.rider-photo-gallery{display:flex;align-items:center;gap:14rpx;min-height:112rpx}
.rider-photo-thumb,.rider-photo-add-more{flex:0 0 112rpx;width:112rpx;height:112rpx;border-radius:22rpx;overflow:hidden}
.rider-photo-thumb{background:#f3f1ec}
.rider-photo-add-more{display:flex;align-items:center;justify-content:center;border:2rpx dashed #f2a678;background:#fff1e6;color:#c2410c;font-size:48rpx;font-weight:400;box-sizing:border-box}
.rider-photo-foot{margin-top:14rpx;color:#8a877e;font-size:22rpx}
.page-dark .rider-photo-action{background:#242522;border-color:#4aaa86}
.page-dark .rider-photo-press{background:#173c31}
.page-dark .rider-photo-media,.page-dark .rider-photo-count{background:#173c31;color:#76d7b3}
.page-dark .rider-photo-help{color:#aaa79f}

.btn.outline.customer-status-button{display:flex;align-items:center;justify-content:center;width:58%;min-width:300rpx;min-height:88rpx;margin:22rpx auto 10rpx;padding:18rpx 22rpx;border:2rpx solid #b9d6ca;border-radius:22rpx;background:#f3faf6;color:#16815e;font-size:27rpx;font-weight:800;line-height:1.35;text-align:center;white-space:nowrap;box-shadow:0 4rpx 10rpx rgba(11,122,85,.08);transition:var(--ue-transition,transform .14s ease,background .14s ease,border-color .14s ease)}
.btn.outline.customer-status-button-press{transform:scale(.97);background:#e4f3ec;border-color:#79bfa4}
.btn.outline.customer-status-button[disabled]{border-color:#d6e5de;background:#f4f8f6;color:#74a391;box-shadow:none;opacity:1}
.late-options-panel{margin-top:20rpx;padding:20rpx;border-radius:20rpx;background:#f7f9f7;border:1rpx solid #dce8e2}
.late-options-title{margin-bottom:14rpx;font-size:24rpx;font-weight:800;color:#263d34}
.late-options-grid{display:flex;flex-wrap:nowrap;align-items:center;justify-content:space-between;gap:14rpx}
.late-option{display:flex;align-items:center;justify-content:center;flex:0 0 94rpx;width:94rpx;height:94rpx;min-height:94rpx;margin:0;padding:0;border:2rpx solid #b9d6ca;border-radius:50%;background:#fff;color:#16815e;font-size:24rpx;font-weight:750;line-height:1}
.late-option-other{font-size:34rpx;font-weight:500}
.late-option.selected{background:#e7f3ed;border-color:#79bfa4}
.late-option-press{transform:scale(.97);background:#e7f3ed}
.late-custom-row{display:flex;align-items:center;gap:12rpx;margin-top:14rpx}
.late-custom-field{display:flex;align-items:center;flex:1;height:76rpx;padding:0 18rpx;border:2rpx solid #b9d6ca;border-radius:18rpx;background:#fff;color:#5e5c55}
.late-custom-field input{flex:1;height:72rpx;font-size:27rpx;color:#16181c}
.late-custom-confirm{width:150rpx;height:76rpx;margin:0;border-radius:18rpx;background:#16815e;color:#fff;font-size:24rpx;font-weight:750}
.late-custom-confirm[disabled]{background:#dce8e2;color:#8a9c95}
.late-options-hint{margin:14rpx 2rpx 0}
.page-dark .btn.outline.customer-status-button{background:#173c31;color:#76d7b3;border-color:#285b49}
.page-dark .late-options-panel{background:#202723;border-color:#33463e}
.page-dark .late-options-title{color:#edebe4}
.page-dark .late-option,.page-dark .late-custom-field{background:#242522;border-color:#3f6655;color:#76d7b3}
.page-dark .late-custom-field input{color:#edebe4}

/* Horizontal order tracker, replaces the vertical timeline card. */
.order-steps{display:flex;background:#fff;border:1rpx solid #ece9e2;border-radius:24rpx;padding:24rpx 16rpx 22rpx;margin:16rpx 0 20rpx;box-shadow:0 2rpx 12rpx rgba(22,24,28,.04)}
.order-step{flex:1;display:flex;flex-direction:column;align-items:center;min-width:0}
.step-rail{position:relative;display:flex;align-items:center;justify-content:center;width:100%;height:22rpx}
.step-rail::before,.step-rail::after{content:'';position:absolute;top:50%;height:2rpx;background:#e5e3dc;transform:translateY(-50%)}
.step-rail::before{left:0;right:50%}
.step-rail::after{left:50%;right:0}
.order-step:first-child .step-rail::before{display:none}
.order-step:last-child .step-rail::after{display:none}
.step-dot{position:relative;z-index:1;width:18rpx;height:18rpx;border-radius:50%;background:#fff;border:3rpx solid #d8d4c9;box-sizing:border-box}
.order-step.done .step-dot{border-color:#c2410c;background:#c2410c}
.order-step.current .step-dot{border-color:#c2410c;background:#fff;box-shadow:0 0 0 6rpx rgba(194,65,12,.14)}
.step-label{margin-top:12rpx;font-size:22rpx;line-height:1.3;color:#8a877e;text-align:center;white-space:nowrap}
.order-step.current .step-label{color:#16181c;font-weight:700}
.step-time{margin-top:5rpx;font-size:20rpx;line-height:1.3;color:#8a877e}

/* Raise module: header with the current offer, four presets, refund line and a pill cancel. */
.offer-card{padding:26rpx 26rpx 20rpx}
.offer-head{display:flex;align-items:baseline;justify-content:space-between;gap:16rpx}
.offer-title{font-size:29rpx;font-weight:800}
.offer-current{font-size:23rpx;color:#6b6860;white-space:nowrap}
.offer-amount{font-size:27rpx;font-weight:800;color:#16181c}
.offer-hint{margin-top:8rpx;font-size:23rpx;line-height:1.5;color:#6b6860}
.offer-pills{display:flex;flex-wrap:wrap;gap:14rpx;margin-top:18rpx}
.offer-pill{display:flex;align-items:center;justify-content:center;min-width:132rpx;padding:14rpx 22rpx;border-radius:18rpx;border:2rpx solid #f5c9a8;background:#fdf1e8;color:#c2410c;font-size:26rpx;font-weight:700;line-height:1.4}
.offer-pill-press{background:#fbe3d3}
.offer-foot{display:flex;align-items:center;justify-content:space-between;gap:16rpx;margin-top:22rpx;padding-top:20rpx;border-top:1rpx solid #f0efea}
.offer-refund{flex:1;min-width:0;font-size:22rpx;line-height:1.5;color:#6b6860}
.offer-cancel{flex:none;display:flex;align-items:center;justify-content:center;padding:10rpx 24rpx;border-radius:999rpx;border:2rpx solid #f2b48a;background:#fdf6f2;color:#c2410c;font-size:23rpx;font-weight:700;line-height:1.4;min-height:56rpx}
.offer-cancel-press{background:#fbe3d3;color:#a5360a}
.page-dark .order-steps{background:#242522;border-color:#3a3b37}
.page-dark .step-rail::before,.page-dark .step-rail::after{background:#3a3b37}
.page-dark .step-dot{border-color:#4a4b45;background:#242522}
.page-dark .order-step.done .step-dot{background:#f4a06e;border-color:#f4a06e}
.page-dark .order-step.current .step-dot{border-color:#f4a06e;background:#242522}
.page-dark .order-step.current .step-label{color:#edebe4}
.page-dark .offer-title,.page-dark .offer-amount{color:#edebe4}
.page-dark .offer-pill{background:#3a2416;border-color:#5a3a24;color:#f4a06e}
.page-dark .offer-cancel{background:#3a2416;border-color:#5a3a24;color:#f4a06e}
.page-dark .offer-foot{border-color:#3a3b37}

.request-cancel-card .offer-footer{display:flex;flex-direction:column;align-items:stretch;justify-content:flex-start;gap:0;border-top:0;margin-top:0;padding-top:0}
.request-cancel-card .offer-footer-copy{flex:none;width:100%;box-sizing:border-box}
.request-cancel-card .offer-footer-copy>.hint,.request-cancel-card .cancel-tip{font-size:22rpx;line-height:1.65;word-break:normal;overflow-wrap:break-word}
.request-cancel-card .cancel-tip{margin-top:10rpx}
.request-cancel-card button.offer-cancel{display:flex;align-items:center;justify-content:center;box-sizing:border-box;width:100%;min-height:78rpx;margin:22rpx 0 0;padding:16rpx 24rpx;border:1rpx solid #ead8ca;border-radius:16rpx;background:#fff9f4;color:#a84b24;font-size:25rpx;font-weight:650;line-height:1.4}
.request-cancel-card button.offer-cancel::after{border:0}
.request-cancel-card button.offer-cancel-press{background:#fbeee3}
.page-dark .request-cancel-card button.offer-cancel{background:#30271f;border-color:#654a37;color:#efb38d}

page{background:#f2f1ec}.journey-page{background:#f2f1ec;padding:30rpx 28rpx 75rpx}.journey-page>.flow-title{font-size:39rpx;line-height:1.25;font-weight:800;letter-spacing:-.8rpx;margin-bottom:12rpx}.journey-page>.flow-sub{font-size:24rpx;line-height:1.55;color:#74766e;margin-bottom:27rpx}
.journey-ticket{margin:0 0 24rpx;border-radius:32rpx;box-shadow:0 7rpx 18rpx #29322410;background:#3e6b51;overflow:hidden}.journey-ticket-band{display:flex;align-items:center;gap:17rpx;min-height:84rpx;padding:17rpx 28rpx 21rpx;box-sizing:border-box;color:#fff}.journey-brand{font-size:31rpx;font-weight:800;letter-spacing:-.4rpx}.journey-band-divider{font-size:26rpx;opacity:.55;font-weight:300}.journey-band-title{font-size:25rpx;font-weight:400;flex:1}.journey-anchor{flex:none;width:35rpx;height:40rpx}.journey-ticket-body{background:#fffbf3;border-radius:30rpx 30rpx 0 0;padding:0 25rpx 24rpx;margin-top:-5rpx}.journey-hero{display:flex;align-items:center;gap:22rpx;padding:19rpx 0 13rpx}.journey-mascot{width:153rpx;height:174rpx;flex:none}.journey-status{flex:1;min-width:0;border-left:1rpx solid #d8cbb6;padding:9rpx 0 9rpx 21rpx}.journey-status-title{font-size:36rpx;line-height:1.22;font-weight:800;letter-spacing:-.7rpx;color:#192949;overflow-wrap:break-word}.journey-status-note{font-size:23rpx;line-height:1.55;color:#74736b;margin-top:12rpx;overflow-wrap:break-word}
.journey-progress{display:flex;padding:7rpx 0 22rpx}.journey-step{position:relative;flex:1;min-width:0;text-align:center;padding:0 1rpx}.journey-step:before{content:'';position:absolute;top:13rpx;height:3rpx;background:#c8c7bf;width:100%;left:-50%}.journey-step:first-child:before{display:none}.journey-step.done:before,.journey-step.current:before{background:#41775b}.journey-step-dot{position:relative;z-index:1;box-sizing:border-box;margin:0 auto 11rpx;width:28rpx;height:28rpx;border:3rpx solid #bdbcb5;border-radius:50%;background:#fffbf3;color:transparent;display:flex;align-items:center;justify-content:center;font-size:20rpx;font-weight:800;line-height:1}.journey-step.done .journey-step-dot,.journey-step.current .journey-step-dot{background:#41775b;border-color:#41775b;color:#fff}.journey-step-name{font-size:18rpx;line-height:1.35;color:#74736d;white-space:nowrap;letter-spacing:-.3rpx}.journey-step.current .journey-step-name{color:#37664c;font-weight:750}.journey-step-time{font-size:19rpx;color:#41775b;line-height:1.4;min-height:27rpx;margin-top:4rpx}
.journey-route-section{display:flex;flex-direction:row;gap:16rpx;align-items:center;position:relative;border-top:2rpx dashed #cbbfa8;border-bottom:1rpx dashed #d8cfbd;padding:24rpx 0;margin:0 -25rpx}.journey-route-section:before,.journey-route-section:after{content:'';position:absolute;top:-17rpx;width:32rpx;height:32rpx;border-radius:50%;background:#f2f1ec}.journey-route-section:before{left:-16rpx}.journey-route-section:after{right:-16rpx}.journey-route{flex:1;min-width:0;display:flex;align-items:center;gap:14rpx;padding:4rpx 0 4rpx 25rpx;box-sizing:border-box;min-height:68rpx}.journey-route-point{display:flex;align-items:center;gap:9rpx;min-width:0;flex:1;font-size:31rpx;font-weight:750;line-height:1.4;overflow-wrap:anywhere;color:#28382f}.journey-route-point text:last-child{min-width:0}.journey-destination{flex:.68}.journey-pin{display:block;width:30rpx;height:36rpx;flex:none}.journey-route-arrow{font-size:36rpx;color:#aaa08c;flex:none}.journey-times{display:flex;flex-direction:column;align-items:stretch;justify-content:center;gap:1rpx;flex:none;box-sizing:border-box;width:190rpx;min-height:66rpx;padding:0 20rpx 0 17rpx;border-left:1rpx solid #beb7a7;font-size:22rpx;line-height:1.55;color:#75746c}.journey-times>view{display:flex;justify-content:space-between;gap:6rpx}.journey-times text:last-child{font-weight:750;color:#26332c}
.journey-ticket-footer{padding-top:20rpx}.journey-cancel-copy{width:100%}.journey-refund-note,.journey-ticket-footer .cancel-tip{display:flex;align-items:flex-start;gap:9rpx;font-size:21rpx;line-height:1.6;color:#686d62;margin:0 0 6rpx}.journey-bullet{color:#41775b;flex:none}.journey-ticket-footer button.journey-cancel{display:block;width:auto;min-width:206rpx;min-height:65rpx;margin:16rpx 0 0 auto;padding:12rpx 24rpx;border:2rpx solid #41775b;border-radius:17rpx;background:transparent;color:#37664c;font-size:24rpx;font-weight:700;line-height:1.45}.journey-cancel::after{border:0}.journey-ticket-footer button.journey-cancel-press{background:#eaf0e5}
.journey-page .flow-card{border:0;border-radius:26rpx;box-shadow:0 4rpx 14rpx #29322409;margin:22rpx 0}.journey-page .rider-photo-card{padding:24rpx;background:#fff}.journey-page .rider-photo-action{display:flex;align-items:center;gap:18rpx;padding:0;border:0;background:transparent;position:relative;min-height:120rpx}.journey-page .rider-photo-media{width:79rpx;height:79rpx;flex:none;border:0;border-radius:20rpx;background:#edf3e9;display:flex;align-items:center;justify-content:center}.journey-page .rider-photo-placeholder{width:43rpx;height:43rpx}.journey-page .rider-photo-copy{flex:1;min-width:0;padding-right:6rpx}.journey-page .rider-photo-title{font-size:27rpx;line-height:1.3;color:#24352a}.journey-page .rider-photo-title-line:first-child{font-size:29rpx;font-weight:750;margin-bottom:6rpx}.journey-page .rider-photo-title-line:last-child{font-size:24rpx;font-weight:450}.journey-page .rider-photo-help{font-size:20rpx;color:#898d80;line-height:1.45;margin-top:7rpx}.journey-page .rider-photo-count{position:static;flex:none;font-size:18rpx;align-self:flex-start;color:#7d8c76;background:#f0f5eb;border-radius:8rpx;padding:3rpx 6rpx}.journey-page .journey-upload{flex:none;width:102rpx;min-height:104rpx;padding:9rpx 3rpx;margin:0;border:1rpx dashed #7e9d78;background:transparent;border-radius:19rpx;color:#41775b;font-size:20rpx;line-height:1.6;display:flex;flex-direction:column;align-items:center;justify-content:center}.journey-upload::after{border:0}.journey-upload>text:first-child{font-size:38rpx;line-height:1.05}.journey-page .rider-photo-foot{font-size:19rpx;color:#919889;padding:0;margin-top:12rpx}.journey-page .rider-photo-gallery{margin-top:20rpx}.journey-page .rider-photo-action.rider-photo-filled{display:block}.journey-page .rider-photo-filled .upload-head{padding:0;display:flex;align-items:center;gap:18rpx}.journey-page .rider-photo-filled>.rider-photo-count{position:absolute;top:0;right:0}
.journey-details{padding:25rpx 26rpx!important}.journey-details-title{font-size:32rpx;font-weight:800;line-height:1.3;color:#202b25;margin-bottom:13rpx}.journey-detail-row{display:flex;justify-content:space-between;align-items:baseline;gap:18rpx;padding:20rpx 0;border-bottom:1rpx solid #eeeee7;font-size:23rpx;line-height:1.5;color:#676f61}.journey-detail-label{display:flex;align-items:baseline;gap:10rpx;flex:none;max-width:43%}.journey-detail-icon{color:#41775b;width:25rpx;font-size:25rpx;flex:none}.journey-detail-value{flex:1;min-width:0;text-align:right;overflow-wrap:anywhere;color:#30392e}.journey-price-row{border-bottom:0;padding-bottom:1rpx}.journey-price{font-size:30rpx;font-weight:750;color:#273b2b;flex:none}.journey-net-total{font-weight:700}.journey-parcel-detail,.journey-order-note{font-size:22rpx;line-height:1.6;color:#79816f;padding-top:12rpx;overflow-wrap:anywhere}

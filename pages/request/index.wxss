@import "../../utils/order-pictures.wxss";
@import "../../utils/flow.wxss";

.status-card{background:#fff1e6;border:1rpx solid #f2b48a;border-left:1rpx solid #f2b48a;min-height:130rpx;padding-right:110rpx;position:relative}.status-card .flow-title{font-size:30rpx;color:#c2410c}.status-yuni{position:absolute;right:18rpx;top:20rpx;width:78rpx;height:90rpx}.timeline{padding:20rpx 0}.timeline text{font-size:24rpx}.cancel-order-button{display:flex;align-items:center;justify-content:center;width:100%;min-height:88rpx;padding:20rpx 24rpx;margin:24rpx 0 0;border:2rpx solid #f2b48a;border-radius:20rpx;background:#fdf6f2;color:#c2410c;font-size:28rpx;font-weight:700;line-height:1.5;transition:transform .16s ease,background .16s ease}.cancel-order-press{transform:scale(.98);background:#fff1e6}.page-dark .cancel-order-button{background:#3a2416;border-color:#3a3b37;color:#f4a06e}.contact-actions{display:flex;gap:16rpx}.contact-button{position:relative;width:66rpx;height:66rpx;border:1rpx solid #e2e0d9;border-radius:50%;display:flex;align-items:center;justify-content:center}.contact-button image{width:30rpx;height:30rpx}

.flow-page .btn.orange{background:#c2410c}
.page-dark.flow-page .btn.orange{background:#f4a06e;color:#16181c}

.rules-page{min-height:100vh;background:#eeede8;padding-bottom:env(safe-area-inset-bottom)}.rules-header{position:sticky;top:0;z-index:5;background:#fff;padding:20rpx 38rpx 24rpx}.rules-header .flow-title{font-size:35rpx}.rules-header .hint{font-size:23rpx}.final-tabs{margin-top:26rpx}.rules-body{padding:26rpx 38rpx}.rules-intro{font-size:25rpx;color:#606259;line-height:1.7;margin:0 3rpx 25rpx}.numbered-card{background:white;border:1rpx solid #deded7;border-radius:27rpx;overflow:hidden}.rule-row{display:flex;gap:23rpx;align-items:flex-start;padding:25rpx 26rpx;border-bottom:1rpx solid #eeeee8}.rule-row:last-child{border-bottom:0}.number{background:#fcf1e6;color:#a53e21;width:43rpx;height:43rpx;border-radius:50%;text-align:center;line-height:43rpx;font-size:23rpx;font-weight:750;flex:none}.runners .number{background:#e8f3ed;color:#41775b}.privacy .number{background:#eceef6;color:#434b75}.rule-copy{flex:1;min-width:0}.rule-title{font-size:27rpx;font-weight:750;line-height:1.45}.rule-text{font-size:25rpx;color:#606259;line-height:1.6;margin-top:12rpx}.delete-button{margin:22rpx 0 0;padding:26rpx;background:white;border:1rpx solid #ecc9c0;color:#a53e21;font-size:25rpx;font-weight:750;border-radius:25rpx}
.terms-link{display:inline-block;margin:6rpx 3rpx 20rpx;color:#41775b;font-weight:700}

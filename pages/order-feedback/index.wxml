<view style="{{motionStyle}}"><lang-switch/><view class="feedback-page {{darkClass}}"><block wx:if="{{request}}">
 <view class="feedback-title">{{zh?'订单反馈':'Order feedback'}}</view><view class="feedback-sub">{{zh?'反馈会自动关联本单，由 Uniearn 团队跟进。':'Your feedback is linked to this order for the Uniearn team.'}}</view>
 <view class="feedback-card order-summary"><view class="summary-top"><text>{{request.sizeLabel}}</text><text>#{{request.id}}</text></view><view class="summary-route">{{request.category==='task'?request.title:request.pickupDisplay+' → '+request.destinationDisplay}}</view><view class="summary-state">{{request.statusLabel}}</view></view>
 <view wx:if="{{paused}}" class="feedback-notice"><view class="notice-title">{{zh?'自动结单与结算已暂停':'Auto-confirmation and settlement paused'}}</view><view>{{zh?'可以先与对方沟通，或提交情况让团队介入。问题解决后，由顾客确认完成。团队会在 24 小时内处理':'Contact the other person or ask the team to help. The customer can confirm completion once resolved. The team will resolve it within 24 hours'}}{{request.holdTime?(zh?'（冻结至 '+request.holdTime+'）':' (held until '+request.holdTime+')'):''}}{{zh?'。':'.'}}</view></view>
 <view wx:elif="{{request.feedbackOpen}}" class="feedback-notice"><view class="notice-title">{{zh?'问题反馈处理中':'Feedback in progress'}}</view><view>{{zh?'本单有待处理反馈。解决反馈后，订单会继续原来的流程。':'This order has unresolved feedback. Resolving it keeps the order at its current stage.'}}</view></view>
 <view wx:elif="{{resolved}}" class="feedback-notice"><view class="notice-title">{{zh?'该订单的问题已处理':'This order issue has been resolved'}}</view><view>{{zh?'处理记录与团队回复会保留在下方。':'The conversation and handling record remain below.'}}</view></view>
 <view class="feedback-card"><view class="card-title">{{zh?'你需要哪种帮助？':'How can we help?'}}</view><view wx:if="{{request.isMine && request.status==='delivered'}}" class="feedback-help">{{zh?'点击下方任一求助方式，将暂停本单自动结单和结算。日常订单里的聊天、电话不受影响。':'Choosing a help option below pauses auto-confirmation and settlement. Ordinary calls and messages elsewhere do not pause them.'}}</view>
  <view class="contact-grid"><button wx:if="{{canMessage}}" data-channel="message" bindtap="contact" disabled="{{busy}}"><image src="/assets/message.svg"/><text>{{zh?(request.isMine?'联系跑手':'联系顾客'):(request.isMine?'Message runner':'Message customer')}}</text></button><button wx:if="{{hasContact}}" data-channel="phone" bindtap="contact" disabled="{{busy||!otherPhone}}"><image src="/assets/phone.svg"/><text>{{zh?'拨打电话':'Call'}}</text></button></view>
  <button class="team-button" data-channel="team" bindtap="contact" disabled="{{busy}}">{{zh?'请 Uniearn 团队协助':'Ask the Uniearn team'}}<text>›</text></button>
 </view>
 <view wx:if="{{formOpen}}" class="feedback-card feedback-form">
  <view class="form-heading"><view class="card-title">{{zh?'描述你的问题':'Tell us what happened'}}</view><text class="form-private">{{zh?'仅用于处理本单':'For this order'}}</text></view>
  <view class="form-section-label"><text class="section-number">1</text><text>{{zh?'问题类型':'Issue type'}}</text><text class="section-caption">{{zh?'选择最符合的一项':'Choose one'}}</text></view>
  <view class="reason-list" role="radiogroup" aria-label="{{zh?'问题类型':'Issue type'}}"><view wx:for="{{reasons}}" wx:key="id" class="reason-option {{reason===item.id?'selected':''}} {{busy?'locked':''}}" data-reason="{{item.id}}" bindtap="choose" hover-class="reason-option-press" role="radio" aria-checked="{{reason===item.id}}" aria-disabled="{{busy}}"><view class="reason-radio"><text wx:if="{{reason===item.id}}">✓</text></view><view class="reason-copy"><view class="reason-label">{{item.label}}</view><view class="reason-description">{{item.hint}}</view></view></view></view>
  <view class="form-section-label"><text class="section-number">2</text><text>{{zh?'详细说明':'Details'}}</text><text class="section-caption">{{zh?'至少 3 个字':'At least 3 characters'}}</text></view>
  <view class="feedback-note-box"><textarea class="feedback-note" value="{{note}}" bindinput="input" maxlength="500" disabled="{{busy}}" placeholder="{{zh?'发生了什么？可以补充时间、地点和需要我们协助的内容。':'What happened? Include when, where and how we can help.'}}" placeholder-class="feedback-placeholder"/><view class="note-limit">{{note.length}} / 500</view></view>
  <view class="form-section-label"><text class="section-number">3</text><text>{{zh?'凭证照片':'Evidence photo'}}</text><text class="evidence-tag {{reason==='Spilled or damaged'?'required':''}}">{{reason==='Spilled or damaged'?(zh?'必填':'Required'):(zh?'选填':'Optional')}}</text></view>
  <view class="feedback-evidence {{photo?'has-photo':''}}"><view class="evidence-head"><view class="evidence-icon"><image src="/assets/photo-green.svg" mode="aspectFit"/></view><view class="evidence-copy"><view class="evidence-title">{{photo?(zh?'照片已添加':'Photo attached'):(zh?'添加凭证照片':'Add a photo')}}</view><view class="evidence-description">{{zh?'拍照或从相册选择，最多 1 张':'Camera or album · 1 photo maximum'}}</view></view><button class="evidence-upload" bindtap="choosePhoto" loading="{{uploading}}" disabled="{{busy||uploading}}" aria-label="{{photo?(zh?'更换凭证照片':'Replace evidence photo'):(zh?'上传凭证照片':'Upload evidence photo')}}"><text class="evidence-upload-symbol">{{photo?'↻':'＋'}}</text><text>{{photo?(zh?'更换':'Replace'):(zh?'上传':'Upload')}}</text></button></view><view wx:if="{{photo}}" class="evidence-gallery"><view class="photo-preview"><image src="{{photo}}" mode="aspectFill" data-photo="{{photo}}" bindtap="preview"/><button class="evidence-remove" bindtap="removePhoto" disabled="{{busy}}" aria-label="{{zh?'删除凭证照片':'Remove evidence photo'}}">×</button></view><view class="evidence-preview-help">{{zh?'点击照片查看大图':'Tap the photo to preview'}}</view></view></view>
  <view class="evidence-footnote">{{reason==='Spilled or damaged'?(zh?'物品损坏或洒漏，请上传能看清问题的照片。':'For damage or spills, add a clear photo of the issue.'):(zh?'清晰的照片能帮助团队更快了解情况。':'A clear photo helps the team understand the issue.')}}</view>
  <button class="submit-button" bindtap="submit" loading="{{busy}}" disabled="{{!canSubmit||busy||uploading}}">{{zh?'提交反馈':'Submit feedback'}}</button>
 </view>
 <view wx:if="{{ticket}}" class="feedback-card"><view class="conversation-head"><view class="card-title">{{zh?'处理记录与团队回复':'Updates from the team'}}</view><text class="ticket-state">{{ticket.status==='resolved'?(zh?'已处理':'Resolved'):(zh?'待跟进':'Open')}}</text></view><view class="feedback-help">{{zh?'返回本页可查看新回复。':'Return here to check for replies.'}}</view><view wx:for="{{messages}}" wx:key="key" class="feedback-message {{item.mine?'mine':'team'}}"><view class="message-author">{{item.mine?(zh?'你':'You'):'Uniearn'}} · {{item.time}}</view><text class="message-text">{{item.text}}</text><image wx:if="{{item.photo}}" src="{{item.photo}}" mode="aspectFill" data-photo="{{item.photo}}" bindtap="preview"/></view></view>
 <button wx:if="{{canResolve}}" class="resolve-button" bindtap="resolve" disabled="{{busy}}" loading="{{busy}}">{{zh?'问题已解决':'Issue resolved'}}</button>
 <view wx:if="{{error}}" class="feedback-error">{{error}}</view>
 </block><view wx:else class="feedback-unavailable">{{zh?'订单暂不可用，请返回重试。':'Order unavailable. Go back and try again.'}}</view></view></view>

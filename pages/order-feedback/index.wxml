<view style="{{motionStyle}}"><lang-switch/><view class="feedback-page sc-page {{darkClass}}"><block wx:if="{{request}}">
 <view class="sc-order"><view class="sc-order-top"><text>{{request.sizeLabel}}</text><text class="order-no">#{{request.id}}</text></view><view class="sc-order-route">{{request.category==='task'?request.title:request.pickupDisplay+' → '+request.destinationDisplay}}</view><view class="sc-order-state">{{request.statusLabel}}</view></view>
 <view wx:if="{{paused}}" class="sc-note">{{zh?'本单结算已暂停，直到顾客确认或团队处理完成。':'Payout is paused until the customer confirms or the team decides.'}}</view>
 <view wx:if="{{canResolve}}" class="sc-resolve"><text>{{zh?'问题解决了吗？':'Is it sorted?'}}</text><button class="sc-resolve-button" bindtap="resolve" disabled="{{busy}}">{{zh?'问题已解决':'Issue resolved'}}</button></view>

 <block wx:if="{{!sentAny}}">
  <view class="sc-step">
   <view class="sc-step-head"><text class="sc-step-number">1</text><text>{{zh?'遇到了什么问题？':'What’s the problem?'}}</text></view>
   <view class="sc-options" role="radiogroup"><view wx:for="{{reasons}}" wx:key="id" class="sc-option {{reason===item.id?'on':''}}" data-reason="{{item.id}}" bindtap="choose" hover-class="sc-chip-press" role="radio" aria-checked="{{reason===item.id}}"><view class="sc-radio"><text wx:if="{{reason===item.id}}">✓</text></view><view class="sc-option-copy"><view class="sc-option-label">{{item.label}}</view><view class="sc-option-hint">{{item.hint}}</view></view></view></view>
  </view>
  <view class="sc-step {{reason?'':'locked'}}">
   <view class="sc-step-head"><text class="sc-step-number">2</text><text>{{zh?'告诉团队更多情况':'Tell the team a bit more'}}</text></view>
   <view class="sc-step-help">{{reason?(photoRequired?(zh?'请写下发生了什么，并用左下角相机附一张照片。':'Write what happened and add a photo with the camera button below.'):(zh?'在下方写下发生了什么，然后点「发送」。':'Write what happened below, then tap Send.')):(zh?'请先在上面选择一个问题。':'Pick a problem above first.')}}</view>
   <view wx:if="{{willPause && reason!=='Report response'}}" class="sc-step-warn">{{zh?'发送后，跑手的赏金会暂停结算，直到问题解决。':'Sending this pauses the runner’s payout until it’s sorted.'}}</view>
  </view>
  <view class="sc-howto">{{zh?'UniEarn 团队会在这里回复，一般在 24 小时内。有新回复时，「我的订单」会出现红点。':'The UniEarn team replies here, usually within 24 hours. You’ll see a red dot on My orders when they reply.'}}</view>
 </block>

 <view wx:else class="sc-thread">
  <view class="sc-row team"><image class="sc-avatar" src="/assets/yuni-work.png" mode="aspectFit"/><view class="sc-bubble"><view class="sc-author">UniEarn</view><text class="sc-text">{{zh?'收到！我们会在这里回复你，一般在 24 小时内。':'Got it! We’ll reply right here, usually within 24 hours.'}}</text></view></view>
  <view wx:for="{{messages}}" wx:key="key" class="sc-row {{item.mine?'mine':'team'}}"><image wx:if="{{!item.mine}}" class="sc-avatar" src="/assets/yuni-work.png" mode="aspectFit"/><view class="sc-bubble"><view wx:if="{{!item.mine}}" class="sc-author">UniEarn</view><view wx:if="{{item.reasonLabel}}" class="sc-tag">{{item.reasonLabel}}</view><text class="sc-text">{{item.text}}</text><image wx:if="{{item.photo}}" class="sc-photo" src="{{item.photo}}" mode="aspectFill" data-photo="{{item.photo}}" bindtap="preview"/><view class="sc-time">{{item.time}}</view></view></view>
  <view wx:if="{{waitingReply}}" class="sc-waiting">{{zh?'已发送，等待团队回复…':'Sent. Waiting for the team to reply…'}}</view>
 </view>

 <view wx:if="{{error}}" class="feedback-error">{{error}}</view>
 <view class="sc-compose-space"/>
 <view class="sc-compose {{!sentAny&&!reason?'locked':''}}"><view wx:if="{{photo}}" class="sc-attach"><image src="{{photo}}" mode="aspectFill" data-photo="{{photo}}" bindtap="preview"/><text class="sc-attach-remove" bindtap="removePhoto">×</text></view><view class="sc-compose-row"><view class="sc-photo-button {{photoRequired&&!photo?'need':''}}" hover-class="sc-chip-press" role="button" aria-label="{{zh?'添加照片':'Add a photo'}}" bindtap="choosePhoto"><image src="/assets/camera.svg" mode="aspectFit"/></view><textarea class="sc-input" value="{{note}}" bindinput="input" maxlength="500" auto-height disabled="{{busy||(!sentAny&&!reason)}}" placeholder="{{!sentAny&&!reason?(zh?'请先选择问题':'Pick a problem first'):(zh?'写给 UniEarn 团队…':'Message the UniEarn team…')}}" placeholder-class="sc-placeholder"/><button class="sc-send" bindtap="submit" disabled="{{!canSubmit||busy||uploading}}" loading="{{busy}}">{{zh?'发送':'Send'}}</button></view></view>
</block><view wx:else class="feedback-unavailable">{{zh?'订单暂不可用，请返回重试。':'Order unavailable. Go back and try again.'}}</view></view></view>

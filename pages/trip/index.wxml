<lang-switch/>
<view class="flow-page" wx:if="{{trip}}"><view class="flow-title">{{names[trip.station]||trip.station}} → {{trip.dorm}}</view><view class="flow-sub">{{trip.category==='takeout'?(zh?'外卖代取':'Takeaway'):(zh?'快递代取':'Parcels')}} · {{requests.length}} {{zh?'个订单，':'orders,'}} {{boxes}} {{trip.category==='takeout'?(zh?'袋':'bags'):(zh?'件':'boxes')}}</view><view class="progress-row"><view class="progress-step active">{{zh?'1 · 取件':'1 · Pick up'}}</view><view class="progress-step {{trip.phase==='deliver'||trip.phase==='done'?'active':''}}">{{zh?'2 · 送达':'2 · Deliver'}}</view><view class="progress-step {{trip.phase==='done'?'active':''}}">{{zh?'3 · 完成':'3 · Done'}}</view></view><yuni-assistant topic="trip" stage="{{trip.phase}}" floating="{{true}}"/><view class="preview-label">{{zh?'团队测试 · 云端同步 · 不产生真实付款':'Team test · cloud sync · no real payment'}}</view>
<view wx:if="{{trip.cancelled}}" class="flow-card"><view class="strong">{{zh?'行程已结束':'Trip ended'}}</view><button class="btn" bindtap="reset">{{zh?'再找一单':'Find another job'}}</button></view>
<block wx:else>
<view wx:if="{{joinOpen}}" class="flow-card"><view class="row"><view><view class="strong">{{zh?'还可加入 '+minutes+' 分钟':'Open for '+minutes+' more min'}}</view><view class="hint">{{zh?'还能装 '+remaining+(trip.category==='takeout'?' 袋':' 件'):'Room for '+remaining+' more '+(trip.category==='takeout'?'bags':'boxes')}}</view></view><text class="amount">{{remaining}}</text></view><button class="btn" open-type="share">{{zh?'分享行程到宿舍群':'Share trip to your dorm group'}}</button><text class="link hint" bindtap="joinPreview">{{zh?'预览同学如何加入 →':'Preview how a friend joins →'}}</text><view class="hint">{{zh?'开放期间，其他同学可以加入这条顺路行程。':'Other students can join this shared route while it is open.'}}</view></view>
<view wx:if="{{trip.phase==='done'}}" class="flow-card center"><view class="big-check">✓</view><view class="flow-title">{{zh?'行程已完成':'Trip complete'}}</view><view class="amount money">¥{{reward}}</view><view class="hint">{{zh?'共 '+boxes+' 件，送给 '+requests.length+' 位同学':boxes+' items to '+requests.length+' people'}}</view></view>
<view wx:if="{{trip.phase==='collect'}}" class="orange-note">{{zh?'现在可以查看姓名、房间号和手机号。取走前请核对每一件上的号码。':'Names, rooms and phone numbers are now visible. Match the number on each bag before taking it.'}}</view>
<block wx:if="{{trip.category==='parcel' && trip.phase==='collect'}}"><view wx:for="{{parcels}}" wx:key="key" class="flow-card"><view class="row"><text class="amount">{{item.code}}</text><text class="badge">{{zh?'第 '+(item.index+1)+' 件':'Box '+(item.index+1)}}</text></view><view class="hint">{{item.owner}} · {{zh?'房间号':'Room'}} {{item.room}}</view><button class="btn" disabled="{{item.done}}" data-id="{{item.id}}" data-index="{{item.index}}" bindtap="collect">{{item.done?(zh?'✓ 已取件':'✓ Collected'):(zh?'已取到':'Got it')}}</button><view wx:if="{{!item.done}}" class="link" data-id="{{item.id}}" bindtap="missingParcel">{{zh?'找不到':'Can’t find it'}}</view><view wx:if="{{cancelling===item.id}}" class="hint">{{zh?'该订单已部分取件，请先联系发布人再继续。':'For a partly collected request, contact the customer before continuing.'}}<view class="contact-actions"><view class="contact-button" data-id="{{item.id}}" bindtap="chat"><image src="/assets/message.svg"/></view><view class="contact-button" data-phone="{{item.phone}}" bindtap="phone"><image src="/assets/phone.svg"/></view></view></view></view><view class="hint">{{zh?'已取 '+collected+' / '+boxes:collected+' of '+boxes+' collected'}}</view></block><view wx:if="{{trip.phase==='deliver'}}" class="green-note">{{zh?'已全部取件 · 已送达 '+done+' / '+requests.length+' · 从低楼层开始':'All collected · '+done+' of '+requests.length+' delivered · lowest floor first'}}</view><view wx:for="{{requests}}" wx:key="id" wx:if="{{trip.category!=='parcel'||trip.phase!=='collect'}}" class="flow-card"><view class="row"><view class="value">{{item.owner}} · {{item.boxes}} {{zh?(item.unit==='bags'?'袋':item.unit==='boxes'?'件':'个任务'):item.unit}}</view><text class="badge {{item.status==='confirmed'?'green':''}}">{{item.status==='confirmed'?(zh?'已结算（演示）':'Paid (demo)'):item.status==='delivered'?(zh?'待确认':'Waiting'):item.status==='disputed'?(zh?'审核中':'Under review'):item.status==='collected'?(zh?'已取件':'Picked up'):item.category==='takeout'?item.arrivalLabel:(zh?'待取件':'To collect')}}</text></view><view class="row"><view class="hint">{{item.destinationDisplay}}</view><view class="contact-actions"><view class="contact-button" data-id="{{item.id}}" bindtap="chat"><image src="/assets/message.svg"/><text wx:if="{{item.unread}}" class="unread">{{item.unread}}</text></view><view class="contact-button" data-phone="{{item.phone}}" bindtap="phone"><image src="/assets/phone.svg"/></view></view></view><view wx:if="{{item.soup}}" class="orange-note">{{zh?'↑ 内有汤或饮品 · 请保持直立':'↑ Soup or drinks inside · keep it upright'}}</view>
<block wx:if="{{item.status==='taken'||item.status==='collected'}}"><view class="soft"><view class="label">{{item.category==='takeout'?(zh?'外卖袋上的手机号':'Phone number on the bag'):(zh?'联系电话':'Contact phone')}}</view><view class="row"><text class="value">{{fullNumbers[item.id]?item.phone:'••• '+item.phoneLast4}}</text><text class="link" data-id="{{item.id}}" bindtap="full">{{fullNumbers[item.id]?(zh?'隐藏':'Hide'):(zh?'完整号码':'Full number')}}</text></view><view wx:if="{{fullNumbers[item.id]}}" class="link hint" data-phone="{{item.phone}}" bindtap="phone">{{zh?'拨打':'Call'}}</view></view><view wx:if="{{item.category==='parcel'}}" class="soft"><view class="label">{{zh?'取件码 · 剩 '+item.left+' 个':'Pickup codes · '+item.left+' left'}}</view><view wx:for="{{item.codes}}" wx:for-item="code" wx:key="index" class="value">{{code}}</view></view><image wx:if="{{item.riderPhoto}}" class="thumb" src="{{item.riderPhoto}}" mode="aspectFill" data-photo="{{item.riderPhoto}}" bindtap="previewOrderPhoto"/><view wx:elif="{{item.category==='takeout'}}" class="hint">{{zh?'骑手还没上传照片，请核对外卖袋上的号码。':'No rider’s photo yet. Check the number on the bag.'}}</view><view class="hint">{{names[item.dropNote]||item.dropNote}} {{item.note}}</view></block>
<block wx:if="{{item.status==='taken'}}"><block wx:if="{{cancelling!==item.id}}"><button class="btn" data-id="{{item.id}}" bindtap="collect">✓ {{item.category==='takeout'?(zh?'已取餐':'Picked up'):(zh?'取下一件':'Collect next parcel')}}</button><view wx:if="{{item.category==='takeout'}}" class="link hint" data-id="{{item.id}}" bindtap="broken">{{item.sealReportedAt?(zh?'已记录封签问题':'Seal issue recorded'):(zh?'封签已破损？取餐前请先报告':'Seal already broken? Report before pickup')}}</view><view class="row hint"><text>{{zh?(item.etaChanged?'同学修改了送达时间 · 个人取消不记录':item.freeCancel?item.freeCancelTime+' 前可免费取消':'临时个人取消会被记录。'):(item.etaChanged?'Student moved the ETA · no personal cancellation mark':item.freeCancel?'Free until '+item.freeCancelTime:'Late personal cancellation adds a mark.')}}</text><text class="link" data-id="{{item.id}}" bindtap="cancel">{{zh?'取消订单':'Cancel order'}}</text></view></block><block wx:else><view class="strong">{{zh?'为什么取消？':'Why are you cancelling?'}}</view><view class="soft {{!item.missingAllowed?'locked':''}}" data-value="missing" bindtap="chooseReason"><view>{{cancelReason==='missing'?'◉':'○'}} {{zh?(item.category==='takeout'?'找不到外卖':'找不到快递'):'Can’t find the '+(item.category==='takeout'?'food':'parcel')}}</view><view class="hint">{{zh?(item.missingAllowed?'不记录。':item.missingTime+' 起可选（送达后 10 分钟）。'):(item.missingAllowed?'No mark.':'Available from '+item.missingTime+' (arrival + 10 min).')}}</view></view><view class="soft" data-value="quantity" bindtap="chooseReason"><view>{{cancelReason==='quantity'?'◉':'○'}} {{zh?'数量不符':'Number of items doesn’t match'}}</view><view class="hint">{{zh?'不记录。发布人可以看到取消原因。':'No mark. The student can see the cancellation reason.'}}</view></view><view class="soft" data-value="personal" bindtap="chooseReason"><view>{{cancelReason==='personal'?'◉':'○'}} {{zh?'我无法继续完成':'I can’t do it anymore'}}</view><view class="hint">{{zh?(item.freeCancel?item.freeCancelTime+' 前取消不记录':'会在你的跑手记录中记一次。'):(item.freeCancel?'No mark before '+item.freeCancelTime:'Adds a mark to your runner record.')}}</view></view><view class="action-row"><button class="btn outline" bindtap="backCancel">{{zh?'返回':'Back'}}</button><button class="btn" disabled="{{!cancelReason||(cancelReason==='missing' && !item.missingAllowed)}}" bindtap="submitCancel">{{zh?'确认原因':'Confirm reason'}}</button></view></block></block>
<view wx:if="{{item.category==='takeout' && item.status==='collected'}}" class="orange-note">{{zh?(item.deliveryMinutes>0?'请在 '+item.deliveryMinutes+' 分钟内送达 · '+item.deliveryBy+' 前':'已超过 15 分钟送达目标 · 请尽快完成'):(item.deliveryMinutes>0?'Deliver within '+item.deliveryMinutes+' min · by '+item.deliveryBy:'15-minute delivery target passed · finish promptly')}}</view><button wx:if="{{item.status==='collected' && trip.phase==='deliver'}}" class="btn" data-id="{{item.id}}" bindtap="photo">{{zh?'拍送达照片':'Take delivery photo'}}</button><image wx:if="{{item.photo}}" class="thumb" src="{{item.photo}}" mode="aspectFill" data-photo="{{item.photo}}" bindtap="previewOrderPhoto"/><view wx:if="{{item.deliveredAt}}" class="hint">{{names[item.deliveryLocation]||item.deliveryLocation}} · {{item.deliveredTime}}<view wx:if="{{item.status==='delivered'}}">{{zh?item.autoHours+' 小时后自动确认。':'Automatically confirms after '+item.autoHours+' '+(item.autoHours===1?'hour':'hours')+'.'}}</view></view><view class="row"><text class="hint">{{zh?'跑手赏金':'Runner reward'}}</text><text class="strong">¥{{item.earnedText}}</text></view><text wx:if="{{item.status==='delivered'}}" class="link hint" data-id="{{item.id}}" bindtap="request">{{zh?'查看订单详情 →':'View order details →'}}</text></view>
<view wx:if="{{!requests.length}}" class="flow-card empty">{{zh?'这个行程还没有订单。':'No orders on this trip.'}}<button class="btn outline" bindtap="endEmpty">{{zh?'结束行程':'End trip'}}</button></view>
<view wx:if="{{trip.phase==='done'}}" class="flow-card"><view class="strong">{{zh?'结算（模拟）':'Payments (simulated)'}}</view><view class="hint">{{zh?'已确认 ¥'+paid+' · 待确认 ¥'+pending:'¥'+paid+' confirmed · ¥'+pending+' waiting'}}</view><view class="hint">{{zh?'每个订单在确认后单独结算，或在 '+(trip.category==='takeout'?1:48)+' 小时后自动结算。有反馈时暂停结算。':'Each order settles separately after confirmation, or after '+(trip.category==='takeout'?1:48)+' hours. Reports pause settlement.'}}</view><view class="strong">{{zh?'你的记录 · 完成 '+jobsDone+' 单 · 准时 '+onTime+' 单':'Your record · '+jobsDone+' done · '+onTime+' on time'}}</view><view class="progress-track"><view class="progress-fill" style="width:{{progress}}%"/></view><view class="row"><text>{{level}} {{zh?'跑手':'runner'}}</text><text>{{zh?'每趟上限 '+limit:limit+' per trip'}}</text></view><view class="hint">{{zh?'再完成 '+next+' 单升级 · '+marks+' 次记录':next+' more jobs to the next level · '+marks+' marks'}}</view><button class="btn" bindtap="reset">{{zh?'再找一单 →':'Find another job →'}}</button></view>
<view wx:if="{{trip.phase==='collect' && requests.length}}" class="flow-bottom row"><view><view class="hint">{{zh?'你将获得':'You’ll earn'}}</view><view class="money">¥{{reward}}</view></view><button class="btn" bindtap="leave">{{zh?'去送达 →':'Go deliver →'}}</button></view>
</block></view><view wx:else class="empty">{{zh?'此设备上无法查看该行程。':'Trip unavailable on this device.'}}</view>
<block wx:if="{{deliveryId}}"><view class="sheet-shade" bindtap="closeDelivery"/><view class="flow-sheet"><view class="flow-title">{{zh?'送达凭证':'Delivery proof'}}</view><view class="dash" bindtap="choosePhoto">{{deliveryPhoto?(zh?'更换照片':'Replace photo'):(zh?'拍摄或选择照片':'Take / choose a photo')}}</view><image wx:if="{{deliveryPhoto}}" class="proof" src="{{deliveryPhoto}}" mode="aspectFill"/><button class="btn" disabled="{{!deliveryPhoto || sendingDelivery}}" bindtap="sendDelivery">{{zh?'提交送达凭证':'Send delivery proof'}}</button><button class="btn outline" bindtap="closeDelivery">{{zh?'返回':'Back'}}</button></view></block>

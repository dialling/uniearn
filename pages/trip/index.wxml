<view style="{{motionStyle}}">
<lang-switch></lang-switch>
<view class="flow-page trip-page {{trip.category==='takeout'?'trip-takeout':''}} {{darkClass}}" wx:if="{{trip}}"><view class="flow-title">{{tripStationLabel||names[trip.station]||trip.station}} → {{trip.destinationType==='place'?(trip.deliveryAddress||trip.dorm):trip.dorm}}</view><view wx:if="{{trip.pickupAddress}}" class="hint">{{trip.pickupAddress}}</view><view wx:if="{{trip.waypoint}}" class="hint">{{zh?'途经：':'Via: '}}{{trip.waypoint}}</view><view class="flow-sub">{{trip.category==='takeout'?(zh?'外卖代取':'Takeaway'):(trip.category==='other'||trip.category==='task')?(zh?'其他':'Other'):(zh?'快递代取':'Parcels')}} · {{requests.length}} {{zh?'个订单，':'orders,'}} {{boxes}} {{trip.category==='takeout'?(zh?'袋':'bags'):(zh?'件':'boxes')}}</view><view class="progress-row"><view class="progress-step active">{{zh?'1 · 取件':'1 · Pick up'}}</view><view class="progress-step {{trip.phase==='deliver'||trip.phase==='done'?'active':''}}">{{zh?'2 · 送达':'2 · Deliver'}}</view><view class="progress-step {{trip.phase==='done'?'active':''}}">{{zh?'3 · 完成':'3 · Done'}}</view></view><yuni-assistant topic="trip" stage="{{trip.phase}}" floating="{{true}}"/><view class="preview-label">{{zh?'团队测试 · 云端同步 · 不产生真实付款':'Team test · cloud sync · no real payment'}}</view>
<view wx:if="{{trip.cancelled}}" class="flow-card"><view class="strong">{{zh?'行程已结束':'Trip ended'}}</view><button class="btn" bindtap="reset">{{zh?'再找一单':'Find another job'}}</button></view>
<block wx:else>
<view wx:if="{{joinOpen}}" class="flow-card"><view class="row"><view><view class="strong">{{zh?'还可加入 '+minutes+' 分钟':'Open for '+minutes+' more min'}}</view><view class="hint">{{zh?'还能装 '+remaining+(trip.category==='takeout'?' 袋':' 件'):'Room for '+remaining+' more '+(trip.category==='takeout'?'bags':'boxes')}}</view></view><text class="amount">{{remaining}}</text></view><button class="btn" open-type="share">{{zh?'分享行程到宿舍群':'Share trip to your dorm group'}}</button><text class="link hint" bindtap="joinPreview">{{zh?'预览同学如何加入 →':'Preview how a friend joins →'}}</text><view class="hint">{{zh?'开放期间，其他同学可以加入这条顺路行程。':'Other students can join this shared route while it is open.'}}</view></view>
<view wx:if="{{trip.phase==='done'}}" class="flow-card center"><view class="big-check">✓</view><view class="flow-title">{{zh?'行程已完成':'Trip complete'}}</view><view class="hint">{{zh?'款项将转入你的钱包。':'Money will be transferred into your wallet.'}}</view><view class="amount money">¥{{reward}}</view><view class="hint">{{zh?'共 '+boxes+' 件，送给 '+requests.length+' 位同学':boxes+' items to '+requests.length+' people'}}</view></view>
<view wx:if="{{trip.phase==='collect' && trip.category!=='task' && trip.category!=='other'}}" class="orange-note">{{zh?'现在可以查看姓名、房间号和手机号。取走前请核对每一件上的号码。':'Names, rooms and phone numbers are now visible. Match the number on each bag before taking it.'}}</view>
<block wx:if="{{trip.category==='parcel' && trip.phase==='collect'}}"><view wx:for="{{parcels}}" wx:key="key" class="flow-card"><view class="row"><text class="amount">{{item.code}}</text><text class="badge">{{zh?'第 '+(item.index+1)+' 件':'Box '+(item.index+1)}}</text></view><view class="hint">{{item.pickupPoint}}</view><view wx:if="{{item.fragile}}" class="orange-note">{{zh?'易碎 · 请轻拿轻放':'Fragile · handle with care'}}</view><view class="contact-person"><contact-avatar name="{{item.owner}}"/><view class="contact-person-copy hint">{{item.owner}} · {{zh?'房间号':'Room'}} {{item.room}}</view></view><button class="btn" disabled="{{item.done || !!parcelBusy}}" data-id="{{item.id}}" data-index="{{item.index}}" data-code="{{item.code}}" bindtap="collect">{{item.done?(zh?'✓ 已取件':'✓ Collected'):(zh?'已取到':'Got it')}}</button><view wx:if="{{!item.done}}" class="link missing-parcel-link" aria-disabled="{{!!parcelBusy}}" data-id="{{item.id}}" data-index="{{item.index}}" data-code="{{item.code}}" bindtap="missingParcel">{{zh?'找不到':'Can’t find it'}}</view><view wx:if="{{cancelling===item.id}}" class="hint">{{zh?'该订单已部分取件，请先联系发布人再继续。':'For a partly collected request, contact the customer before continuing.'}}<view class="contact-actions"><view class="contact-button" data-id="{{item.id}}" bindtap="chat"><image src="/assets/message.svg"/><view wx:if="{{item.unread}}" class="chat-dot"/></view><view class="contact-button" data-phone="{{item.phone}}" bindtap="phone"><image src="/assets/phone.svg"/></view></view></view><order-feedback wx:if="{{item.index===0}}" order-id="{{item.id}}" zh="{{zh}}" dark="{{darkClass}}"/></view><view class="hint">{{zh?'已取 '+collected+' / '+boxes:collected+' of '+boxes+' collected'}}</view></block><view wx:if="{{trip.category==='task'}}" wx:for="{{requests}}" wx:key="id" class="flow-card"><view class="strong">{{item.title}}</view><view class="hint">{{item.owner}} · ¥{{item.rewardText}} · {{item.statusLabel}}</view><button class="btn" data-id="{{item.id}}" bindtap="request">{{zh?'查看任务与完成凭证':'View task and completion proof'}}</button><order-feedback order-id="{{item.id}}" zh="{{zh}}" dark="{{darkClass}}"/></view><view wx:for="{{requests}}" wx:key="id" wx:if="{{trip.category!=='task' && (trip.category!=='parcel'||trip.phase!=='collect')}}" class="flow-card"><view class="row"><view class="contact-person"><contact-avatar name="{{item.owner}}"/><view class="contact-person-copy value">{{item.owner}} · {{item.boxes}} {{zh?(item.unit==='bags'?'袋':item.unit==='boxes'?'件':'个任务'):item.unit}}</view></view><text class="badge {{item.status==='confirmed'?'green':''}}">{{item.status==='confirmed'?(zh?'已结算（演示）':'Paid (demo)'):item.status==='delivered'?(zh?'待确认':'Waiting'):item.status==='disputed'?(zh?'审核中':'Under review'):item.status==='collected'?(zh?'已取件':'Picked up'):item.category==='takeout'?item.arrivalLabel:(zh?'待取件':'To collect')}}</text></view><view class="row"><view><view class="hint">{{item.destinationDisplay}}</view></view><view class="contact-actions"><view class="contact-button" data-id="{{item.id}}" bindtap="chat"><image src="/assets/message.svg"/><view wx:if="{{item.unread}}" class="chat-dot"/></view><view class="contact-button" data-phone="{{item.phone}}" bindtap="phone"><image src="/assets/phone.svg"/></view></view></view><view wx:if="{{item.phone && (item.status==='taken'||item.status==='collected')}}" class="soft pickup-number-box"><view class="label">{{item.category==='takeout'?(zh?'袋子上的手机号':'Phone number on the bag'):(zh?'联系手机号':'Contact phone')}}</view><view class="row"><text class="value">{{fullNumbers[item.id]?item.phone:'••• '+item.phoneLast4}}</text><text class="link" data-id="{{item.id}}" bindtap="full">{{fullNumbers[item.id]?(zh?'收起':'Hide'):(zh?'完整号码':'Full number')}}</text></view><view wx:if="{{fullNumbers[item.id]}}" class="link hint" data-phone="{{item.phone}}" bindtap="phone">{{zh?'拨打电话':'Call'}}</view></view><view wx:if="{{item.soup}}" class="orange-note">{{zh?'↑ 内有汤或饮品 · 请保持直立':'↑ Soup or drinks inside · keep it upright'}}</view>
<block wx:if="{{item.status==='taken'||item.status==='collected'}}"><view wx:if="{{item.category==='takeout' && item.night}}" class="hint">{{zh?'订单状态：':'Order status: '}}{{item.purchaseStatus==='needs_purchase'?(zh?'未下单（需跑手垫付）':'Not ordered · runner pays upfront'):(zh?'已下单':'Already ordered')}}</view><view wx:if="{{item.category==='takeout' && !item.night && item.pickupPoint}}" class="soft"><view class="label">{{zh?'外卖柜':'Takeaway locker'}}</view><view class="value">{{item.pickupPointDisplay}}</view></view><view wx:if="{{item.category==='parcel'}}" class="soft"><view class="label">{{zh?'取件码 · 剩 '+item.left+' 个':'Pickup codes · '+item.left+' left'}}</view><view wx:for="{{item.codes}}" wx:for-item="code" wx:key="index" class="value">{{code}}</view></view><view wx:if="{{item.riderPhotos.length > 0}}" class="order-picture-list"><image wx:for="{{item.riderPhotos}}" wx:for-item="photo" wx:key="*this" class="order-picture" src="{{photo}}" mode="aspectFill" data-id="{{item.id}}" data-index="{{index}}" data-source="riderPhotos" data-photo="{{photo}}" binderror="pickupPhotoError" bindtap="previewRiderPhotos"/></view><view wx:if="{{item.orderPictures.length > 0}}" class="order-picture-list"><image wx:for="{{item.orderPictures}}" wx:for-item="picture" wx:key="*this" class="order-picture" src="{{picture}}" mode="aspectFill" data-id="{{item.id}}" data-index="{{index}}" data-source="orderPictures" data-photo="{{picture}}" binderror="pickupPhotoError" bindtap="previewPictures"/></view><view wx:if="{{item.note}}" class="hint">{{zh?'备注：':'Note: '}}{{item.note}}</view><view wx:if="{{item.pickupCode}}" class="pickup-code-line"><text>{{item.night?(zh?'取餐码':'Meal code'):(zh?'外卖手机号':'Order phone')}}</text><text class="pickup-code-value">{{item.pickupCode}}</text></view></block>
<view wx:if="{{item.status==='taken'||(item.status==='collected' && trip.phase==='collect')}}" class="pickup-actions">
<button class="btn pickup-deliver" data-id="{{item.id}}" bindtap="collectAndDeliver" loading="{{motionEnabled && (collectingId===item.id)}}" disabled="{{!!collectingId || cancelBusy || (item.status==='collected' && !allCollected)}}">{{zh?'已取物，去送达':'Picked up, go deliver'}}</button>
<button class="btn pickup-cancel" data-id="{{item.id}}" bindtap="cancel" disabled="{{!!collectingId || cancelBusy || item.status!=='taken'}}">{{zh?'取消接单':'Cancel job'}}</button>
</view>
<view wx:if="{{item.status==='collected' && trip.phase==='deliver'}}" class="upload-card"><view class="upload-head" data-id="{{item.id}}" bindtap="photo" role="button"><view class="upload-icon"><image src="/assets/photo-green.svg"/></view><view class="upload-copy"><view class="upload-title">{{zh?'送达凭证':'Delivery proof'}}</view><view class="upload-hint">{{zh?'拍照或相册上传，记录放置位置。':'Camera or album. Show the drop-off location.'}}</view></view></view><text class="upload-count">0/1</text></view><image wx:if="{{item.photo}}" class="thumb" src="{{item.photo}}" mode="aspectFill" data-photo="{{item.photo}}" bindtap="previewOrderPhoto"/><view wx:if="{{item.deliveredAt}}" class="hint">{{names[item.deliveryLocation]||item.deliveryLocation}} · {{item.deliveredTime}}<view wx:if="{{item.status==='delivered'}}">{{zh?item.autoHours+' 小时后自动确认。':'Automatically confirms after '+item.autoHours+' '+(item.autoHours===1?'hour':'hours')+'.'}}</view></view><view wx:if="{{item.status==='delivered'||item.status==='confirmed'}}" class="row"><text class="hint">{{zh?'跑手奖励':'Runner reward'}}</text><text class="strong">{{item.runnerPoints}} {{zh?'积分':'points'}}</text></view><text wx:if="{{item.status==='delivered'}}" class="link hint" data-id="{{item.id}}" bindtap="request">{{zh?'查看订单详情 →':'View order details →'}}</text><order-feedback order-id="{{item.id}}" zh="{{zh}}" dark="{{darkClass}}"/></view>
<view wx:if="{{!requests.length}}" class="flow-card empty">{{zh?'这个行程还没有订单。':'No orders on this trip.'}}<button class="btn outline" bindtap="endEmpty">{{zh?'结束行程':'End trip'}}</button></view>
<view wx:if="{{trip.phase==='done'}}" class="flow-card"><view class="strong">{{zh?'结算（模拟）':'Payments (simulated)'}}</view><view class="hint">{{zh?'已确认 ¥'+paid+' · 待确认 ¥'+pending:'¥'+paid+' confirmed · ¥'+pending+' waiting'}}</view><view class="hint">{{zh?'每个订单在确认后单独结算，或在 '+2+' 小时后自动结算。有反馈时暂停结算。':'Each order settles separately after confirmation, or after '+2+' hours. Reports pause settlement.'}}</view><view class="strong">{{zh?'你的记录 · 完成 '+jobsDone+' 单':'Your record · '+jobsDone+' done'}}</view><view class="progress-track"><view class="progress-fill" style="width:{{progress}}%"/></view><view class="row"><text>{{level}} {{zh?'跑手':'runner'}}</text><text>{{zh?'每趟上限 '+limit:limit+' per trip'}}</text></view><view class="hint">{{zh?'再完成 '+next+' 单升级 · '+marks+' 次记录':next+' more jobs to the next level · '+marks+' marks'}}</view><button class="btn" bindtap="reset">{{zh?'再找一单 →':'Find another job →'}}</button></view>
<view wx:if="{{trip.category==='parcel' && trip.phase==='collect' && requests.length}}" class="flow-bottom row"><view><view class="hint">{{zh?'你将获得':'You’ll earn'}}</view><view class="money">¥{{reward}}</view></view><button class="btn" bindtap="leave">{{zh?'去送达 →':'Go deliver →'}}</button></view>
</block></view><view wx:else class="empty">{{zh?'此设备上无法查看该行程。':'Trip unavailable on this device.'}}</view>
<block wx:if="{{deliveryId}}"><view class="sheet-shade" bindtap="closeDelivery"/><view class="flow-sheet"><view class="flow-title">{{zh?'送达凭证':'Delivery proof'}}</view><view class="upload-card upload-green" aria-disabled="{{sendingDelivery||deliverySubmitted}}"><view class="upload-head" bindtap="choosePhoto" hover-class="upload-card-press" role="button"><view class="upload-icon"><image src="/assets/photo-green.svg" mode="aspectFit"/></view><view class="upload-copy"><view class="upload-title">{{zh?'送达凭证':'Delivery proof'}}</view><view class="upload-hint">{{zh?'拍照或从相册选择，清晰展示放置位置。':'Take or select a clear photo of the drop-off location.'}}</view></view></view><text class="upload-count">{{(deliveryPhoto?1:0)}}/1</text><view wx:if="{{(deliveryPhoto?1:0)>0}}" class="upload-gallery"><view class="upload-tile"><image class="upload-image" src="{{deliveryPhoto}}" mode="aspectFill" data-photo="{{deliveryPhoto}}" bindtap="previewOrderPhoto"/><view wx:if="{{!deliverySubmitted}}" class="upload-remove" catchtap="removeDeliveryPhoto" role="button" aria-label="{{zh?'删除照片':'Remove photo'}}">×</view></view></view></view><view wx:if="{{deliveryError}}" class="orange-note">{{deliveryError}}</view><view wx:if="{{deliverySubmitted}}" class="green-note">{{zh?'送达凭证已提交。页面会停留在这里，点击下方按钮后再刷新行程。':'Delivery proof submitted. This view stays open until you return.'}}</view><button wx:if="{{!deliverySubmitted}}" class="btn" loading="{{sendingDelivery}}" disabled="{{!deliveryPhoto || sendingDelivery}}" bindtap="sendDelivery">{{sendingDelivery?(zh?'正在提交…':'Submitting…'):(zh?'提交送达凭证':'Send delivery proof')}}</button><button class="btn outline" disabled="{{sendingDelivery}}" bindtap="closeDelivery">{{deliverySubmitted?(zh?'返回行程':'Return to trip'):(zh?'返回':'Back')}}</button></view></block>
<block wx:if="{{cancellingRequest}}"><view class="sheet-shade" bindtap="backCancel"/><view class="flow-sheet cancel-sheet"><view class="strong">{{zh?'为什么取消？':'Why are you cancelling?'}}</view><view class="soft" data-value="missing" bindtap="chooseReason"><view>{{cancelReason==='missing'?'◉':'○'}} {{zh?(cancellingRequest.category==='takeout'?'找不到外卖':'找不到快递'):'Can’t find the '+(cancellingRequest.category==='takeout'?'food':'parcel')}}</view><view class="hint">{{zh?'不记录取消，无需等待。':'No mark. No waiting required.'}}</view></view><view class="soft" data-value="quantity" bindtap="chooseReason"><view>{{cancelReason==='quantity'?'◉':'○'}} {{zh?'数量不符':'Number of items doesn’t match'}}</view><view class="hint">{{zh?'不记录。发布人可以看到取消原因。':'No mark. The student can see the cancellation reason.'}}</view></view><view class="soft" data-value="personal" bindtap="chooseReason"><view>{{cancelReason==='personal'?'◉':'○'}} {{zh?'我无法继续完成':'I can’t do it anymore'}}</view><view class="hint">{{zh?(cancellingRequest.freeCancel?cancellingRequest.freeCancelTime+' 前取消不记录':'会在你的跑手记录中记一次。'):(cancellingRequest.freeCancel?'No mark before '+cancellingRequest.freeCancelTime:'Adds a mark to your runner record.')}}</view></view><view class="action-row"><button class="btn outline" bindtap="backCancel">{{zh?'返回':'Back'}}</button><button class="btn" disabled="{{!cancelReason}}" loading="{{motionEnabled && (cancelBusy)}}" bindtap="submitCancel">{{zh?'确认原因':'Confirm reason'}}</button></view></view></block>

</view>

<view style="{{motionStyle}}">
<lang-switch></lang-switch>
<view class="flow-page trip-page {{trip.category==='takeout'?'trip-takeout':''}} {{darkClass}}" wx:if="{{trip}}"><view class="flow-title">{{tripStationLabel||names[trip.station]||trip.station}} → {{requests[0]&&requests[0].destinationType==='place'?(requests[0].placeName||requests[0].deliveryAddress||trip.dorm):trip.destinationType==='place'?(trip.deliveryAddress||trip.dorm):trip.dorm}}</view><view wx:if="{{trip.pickupAddress}}" class="hint">{{trip.pickupAddress}}</view><view wx:if="{{trip.waypoint}}" class="hint">{{zh?'途经：':'Via: '}}{{trip.waypoint}}</view><view class="flow-sub">{{trip.category==='takeout'?(tripNight?(zh?'夜市代买':'Request a night market purchase'):(zh?'外卖代取':'Takeaway')):(trip.category==='other'||trip.category==='task')?(zh?'其他':'Other'):(zh?'快递代取':'Parcels')}} · {{requests.length}} {{zh?'个订单，':'orders,'}} {{boxes}} {{trip.category==='takeout'?(zh?'袋':'bags'):(zh?'件':'boxes')}}</view><view class="progress-row"><view class="progress-step active">{{zh?'1 · 取件':'1 · Pick up'}}</view><view class="progress-step {{trip.phase==='deliver'||trip.phase==='done'?'active':''}}">{{zh?'2 · 送达':'2 · Deliver'}}</view><view class="progress-step {{trip.phase==='done'?'active':''}}">{{zh?'3 · 完成':'3 · Done'}}</view></view><yuni-assistant topic="trip" stage="{{trip.phase}}" floating="{{true}}"/><view class="preview-label">{{zh?'团队测试 · 云端同步 · 不产生真实付款':'Team test · cloud sync · no real payment'}}</view>
<view wx:if="{{trip.cancelled}}" class="flow-card"><view class="strong">{{zh?'行程已结束':'Trip ended'}}</view><button class="btn" bindtap="reset">{{zh?'再找一单':'Find another job'}}</button></view>
<block wx:else>
<view wx:if="{{joinOpen}}" class="flow-card"><view class="row"><view><view class="strong">{{zh?'还可加入 '+minutes+' 分钟':'Open for '+minutes+' more min'}}</view><view class="hint">{{zh?'还能装 '+remaining+(trip.category==='takeout'?' 袋':' 件'):'Room for '+remaining+' more '+(trip.category==='takeout'?'bags':'boxes')}}</view></view><text class="amount">{{remaining}}</text></view><button class="btn" open-type="share">{{zh?'分享行程到宿舍群':'Share trip to your dorm group'}}</button><text class="link hint" bindtap="joinPreview">{{zh?'预览同学如何加入 →':'Preview how a friend joins →'}}</text><view class="hint">{{zh?'开放期间，其他同学可以加入这条顺路行程。':'Other students can join this shared route while it is open.'}}</view></view>
<view wx:if="{{trip.phase==='done'}}" class="flow-card center"><view class="big-check">✓</view><view class="flow-title">{{zh?'行程已完成':'Trip complete'}}</view><view class="hint">{{zh?'款项将转入你的钱包。':'Money will be transferred into your wallet.'}}</view><view class="amount money">¥{{reward}}</view><view class="hint">{{zh?'共 '+boxes+' 件，送给 '+requests.length+' 位同学':boxes+' items to '+requests.length+' people'}}</view></view>
<view wx:if="{{trip.phase==='collect' && trip.category!=='task' && trip.category!=='other'}}" class="orange-note">{{zh?'现在可以查看姓名、房间号和手机号。取走前请核对每一件上的号码。':'Names, rooms and phone numbers are now visible. Match the number on each bag before taking it.'}}</view>
<block wx:if="{{trip.category==='parcel' && trip.phase==='collect'}}"><view wx:for="{{parcels}}" wx:key="key" class="flow-card parcel-collect-card {{item.done?'is-done':''}}"><view class="parcel-code-plate"><view class="parcel-code-copy"><view class="parcel-code-label">{{item.done?(zh?'✓ 已取件':'✓ Collected'):(zh?'取件码':'Pickup code')}}</view><text class="parcel-code" selectable="{{true}}">{{item.code}}</text></view><text class="parcel-box-badge"><text class="order-no">#{{item.id}}</text> · {{zh?'第 '+(item.index+1)+' 件':'Box '+(item.index+1)}}</text></view><view class="parcel-station-row"><view class="parcel-station-icon"><image src="/assets/route-outline.svg"/></view><view class="parcel-station-copy"><view class="parcel-station-label">{{zh?'取件驿站':'Pickup station'}}</view><view class="parcel-station">{{item.pickupPoint}}</view></view></view><view wx:if="{{item.fragile}}" class="parcel-fragile">{{zh?'易碎 · 请轻拿轻放':'Fragile · handle with care'}}</view><view class="parcel-contact"><view class="contact-person"><contact-avatar name="{{item.owner}}"/><view class="contact-person-copy"><view class="parcel-owner">{{item.owner}}</view><view wx:if="{{item.room}}" class="parcel-room">{{zh?'房间号 ':'Room '}}{{item.room}}</view></view></view><view class="contact-actions"><view class="contact-button contact-3d" data-id="{{item.id}}" bindtap="chat" aria-label="{{zh?'发消息':'Message'}}"><image mode="aspectFit" src="/assets/icons3d/chat.svg"/><view wx:if="{{item.unread>0}}" class="trip-chat-dot"/></view><view wx:if="{{item.phone}}" class="contact-button contact-3d" data-phone="{{item.phone}}" bindtap="phone" aria-label="{{zh?'打电话':'Call'}}"><image mode="aspectFit" src="/assets/icons3d/phone.svg"/></view></view></view><view wx:if="{{item.note || item.pictures.length}}" class="parcel-memo"><view class="parcel-memo-label">{{item.note?(zh?'发布人备注':'Note from the requester'):(zh?'发布人上传的图片':'Photos from the requester')}}</view><view wx:if="{{item.note}}" class="parcel-note-text">{{item.note}}</view><view wx:if="{{item.pictures.length}}" class="parcel-picture-grid"><image wx:for="{{item.pictures}}" wx:for-item="picture" wx:key="*this" class="parcel-picture" src="{{picture}}" mode="aspectFill" data-id="{{item.id}}" data-index="{{index}}" binderror="pickupPhotoError" bindtap="previewParcelPictures"/></view></view><view class="pickup-actions"><button class="btn pickup-deliver" disabled="{{item.done || !!collectingId || cancelBusy}}" data-id="{{item.id}}" data-index="{{item.index}}" data-code="{{item.code || item.pickupCode}}" bindtap="collect">{{item.done?(zh?'✓ 已取件':'✓ Collected'):(zh?'已取到':'Got it')}}</button><button wx:if="{{!item.done && item.canCancel}}" class="btn pickup-cancel" data-id="{{item.id}}" bindtap="cancel" disabled="{{!!collectingId || cancelBusy}}">{{zh?'取消接单':'Cancel job'}}</button>
<button wx:if="{{!item.done}}" class="missing-parcel-link" data-id="{{item.id}}" data-index="{{item.index}}" data-code="{{item.code}}" disabled="{{!!parcelBusy || cancelBusy}}" catchtap="missingParcel">{{zh?'找不到':'Can’t find it'}}</button></view><view wx:if="{{!item.done}}" class="parcel-cancel-hint"><image src="/assets/lock-outline.svg"/><text>{{zh?'点「已取到」后，发布人将无法取消订单':'After you tap Got it, the requester can no longer cancel'}}</text></view><view wx:if="{{cancelling===item.id}}" class="hint">{{zh?'该订单已部分取件，请先联系发布人再继续。':'For a partly collected request, contact the customer before continuing.'}}</view><order-feedback wx:if="{{item.index===0}}" order-id="{{item.id}}" zh="{{zh}}" dark="{{darkClass}}"/></view></block><view wx:if="{{trip.phase==='deliver'}}" class="green-note">{{zh?'已全部取件 · 已送达 '+done+' / '+requests.length+' · 从低楼层开始':'All collected · '+done+' of '+requests.length+' delivered · lowest floor first'}}</view><view wx:if="{{trip.category==='task'}}" wx:for="{{requests}}" wx:key="id" class="flow-card"><view class="strong">{{item.title}}</view><view class="hint">{{item.owner}} · ¥{{item.rewardText}} · {{item.statusLabel}}</view><button class="btn" data-id="{{item.id}}" bindtap="request">{{zh?'查看任务与完成凭证':'View task and completion proof'}}</button></view><view wx:for="{{requests}}" wx:key="id" wx:if="{{trip.category!=='task' && (trip.category!=='parcel'||trip.phase!=='collect')}}" class="flow-card"><view class="row trip-card-head"><view class="contact-person"><contact-avatar name="{{item.owner}}"/><view class="trip-card-who"><view class="value trip-card-address">{{item.owner}}</view><view class="hint trip-card-owner"><text class="order-no">#{{item.id}}</text> · {{item.boxes}} {{zh?(item.unit==='bags'?'袋':item.unit==='boxes'?'件':'个任务'):(item.boxes===1?(item.unit==='bags'?'bag':item.unit==='boxes'?'box':'task'):item.unit)}}<text wx:if="{{item.status!=='collected'}}" class="trip-card-status {{item.status==='confirmed'?'is-paid':''}}"> · {{item.status==='confirmed'?(zh?'已结算（演示）':'Paid (demo)'):item.status==='delivered'?(zh?'待确认':'Waiting'):item.status==='disputed'?(zh?'审核中':'Under review'):item.category==='takeout'?item.arrivalBadge:(zh?'待取件':'To collect')}}</text></view></view></view><view class="contact-actions"><view class="contact-button contact-3d" data-id="{{item.id}}" bindtap="chat" aria-label="{{zh?'发消息':'Message'}}"><image mode="aspectFit" src="/assets/icons3d/chat.svg"/><text wx:if="{{item.unread}}" class="unread">{{item.unread}}</text></view><view class="contact-button contact-3d" data-phone="{{item.phone}}" bindtap="phone" aria-label="{{zh?'打电话':'Call'}}"><image mode="aspectFit" src="/assets/icons3d/phone.svg"/></view></view></view><view wx:if="{{item.category!=='task' && item.status!=='taken'}}" class="soft trip-dropoff trip-icon-box"><image class="trip-box-icon" mode="aspectFit" src="/assets/icons3d/offline.svg"/><view class="trip-box-body"><view class="label">{{zh?'送到':'Deliver to'}}</view><view class="value">{{item.destinationType==='place'&&item.placeName?item.placeName:item.destinationDisplay}}</view><view wx:if="{{item.destinationType==='place'&&item.placeName}}" class="trip-dropoff-detail">{{item.destinationDisplay}}</view><view wx:if="{{item.dropLabel && item.destinationType!=='place'}}" class="hint trip-dropoff-how">{{item.dropLabel}}</view></view></view><view wx:if="{{item.note && item.status!=='taken'}}" class="soft trip-runner-note trip-icon-box"><image class="trip-box-icon" mode="aspectFit" src="/assets/icons3d/note.svg"/><view class="trip-box-body"><view class="label">{{zh?'顾客备注':'Note for you'}}</view><view class="value trip-runner-note-text">{{item.note}}</view></view></view><view wx:if="{{item.soup}}" class="orange-note">{{zh?'↑ 内有汤或饮品 · 请保持直立':'↑ Soup or drinks inside · keep it upright'}}</view>
<block wx:if="{{item.status==='taken'||item.status==='collected'}}"><view wx:if="{{item.category==='takeout' && item.night}}" class="hint">{{zh?'订单状态：':'Order status: '}}{{item.purchaseStatus==='needs_purchase'?(zh?'未下单（需跑手垫付）':'Not ordered · runner pays upfront'):(zh?'已下单':'Already ordered')}}</view><view wx:if="{{item.category==='takeout' && !item.night && item.pickupPoint && item.status==='taken'}}" class="soft trip-icon-box"><image class="trip-box-icon trip-box-icon-locker" mode="aspectFit" src="/assets/icons3d/locker.svg"/><view class="trip-box-body"><view class="label">{{zh?'外卖柜':'Takeaway locker'}}</view><view class="value">{{item.pickupPointDisplay}}</view></view></view><view wx:if="{{item.category!=='parcel' && item.status==='taken'}}" class="soft trip-icon-box"><image class="trip-box-icon" mode="aspectFit" src="/assets/icons3d/{{item.category==='takeout'?'takeout':'phone'}}.svg"/><view class="trip-box-body"><view class="label">{{item.category==='takeout'?(zh?'外卖袋上的手机号':'Phone number on the bag'):(zh?'联系电话':'Contact phone')}}</view><view class="row"><text class="value">{{fullNumbers[item.id]?item.phone:'••• '+item.phoneLast4}}</text><text class="link" data-id="{{item.id}}" bindtap="full">{{fullNumbers[item.id]?(zh?'隐藏':'Hide'):(zh?'完整号码':'Full number')}}</text></view></view></view><view wx:if="{{item.category==='parcel'}}" class="soft pickup-codes-box trip-icon-box"><image class="trip-box-icon" mode="aspectFit" src="/assets/icons3d/parcel.svg"/><view class="trip-box-body"><view class="label">{{zh?('取件码 · '+item.codes.length+' 个'+(item.left?' · 剩 '+item.left+' 个':' · 已全部取到')):('Pickup codes · '+item.codes.length+(item.left?' · '+item.left+' left':' · all picked up'))}}</view><view class="pickup-code-chips"><text wx:for="{{item.codes}}" wx:for-item="code" wx:key="index" class="pickup-code-chip">{{code}}</text></view></view></view><view wx:if="{{item.riderPhotos.length > 0}}" class="order-picture-list"><image wx:for="{{item.riderPhotos}}" wx:for-item="photo" wx:key="*this" class="order-picture" src="{{photo}}" mode="aspectFill" data-id="{{item.id}}" data-index="{{index}}" data-source="riderPhotos" data-photo="{{photo}}" binderror="pickupPhotoError" bindtap="previewRiderPhotos"/></view><view wx:if="{{item.orderPictures.length > 0}}" class="order-picture-list"><image wx:for="{{item.orderPictures}}" wx:for-item="picture" wx:key="*this" class="order-picture" src="{{picture}}" mode="aspectFill" data-id="{{item.id}}" data-index="{{index}}" data-source="orderPictures" data-photo="{{picture}}" binderror="pickupPhotoError" bindtap="previewPictures"/></view><view wx:if="{{item.pickupCode}}" class="pickup-code-line"><text>{{item.night?(zh?'取餐码':'Meal code'):(zh?'外卖手机号':'Order phone')}}</text><text class="pickup-code-value">{{item.pickupCode}}</text></view></block>
<view wx:if="{{item.status==='taken'||(item.status==='collected' && trip.phase==='collect')}}" class="pickup-actions">
<button class="btn pickup-deliver" data-id="{{item.id}}" bindtap="collectAndDeliver" loading="{{motionEnabled && (collectingId===item.id)}}" disabled="{{!!collectingId || cancelBusy || (item.status==='collected' && !allCollected)}}">{{zh?'已取物，去送达':'Picked up, go deliver'}}</button>
<button class="btn pickup-cancel" data-id="{{item.id}}" bindtap="cancel" disabled="{{!!collectingId || cancelBusy || item.status!=='taken'}}">{{zh?'取消接单':'Cancel job'}}</button>
</view>
<button wx:if="{{item.status==='collected' && trip.phase==='deliver'}}" class="btn delivery-photo-btn" data-id="{{item.id}}" bindtap="photo"><image class="delivery-photo-icon" src="/assets/icons/camera-white.svg" mode="aspectFit"/><text>{{zh?'拍送达照片':'Take delivery photo'}}</text></button><image wx:if="{{item.photo}}" class="thumb" src="{{item.photo}}" mode="aspectFill" data-photo="{{item.photo}}" bindtap="previewOrderPhoto"/><view wx:if="{{item.deliveredAt}}" class="hint">{{names[item.deliveryLocation]||item.deliveryLocation}} · {{item.deliveredTime}}<view wx:if="{{item.status==='delivered'}}">{{zh?item.autoHours+' 小时后自动确认。':'Automatically confirms after '+item.autoHours+' '+(item.autoHours===1?'hour':'hours')+'.'}}</view></view><view wx:if="{{item.status==='delivered'||item.status==='confirmed'}}" class="row"><text class="hint">{{zh?'跑手奖励':'Runner reward'}}</text><text class="strong">{{item.runnerPoints}} {{zh?'积分':'points'}}</text></view><text wx:if="{{item.status==='delivered'}}" class="link hint" data-id="{{item.id}}" bindtap="request">{{zh?'查看订单详情 →':'View order details →'}}</text><view wx:if="{{item.feedbackOpen && !item.canResolveFeedback}}" class="report-contact"><view wx:if="{{item.reportNoticeText}}" class="report-nudge">{{item.reportNoticeText}}</view><button class="report-contact-btn" hover-class="report-contact-press" data-id="{{item.id}}" catchtap="report"><view wx:if="{{item.supportUnread>0}}" class="report-dot"/><text>{{item.supportUnread>0?(zh?'UniEarn 已回复，查看':'UniEarn replied · View'):(zh?'联系 UniEarn 团队':'Contact the UniEarn team')}}</text></button></view><view wx:if="{{!item.canResolveFeedback && !item.feedbackOpen && (item.status==='collected'||item.status==='delivered'||item.supportUnread>0)}}" class="report-link {{item.supportUnread>0?'has-reply':''}}" hover-class="report-link-press" role="button" data-id="{{item.id}}" bindtap="report"><view wx:if="{{item.supportUnread>0}}" class="report-dot"/><image wx:else mode="aspectFit" src="/assets/icons/flag-muted.svg"/><text>{{item.supportUnread>0?(zh?'UniEarn 已回复':'UniEarn replied'):item.canResolveFeedback?(zh?'联系 UniEarn':'Chat with UniEarn'):item.feedbackOpen?(zh?'联系 UniEarn 团队':'Contact the UniEarn team'):(zh?'报告问题':'Report a problem')}}</text></view><order-feedback order-id="{{item.id}}" unread="{{item.supportUnread}}" resolvable="{{item.canResolveFeedback}}" completes="{{item.feedbackResolutionCompletes}}" zh="{{zh}}" dark="{{darkClass}}"/></view>
<view wx:if="{{!requests.length}}" class="flow-card empty">{{zh?'这个行程还没有订单。':'No orders on this trip.'}}<button class="btn outline" bindtap="endEmpty">{{zh?'结束行程':'End trip'}}</button></view>
<view wx:if="{{trip.phase==='done'}}" class="flow-card"><view class="strong">{{zh?'结算（模拟）':'Payments (simulated)'}}</view><view class="hint">{{zh?'已确认 ¥'+paid+' · 待确认 ¥'+pending:'Balance ¥'+paid+' confirmed · ¥'+pending+' waiting'}}</view><view class="hint">{{zh?'每个订单在确认后单独结算，或在 '+2+' 小时后自动结算。有反馈时暂停结算。':'Each order settles separately after confirmation, or after '+2+' hours. Reports pause settlement.'}}</view><view class="strong">{{zh?'你的记录 · 完成 '+jobsDone+' 单':'Your record · '+jobsDone+' done'}}</view><view class="progress-track"><view class="progress-fill" style="width:{{progress}}%"/></view><view class="row"><text>{{level}} {{zh?'跑手':'runner'}}</text><text>{{zh?'每趟上限 '+limit:limit+' per trip'}}</text></view><view class="hint">{{zh?'再完成 '+next+' 单升级 · '+marks+' 次记录':next+' more jobs to the next level · '+marks+' marks'}}</view><button class="btn" bindtap="reset">{{zh?'再找一单 →':'Find another job →'}}</button></view>

</block></view><view wx:else class="empty">{{zh?'此设备上无法查看该行程。':'Trip unavailable on this device.'}}</view>
<block wx:if="{{deliveryId}}"><view class="sheet-shade" bindtap="closeDelivery"/><view class="flow-sheet"><view class="flow-title">{{zh?'送达凭证':'Delivery proof'}}</view><view wx:if="{{!deliverySubmitted}}" class="dash" bindtap="choosePhoto">{{deliveryPhoto?(zh?'更换照片':'Replace photo'):(zh?'拍摄或选择照片':'Take / choose a photo')}}</view><view wx:if="{{deliveryPhoto}}" class="pg-preview"><image class="proof" src="{{deliveryPhoto}}" mode="aspectFill"/><view class="pg-x" catchtap="removeDeliveryPhoto">×</view></view><view wx:if="{{deliveryError}}" class="orange-note">{{deliveryError}}</view><view wx:if="{{deliverySubmitted}}" class="green-note">{{zh?'送达凭证已提交。页面会停留在这里，点击下方按钮后再刷新行程。':'Delivery proof submitted. This view stays open until you return.'}}</view><button wx:if="{{!deliverySubmitted}}" class="btn" loading="{{sendingDelivery}}" disabled="{{!deliveryPhoto || sendingDelivery}}" bindtap="sendDelivery">{{sendingDelivery?(zh?'正在提交…':'Submitting…'):(zh?'提交送达凭证':'Send delivery proof')}}</button><button class="btn outline" disabled="{{sendingDelivery}}" bindtap="closeDelivery">{{deliverySubmitted?(zh?'返回行程':'Return to trip'):(zh?'返回':'Back')}}</button></view></block>
<block wx:if="{{cancellingRequest}}"><view class="sheet-shade" bindtap="backCancel"/><view class="flow-sheet cancel-sheet"><view class="strong">{{zh?'为什么取消？':'Why are you cancelling?'}}</view><view class="soft" data-value="missing" bindtap="chooseReason"><view>{{cancelReason==='missing'?'◉':'○'}} {{zh?(cancellingRequest.category==='takeout'?'找不到外卖':'找不到快递'):'Can’t find the '+(cancellingRequest.category==='takeout'?'food':'parcel')}}</view><view class="hint">{{zh?'不记录取消，无需等待。':'No mark. No waiting required.'}}</view></view><view class="soft" data-value="quantity" bindtap="chooseReason"><view>{{cancelReason==='quantity'?'◉':'○'}} {{zh?'数量不符':'Number of items doesn’t match'}}</view><view class="hint">{{zh?'不记录。发布人可以看到取消原因。':'No mark. The student can see the cancellation reason.'}}</view></view><view class="soft" data-value="personal" bindtap="chooseReason"><view>{{cancelReason==='personal'?'◉':'○'}} {{zh?'我无法继续完成':'I can’t do it anymore'}}</view><view class="hint">{{zh?(cancellingRequest.freeCancel?cancellingRequest.freeCancelTime+' 前取消不记录':'会在你的跑手记录中记一次。'):(cancellingRequest.freeCancel?'No mark before '+cancellingRequest.freeCancelTime:'Adds a mark to your runner record.')}}</view></view><view class="action-row"><button class="btn outline" bindtap="backCancel">{{zh?'返回':'Back'}}</button><button class="btn" disabled="{{!cancelReason}}" loading="{{motionEnabled && (cancelBusy)}}" bindtap="submitCancel">{{zh?'确认原因':'Confirm reason'}}</button></view></view></block>

</view>

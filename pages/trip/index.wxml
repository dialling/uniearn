<view class="flow-page" wx:if="{{trip}}"><view class="flow-title">{{trip.station}} → {{trip.dorm}}</view><view class="flow-sub">{{trip.category==='takeout'?'Takeaway':'Parcels'}} · {{requests.length}} orders, {{boxes}} {{trip.category==='takeout'?'bags':'boxes'}}</view><view class="progress-row"><view class="progress-step active">1 · Pick up</view><view class="progress-step {{trip.phase==='deliver'||trip.phase==='done'?'active':''}}">2 · Deliver</view><view class="progress-step {{trip.phase==='done'?'active':''}}">3 · Done</view></view><yuni-assistant topic="trip" stage="{{trip.phase}}"/><view class="preview-label">Team test · cloud sync · no real payment</view>
<view wx:if="{{trip.cancelled}}" class="flow-card"><view class="strong">Trip ended</view><button class="btn" bindtap="reset">Find another job</button></view>
<block wx:else>
<view wx:if="{{joinOpen}}" class="flow-card"><view class="row"><view><view class="strong">Open for {{minutes}} more min</view><view class="hint">Room for {{remaining}} more {{trip.category==='takeout'?'bags':'boxes'}}</view></view><text class="amount">{{remaining}}</text></view><button class="btn" open-type="share">Share trip to your dorm group</button><text class="link hint" bindtap="joinPreview">Preview how a friend joins →</text><view class="hint">Other students can join this shared route while it is open.</view></view>
<view wx:if="{{trip.phase==='done'}}" class="flow-card center"><view class="big-check">✓</view><view class="flow-title">Trip complete</view><view class="amount money">¥{{reward}}</view><view class="hint">{{boxes}} items to {{requests.length}} people</view></view>
<view wx:if="{{trip.phase==='collect'}}" class="orange-note">Names, rooms and phone numbers are now visible. Match the number on each bag before taking it.</view>
<block wx:if="{{trip.category==='parcel' && trip.phase==='collect'}}"><view wx:for="{{parcels}}" wx:key="key" class="flow-card"><view class="row"><text class="amount">{{item.code}}</text><text class="badge">Box {{item.index+1}}</text></view><view class="hint">{{item.owner}} · Room {{item.room}}</view><button class="btn" disabled="{{item.done}}" data-id="{{item.id}}" data-index="{{item.index}}" bindtap="collect">{{item.done?'✓ Collected':'Got it'}}</button><view wx:if="{{!item.done}}" class="link" data-id="{{item.id}}" bindtap="missingParcel">Can’t find it</view><view wx:if="{{cancelling===item.id}}" class="hint">For a partly collected request, contact the customer before continuing.<view class="contact-actions"><view class="contact-button" data-id="{{item.id}}" bindtap="chat"><image src="/assets/message.svg"/></view><view class="contact-button" data-phone="{{item.phone}}" bindtap="phone"><image src="/assets/phone.svg"/></view></view></view></view><view class="hint">{{collected}} of {{boxes}} collected</view></block><view wx:if="{{trip.phase==='deliver'}}" class="green-note">All collected · {{done}} of {{requests.length}} delivered · lowest floor first</view><view wx:for="{{requests}}" wx:key="id" wx:if="{{trip.category!=='parcel'||trip.phase!=='collect'}}" class="flow-card"><view class="row"><view class="value">{{item.owner}} · {{item.boxes}} {{item.unit}}</view><text class="badge {{item.status==='confirmed'?'green':''}}">{{item.status==='confirmed'?'Paid (demo)':item.status==='delivered'?'Waiting':item.status==='disputed'?'Under review':item.status==='collected'?'Picked up':item.category==='takeout'?item.arrivalLabel:'To collect'}}</text></view><view class="row"><view class="hint">{{item.destinationDisplay}}</view><view class="contact-actions"><view class="contact-button" data-id="{{item.id}}" bindtap="chat"><image src="/assets/message.svg"/><text wx:if="{{item.unread}}" class="unread">{{item.unread}}</text></view><view class="contact-button" data-phone="{{item.phone}}" bindtap="phone"><image src="/assets/phone.svg"/></view></view></view><view wx:if="{{item.soup}}" class="orange-note">↑ Soup or drinks inside · keep it upright</view>
<block wx:if="{{item.status==='taken'||item.status==='collected'}}"><view class="soft"><view class="label">{{item.category==='takeout'?'Phone number on the bag':'Contact phone'}}</view><view class="row"><text class="value">{{fullNumbers[item.id]?item.phone:'••• '+item.phoneLast4}}</text><text class="link" data-id="{{item.id}}" bindtap="full">{{fullNumbers[item.id]?'Hide':'Full number'}}</text></view><view wx:if="{{fullNumbers[item.id]}}" class="link hint" data-phone="{{item.phone}}" bindtap="phone">Call</view></view><view wx:if="{{item.category==='parcel'}}" class="soft"><view class="label">Pickup codes · {{item.left}} left</view><view wx:for="{{item.codes}}" wx:for-item="code" wx:key="index" class="value">{{code}}</view></view><image wx:if="{{item.riderPhoto}}" class="thumb" src="{{item.riderPhoto}}" mode="aspectFill" data-photo="{{item.riderPhoto}}" bindtap="previewOrderPhoto"/><view wx:elif="{{item.category==='takeout'}}" class="hint">No rider’s photo yet. Check the number on the bag.</view><view class="hint">{{item.dropNote}} {{item.note}}</view></block>
<block wx:if="{{item.status==='taken'}}"><block wx:if="{{cancelling!==item.id}}"><button class="btn" data-id="{{item.id}}" bindtap="collect">✓ {{item.category==='takeout'?'Picked up':'Collect next parcel'}}</button><view wx:if="{{item.category==='takeout'}}" class="link hint" data-id="{{item.id}}" bindtap="broken">{{item.sealReportedAt?'Seal issue recorded':'Seal already broken? Report before pickup'}}</view><view class="row hint"><text>{{item.etaChanged?'Student moved the ETA · no personal cancellation mark':item.freeCancel?'Free until '+item.freeCancelTime:'Late personal cancellation adds a mark.'}}</text><text class="link" data-id="{{item.id}}" bindtap="cancel">Cancel order</text></view></block><block wx:else><view class="strong">Why are you cancelling?</view><view class="soft {{!item.missingAllowed?'locked':''}}" data-value="missing" bindtap="chooseReason"><view>{{cancelReason==='missing'?'◉':'○'}} Can’t find the {{item.category==='takeout'?'food':'parcel'}}</view><view class="hint">{{item.missingAllowed?'No mark.':'Available from '+item.missingTime+' (arrival + 10 min).'}}</view></view><view class="soft" data-value="quantity" bindtap="chooseReason"><view>{{cancelReason==='quantity'?'◉':'○'}} Number of items doesn’t match</view><view class="hint">No mark. The student can see the cancellation reason.</view></view><view class="soft" data-value="personal" bindtap="chooseReason"><view>{{cancelReason==='personal'?'◉':'○'}} I can’t do it anymore</view><view class="hint">{{item.freeCancel?'No mark before '+item.freeCancelTime:'Adds a mark to your runner record.'}}</view></view><view class="action-row"><button class="btn outline" bindtap="backCancel">Back</button><button class="btn" disabled="{{!cancelReason||(cancelReason==='missing' && !item.missingAllowed)}}" bindtap="submitCancel">Confirm reason</button></view></block></block>
<view wx:if="{{item.category==='takeout' && item.status==='collected'}}" class="orange-note">{{item.deliveryMinutes>0?'Deliver within '+item.deliveryMinutes+' min · by '+item.deliveryBy:'15-minute delivery target passed · finish promptly'}}</view><button wx:if="{{item.status==='collected' && trip.phase==='deliver'}}" class="btn" data-id="{{item.id}}" bindtap="photo">Take delivery photo</button><image wx:if="{{item.photo}}" class="thumb" src="{{item.photo}}" mode="aspectFill" data-photo="{{item.photo}}" bindtap="previewOrderPhoto"/><view wx:if="{{item.deliveredAt}}" class="hint">{{item.deliveryLocation}} · {{item.deliveredTime}}<view wx:if="{{item.status==='delivered'}}">Automatically confirms after {{item.autoHours}} {{item.autoHours===1?'hour':'hours'}}.</view></view><view class="row"><text class="hint">Runner reward</text><text class="strong">¥{{item.earnedText}}</text></view><text wx:if="{{item.status==='delivered'}}" class="link hint" data-id="{{item.id}}" bindtap="request">View order details →</text></view>
<view wx:if="{{!requests.length}}" class="flow-card empty">No orders on this trip.<button class="btn outline" bindtap="endEmpty">End trip</button></view>
<view wx:if="{{trip.phase==='done'}}" class="flow-card"><view class="strong">Payments (simulated)</view><view class="hint">¥{{paid}} confirmed · ¥{{pending}} waiting</view><view class="hint">Each order settles separately after confirmation, or after {{trip.category==='takeout'?1:48}} hours. Reports pause settlement.</view><view class="strong">Your record · {{jobsDone}} done · {{onTime}} on time</view><view class="progress-track"><view class="progress-fill" style="width:{{progress}}%"/></view><view class="row"><text>{{level}} runner</text><text>{{limit}} per trip</text></view><view class="hint">{{next}} more jobs to the next level · {{marks}} marks</view><button class="btn" bindtap="reset">Find another job →</button></view>
<view wx:if="{{trip.phase==='collect' && requests.length}}" class="flow-bottom row"><view><view class="hint">You’ll earn</view><view class="money">¥{{reward}}</view></view><button class="btn" bindtap="leave">Go deliver →</button></view>
</block></view><view wx:else class="empty">Trip unavailable on this device.</view>
<block wx:if="{{deliveryId}}"><view class="sheet-shade" bindtap="closeDelivery"/><view class="flow-sheet"><view class="flow-title">Delivery proof</view><view class="dash" bindtap="choosePhoto">{{deliveryPhoto?'Replace photo':'Take / choose a photo'}}</view><image wx:if="{{deliveryPhoto}}" class="proof" src="{{deliveryPhoto}}" mode="aspectFill"/><view class="pills"><text wx:for="{{locations}}" wx:key="*this" class="pill green {{location===item?'selected':''}}" data-value="{{item}}" bindtap="chooseLocation">{{item}}</text></view><view wx:if="{{trip.category==='takeout'}}" class="soft" bindtap="seal">{{sealChecked?'☑':'☐'}} I checked the seal and included it in the delivery photo.</view><button class="btn" disabled="{{!deliveryPhoto || (trip.category==='takeout' && !sealChecked)}}" bindtap="sendDelivery">Send delivery proof</button><button class="btn outline" bindtap="closeDelivery">Back</button></view></block>

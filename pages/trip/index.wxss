@import "../../utils/order-pictures.wxss";
@import "../../utils/flow.wxss";

.trip-takeout{padding-bottom:calc(35rpx + env(safe-area-inset-bottom))}
.pickup-actions{display:flex;flex-direction:column;gap:14rpx;margin:24rpx 0 18rpx}
.pickup-actions .btn{width:100%;margin:0;min-height:82rpx;border-radius:20rpx;font-size:27rpx;box-sizing:border-box}
.pickup-actions .pickup-deliver{background:#0b7a55;color:#fff}
.pickup-actions .pickup-cancel{background:#f9eee7;color:#b45321;border:1rpx solid #efd9cb}
.pickup-actions .btn[disabled]{background:#eeede8;color:#95998f;border-color:transparent}
.page-dark .pickup-actions .pickup-cancel{background:#3c2c23;color:#f4b582;border-color:#614434}
.page-dark .pickup-actions .btn[disabled]{background:#343831;color:#8f9888}
.cancel-sheet .action-row{margin-top:22rpx}

.pickup-code-line{display:flex;align-items:center;justify-content:space-between;margin:10rpx 0;padding:14rpx 18rpx;border-radius:14rpx;background:#f3faf6;color:#0b7a55;font-size:24rpx}.pickup-code-value{font-weight:800;letter-spacing:3rpx;font-size:30rpx}.page-dark .pickup-code-line{background:#44423c;color:#6fd0a8}

.seal-report-row{gap:20rpx;margin:16rpx 0}.seal-report-description{flex:1;min-width:0}.seal-report-action,.seal-report-recorded{flex-shrink:0;white-space:nowrap}

.parcel-collect-card{padding:28rpx 28rpx 24rpx;border-color:#ebe7dd;box-shadow:0 8rpx 28rpx rgba(40,36,28,.06)}
.parcel-collect-card.is-done{opacity:.78}
.parcel-code-plate{display:flex;align-items:center;justify-content:space-between;gap:16rpx;background:#eef6f1;border-radius:22rpx;padding:20rpx 24rpx}
.parcel-code-copy{min-width:0}
.parcel-code-label{font-size:22rpx;color:#4f7a63;line-height:1.3}
.parcel-code{display:block;font-family:monospace;font-size:60rpx;font-weight:850;letter-spacing:4rpx;line-height:1.15;color:#1f2a24;word-break:break-all}
.parcel-box-badge{flex:none;background:#fff;color:#4f7a63;border-radius:999rpx;padding:8rpx 18rpx;font-size:22rpx;font-weight:600}
.is-done .parcel-code-plate{background:#f0efea}
.is-done .parcel-code-label,.is-done .parcel-box-badge{color:#8a877e}
.parcel-station-row{display:flex;align-items:center;gap:18rpx;margin:24rpx 0 4rpx}
.parcel-station-icon{flex:none;width:64rpx;height:64rpx;border-radius:20rpx;background:#f6f3ec;display:flex;align-items:center;justify-content:center}
.parcel-station-icon image{width:34rpx;height:34rpx}
.parcel-station-copy{min-width:0}
.parcel-station-label{font-size:22rpx;color:#8a877e;line-height:1.3}
.parcel-station{font-size:36rpx;font-weight:750;color:#2a2925;line-height:1.3;overflow-wrap:break-word}
.parcel-fragile{display:inline-block;margin:14rpx 0 0;padding:6rpx 16rpx;border-radius:999rpx;background:#fbefe6;color:#b45321;font-size:22rpx}
.parcel-contact{display:flex;align-items:center;justify-content:space-between;gap:16rpx;margin:20rpx 0 0;padding-top:20rpx;border-top:1rpx solid #efebe2}
.parcel-owner{font-size:28rpx;font-weight:650;color:#2a2925;line-height:1.35}
.parcel-room{font-size:24rpx;color:#7d7a72;line-height:1.4}
.parcel-contact .contact-actions{flex:none}
.parcel-memo{margin:20rpx 0 0;padding:18rpx 20rpx;border-radius:18rpx;background:#f7f4ed}
.parcel-memo-label{font-size:22rpx;color:#8a877e;margin-bottom:8rpx}
.parcel-note-text{font-size:27rpx;color:#3a3832;line-height:1.6;white-space:pre-wrap;overflow-wrap:break-word}
.parcel-picture-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12rpx;margin-top:14rpx}
.parcel-note-text+.parcel-picture-grid{margin-top:16rpx}
.parcel-memo-label+.parcel-picture-grid{margin-top:4rpx}
.parcel-picture{width:100%;height:190rpx;border-radius:14rpx;background:#ece8de}
.parcel-collect-card .pickup-actions{margin:24rpx 0 14rpx}
.parcel-cancel-hint{display:flex;align-items:center;justify-content:center;gap:8rpx;font-size:22rpx;color:#8a877e;line-height:1.5;text-align:center}
.parcel-cancel-hint image{flex:none;width:24rpx;height:24rpx;opacity:.7}
.page-dark .parcel-collect-card{border-color:#3a3b37}
.page-dark .parcel-code-plate{background:#2f3a33}
.page-dark .parcel-code-label,.page-dark .parcel-box-badge{color:#8fcfae}
.page-dark .parcel-code{color:#f3f0e8}
.page-dark .parcel-box-badge{background:#242522}
.page-dark .is-done .parcel-code-plate{background:#343831}
.page-dark .parcel-station-icon,.page-dark .parcel-memo{background:#2e2f2b}
.page-dark .parcel-station-icon image{opacity:.8}
.page-dark .parcel-station,.page-dark .parcel-owner,.page-dark .parcel-note-text{color:#f3f0e8}
.page-dark .parcel-station-label,.page-dark .parcel-room,.page-dark .parcel-memo-label,.page-dark .parcel-cancel-hint{color:#a8a59c}
.page-dark .parcel-contact{border-top-color:#3a3b37}
.page-dark .parcel-fragile{background:#3c2c23;color:#f4b582}
.page-dark .parcel-picture{background:#343831}

.missing-parcel-link{color:#c46524}
.nav-dark .missing-parcel-link,.dark .missing-parcel-link{color:#e8a06a}

.trip-page .contact-button{position:relative;overflow:visible}.trip-chat-dot{position:absolute;right:-2rpx;top:-2rpx;width:17rpx;height:17rpx;border:3rpx solid #fff;border-radius:50%;background:#fa5151;box-sizing:content-box;pointer-events:none}.page-dark .trip-chat-dot{border-color:#242522}

button.missing-parcel-link{display:block;width:100%;margin:0;padding:14rpx 0;min-height:72rpx;line-height:1.5;text-align:left;background:transparent;color:#c46524;font-size:28rpx;border-radius:0}button.missing-parcel-link::after{border:0}button.missing-parcel-link[disabled]{background:transparent;color:#999}

/* Pickup codes: wrap several codes as chips instead of a tall stacked list. */
.pickup-code-chips{display:flex;flex-wrap:wrap;gap:14rpx;margin-top:14rpx}
.pickup-code-chip{display:inline-flex;align-items:center;justify-content:center;min-width:132rpx;box-sizing:border-box;padding:12rpx 22rpx;border-radius:16rpx;background:#fff;border:2rpx solid #d9e5dc;color:#16181c;font-size:34rpx;font-weight:800;letter-spacing:4rpx;font-variant-numeric:tabular-nums;line-height:1.3}
.page-dark .pickup-code-chip{background:#242522;border-color:#3a3b37;color:#edebe4}

/* Delivery cards lead with where to go: address is the headline, customer below. */
.trip-card-address{font-size:34rpx;font-weight:800;color:#16181c;line-height:1.35}
.trip-card-owner{font-size:25rpx;color:#6b6860}
.page-dark .trip-card-address{color:#edebe4}

/* Take delivery photo matches the full-width "Picked up, go deliver" button. */
button.btn.delivery-photo-btn{display:flex;align-items:center;justify-content:center;gap:12rpx;width:100%!important;max-width:none;margin:24rpx 0 18rpx;min-height:82rpx;border-radius:20rpx;font-size:27rpx;box-sizing:border-box;background:#0b7a55;color:#fff}
.delivery-photo-icon{width:36rpx;height:36rpx;flex:none}
.trip-dropoff-detail{margin-top:4rpx;font-size:26rpx;color:#3f3d38;line-height:1.4;word-break:break-all}.trip-dropoff-how{margin:6rpx 0 0}.trip-runner-note-text{line-height:1.45;word-break:break-all;white-space:pre-wrap}.page-dark .trip-dropoff-detail{color:#c9c6bd}
.trip-icon-box{display:flex;align-items:center;gap:22rpx}.trip-box-icon{flex:none;width:80rpx;height:80rpx;padding:10rpx;box-sizing:border-box;border-radius:22rpx;background:#fff;box-shadow:0 4rpx 12rpx rgba(22,24,28,.07)}.trip-box-body{flex:1;min-width:0}.page-dark .trip-box-icon{background:#2b2d29;box-shadow:none}
.trip-page .contact-button.contact-3d{background:#fff;border:0;box-shadow:0 4rpx 12rpx rgba(22,24,28,.08),inset 0 0 0 1rpx rgba(22,24,28,.05)}.trip-page .contact-button.contact-3d image{width:46rpx;height:46rpx}.page-dark.trip-page .contact-button.contact-3d,.page-dark .trip-page .contact-button.contact-3d{background:#2b2d29!important}
.trip-box-icon.trip-box-icon-locker{padding:4rpx;margin-top:34rpx}
.parcel-code-copy .parcel-code{display:inline-block;margin-top:8rpx;padding:8rpx 28rpx;border:2rpx solid #dcdad3;border-radius:20rpx;background:#fff;box-shadow:0 4rpx 10rpx rgba(22,24,28,.06)}.page-dark .parcel-code-copy .parcel-code{background:#242522;border-color:#3a3b37}
.trip-card-head{align-items:center}.trip-card-head .contact-person{flex:1;min-width:0}.trip-card-who{min-width:0}.trip-card-who .trip-card-owner{margin:2rpx 0 0}.trip-card-status{display:inline-block;flex:none;max-width:60%;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;padding:5rpx 18rpx;border-radius:99rpx;background:#fdeee4;color:#b4501f;font-size:23rpx;font-weight:700;line-height:1.4}.trip-card-status.is-paid,.trip-card-status.is-ready{background:#e3f3ea;color:#0b7a55}.trip-card-status.is-review{background:#fff1d6;color:#8a5a00}.trip-card-head{gap:20rpx}.trip-card-head .trip-card-who{flex:1;min-width:0;display:flex;flex-direction:column;gap:10rpx}.trip-card-line{display:flex;align-items:center;justify-content:space-between;gap:16rpx;min-width:0}.trip-card-line .trip-card-address{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.trip-card-line .trip-card-owner{flex:1;min-width:0;margin:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.trip-card-line .contact-actions{flex:none}.page-dark .trip-card-status{background:#3a2a20;color:#f3b58f}.page-dark .trip-card-status.is-paid,.page-dark .trip-card-status.is-ready{background:#1f3a2e;color:#6fd0a8}.page-dark .trip-card-status.is-review{background:#3b3220;color:#f0c777}
.report-link{display:flex;align-items:center;justify-content:center;gap:10rpx;margin:18rpx 0 4rpx;padding:12rpx 0;color:#8a877e;font-size:24rpx}.report-link image{width:28rpx;height:28rpx}.report-link-press{opacity:.55}.page-dark .report-link{color:#a9a69c}
.report-link.has-reply{color:#0b7a55;font-weight:700}.report-dot{width:14rpx;height:14rpx;border-radius:50%;background:#e5484d}
.report-nudge{margin:14rpx 0 6rpx;padding:14rpx 20rpx;border-radius:16rpx;background:#fff4e2;color:#8a4b13;font-size:24rpx;line-height:1.45}.page-dark .report-nudge{background:#3a2a1a;color:#f4c79a}
.report-contact{margin:18rpx 0 8rpx}.report-contact .report-nudge{margin:0 0 12rpx}.report-contact button.report-contact-btn{display:flex;align-items:center;justify-content:center;gap:10rpx;width:100%!important;max-width:none;margin:0;padding:0;height:84rpx;line-height:84rpx;border:2rpx solid #0b7a55;border-radius:20rpx;background:#fff;color:#0b7a55;font-size:27rpx;font-weight:700}.report-contact-btn::after{border:0}.report-contact-press{background:#eef6f1!important}.page-dark .report-contact button.report-contact-btn{background:#242522;border-color:#6fd0a8;color:#6fd0a8}
.order-no{text-transform:uppercase;font-variant-numeric:tabular-nums;letter-spacing:.5rpx}

/* customer note: a warm sticky-note tile so it stands apart from the grey info tiles */
.trip-runner-note{position:relative;margin-top:18rpx;background:#fff7e0;border:2rpx solid #f6dfa3}
.trip-runner-note .label{color:#9a6a00;font-weight:700}
.trip-runner-note .trip-box-icon{background:#fff;box-shadow:0 4rpx 12rpx rgba(154,106,0,.12)}
.trip-runner-note-text{margin-top:4rpx;font-size:30rpx;font-weight:600;color:#3a2c08}
.page-dark .trip-runner-note{background:#3a3220;border-color:#5a4a26}
.page-dark .trip-runner-note .label{color:#f0c777}
.page-dark .trip-runner-note-text{color:#f6ead0}
.trip-runner-note-text{word-break:normal;overflow-wrap:anywhere}

/* 2026-11-15: open trip redesign, same family as Start a trip / Post a task */
.trip-page .flow-title{font-size:40rpx;font-weight:800;line-height:1.3;letter-spacing:-.5rpx}
.trp-meta{display:flex;align-items:center;gap:14rpx;margin-top:12rpx;font-size:24rpx;color:#6b6860}
.trp-chip{padding:4rpx 16rpx;border-radius:99rpx;background:#fdeee4;color:#c2410c;font-size:22rpx;font-weight:700}
.trip-page .progress-row{margin:28rpx 0 10rpx}
.trip-page .progress-step::before{height:10rpx}
.trp-share{padding:30rpx 28rpx;border-radius:36rpx}
.trp-share-top{display:flex;align-items:center;gap:24rpx}
.trp-timer{position:relative;flex:none;width:112rpx;height:112rpx;border-radius:50%;background:#e3f3ea;display:flex;flex-direction:column;align-items:center;justify-content:center;color:#0b7a55}
.trp-timer::after{content:'';position:absolute;inset:-8rpx;border-radius:50%;border:4rpx solid #0b7a5533;animation:var(--ue-animation,trp-pulse 2.4s ease-out infinite)}
.trp-timer-num{font-size:40rpx;font-weight:800;line-height:1}
.trp-timer-unit{margin-top:2rpx;font-size:20rpx;font-weight:700}
.trp-share-copy{flex:1;min-width:0}
.trp-share-title{font-size:32rpx;font-weight:800;color:#16181c}
.trp-share-sub{margin-top:6rpx;font-size:25rpx;color:#6b6860}
.trp-share-btn{display:flex!important;align-items:center;justify-content:center;gap:14rpx;width:100%!important;height:96rpx;margin:28rpx 0 0!important;padding:0;border-radius:28rpx;background:#0b7a55;color:#fff;font-size:29rpx;font-weight:800;line-height:1.2;box-shadow:0 8rpx 0 #08603f}
.trp-share-btn::after{border:0}
.trp-share-icon{width:36rpx;height:36rpx}
.trp-share-foot{display:flex;flex-direction:column;gap:14rpx;margin-top:26rpx}
.trp-share-hint{font-size:23rpx;line-height:1.5;color:#7a776e}
.trp-link{align-self:flex-start;font-size:25rpx;font-weight:700;color:#0b7a55;text-decoration:underline}
.trp-empty{display:flex;flex-direction:column;align-items:center;text-align:center;padding:40rpx 32rpx 34rpx;border-radius:36rpx}
.trp-empty-yuni{width:150rpx;height:150rpx}
.trp-empty-title{margin-top:10rpx;font-size:30rpx;font-weight:800;color:#16181c}
.trp-empty-sub{margin-top:8rpx;max-width:520rpx;font-size:24rpx;line-height:1.5;color:#6b6860}
.trp-end{width:100%!important;margin:28rpx 0 0!important;height:88rpx;line-height:88rpx;border-radius:26rpx}
@keyframes trp-pulse{0%{transform:scale(.92);opacity:.9}100%{transform:scale(1.12);opacity:0}}
.page-dark .trp-share-title,.page-dark .trp-empty-title{color:#edebe4}
.page-dark .trp-timer{background:#16332a;color:#6fd0a8}
.page-dark .trp-chip{background:#3a2a20;color:#f3b58f}

/* join requests (2026-11-15): a warm card the runner answers with Decline / Accept */
.of-wrap{margin:24rpx 0}
.of-head{display:flex;align-items:center;gap:12rpx}
.of-title{font-size:32rpx;font-weight:800;color:#16181c}
.of-count{min-width:40rpx;height:40rpx;line-height:40rpx;padding:0 10rpx;border-radius:99rpx;background:#c2410c;color:#fff;font-size:22rpx;font-weight:800;text-align:center;box-sizing:border-box}
.of-sub{margin:6rpx 0 16rpx;font-size:24rpx;color:#6b6860;line-height:1.5}
.of-card{margin-bottom:18rpx;padding:26rpx 26rpx 24rpx;border-radius:36rpx;background:#fff;border:3rpx solid #f6c9a8;box-shadow:0 8rpx 22rpx rgba(194,65,12,.10)}
.of-top{display:flex;align-items:center;gap:18rpx}
.of-icon{flex:none;width:84rpx;height:84rpx;padding:10rpx;box-sizing:border-box;border-radius:24rpx;background:#fdeee4}
.of-what{flex:1;min-width:0}
.of-type{font-size:30rpx;font-weight:800;color:#16181c}
.of-count-text{font-weight:600;color:#6b6860}
.of-when{margin-top:4rpx;font-size:23rpx;font-weight:700;color:#0b7a55}
.of-reward{flex:none;font-size:36rpx;font-weight:800;color:#c2410c;font-variant-numeric:tabular-nums}
.of-route{margin-top:18rpx;padding:16rpx 20rpx;border-radius:22rpx;background:#f6f5f1;display:flex;flex-direction:column;gap:10rpx}
.of-leg{display:flex;gap:16rpx;align-items:baseline}
.of-k{flex:none;width:64rpx;font-size:22rpx;color:#8a877e}
.of-v{flex:1;min-width:0;font-size:26rpx;font-weight:700;color:#2b2a26;overflow-wrap:anywhere}
.of-foot{margin-top:14rpx}
.of-left{font-size:22rpx;color:#9a6a00}
.of-actions{display:flex;gap:16rpx;margin-top:18rpx}
.of-actions .btn{flex:1;height:88rpx;line-height:88rpx;margin:0!important;padding:0;border-radius:26rpx;font-size:28rpx;font-weight:800}
.of-decline{background:#f1f0eb!important;color:#5e5c55!important;box-shadow:none!important}
.of-accept{background:#0b7a55!important;color:#fff!important;box-shadow:0 6rpx 0 #08603f!important}
.of-actions .btn::after{border:0}
.page-dark .of-card{background:#252a28;border-color:#5a3a26}
.page-dark .of-title,.page-dark .of-type{color:#edebe4}
.page-dark .of-route{background:#1f2321}
.page-dark .of-v{color:#d8e2db}
.page-dark .of-decline{background:#2b2d29!important;color:#c8c5bb!important}

/* 2026-11-15 Figma: the share card shows the trip type as a 3D icon; End trip text centred */
.trp-type-icon{position:relative;flex:none;width:112rpx;height:112rpx;border-radius:32rpx;background:#fdeee4;display:flex;align-items:center;justify-content:center}
.trp-type-icon::after{content:'';position:absolute;inset:-8rpx;border-radius:38rpx;border:4rpx solid #c2410c26;animation:var(--ue-animation,trp-pulse 2.4s ease-out infinite)}
.trp-type-icon image{width:76rpx;height:76rpx}
.trp-end{display:flex!important;align-items:center;justify-content:center;padding:0!important;line-height:1.2!important}
.page-dark .trp-type-icon{background:#3a2a20}

/* 2026-11-16: one customer's codes at one station sit together in the same plate */
.parcel-code-list{display:flex;flex-wrap:wrap;gap:14rpx}
.parcel-code.code-done{opacity:.45;text-decoration:line-through}

/* 2026-11-16: codes fill the plate in a tidy grid, no badge */
.pc-plate{display:block}
.pc-plate .parcel-code-copy{width:100%}
.pc-plate .parcel-code-list{display:grid;grid-template-columns:repeat(auto-fill,minmax(200rpx,1fr));gap:16rpx;margin-top:10rpx}
.pc-plate .parcel-code{display:flex!important;align-items:center;justify-content:center;width:auto!important;margin:0!important;box-sizing:border-box}
.pc-plate .parcel-code{white-space:nowrap}
.pc-plate .parcel-code.code-long{grid-column:1/-1;font-size:44rpx!important;letter-spacing:2rpx}

/* 2026-11-16: sized for real station codes like 11-1-9410 (two per row) */
.pc-plate .parcel-code-list{grid-template-columns:1fr 1fr;gap:14rpx}
.pc-plate .parcel-code{min-width:0;height:96rpx;padding:0 10rpx!important;font-size:40rpx!important;letter-spacing:0!important;font-variant-numeric:tabular-nums}
.pc-plate .parcel-code.code-long{font-size:40rpx!important}
/* 2026-11-16: a task join request shows only what the student needs; the runner already knows the route */
.of-detail{font-size:28rpx;font-weight:700;line-height:1.45;color:#16181c;overflow-wrap:anywhere}
.page-dark .of-detail{color:#edebe4}

/* 2026-11-16: accepted tasks, same family as the join request card but settled (green, no orange outline) */
.tk-wrap{margin:24rpx 0}
.tk-head{display:flex;align-items:center;gap:12rpx;margin-bottom:16rpx}
.tk-title{font-size:32rpx;font-weight:800;color:#16181c}
.tk-count{min-width:40rpx;height:40rpx;line-height:40rpx;padding:0 10rpx;border-radius:99rpx;background:#e3f3ea;color:#0b7a55;font-size:22rpx;font-weight:800;text-align:center;box-sizing:border-box}
.tk-card{margin-bottom:18rpx;padding:26rpx 26rpx 24rpx;border-radius:36rpx;background:#fff;box-shadow:0 8rpx 22rpx rgba(22,24,28,.06)}
.tk-icon{background:#e9f6ef}
.tk-pill{display:inline-block;margin-top:6rpx;padding:4rpx 14rpx;border-radius:99rpx;background:#fff4d6;color:#8a5a00;font-size:21rpx;font-weight:700}
.tk-delivered .tk-pill{background:#e8f0fe;color:#2856b8}
.tk-confirmed .tk-pill{background:#e3f3ea;color:#0b7a55}
.tk-reward{flex:none;font-size:36rpx;font-weight:800;color:#0b7a55;font-variant-numeric:tabular-nums}
.tk-who{display:flex;align-items:center;gap:16rpx;margin-top:18rpx}
.tk-name{flex:1;min-width:0;font-size:27rpx;font-weight:800;color:#16181c;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.tk-who .contact-actions{display:flex;gap:14rpx}
.tk-go{display:block;width:100%!important;height:88rpx;line-height:88rpx;margin:20rpx 0 0!important;padding:0;border-radius:26rpx;background:#0b7a55!important;color:#fff!important;font-size:28rpx;font-weight:800;box-shadow:0 6rpx 0 #08603f}
.tk-go.is-quiet{background:#f1f0eb!important;color:#2b2a26!important;box-shadow:none}
.tk-go::after{border:0}
.page-dark .tk-card{background:#252a28;box-shadow:none}
.page-dark .tk-title,.page-dark .tk-name{color:#edebe4}
.page-dark .tk-go.is-quiet{background:#333832!important;color:#edebe4!important}
/* 2026-11-17: delivery proof: Back on the left, Send on the right, one row */
.dl-actions{display:flex;gap:20rpx;margin-top:8rpx}
.dl-actions .btn{flex:1;min-width:0;margin:0!important;width:auto!important;white-space:nowrap;padding-left:12rpx;padding-right:12rpx}
.dl-actions .dl-send{flex:1.5}
/* 2026-11-17: grouped orders (same person, locker and destination): one card, one pick-up and one delivery photo; each order keeps its own cancel. */
/* 2026-11-18: grouped card reminds how many bags to take. */
.trip-group-remind{display:flex;align-items:center;gap:12rpx;margin:4rpx 0 16rpx;padding:16rpx 20rpx;border-radius:20rpx;background:#fff4e5;color:#9a4a00;font-size:25rpx;font-weight:800}
.trip-group-remind-icon{flex:none;display:flex;align-items:center;justify-content:center;width:38rpx;height:38rpx;border-radius:50%;background:#e8590c;color:#fff;font-size:26rpx;font-weight:900;line-height:1}
.page-dark .trip-group-remind{background:#3a2416;color:#f4a06e}

.delivery-proof{width:140rpx;height:140rpx;border-radius:16rpx;margin:10rpx 0;background:#eee}

.trip-share-btn{margin:12rpx 0 0;background:#fff;border:1rpx solid #dcd8cc;color:#2f6b4f;font-size:26rpx;line-height:2.2;border-radius:999rpx}
.trip-share-btn::after{border:0}

.trip-cancel-btn{background:#fff5f2;border-color:#f0c9bd;color:#a63b22}

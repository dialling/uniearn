@import "../../utils/order-pictures.wxss";
@import "../../utils/flow.wxss";

.trip-takeout{padding-bottom:calc(35rpx + env(safe-area-inset-bottom))}
.pickup-actions{display:flex;flex-direction:column;gap:14rpx;margin:24rpx 0 18rpx}
.pickup-actions .btn{width:100%;margin:0;min-height:82rpx;border-radius:20rpx;font-size:27rpx;box-sizing:border-box}
.pickup-actions .pickup-deliver{background:#0b7a55;color:#fff}
.pickup-actions .pickup-cancel{background:#f9eee7;color:#b45321;border:1rpx solid #efd9cb}
.pickup-actions .btn[disabled]{background:#eeede8;color:#95998f;border-color:transparent}
.page-dark .pickup-actions .pickup-cancel{background:#3c2c23;color:#f4b582;border-color:#614434}
.page-dark .pickup-actions .btn[disabled]{background:#343831;color:#8f9888}
.cancel-sheet .action-row{margin-top:22rpx}

.pickup-code-line{display:flex;align-items:center;justify-content:space-between;margin:10rpx 0;padding:14rpx 18rpx;border-radius:14rpx;background:#f3faf6;color:#0b7a55;font-size:24rpx}.pickup-code-value{font-weight:800;letter-spacing:3rpx;font-size:30rpx}.page-dark .pickup-code-line{background:#44423c;color:#6fd0a8}

.seal-report-row{gap:20rpx;margin:16rpx 0}.seal-report-description{flex:1;min-width:0}.seal-report-action,.seal-report-recorded{flex-shrink:0;white-space:nowrap}

.parcel-collect-card{padding:28rpx 28rpx 24rpx;border-color:#ebe7dd;box-shadow:0 8rpx 28rpx rgba(40,36,28,.06)}
.parcel-collect-card.is-done{opacity:.78}
.parcel-code-plate{display:flex;align-items:center;justify-content:space-between;gap:16rpx;background:#eef6f1;border-radius:22rpx;padding:20rpx 24rpx}
.parcel-code-copy{min-width:0}
.parcel-code-label{font-size:22rpx;color:#4f7a63;line-height:1.3}
.parcel-code{display:block;font-family:monospace;font-size:60rpx;font-weight:850;letter-spacing:4rpx;line-height:1.15;color:#1f2a24;word-break:break-all}
.parcel-box-badge{flex:none;background:#fff;color:#4f7a63;border-radius:999rpx;padding:8rpx 18rpx;font-size:22rpx;font-weight:600}
.is-done .parcel-code-plate{background:#f0efea}
.is-done .parcel-code-label,.is-done .parcel-box-badge{color:#8a877e}
.parcel-station-row{display:flex;align-items:center;gap:18rpx;margin:24rpx 0 4rpx}
.parcel-station-icon{flex:none;width:64rpx;height:64rpx;border-radius:20rpx;background:#f6f3ec;display:flex;align-items:center;justify-content:center}
.parcel-station-icon image{width:34rpx;height:34rpx}
.parcel-station-copy{min-width:0}
.parcel-station-label{font-size:22rpx;color:#8a877e;line-height:1.3}
.parcel-station{font-size:36rpx;font-weight:750;color:#2a2925;line-height:1.3;overflow-wrap:break-word}
.parcel-fragile{display:inline-block;margin:14rpx 0 0;padding:6rpx 16rpx;border-radius:999rpx;background:#fbefe6;color:#b45321;font-size:22rpx}
.parcel-contact{display:flex;align-items:center;justify-content:space-between;gap:16rpx;margin:20rpx 0 0;padding-top:20rpx;border-top:1rpx solid #efebe2}
.parcel-owner{font-size:28rpx;font-weight:650;color:#2a2925;line-height:1.35}
.parcel-room{font-size:24rpx;color:#7d7a72;line-height:1.4}
.parcel-contact .contact-actions{flex:none}
.parcel-memo{margin:20rpx 0 0;padding:18rpx 20rpx;border-radius:18rpx;background:#f7f4ed}
.parcel-memo-label{font-size:22rpx;color:#8a877e;margin-bottom:8rpx}
.parcel-note-text{font-size:27rpx;color:#3a3832;line-height:1.6;white-space:pre-wrap;overflow-wrap:break-word}
.parcel-picture-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12rpx;margin-top:14rpx}
.parcel-note-text+.parcel-picture-grid{margin-top:16rpx}
.parcel-memo-label+.parcel-picture-grid{margin-top:4rpx}
.parcel-picture{width:100%;height:190rpx;border-radius:14rpx;background:#ece8de}
.parcel-collect-card .pickup-actions{margin:24rpx 0 14rpx}
.parcel-cancel-hint{display:flex;align-items:center;justify-content:center;gap:8rpx;font-size:22rpx;color:#8a877e;line-height:1.5;text-align:center}
.parcel-cancel-hint image{flex:none;width:24rpx;height:24rpx;opacity:.7}
.page-dark .parcel-collect-card{border-color:#3a3b37}
.page-dark .parcel-code-plate{background:#2f3a33}
.page-dark .parcel-code-label,.page-dark .parcel-box-badge{color:#8fcfae}
.page-dark .parcel-code{color:#f3f0e8}
.page-dark .parcel-box-badge{background:#242522}
.page-dark .is-done .parcel-code-plate{background:#343831}
.page-dark .parcel-station-icon,.page-dark .parcel-memo{background:#2e2f2b}
.page-dark .parcel-station-icon image{opacity:.8}
.page-dark .parcel-station,.page-dark .parcel-owner,.page-dark .parcel-note-text{color:#f3f0e8}
.page-dark .parcel-station-label,.page-dark .parcel-room,.page-dark .parcel-memo-label,.page-dark .parcel-cancel-hint{color:#a8a59c}
.page-dark .parcel-contact{border-top-color:#3a3b37}
.page-dark .parcel-fragile{background:#3c2c23;color:#f4b582}
.page-dark .parcel-picture{background:#343831}

.missing-parcel-link{color:#c46524}
.nav-dark .missing-parcel-link,.dark .missing-parcel-link{color:#e8a06a}

.trip-page .contact-button{position:relative;overflow:visible}.trip-chat-dot{position:absolute;right:-2rpx;top:-2rpx;width:17rpx;height:17rpx;border:3rpx solid #fff;border-radius:50%;background:#fa5151;box-sizing:content-box;pointer-events:none}.page-dark .trip-chat-dot{border-color:#242522}

button.missing-parcel-link{display:block;width:100%;margin:0;padding:14rpx 0;min-height:72rpx;line-height:1.5;text-align:left;background:transparent;color:#c46524;font-size:28rpx;border-radius:0}button.missing-parcel-link::after{border:0}button.missing-parcel-link[disabled]{background:transparent;color:#999}

/* Pickup codes: wrap several codes as chips instead of a tall stacked list. */
.pickup-code-chips{display:flex;flex-wrap:wrap;gap:14rpx;margin-top:14rpx}
.pickup-code-chip{display:inline-flex;align-items:center;justify-content:center;min-width:132rpx;box-sizing:border-box;padding:12rpx 22rpx;border-radius:16rpx;background:#fff;border:2rpx solid #d9e5dc;color:#16181c;font-size:34rpx;font-weight:800;letter-spacing:4rpx;font-variant-numeric:tabular-nums;line-height:1.3}
.page-dark .pickup-code-chip{background:#242522;border-color:#3a3b37;color:#edebe4}

/* Delivery cards lead with where to go: address is the headline, customer below. */
.trip-card-address{font-size:34rpx;font-weight:800;color:#16181c;line-height:1.35}
.trip-card-owner{font-size:25rpx;color:#6b6860}
.page-dark .trip-card-address{color:#edebe4}

/* Take delivery photo matches the full-width "Picked up, go deliver" button. */
button.btn.delivery-photo-btn{display:flex;align-items:center;justify-content:center;gap:12rpx;width:100%!important;max-width:none;margin:24rpx 0 18rpx;min-height:82rpx;border-radius:20rpx;font-size:27rpx;box-sizing:border-box;background:#0b7a55;color:#fff}
.delivery-photo-icon{width:36rpx;height:36rpx;flex:none}
.trip-dropoff-detail{margin-top:4rpx;font-size:26rpx;color:#3f3d38;line-height:1.4;word-break:break-all}.trip-dropoff-how{margin:6rpx 0 0}.trip-runner-note-text{line-height:1.45;word-break:break-all;white-space:pre-wrap}.page-dark .trip-dropoff-detail{color:#c9c6bd}
.trip-icon-box{display:flex;align-items:center;gap:22rpx}.trip-box-icon{flex:none;width:80rpx;height:80rpx;padding:10rpx;box-sizing:border-box;border-radius:22rpx;background:#fff;box-shadow:0 4rpx 12rpx rgba(22,24,28,.07)}.trip-box-body{flex:1;min-width:0}.page-dark .trip-box-icon{background:#2b2d29;box-shadow:none}
.trip-page .contact-button.contact-3d{background:#fff;border:0;box-shadow:0 4rpx 12rpx rgba(22,24,28,.08),inset 0 0 0 1rpx rgba(22,24,28,.05)}.trip-page .contact-button.contact-3d image{width:46rpx;height:46rpx}.page-dark.trip-page .contact-button.contact-3d,.page-dark .trip-page .contact-button.contact-3d{background:#2b2d29!important}
.trip-box-icon.trip-box-icon-locker{padding:4rpx;margin-top:34rpx}
.parcel-code-copy .parcel-code{display:inline-block;margin-top:8rpx;padding:8rpx 28rpx;border:2rpx solid #dcdad3;border-radius:20rpx;background:#fff;box-shadow:0 4rpx 10rpx rgba(22,24,28,.06)}.page-dark .parcel-code-copy .parcel-code{background:#242522;border-color:#3a3b37}
.trip-card-head{align-items:center}.trip-card-head .contact-person{flex:1;min-width:0}.trip-card-who{min-width:0}.trip-card-who .trip-card-owner{margin:2rpx 0 0}.trip-card-status.is-paid{color:#0b7a55;font-weight:700}.page-dark .trip-card-status.is-paid{color:#6fd0a8}

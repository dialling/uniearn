<view style="{{motionStyle}}">
<lang-switch></lang-switch>
<!-- 2026-11-16: Yuni settings and help, opened from Me › Settings › Yuni -->
<view class="yn-page {{darkClass}}">
 <view class="yn-hero" hover-class="yn-press" bindtap="levels">
  <view class="yn-hero-copy">
   <view class="yn-name">Yuni</view>
   <view class="yn-sub">{{zh?'你在 Uniearn 的企鹅船长':'Your penguin captain on Uniearn'}}</view>
   <view class="yn-level"><text class="yn-level-no">Lv.{{levelNo}}</text><text>{{levelName}}</text></view>
   <view class="yn-next">{{nextText}} ›</view>
  </view>
  <view class="yn-portrait"><view class="yn-floe"/><image class="yn-yuni" src="{{avatar}}" mode="aspectFit"/></view>
 </view>

 <view class="yn-group">{{zh?'设置':'Settings'}}</view>
 <view class="yn-list">
  <view class="yn-row"><image class="yn-ico" src="/assets/yuni-play/i-sound.svg" mode="aspectFit"/><view class="yn-grow"><view class="yn-title">{{zh?'音效':'Sounds'}}</view><view class="yn-val">{{zh?'和 Yuni 玩时的音乐和音效':'Music and effects when you play with Yuni'}}</view></view><switch color="#0b7a55" checked="{{soundOn}}" bindchange="sound"/></view>
  <view class="yn-row"><image class="yn-ico" src="/assets/yuni-play/spin.svg" mode="aspectFit"/><view class="yn-grow"><view class="yn-title">{{zh?'提示和动画':'Tips and animations'}}</view><view class="yn-val">{{zh?'Yuni 弹出订单进度提示，页面上有动画':'Yuni pops up with order updates, and pages move'}}</view></view><switch color="#0b7a55" checked="{{tipsOn}}" bindchange="tips"/></view>
 </view>

 <view class="yn-group">{{zh?'帮助':'Help'}}</view>
 <view class="yn-list">
  <view class="yn-row" hover-class="yn-row-press" bindtap="yuniGuide"><image class="yn-ico" src="/assets/yuni-play/i-yuni.svg" mode="aspectFit"/><view class="yn-grow"><view class="yn-title">{{zh?'Yuni 新手引导':'Yuni guide'}}</view><view class="yn-val">{{zh?'Yuni 带你认识喂食、钓鱼、商店和升级':'A quick tour of feeding, fishing, the shop and levels'}}</view></view><view class="yn-chev"/></view>
  <view class="yn-row" hover-class="yn-row-press" bindtap="guide"><image class="yn-ico" src="/assets/yuni-play/i-help.svg" mode="aspectFit"/><view class="yn-grow"><view class="yn-title">{{zh?'重看新手引导':'Replay the app guide'}}</view><view class="yn-val">{{zh?'再看一遍接单大厅，以及发单和行程的小提示':'See the job hall tour and the posting and trip tips again'}}</view></view><view class="yn-chev"/></view>
  <view class="yn-row" hover-class="yn-row-press" bindtap="levels"><image class="yn-ico" src="/assets/yuni-play/book.svg" mode="aspectFit"/><view class="yn-grow"><view class="yn-title">{{zh?'等级和奖励':'Levels and rewards'}}</view><view class="yn-val">{{zh?'怎么赚积分，每级送什么装备':'How to earn points and the gear each level unlocks'}}</view></view><view class="yn-chev"/></view>
 </view>

 <view class="yn-group">{{zh?'怎么和 Yuni 玩':'How to play with Yuni'}}</view>
 <view class="yn-list yn-how">
  <view class="yn-row"><image class="yn-ico yn-ico-sm" src="/assets/yuni-play/five.svg" mode="aspectFit"/><view class="yn-grow"><view class="yn-title">{{zh?'陪 Yuni 玩一会儿':'Spend time with Yuni'}}</view><view class="yn-val">{{zh?'点一点 Yuni，和它一起放松一下。':'Tap Yuni and take a little break together.'}}</view></view></view>
  <view class="yn-row"><image class="yn-ico yn-ico-sm" src="/assets/yuni-play/rod.svg" mode="aspectFit"/><view class="yn-grow"><view class="yn-title">{{zh?'钓鱼':'Fishing'}}</view><view class="yn-val">{{zh?'先在商店购买鱼竿。浮标下沉后，点击让指针停在绿色区域，再快速连点 3 次，就能钓起鱼。钓鱼时还有机会获得优惠券。':'Buy a rod from the shop first. When the bobber dips, tap to stop the pointer in the green area, then tap quickly 3 times to land your fish. You may also catch a coupon.'}}</view></view></view>
  <view class="yn-row"><image class="yn-ico yn-ico-sm" src="/assets/yuni-feed/fish.png" mode="aspectFit"/><view class="yn-grow"><view class="yn-title">{{zh?'喂鱼得积分':'Feed for points'}}</view><view class="yn-val">{{zh?'把钓到的鱼喂给 Yuni，即可获得积分：普通鱼 2 积分、稀有鱼 5 积分、超稀有鱼 10 积分。':'Feed Yuni the fish you catch to earn points: 2 for a common fish, 5 for a rare fish and 10 for a super rare fish.'}}</view></view></view>
  <view class="yn-row"><image class="yn-ico yn-ico-sm" src="/assets/yuni-play/spin.svg" mode="aspectFit"/><view class="yn-grow"><view class="yn-title">{{zh?'一起互动':'Play together'}}</view><view class="yn-val">{{zh?'点击「击掌」「跳舞」或「转圈」，和 Yuni 互动。快速连点，还能触发连击效果。':'Tap High five, Dance or Spin to play with Yuni. Tap repeatedly to trigger combo effects.'}}</view></view></view>
  <view class="yn-row"><image class="yn-ico yn-ico-sm" src="/assets/yuni-play/shop.svg" mode="aspectFit"/><view class="yn-grow"><view class="yn-title">{{zh?'给 Yuni 换装':'Dress up Yuni'}}</view><view class="yn-val">{{zh?'在商店用积分购买服装、配饰和场景，搭配喜欢的造型。还可以购买海鹰伙伴，帮 Yuni 多抓一条鱼。':'Spend points on outfits, accessories and scenes to create your favorite look. You can also buy an eagle friend for a chance to catch an extra fish for Yuni.'}}</view></view></view>
 </view>
 <button class="yn-play" bindtap="play">{{zh?'去找 Yuni':'Visit Yuni'}}</button>
</view>
</view>

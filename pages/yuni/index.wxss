/* 2026-11-16: Yuni settings and help. Same rows as Me; the header echoes Yuni's stage (mint sky, ice floe). */
.yn-page{min-height:100vh;padding:24rpx 32rpx calc(60rpx + env(safe-area-inset-bottom));box-sizing:border-box;background:#eeede8}
.yn-hero{position:relative;overflow:hidden;display:flex;align-items:flex-end;gap:12rpx;min-height:300rpx;padding:34rpx 0 0 34rpx;border-radius:44rpx;background:linear-gradient(180deg,#d6f1e6 0%,#a9dcc7 72%,#0b7a55 72.2%,#0b7a55 100%)}
.yn-press{opacity:.92}
.yn-hero-copy{flex:1;min-width:0;align-self:flex-start}
.yn-name{font-size:56rpx;font-weight:900;line-height:1;color:#1c2a54;letter-spacing:-1rpx}
.yn-sub{margin-top:10rpx;font-size:24rpx;color:#2e4a5e}
.yn-level{display:inline-flex;align-items:center;gap:10rpx;margin-top:22rpx;padding:6rpx 18rpx 6rpx 6rpx;border-radius:99rpx;background:#fff;color:#1c2a54;font-size:24rpx;font-weight:800;box-shadow:0 4rpx 0 rgba(28,42,84,.12)}
.yn-level-no{padding:4rpx 12rpx;border-radius:99rpx;background:#f2b233;color:#1c2a54;font-size:21rpx;font-weight:900}
.yn-next{margin-top:12rpx;font-size:22rpx;font-weight:700;color:#0b5c40}
.yn-portrait{position:relative;flex:none;width:250rpx;height:260rpx}
.yn-floe{position:absolute;left:24rpx;right:10rpx;bottom:18rpx;height:44rpx;border-radius:50%;background:#f4fbff;box-shadow:inset 0 -8rpx 0 #cfe6ef}
.yn-yuni{position:absolute;left:20rpx;bottom:34rpx;width:220rpx;height:220rpx}
.yn-group{margin:40rpx 6rpx 16rpx;font-size:26rpx;font-weight:700;color:#6b6860}
.yn-list{background:#fff;border-radius:40rpx;overflow:hidden}
.yn-row{display:flex;align-items:center;gap:24rpx;padding:22rpx 28rpx;min-height:100rpx;box-sizing:border-box}
.yn-row+.yn-row{border-top:1rpx solid #f0eee8}
.yn-row-press{background:#f7f6f2}
.yn-ico{width:76rpx;height:76rpx;flex:none}
.yn-ico-sm{width:56rpx;height:56rpx;margin:0 10rpx}
.yn-how .yn-row{align-items:flex-start}
.yn-how .yn-ico-sm{margin-top:4rpx}
.yn-grow{flex:1;min-width:0}
.yn-title{font-size:29rpx;font-weight:650;color:#16181c}
.yn-val{margin-top:2rpx;font-size:25rpx;line-height:1.45;color:#6b6860}
.yn-row switch{transform:scale(.85);flex:none}
.yn-chev{width:15rpx;height:15rpx;border-right:4rpx solid #b9b6ab;border-top:4rpx solid #b9b6ab;transform:rotate(45deg);flex:none;margin-left:8rpx}
.yn-play{display:flex!important;align-items:center;justify-content:center;margin:36rpx 0 0!important;padding:0!important;width:100%!important;height:96rpx;line-height:1!important;border-radius:28rpx;background:#0b7a55;color:#fff;font-size:30rpx;font-weight:800;box-shadow:0 8rpx 0 #08603f}
.yn-play::after{border:0}
.page-dark.yn-page{background:#1b1d1a}
.page-dark .yn-list{background:#252a28}
.page-dark .yn-row+.yn-row{border-top-color:#333832}
.page-dark .yn-title{color:#edebe4}
.page-dark .yn-val,.page-dark .yn-group{color:#a9b0a6}
.page-dark .yn-hero{background:linear-gradient(180deg,#2c4d47 0%,#24423c 72%,#0b5c40 72.2%,#0b5c40 100%)}
.page-dark .yn-name{color:#eef2ff}
.page-dark .yn-sub{color:#c8d6d0}
.page-dark .yn-next{color:#9fe0c3}
/* the sea is a fixed strip at the bottom, so the text above always sits on the light sky */
.yn-hero{background:linear-gradient(180deg,#d6f1e6 0%,#a9dcc7 100%)}
.yn-hero::after{content:'';position:absolute;left:0;right:0;bottom:0;height:58rpx;background:#0b7a55}
.yn-hero-copy{position:relative;z-index:1;padding-bottom:84rpx}
.yn-portrait{z-index:1}
.page-dark .yn-hero{background:linear-gradient(180deg,#2c4d47 0%,#24423c 100%)}
.page-dark .yn-hero::after{background:#0b5c40}

@import "../../utils/post-form.wxss";
.route-editor{padding-top:24rpx;padding-bottom:70rpx}.editor-heading{margin:0 -30rpx 24rpx;padding:6rpx 30rpx 26rpx;background:transparent}.editor-title{font-size:36rpx;font-weight:750}.order-only{background:#fdf2f0;color:#8b1e2b;border-radius:20rpx;padding:22rpx;margin-bottom:22rpx}.destination-column{width:64%}.room-column{flex:1;min-width:0}.route-editor .field-label{margin-top:12rpx}.address-area{height:170rpx!important}.suggestions .pill{padding:10rpx 18rpx;min-height:50rpx}.cancel-button{background:transparent;color:#65645d;margin:22rpx auto;font-size:26rpx}.cancel-button::after,.wechat-number::after{border:0}.wechat-number{margin:8rpx 0 12rpx;padding:12rpx 20rpx;background:#f3faf3;border:1rpx solid #a6d8b4;color:#8b1e2b;border-radius:40rpx;font-size:23rpx;line-height:1.5;text-align:left}

.route-editor .phone-invalid{border:2rpx solid #b23a3a;box-shadow:0 0 0 4rpx #f7e6e4}.phone-error{font-size:24rpx;font-weight:650;color:#7a1a26;margin:12rpx 8rpx 18rpx}.phone-format-hint{margin:0 0 14rpx!important}

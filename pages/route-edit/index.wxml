<lang-switch/>
<view class="post-page route-editor">
 <view class="editor-heading"><view class="editor-title">{{title}}</view><view class="hint">{{subtitle}}</view></view>
 <view wx:if="{{mode==='order'}}" class="order-only">{{zh?'只修改这笔订单，你的常用路线保持不变。':'Only this order changes. Your saved route stays the same.'}}</view>
 <view class="flow-card">
  <block wx:if="{{form.destinationType==='place' && mode==='saved'}}"><view class="field-label">{{zh?'保存为':'Save as'}}</view><view class="pills"><text wx:for="{{names}}" wx:key="*this" class="pill {{form.name===item?'selected':''}}" data-field="name" data-value="{{item}}" bindtap="select">{{nameLabels[index]||item}}</text></view></block>
  <block wx:if="{{!parcel}}"><view class="field-label">{{zh?'取件点':'Collect from'}}</view><view class="pills"><text wx:for="{{stations}}" wx:key="*this" class="pill {{form.station===item?'selected':''}}" data-field="station" data-value="{{item}}" bindtap="select">{{item}}</text></view></block>
  <block wx:if="{{form.destinationType==='dorm'}}"><view class="row"><view class="destination-column"><view class="field-label">{{zh?'送到':'Deliver to'}}</view><picker range="{{dormLabels}}" value="{{dormIndex}}" disabled="{{routeLocked}}" bindchange="dorm"><view class="field">{{form.dorm||(zh?'选择楼栋':'Choose building')}}　⌄</view></picker></view><view class="room-column"><view class="field-label">{{zh?'房间号':'Room'}}</view><input class="field" value="{{form.room}}" data-field="room" bindinput="field" placeholder="{{zh?'房间号':'Room'}}" maxlength="100"/></view></view></block>
  <block wx:else><view class="field-label">{{zh?'送到哪里？请写具体位置':'Deliver to: where exactly?'}}</view><textarea class="field address-area" value="{{form.deliveryAddress}}" data-field="deliveryAddress" bindinput="field" maxlength="500" placeholder="{{zh?'例如：图书馆一楼前台':'e.g. Library, front desk on the ground floor'}}"/><view class="pills suggestions"><text wx:for="{{suggestions}}" wx:key="*this" class="pill" data-field="deliveryAddress" data-value="{{item}}" bindtap="select">{{item}}</text></view><view class="hint">{{zh?'跑手会在这里当面交给你，无需选择门口或大堂。':'The runner hands it to you there, so there’s no door or lobby to choose.'}}</view></block>
  <view class="field-label">{{zh?'配送备注（选填）':'Delivery instructions (optional)'}}</view><input class="field" value="{{form.deliveryNote}}" data-field="deliveryNote" bindinput="field" maxlength="500" placeholder="{{zh?'例如：放在前台':'e.g. leave at the desk'}}"/><view class="row"><view class="half"><view class="field-label">{{zh?'订单联系人':'Name on the order'}}</view><input class="field" value="{{form.owner}}" data-field="owner" bindinput="field" maxlength="60"/></view><view class="half"><view class="field-label">{{zh?'手机号':'Phone'}}</view><input class="field {{phoneError?'phone-invalid':''}}" type="number" value="{{form.phone}}" data-field="phone" bindinput="field" bindblur="phoneBlur" maxlength="11" placeholder="{{zh?'11 位手机号':'11-digit number'}}" focus="{{phoneFocus}}"/></view></view>
  <view wx:if="{{!phoneError}}" class="hint phone-format-hint">{{phoneHintLabel}}</view>
  <button wx:if="{{form.destinationType==='dorm' && wechatPhone}}" class="wechat-number" bindtap="usePhone">{{zh?'使用我的微信手机号':'Use my WeChat number'}}　{{wechatMask}}</button><button wx:elif="{{form.destinationType==='dorm'}}" class="wechat-number" open-type="getPhoneNumber" bindgetphonenumber="authorizePhone" loading="{{phoneBusy}}">{{zh?'使用我的微信手机号':'Use my WeChat number'}}</button>
  <block wx:if="{{form.destinationType==='dorm'}}"><view class="field-label">{{zh?'跑手到达后':'When the runner arrives'}}</view><view class="pills"><text class="pill {{form.dropMode==='door'?'selected':''}}" data-field="dropMode" data-value="door" bindtap="select">{{zh?'送到门口':'At my door'}}</text><text class="pill {{form.dropMode==='lobby'?'selected':''}}" data-field="dropMode" data-value="lobby" bindtap="select">{{zh?'大堂 · 我下楼取':'Lobby · I’ll come down'}}</text></view></block>
 </view><view wx:if="{{phoneError}}" class="phone-error">{{zh&&phoneError===phoneHint?phoneHintLabel:phoneError}}</view><button class="btn" bindtap="save" disabled="{{saving}}" loading="{{saving}}">{{zh?(mode==='order'?'用于这笔订单':parcel?'保存地址':'保存路线'):mode==='order'?'Use for this order':parcel?'Save address':'Save route'}}</button><button class="cancel-button" bindtap="cancel" disabled="{{saving}}">{{zh?'取消':'Cancel'}}</button>
</view><yuni-assistant topic=""/>

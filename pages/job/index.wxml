<view class="page"><view class="title">Choose pickups</view><view class="subtitle">Select only the items you can carry. View details before accepting.</view><view class="banner"><view class="route">{{route}}</view><view>Runner limit: {{limit===Infinity?'No limit':'¥'+limit+' this trip'}}</view></view><view class="section">Available pickups</view><block wx:for="{{parcels}}" wx:key="key"><view class="card"><view class="row"><view><view class="strong">{{item.owner}} · {{item.kind}} · {{item.index+1}}</view><view class="muted">Room {{item.room}} · by {{item.deadline}}</view></view><text class="money">¥{{item.reward}}</text></view><view class="muted" style="margin:15rpx 0">{{item.description}}</view><view class="row"><view class="chip green" data-key="{{item.key}}" bindtap="details">View details　›</view><view class="chip {{selected[item.key]?'green':''}}" data-key="{{item.key}}" bindtap="toggle">{{selected[item.key]?'✓ Selected':'○ Select'}}</view></view></view></block><view wx:if="{{!parcels.length}}" class="empty">These parcels have already been taken. Go back to Jobs.</view><view style="height:175rpx"/></view><view class="bottom"><view class="row" style="margin-bottom:12rpx"><text>{{count}} item(s) selected</text><text class="money">¥{{total}}</text></view><view wx:if="{{overLimit}}" class="link">Over your runner limit · deselect some boxes.</view><button class="btn {{count===0||overLimit?'disabled':''}}" disabled="{{count===0||overLimit}}" bindtap="accept">Confirm and take {{count}} item(s)</button></view>

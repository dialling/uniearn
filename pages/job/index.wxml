<view class="page"><view class="title">{{zh?'选择取件':'Choose pickups'}}</view><view class="subtitle">{{zh?'只选择你能带走的物品，接单前请先查看详情。':'Select only the items you can carry. View details before accepting.'}}</view><view class="banner"><view class="route">{{route}}</view><view>{{zh?'帮手额度：'+(limit===Infinity?'不限':'本趟 ¥'+limit):'Runner limit: '+(limit===Infinity?'No limit':'¥'+limit+' this trip')}}</view></view><view class="section">{{zh?'可取件':'Available pickups'}}</view><block wx:for="{{parcels}}" wx:key="key"><view class="card"><view class="row"><view><view class="strong">{{item.owner}} · {{item.kind}} · {{item.index+1}}</view><view class="muted">{{zh?'房间号 '+item.room+' · '+item.deadline+' 前':'Room '+item.room+' · by '+item.deadline}}</view></view><text class="money">¥{{item.reward}}</text></view><view class="muted" style="margin:15rpx 0">{{item.description}}</view><view class="row"><view class="chip green" data-key="{{item.key}}" bindtap="details">{{zh?'查看详情　›':'View details　›'}}</view><view class="chip {{selected[item.key]?'green':''}}" data-key="{{item.key}}" bindtap="toggle">{{selected[item.key]?(zh?'✓ 已选':'✓ Selected'):(zh?'○ 选择':'○ Select')}}</view></view></view></block><view wx:if="{{!parcels.length}}" class="empty">{{zh?'这些快递已被接走，请返回任务大厅。':'These parcels have already been taken. Go back to Jobs.'}}</view><view style="height:175rpx"/></view><view class="bottom"><view class="row" style="margin-bottom:12rpx"><text>{{zh?'已选 '+count+' 件':count+' item(s) selected'}}</text><text class="money">¥{{total}}</text></view><view wx:if="{{overLimit}}" class="link">{{zh?'超出你的帮手额度 · 请取消部分包裹。':'Over your runner limit · deselect some boxes.'}}</view><button class="btn {{count===0||overLimit?'disabled':''}}" disabled="{{count===0||overLimit}}" bindtap="accept">{{zh?'确认接取 '+count+' 件':'Confirm and take '+count+' item(s)'}}</button></view>
<yuni-assistant topic=""/>
page{background:#f2efe6;color:#15221d;overflow-x:hidden}
.levels-page{min-height:100vh;padding:34rpx 30rpx 70rpx;box-sizing:border-box;background:radial-gradient(circle at 82% 12%,#f7e7ad 0,transparent 30%),linear-gradient(180deg,#f4f0e4,#ebe8df)}
.levels-intro{padding:8rpx 10rpx 0;text-align:center}.eyebrow{font-size:20rpx;font-weight:800;letter-spacing:2rpx;color:#0b7a55}.intro-title{font-size:40rpx;line-height:1.2;font-weight:850;margin-top:8rpx}
.level-orbit{height:710rpx;margin:12rpx 0 0;position:relative;overflow:hidden}.orbit-line{position:absolute;left:34rpx;right:34rpx;top:150rpx;height:220rpx;border-top:3rpx solid #c9b878;border-radius:50%}
.orbit-level{position:absolute;z-index:4;width:142rpx;padding:8rpx 2rpx;display:flex;flex-direction:column;align-items:center;gap:7rpx;color:#7d796b;font-size:20rpx;font-weight:700;line-height:1.2;text-align:center;transition:color .2s,transform .2s}.orbit-dot{width:18rpx;height:18rpx;border-radius:50%;background:#d7ca96;box-shadow:0 0 0 0 #d5ad4c33;transition:background .2s,box-shadow .25s,transform .25s}.orbit-name{white-space:nowrap}.orbit-level.selected{color:#1b2822}.orbit-level.selected .orbit-dot{background:#c69123;box-shadow:0 0 0 12rpx #d5ad4c2e;transform:scale(1.16)}.orbit-level.is-current .orbit-name::after{content:' ·';color:#0b7a55}.orbit-press{opacity:.68}
.orbit-0{left:-8rpx;top:185rpx}.orbit-1{left:84rpx;top:94rpx}.orbit-2{left:50%;top:52rpx;transform:translateX(-50%)}.orbit-2.selected{transform:translateX(-50%) translateY(-4rpx)}.orbit-3{right:84rpx;top:94rpx}.orbit-4{right:-8rpx;top:185rpx}
.hero-motion{position:absolute;z-index:2;inset:0;transform:translate3d(var(--drag-x,0),var(--drag-y,0),0);transition:transform var(--arc-release,420ms) cubic-bezier(.16,1,.3,1);will-change:transform}.hero-motion.dragging{transition:none}
.mascot-aura{position:absolute;left:50%;top:218rpx;width:310rpx;height:310rpx;transform:translateX(-50%);border-radius:50%;background:radial-gradient(circle,#d2a64142,transparent 68%);transition:transform .35s}.mascot-aura view{position:absolute;inset:20rpx;border:2rpx solid #c99d393c;border-radius:50%;animation:aura-pulse 2.8s ease-in-out infinite}.mascot-aura view:nth-child(2){inset:54rpx;animation-delay:.35s}.mascot-aura view:nth-child(3){inset:88rpx;animation-delay:.7s}.mascot-aura.power-4,.mascot-aura.power-5{filter:saturate(1.2)}
.level-mascot{position:absolute;z-index:2;left:50%;top:226rpx;width:250rpx;height:270rpx;filter:drop-shadow(0 24rpx 24rpx #35403742);animation:mascot-power-in var(--arc-move,420ms) cubic-bezier(.2,1.35,.4,1) both,mascot-float 3.2s .5s ease-in-out infinite}.level-mascot.power-1{--power:.86}.level-mascot.power-2{--power:.92}.level-mascot.power-3{--power:1}.level-mascot.power-4{--power:1.08}.level-mascot.power-5{--power:1.15}
.current-label{position:absolute;left:0;right:0;top:512rpx;text-align:center;color:#7f7b70;font-size:20rpx}.level-title{position:absolute;left:0;right:0;top:548rpx;text-align:center;font-size:46rpx;line-height:1.2;font-weight:900}.level-kicker{position:absolute;left:0;right:0;top:610rpx;text-align:center;font-size:19rpx;letter-spacing:4rpx;color:#ad8127;font-weight:850}.current-chip{position:absolute;left:50%;top:652rpx;transform:translateX(-50%);padding:8rpx 18rpx;border-radius:999rpx;background:#e2efe8;color:#0b7a55;font-size:19rpx;font-weight:800}
.level-progress{display:flex;align-items:center;justify-content:space-between;gap:18rpx;margin:-4rpx 4rpx 22rpx;padding:22rpx 25rpx;border-radius:24rpx;background:#fffdf7;box-shadow:0 12rpx 34rpx #594b2520}.progress-label{color:#7d796f;font-size:19rpx;font-weight:750;letter-spacing:1rpx}.progress-condition{margin-top:6rpx;font-size:23rpx;font-weight:750;line-height:1.4}.progress-points{flex:none;display:flex;align-items:baseline;gap:5rpx;color:#a87720}.progress-points text:first-child{font-family:monospace;font-size:36rpx;font-weight:850}.progress-points text:last-child{font-size:17rpx;font-weight:800}
.content-section{padding:27rpx 24rpx 24rpx;border-radius:32rpx;background:#282820;color:#f5f0e4;box-shadow:0 24rpx 64rpx #3a321d38}.content-head{display:flex;align-items:center;justify-content:space-between;gap:20rpx}.content-title{font-size:33rpx;font-weight:850}.content-sub{margin-top:5rpx;color:#bbb7a7;font-size:20rpx}.level-chip{flex:none;padding:10rpx 16rpx;border-radius:18rpx;background:#45412f;color:#dfbd67;font-family:monospace;font-size:20rpx;font-weight:800}
.benefit-grid{display:grid;grid-template-columns:1fr 1fr;gap:16rpx;margin-top:22rpx}.benefit-card{min-height:172rpx;padding:20rpx;box-sizing:border-box;border-radius:24rpx;background:#37362d;display:flex;align-items:flex-start;gap:15rpx}.benefit-icon{width:58rpx;height:58rpx;flex:none;border-radius:19rpx;background:#4a4633;display:flex;align-items:center;justify-content:center}.benefit-icon image{width:34rpx;height:34rpx;filter:sepia(1) saturate(.65) brightness(1.18)}.benefit-title{font-size:23rpx;font-weight:850;line-height:1.3}.benefit-detail{margin-top:8rpx;color:#c5c0ae;font-size:20rpx;line-height:1.45}.source-note{text-align:center;color:#7a7d75;font-size:19rpx;line-height:1.5;margin:24rpx 18rpx 0}
.page-dark.levels-page{background:radial-gradient(circle at 82% 12%,#594716 0,transparent 30%),#101713;color:#edf4ef}.page-dark .level-progress{background:#1b2823;color:#edf4ef}.page-dark .orbit-level{color:#9aa89f}.page-dark .orbit-level.selected{color:#edf4ef}.page-dark .orbit-line{border-color:#76652c}.page-dark .progress-condition{color:#edf4ef}.page-dark .source-note{color:#87948c}
@keyframes mascot-power-in{0%{opacity:.2;transform:translateX(-50%) scale(.66) translateY(24rpx)}65%{opacity:1;transform:translateX(-50%) scale(calc(var(--power) + .08)) translateY(-8rpx)}100%{opacity:1;transform:translateX(-50%) scale(var(--power)) translateY(0)}}
@keyframes mascot-float{0%,100%{transform:translateX(-50%) scale(var(--power)) translateY(0) rotate(-1deg)}50%{transform:translateX(-50%) scale(var(--power)) translateY(-10rpx) rotate(1deg)}}
@keyframes aura-pulse{0%,100%{transform:scale(.94);opacity:.35}50%{transform:scale(1.06);opacity:.8}}

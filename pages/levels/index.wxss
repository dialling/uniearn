page{background:#f2efe6;color:#15221d;overflow-x:hidden}
.levels-page{min-height:100vh;padding:34rpx 30rpx 70rpx;box-sizing:border-box;background:radial-gradient(circle at 82% 12%,#f7e7ad 0,transparent 30%),linear-gradient(180deg,#f4f0e4,#ebe8df)}
.levels-intro{padding:8rpx 10rpx 0;text-align:center}.eyebrow{font-size:20rpx;font-weight:800;letter-spacing:2rpx;color:#0b7a55}.intro-title{font-size:40rpx;line-height:1.2;font-weight:850;margin-top:8rpx}
.level-orbit{height:710rpx;margin:12rpx 0 0;position:relative;overflow:hidden}.orbit-line{position:absolute;left:34rpx;right:34rpx;top:150rpx;height:220rpx;border-top:3rpx solid #c9b878;border-radius:50%}
.orbit-level{position:absolute;z-index:4;width:142rpx;padding:8rpx 2rpx;display:flex;flex-direction:column;align-items:center;gap:7rpx;color:#7d796b;font-size:20rpx;font-weight:700;line-height:1.2;text-align:center;transition:var(--ue-transition,color .2s,transform .2s)}.orbit-dot{width:18rpx;height:18rpx;border-radius:50%;background:#d7ca96;box-shadow:0 0 0 0 #d5ad4c33;transition:var(--ue-transition,background .2s,box-shadow .25s,transform .25s)}.orbit-name{white-space:nowrap}.orbit-level.selected{color:#1b2822}.orbit-level.selected .orbit-dot{background:#c69123;box-shadow:0 0 0 12rpx #d5ad4c2e;transform:scale(1.16)}.orbit-level.is-current .orbit-name::after{content:' ·';color:#0b7a55}.orbit-press{opacity:.68}
.orbit-0{left:-8rpx;top:185rpx}.orbit-1{left:84rpx;top:94rpx}.orbit-2{left:50%;top:52rpx;transform:translateX(-50%)}.orbit-2.selected{transform:translateX(-50%) translateY(-4rpx)}.orbit-3{right:84rpx;top:94rpx}.orbit-4{right:-8rpx;top:185rpx}
.hero-motion{position:absolute;z-index:2;inset:0;transform:translate3d(var(--drag-x,0),var(--drag-y,0),0);transition:var(--ue-transition,transform var(--arc-release,420ms) cubic-bezier(.16,1,.3,1));will-change:transform}.hero-motion.dragging{transition:var(--ue-transition,none)}
.mascot-aura{position:absolute;left:50%;top:218rpx;width:310rpx;height:310rpx;transform:translateX(-50%);border-radius:50%;background:radial-gradient(circle,#d2a64142,transparent 68%);transition:var(--ue-transition,transform .35s)}.mascot-aura view{position:absolute;inset:20rpx;border:2rpx solid #c99d393c;border-radius:50%;animation:var(--ue-animation,aura-pulse 2.8s ease-in-out infinite)}.mascot-aura view:nth-child(2){inset:54rpx;animation-delay:.35s}.mascot-aura view:nth-child(3){inset:88rpx;animation-delay:.7s}.mascot-aura.power-4,.mascot-aura.power-5{filter:saturate(1.2)}
.level-mascot{position:absolute;z-index:2;left:50%;top:200rpx;width:340rpx;height:280rpx;transform:translateX(-50%);filter:drop-shadow(0 12rpx 16rpx #35403724);animation:var(--ue-animation,mascot-power-in var(--arc-move,420ms) cubic-bezier(.2,1.35,.4,1) both,mascot-float 3.2s .5s ease-in-out infinite)}.level-mascot.power-1{--power:.86}.level-mascot.power-2{--power:.92}.level-mascot.power-3{--power:1}.level-mascot.power-4{--power:1.08}.level-mascot.power-5{--power:1.15}
.current-label{position:absolute;left:22rpx;right:22rpx;top:512rpx;text-align:center;color:#7f7b70;font-size:21rpx;line-height:1.4}.level-title{position:absolute;left:0;right:0;top:548rpx;text-align:center;font-size:46rpx;line-height:1.2;font-weight:900}.level-kicker{position:absolute;left:0;right:0;top:610rpx;text-align:center;font-size:19rpx;letter-spacing:4rpx;color:#ad8127;font-weight:850}.current-chip{position:absolute;left:50%;top:652rpx;transform:translateX(-50%);padding:8rpx 18rpx;border-radius:999rpx;background:#e2efe8;color:#0b7a55;font-size:19rpx;font-weight:800}
.level-progress{display:flex;align-items:center;justify-content:space-between;gap:18rpx;margin:-4rpx 4rpx 22rpx;padding:22rpx 25rpx;border-radius:24rpx;background:#fffdf7;box-shadow:0 12rpx 34rpx #594b2520}.progress-label{color:#7d796f;font-size:19rpx;font-weight:750;letter-spacing:1rpx}.progress-condition{margin-top:6rpx;font-size:23rpx;font-weight:750;line-height:1.4}.progress-points{flex:none;display:flex;align-items:baseline;gap:5rpx;color:#a87720}.progress-points text:first-child{font-family:monospace;font-size:36rpx;font-weight:850}.progress-points text:last-child{font-size:17rpx;font-weight:800}
.content-section{padding:27rpx 24rpx 24rpx;border-radius:32rpx;background:#192b46;color:#f5f0e4;box-shadow:0 24rpx 64rpx #3a321d38}.content-head{display:flex;align-items:center;justify-content:space-between;gap:20rpx}.content-title{font-size:33rpx;font-weight:850}.content-sub{margin-top:5rpx;color:#bbb7a7;font-size:20rpx}.level-chip{flex:none;padding:10rpx 16rpx;border-radius:18rpx;background:#34415a;color:#dfbd67;font-family:monospace;font-size:20rpx;font-weight:800}
.benefit-grid{display:grid;grid-template-columns:1fr 1fr;gap:16rpx;margin-top:22rpx}.benefit-card{min-height:172rpx;padding:20rpx;box-sizing:border-box;border-radius:24rpx;background:#243952;display:flex;align-items:flex-start;gap:15rpx}.benefit-icon{width:58rpx;height:58rpx;flex:none;border-radius:19rpx;background:#4a4633;display:flex;align-items:center;justify-content:center}.benefit-icon image{width:34rpx;height:34rpx;filter:sepia(1) saturate(.65) brightness(1.18)}.benefit-title{font-size:23rpx;font-weight:850;line-height:1.3}.benefit-detail{margin-top:8rpx;color:#c5c0ae;font-size:20rpx;line-height:1.45}.source-note{text-align:center;color:#7a7d75;font-size:19rpx;line-height:1.5;margin:24rpx 18rpx 0}
.page-dark.levels-page{background:radial-gradient(circle at 82% 12%,#594716 0,transparent 30%),#101713;color:#edf4ef}.page-dark .level-progress{background:#1b2823;color:#edf4ef}.page-dark .orbit-level{color:#9aa89f}.page-dark .orbit-level.selected{color:#edf4ef}.page-dark .orbit-line{border-color:#76652c}.page-dark .progress-condition{color:#edf4ef}.page-dark .source-note{color:#87948c}
@keyframes mascot-power-in{0%{opacity:.2;transform:translateX(-50%) scale(.66) translateY(24rpx)}65%{opacity:1;transform:translateX(-50%) scale(calc(var(--power) + .08)) translateY(-8rpx)}100%{opacity:1;transform:translateX(-50%) scale(var(--power)) translateY(0)}}
@keyframes mascot-float{0%,100%{transform:translateX(-50%) scale(var(--power)) translateY(0) rotate(-1deg)}50%{transform:translateX(-50%) scale(var(--power)) translateY(-10rpx) rotate(1deg)}}
@keyframes aura-pulse{0%,100%{transform:scale(.94);opacity:.35}50%{transform:scale(1.06);opacity:.8}}

/* Tap response stays on its own layer so floating and arc dragging keep working. */
.mascot-tap-layer{position:absolute;inset:0;pointer-events:none}
.mascot-tap-layer .level-mascot{pointer-events:auto}
.mascot-jumping{animation:var(--ue-animation,mascot-tap-hop 600ms cubic-bezier(.22,.68,.35,1) both)}
@keyframes mascot-tap-hop{0%,100%{transform:translateY(0) scale(1)}12%{transform:translateY(5rpx) scale(1.025,.96)}42%{transform:translateY(-58rpx) scale(.98,1.03)}68%{transform:translateY(0) scale(1.035,.96)}84%{transform:translateY(-10rpx) scale(1)}}
@media(prefers-reduced-motion:reduce){.mascot-jumping{animation:var(--ue-animation,none)}}

.points-section{margin:24rpx 4rpx;padding:28rpx 24rpx;background:#fffdf7;border-radius:26rpx;color:#192d29}
.points-heading{font-size:32rpx;font-weight:800}.points-subtitle{font-size:22rpx;line-height:1.6;color:#7b8178;margin-top:8rpx}
.points-task{display:flex;align-items:flex-start;gap:24rpx;padding:24rpx 0;border-bottom:1rpx solid #ecebe3}
.points-task-copy{flex:1;min-width:0}.points-task-title{font-size:26rpx;font-weight:750;line-height:1.5}.points-task-detail{font-size:23rpx;line-height:1.6;color:#7b8178;margin-top:8rpx}.points-task-first{font-size:21rpx;line-height:1.5;color:#52755d;margin-top:7rpx}
.points-task-reward{display:flex;flex-direction:column;align-items:flex-end;flex:none;min-width:72rpx;color:#52755d;padding-top:4rpx}.points-task-reward text:first-child{font-size:34rpx;line-height:1.1;font-weight:800}.points-task-reward text:last-child{font-size:20rpx;color:#7b8178;margin-top:5rpx}
.points-footnote,.points-sync-note{font-size:22rpx;line-height:1.6;color:#7b8178;margin-top:20rpx}
.page-dark .points-section{background:#1b2823;color:#edf4ef}.page-dark .points-task{border-color:#33423a}.page-dark .points-subtitle,.page-dark .points-task-detail,.page-dark .points-footnote,.page-dark .points-task-reward text:last-child,.page-dark .points-sync-note{color:#a1b1a7}.page-dark .points-task-reward,.page-dark .points-task-first{color:#98c8a6}

.level-checkin{margin:28rpx 4rpx 12rpx;padding:26rpx 24rpx;border-radius:26rpx;background:#fffdf7;border:1rpx solid #e7e6da}.checkin-heading{display:flex;align-items:center;justify-content:space-between;gap:14rpx}.checkin-title{font-size:29rpx;font-weight:800}.checkin-streak{font-size:21rpx;color:#7b8178;margin-top:6rpx}.checkin-streak text{font-weight:850;font-size:29rpx;color:#41775b;margin:0 5rpx}.checkin-status{max-width:240rpx;font-size:19rpx;line-height:1.5;color:#7b8178;text-align:right}.checkin-status.checked{background:#e6f0e6;color:#41775b;padding:8rpx 14rpx;border-radius:999rpx}.checkin-days{display:flex;gap:9rpx;margin-top:25rpx}.checkin-day{flex:1;min-width:0;text-align:center}.checkin-day-mark{height:64rpx;border-radius:17rpx;display:flex;align-items:center;justify-content:center;background:#efeee6;color:#a3a595;font-size:24rpx;font-weight:800}.checkin-day.done .checkin-day-mark{background:#e3edde;color:#52775d}.checkin-day.today .checkin-day-mark{background:#41775b;color:#fff}.checkin-day-label{font-size:17rpx;color:#8b8f81;margin-top:8rpx;white-space:nowrap}.checkin-hint{font-size:21rpx;color:#697b62;line-height:1.6;margin-top:21rpx}.checkin-total{font-size:19rpx;color:#929487;margin-top:7rpx}.page-dark .level-checkin{background:#1b2823;border-color:#33423a}.page-dark .checkin-title{color:#edf4ef}.page-dark .checkin-streak,.page-dark .checkin-status,.page-dark .checkin-total,.page-dark .checkin-day-label{color:#a1b1a7}.page-dark .checkin-status.checked,.page-dark .checkin-day.done .checkin-day-mark{background:#293e30;color:#a2c9a9}.page-dark .checkin-day-mark{background:#28312a;color:#7a8b7e}.page-dark .checkin-day.today .checkin-day-mark{background:#41775b;color:#fff}.page-dark .checkin-streak text,.page-dark .checkin-hint{color:#98c8a6}
.checkin-day-mark{position:relative}.checkin-day-fish{display:block;width:46rpx;height:25rpx}.checkin-day-bonus{position:absolute;bottom:0;right:3rpx;font-size:15rpx;line-height:1.2;color:#805e26}.checkin-day.bonus-day:not(.today) .checkin-day-mark{background:#f7eed7}.checkin-day.today .checkin-day-bonus{color:#fff}.checkin-card-foot{display:flex;align-items:center;justify-content:space-between;gap:12rpx}.checkin-open-feed{display:flex;align-items:center;min-height:44px;font-size:23rpx;font-weight:700;color:#41694e;white-space:nowrap}.checkin-card-pressed{opacity:.85}.page-dark .checkin-open-feed{color:#a2c9a9}.page-dark .checkin-day.bonus-day:not(.today) .checkin-day-mark{background:#453d27}.page-dark .checkin-day-bonus{color:#e4c680}

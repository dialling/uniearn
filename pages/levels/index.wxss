/* 2026-11-16 redesign: Yuni's voyage. Sea-foam page, a navy captain's log, gold buoys on a dotted sea route. */
page{background:#e7f3ed;color:#16181c;overflow-x:hidden}
.lv-page{min-height:100vh;padding:28rpx 30rpx calc(60rpx + env(safe-area-inset-bottom));box-sizing:border-box;background:linear-gradient(180deg,#d9efe4 0%,#e7f3ed 340rpx,#eef5f1 100%)}
.lv-press{opacity:.94}

/* captain's log */
.lv-log{position:relative;overflow:hidden;padding:30rpx 30rpx 28rpx;border-radius:40rpx;background:linear-gradient(160deg,#25386b 0%,#1c2a54 60%,#152043 100%);color:#fff;box-shadow:0 14rpx 0 rgba(28,42,84,.18)}
.lv-log::after{content:'';position:absolute;left:-10%;right:-10%;bottom:-40rpx;height:90rpx;border-radius:50%;background:rgba(127,224,176,.12)}
.lv-log-top{position:relative;z-index:1;display:flex;align-items:center;gap:24rpx}
.lv-buoy{flex:none;width:176rpx;height:176rpx;border-radius:50%;background:radial-gradient(circle at 40% 35%,#fff6d6 0%,#ffe08a 55%,#f2b233 100%);box-shadow:0 0 0 8rpx rgba(255,224,138,.25),inset 0 -8rpx 0 rgba(122,78,0,.18);display:flex;align-items:center;justify-content:center}
.lv-buoy-yuni{width:160rpx;height:160rpx;margin-top:-12rpx}
.lv-buoy.is-hop .lv-buoy-yuni{animation:var(--ue-animation,lv-hop .6s cubic-bezier(.22,.68,.35,1))}
@keyframes lv-hop{0%,100%{transform:translateY(0)}40%{transform:translateY(-34rpx) scale(.97,1.04)}70%{transform:translateY(0) scale(1.04,.96)}}
.lv-log-copy{flex:1;min-width:0}
.lv-log-level{display:inline-block;padding:4rpx 16rpx;border-radius:99rpx;background:#f2b233;color:#1c2a54;font-size:22rpx;font-weight:900}
.lv-log-name{margin-top:10rpx;font-size:44rpx;font-weight:900;line-height:1.15;letter-spacing:-.5rpx}
.lv-log-pts{margin-top:6rpx;font-size:24rpx;color:#c8d3ef}
.lv-log-num{font-size:34rpx;font-weight:900;color:#ffe08a;font-variant-numeric:tabular-nums}
.lv-rail{position:relative;z-index:1;margin-top:28rpx;height:22rpx;border-radius:99rpx;background:rgba(255,255,255,.14)}
.lv-rail-fill{position:relative;height:100%;border-radius:99rpx;background:linear-gradient(90deg,#7fe0b0,#2fbf83)}
.lv-rail-boat{position:absolute;right:-16rpx;top:50%;width:32rpx;height:32rpx;margin-top:-16rpx;border-radius:50%;background:#fff;box-shadow:0 0 0 6rpx rgba(255,255,255,.25)}
.lv-rail-text{position:relative;z-index:1;margin-top:14rpx;font-size:24rpx;font-weight:700;color:#dfe7fb}

/* Feed Yuni */
.lv-feed{margin-top:24rpx;padding:26rpx 26rpx 22rpx;border-radius:36rpx;background:#fff}
.lv-feed-head{display:flex;align-items:baseline;justify-content:space-between}
.lv-feed-title{font-size:31rpx;font-weight:800;color:#16181c}
.lv-feed-streak{font-size:23rpx;color:#6b6860}
.lv-feed-num{font-size:34rpx;font-weight:900;color:#0b7a55;font-variant-numeric:tabular-nums}
.lv-days{display:flex;justify-content:space-between;gap:8rpx;margin-top:20rpx}
.lv-day{flex:1;display:flex;flex-direction:column;align-items:center;gap:8rpx}
.lv-day-token{position:relative;width:100%;height:76rpx;border-radius:20rpx;background:#f2f1ec;display:flex;align-items:center;justify-content:center}
.lv-day-fish{width:62rpx;height:40rpx}
.lv-day.is-done .lv-day-token{background:#e3f3ea}
.lv-day.is-today .lv-day-token{background:#0b7a55;box-shadow:0 6rpx 0 #08603f}
.lv-day.is-bonus .lv-day-token{background:#fff4d6;box-shadow:inset 0 0 0 3rpx #f2c95c}
.lv-day.is-bonus.is-done .lv-day-token{background:#ffe08a}
.lv-day-bonus{position:absolute;right:6rpx;bottom:2rpx;font-size:17rpx;font-weight:900;color:#8a5a00}
.lv-day-label{font-size:20rpx;font-weight:700;color:#8a877e;font-variant-numeric:tabular-nums}
.lv-day.is-today .lv-day-label{color:#0b7a55}
.lv-feed-foot{display:flex;align-items:center;justify-content:space-between;gap:16rpx;margin-top:18rpx}
.lv-feed-hint{flex:1;min-width:0;font-size:22rpx;line-height:1.45;color:#6b6860}
.lv-feed-go{flex:none;padding:12rpx 26rpx;border-radius:99rpx;background:#0b7a55;color:#fff;font-size:24rpx;font-weight:800;box-shadow:0 5rpx 0 #08603f}

/* the voyage */
.lv-voyage-head{margin:40rpx 6rpx 16rpx;font-size:32rpx;font-weight:900;color:#1c2a54}
.lv-voyage{position:relative}
.lv-stop{display:flex;gap:18rpx}
.lv-stop-rail{position:relative;flex:none;width:44rpx;display:flex;justify-content:center}
.lv-stop-rail::before{content:'';position:absolute;top:0;bottom:0;left:50%;margin-left:-2rpx;border-left:4rpx dashed #9fc7b4}
.lv-stop:first-child .lv-stop-rail::before{top:50rpx}
.lv-stop:last-child .lv-stop-rail::before{bottom:auto;height:50rpx}
.lv-stop.is-reached .lv-stop-rail::before{border-left-style:solid;border-left-color:#f2b233}
.lv-stop-buoy{position:relative;z-index:1;margin-top:34rpx;width:32rpx;height:32rpx;border-radius:50%;box-sizing:border-box;background:#fff;border:4rpx solid #b9c7bf}
.lv-stop.is-reached .lv-stop-buoy{background:#f2b233;border-color:#f2b233}
.lv-stop.is-here .lv-stop-buoy{width:40rpx;height:40rpx;margin-top:30rpx;border:6rpx solid #0b7a55;box-shadow:0 0 0 0 rgba(11,122,85,.4);animation:var(--ue-animation,lv-ping 2s ease-out infinite)}
@keyframes lv-ping{0%{box-shadow:0 0 0 0 rgba(11,122,85,.45)}100%{box-shadow:0 0 0 22rpx rgba(11,122,85,0)}}
.lv-tick{position:absolute;left:50%;top:44%;width:10rpx;height:16rpx;border:solid #fff;border-width:0 4rpx 4rpx 0;transform:translate(-50%,-50%) rotate(45deg)}
.lv-stop-card{flex:1;min-width:0;margin-bottom:18rpx;padding:18rpx 22rpx;border-radius:30rpx;background:#fff}
.lv-stop.is-here .lv-stop-card{box-shadow:0 0 0 4rpx #0b7a55}
.lv-stop.is-ahead .lv-stop-card{background:rgba(255,255,255,.62)}
.lv-stop-top{display:flex;align-items:center;gap:16rpx}
.lv-stop-yuni{flex:none;width:84rpx;height:84rpx}
.lv-stop.is-ahead .lv-stop-yuni{filter:grayscale(.6);opacity:.65}
.lv-stop-copy{flex:1;min-width:0}
.lv-stop-name{font-size:28rpx;font-weight:800;color:#16181c}
.lv-stop-need{margin-top:2rpx;font-size:22rpx;color:#6b6860}
.lv-stop-tag{flex:none;padding:6rpx 14rpx;border-radius:99rpx;background:#f2f1ec;color:#6b6860;font-size:20rpx;font-weight:800}
.lv-stop.is-reached .lv-stop-tag{background:#fff4d6;color:#8a5a00}
.lv-stop.is-here .lv-stop-tag{background:#0b7a55;color:#fff}
.lv-stop-more{margin-top:16rpx;padding-top:16rpx;border-top:2rpx solid #f0eee8}
.lv-stop-action{font-size:24rpx;font-weight:700;color:#1c2a54}
.lv-gear-title{margin-top:14rpx;font-size:21rpx;font-weight:700;color:#8a877e}
.lv-gear{display:flex;flex-wrap:wrap;gap:12rpx;margin-top:10rpx}
.lv-gear-chip{display:flex;align-items:center;gap:10rpx;padding:8rpx 16rpx 8rpx 8rpx;border-radius:99rpx;background:#eef6f2;font-size:22rpx;font-weight:700;color:#16181c}
.lv-gear-img{width:52rpx;height:40rpx}

/* how to earn */
.lv-earn{margin-top:28rpx;padding:26rpx 26rpx 20rpx;border-radius:36rpx;background:#fff}
.lv-earn-head{font-size:30rpx;font-weight:800;color:#16181c}
.lv-earn-note{margin-top:10rpx;font-size:22rpx;color:#b4501f}
.lv-earn-row{display:flex;align-items:flex-start;gap:20rpx;padding:20rpx 0;border-bottom:2rpx solid #f0eee8}
.lv-earn-copy{flex:1;min-width:0}
.lv-earn-title{font-size:26rpx;font-weight:750;color:#16181c;line-height:1.45}
.lv-earn-detail{margin-top:4rpx;font-size:22rpx;line-height:1.5;color:#6b6860}
.lv-earn-first{display:inline-block;margin-top:8rpx;padding:2rpx 12rpx;border-radius:99rpx;background:#fff4d6;color:#8a5a00;font-size:20rpx;font-weight:700}
.lv-earn-pts{flex:none;display:flex;align-items:center;justify-content:center;gap:6rpx;min-width:84rpx;padding:6rpx 14rpx;border-radius:99rpx;background:#e3f3ea;color:#0b7a55;font-size:26rpx;font-weight:900;text-align:center;font-variant-numeric:tabular-nums}
.lv-earn-foot{margin-top:14rpx;font-size:21rpx;line-height:1.55;color:#8a877e}

/* dark */
.page-dark.lv-page{background:#141a17;color:#edf4ef}
.page-dark .lv-feed,.page-dark .lv-stop-card,.page-dark .lv-earn{background:#1f2622}
.page-dark .lv-stop.is-ahead .lv-stop-card{background:#1a201d}
.page-dark .lv-feed-title,.page-dark .lv-stop-name,.page-dark .lv-earn-title{color:#edf4ef}
.page-dark .lv-voyage-head,.page-dark .lv-stop-action{color:#c8d3ef}
.page-dark .lv-day-token,.page-dark .lv-stop-tag{background:#2a322d}
.page-dark .lv-gear-chip{background:#26302b;color:#edf4ef}
.page-dark .lv-stop-more,.page-dark .lv-earn-row{border-color:#2c342f}
@media(prefers-reduced-motion:reduce){.lv-stop.is-here .lv-stop-buoy,.lv-buoy.is-hop .lv-buoy-yuni{animation:var(--ue-animation,none)}}
/* 2026-11-17: these points come as a fish to feed Yuni */
.lv-earn-side{flex:none;display:flex;flex-direction:column;align-items:flex-end;gap:8rpx}
.lv-earn-pts{gap:0}
.lv-earn-unit{margin-left:4rpx;font-size:20rpx;font-weight:800}
.lv-earn-catch{display:flex;align-items:center;gap:2rpx;color:#8a5a00;font-size:20rpx;font-weight:800;white-space:nowrap}
.lv-earn-catch text{margin-left:6rpx}
.lv-earn-fish{width:28rpx;height:18rpx;flex:none}
.lv-earn-first{line-height:1.45;border-radius:14rpx}
.page-dark .lv-earn-catch{color:#f2c46b}

<view class="flow-page trip-start-page"><view class="flow-title">Start a trip</view><view class="flow-sub">Bring other people’s {{category==='takeout'?'takeaway':'parcels'}} on your way back.</view><view class="preview-label">Team test · share this trip so students can join your route</view>
<view class="strong">What are you picking up?</view><view class="choices"><view class="choice-box {{category==='takeout'?'selected':''}}" data-value="takeout" bindtap="changeCategory"><view class="strong">Takeaway</view><view class="hint">Food at the gate</view></view><view class="choice-box {{category==='parcel'?'selected':''}}" data-value="parcel" bindtap="changeCategory"><view class="strong">Parcels</view><view class="hint">from a station</view></view></view>
<view class="strong">When are you going?</view><view class="choices"><view class="choice-box {{when==='now'?'selected':''}}" data-field="when" data-value="now" bindtap="select"><view class="strong">Now</view><view class="hint">I’m at the pickup point</view></view><view class="choice-box {{when==='later'?'selected':''}}" data-field="when" data-value="later" bindtap="select"><view class="strong">Later today</view><view class="hint">Pick a time</view></view></view>
<view class="flow-card" wx:if="{{when==='now'}}"><view class="strong">Others can join for</view><view class="pills"><text wx:for="{{durations}}" wx:key="*this" class="pill dark {{duration==item?'selected':''}}" data-field="duration" data-value="{{item}}" bindtap="select">{{item}} min</text></view></view>
<view class="flow-card" wx:else><view class="strong">Time today</view><picker mode="time" value="{{time}}" data-field="time" bindchange="text"><view class="field center amount">{{time}} ⌄</view></picker><view class="hint">People can join until {{joinLabel}}, 10 minutes before you go.</view><view class="hint">Reminder time: {{remindLabel}}. Push reminders are not connected in this preview.</view></view>
<view class="gate-label">{{category==='takeout'?'Gate':'Station'}}</view><view class="gate-cards"><view wx:for="{{stations}}" wx:key="*this" class="gate-card {{station===item?'selected':''}}" data-field="station" data-value="{{item}}" bindtap="select"><view class="strong">{{item}}</view><view class="hint">{{stationHints[index]||'Pickup point'}}</view></view></view>
<view class="flow-card trip-destination"><view class="destination-copy"><view class="hint">Going back to</view><view wx:if="{{profileDorm && dorm===profileDorm}}" class="strong">{{dorm}} · your dorm</view><input wx:else class="dorm-input" value="{{dorm}}" placeholder="Your dorm / building" data-field="dorm" bindinput="text"/></view><view class="capacity-control"><button data-delta="-1" bindtap="changeCapacity">−</button><view class="capacity-number"><text>{{capacity}}</text><view>{{category==='takeout'?'bags':'boxes'}}</view></view><button data-delta="1" bindtap="changeCapacity">＋</button></view></view>
<view class="flow-card waiting-card"><view class="strong">Already waiting at {{station}} for {{dorm}}</view><view class="hint">{{waiting}} {{waiting===1?'order':'orders'}} · ¥{{reward}} · they join your trip automatically</view></view><view wx:if="{{error}}" class="orange-note">{{error}}</view>
<view class="flow-bottom trip-start-bottom"><button class="btn" bindtap="start" disabled="{{!!error||starting}}" loading="{{starting}}">{{when==='later'?'Post trip for '+departLabel:'Start trip · '+waiting+' waiting · ¥'+reward}}</button></view></view>
<yuni-assistant topic=""/>
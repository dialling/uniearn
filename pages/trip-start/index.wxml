<lang-switch/>
<view class="flow-page trip-start-page {{darkClass}}"><view class="flow-title">{{zh?'发起行程':'Start a trip'}}</view><view class="flow-sub">{{zh?'回去路上顺便帮同学带'+(category==='takeout'?'外卖':'快递')+'。':'Bring other people’s '+(category==='takeout'?'takeaway':'parcels')+' on your way back.'}}</view><view class="preview-label">{{zh?'团队测试 · 分享行程，让同学加入你的路线':'Team test · share this trip so students can join your route'}}</view>
<view class="strong">{{zh?'你要取什么？':'What are you picking up?'}}</view><view class="choices"><view class="choice-box {{category==='takeout'?'selected':''}}" data-value="takeout" bindtap="changeCategory"><view class="strong">{{zh?'外卖代取':'Takeaway'}}</view><view class="hint">{{zh?'校门口的外卖':'Food at the gate'}}</view></view><view class="choice-box {{category==='parcel'?'selected':''}}" data-value="parcel" bindtap="changeCategory"><view class="strong">{{zh?'快递代取':'Parcels'}}</view><view class="hint">{{zh?'从快递站取':'from a station'}}</view></view></view>
<view class="strong">{{zh?'什么时候出发？':'When are you going?'}}</view><view class="choices"><view class="choice-box {{when==='now'?'selected':''}}" data-field="when" data-value="now" bindtap="select"><view class="strong">{{zh?'现在':'Now'}}</view><view class="hint">{{zh?'我已在取件点':'I’m at the pickup point'}}</view></view><view class="choice-box {{when==='later'?'selected':''}}" data-field="when" data-value="later" bindtap="select"><view class="strong">{{zh?'今天晚些时候':'Later today'}}</view><view class="hint">{{zh?'选择时间':'Pick a time'}}</view></view></view>
<view class="flow-card" wx:if="{{when==='now'}}"><view class="strong">{{zh?'开放加入时长':'Others can join for'}}</view><view class="pills"><text wx:for="{{durations}}" wx:key="*this" class="pill dark {{duration==item?'selected':''}}" data-field="duration" data-value="{{item}}" bindtap="select">{{item}} {{zh?'分钟':'min'}}</text></view></view>
<view class="flow-card" wx:else><view class="strong">{{zh?'今天的时间':'Time today'}}</view><picker mode="time" value="{{time}}" data-field="time" bindchange="text"><view class="field center amount">{{time}} ⌄</view></picker><view class="hint">{{zh?'同学可在 '+joinLabel+' 前加入，即出发前 10 分钟。':'People can join until '+joinLabel+', 10 minutes before you go.'}}</view><view class="hint">{{zh?'提醒时间：'+remindLabel+'。预览版暂未接入推送提醒。':'Reminder time: '+remindLabel+'. Push reminders are not connected in this preview.'}}</view></view>
<view class="gate-label">{{category==='takeout'?(zh?'校门':'Gate'):(zh?'快递站':'Station')}}</view><view class="gate-cards"><view wx:for="{{stations}}" wx:key="*this" class="gate-card {{station===item?'selected':''}}" data-field="station" data-value="{{item}}" bindtap="select"><view class="strong">{{names[item]||item}}</view><view class="hint">{{names[stationHints[index]]||stationHints[index]||(zh?'取件点':'Pickup point')}}</view></view></view>
<view class="flow-card trip-destination"><view class="destination-copy"><view class="hint">{{zh?'送往':'Going back to'}}</view><view wx:if="{{profileDorm && dorm===profileDorm}}" class="strong">{{dorm}} · {{zh?'你的宿舍':'your dorm'}}</view><input wx:else class="dorm-input" value="{{dorm}}" placeholder="{{zh?'你的宿舍 / 楼栋':'Your dorm / building'}}" data-field="dorm" bindinput="text"/></view><view class="capacity-control"><button data-delta="-1" bindtap="changeCapacity">−</button><view class="capacity-number"><text>{{capacity}}</text><view>{{category==='takeout'?(zh?'袋':'bags'):(zh?'件':'boxes')}}</view></view><button data-delta="1" bindtap="changeCapacity">＋</button></view></view>
<view class="flow-card waiting-card"><view class="strong">{{zh?'已在 '+(names[station]||station)+' 等待送往 '+dorm+' 的订单':'Already waiting at '+station+' for '+dorm}}</view><view class="hint">{{zh?waiting+' 个订单 · ¥'+reward+' · 将自动加入你的行程':waiting+' '+(waiting===1?'order':'orders')+' · ¥'+reward+' · they join your trip automatically'}}</view></view><view wx:if="{{error}}" class="orange-note">{{names[error]||error}}</view>
<view class="flow-bottom trip-start-bottom"><button class="btn" bindtap="start" disabled="{{!!error||starting}}" loading="{{starting}}">{{zh?(when==='later'?'发布 '+departLabel+' 出发的行程':'开始行程 · '+waiting+' 单等待中 · ¥'+reward):(when==='later'?'Post trip for '+departLabel:'Start trip · '+waiting+' waiting · ¥'+reward)}}</button></view></view>
<yuni-assistant topic=""/>
<view style="{{motionStyle}}">
<lang-switch></lang-switch>
<!-- 2026-11-15 redesign: one route card (pick up → deliver to) is the centre of the page; everything else is a quiet row. -->
<view class="flow-page trip-start-page ts-page {{darkClass}}">
 <view class="ts-head">
  <view class="ts-title">{{zh?'发起行程':'Start a trip'}}</view>
  <view class="ts-lead">{{zh?'选好路线，同学可以把订单加到你的行程里。':'Choose your route. Other students can add their orders to it.'}}</view>
 </view>

 <!-- What -->
 <view class="ts-label">{{zh?'你要取什么？':'What are you picking up?'}}</view>
 <view class="ts-types" role="radiogroup">
  <view class="ts-type {{category==='takeout'?'on':''}}" role="radio" aria-checked="{{category==='takeout'}}" data-value="takeout" bindtap="changeCategory"><image src="/assets/icons3d/takeout.svg" mode="aspectFit"/><text>{{zh?'外卖代取':'Takeaway'}}</text></view>
  <view class="ts-type {{category==='parcel'?'on':''}}" role="radio" aria-checked="{{category==='parcel'}}" data-value="parcel" bindtap="changeCategory"><image src="/assets/icons3d/parcel.svg" mode="aspectFit"/><text>{{zh?'快递代取':'Parcels'}}</text></view>
  <view id="tsOther" class="ts-type {{category==='other'?'on':''}}" role="radio" aria-checked="{{category==='other'}}" data-value="other" bindtap="changeCategory"><image src="/assets/icons3d/task.svg" mode="aspectFit"/><text>{{zh?'其他':'Other'}}</text></view>
 </view>

 <!-- Route: pick up → deliver to -->
 <view class="ts-route">
  <view class="ts-stop">
   <view class="ts-rail"><image class="ts-pin" src="/assets/icons3d/pickup.svg" mode="aspectFit"/><view class="ts-dots"/></view>
   <view class="ts-stop-body">
    <view class="ts-stop-title">{{category==='takeout'?(zh?'在哪个外卖柜取':'Pick up at which locker'):category==='parcel'?(zh?'在哪个快递站取':'Pick up at which station'):(zh?'从哪里出发':'Where are you starting?')}}</view>
    <block wx:if="{{category==='other'}}">
     <input class="ts-input" value="{{station}}" data-field="station" bindinput="text" maxlength="200" placeholder="{{zh?'店铺、建筑或出发地点':'Shop, building or starting place'}}"/>
     <input class="ts-input" value="{{pickupAddress}}" data-field="pickupAddress" bindinput="text" maxlength="200" placeholder="{{zh?'具体位置（选填），如一楼入口':'Exact spot (optional), e.g. ground-floor entrance'}}"/>
     <input class="ts-input" value="{{waypoint}}" data-field="waypoint" bindinput="text" maxlength="200" placeholder="{{zh?'途经地点（选填）':'A stop on the way (optional)'}}"/>
    </block>
    <block wx:else>
     <view class="ts-options" role="radiogroup">
      <view wx:for="{{stationOptions}}" wx:key="value" class="ts-option {{(item.manual?stationManual:(!stationManual&&(station===item.value||stations.indexOf(item.value)>=0)))?'on':''}}" role="checkbox" aria-checked="{{item.manual?stationManual:(!stationManual&&stations.indexOf(item.value)>=0)}}" data-index="{{index}}" bindtap="stationChoice"><view class="ts-radio"/><text>{{item.label}}</text></view>
     </view>
     <input wx:if="{{stationManual}}" class="ts-input" value="{{station}}" data-field="station" bindinput="text" placeholder="{{category==='takeout'?(zh?'输入外卖柜名称':'Enter the locker name'):(zh?'输入快递站名称':'Enter the station name')}}" maxlength="200"/>
    </block>
   </view>
  </view>
  <view class="ts-stop ts-stop-last">
   <view class="ts-rail"><image class="ts-pin" src="{{destinationType==='place'?'/assets/icons3d/map.svg':'/assets/icons3d/home.svg'}}" mode="aspectFit"/></view>
   <view class="ts-stop-body">
    <view class="ts-stop-title">{{zh?'送到哪里':'Deliver to'}}</view>
    <view class="ts-seg" role="radiogroup">
     <view class="ts-seg-item {{destinationType==='dorm'?'on':''}}" role="radio" aria-checked="{{destinationType==='dorm'}}" data-value="dorm" bindtap="destinationTypeChoice">{{zh?'宿舍':'Dorm'}}</view>
     <view class="ts-seg-item {{destinationType==='place'?'on':''}}" role="radio" aria-checked="{{destinationType==='place'}}" data-value="place" bindtap="destinationTypeChoice">{{zh?'其他地点':'Other place'}}</view>
    </view>
    <textarea wx:if="{{destinationType==='place'}}" class="ts-input ts-textarea" value="{{deliveryAddress}}" data-field="deliveryAddress" bindinput="text" maxlength="500" auto-height placeholder="{{zh?'地点和交接位置，如图书馆南门前台旁':'Place and meeting spot, e.g. library south entrance by reception'}}"/>
    <view wx:else class="ts-pickers">
     <picker range="{{areaLabels}}" value="{{areaIndex}}" bindchange="destinationArea"><view class="ts-picker"><text class="ts-picker-label">{{zh?'区域':'Area'}}</text><text class="ts-picker-value">{{areaLabels[areaIndex]}}</text><view class="ts-chev"/></view></picker>
     <!-- 2026-11-21: choose one or more buildings in this area -->
     <view class="ts-bld">
      <view class="ts-bld-head"><text class="ts-picker-label">{{zh?'楼栋':'Buildings'}}</text><text class="ts-bld-hint">{{zh?'可多选 · 已选 '+dorms.length+' 栋':'Choose one or more · '+dorms.length+' chosen'}}</text></view>
      <view class="ts-bld-grid" role="group">
       <view wx:for="{{buildingChips}}" wx:key="code" class="ts-bld-chip {{item.on?'on':''}}" role="checkbox" aria-checked="{{item.on}}" hover-class="ts-bld-press" data-code="{{item.code}}" bindtap="toggleBuilding"><text wx:if="{{item.on}}" class="ts-bld-tick">✓</text>{{item.label}}</view>
      </view>
     </view>
    </view>
   </view>
  </view>
 </view>

 <!-- When + how much -->
 <view class="ts-card">
  <view class="ts-row">
   <view class="ts-row-title">{{zh?'什么时候出发':'When are you going?'}}</view>
   <view class="ts-seg ts-seg-small" role="radiogroup">
    <view class="ts-seg-item {{when==='now'?'on':''}}" role="radio" aria-checked="{{when==='now'}}" data-field="when" data-value="now" bindtap="select">{{zh?'现在':'Now'}}</view>
    <view class="ts-seg-item {{when==='later'?'on':''}}" role="radio" aria-checked="{{when==='later'}}" data-field="when" data-value="later" bindtap="select">{{zh?'今天晚些':'Later today'}}</view>
   </view>
  </view>
  <block wx:if="{{when==='now'}}">
   <view class="ts-sub">{{zh?'同学可以在这段时间内加入：':'Others can join for'}}</view>
   <view class="ts-chips">
    <view wx:for="{{durations}}" wx:key="*this" class="ts-chip {{!customDurationOpen&&duration==item?'on':''}}" data-field="duration" data-value="{{item}}" bindtap="select">{{item}} {{zh?'分钟':'min'}}</view>
    <view class="ts-chip {{customDurationOpen?'on':''}}" bindtap="toggleCustomDuration">{{zh?'自定义':'Custom'}}</view>
   </view>
   <view wx:if="{{customDurationOpen}}" class="ts-custom"><input class="ts-input ts-input-small" type="number" value="{{customDurationInput}}" bindinput="setCustomDuration" placeholder="1–30"/><text>{{zh?'分钟':'minutes'}}</text></view>
  </block>
  <block wx:else>
   <picker mode="time" value="{{time}}" data-field="time" bindchange="text"><view class="ts-picker ts-time"><text class="ts-picker-label">{{zh?'出发时间':'Leaving at'}}</text><text class="ts-picker-value">{{time}}</text><view class="ts-chev"/></view></picker>
   <view class="ts-note">{{zh?'同学可在 '+joinLabel+' 前加入（出发前 10 分钟）。':'Others can join until '+joinLabel+', 10 minutes before you leave.'}}</view>
  </block>
  <view class="ts-divider"/>
  <view class="ts-row">
   <view><view class="ts-row-title">{{category==='other'?(zh?'最多能接':'You can take'):(zh?'最多能带':'You can carry')}}</view><view class="ts-note ts-note-tight">{{category==='takeout'?(zh?'外卖袋数':'bags of food'):category==='other'?(zh?'任务数':'tasks'):(zh?'快递件数':'parcels')}}</view></view>
   <view class="ts-stepper"><view class="ts-step {{capacity<=1?'off':''}}" role="button" aria-label="{{zh?'减少':'Fewer'}}" data-delta="-1" bindtap="changeCapacity">−</view><text class="ts-count">{{capacity}}</text><view class="ts-step" role="button" aria-label="{{zh?'增加':'More'}}" data-delta="1" bindtap="changeCapacity">+</view></view>
  </view>
 </view>

 <!-- Orders already waiting on this route -->
 <view class="ts-orders-head">
  <view class="ts-label ts-label-flush">{{zh?'顺路订单':'Orders on your route'}}<text wx:if="{{waiting}}" class="ts-badge">{{waiting}}</text></view>
  <view wx:if="{{selectedCount}}" class="ts-clear" role="button" bindtap="clearOrders">{{zh?'清空':'Clear'}}</view>
 </view>
 <view wx:if="{{!waiting}}" class="ts-empty"><image src="/assets/icons3d/trip.svg" mode="aspectFit"/><view><view class="ts-empty-title">{{zh?'暂时没有顺路订单':'No orders on this route yet'}}</view><view class="ts-note ts-note-tight">{{zh?'先分享行程，同学会把订单加进来。':'Share your trip and students can add their orders.'}}</view></view></view>
 <view wx:else class="ts-orders">
  <button wx:for="{{recommendedOrders}}" wx:key="id" class="ts-order {{item.selected?'on':''}}" data-id="{{item.id}}" bindtap="toggleOrder" disabled="{{starting}}" aria-label="{{(item.selected?(zh?'取消选择 ':'Unselect '):(zh?'选择 ':'Select '))+item.route+' ¥'+item.rewardText}}">
   <view class="ts-check">{{item.selected?'✓':''}}</view>
   <view class="ts-order-copy"><view class="ts-order-route">{{item.route}}</view><view class="ts-order-meta">{{item.boxes}} {{item.category==='takeout'?(zh?'袋外卖':(item.boxes===1?'bag':'bags')):(zh?'件快递':(item.boxes===1?'parcel':'parcels'))}}<text wx:if="{{item.night}}">{{zh?'，夜市代买':', night market'}}</text><text wx:if="{{item.fragile}}">{{zh?'，易碎':', fragile'}}</text><text class="ts-order-time"> {{item.timeLabel}}</text></view></view>
   <view class="ts-order-reward">¥{{item.rewardText}}</view>
  </button>
  <view class="ts-note">{{zh?'只有勾选的订单会加入行程。':'Only the orders you tick join your trip.'}}</view>
 </view>

 <view wx:if="{{error}}" class="ts-error">{{names[error]||error}}</view>

 <view class="flow-bottom trip-start-bottom ts-bottom">
  <view wx:if="{{selectedCount}}" class="ts-sum"><text>{{zh?'已选 '+selectedCount+' 单，'+selectedBoxes+'/'+capacity+(category==='takeout'?' 袋':category==='other'?' 个任务':' 件'):selectedCount+(selectedCount===1?' order, ':' orders, ')+selectedBoxes+' of '+capacity+(category==='takeout'?' bags':category==='other'?' tasks':' parcels')}}</text><text class="ts-sum-money">¥{{reward}}</text></view>
  <button class="btn ts-go" bindtap="start" disabled="{{!!error||starting}}" loading="{{motionEnabled && (starting)}}">{{selectedCount?(zh?'开始行程':'Start trip'):(zh?'分享行程，等同学加入':'Share trip')}}</button>
 </view>
</view>
<yuni-assistant topic=""/>
<coach-tip name="trip" when="{{true}}"/>
</view>

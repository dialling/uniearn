<view class="ue-enter" style="{{motionStyle}}">
<lang-switch></lang-switch>
<view class="flow-page trip-start-page {{darkClass}}"><view class="flow-title">{{zh?'发起行程':'Start a trip'}}</view><view class="flow-sub">{{zh?'回去路上顺便帮同学带'+(category==='other'?'物品':category==='takeout'?'外卖':'快递')+'。':'Bring other people’s '+(category==='other'?'items':category==='takeout'?'takeaway':'parcels')+' on your way back.'}}</view><view class="preview-label">{{zh?'团队测试 · 分享行程，让同学加入你的路线':'Team test · share this trip so students can join your route'}}</view>
<view class="strong">{{zh?'你要取什么？':'What are you picking up?'}}</view><view class="choices category-choices"><view class="choice-box {{category==='takeout'?'selected':''}}" data-value="takeout" bindtap="changeCategory"><view class="strong">{{zh?'外卖代取':'Takeaway'}}</view><view class="hint">{{zh?'校门口的外卖':'Food at the gate'}}</view></view><view class="choice-box {{category==='parcel'?'selected':''}}" data-value="parcel" bindtap="changeCategory"><view class="strong">{{zh?'快递代取':'Parcels'}}</view><view class="hint">{{zh?'从快递站取':'from a station'}}</view></view><view class="choice-box {{category==='other'?'selected':''}}" data-value="other" bindtap="changeCategory"><view class="strong">{{zh?'其他':'Other'}}</view><view class="hint">{{zh?'自定义路线':'Your own route'}}</view></view></view>
<view class="strong">{{zh?'什么时候出发？':'When are you going?'}}</view><view class="choices"><view class="choice-box {{when==='now'?'selected':''}}" data-field="when" data-value="now" bindtap="select"><view class="strong">{{zh?'现在':'Now'}}</view><view class="hint">{{zh?'我已在取件点':'I’m at the pickup point'}}</view></view><view class="choice-box {{when==='later'?'selected':''}}" data-field="when" data-value="later" bindtap="select"><view class="strong">{{zh?'今天晚些时候':'Later today'}}</view><view class="hint">{{zh?'选择时间':'Pick a time'}}</view></view></view>
<view class="flow-card" wx:if="{{when==='now'}}"><view class="strong">{{zh?'开放加入时长':'Others can join for'}}</view><view class="pills"><text wx:for="{{durations}}" wx:key="*this" class="pill dark {{!customDurationOpen&&duration==item?'selected':''}}" data-field="duration" data-value="{{item}}" bindtap="select">{{item}} {{zh?'分钟':'min'}}</text><text class="pill dark {{customDurationOpen?'selected':''}}" bindtap="toggleCustomDuration">{{zh?'自定义':'Custom'}}</text></view><view wx:if="{{customDurationOpen}}" class="custom-duration-row"><view>{{zh?'自定义分钟':'Custom minutes'}}</view><input class="field custom-duration-input" type="number" value="{{customDurationInput}}" bindinput="setCustomDuration" placeholder="{{zh?'输入 1-30 分钟':'1-30 min'}}"/><text>{{zh?'分钟':'min'}}</text></view></view>
<view class="flow-card" wx:else><view class="strong">{{zh?'今天的时间':'Time today'}}</view><picker mode="time" value="{{time}}" data-field="time" bindchange="text"><view class="field center amount">{{time}} ⌄</view></picker><view class="hint">{{zh?'同学可在 '+joinLabel+' 前加入，即出发前 10 分钟。':'People can join until '+joinLabel+', 10 minutes before you go.'}}</view><view class="hint">{{zh?'提醒时间：'+remindLabel+'。预览版暂未接入推送提醒。':'Reminder time: '+remindLabel+'. Push reminders are not connected in this preview.'}}</view></view>
<view wx:if="{{category==='other'}}" class="flow-card custom-route-card"><view class="strong">{{zh?'从哪里出发？':'Where are you starting?'}}</view><view class="route-field-label">{{zh?'地点名称':'Place name'}}</view><input class="field" value="{{station}}" data-field="station" bindinput="text" maxlength="200" placeholder="{{zh?'填写店铺、建筑或其他出发地点':'Enter a shop, building or pickup location'}}"/><view class="route-field-label">{{zh?'具体位置 · 选填':'Exact location · optional'}}</view><input class="field" value="{{pickupAddress}}" data-field="pickupAddress" bindinput="text" maxlength="200" placeholder="{{zh?'例如：一楼入口、门牌号':'e.g. ground-floor entrance or street number'}}"/><view class="route-field-label">{{zh?'途经地点 · 选填':'Stop along the way · optional'}}</view><input class="field" value="{{waypoint}}" data-field="waypoint" bindinput="text" maxlength="200" placeholder="{{zh?'途中还想去哪里？':'Any other stop on your way?'}}"/><view class="hint">{{zh?'先安排自己的路线，再选择同路订单。途经地点仅作行程说明，暂不用于地图匹配。':'Plan your own route, then choose matching orders. Stops are notes only; map matching is not connected.'}}</view></view><block wx:else><view class="gate-label {{category==='takeout'?'locker-label':''}}">{{category==='takeout'?(zh?'外卖柜':'Takeaway lockers'):(zh?'快递站':'Station')}}</view><view class="gate-cards {{category==='takeout'?'locker-cards':''}}"><view wx:for="{{stationOptions}}" wx:key="value" class="gate-card {{category==='takeout'?'locker-option':''}} {{item.wide?'locker-option-wide':''}} {{(item.manual?stationManual:(!stationManual&&station===item.value))?'selected':''}}" data-index="{{index}}" bindtap="stationChoice"><view class="strong">{{item.label}}</view></view></view><input wx:if="{{stationManual}}" class="field station-manual" value="{{station}}" data-field="station" bindinput="text" placeholder="{{zh?'输入外卖柜名称':'Enter takeaway locker name'}}" maxlength="200"/>
</block><view class="flow-card trip-destination"><view class="destination-top"><view class="destination-title">{{zh?'送达':'Deliver to'}}</view><view class="capacity-control"><button data-delta="-1" bindtap="changeCapacity">−</button><view class="capacity-number"><text>{{capacity}}</text><view>{{category==='takeout'?(zh?'袋':'bags'):(zh?'件':'boxes')}}</view></view><button data-delta="1" bindtap="changeCapacity">＋</button></view></view><view class="destination-types"><view class="destination-type {{destinationType==='dorm'?'selected':''}}" data-value="dorm" bindtap="destinationTypeChoice">{{zh?'宿舍':'Dorm'}}</view><view class="destination-type {{destinationType==='place'?'selected':''}}" data-value="place" bindtap="destinationTypeChoice">{{zh?'其他地点':'Other place'}}</view></view><view wx:if="{{destinationType==='place'}}" class="custom-destination"><view class="route-field-label">{{zh?'送达地点与交接位置':'Destination and meeting point'}}</view><textarea class="field" value="{{deliveryAddress}}" data-field="deliveryAddress" bindinput="text" maxlength="500" placeholder="{{zh?'例如：图书馆南门，前台旁边':'e.g. library south entrance, beside reception'}}"/></view><view wx:else class="destination-pickers"><view class="destination-choice"><view class="destination-choice-label">{{zh?'可选宿舍':'Dorm area'}}</view><picker range="{{areaLabels}}" value="{{areaIndex}}" bindchange="destinationArea"><view class="destination-picker"><text>{{areaLabels[areaIndex]}}</text><text class="destination-chevron">⌄</text></view></picker></view><view class="destination-choice"><view class="destination-choice-label">{{zh?'可选楼栋':'Building'}}</view><picker range="{{buildingLabels}}" value="{{buildingIndex}}" bindchange="destinationBuilding"><view class="destination-picker"><text>{{buildingLabels[buildingIndex]}}</text><text class="destination-chevron">⌄</text></view></picker></view></view></view>
<view class="flow-card waiting-card">
 <view class="order-select-head"><view class="strong">{{zh?'顺路订单 · 自由勾选':'Orders on your route · choose any'}}</view><button wx:if="{{selectedCount}}" class="clear-orders" bindtap="clearOrders" disabled="{{starting}}">{{zh?'清空':'Clear'}}</button></view>
 <view class="hint">{{zh?'找到 '+waiting+' 个匹配订单，勾选后才会加入行程。':'Found '+waiting+' matching orders. Only checked orders will join your trip.'}}</view>
 <view wx:if="{{!waiting}}" class="order-empty">{{zh?'暂时没有匹配订单，可以先分享行程等待同学加入。':'No matching orders yet. Share your trip and let others join.'}}</view>
 <button wx:for="{{recommendedOrders}}" wx:key="id" class="trip-order {{item.selected?'is-selected':''}}" data-id="{{item.id}}" bindtap="toggleOrder" disabled="{{starting}}" aria-label="{{(item.selected?(zh?'取消选择 ':'Unselect '):(zh?'选择 ':'Select '))+item.route+' '+item.boxes+(zh?(category==='takeout'?'袋':'件'):(category==='takeout'?' bags':' parcels'))+' ¥'+item.rewardText}}">
  <view class="order-check">{{item.selected?'✓':''}}</view><view class="order-copy"><view class="order-route">{{item.route}}</view><view class="order-meta">{{item.boxes}} {{item.category==='takeout'?(zh?'袋外卖':'bags'):(zh?'件快递':'parcels')}}<text wx:if="{{item.night}}"> · {{zh?'夜市':'Night market'}}</text><text wx:if="{{item.fragile}}"> · {{zh?'易碎':'Fragile'}}</text></view><view class="order-time">{{item.timeLabel}}</view></view><view class="order-reward">¥{{item.rewardText}}</view>
 </button>
 <view class="selection-summary">{{zh?'已选 '+selectedCount+' 单 · '+selectedBoxes+'/'+capacity+(category==='takeout'?' 袋':' 件')+' · 赏金 ¥'+reward:selectedCount+' selected · '+selectedBoxes+'/'+capacity+(category==='takeout'?' bags':' parcels')+' · ¥'+reward}}</view>
 <view class="hint">{{zh?'不勾选也能分享空行程，等待同学加入。':'You can also share an empty trip and wait for others to join.'}}</view>
</view><view wx:if="{{error}}" class="orange-note">{{names[error]||error}}</view>
<view class="flow-bottom trip-start-bottom"><button class="btn" bindtap="start" disabled="{{!!error||starting}}" loading="{{motionEnabled && (starting)}}">{{zh?(selectedCount?'开始行程 · 已选 '+selectedCount+' 单 · ¥'+reward:'分享空行程 · 等待加入'):(selectedCount?'Start trip · '+selectedCount+' selected · ¥'+reward:'Share empty trip')}}</button></view></view>
<yuni-assistant topic=""/>

</view>

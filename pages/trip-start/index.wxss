@import "../../utils/flow.wxss";
/* 2026-11-15 redesign of Start a trip: the route card (pick up → deliver to) carries the page; the rest stays quiet. */
.trip-start-page.ts-page{padding:28rpx 32rpx 250rpx;background:#eeede8;color:#16181c}
.ts-head{margin:4rpx 4rpx 30rpx}
.ts-title{font-size:46rpx;font-weight:800;letter-spacing:-.6rpx;color:#16181c}
.ts-lead{margin-top:8rpx;font-size:26rpx;line-height:1.5;color:#6b6860}
.ts-label{margin:0 4rpx 16rpx;font-size:27rpx;font-weight:800;color:#1c2a54}
.ts-label-flush{margin:0}

/* what: three tiles with the app's 3D icons */
.ts-types{display:flex;gap:16rpx;margin-bottom:28rpx}
.ts-type{flex:1;min-width:0;display:flex;flex-direction:column;align-items:center;gap:8rpx;padding:22rpx 8rpx 20rpx;background:#fff;border-radius:32rpx;border:3rpx solid transparent;font-size:25rpx;font-weight:700;color:#4c5148;box-shadow:0 6rpx 0 #e2e0d9;transition:var(--ue-transition,transform .12s)}
.ts-type image{width:76rpx;height:76rpx}
.ts-type.on{border-color:#0b7a55;background:#f2faf6;color:#08523a;box-shadow:0 6rpx 0 #b9dcc9}
.ts-type:active{transform:translateY(4rpx)}

/* route card: two stops joined by a dotted line */
.ts-route{background:#fff;border-radius:40rpx;padding:30rpx 28rpx 26rpx;margin-bottom:24rpx}
.ts-stop{display:flex;gap:20rpx}
.ts-rail{flex:none;width:64rpx;display:flex;flex-direction:column;align-items:center}
.ts-pin{width:64rpx;height:64rpx;flex:none}
.ts-dots{flex:1;width:0;margin:8rpx 0;border-left:4rpx dotted #b9dcc9}
.ts-stop-body{flex:1;min-width:0;padding:10rpx 0 30rpx}
.ts-stop-last .ts-stop-body{padding-bottom:0}
.ts-stop-title{font-size:29rpx;font-weight:800;color:#16181c;margin-bottom:16rpx}
.ts-options{display:flex;flex-direction:column;gap:10rpx}
.ts-option{display:flex;align-items:flex-start;gap:16rpx;padding:18rpx 20rpx;border-radius:22rpx;background:#f6f5f1;font-size:25rpx;line-height:1.4;color:#33362f}
.ts-option.on{background:#e7f3ed;color:#08523a;font-weight:700}
.ts-radio{flex:none;width:30rpx;height:30rpx;margin-top:3rpx;border-radius:50%;border:3rpx solid #c4c1b6;box-sizing:border-box;background:#fff}
.ts-option.on .ts-radio{border:9rpx solid #0b7a55}
.ts-input{box-sizing:border-box;width:100%;min-height:84rpx;margin-top:12rpx;padding:20rpx 22rpx;border-radius:22rpx;background:#f6f5f1;font-size:26rpx;line-height:1.4;color:#16181c}
.ts-options + .ts-input{margin-top:12rpx}
.ts-stop-title + .ts-input{margin-top:0}
.ts-textarea{min-height:120rpx;margin-top:16rpx}
.ts-seg{display:flex;background:#f1f0eb;border-radius:22rpx;padding:6rpx;gap:6rpx}
.ts-seg-item{flex:1;text-align:center;padding:16rpx 10rpx;border-radius:18rpx;font-size:25rpx;font-weight:650;color:#6b6860;white-space:nowrap}
.ts-seg-item.on{background:#fff;color:#08523a;font-weight:800;box-shadow:0 3rpx 10rpx #1c2a5414}
.ts-pickers{display:flex;flex-direction:column;gap:10rpx;margin-top:16rpx}
.ts-picker{display:flex;align-items:center;gap:16rpx;padding:20rpx 22rpx;border-radius:22rpx;background:#f6f5f1;font-size:26rpx}
.ts-picker-label{flex:none;color:#6b6860;min-width:96rpx}
.ts-picker-value{flex:1;min-width:0;font-weight:700;color:#16181c;text-align:right;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.ts-chev{flex:none;width:14rpx;height:14rpx;border-right:4rpx solid #a9a69b;border-bottom:4rpx solid #a9a69b;transform:translateY(-4rpx) rotate(45deg)}

/* when + capacity */
.ts-card{background:#fff;border-radius:40rpx;padding:28rpx;margin-bottom:34rpx}
.ts-row{display:flex;align-items:center;justify-content:space-between;gap:20rpx}
.ts-row-title{font-size:28rpx;font-weight:800;color:#16181c}
.ts-seg-small{flex:none;width:auto}
.ts-seg-small .ts-seg-item{flex:none;padding:12rpx 22rpx;font-size:24rpx}
.ts-sub{margin:24rpx 0 12rpx;font-size:24rpx;color:#6b6860}
.ts-chips{display:flex;gap:12rpx;flex-wrap:wrap}
.ts-chip{padding:14rpx 26rpx;border-radius:99rpx;background:#f1f0eb;font-size:25rpx;font-weight:650;color:#4c5148}
.ts-chip.on{background:#0b7a55;color:#fff}
.ts-custom{display:flex;align-items:center;gap:16rpx;margin-top:14rpx;font-size:25rpx;color:#6b6860}
.ts-input-small{width:200rpx;margin-top:0;min-height:72rpx;padding:14rpx 20rpx;text-align:center}
.ts-time{margin-top:22rpx}
.ts-note{margin-top:12rpx;font-size:23rpx;line-height:1.5;color:#7a776e}
.ts-note-tight{margin-top:2rpx}
.ts-divider{height:1rpx;background:#efede7;margin:26rpx 0}
.ts-stepper{flex:none;display:flex;align-items:center;gap:6rpx;background:#f1f0eb;border-radius:99rpx;padding:6rpx}
.ts-step{width:68rpx;height:68rpx;border-radius:50%;background:#fff;display:flex;align-items:center;justify-content:center;font-size:36rpx;font-weight:700;color:#0b7a55;box-shadow:0 3rpx 8rpx #1c2a5412}
.ts-step.off{color:#c4c1b6}
.ts-count{min-width:64rpx;text-align:center;font-size:34rpx;font-weight:800;color:#16181c;font-variant-numeric:tabular-nums}

/* orders on the route */
.ts-orders-head{display:flex;align-items:center;justify-content:space-between;margin:0 4rpx 16rpx}
.ts-badge{display:inline-block;margin-left:12rpx;min-width:40rpx;padding:2rpx 12rpx;border-radius:99rpx;background:#f2b233;color:#1c2a54;font-size:22rpx;text-align:center;vertical-align:2rpx}
.ts-clear{font-size:25rpx;font-weight:700;color:#0b7a55;padding:8rpx 4rpx}
.ts-empty{display:flex;align-items:center;gap:22rpx;background:#fff;border-radius:40rpx;padding:26rpx 28rpx}
.ts-empty image{width:84rpx;height:84rpx;flex:none}
.ts-empty-title{font-size:27rpx;font-weight:800;color:#16181c}
.ts-orders{display:flex;flex-direction:column;gap:12rpx}
.ts-order{display:flex;align-items:center;gap:20rpx;width:100%;margin:0;padding:24rpx 24rpx;border-radius:30rpx;border:3rpx solid transparent;background:#fff;text-align:left;line-height:1.45;color:inherit;box-sizing:border-box}
.ts-order::after{border:0}
.ts-order.on{border-color:#0b7a55;background:#f2faf6}
.ts-check{flex:none;width:40rpx;height:40rpx;border-radius:12rpx;border:3rpx solid #c4c1b6;box-sizing:border-box;text-align:center;line-height:34rpx;font-size:26rpx;font-weight:800;color:#fff}
.ts-order.on .ts-check{background:#0b7a55;border-color:#0b7a55}
.ts-order-copy{flex:1;min-width:0}
.ts-order-route{font-size:26rpx;font-weight:800;color:#16181c;overflow-wrap:break-word}
.ts-order-meta{margin-top:4rpx;font-size:23rpx;color:#6b6860}
.ts-order-time{color:#9a978d}
.ts-order-reward{flex:none;font-size:31rpx;font-weight:800;color:#0b7a55;font-variant-numeric:tabular-nums}
.ts-error{margin-top:24rpx;padding:20rpx 24rpx;border-radius:24rpx;background:#fff4e5;color:#8a4b00;font-size:25rpx;line-height:1.5}

/* bottom bar */
.trip-start-bottom{position:fixed;left:0;right:0;bottom:0;z-index:20;background:#fff;border-top:1rpx solid #e2e0d9;padding:18rpx 32rpx calc(22rpx + env(safe-area-inset-bottom));box-shadow:0 -6rpx 24rpx #0000000d}
.ts-sum{display:flex;justify-content:space-between;align-items:baseline;margin:0 6rpx 14rpx;font-size:25rpx;color:#4c5148}
.ts-sum-money{font-size:30rpx;font-weight:800;color:#0b7a55;font-variant-numeric:tabular-nums}
.trip-start-bottom .btn.ts-go{display:block;width:100%;margin:0;min-height:96rpx;border-radius:28rpx;font-size:29rpx;font-weight:800;text-align:center;box-shadow:0 8rpx 0 #085c41}

/* dark pages */
.page-dark.ts-page{background:#1b1d1a;color:#f0f2ee}
.page-dark .ts-route,.page-dark .ts-card,.page-dark .ts-type,.page-dark .ts-empty,.page-dark .ts-order{background:#252a28;box-shadow:none}
.page-dark .ts-option,.page-dark .ts-input,.page-dark .ts-picker,.page-dark .ts-seg,.page-dark .ts-chip,.page-dark .ts-stepper{background:#30362f;color:#f0f2ee}
.page-dark .ts-title,.page-dark .ts-stop-title,.page-dark .ts-row-title,.page-dark .ts-order-route,.page-dark .ts-empty-title,.page-dark .ts-picker-value,.page-dark .ts-count{color:#f0f2ee}
.page-dark .ts-label{color:#c9d3f0}

/* 2026-11-21: Deliver to: choose one or more buildings in the area (same grey field as the Area picker, chips like the
   station choices: chosen = green tint with a tick). */
.ts-bld{padding:20rpx 22rpx 22rpx;border-radius:22rpx;background:#f6f5f1}
.ts-bld-head{display:flex;align-items:center;justify-content:space-between;gap:16rpx;font-size:26rpx}
.ts-bld-hint{font-size:22rpx;color:#8a877c;white-space:nowrap}
.ts-bld-grid{display:flex;flex-wrap:wrap;gap:12rpx;margin-top:18rpx}
.ts-bld-chip{display:flex;align-items:center;justify-content:center;gap:6rpx;min-width:104rpx;box-sizing:border-box;padding:14rpx 20rpx;border-radius:18rpx;border:2rpx solid #e6e4dd;background:#fff;font-size:26rpx;font-weight:700;color:#3b3e37}
.ts-bld-chip.on{border-color:#0b7a55;background:#e7f3ed;color:#08523a}
.ts-bld-tick{font-size:22rpx;color:#0b7a55}
.ts-bld-press{opacity:.7}
.page-dark .ts-bld{background:#2a2c26}
.page-dark .ts-bld-chip{background:#242522;border-color:#3a3b37;color:#c8c7bd}
.page-dark .ts-bld-chip.on{background:#1d2f28;border-color:#6fd0a8;color:#6fd0a8}

@import "../../utils/flow.wxss";
.trip-start-bottom{position:fixed;left:0;right:0;bottom:0;z-index:20;background:#fff;border-top:1rpx solid #eadfd2;padding:18rpx 30rpx calc(20rpx + env(safe-area-inset-bottom));box-shadow:0 -6rpx 24rpx #0000000d}.trip-start-bottom .btn{display:block;width:100%;margin:0 auto;min-height:92rpx;text-align:center}

.trip-start-page{padding:30rpx 38rpx 190rpx}.gate-label{font-size:23rpx;font-weight:750;color:#505149;letter-spacing:1rpx;margin:24rpx 4rpx}.gate-cards{display:flex;gap:15rpx}.gate-card{flex:1;min-width:0;padding:19rpx 10rpx;border-radius:25rpx;border:1rpx solid #e7d9cb;background:#fff;text-align:center}.gate-card .strong{font-size:27rpx;line-height:1.4}.gate-card .hint{font-size:20rpx;line-height:1.4;margin:9rpx 0 0}.gate-card.selected{background:#2e211a;border-color:#2e211a;color:#fff}.gate-card.selected .hint{color:#d2d0c3}.trip-destination{display:flex;align-items:center;justify-content:space-between;gap:17rpx;padding:23rpx 27rpx;margin:18rpx 0}.destination-copy{flex:1;min-width:0}.destination-copy .hint{margin:0 0 9rpx;font-size:21rpx}.destination-copy .strong,.dorm-input{font-size:28rpx;font-weight:750}.dorm-input{height:48rpx;min-height:48rpx;padding:0;background:transparent}.capacity-control{display:flex;align-items:center;gap:9rpx;flex:none;border:1rpx solid #e7d9cb;border-radius:55rpx;padding:8rpx 13rpx;width:240rpx;justify-content:space-between}.capacity-control button{width:50rpx;min-width:50rpx;height:54rpx;min-height:54rpx;margin:0;padding:0;line-height:54rpx;background:transparent;color:#55564d;font-size:31rpx}.capacity-number{text-align:center;font-size:28rpx;font-weight:750}.capacity-number view{font-size:18rpx;line-height:1.3;font-weight:400;color:#8b897f}.waiting-card{background:#fafaf7;padding:27rpx}.waiting-card .strong{font-size:24rpx;line-height:1.5}.waiting-card .hint{font-size:24rpx;margin:17rpx 0 0}.trip-start-bottom{padding:22rpx 38rpx calc(24rpx + env(safe-area-inset-bottom))}.trip-start-bottom .btn{border-radius:24rpx;font-size:28rpx;min-height:96rpx}

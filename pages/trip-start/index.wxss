@import "../../utils/flow.wxss";
.trip-start-bottom{position:fixed;left:0;right:0;bottom:0;z-index:20;background:#fff;border-top:1rpx solid #e2e0d9;padding:18rpx 30rpx calc(20rpx + env(safe-area-inset-bottom));box-shadow:0 -6rpx 24rpx #0000000d}.trip-start-bottom .btn{display:block;width:100%;margin:0 auto;min-height:92rpx;text-align:center}

.trip-start-page{padding:30rpx 38rpx 190rpx}.gate-label{font-size:23rpx;font-weight:750;color:#44423c;letter-spacing:1rpx;margin:24rpx 4rpx}.gate-cards{display:flex;gap:15rpx}.gate-card{flex:1;min-width:0;padding:19rpx 10rpx;border-radius:25rpx;border:1rpx solid #e2e0d9;background:#fff;text-align:center}.gate-card .strong{font-size:27rpx;line-height:1.4}.gate-card .hint{font-size:20rpx;line-height:1.4;margin:9rpx 0 0}.gate-card.selected{background:#bd4f2a;border-color:#bd4f2a;color:#fff}.trip-destination{display:block;box-sizing:border-box;background:#f7f6f2;border-color:#e8e4dc;padding:14rpx 18rpx;margin:14rpx 0}.destination-copy{flex:1;min-width:0}.destination-copy .hint{margin:0 0 9rpx;font-size:21rpx}.destination-copy .strong,.dorm-input{font-size:28rpx;font-weight:750}.dorm-input{height:48rpx;min-height:48rpx;padding:0;background:transparent}.capacity-control{display:flex;align-items:center;gap:9rpx;flex:none;border:1rpx solid #e2e0d9;border-radius:55rpx;padding:8rpx 13rpx;width:240rpx;justify-content:space-between}.capacity-control button{width:50rpx;min-width:50rpx;height:54rpx;min-height:54rpx;margin:0;padding:0;line-height:54rpx;background:transparent;color:#44423c;font-size:31rpx}.capacity-number{text-align:center;font-size:28rpx;font-weight:750}.capacity-number view{font-size:18rpx;line-height:1.3;font-weight:400;color:#8a877e}.waiting-card{background:#fafaf7;padding:27rpx}.waiting-card .strong{font-size:24rpx;line-height:1.5}.waiting-card .hint{font-size:24rpx;margin:17rpx 0 0}.trip-start-bottom{padding:22rpx 38rpx calc(24rpx + env(safe-area-inset-bottom))}.trip-start-bottom .btn{border-radius:24rpx;font-size:28rpx;min-height:96rpx}
.trip-start-page .pill.dark.selected{background:#d9eee4;border-color:#0b7a55;color:#202623}
.trip-start-page .choice-box.selected{background:#0b7a55;border-color:#0b7a55;color:#fff}
.trip-start-page .choice-box.selected .hint,.trip-start-page .gate-card.selected .hint{color:#fff0e7}
.trip-start-page .locker-label{margin:12rpx 4rpx 8rpx}.trip-start-page .locker-cards{flex-wrap:wrap;align-items:flex-start;gap:10rpx}.trip-start-page .locker-cards .locker-option{flex:1 1 auto;width:auto;max-width:100%;min-height:62rpx;box-sizing:border-box;display:flex;align-items:center;padding:13rpx 20rpx;border-radius:999rpx;text-align:left}.trip-start-page .locker-cards .locker-option .strong{font-size:25rpx;line-height:1.3;white-space:normal;word-break:break-all}.trip-start-page .locker-cards .locker-option-wide{flex:0 0 100%;width:100%}.trip-start-page .locker-cards .locker-option.selected{background:#0b7a55;border-color:#0b7a55;color:#fff}.trip-start-page .locker-cards .locker-option.selected .strong{color:#fff}.trip-start-page .station-manual{width:100%;margin:12rpx 0 0}
.trip-start-page .destination-top{display:flex;align-items:center;justify-content:space-between;gap:16rpx}.destination-title{font-size:25rpx;font-weight:750;color:#44423c}.destination-pickers{display:flex;gap:10rpx;margin-top:7rpx}.trip-start-page .destination-choice{flex:1;min-width:0}.trip-start-page .destination-choice-label{font-size:18rpx;line-height:1.25;color:#6b6860;margin-bottom:2rpx}.trip-start-page .destination-picker{display:flex;align-items:center;justify-content:space-between;gap:8rpx;box-sizing:border-box;height:58rpx;padding:0 14rpx;border:1rpx solid #e2e0d9;border-radius:14rpx;background:#fff;font-size:23rpx}.destination-picker>text:first-child{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.destination-chevron{flex:none;color:#8a877e;font-size:28rpx;line-height:1}

.trip-start-page .custom-duration-row{display:flex;align-items:center;gap:12rpx;margin:10rpx 0 4rpx;color:#44423c;font-size:23rpx}.trip-start-page .custom-duration-input{flex:1;min-width:0;height:66rpx;min-height:66rpx;padding:0 16rpx;background:#f7f6f2;border:1rpx solid #e2e0d9;border-radius:14rpx;font-size:25rpx}.trip-start-page .custom-duration-row text{color:#6b6860;flex:none}
.order-select-head{display:flex;align-items:center;justify-content:space-between;gap:16rpx}.clear-orders{margin:0;padding:0 12rpx;min-height:48rpx;line-height:48rpx;background:transparent;color:#41775b;font-size:24rpx}.clear-orders::after,.trip-order::after{border:0}.trip-order{display:flex;align-items:center;gap:18rpx;width:100%;margin:18rpx 0 0;padding:22rpx 18rpx;border:2rpx solid #e1e3dc;border-radius:20rpx;background:#fff;text-align:left;line-height:1.5;color:inherit}.trip-order.is-selected{border-color:#527b60;background:#eef5ee}.order-check{flex:none;width:34rpx;height:34rpx;border:2rpx solid #adb6ad;border-radius:8rpx;text-align:center;line-height:34rpx;color:transparent;font-size:27rpx}.is-selected .order-check{border-color:#527b60;background:#527b60;color:#fff}.order-copy{flex:1;min-width:0}.order-route{font-size:25rpx;font-weight:700;overflow-wrap:break-word}.order-meta,.order-time{font-size:22rpx;color:#777d73;margin-top:6rpx}.order-reward{flex:none;font-size:29rpx;font-weight:750;color:#41775b}.selection-summary{border-top:1rpx solid #e1e3dc;padding-top:20rpx;margin-top:22rpx;font-size:25rpx;font-weight:700}.order-empty{padding:25rpx 0 8rpx;color:#777d73;font-size:24rpx;line-height:1.6}.page-dark .trip-order{background:#252a28;border-color:#455047;color:#f0f2ee}.page-dark .trip-order.is-selected{background:#293e30;border-color:#80ae8a}.page-dark .order-meta,.page-dark .order-time{color:#bbc3b9}.page-dark .order-reward,.page-dark .clear-orders{color:#9dceaa}

.auth-steps{display:flex;gap:12rpx;margin-top:25rpx;font-size:22rpx;font-weight:700;color:#41775b}.auth-steps view{flex:1;border-top:8rpx solid #41775b;padding-top:12rpx}.auth-steps view+view{border-color:#e3e1d9;color:#888}.auth-steps .active{border-color:#41775b;color:#41775b}.apply-form .field{width:100%}.apply-form .btn{margin-bottom:0}.apply-status .flow-title{margin:8rpx 0}.status-dot{width:100rpx;height:100rpx;border-radius:50%;margin:15rpx auto 24rpx;line-height:100rpx;text-align:center;font-size:48rpx;font-weight:800}.pending-dot{background:#f1e4dc;color:#41775b}.rejected-dot{background:#eaf4ef;color:#3a6a50}.apply-line{padding:12rpx 0;border-bottom:1rpx solid #eeeee8}.apply-line:last-child{border-bottom:0}.apply-line .hint{margin:0}.link-hint{color:#41775b;font-weight:700;padding:16rpx 0}.rule-card{display:flex;gap:18rpx}.rule-check{font-size:35rpx;color:#41775b}.all-rules{border:2rpx solid #41775b;color:#41775b;font-weight:800}.all-checked{background:#41775b;color:white}.checked-rule{background:#f4f8f6;border-color:#b8cfc3}
.student-check-page.success-page{padding-bottom:250rpx}.success-actions{position:fixed;left:0;right:0;bottom:0;z-index:20;background:#fff;border-top:1rpx solid #e6e4dc;padding:18rpx 30rpx calc(20rpx + env(safe-area-inset-bottom));box-shadow:0 -6rpx 24rpx #0000000d}.success-actions .btn{display:block;width:100%;margin:0 auto 14rpx}.success-actions .btn:last-child{margin-bottom:0}.success-actions .primary-action{min-height:92rpx}

.phone-row{display:flex;align-items:center;gap:14rpx}.phone-row .phone-input{flex:1;min-width:0;margin:0}.phone-verify{flex:none;margin:0;padding:0 24rpx;height:80rpx;line-height:80rpx;border-radius:16rpx;background:#41775b;color:#fff;font-size:24rpx;font-weight:700;transition:background .2s,color .2s}.phone-verify::after{border:0}.phone-verify.done{background:#e3f2e8;color:#2f7a4c}.phone-state{margin:10rpx 0 4rpx}.phone-state.ok{color:#2f7a4c}

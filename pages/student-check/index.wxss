.auth-steps{display:flex;gap:12rpx;margin-top:25rpx;font-size:22rpx;font-weight:700;color:#0b7a55}.auth-steps view{flex:1;border-top:8rpx solid #0b7a55;padding-top:12rpx}.auth-steps view+view{border-color:#e2e0d9;color:#8a877e}.auth-steps .active{border-color:#0b7a55;color:#0b7a55}.apply-form .field{width:100%}.apply-form .btn{margin-bottom:0}.apply-status .flow-title{margin:8rpx 0}.status-dot{width:100rpx;height:100rpx;border-radius:50%;margin:15rpx auto 24rpx;line-height:100rpx;text-align:center;font-size:48rpx;font-weight:800}.pending-dot{background:#e7f3ed;color:#0b7a55}.rejected-dot{background:#e7f3ed;color:#0b7a55}.apply-line{padding:12rpx 0;border-bottom:1rpx solid #e2e0d9}.apply-line:last-child{border-bottom:0}.apply-line .hint{margin:0}.link-hint{color:#0b7a55;font-weight:700;padding:16rpx 0}.rule-card{display:flex;gap:18rpx}.rule-check{font-size:35rpx;color:#0b7a55}.all-rules{border:2rpx solid #0b7a55;color:#0b7a55;font-weight:800}.all-checked{background:#0b7a55;color:white}.checked-rule{background:#f3faf6;border-color:#cfe8dc}
.student-check-page.success-page{padding-bottom:150rpx}.success-actions{position:fixed;left:0;right:0;bottom:0;z-index:20;background:#fff;border-top:1rpx solid #e2e0d9;padding:18rpx 30rpx calc(20rpx + env(safe-area-inset-bottom));box-shadow:0 -6rpx 24rpx #0000000d}.success-actions .btn{display:block;width:100%;margin:0 auto 14rpx}.success-actions .btn:last-child{margin-bottom:0}.success-actions .primary-action{min-height:92rpx}

/* Runner application: clear fields and a single primary action. */
.student-check-page{padding:30rpx 30rpx calc(64rpx + env(safe-area-inset-bottom))}
.student-check-page .summary-head{padding:0;margin:0 0 24rpx;background:transparent}
.student-check-page .summary-head .flow-title{font-size:40rpx;line-height:1.3;margin:0}
.student-check-page .summary-head .flow-sub{font-size:24rpx;margin:10rpx 0 0}
.student-check-page .auth-steps{margin-top:26rpx;gap:14rpx;font-size:21rpx;line-height:1.4}
.student-check-page .auth-steps view{border-top-width:5rpx;padding-top:12rpx}
.student-check-page .apply-form{margin:0;padding:30rpx;border-radius:28rpx;border:1rpx solid #e2e0d9;background:#fff;box-shadow:none}
.apply-form-head{display:flex;align-items:baseline;justify-content:space-between;gap:16rpx;margin-bottom:26rpx}
.apply-form-head .strong{font-size:29rpx;line-height:1.4}
.apply-required{font-size:20rpx;color:#8a877e;line-height:1.4;text-align:right}
.application-field+.application-field{margin-top:24rpx}
.apply-form .field-label{margin:0 0 12rpx;font-size:25rpx;font-weight:650;color:#44423c;line-height:1.4}
.apply-form .field{display:block;box-sizing:border-box;width:100%;height:88rpx;min-height:88rpx;margin:0;padding:0 24rpx;border:2rpx solid transparent;border-radius:18rpx;background:#f7f6f2;color:#16181c;font-size:28rpx;line-height:normal}
.apply-form .field:focus{border-color:#a6d0be;background:#fff}
.runner-ph{color:#8a877e;font-weight:400}
.runner-gender-row{display:flex;gap:16rpx}
.runner-gender-option{display:flex;align-items:center;justify-content:space-between;gap:12rpx;flex:1;min-width:0;height:88rpx;min-height:88rpx;padding:0 24rpx;margin:0;border:2rpx solid #e2e0d9;border-radius:18rpx;background:#f7f6f2;color:#5e5c55;font-size:27rpx;font-weight:650;line-height:1.4;transition:background .18s,color .18s,border-color .18s,transform .15s}
.runner-gender-option.selected{background:#e7f3ed;border-color:#0b7a55;color:#0b7a55}
.gender-check{display:flex;align-items:center;justify-content:center;flex:none;width:30rpx;height:30rpx;border:2rpx solid #d3cfc4;border-radius:50%;font-size:20rpx;line-height:1;background:transparent;color:transparent}
.selected .gender-check{border-color:#0b7a55;background:#0b7a55;color:#fff}
.runner-privacy{display:flex;align-items:flex-start;gap:10rpx;margin-top:26rpx;color:#6b6860;font-size:22rpx;line-height:1.5}
.runner-privacy image{flex:none;width:25rpx;height:27rpx;margin-top:2rpx}
.apply-form .runner-submit{display:flex;align-items:center;justify-content:center;width:100%;min-height:92rpx;margin:26rpx 0 0;padding:20rpx 24rpx;border-radius:20rpx;background:#0b7a55;color:#fff;font-size:28rpx;font-weight:750;line-height:1.4;transition:transform .15s,opacity .15s}
.runner-option-press{transform:scale(.985);opacity:.85}
.apply-form .runner-submit[disabled]{background:#e4e1d8;color:#8a877e}
.student-check-page .apply-line{padding:17rpx 0;gap:20rpx}
.student-check-page .apply-line .strong{text-align:right;overflow-wrap:anywhere}
.page-dark.student-check-page .apply-form{background:#242522!important;border-color:#3a3b37!important}
.page-dark.student-check-page .apply-form .field{background:#1b1c1a!important;border-color:#3a3b37!important;color:#edebe4!important}
.page-dark.student-check-page .field-label{color:#edebe4}
.page-dark.student-check-page .apply-required,.page-dark.student-check-page .runner-privacy{color:#a9a69c}
.page-dark .runner-gender-option{background:#1b1c1a;border-color:#3a3b37;color:#a9a69c}
.page-dark .runner-gender-option.selected{background:#16332a;border-color:#6fd0a8;color:#6fd0a8}
.page-dark .gender-check{border-color:#5e5c55}
.page-dark .selected .gender-check{background:#6fd0a8;border-color:#6fd0a8;color:#16181c}
.page-dark.student-check-page .runner-submit{background:#6fd0a8;color:#16181c}
.page-dark.student-check-page .auth-steps view{border-color:#6fd0a8;color:#6fd0a8}
.page-dark.student-check-page .auth-steps view+view{border-color:#3a3b37;color:#a9a69c}
.page-dark.student-check-page .auth-steps .active{border-color:#6fd0a8;color:#6fd0a8}

<view class="v8-page student-check-page {{stage==='success'?'success-page':''}}"><view class="summary-head"><view class="flow-title">Become a runner</view><view class="flow-sub">Before your first trip · one time, about 2 minutes</view><view class="auth-steps"><view>1 · Student check</view><view class="{{stage==='rules'||stage==='success'?'active':''}}">2 · Rules</view></view></view><yuni-assistant topic="runner" stage="{{stage}}"/><view wx:if="{{error}}" class="notice-error">{{error}}</view>
<block wx:if="{{stage==='profile'}}"><view class="flow-card"><view class="strong">Register your student information</view><button class="btn" bindtap="profile">Enter name and phone</button></view></block>
<block wx:elif="{{stage==='rules'}}"><view class="row hint"><text>Read the rules, then agree</text><text>{{ruleCount}} of 5</text></view><view class="flow-card all-rules {{ruleCount===5?'all-checked':''}}" data-index="-1" bindtap="rule">{{ruleCount===5?'☑':'□'}} I agree to all 5 rules</view><view wx:for="{{rules}}" wx:key="title" class="flow-card rule-card {{ruleChecks[index]?'checked-rule':''}}" data-index="{{index}}" bindtap="rule"><text class="rule-check">{{ruleChecks[index]?'☑':'□'}}</text><view><view class="strong">{{item.title}}</view><view class="hint">{{item.body}}</view></view></view><button class="btn" disabled="{{ruleCount!==5||busy}}" loading="{{busy}}" bindtap="finish">{{ruleCount===5?'Finish sign-up':'Tick all 5 rules ('+ruleCount+' of 5)'}}</button></block>
<block wx:elif="{{stage==='success'}}"><view class="flow-card center"><view class="big-check">✓</view><view class="flow-title">You’re a runner</view><view class="hint">Your student identity is checked and the rules are agreed. You can take jobs now.</view></view><view class="flow-card"><view class="row strong"><text>Your level</text><text>{{level}} · up to ¥{{limit}} per trip</text></view><view class="progress-track"><view class="progress-fill" style="width:{{progress}}%"/></view><view class="hint">{{remaining}} completed jobs to the next level.</view></view><view wx:if="{{suggestion}}" class="flow-card"><view class="strong">Open near you now</view><view class="hint">{{suggestion.station}} → {{suggestion.dorm}} · ¥{{suggestion.reward}}</view></view><view class="success-actions"><button class="btn primary-action" bindtap="startTrip">Start my trip</button><button class="btn light" bindtap="jobs">See jobs near me</button></view></block>
<block wx:else><view class="green-note">Runners see other students’ names, rooms and phone numbers, so every runner is a checked XJTLU student.</view><view class="section">How do you want to check?</view><view class="auth-methods"><view class="flow-card {{method==='email'?'method-active':''}}" data-value="email" bindtap="switchMethod"><text class="badge">Email code</text><view class="strong">Student email</view><view class="hint">We send a code to your XJTLU address</view></view><view class="flow-card {{method==='card'?'method-active':''}}" data-value="card" bindtap="switchMethod"><text class="badge">Photo</text><view class="strong">Student card</view><view class="hint">Read your card with OCR</view></view></view><view wx:if="{{method==='email'}}" class="flow-card"><view class="strong">Your student email</view><view class="email-row"><input class="field" value="{{prefix}}" data-field="prefix" bindinput="field" placeholder="e.g.Zhangsan.25" disabled="{{busy}}"/><text>@student.xjtlu.edu.cn</text></view><button class="btn" bindtap="sendCode" disabled="{{busy}}" loading="{{busy}}">{{codeSent?'Resend code':'Send code'}}</button><block wx:if="{{codeSent}}"><view class="hint">We sent a 6-digit code. Check junk mail too.</view><view class="row"><input class="field" type="number" maxlength="6" placeholder="6-digit code" value="{{code}}" data-field="code" bindinput="field"/><button class="btn" bindtap="checkCode" disabled="{{busy}}">Check</button></view></block><view class="hint">Email is used only for registration verification.</view></view><view wx:else class="flow-card"><view class="hint">{{reason||readHelp||'Use a clear photo of your own student card. Your profile name must match.'}}</view><view bindtap="toggleConsent">{{consent?'☑':'□'}} I agree to send this card for text recognition.</view><button class="btn" bindtap="scan" disabled="{{busy||!consent}}" loading="{{busy}}">Upload student card</button></view></block></view>

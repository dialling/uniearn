<lang-switch/>
<view class="v8-page student-check-page {{stage==='success'?'success-page':''}} {{darkClass}}"><view class="summary-head"><view class="flow-title">{{zh?'成为跑手':'Become a runner'}}</view><view class="flow-sub">{{zh?'首次接单前完成 · 只需一次':'Before your first trip · one time only'}}</view><view class="auth-steps"><view>1 · {{zh?'提交申请':'Apply'}}</view><view class="{{stage==='pending'||stage==='rules'||stage==='success'?'active':''}}">2 · {{zh?'管理员审核':'Admin review'}}</view><view class="{{stage==='rules'||stage==='success'?'active':''}}">3 · {{zh?'规则':'Rules'}}</view></view></view><yuni-assistant topic="runner" stage="{{stage}}"/><view wx:if="{{error}}" class="notice-error">{{error}}</view>
<block wx:if="{{stage==='profile'}}"><view class="flow-card"><view class="strong">{{zh?'先登记你的个人信息':'Register your student information'}}</view><button class="btn" bindtap="profile">{{zh?'填写姓名和手机号':'Enter name and phone'}}</button></view></block>
<block wx:elif="{{stage==='pending'}}"><view class="flow-card center apply-status"><view class="status-dot pending-dot">…</view><view class="flow-title">{{zh?'申请审核中':'Application under review'}}</view><view class="hint">{{zh?'管理员会核对你的姓名、手机号和学号，通过后即可阅读规则并开始接单。':'An admin will check your name, phone and student ID. Once approved, read the rules and start taking jobs.'}}</view></view><view class="flow-card"><view class="row apply-line"><text class="hint">{{zh?'真实姓名':'Real name'}}</text><text class="strong">{{studentName}}</text></view><view class="row apply-line"><text class="hint">{{zh?'学号':'Student ID'}}</text><text class="strong">•••{{last4}}</text></view><view class="row apply-line"><text class="hint">{{zh?'提交时间':'Submitted'}}</text><text>{{submittedAt}}</text></view></view><button class="btn" bindtap="refresh" loading="{{busy}}" disabled="{{busy}}">{{zh?'刷新审核状态':'Check status'}}</button><button class="btn light" bindtap="reapply">{{zh?'修改申请信息':'Edit application'}}</button><view class="hint center link-hint" bindtap="support">{{zh?'复制账号编号，联系管理员':'Copy account reference for an admin'}}</view></block>
<block wx:elif="{{stage==='rejected'}}"><view class="flow-card center apply-status"><view class="status-dot rejected-dot">!</view><view class="flow-title">{{zh?'申请未通过':'Application not approved'}}</view><view class="hint">{{reason}}</view></view><button class="btn" bindtap="reapply">{{zh?'重新提交申请':'Apply again'}}</button><view class="hint center link-hint" bindtap="support">{{zh?'复制账号编号，联系管理员':'Copy account reference for an admin'}}</view></block>
<block wx:elif="{{stage==='rules'}}"><view class="row hint"><text>{{zh?'阅读规则后勾选同意':'Read the rules, then agree'}}</text><text>{{zh?ruleCount+' / 5':ruleCount+' of 5'}}</text></view><view class="flow-card all-rules {{ruleCount===5?'all-checked':''}}" data-index="-1" bindtap="rule">{{ruleCount===5?'☑':'□'}} {{zh?'我同意全部 5 条规则':'I agree to all 5 rules'}}</view><view wx:for="{{rules}}" wx:key="title" class="flow-card rule-card {{ruleChecks[index]?'checked-rule':''}}" data-index="{{index}}" bindtap="rule"><text class="rule-check">{{ruleChecks[index]?'☑':'□'}}</text><view><view class="strong">{{item.title}}</view><view class="hint">{{item.body}}</view></view></view><button class="btn" disabled="{{ruleCount!==5||busy}}" loading="{{busy}}" bindtap="finish">{{zh?(ruleCount===5?'完成注册':'请勾选全部 5 条规则（'+ruleCount+' / 5）'):ruleCount===5?'Finish sign-up':'Tick all 5 rules ('+ruleCount+' of 5)'}}</button></block>
<block wx:elif="{{stage==='success'}}"><view class="flow-card center"><view class="big-check">✓</view><view class="flow-title">{{zh?'你已成为跑手':'You’re a runner'}}</view><view class="hint">{{zh?'学生身份已核验，规则也已同意，现在可以接单了。':'Your student identity is checked and the rules are agreed. You can take jobs now.'}}</view></view><view class="flow-card"><view class="row strong"><text>{{zh?'你的等级':'Your level'}}</text><text>{{zh?(level==='Top'?'顶级':level==='Trusted'?'可信':'新手')+' · '+(limit==='No limit'?'每趟不限金额':'每趟最高 ¥'+limit):level+' · up to ¥'+limit+' per trip'}}</text></view><view class="progress-track"><view class="progress-fill" style="width:{{progress}}%"/></view><view class="hint">{{zh?'再完成 '+remaining+' 单即可升级。':remaining+' completed jobs to the next level.'}}</view></view><view wx:if="{{suggestion}}" class="flow-card"><view class="strong">{{zh?'附近待接的任务':'Open near you now'}}</view><view class="hint">{{suggestion.station}} → {{suggestion.dorm}} · ¥{{suggestion.reward}}</view></view><view class="success-actions"><button class="btn primary-action" bindtap="startTrip">{{zh?'开始我的行程':'Start my trip'}}</button><button class="btn light" bindtap="jobs">{{zh?'查看附近任务':'See jobs near me'}}</button></view></block>
<block wx:else><view class="green-note">{{zh?'跑手会看到同学的姓名、房间和手机号，所以每位跑手都要经过管理员审核。':'Runners see other students’ names, rooms and phone numbers, so every runner is reviewed by an admin.'}}</view><view class="flow-card apply-form"><view class="strong">{{zh?'填写申请信息':'Your application'}}</view><view class="field-label">{{zh?'真实姓名':'Real name'}}</view><input class="field" maxlength="40" value="{{form.realName}}" data-field="realName" bindinput="field" placeholder="{{zh?'与学生证一致':'As on your student card'}}" disabled="{{busy}}"/><view class="field-label">{{zh?'性别（真实性别）':'Gender'}}</view><view class="pill-row"><view class="pill {{form.gender==='male'?'selected':''}}" data-gender="male" bindtap="chooseGender">{{zh?'男':'Male'}}</view><view class="pill {{form.gender==='female'?'selected':''}}" data-gender="female" bindtap="chooseGender">{{zh?'女':'Female'}}</view></view><view class="field-label">{{zh?'手机号':'Phone number'}}</view><view class="phone-row"><input class="field phone-input" type="number" maxlength="11" value="{{form.phone}}" data-field="phone" bindinput="field" placeholder="{{zh?'11 位手机号':'11-digit mobile number'}}" disabled="{{busy}}"/><button class="phone-verify {{verifiedPhone&&form.phone===verifiedPhone?'done':''}}" open-type="getPhoneNumber" bindgetphonenumber="wechatPhone" loading="{{phoneBusy}}" disabled="{{busy||phoneBusy}}">{{verifiedPhone&&form.phone===verifiedPhone?(zh?'✓ 已验证':'✓ Verified'):(zh?'微信验证':'Verify')}}</button></view><view class="hint phone-state {{verifiedPhone&&form.phone===verifiedPhone?'ok':''}}">{{verifiedPhone&&form.phone===verifiedPhone?(zh?'号码来自微信，已确认是你本人的手机号。':'Number from WeChat, confirmed as yours.'):(zh?'推荐用微信验证；手动填写的号码需要管理员人工核对。':'Verify with WeChat. Typed numbers are checked manually by an admin.')}}</view><view class="field-label">{{zh?'学号':'Student ID'}}</view><input class="field" type="number" maxlength="12" value="{{form.studentId}}" data-field="studentId" bindinput="field" placeholder="{{zh?'例如 2512345':'e.g. 2512345'}}" disabled="{{busy}}"/><view class="hint">{{zh?'这些信息只用于管理员审核，不会展示给其他同学。':'Only admins see these details for review. Other students never see them.'}}</view><button class="btn" bindtap="submit" disabled="{{busy}}" loading="{{busy}}">{{zh?'提交申请':'Submit application'}}</button></view></block></view>

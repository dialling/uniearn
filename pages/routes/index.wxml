<view class="flow-page"><view class="flow-title">{{parcel?'Saved parcel addresses':'Saved routes'}}</view><view class="flow-sub">{{parcel?'Where to deliver, who to call':'Where to collect, where to deliver, who to call'}}</view><view wx:for="{{routes}}" wx:key="id" class="flow-card"><view class="row"><view class="route">{{item.name}}</view><text wx:if="{{item.default}}" class="badge green">Default</text></view><view class="strong">{{parcel?'':item.station+' → '}}{{item.display}}</view><view class="hint">{{item.owner}} · {{item.phone}}</view><view class="hint">{{item.dropNote}}</view><view class="action-row"><button class="btn light" data-id="{{item.id}}" bindtap="edit">Edit</button><button class="btn light" data-id="{{item.id}}" bindtap="default">Set default</button></view><text class="link" data-id="{{item.id}}" bindtap="remove">Delete</text></view><view wx:if="{{!routes.length}}" class="flow-card empty">{{parcel?'Save a parcel address to use next time.':'Add a route once, then use it every time you post.'}}</view><button class="btn" bindtap="new">＋ {{parcel?'New address':'New route'}}</button></view><yuni-assistant topic=""/>

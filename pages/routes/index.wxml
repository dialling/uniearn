<lang-switch/>
<view class="flow-page {{darkClass}}"><view class="flow-title">{{zh?(parcel?'常用快递地址':'常用路线'):parcel?'Saved parcel addresses':'Saved routes'}}</view><view class="flow-sub">{{zh?(parcel?'送到哪里、联系谁':'在哪里取、送到哪里、联系谁'):parcel?'Where to deliver, who to call':'Where to collect, where to deliver, who to call'}}</view><view wx:for="{{routes}}" wx:key="id" class="flow-card"><view class="row"><view class="route">{{item.nameLabel}}</view><text wx:if="{{item.default}}" class="badge green">{{zh?'默认':'Default'}}</text></view><view class="strong">{{parcel?'':item.station+' → '}}{{item.display}}</view><view class="hint">{{item.owner}} · {{item.phone}}</view><view class="hint">{{item.dropNoteLabel}}</view><view class="action-row"><button class="btn light" data-id="{{item.id}}" bindtap="edit">{{zh?'编辑':'Edit'}}</button><button class="btn light" data-id="{{item.id}}" bindtap="default">{{zh?'设为默认':'Set default'}}</button></view><text class="link" data-id="{{item.id}}" bindtap="remove">{{zh?'删除':'Delete'}}</text></view><view wx:if="{{!routes.length}}" class="flow-card empty">{{zh?(parcel?'保存快递地址，下次直接使用。':'添加一次常用路线，以后发布时都能直接使用。'):parcel?'Save a parcel address to use next time.':'Add a route once, then use it every time you post.'}}</view><button class="btn" bindtap="new">＋ {{zh?(parcel?'新增地址':'新增路线'):parcel?'New address':'New route'}}</button></view><yuni-assistant topic=""/>

<lang-switch/>
<view class="v8-page {{darkClass}}" wx:if="{{request}}"><view class="flow-card center"><view class="big-check">✓</view><view class="flow-title">{{request.category==='takeout'?ui.posted:ui.parcelAdded}}</view><view class="hint">{{request.category==='takeout'?ui.onBoard:ui.queuePre+(ui.labels[request.station]||request.station)+ui.queuePost}}</view></view><view class="flow-card"><view class="row"><text>{{ui.route}}</text><text class="strong">{{ui.labels[request.station]||request.station}} → {{ui.labels[request.dorm]||request.dorm}}</text></view><view class="row hint" wx:if="{{request.category==='takeout'}}"><text>{{ui.foodArrives}}</text><text class="strong">{{request.arrivalLabel}}</text></view><view class="row hint"><text>{{request.category==='takeout'?ui.bags:ui.parcels}}</text><text>{{request.boxes}}</text></view><view class="row hint"><text>{{request.category==='takeout'?ui.closes:ui.deliverBy}}</text><text>{{request.closeTime==='—'?request.deadline:request.closeTime}}</text></view><view class="divider"/><view class="row strong"><text>{{ui.testTotal}}</text><text>¥{{request.total}}</text></view></view><button wx:if="{{request.category==='takeout'}}" class="btn orange" bindtap="track">{{ui.track}}</button><block wx:else><view wx:if="{{stage==='choice'}}" class="flow-card"><view class="hint">{{zh?(ui.labels[request.station]||request.station)+' 还有 '+otherCount+' 个送往 '+(ui.labels[request.dorm]||request.dorm)+' 的需求':otherCount+' other requests at '+request.station+' for '+request.dorm}}</view><view class="flow-title">{{ui.yourself}}</view><view class="hint">{{ui.bringOthers}}</view><view class="strong">{{ui.upToPre}}{{otherReward}}{{ui.upToPost}}</view><button class="btn" bindtap="go">{{ui.going}}</button><button class="btn outline" bindtap="notNow">{{ui.notNow}}</button></view><block wx:else><view class="flow-card"><view class="strong">{{ui.keepUpdated}}</view><view class="menu-row"><text>{{ui.whenTaken}}</text><switch color="#31584f" checked="{{notifications.orderUpdates!==false}}" data-key="orderUpdates" bindchange="preference"/></view><view class="menu-row"><text>{{ui.whenDelivered}}</text><switch color="#31584f" checked="{{notifications.deliveredUpdates!==false}}" data-key="deliveredUpdates" bindchange="preference"/></view><view class="menu-row"><text>{{ui.whenRunner}}</text><switch color="#31584f" checked="{{notifications.nearbyTrip}}" data-key="nearbyTrip" bindchange="preference"/></view><view class="hint">{{ui.prefHint}}</view></view><button class="btn orange" bindtap="done">{{ui.done}}</button></block></block></view><view wx:if="{{celebrate&&request}}" class="yuni-mask" bindtap="closeCelebrate" catchtouchmove="noop"><view class="yuni-pop" catchtap="noop"><view class="yuni-badge">{{request.night?ui.typeNight:request.category==='takeout'?ui.typeTakeout:ui.typeParcel}}</view><view class="yuni-mark"><view class="yuni-tick"/></view><view class="yuni-title">{{ui.success}}</view><view class="yuni-sub">{{ui.waitingRunner}}</view><view class="yuni-stage"><video wx:if="{{videoSrc&&!videoFailed}}" class="yuni-video" src="{{videoSrc}}" autoplay muted loop="{{false}}" controls="{{false}}" show-center-play-btn="{{false}}" show-play-btn="{{false}}" show-fullscreen-btn="{{false}}" show-progress="{{false}}" show-mute-btn="{{false}}" enable-progress-gesture="{{false}}" object-fit="cover" binderror="videoError"/><image wx:if="{{videoFailed}}" class="yuni-still" src="/assets/yuni-happy.png" mode="aspectFit"/></view><view class="yuni-foot"><view class="yuni-foot-main"><view class="yuni-route">{{ui.labels[request.station]||request.station}} → {{ui.labels[request.dorm]||request.dorm}}</view><view class="yuni-meta">{{request.night?ui.typeNight:request.category==='takeout'?ui.typeTakeout:ui.typeParcel}} · {{request.boxes}}{{request.category==='takeout'?ui.bagUnit:ui.parcelUnit}} · ¥{{request.total}}</view></view><view class="yuni-pill">{{ui.pending}}</view></view><view class="yuni-cta" bindtap="track">{{ui.viewOrder}}<text class="yuni-arrow">›</text></view></view></view><app-nav id="app-nav" active="requests"/><yuni-assistant topic=""/>

<lang-switch/>
<view class="v8-page" wx:if="{{request}}"><view class="flow-card center"><view class="big-check">✓</view><view class="flow-title">{{request.category==='takeout'?ui.posted:ui.parcelAdded}}</view><view class="hint">{{request.category==='takeout'?ui.onBoard:ui.queuePre+(ui.labels[request.station]||request.station)+ui.queuePost}}</view></view><view class="flow-card"><view class="row"><text>{{ui.route}}</text><text class="strong">{{ui.labels[request.station]||request.station}} → {{ui.labels[request.dorm]||request.dorm}}</text></view><view class="row hint" wx:if="{{request.category==='takeout'}}"><text>{{ui.foodArrives}}</text><text class="strong">{{request.arrivalLabel}}</text></view><view class="row hint"><text>{{request.category==='takeout'?ui.bags:ui.parcels}}</text><text>{{request.boxes}}</text></view><view class="row hint"><text>{{request.category==='takeout'?ui.closes:ui.deliverBy}}</text><text>{{request.closeTime==='—'?request.deadline:request.closeTime}}</text></view><view class="divider"/><view class="row strong"><text>{{ui.testTotal}}</text><text>¥{{request.total}}</text></view></view><button wx:if="{{request.category==='takeout'}}" class="btn orange" bindtap="track">{{ui.track}}</button><block wx:else><view wx:if="{{stage==='choice'}}" class="flow-card"><view class="hint">{{zh?(ui.labels[request.station]||request.station)+' 还有 '+otherCount+' 个送往 '+(ui.labels[request.dorm]||request.dorm)+' 的需求':otherCount+' other requests at '+request.station+' for '+request.dorm}}</view><view class="flow-title">{{ui.yourself}}</view><view class="hint">{{ui.bringOthers}}</view><view class="strong">{{ui.upToPre}}{{otherReward}}{{ui.upToPost}}</view><button class="btn" bindtap="go">{{ui.going}}</button><button class="btn outline" bindtap="notNow">{{ui.notNow}}</button></view><block wx:else><view class="flow-card"><view class="strong">{{ui.keepUpdated}}</view><view class="menu-row"><text>{{ui.whenTaken}}</text><switch color="#31584f" checked="{{notifications.orderUpdates!==false}}" data-key="orderUpdates" bindchange="preference"/></view><view class="menu-row"><text>{{ui.whenDelivered}}</text><switch color="#31584f" checked="{{notifications.deliveredUpdates!==false}}" data-key="deliveredUpdates" bindchange="preference"/></view><view class="menu-row"><text>{{ui.whenRunner}}</text><switch color="#31584f" checked="{{notifications.nearbyTrip}}" data-key="nearbyTrip" bindchange="preference"/></view><view class="hint">{{ui.prefHint}}</view></view><button class="btn orange" bindtap="done">{{ui.done}}</button></block></block></view><app-nav active="requests"/><yuni-assistant topic=""/>

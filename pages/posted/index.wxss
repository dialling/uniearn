.yuni-mask{position:fixed;left:0;top:0;right:0;bottom:0;z-index:999;background:rgba(27,28,26,.56);display:flex;align-items:center;justify-content:center;animation:yuni-fade .42s ease-out both}
.yuni-pop{position:relative;box-sizing:border-box;width:600rpx;max-width:calc(100vw - 64rpx);max-height:calc(100vh - 64rpx - env(safe-area-inset-top) - env(safe-area-inset-bottom));overflow-y:auto;padding:28rpx 26rpx 24rpx;border-radius:32rpx;background:#fafaf7;color:#16181c;box-shadow:0 40rpx 100rpx rgba(27,28,26,.36);display:flex;flex-direction:column;align-items:center;animation:yuni-rise .64s cubic-bezier(.34,1.45,.64,1) .12s both}
.yuni-badge{position:absolute;top:26rpx;right:26rpx;height:38rpx;line-height:38rpx;padding:0 16rpx;border-radius:999rpx;background:#fff1e6;color:#c2410c;font-size:21rpx;font-weight:650;letter-spacing:1rpx;animation:yuni-in .34s ease-out .5s both}
.yuni-mark{width:64rpx;height:64rpx;border-radius:50%;background:#c2410c;display:flex;align-items:center;justify-content:center;box-shadow:0 12rpx 26rpx rgba(194,65,12,.24);animation:yuni-pop .4s cubic-bezier(.3,1.8,.6,1) .34s both}
.yuni-tick{width:16rpx;height:28rpx;margin-top:-6rpx;border-right:6rpx solid #fff;border-bottom:6rpx solid #fff;border-radius:2rpx;transform:rotate(45deg)}
.yuni-title{margin-top:14rpx;font-size:40rpx;font-weight:700;letter-spacing:2rpx;animation:yuni-in .38s ease-out .42s both}
.yuni-sub{margin-top:6rpx;font-size:24rpx;color:#6b6860;animation:yuni-in .38s ease-out .5s both}
.yuni-stage{flex-shrink:0;margin-top:20rpx;width:100%;height:412rpx;border-radius:24rpx;overflow:hidden;background:#fff1e6;animation:yuni-in .42s ease-out .55s both}
.yuni-stage{display:flex;align-items:center;justify-content:center}.yuni-video{display:block;width:100%;height:100%}.yuni-still{width:260rpx;height:293rpx;animation:yuni-hop 1.2s ease-in-out .8s infinite}
.yuni-foot{width:100%;margin-top:18rpx;padding-top:18rpx;border-top:1rpx solid #f0eee8;display:flex;align-items:center;justify-content:space-between;gap:16rpx;animation:yuni-in .4s ease-out .66s both}
.yuni-foot-main{min-width:0;flex:1}
.yuni-route{font-size:26rpx;font-weight:700;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.yuni-meta{margin-top:6rpx;font-size:22rpx;color:#8a877e}
.yuni-pill{flex:none;height:46rpx;line-height:46rpx;padding:0 20rpx;border-radius:999rpx;background:#fff1e6;color:#c2410c;font-size:22rpx;font-weight:650}
.yuni-cta{flex-shrink:0;width:100%;height:88rpx;margin-top:18rpx;border-radius:22rpx;background:#c2410c;color:#fff;display:flex;align-items:center;justify-content:center;gap:10rpx;font-size:31rpx;font-weight:650;letter-spacing:1.5rpx;box-shadow:0 16rpx 32rpx rgba(194,65,12,.24);animation:yuni-in .42s ease-out .74s both,yuni-pulse 1.6s ease-in-out 5.2s infinite}
.yuni-arrow{font-size:34rpx;opacity:.86}
@keyframes yuni-fade{from{opacity:0}to{opacity:1}}
@keyframes yuni-rise{from{opacity:0;transform:translateY(120rpx) scale(.94)}to{opacity:1;transform:none}}
@keyframes yuni-pop{from{transform:scale(0)}to{transform:scale(1)}}
@keyframes yuni-in{from{opacity:0;transform:translateY(14rpx)}to{opacity:1;transform:none}}
@keyframes yuni-hop{0%,100%{transform:translateY(0)}50%{transform:translateY(-16rpx)}}@keyframes yuni-pulse{0%,100%{transform:scale(1)}50%{transform:scale(1.03)}}

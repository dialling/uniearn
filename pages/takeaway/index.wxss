/* 2026-11-15 Figma: 3D icon on Your details; say why Join is off */
.jt-you-name{display:flex;align-items:center;gap:12rpx}
.jt-you-icon{width:52rpx;height:52rpx;padding:6rpx;box-sizing:border-box;border-radius:16rpx;background:#fdeee4}
.jt-error{margin:2rpx 0 6rpx;padding:12rpx 16rpx;border-radius:16rpx;background:#fff1ec;color:#b4501f;font-size:23rpx;font-weight:700;line-height:1.4}

/* 2026-11-15: each detail row carries its own 3D icon */
.jt-row{gap:16rpx;padding-left:18rpx}
.jt-row-icon{flex:none;width:56rpx;height:56rpx}
.jt-row-label{width:auto;min-width:88rpx}
.jt-pick-value{flex:1;min-width:0;padding:20rpx 0;font-size:29rpx;font-weight:700;line-height:1.4;color:#16181c;text-align:right}
.jt-pick-value.empty{color:#a8a59c;font-weight:500}
.jt-row-need{border-color:#f3c9ae}
.page-dark .jt-pick-value{color:#edebe4}
/* 2026-11-17: card 1 reads as a route, the same language as Start a trip: a 3D pin for where the food is picked up,
   a dotted line, and a pin for where it goes. Details (note, soup, photos) follow below a soft divider. */
.takeaway-page.tw-v2 .tw-route{margin-top:2rpx}
.takeaway-page.tw-v2 .tw-stop{display:flex;gap:18rpx}
.takeaway-page.tw-v2 .tw-rail{flex:none;width:60rpx;display:flex;flex-direction:column;align-items:center}
.takeaway-page.tw-v2 .tw-pin{flex:none;width:58rpx;height:58rpx;margin-top:2rpx}
.takeaway-page.tw-v2 .tw-dots{flex:1;min-height:36rpx;width:0;margin:10rpx 0 2rpx;border-left:4rpx dotted #e9c6ad}
.takeaway-page.tw-v2 .tw-stop-body{flex:1;min-width:0;padding-bottom:30rpx}
.takeaway-page.tw-v2 .tw-stop-last .tw-stop-body{padding-bottom:4rpx}
.takeaway-page.tw-v2 .tw-stop-body > .field-label:first-child{margin-top:12rpx}
.takeaway-page.tw-v2 .tw-route .addr-label{display:flex;align-items:center;margin:12rpx 0 14rpx;font-size:26rpx;font-weight:800;color:#16181c}
.takeaway-page.tw-v2 .tw-route .addr-manage{margin-left:auto}
.takeaway-page.tw-v2 .tw-route .tw-sum-icon{display:none}
.takeaway-page.tw-v2 .tw-route .hint{margin-top:10rpx;font-size:22rpx}
.takeaway-page.tw-v2 .tw-route-solo .tw-stop-body{padding-bottom:4rpx}
.page-dark .takeaway-page.tw-v2 .tw-route .addr-label,.takeaway-page.tw-v2.page-dark .tw-route .addr-label{color:#edebe4}
/* Soup or drinks: an on/off switch on the right instead of a small checkbox. */
.takeaway-page.tw-v2 .note-soup .soup-inline{display:flex;align-items:center;gap:20rpx}
.takeaway-page.tw-v2 .note-soup .check{order:2;flex:none;position:relative;width:84rpx;height:48rpx;margin:0 0 0 auto;border:0;border-radius:99rpx;background:#dcd8cf;font-size:0;color:transparent;transition:var(--ue-transition,background-color .2s ease)}
.takeaway-page.tw-v2 .note-soup .check::after{content:'';position:absolute;top:6rpx;left:6rpx;width:36rpx;height:36rpx;border-radius:50%;background:#fff;box-shadow:0 2rpx 6rpx rgba(22,24,28,.2);transition:var(--ue-transition,transform .22s cubic-bezier(.3,1.3,.5,1))}
.takeaway-page.tw-v2 .note-soup .check.checked{background:#c2410c}
.takeaway-page.tw-v2 .note-soup .check.checked::after{transform:translateX(36rpx)}
.page-dark .takeaway-page.tw-v2 .note-soup .check,.takeaway-page.tw-v2.page-dark .note-soup .check{background:#3a3b37}
/* 2026-11-17 v3: icon headings, address-first route, a runner-details card with quick note chips, and price + bill in one card. */
.takeaway-page.tw-v2 .tw-head-icon{flex:none;width:52rpx;height:52rpx;margin:-4rpx 0}
.takeaway-page.tw-v2 .tw-first-hint{margin:2rpx 0 12rpx;padding:14rpx 18rpx;border-radius:18rpx;background:#fff7ef;color:#9a4a1c;font-size:23rpx;line-height:1.5}
.takeaway-page.tw-v2 .tw-details .note-photo-header{margin-top:4rpx}
.takeaway-page.tw-v2 .tw-details .note-soup{margin-top:22rpx}
.takeaway-page.tw-v2 .tw-first-label{margin-top:28rpx}
.takeaway-page.tw-v2 .tw-chips{display:flex;flex-wrap:wrap;gap:12rpx;margin-top:14rpx}
.takeaway-page.tw-v2 .tw-chip{padding:10rpx 20rpx;border-radius:99rpx;background:#f6f5f1;color:#44423c;font-size:23rpx;font-weight:650;line-height:1.35}
.takeaway-page.tw-v2 .tw-chip-press{background:#fdeee4;color:#c2410c}
.takeaway-page.tw-v2 .tw-bill{margin:26rpx -28rpx -30rpx;padding:22rpx 28rpx 28rpx;border-top:2rpx dashed #e6e1d7;background:transparent;border-radius:0;box-shadow:none}
.takeaway-page.tw-v2 .arrival-card .arrival-switch{margin-top:2rpx}
.page-dark .takeaway-page.tw-v2 .tw-chip,.takeaway-page.tw-v2.page-dark .tw-chip{background:#2c2d2a;color:#d8d5cc}
.page-dark .takeaway-page.tw-v2 .tw-first-hint,.takeaway-page.tw-v2.page-dark .tw-first-hint{background:#3a2416;color:#f4a06e}
.page-dark .takeaway-page.tw-v2 .tw-bill,.takeaway-page.tw-v2.page-dark .tw-bill{border-top-color:#3a3b37}

/* 2026-11-21: a trip to several buildings: the customer picks theirs here (one-building trips stay locked text) */
.jt-bld{display:flex;flex-wrap:wrap;gap:12rpx;margin-top:10rpx}
.jt-bld-chip{min-width:96rpx;box-sizing:border-box;padding:12rpx 22rpx;border-radius:18rpx;border:2rpx solid #e2e0d9;background:#fff;text-align:center;font-size:27rpx;font-weight:800;color:#3b3a35}
.jt-bld-chip.on{border-color:#0b7a55;background:#e7f3ed;color:#08523a}
.jt-bld-press{opacity:.7}
.page-dark .jt-bld-chip{background:#242522;border-color:#3a3b37;color:#c8c7bd}
.page-dark .jt-bld-chip.on{background:#1d2f28;border-color:#6fd0a8;color:#6fd0a8}

.trip-join-banner{margin:12rpx 0 0;padding:16rpx 20rpx;border-radius:16rpx;background:#e8f3ec;color:#1f6b4a;font-size:26rpx}

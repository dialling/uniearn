.addr-summary-top{display:flex;align-items:center;gap:16rpx}.addr-summary-top .addr-summary-place{flex:1;min-width:0}.addr-order-edit{flex:none;color:#c2410c;font-size:22rpx;font-weight:700;white-space:nowrap}.addr-order-edit:active{opacity:.6}.page-dark .addr-order-edit{color:#f4a06e}
.note-label{display:flex;align-items:center;gap:8rpx}.vis-tag{margin-left:auto;padding:2rpx 12rpx;border-radius:8rpx;font-size:20rpx;font-weight:650}.vis-tag.public{background:#e7f3ed;color:#0b7a55}.vis-tag.private{background:#fdf6f2;color:#c2410c}

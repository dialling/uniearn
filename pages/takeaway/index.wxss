@import "../../utils/post-form.wxss";
.route-line{border-left:3rpx solid #e7d9cb;padding-left:24rpx;margin:18rpx 0}.route-line .value{margin-bottom:18rpx}
.dash{border:2rpx dashed #c8ac9b;border-radius:18rpx;padding:20rpx;margin:18rpx 0}.thumb{width:140rpx;height:140rpx;border-radius:16rpx}
.bag-control{margin:18rpx 0}.bag-control>view:first-child{flex:1;min-width:0}.bag-control .hint{margin:4rpx 0}
.soup-control{display:flex;align-items:center;gap:12rpx;border:1rpx solid #e7d9cb;border-radius:18rpx;padding:18rpx;min-height:90rpx}.soup-control .hint{margin:2rpx 0}
.fee-control{margin:22rpx 0 4rpx}.fee-round{flex:none;width:72rpx;height:72rpx;line-height:72rpx;text-align:center;border-radius:50%;background:#efefeb;font-size:36rpx}.fee-value{flex:1;text-align:center;white-space:nowrap}.fee-value .amount{font-size:50rpx;font-weight:800}.fee-value .hint{font-size:24rpx}

.coupon-unavailable{opacity:.55;border-style:dashed}.coupon-block .pills{flex-wrap:wrap}

.address-card{margin-bottom:22rpx!important}.destination-column{width:57%}.room-column{flex:1;min-width:0}.orange-label{color:#8b1e2b!important;font-weight:700}.route-tag{background:#f9e9e6;border:1rpx solid #e9c9c6;color:#7a1a26;padding:6rpx 13rpx;border-radius:9rpx;font-size:22rpx}.drop-pills{flex-wrap:nowrap!important}.drop-pills .pill{flex:1;text-align:center;padding:12rpx 8rpx;font-size:23rpx}.bag-phone{text-align:center;flex:none}.phone-field{flex:1;min-width:0}.phone-digits{background:#2e211a;color:white;border-radius:12rpx;padding:8rpx 16rpx;letter-spacing:3rpx;font-weight:750}.save-route-choice{display:flex;align-items:flex-start;gap:16rpx;padding:20rpx;border:1rpx solid #e7d9cb;border-radius:18rpx;background:white;margin:24rpx 0}.save-route-choice .check{margin-top:6rpx}.save-route-choice>view{flex:1}.privacy-lock{margin-top:24rpx!important}.other-place-link{color:#8b1e2b;font-weight:650;margin:22rpx 0}.wechat-number{margin:8rpx 0 12rpx;padding:12rpx 20rpx;background:#f3faf3;border:1rpx solid #a6d8b4;color:#8b1e2b;border-radius:40rpx;font-size:23rpx;line-height:1.5;text-align:left}.wechat-number::after{border:0}.fee-value .price-input{display:inline-block;width:95rpx;height:60rpx;font-size:50rpx;font-weight:800;vertical-align:middle;text-align:center}.post-header{position:sticky;top:0;z-index:10}

.privacy-lock{display:flex;align-items:center;gap:12rpx}.lock-icon{width:24rpx;height:24rpx;flex:none}

.takeaway-page .phone-invalid{border:2rpx solid #b23a3a}.phone-error{font-size:24rpx;font-weight:650;color:#7a1a26;margin:12rpx 0 18rpx}

.takeaway-page .place-tag{background:#fff;border-color:#e7d9cb;color:#65645d}.formatted-phone{font-weight:600;letter-spacing:1rpx}



.note-soup{margin-top:14rpx}.soup-inline{min-height:0;padding:16rpx 18rpx;border:0;background:#f8f7f3;border-radius:18rpx}.soup-inline .check{flex:none}
.note-label{display:flex;align-items:center;gap:8rpx}.vis-tag{margin-left:auto;padding:2rpx 12rpx;border-radius:8rpx;font-size:20rpx;font-weight:650}.vis-tag.public{background:#eef3ef;color:#41775b}.vis-tag.private{background:#fdf2f0;color:#8b1e2b}
.arrival-switch{display:flex;gap:16rpx;margin:6rpx 0 18rpx}.arrival-opt{flex:1;height:84rpx;line-height:84rpx;text-align:center;border-radius:42rpx;border:2rpx solid #e3e1da;background:#fff;color:#4a4a45;font-weight:700;transition:background .22s ease,color .22s ease,border-color .22s ease,transform .15s ease}.arrival-opt:active{transform:scale(.96)}.arrival-opt.on{background:#8b1e2b;border-color:#8b1e2b;color:#fff;box-shadow:0 6rpx 16rpx rgba(139,30,43,.25)}
.arrival-box{padding:22rpx 24rpx;border-radius:22rpx;background:#f8f7f3;animation:ue-settle .25s ease backwards}
.arrival-row{margin-bottom:14rpx}.time-step{display:flex;align-items:center;gap:6rpx;padding:6rpx 10rpx;border-radius:40rpx;background:#fff;border:2rpx solid #e3e1da}.time-btn{width:60rpx;height:60rpx;line-height:58rpx;text-align:center;font-size:34rpx;color:#4a4a45;border-radius:50%;transition:background .15s}.time-btn:active{background:#f0efeb}.time-value{display:inline-block;min-width:110rpx;text-align:center;font-size:34rpx;font-weight:800;font-family:monospace;letter-spacing:1rpx}
.arrival-close{color:#5e5d57;font-size:24rpx;line-height:1.6}.time-strong{font-weight:800;font-family:monospace;color:#202126;margin:0 6rpx}
.arrival-note{display:flex;align-items:center;gap:12rpx}.arrival-yuni{flex:none;width:56rpx;height:56rpx}.arrival-pick{display:flex;align-items:center;gap:14rpx;height:72rpx;padding:0 26rpx;border-radius:36rpx;background:#fff;border:2rpx solid #e3e1da;font-weight:700;color:#202126}.arrival-pick:active{transform:scale(.97)}.arrival-at{font-family:monospace;font-weight:800;color:#8b1e2b}.arrival-pick .ue-chev{width:12rpx;height:12rpx;margin:-6rpx 0 0 2rpx;border-right:3rpx solid #a9a8a1;border-bottom:3rpx solid #a9a8a1;transform:rotate(45deg)}
.page-dark .arrival-opt{background:#2c332f;border-color:#465149;color:#edf1ed}.page-dark .arrival-opt.on{background:#8b1e2b;border-color:#8b1e2b}.page-dark .arrival-box{background:#2c332f}.page-dark .time-step{background:#232926;border-color:#465149}.page-dark .time-btn,.page-dark .time-strong{color:#edf1ed}.page-dark .arrival-close,.page-dark .arrival-pick{background:#232926;border-color:#465149;color:#edf1ed}

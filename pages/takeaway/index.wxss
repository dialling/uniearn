/* arrival: a quiet segmented switch instead of two big pills */
.takeaway-page.tw-v2 .arrival-switch{gap:6rpx;padding:6rpx;margin:0 0 18rpx;border-radius:22rpx;background:#f1f0eb}
.takeaway-page.tw-v2 .arrival-opt{height:72rpx;line-height:72rpx;border:0;border-radius:18rpx;background:transparent;color:#6b6860;font-size:26rpx}

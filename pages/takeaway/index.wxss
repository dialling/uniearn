@import "../../utils/post-form.wxss";
.purchase-options{display:flex;gap:16rpx}
.purchase-option{flex:1;min-width:0;display:flex;align-items:center;gap:14rpx;min-height:112rpx;padding:20rpx;border:2rpx solid #e2e0d9;border-radius:22rpx;background:#f6f5f1}
.purchase-option.selected{border-color:#c2410c;background:#fff1e6;color:#c2410c}
.purchase-radio{flex:none;display:flex;align-items:center;justify-content:center;width:30rpx;height:30rpx;border:2rpx solid #c9c5b8;border-radius:50%;font-size:20rpx;line-height:1}
.purchase-option.selected .purchase-radio{border-color:#c2410c;color:#c2410c}
.purchase-option .hint{margin:4rpx 0 0;font-size:23rpx;line-height:1.4}
.purchase-help{margin:18rpx 0 0;line-height:1.5}
.purchase-press{opacity:.8}
.page-dark .purchase-option{background:#242522;border-color:#3a3b37;color:#edebe4}
.page-dark .purchase-option.selected{background:#3a2416;border-color:#f4a06e}
.page-dark .purchase-option.selected .purchase-radio{color:#f2b48a;border-color:#f4a06e}
.post-page .locker-select{padding-top:18rpx;padding-bottom:18rpx}
.post-page .locker-select .ue-select-text{white-space:normal;overflow:visible;line-height:1.5}
.route-line{border-left:3rpx solid #e2e0d9;padding-left:24rpx;margin:18rpx 0}.route-line .value{margin-bottom:18rpx}
.dash{border:2rpx dashed #f4a06e;border-radius:18rpx;padding:20rpx;margin:18rpx 0}.thumb{width:140rpx;height:140rpx;border-radius:16rpx}
.bag-control{margin:18rpx 0}.bag-control>view:first-child{flex:1;min-width:0}.bag-control .hint{margin:4rpx 0}
.soup-control{display:flex;align-items:center;gap:12rpx;border:1rpx solid #e2e0d9;border-radius:18rpx;padding:18rpx;min-height:90rpx}.soup-control .hint{margin:2rpx 0}
.fee-control{margin:22rpx 0 4rpx}.fee-round{flex:none;width:72rpx;height:72rpx;line-height:72rpx;text-align:center;border-radius:50%;background:#f0efea;font-size:36rpx}.fee-value{flex:1;text-align:center;white-space:nowrap}.fee-value .amount{font-size:50rpx;font-weight:800}.fee-value .hint{font-size:24rpx}

.coupon-unavailable{opacity:.55;border-style:dashed}.coupon-block .pills{flex-wrap:wrap}

.address-card{margin-bottom:22rpx!important}.destination-column{width:57%}.room-column{flex:1;min-width:0}.orange-label{color:#c2410c!important;font-weight:700}.route-tag{background:#fff1e6;border:1rpx solid #f2b48a;color:#0b7a55;padding:6rpx 13rpx;border-radius:9rpx;font-size:22rpx}.drop-pills{flex-wrap:nowrap!important}.drop-pills .pill{flex:1;text-align:center;padding:12rpx 8rpx;font-size:23rpx}.bag-phone{text-align:center;flex:none}.phone-field{flex:1;min-width:0}.phone-digits{background:#16181c;color:white;border-radius:12rpx;padding:8rpx 16rpx;letter-spacing:3rpx;font-weight:750}.save-route-choice{display:flex;align-items:flex-start;gap:16rpx;padding:20rpx;border:1rpx solid #e2e0d9;border-radius:18rpx;background:white;margin:24rpx 0}.save-route-choice .check{margin-top:6rpx}.save-route-choice>view{flex:1}.privacy-lock{margin-top:24rpx!important}.other-place-link{color:#c2410c;font-weight:650;margin:22rpx 0}.wechat-number{margin:8rpx 0 12rpx;padding:12rpx 20rpx;background:#fdf6f2;border:1rpx solid #f2b48a;color:#c2410c;border-radius:40rpx;font-size:23rpx;line-height:1.5;text-align:left}.wechat-number::after{border:0}.fee-value .price-input{display:inline-block;width:95rpx;height:60rpx;font-size:50rpx;font-weight:800;vertical-align:middle;text-align:center}

.privacy-lock{display:flex;align-items:center;gap:12rpx}.lock-icon{width:24rpx;height:24rpx;flex:none}

.takeaway-page .phone-invalid{border:2rpx solid #b42318}.phone-error{font-size:24rpx;font-weight:650;color:#0b7a55;margin:12rpx 0 18rpx}

.takeaway-page .place-tag{background:#fff;border-color:#e2e0d9;color:#5e5c55}.formatted-phone{font-weight:600;letter-spacing:1rpx}



.note-soup{margin-top:14rpx}.soup-inline{min-height:0;padding:16rpx 18rpx;border:0;background:#f7f6f2;border-radius:18rpx}.soup-inline .check{flex:none}
.note-label{display:flex;align-items:center;gap:8rpx}.vis-tag{margin-left:auto;padding:2rpx 12rpx;border-radius:8rpx;font-size:20rpx;font-weight:650}.vis-tag.public{background:#e7f3ed;color:#0b7a55}.vis-tag.private{background:#fdf6f2;color:#c2410c}
.takeaway-page .note-photo-header{gap:10rpx;margin:24rpx 0 0}
.note-photo-optional{font-size:22rpx;font-weight:400;color:#8a877e}
.note-photo-count{padding:2rpx 10rpx;border-radius:12rpx;background:#f7f6f2;color:#6b6860;font-size:20rpx;font-weight:500;line-height:1.4}
.note-photo-grid{display:flex;flex-wrap:wrap;justify-content:flex-start;gap:16rpx;margin-top:18rpx}
.note-photo-item,.note-photo-add{position:relative;width:184rpx;height:184rpx;box-sizing:border-box;flex:none}
.note-photo-item{border-radius:20rpx;overflow:hidden;background:#f7f6f2}
.note-photo-image{display:block;width:100%;height:100%;border-radius:20rpx}
.note-photo-add{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:12rpx;margin:0;padding:0;background:#f7f6f2;border:2rpx dashed #f2b48a;border-radius:20rpx;color:#44423c;transition:background .16s ease,transform .16s ease}
.note-photo-glyph{display:flex;align-items:center;justify-content:center;width:54rpx;height:54rpx}
.note-photo-icon{display:block;width:48rpx;height:48rpx;opacity:.9}
.note-photo-add-label{font-size:23rpx;font-weight:500;line-height:1.35}
.note-photo-add.busy{opacity:.55}
.note-photo-press{transform:scale(.96);background:#fff1e6}
.note-photo-remove{position:absolute;right:8rpx;top:8rpx;display:flex;align-items:center;justify-content:center;width:42rpx;height:42rpx;border:2rpx solid rgba(255,255,255,.9);border-radius:50%;background:rgba(255,255,255,.92);color:#3a3b37;font-size:30rpx;line-height:1}
.note-photo-help{margin:14rpx 0 0;color:#8a877e;font-size:22rpx;font-weight:400;line-height:1.5}
.note-photo-spinner{width:34rpx;height:34rpx;border:3rpx solid #f2b48a;border-top-color:#44423c;border-radius:50%;animation:note-photo-turn .7s linear infinite}
@keyframes note-photo-turn{to{transform:rotate(360deg)}}
.page-dark .note-photo-add{background:#3a2416;border-color:#3a3b37;color:#f4a06e}
.page-dark .note-photo-count{background:#3a3b37;color:#f4a06e}
.page-dark .note-photo-optional,.page-dark .note-photo-help{color:#8a877e}
.page-dark .note-photo-remove{background:rgba(27,28,26,.9);border-color:#3a3b37;color:#edebe4}
.arrival-switch{display:flex;gap:16rpx;margin:6rpx 0 18rpx}.arrival-opt{flex:1;height:84rpx;line-height:84rpx;text-align:center;border-radius:42rpx;border:2rpx solid #e2e0d9;background:#fff;color:#44423c;font-weight:700;transition:background .22s ease,color .22s ease,border-color .22s ease,transform .15s ease}.arrival-opt:active{transform:scale(.96)}.arrival-opt.on{background:#c2410c;border-color:#c2410c;color:#fff;box-shadow:0 6rpx 16rpx rgba(194,65,12,.25)}
.arrival-box{padding:22rpx 24rpx;border-radius:22rpx;background:#f7f6f2;animation:ue-settle .25s ease backwards}
.arrival-row{margin-bottom:14rpx}.time-step{display:flex;align-items:center;gap:6rpx;padding:6rpx 10rpx;border-radius:40rpx;background:#fff;border:2rpx solid #e2e0d9}.time-btn{width:60rpx;height:60rpx;line-height:58rpx;text-align:center;font-size:34rpx;color:#44423c;border-radius:50%;transition:background .15s}.time-btn:active{background:#f0efea}.time-value{display:inline-block;min-width:110rpx;text-align:center;font-size:34rpx;font-weight:800;font-family:monospace;letter-spacing:1rpx}
.arrival-close{color:#5e5c55;font-size:24rpx;line-height:1.6}.time-strong{font-weight:800;font-family:monospace;color:#16181c;margin:0 6rpx}
.arrival-note{display:flex;align-items:center;gap:12rpx}.arrival-yuni{flex:none;width:56rpx;height:56rpx}.arrival-pick{display:flex;align-items:center;gap:14rpx;height:72rpx;padding:0 26rpx;border-radius:36rpx;background:#fff;border:2rpx solid #e2e0d9;font-weight:700;color:#16181c}.arrival-pick:active{transform:scale(.97)}.arrival-at{font-family:monospace;font-weight:800;color:#c2410c}.arrival-pick .ue-chev{width:12rpx;height:12rpx;margin:-6rpx 0 0 2rpx;border-right:3rpx solid #c9c5b8;border-bottom:3rpx solid #c9c5b8;transform:rotate(45deg)}
.page-dark .arrival-opt{background:#242522;border-color:#3a3b37;color:#edebe4}.page-dark .arrival-opt.on{background:#c2410c;border-color:#c2410c}.page-dark .arrival-box{background:#242522}.page-dark .time-step{background:#242522;border-color:#3a3b37}.page-dark .time-btn,.page-dark .time-strong{color:#edebe4}.page-dark .arrival-close,.page-dark .arrival-pick{background:#242522;border-color:#3a3b37;color:#edebe4}
.door-head{display:flex;align-items:baseline;justify-content:space-between;margin-bottom:16rpx}.door-at{font-family:monospace;font-size:34rpx;font-weight:800;color:#c2410c}
.door-grid{display:flex;flex-wrap:wrap;gap:14rpx;margin-bottom:18rpx}.door-chip{width:calc((100% - 28rpx) / 3);box-sizing:border-box;height:68rpx;line-height:68rpx;text-align:center;border-radius:34rpx;background:#fff;border:2rpx solid #e2e0d9;color:#44423c;font-size:25rpx;font-weight:650;transition:background .2s ease,color .2s ease,border-color .2s ease,transform .15s ease}.door-chip.on{background:#c2410c;border-color:#c2410c;color:#fff;box-shadow:0 6rpx 14rpx rgba(194,65,12,.22)}.door-press{transform:scale(.95)}
.page-dark .door-chip{background:#242522;border-color:#3a3b37;color:#edebe4}.page-dark .door-chip.on{background:#c2410c;border-color:#c2410c;color:#fff}.page-dark .door-at{color:#f4a06e}

.arrival-eta-label{margin-bottom:16rpx}.arrival-time-prompt{margin-left:auto;font-size:24rpx;color:#5e5c55}.arrival-eta-hint{margin:16rpx 0 20rpx;line-height:1.6}.page-dark .arrival-at{color:#f4a06e}.page-dark .arrival-time-prompt{color:#a9a69c}
.arrival-manual-time{display:flex;align-items:center;justify-content:center;gap:12rpx;height:80rpx;border:2rpx solid #e2e0d9;border-radius:40rpx;background:#fff;color:#c2410c}
.arrival-digit{width:100rpx;height:76rpx;text-align:center;font-family:monospace;font-size:36rpx;font-weight:800;color:inherit}
.arrival-colon{font-family:monospace;font-size:36rpx;font-weight:800}
.page-dark .arrival-manual-time{background:#242522;border-color:#3a3b37;color:#f4a06e}

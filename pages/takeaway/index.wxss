@import "../../utils/post-form.wxss";
.purchase-options{display:flex;gap:16rpx}
.purchase-option{flex:1;min-width:0;display:flex;align-items:center;gap:14rpx;min-height:112rpx;padding:20rpx;border:2rpx solid #e6e5df;border-radius:22rpx;background:#f6f5f1}
.purchase-option.selected{border-color:#41775b;background:#edf6f1;color:#315e47}
.purchase-radio{flex:none;display:flex;align-items:center;justify-content:center;width:30rpx;height:30rpx;border:2rpx solid #b3b4aa;border-radius:50%;font-size:20rpx;line-height:1}
.purchase-option.selected .purchase-radio{border-color:#41775b;color:#41775b}
.purchase-option .hint{margin:4rpx 0 0;font-size:23rpx;line-height:1.4}
.purchase-help{margin:18rpx 0 0;line-height:1.5}
.purchase-press{opacity:.8}
.page-dark .purchase-option{background:#2c332f;border-color:#465149;color:#edf1ed}
.page-dark .purchase-option.selected{background:#263c2f;border-color:#7bb08f}
.page-dark .purchase-option.selected .purchase-radio{color:#a6d8b4;border-color:#7bb08f}
.post-page .locker-select{padding-top:18rpx;padding-bottom:18rpx}
.post-page .locker-select .ue-select-text{white-space:normal;overflow:visible;line-height:1.5}
.route-line{border-left:3rpx solid #deded7;padding-left:24rpx;margin:18rpx 0}.route-line .value{margin-bottom:18rpx}
.dash{border:2rpx dashed #7bb08f;border-radius:18rpx;padding:20rpx;margin:18rpx 0}.thumb{width:140rpx;height:140rpx;border-radius:16rpx}
.bag-control{margin:18rpx 0}.bag-control>view:first-child{flex:1;min-width:0}.bag-control .hint{margin:4rpx 0}
.soup-control{display:flex;align-items:center;gap:12rpx;border:1rpx solid #deded7;border-radius:18rpx;padding:18rpx;min-height:90rpx}.soup-control .hint{margin:2rpx 0}
.fee-control{margin:22rpx 0 4rpx}.fee-round{flex:none;width:72rpx;height:72rpx;line-height:72rpx;text-align:center;border-radius:50%;background:#efefeb;font-size:36rpx}.fee-value{flex:1;text-align:center;white-space:nowrap}.fee-value .amount{font-size:50rpx;font-weight:800}.fee-value .hint{font-size:24rpx}

.coupon-unavailable{opacity:.55;border-style:dashed}.coupon-block .pills{flex-wrap:wrap}

.address-card{margin-bottom:22rpx!important}.destination-column{width:57%}.room-column{flex:1;min-width:0}.orange-label{color:#41775b!important;font-weight:700}.route-tag{background:#edf6f1;border:1rpx solid #cfe3d6;color:#3a6a50;padding:6rpx 13rpx;border-radius:9rpx;font-size:22rpx}.drop-pills{flex-wrap:nowrap!important}.drop-pills .pill{flex:1;text-align:center;padding:12rpx 8rpx;font-size:23rpx}.bag-phone{text-align:center;flex:none}.phone-field{flex:1;min-width:0}.phone-digits{background:#191b1d;color:white;border-radius:12rpx;padding:8rpx 16rpx;letter-spacing:3rpx;font-weight:750}.save-route-choice{display:flex;align-items:flex-start;gap:16rpx;padding:20rpx;border:1rpx solid #deded7;border-radius:18rpx;background:white;margin:24rpx 0}.save-route-choice .check{margin-top:6rpx}.save-route-choice>view{flex:1}.privacy-lock{margin-top:24rpx!important}.other-place-link{color:#41775b;font-weight:650;margin:22rpx 0}.wechat-number{margin:8rpx 0 12rpx;padding:12rpx 20rpx;background:#f3faf3;border:1rpx solid #a6d8b4;color:#41775b;border-radius:40rpx;font-size:23rpx;line-height:1.5;text-align:left}.wechat-number::after{border:0}.fee-value .price-input{display:inline-block;width:95rpx;height:60rpx;font-size:50rpx;font-weight:800;vertical-align:middle;text-align:center}.post-header{position:sticky;top:0;z-index:10}

.privacy-lock{display:flex;align-items:center;gap:12rpx}.lock-icon{width:24rpx;height:24rpx;flex:none}

.takeaway-page .phone-invalid{border:2rpx solid #b23a3a}.phone-error{font-size:24rpx;font-weight:650;color:#3a6a50;margin:12rpx 0 18rpx}

.takeaway-page .place-tag{background:#fff;border-color:#deded7;color:#65645d}.formatted-phone{font-weight:600;letter-spacing:1rpx}



.note-soup{margin-top:14rpx}.soup-inline{min-height:0;padding:16rpx 18rpx;border:0;background:#f8f7f3;border-radius:18rpx}.soup-inline .check{flex:none}
.note-label{display:flex;align-items:center;gap:8rpx}.vis-tag{margin-left:auto;padding:2rpx 12rpx;border-radius:8rpx;font-size:20rpx;font-weight:650}.vis-tag.public{background:#eef3ef;color:#41775b}.vis-tag.private{background:#f4faf6;color:#41775b}
.arrival-switch{display:flex;gap:16rpx;margin:6rpx 0 18rpx}.arrival-opt{flex:1;height:84rpx;line-height:84rpx;text-align:center;border-radius:42rpx;border:2rpx solid #e3e1da;background:#fff;color:#4a4a45;font-weight:700;transition:background .22s ease,color .22s ease,border-color .22s ease,transform .15s ease}.arrival-opt:active{transform:scale(.96)}.arrival-opt.on{background:#41775b;border-color:#41775b;color:#fff;box-shadow:0 6rpx 16rpx rgba(65,119,91,.25)}
.arrival-box{padding:22rpx 24rpx;border-radius:22rpx;background:#f8f7f3;animation:ue-settle .25s ease backwards}
.arrival-row{margin-bottom:14rpx}.time-step{display:flex;align-items:center;gap:6rpx;padding:6rpx 10rpx;border-radius:40rpx;background:#fff;border:2rpx solid #e3e1da}.time-btn{width:60rpx;height:60rpx;line-height:58rpx;text-align:center;font-size:34rpx;color:#4a4a45;border-radius:50%;transition:background .15s}.time-btn:active{background:#f0efeb}.time-value{display:inline-block;min-width:110rpx;text-align:center;font-size:34rpx;font-weight:800;font-family:monospace;letter-spacing:1rpx}
.arrival-close{color:#5e5d57;font-size:24rpx;line-height:1.6}.time-strong{font-weight:800;font-family:monospace;color:#202126;margin:0 6rpx}
.arrival-note{display:flex;align-items:center;gap:12rpx}.arrival-yuni{flex:none;width:56rpx;height:56rpx}.arrival-pick{display:flex;align-items:center;gap:14rpx;height:72rpx;padding:0 26rpx;border-radius:36rpx;background:#fff;border:2rpx solid #e3e1da;font-weight:700;color:#202126}.arrival-pick:active{transform:scale(.97)}.arrival-at{font-family:monospace;font-weight:800;color:#41775b}.arrival-pick .ue-chev{width:12rpx;height:12rpx;margin:-6rpx 0 0 2rpx;border-right:3rpx solid #a9a8a1;border-bottom:3rpx solid #a9a8a1;transform:rotate(45deg)}
.page-dark .arrival-opt{background:#2c332f;border-color:#465149;color:#edf1ed}.page-dark .arrival-opt.on{background:#41775b;border-color:#41775b}.page-dark .arrival-box{background:#2c332f}.page-dark .time-step{background:#232926;border-color:#465149}.page-dark .time-btn,.page-dark .time-strong{color:#edf1ed}.page-dark .arrival-close,.page-dark .arrival-pick{background:#232926;border-color:#465149;color:#edf1ed}
.door-head{display:flex;align-items:baseline;justify-content:space-between;margin-bottom:16rpx}.door-at{font-family:monospace;font-size:34rpx;font-weight:800;color:#41775b}
.door-grid{display:flex;flex-wrap:wrap;gap:14rpx;margin-bottom:18rpx}.door-chip{width:calc((100% - 28rpx) / 3);box-sizing:border-box;height:68rpx;line-height:68rpx;text-align:center;border-radius:34rpx;background:#fff;border:2rpx solid #e3e1da;color:#4a4a45;font-size:25rpx;font-weight:650;transition:background .2s ease,color .2s ease,border-color .2s ease,transform .15s ease}.door-chip.on{background:#41775b;border-color:#41775b;color:#fff;box-shadow:0 6rpx 14rpx rgba(65,119,91,.22)}.door-press{transform:scale(.95)}
.page-dark .door-chip{background:#232926;border-color:#465149;color:#edf1ed}.page-dark .door-chip.on{background:#41775b;border-color:#41775b;color:#fff}.page-dark .door-at{color:#7bb08f}

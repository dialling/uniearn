@keyframes note-photo-turn{to{transform:rotate(360deg)}}
.page-dark .note-photo-add{background:#3a2416;border-color:#3a3b37;color:#f4a06e}
.page-dark .note-photo-count{background:#3a3b37;color:#f4a06e}
.page-dark .note-photo-optional,.page-dark .note-photo-help{color:#8a877e}
.page-dark .note-photo-remove{background:rgba(27,28,26,.9);border-color:#3a3b37;color:#edebe4}
.arrival-switch{display:flex;gap:16rpx;margin:6rpx 0 18rpx}.arrival-opt{flex:1;height:84rpx;line-height:84rpx;text-align:center;border-radius:42rpx;border:2rpx solid #e2e0d9;background:#fff;color:#44423c;font-weight:700;transition:var(--ue-transition,background .22s ease,color .22s ease,border-color .22s ease,transform .15s ease)}.arrival-opt:active{transform:scale(.96)}.arrival-opt.on{background:#c2410c;border-color:#c2410c;color:#fff;box-shadow:0 6rpx 16rpx rgba(194,65,12,.25)}
.arrival-box{padding:22rpx 24rpx;border-radius:22rpx;background:#f7f6f2;animation:var(--ue-animation,ue-settle .25s ease backwards)}
.arrival-row{margin-bottom:14rpx}.time-step{display:flex;align-items:center;gap:6rpx;padding:6rpx 10rpx;border-radius:40rpx;background:#fff;border:2rpx solid #e2e0d9}.time-btn{width:60rpx;height:60rpx;line-height:58rpx;text-align:center;font-size:34rpx;color:#44423c;border-radius:50%;transition:var(--ue-transition,background .15s)}.time-btn:active{background:#f0efea}.time-value{display:inline-block;min-width:110rpx;text-align:center;font-size:34rpx;font-weight:800;font-family:monospace;letter-spacing:1rpx}
.arrival-close{color:#5e5c55;font-size:24rpx;line-height:1.6}.time-strong{font-weight:800;font-family:monospace;color:#16181c;margin:0 6rpx}
.arrival-note{display:flex;align-items:center;gap:12rpx}.arrival-yuni{flex:none;width:56rpx;height:56rpx}.arrival-pick{display:flex;align-items:center;gap:14rpx;height:72rpx;padding:0 26rpx;border-radius:36rpx;background:#fff;border:2rpx solid #e2e0d9;font-weight:700;color:#16181c}.arrival-pick:active{transform:scale(.97)}.arrival-at{font-family:monospace;font-weight:800;color:#c2410c}.arrival-pick .ue-chev{width:12rpx;height:12rpx;margin:-6rpx 0 0 2rpx;border-right:3rpx solid #c9c5b8;border-bottom:3rpx solid #c9c5b8;transform:rotate(45deg)}
.page-dark .arrival-opt{background:#242522;border-color:#3a3b37;color:#edebe4}.page-dark .arrival-opt.on{background:#c2410c;border-color:#c2410c}.page-dark .arrival-box{background:#242522}.page-dark .time-step{background:#242522;border-color:#3a3b37}.page-dark .time-btn,.page-dark .time-strong{color:#edebe4}.page-dark .arrival-close,.page-dark .arrival-pick{background:#242522;border-color:#3a3b37;color:#edebe4}
.door-head{display:flex;align-items:baseline;justify-content:space-between;margin-bottom:16rpx}.door-at{font-family:monospace;font-size:34rpx;font-weight:800;color:#c2410c}
.door-grid{display:flex;flex-wrap:wrap;gap:14rpx;margin-bottom:18rpx}.door-chip{width:calc((100% - 28rpx) / 3);box-sizing:border-box;height:68rpx;line-height:68rpx;text-align:center;border-radius:34rpx;background:#fff;border:2rpx solid #e2e0d9;color:#44423c;font-size:25rpx;font-weight:650;transition:var(--ue-transition,background .2s ease,color .2s ease,border-color .2s ease,transform .15s ease)}.door-chip.on{background:#c2410c;border-color:#c2410c;color:#fff;box-shadow:0 6rpx 14rpx rgba(194,65,12,.22)}.door-press{transform:scale(.95)}
.page-dark .door-chip{background:#242522;border-color:#3a3b37;color:#edebe4}.page-dark .door-chip.on{background:#c2410c;border-color:#c2410c;color:#fff}.page-dark .door-at{color:#f4a06e}

.arrival-eta-label{margin-bottom:16rpx}.arrival-time-prompt{margin-left:auto;font-size:24rpx;color:#5e5c55}.arrival-eta-hint{margin:16rpx 0 20rpx;line-height:1.6}.page-dark .arrival-at{color:#f4a06e}.page-dark .arrival-time-prompt{color:#a9a69c}
.arrival-manual-time{position:relative;display:flex;align-items:center;justify-content:center;width:100%;height:80rpx;border:2rpx solid #e2e0d9;border-radius:40rpx;background:#fff;overflow:hidden;transition:var(--ue-transition,border-color .14s ease,box-shadow .14s ease)}.arrival-manual-time:focus-within{border-color:#c2410c;box-shadow:0 0 0 5rpx rgba(194,65,12,.08)}.arrival-manual-time.invalid{border-color:#c2410c;animation:var(--ue-animation,arrival-shake .2s ease)}.arrival-sequence{display:flex;align-items:center;justify-content:center;gap:4rpx;font-family:monospace;font-size:36rpx;font-weight:850;color:#b5b1a7;pointer-events:none}.arrival-sequence text{width:26rpx;text-align:center}.arrival-sequence text.filled{color:#c2410c}.arrival-sequence .arrival-colon{width:22rpx;color:#c2410c}.arrival-sequence-input{position:absolute;inset:0;width:100%;height:100%;opacity:.01;color:transparent;background:transparent;caret-color:transparent}.page-dark .arrival-manual-time{background:#242522;border-color:#3a3b37}.page-dark .arrival-sequence text.filled,.page-dark .arrival-sequence .arrival-colon{color:#f4a06e}@keyframes arrival-shake{0%,100%{transform:translateX(0)}35%{transform:translateX(-7rpx)}70%{transform:translateX(7rpx)}}


/* 2026-11-15 redesign: white rounded cards, soft fields, orange only where it means something. */
.takeaway-page.tw-v2{padding:0 32rpx calc(270rpx + env(safe-area-inset-bottom));background:#eeede8}

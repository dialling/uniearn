<lang-switch/>
<view class="post-page takeaway-page {{darkClass}}" wx:if="{{!unavailable}}">
 <view class="post-header"><view class="post-tabs"><button class="post-tab active">{{ui.tabTakeaway}}</button><button class="post-tab" bindtap="parcels" disabled="{{routeLocked}}">{{ui.tabParcels}}</button></view></view>
 <yuni-tip text="{{ui.tip}}" tip-key="takeaway-post"/>
 <view class="campus-proof" bindtap="doneJobs"><text class="proof-icon">✓</text><view><view>{{zh?'本周校园内已送达 '+week+' 单。':week+' '+(week===1?'order':'orders')+' delivered on campus this week.'}}</view><view>{{ui.seeDone}}</view></view><text>›</text></view>
 <view class="flow-card"><view class="flow-head"><text class="step">1</text><text>{{pickupTitle}}</text><text wx:if="{{!firstRoute && !routeLocked}}" class="link" bindtap="manage">{{ui.manage}}</text></view>
 <view wx:if="{{firstRoute}}" class="hint">{{ui.firstHint}}</view><view wx:else class="hint">{{ui.savedHint}}</view>
 <view wx:if="{{!firstRoute && !routeLocked}}" class="pills"><text wx:for="{{routes}}" wx:key="id" class="pill {{routeId===item.id?'selected':''}}" data-id="{{item.id}}" bindtap="route"><text wx:if="{{item.destinationType==='dorm'}}">⌂　</text>{{ui.labels[item.name]||item.name}}</text><text wx:if="{{!hasDormRoute}}" class="pill link" bindtap="addDorm">{{ui.addDorm}}</text><text class="pill link" bindtap="newRoute">{{ui.newRoute}}</text></view>
 <view class="soft address-card">
  <block wx:if="{{firstRoute}}"><view class="label">{{ui.collectFromIcon}}</view><view class="pills"><text wx:for="{{stations}}" wx:key="*this" class="pill {{station===item?'selected':''}}" data-value="{{item}}" bindtap="handleStation">{{ui.labels[item]||item}}</text></view><view class="hint">{{ui.stationHint}}</view><view class="label orange-label">{{ui.myDormIcon}}</view><view class="row"><view class="destination-column"><picker range="{{dormLabels}}" value="{{dormIndex}}" disabled="{{routeLocked}}" bindchange="handleDorm"><view class="field">{{ui.labels[dorm||'Choose building']||dorm||'Choose building'}}　⌄</view></picker></view><view class="room-column"><input class="field" value="{{room}}" placeholder="{{ui.room}}" data-field="room" bindinput="text" maxlength="100"/></view></view></block>
  <block wx:else><view class="row"><text class="route-tag {{destinationType==='place'?'place-tag':''}}"><text wx:if="{{destinationType==='dorm'}}">⌂　</text>{{ui.labels[routeName]||routeName}}</text><text class="link" bindtap="edit">{{ui.editOrder}}</text></view><view class="route-line"><view class="label">{{ui.collectFrom}}</view><view class="value">{{ui.labels[station]||station}}</view><view class="hint">{{pickupNote||ui.shelf}}</view><view class="label">{{ui.deliverTo}}</view><view class="value">{{destinationDisplay}}</view><view class="hint">{{destinationType==='dorm'?ui.yourDorm:ui.handed}}</view></view></block>
  <block wx:if="{{destinationType==='dorm'}}"><view class="divider"/><view class="label">{{ui.dropOff}}</view><view class="pills drop-pills"><text class="pill {{dropMode==='door'?'selected':''}}" data-value="door" bindtap="drop">{{ui.door}}</text><text class="pill {{dropMode==='lobby'?'selected':''}}" data-value="lobby" bindtap="drop">{{ui.lobby}}</text></view><view class="hint">{{ui.dropHint}}</view></block>
  <view class="divider"/><view wx:if="{{firstRoute}}"><view class="label">{{ui.yourPhone}}</view><view class="row"><input class="field phone-field {{phoneError?'phone-invalid':''}}" value="{{phone}}" type="number" maxlength="11" placeholder="{{ui.phonePlaceholder}}" data-field="phone" bindinput="text" bindblur="validatePhone"/><view class="bag-phone"><view class="label">{{ui.onBag}}</view><text class="phone-digits">{{last4||'····'}}</text></view></view><view wx:if="{{!phoneError}}" class="hint">{{ui.phoneHint}}</view><view wx:if="{{phoneError}}" class="phone-error">{{phoneError}}</view><button wx:if="{{wechatPhone}}" class="wechat-number" bindtap="usePhone">{{ui.wechatNumber}}　{{wechatMask}}</button><button wx:else class="wechat-number" open-type="getPhoneNumber" bindgetphonenumber="authorizePhone" loading="{{phoneBusy}}">{{ui.wechatNumber}}</button><view class="hint">{{ui.bagHint}}</view><view class="save-route-choice" bindtap="toggleSaveDorm"><text class="check {{saveDorm?'checked':''}}">{{saveDorm?'✓':''}}</text><view><view class="strong">{{zh?'保存为我的宿舍路线':'Save as my dorm route'}}</view><view class="hint">{{ui.saveDormHint}}</view></view></view></view>
  <view wx:else class="row"><view><view class="value">{{owner}}</view><view class="formatted-phone">{{phoneDisplay}}</view></view><view class="bag-phone"><view class="label">{{ui.onBag}}</view><text class="phone-digits">{{last4||'····'}}</text></view></view><view class="hint privacy-lock"><image class="lock-icon" src="/assets/lock-outline.svg"/>{{ui.privacy}}</view>
 </view>
 <view wx:if="{{firstRoute && !routeLocked}}" class="other-place-link" bindtap="newRoute">{{zh?'＋　不送宿舍？添加其他地点的路线':'＋　Not going to your dorm? Add a route for another place'}}</view>
 <view class="field-label">{{ui.noteLabel}}<text class="hint">{{ui.optional}}</text></view><input class="field" value="{{note}}" placeholder="{{notePlaceholder}}" data-field="note" bindinput="text" maxlength="500"/>
 </view>
 <view class="flow-card"><view class="flow-head"><text class="step dark">2</text><text>{{ui.arrivalTitle}}</text></view><view class="strong">{{ui.arrivedQ}}</view><view class="pills"><text class="pill {{arrived?'selected':''}}" data-value="now" bindtap="arrival">{{ui.thereNow}}</text><text class="pill {{!arrived?'selected':''}}" data-value="later" bindtap="arrival">{{ui.onTheWay}}</text></view>
 <view wx:if="{{!arrived}}" class="soft"><view class="row"><view><view class="strong">{{ui.estimated}}</view><view class="hint">{{ui.copyTime}}</view></view><picker mode="time" value="{{arrivalTime}}" data-field="arrivalTime" bindchange="text"><view class="field value">{{arrivalTime}} ⌄</view></picker></view><view class="row hint"><text class="strong">{{arrivalLabel}}</text><text>{{arrived?ui.atPickup:ui.planAround}}</text></view><view class="row hint"><text class="link strong">{{closeTime}}</text><text>{{ui.closes}}</text></view></view>
 <view class="dash" bindtap="photo"><view class="strong">{{photoTitle}}</view><view class="hint">{{ui.photoHint}}</view></view><view wx:if="{{riderPhoto}}" class="row"><image class="thumb" src="{{riderPhoto}}" mode="aspectFill" bindtap="preview"/><text class="link" bindtap="removePhoto">{{ui.remove}}</text></view></view>
 <view class="flow-card"><view class="flow-head"><text class="step dark">3</text><text>{{ui.carryTitle}}</text></view><view class="row bag-control"><view><view class="strong">{{ui.bags}}</view><view class="hint">{{ui.bagFee}}</view></view><view class="stepper"><text data-delta="-1" bindtap="count">−</text><text class="bag-count">{{bags}}</text><text data-delta="1" bindtap="count">＋</text></view></view><view class="soup-control" bindtap="toggleSoup"><text class="check {{soup?'checked':''}}">{{soup?'✓':''}}</text><view><view class="strong">{{ui.soup}}</view><view class="hint">{{ui.soupHint}}</view></view></view></view>
 <view class="flow-card"><view class="flow-head"><text class="step dark">4</text><text>{{ui.feeTitle}}</text><text class="badge">{{ui.minimum}}</text></view><view class="row fee-control"><text class="fee-round" data-delta="-1" bindtap="changePrice">−</text><view class="fee-value"><text class="amount">¥</text><input class="price-input" type="number" value="{{priceText}}" bindinput="priceInput" bindblur="priceBlur"/><text class="hint">{{ui.perBag}}</text><view class="hint">{{ui.typeOwn}}</view></view><text class="fee-round" data-delta="1" bindtap="changePrice">＋</text></view></view>
 <view class="flow-card totals-card"><view class="row"><text>{{ui.deliveryFee}} · ¥{{price}} × {{bags}}{{ui.bagUnit}}</text><text class="strong">¥{{reward}}</text></view><view class="row hint"><text>{{ui.serviceFee}}</text><text>¥0.00</text></view><view class="hint">{{ui.feeHint}}</view><view class="coupon-block"><view class="row"><text>{{ui.coupon}} · {{couponTitle==='None'?ui.none:couponTitle}}</text><text class="strong">−¥{{discount}}</text></view><view class="hint">{{ui.myCoupons}} · {{coupons.length}}</view><view wx:if="{{couponError}}" class="hint" bindtap="loadCoupons">{{couponError}} {{ui.retry}}</view><view wx:elif="{{!coupons.length}}" class="hint">{{ui.noCoupons}}</view><view class="pills"><text wx:for="{{coupons}}" wx:key="id" class="pill {{couponId===item.id?'selected':''}} {{item.usable?'':'coupon-unavailable'}}" data-id="{{item.id}}" bindtap="coupon">{{item.short}}{{item.usable?'':' · '+item.unavailableLabel}}</text><text class="pill {{!couponId?'selected':''}}" data-id="" bindtap="coupon">{{ui.none}}</text></view><view wx:if="{{discount!=='0.00'}}" class="hint">{{ui.coversPre}}{{discount}}{{ui.coversPost}}</view></view><view class="divider"/><view class="row total-line"><text>{{ui.total}}</text><text>¥{{total}}</text></view><view class="hint">{{ui.paidHint}}</view><view class="green-note">{{ui.previewNote}}</view></view>
 <view class="post-footer"><button class="post-submit" disabled="{{!agreed||posting||!addressReady}}" loading="{{posting}}" bindtap="post">{{tripId?ui.join:ui.post}} · {{ui.preview}} ¥{{total}}</button></view>
</view><view wx:else class="empty">{{ui.unavailable}}</view>
<yuni-assistant topic=""/>

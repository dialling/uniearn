<view class="post-page takeaway-page" wx:if="{{!unavailable}}">
 <view class="post-header"><view class="post-tabs"><button class="post-tab active">Takeaway</button><button class="post-tab" bindtap="parcels" disabled="{{routeLocked}}">Parcels</button></view></view>
 <yuni-tip text="Post right after you order. Runners plan their trip around when your food arrives." tip-key="takeaway-post"/>
 <view class="campus-proof" bindtap="doneJobs"><text class="proof-icon">✓</text><view><view>{{week}} {{week===1?'order':'orders'}} delivered on campus this week.</view><view>See the finished jobs.</view></view><text>›</text></view>
 <view class="flow-card"><view class="flow-head"><text class="step">1</text><text>{{pickupTitle}}</text><text wx:if="{{!firstRoute && !routeLocked}}" class="link" bindtap="manage">Manage</text></view>
 <view wx:if="{{firstRoute}}" class="hint">First order: choose where to collect it and add your dorm. You only do this once.</view><view wx:else class="hint">Tap a saved route. Add a note for the runner below if you need to.</view>
 <view wx:if="{{!firstRoute && !routeLocked}}" class="pills"><text wx:for="{{routes}}" wx:key="id" class="pill {{routeId===item.id?'selected':''}}" data-id="{{item.id}}" bindtap="route"><text wx:if="{{item.destinationType==='dorm'}}">⌂　</text>{{item.name}}</text><text wx:if="{{!hasDormRoute}}" class="pill link" bindtap="addDorm">⌂　Add my dorm</text><text class="pill link" bindtap="newRoute">＋ New route</text></view>
 <view class="soft address-card">
  <block wx:if="{{firstRoute}}"><view class="label">○　Collect from</view><view class="pills"><text wx:for="{{stations}}" wx:key="*this" class="pill {{station===item?'selected':''}}" data-value="{{item}}" bindtap="handleStation">{{item}}</text></view><view class="hint">Where the rider leaves your takeaway.</view><view class="label orange-label">⌂　My dorm</view><view class="row"><view class="destination-column"><picker range="{{dorms}}" value="{{dormIndex}}" disabled="{{routeLocked}}" bindchange="handleDorm"><view class="field">{{dorm||'Choose building'}}　⌄</view></picker></view><view class="room-column"><input class="field" value="{{room}}" placeholder="Room" data-field="room" bindinput="text" maxlength="100"/></view></view></block>
  <block wx:else><view class="row"><text class="route-tag {{destinationType==='place'?'place-tag':''}}"><text wx:if="{{destinationType==='dorm'}}">⌂　</text>{{routeName}}</text><text class="link" bindtap="edit">Edit for this order</text></view><view class="route-line"><view class="label">Collect from</view><view class="value">{{station}}</view><view class="hint">{{pickupNote||'Delivery shelf by the gate'}}</view><view class="label">Deliver to</view><view class="value">{{destinationDisplay}}</view><view class="hint">{{destinationType==='dorm'?'Your dorm':'Handed to you there'}}</view></view></block>
  <block wx:if="{{destinationType==='dorm'}}"><view class="divider"/><view class="label">Drop-off</view><view class="pills drop-pills"><text class="pill {{dropMode==='door'?'selected':''}}" data-value="door" bindtap="drop">At my door</text><text class="pill {{dropMode==='lobby'?'selected':''}}" data-value="lobby" bindtap="drop">Lobby · I’ll come down</text></view><view class="hint">If the runner can’t enter your building, they leave it in the lobby and message you. A runner who lives in your building can bring it to your room.</view></block>
  <view class="divider"/><view wx:if="{{firstRoute}}"><view class="label">Your phone</view><view class="row"><input class="field phone-field {{phoneError?'phone-invalid':''}}" value="{{phone}}" type="number" maxlength="11" placeholder="11-digit mobile number" data-field="phone" bindinput="text" bindblur="validatePhone"/><view class="bag-phone"><view class="label">On the bag</view><text class="phone-digits">{{last4||'····'}}</text></view></view><view wx:if="{{!phoneError}}" class="hint">{{phoneHint}}</view><view wx:if="{{phoneError}}" class="phone-error">{{phoneError}}</view><button wx:if="{{wechatPhone}}" class="wechat-number" bindtap="usePhone">Use my WeChat number　{{wechatMask}}</button><button wx:else class="wechat-number" open-type="getPhoneNumber" bindgetphonenumber="authorizePhone" loading="{{phoneBusy}}">Use my WeChat number</button><view class="hint">Use the number on your Meituan or Ele.me order. Its last 4 digits are printed on the bag.</view><view class="save-route-choice" bindtap="toggleSaveDorm"><text class="check {{saveDorm?'checked':''}}">{{saveDorm?'✓':''}}</text><view><view class="strong">Save as my dorm route</view><view class="hint">Next time, just tap My dorm. You can change it in Saved routes or Me.</view></view></view></view>
  <view wx:else class="row"><view><view class="value">{{owner}}</view><view class="formatted-phone">{{phoneDisplay}}</view></view><view class="bag-phone"><view class="label">On the bag</view><text class="phone-digits">{{last4||'····'}}</text></view></view><view class="hint privacy-lock"><image class="lock-icon" src="/assets/lock-outline.svg"/>Name and phone stay hidden until a runner accepts.</view>
 </view>
 <view wx:if="{{firstRoute && !routeLocked}}" class="other-place-link" bindtap="newRoute">＋　Not going to your dorm? Add a route for another place</view>
 <view class="field-label">Note for the runner <text class="hint">(optional)</text></view><input class="field" value="{{note}}" placeholder="{{notePlaceholder}}" data-field="note" bindinput="text" maxlength="500"/>
 </view>
 <view class="flow-card"><view class="flow-head"><text class="step dark">2</text><text>Arrival and photo</text></view><view class="strong">Has it arrived?</view><view class="pills"><text class="pill {{arrived?'selected':''}}" data-value="now" bindtap="arrival">It’s there now</text><text class="pill {{!arrived?'selected':''}}" data-value="later" bindtap="arrival">Still on the way</text></view>
 <view wx:if="{{!arrived}}" class="soft"><view class="row"><view><view class="strong">Estimated arrival</view><view class="hint">Copy it from Meituan or Ele.me.</view></view><picker mode="time" value="{{arrivalTime}}" data-field="arrivalTime" bindchange="text"><view class="field value">{{arrivalTime}} ⌄</view></picker></view><view class="row hint"><text class="strong">{{arrivalLabel}}</text><text>{{arrived?'Food is at the pickup point.':'Runners plan their trip around this time.'}}</text></view><view class="row hint"><text class="link strong">{{closeTime}}</text><text>Closes if no runner takes it. Full demo refund.</text></view></view>
 <view class="dash" bindtap="photo"><view class="strong">{{photoTitle}}</view><view class="hint">Optional. Helps the runner find your bag.</view></view><view wx:if="{{riderPhoto}}" class="row"><image class="thumb" src="{{riderPhoto}}" mode="aspectFill" bindtap="preview"/><text class="link" bindtap="removePhoto">Remove</text></view></view>
 <view class="flow-card"><view class="flow-head"><text class="step dark">3</text><text>What to carry</text></view><view class="row bag-control"><view><view class="strong">Bags</view><view class="hint">The fee is per bag · up to 5</view></view><view class="stepper"><text data-delta="-1" bindtap="count">−</text><text class="bag-count">{{bags}}</text><text data-delta="1" bindtap="count">＋</text></view></view><view class="soup-control" bindtap="toggleSoup"><text class="check {{soup?'checked':''}}">{{soup?'✓':''}}</text><view><view class="strong">Soup or drinks inside</view><view class="hint">The runner is told to keep the bag upright.</view></view></view></view>
 <view class="flow-card"><view class="flow-head"><text class="step dark">4</text><text>Your delivery fee</text><text class="badge">Minimum ¥3</text></view><view class="row fee-control"><text class="fee-round" data-delta="-1" bindtap="changePrice">−</text><view class="fee-value"><text class="amount">¥</text><input class="price-input" type="number" value="{{priceText}}" bindinput="priceInput" bindblur="priceBlur"/><text class="hint"> / bag</text><view class="hint">Tap the number to type your own</view></view><text class="fee-round" data-delta="1" bindtap="changePrice">＋</text></view></view>
 <view class="flow-card totals-card"><view class="row"><text>Delivery fee · ¥{{price}} × {{bags}} bags</text><text class="strong">¥{{reward}}</text></view><view class="row hint"><text>Service fee · ¥0.50 per order</text><text>¥0.50</text></view><view class="hint">The service fee covers payment processing and UniEarn operations, while runners keep 100% of the delivery fee.</view><view class="coupon-block"><view class="row"><text>Coupon · {{couponTitle}}</text><text class="strong">−¥{{discount}}</text></view><view class="hint">My coupons · {{coupons.length}}</view><view wx:if="{{couponError}}" class="hint" bindtap="loadCoupons">{{couponError}} Tap to retry.</view><view wx:elif="{{!coupons.length}}" class="hint">No available coupons. Collect coupons in Rewards.</view><view class="pills"><text wx:for="{{coupons}}" wx:key="id" class="pill {{couponId===item.id?'selected':''}} {{item.usable?'':'coupon-unavailable'}}" data-id="{{item.id}}" bindtap="coupon">{{item.short}}{{item.usable?'':' · '+item.unavailableLabel}}</text><text class="pill {{!couponId?'selected':''}}" data-id="" bindtap="coupon">None</text></view><view wx:if="{{discount!=='0.00'}}" class="hint">UniEarn covers ¥{{discount}}. The runner still gets the full delivery fee.</view></view><view class="divider"/><view class="row total-line"><text>Total</text><text>¥{{total}}</text></view><view class="hint">Your food is already paid for in Meituan or Ele.me. This is the delivery from the pickup point to your door.</view><view class="green-note">This preview does not charge or hold money. Orders sync with your team; settlement is simulated.</view></view>
 <view class="post-footer"><view class="post-agreement" bindtap="agree"><text class="post-check {{agreed?'checked':''}}">{{agreed?'✓':''}}</text><text>I agree to the <text class="link" catchtap="rules">platform rules and user agreement</text>.</text></view><button class="post-submit" disabled="{{!agreed||posting||!addressReady}}" loading="{{posting}}" bindtap="post">{{tripId?'Join':'Post'}} · preview ¥{{total}}</button></view>
</view><view wx:else class="empty">This trip is unavailable.</view>
<yuni-assistant topic=""/>
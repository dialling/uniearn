<lang-switch/>
<view class="post-page takeaway-page {{darkClass}}" wx:if="{{!unavailable}}">
 <view class="post-header"><view class="post-tabs"><button class="post-tab {{night?'':'active'}}" data-night="0" bindtap="setNight">{{ui.tabTakeaway}}</button><button class="post-tab" bindtap="parcels" disabled="{{routeLocked}}">{{ui.tabParcels}}</button><button class="post-tab {{night?'active':''}}" data-night="1" bindtap="setNight">{{zh?'夜市代买':'Night market'}}</button></view></view>
 
 
 <view class="flow-card"><view class="flow-head"><text class="step">1</text><text>{{pickupTitle}}</text></view>
 <view class="addr-label">{{zh?'常用配送地址':'Saved delivery addresses'}}<text wx:if="{{addrCards.length && !routeLocked}}" class="addr-manage" bindtap="addAddress">{{zh?'管理':'Manage'}} ›</text></view>
 <view wx:if="{{!addrCards.length}}" class="addr-empty-card" hover-class="addr-press" bindtap="addAddress"><text class="addr-plus big">＋</text><view><view class="strong">{{zh?'添加常用配送地址':'Add a delivery address'}}</view><view class="hint">{{zh?'设置一次，以后下单一键选择':'Set it once, pick it in one tap next time'}}</view></view></view>
 <scroll-view wx:else class="addr-scroll" scroll-x enhanced show-scrollbar="{{false}}" scroll-with-animation scroll-into-view="{{addrInto}}"><view class="addr-track"><view wx:for="{{addrCards}}" wx:key="id" id="ad{{index}}" class="addr-chip {{routeId===item.id?'selected':''}} {{routeLocked&&routeId!==item.id?'dim':''}}" data-id="{{item.id}}" bindtap="route"><view class="addr-chip-name">{{item.owner}}<text wx:if="{{item.default}}" class="addr-chip-tag">{{zh?'默认':'Default'}}</text></view><view class="addr-chip-place">{{item.place}}</view><text class="addr-chip-check">✓</text></view><view wx:if="{{!routeLocked}}" class="addr-chip add" hover-class="addr-press" bindtap="addAddress"><text class="addr-plus">＋</text></view></view></scroll-view>
 <view wx:if="{{routeId || (!firstRoute && dorm)}}" class="addr-summary"><text class="addr-send">{{zh?'送':'To'}}</text><view class="addr-summary-body"><view class="addr-summary-place">{{destinationDisplay}}</view><view class="hint">{{zh?'收件：':'Recipient: '}}{{owner}} {{phoneDisplay}}</view></view></view>
 <block wx:if="{{night}}"><view class="field-label">{{zh?'店名 / 摊位':'Shop or stall'}}</view><input always-embed placeholder-class="ue-ph" class="field" value="{{shop}}" data-field="shop" bindinput="field" placeholder="{{zh?'例如：南门夜市 王姐烤冷面':'e.g. South gate night market, Wang’s cold noodles'}}" maxlength="60"/><view class="hint">{{zh?'夜市代买每单 ¥4 起，发布后 1 小时无人接单会自动取消。':'Night market orders start at ¥4 per order and are cancelled automatically if nobody takes them within an hour.'}}</view></block><view class="field-label note-label">{{ui.noteLabel}}<text class="hint">{{ui.optional}}</text><text class="vis-tag public">{{zh?'大厅可见':'Public'}}</text></view><input always-embed placeholder-class="ue-ph" class="field" value="{{note}}" placeholder="{{notePlaceholder}}" data-field="note" bindinput="text" maxlength="500"/><block wx:if="{{night}}"><view class="field-label note-label">{{zh?'取餐码':'Meal code'}}<text class="vis-tag private">{{zh?'接单后可见':'After accept'}}</text></view><input always-embed placeholder-class="ue-ph" class="field" value="{{mealCode}}" placeholder="{{zh?'例如：A23（选填）':'e.g. A23 (optional)'}}" data-field="mealCode" bindinput="text" maxlength="20"/><view class="hint">{{zh?'只有接单的跑手能看到，用来到摊位取餐。':'Only the runner who accepts sees it, to collect your food at the stall.'}}</view></block><block wx:else>
  <view class="field-label note-label">{{zh?'外卖柜':'Takeaway locker'}}<text class="vis-tag public">{{zh?'大厅可见':'Public'}}</text></view>
  <picker wx:if="{{!lockerManual}}" mode="selector" range="{{lockerOptions}}" range-key="label" value="{{lockerIndex}}" bindchange="pickLocker">
   <view class="field ue-select locker-select {{lockerChosen?'':'empty'}}"><text class="ue-select-text">{{lockerChosen?lockerOptions[lockerIndex].label:(zh?'请选择外卖柜':'Choose a takeaway locker')}}</text><text class="ue-chev"></text></view>
  </picker>
  <input wx:if="{{lockerCustom}}" always-embed placeholder-class="ue-ph" class="field" value="{{lockerCustomText}}" placeholder="{{zh?'请填写外卖柜或取件点的具体位置':'Enter the locker or pickup location'}}" bindinput="customLocker" maxlength="200"/>
  <view class="hint">{{zh?'外卖柜位置会显示在接单大厅，方便同学查看取件地点。':'The locker location is visible to everyone in Jobs.'}}</view>
 </block><view wx:if="{{!night}}" class="note-soup"><view class="soup-control soup-inline" bindtap="toggleSoup"><text class="check {{soup?'checked':''}}">{{soup?'✓':''}}</text><view><view class="strong">{{ui.soup}}</view><view class="hint">{{ui.soupHint}}</view></view></view></view>
 </view>
 <view wx:if="{{night}}" class="flow-card purchase-status-card">
  <view class="flow-head"><text class="step dark">2</text><text>{{zh?'订单状态':'Order status'}}</text></view>
  <view class="purchase-options">
   <view class="purchase-option {{purchaseStatus==='ordered'?'selected':''}}" hover-class="purchase-press" data-value="ordered" bindtap="choosePurchaseStatus"><view class="purchase-radio"><text wx:if="{{purchaseStatus==='ordered'}}">●</text></view><text class="strong">{{zh?'已下单':'Already ordered'}}</text></view>
   <view class="purchase-option {{purchaseStatus==='needs_purchase'?'selected':''}}" hover-class="purchase-press" data-value="needs_purchase" bindtap="choosePurchaseStatus"><view class="purchase-radio"><text wx:if="{{purchaseStatus==='needs_purchase'}}">●</text></view><view><view class="strong">{{zh?'未下单':'Not ordered'}}</view><view class="hint">{{zh?'需跑手垫付':'Runner pays upfront'}}</view></view></view>
  </view>
  <view wx:if="{{purchaseStatus==='needs_purchase'}}" class="hint purchase-help">{{zh?'请在备注中写清购买内容，接单后与跑手确认垫付金额。':'Describe what to buy in your note and confirm the upfront amount with your runner after acceptance.'}}</view>
 </view>
 <view class="flow-card arrival-card"><view class="flow-head"><text class="step dark">{{night?3:2}}</text><text>{{zh?'送达时间':'Arrival'}}</text></view><view class="arrival-box"><block><view class="door-head"><text class="strong">{{zh?'期待送达时间':'Expected delivery'}}</text><text class="door-at">{{deliverBy}}</text></view><view class="door-grid"><view wx:for="{{doorChips}}" wx:key="*this" class="door-chip {{doorIndex===index?'on':''}}" hover-class="door-press" hover-stay-time="60" data-index="{{index}}" bindtap="pickDoor">{{item}}</view></view><view class="arrival-close arrival-note"><image class="arrival-yuni" src="/assets/yuni-wave.png" mode="aspectFit"/><text>{{night && purchaseStatus==='needs_purchase'?(zh?'需跑手下单垫付，无人接单将在 ':'Runner orders and pays upfront. Closes at '):(zh?'无人接单将在 ':'If nobody accepts, closes at ')}}<text class="time-strong">{{closeTime}}</text>{{zh?' 自动关闭并退款':' if nobody takes it · refunded'}}</text></view></block></view></view>
 <view class="flow-card"><view class="flow-head"><text class="step dark">{{night?4:3}}</text><text>{{ui.feeTitle}}</text><text class="badge">{{night?(zh?'¥4 起':'From ¥4'):(zh?'¥3 起':'From ¥3')}}</text></view><view class="row fee-control"><text class="fee-round" data-delta="-1" bindtap="changePrice">−</text><view class="fee-value"><text class="amount">¥</text><input always-embed placeholder-class="ue-ph" class="price-input" type="number" value="{{priceText}}" bindinput="priceInput" bindblur="priceBlur"/><view class="hint">{{ui.typeOwn}}</view></view><text class="fee-round" data-delta="1" bindtap="changePrice">＋</text></view></view>
 <view class="flow-card totals-card"><view class="row"><text>{{ui.deliveryFee}}</text><text class="strong">¥{{reward}}</text></view><view class="coupon-block"><view class="coupon-row" hover-class="coupon-row-press" bindtap="openCoupons"><text class="strong">{{zh?'优惠券':'Coupon'}}</text><view class="coupon-row-right"><block wx:if="{{discount!=='0.00'}}"><text class="coupon-row-name">{{couponTitle}}</text><text class="coupon-save">−¥{{discount}}</text></block><text wx:elif="{{coupons.length}}" class="hint">{{zh?'不使用':'Not used'}}</text><text wx:else class="hint">{{zh?'暂无可用':'None available'}}</text><text class="coupon-arrow">›</text></view></view><view wx:if="{{couponError}}" class="hint" bindtap="loadCoupons">{{couponError}} {{ui.retry}}</view><view wx:elif="{{auto && couponId}}" class="hint coupon-auto">{{zh?'已自动为你选择最划算的优惠券':'Best coupon applied automatically'}}</view></view><view class="divider"/><view class="row total-line"><text>{{ui.total}}</text><text>¥{{total}}</text></view></view>
 <view class="post-footer"><button class="post-submit" disabled="{{!agreed||posting||!addressReady||(!night&&!lockerReady)}}" loading="{{posting}}" bindtap="post">{{tripId?ui.join:ui.post}} · ¥{{total}}</button></view>
</view><view wx:else class="empty">{{ui.unavailable}}</view>
<yuni-assistant topic="takeaway-post" intro="{{ui.tip}}" floating="{{!unavailable}}"/>

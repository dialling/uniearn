@import "../../utils/flow.wxss";
.requests-page .flow-sub{margin-bottom:18rpx}.orders-empty{background:#fff;border:2rpx dashed #e7d9cb;border-radius:25rpx;padding:32rpx;margin:25rpx 0;text-align:center}.orders-empty image{width:120rpx;height:130rpx}.empty-title{font-size:31rpx;font-weight:800;margin:12rpx 0}.post-entry{display:flex;align-items:center;gap:22rpx;background:#fff;border:1rpx solid #dfded7;border-radius:22rpx;padding:24rpx;margin:15rpx 0}.post-entry>view{flex:1}.post-entry .hint{margin:4rpx 0 0}.post-icon{width:65rpx;height:65rpx;background:#fdf2f0;border-radius:18rpx;display:flex;align-items:center;justify-content:center;color:#8b1e2b;font-size:33rpx}.order-route{display:flex;align-items:center;gap:10rpx;margin:15rpx 0}.order-route .badge{flex:none;margin:0}.progress-strip{display:flex;gap:8rpx;margin:26rpx 0}.progress-strip>view{flex:1;color:#99978f;font-size:18rpx}.progress-strip>view::before{content:'';display:block;height:7rpx;background:#e8e7df;border-radius:8rpx;margin-bottom:10rpx}.progress-strip .complete{color:#8b1e2b;font-weight:700}.progress-strip .complete::before{background:#8b1e2b}.running-card{border-color:#afd0bc}.open-job{margin-top:20rpx;padding-top:18rpx;border-top:1rpx solid #eeede6;font-weight:700;color:#8b1e2b}.requests-page .badge.takeout{background:#f8e9e6;color:#873766}.requests-page .badge.parcel{background:#eceef8;color:#454d7d}.requests-page .badge.task{background:#e8edff;color:#3545af}

.requests-page .service-tabs{border-radius:21rpx;background:#f1e7da;border:1rpx solid #e2e1d9;padding:5rpx}.requests-page .service-tab{font-size:24rpx;min-height:66rpx;line-height:66rpx;padding:0;flex:1;min-width:0}.requests-page .service-tab.active{background:#fff;color:#3b2a20;box-shadow:0 2rpx 6rpx #00000012}.requests-page .order-card .row>.hint{font-size:20rpx;white-space:nowrap}.requests-page .order-card .value{font-size:27rpx}

.requests-page .progress-strip>view{border-top:0;padding-top:0}.requests-page .progress-strip>view::before{height:7rpx}.requests-page .progress-strip .complete{color:#8b1e2b}

.requests-page{padding:0 0 185rpx}.orders-header{background:transparent;padding:28rpx 33rpx 22rpx}.orders-header .flow-title{margin:0 0 13rpx}.orders-header .flow-sub{margin:0 0 25rpx;font-size:23rpx}.orders-header .service-tabs{margin:0}.orders-content{padding:0 33rpx}.orders-content .orders-empty{padding:43rpx 33rpx;margin:25rpx 0 20rpx}.orders-empty>image{width:135rpx;height:170rpx}.orders-empty .hint{font-size:24rpx;line-height:1.65;margin:22rpx 0 8rpx}.orders-content .post-entry{padding:24rpx 26rpx;gap:17rpx;min-height:99rpx;border-radius:25rpx;margin:19rpx 0}.post-entry .badge{margin:0;flex:none;font-size:19rpx;padding:6rpx 14rpx}.post-entry>.strong{flex:1;min-width:0;font-size:26rpx;line-height:1.4}.post-entry .entry-price{flex:none;color:#777970;font-size:22rpx;white-space:nowrap}.post-entry.takeaway-entry{border:2rpx solid #a02a33}.runner-empty-icon{width:90rpx;height:90rpx;border-radius:50%;background:#f1e4dc;display:flex;align-items:center;justify-content:center;margin:4rpx auto 24rpx}.runner-empty-icon image{width:40rpx;height:40rpx}.orders-content .runner-empty{padding:43rpx 33rpx}.runner-empty .find-job{display:inline-flex;align-items:center;justify-content:center;width:190rpx;min-width:190rpx;max-width:190rpx;min-height:85rpx;height:85rpx;line-height:1;padding:0;margin:23rpx auto 3rpx;border-radius:23rpx;font-size:27rpx}

<template name="message-notice">
 <view wx:if="{{notice.unread>0}}" class="order-message-notice">
  <view class="order-message-summary" data-id="{{notice.id}}" catchtap="openChat" role="button" aria-label="{{zh?'查看订单新消息':'Open unread order messages'}}">
   <view class="order-message-heading"><text>{{notice.peer}}{{zh?'发来新消息':' sent a message'}}</text><text class="order-message-count">{{notice.unread>99?'99+':notice.unread}}</text></view>
   <view class="order-message-preview">{{notice.preview}}</view>
  </view>
 </view>
</template>

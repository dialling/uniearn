<lang-switch/>
<view class="flow-page requests-page {{darkClass}}"><view class="orders-header"><view class="flow-title">{{zh?'我的订单':'My orders'}}</view><view class="flow-sub">{{zh?(tab==='running'?'你帮其他同学接的任务':'你请其他同学帮忙代取的订单'):tab==='running'?'Jobs you took for other students':'Things you asked other students to bring'}}</view><view class="service-tabs glass"><view class="glass-thumb of-2" style="transform:translateX({{(tab==='running'?1:0)*100}}%)"><view wx:for="{{[tab]}}" wx:key="*this" class="glass-blob"/></view><button class="service-tab {{tab==='requested'?'active':''}}" data-value="requested" bindtap="switchTab">{{zh?'我发布的':'I requested'}} {{requestedCount}}</button><button class="service-tab {{tab==='running'?'active':''}}" data-value="running" bindtap="switchTab">{{zh?'我接的单':'I’m running'}} {{running.length}}</button></view></view><view class="orders-content">
<block wx:if="{{tab==='running'}}"><view wx:if="{{running.length}}" class="section">{{zh?'进行中':'Running now'}}</view><view wx:for="{{running}}" wx:key="id" class="flow-card running-card" data-id="{{item.id}}" bindtap="trip"><view class="row"><view><text class="badge {{item.category}}">{{item.type}}</text><view class="route">{{item.route}}</view></view><text class="value">¥{{item.total}}</text></view><view class="open-job">{{zh?'查看任务 ›':'Open the job ›'}}</view></view><view wx:if="{{!running.length && !runningPast.length}}" class="orders-empty runner-empty"><view class="runner-empty-icon"><image src="/assets/box-outline.svg" mode="aspectFit"/></view><view class="empty-title">{{zh?'你还没有接过任务':'You haven’t run any jobs'}}</view><view class="hint">{{zh?'顺路帮其他同学代取外卖或快递，就能赚到每个任务标明的赏金。':'Bring other students’ takeaway or parcels when you’re going that way anyway, and earn the price shown on each job.'}}</view><button class="btn find-job" bindtap="findJob">{{zh?'去接单':'Find a job'}}</button></view><view wx:elif="{{!running.length}}" class="hint center">{{zh?'目前没有进行中的任务，已完成的行程在下方。':'No jobs running right now. Your completed trips are below.'}}</view><view wx:if="{{runningPast.length}}" class="section">{{zh?'已完成的行程':'Completed trips'}}</view><view wx:for="{{runningPast}}" wx:key="id" class="flow-card" data-id="{{item.id}}" bindtap="trip"><view class="row strong"><text>{{item.route}}</text><text>¥{{item.total}}</text></view><view class="hint">{{zh?'已完成 · 查看详情 ›':'Completed · view details ›'}}</view></view></block>
<block wx:else><block wx:if="{{!hasRequests}}"><view class="orders-empty"><image src="/assets/yuni-party.png" mode="aspectFit"/><view class="empty-title">{{zh?'还没有订单':'No orders yet'}}</view><view class="hint">{{zh?'发布订单后，可以在这里一步步查看进度：已发布、已接单、已取件、已送达。完成的订单会保留记录。':'When you post one, you’ll follow it here step by step: posted, taken, picked up, delivered. Finished orders keep their receipt.'}}</view></view><view class="post-entry takeaway-entry" bindtap="post"><text class="badge takeout">{{zh?'外卖':'Takeaway'}}</text><text class="strong">{{zh?'外卖代取':'Bring my takeaway'}}</text><text class="entry-price">{{zh?'每袋 ¥4':'¥4 a bag'}}</text></view><view class="post-entry" bindtap="parcelPost"><text class="badge parcel">{{zh?'快递':'Parcel'}}</text><text class="strong">{{zh?'快递代取':'Bring my parcel'}}</text><text class="entry-price">{{zh?'每件 ¥3 起':'from ¥3 a box'}}</text></view></block>
<block wx:else><view wx:if="{{active.length}}" class="section">{{zh?'进行中':'Active'}}</view><view wx:for="{{active}}" wx:key="id" class="flow-card order-card" data-id="{{item.id}}" bindtap="open"><view class="row"><text class="strong status-{{item.status}}">○ {{item.statusLabel}}</text><text class="hint">{{zh?'发布于 ':'Posted '}}{{item.createdTime}}</text></view><view class="order-route"><text class="badge {{item.category}}">{{zh?(item.category==='task'?'任务':item.category==='takeout'?'外卖':'快递'):item.category==='task'?'Task':item.category==='takeout'?'Takeaway':'Parcel'}}</text><text class="strong">{{item.category==='task'?item.title:item.station+' → '+item.dorm}}</text></view><view class="progress-strip"><view wx:for="{{item.progress}}" wx:for-item="step" wx:key="label" class="{{step.done?'complete':''}}">{{step.label}}</view></view><view class="row hint"><text>{{item.boxes}} {{item.unitLabel}}<text wx:if="{{item.category==='takeout'}}"> · {{zh?'外卖送达 ':'food arrives '}}{{item.arrivalTime}}</text></text><text class="value">¥{{item.total}}</text></view></view><view class="section row"><text>{{zh?'历史订单':'Past'}}</text><text class="hint">{{zh?'点 ↻ 再来一单':'Tap ↻ to post again'}}</text></view><view class="final-tabs glass"><view class="glass-thumb of-3" style="transform:translateX({{(pastFilter==='all'?0:pastFilter==='completed'?1:2)*100}}%)"><view wx:for="{{[pastFilter]}}" wx:key="*this" class="glass-blob"/></view><text wx:for="{{filters}}" wx:key="*this" class="{{pastFilter===item?'active':''}}" hover-class="glass-press" data-value="{{item}}" bindtap="filter">{{zh?(item==='all'?'全部':item==='completed'?'已完成':'已退款'):item}}</text></view><view class="flow-card" wx:if="{{past.length}}"><view wx:for="{{past}}" wx:key="id" class="timeline"><view data-id="{{item.id}}" bindtap="open"><view class="strong">{{item.category==='task'?item.title:item.sizeLabel+' → '+item.dorm}}</view><view class="hint">{{item.boxes}} {{item.unitLabel}} · {{item.statusLabel}}</view></view><view><view class="strong">¥{{item.status==='cancelled'||item.status==='refunded'?'0.00':item.total}}</view><text wx:if="{{item.category!=='task'}}" class="link" data-id="{{item.id}}" data-category="{{item.category}}" bindtap="repeat">{{zh?'↻ 再来一单':'↻ Post again'}}</text></view></view></view></block></block></view><app-nav id="app-nav" active="requests"/></view><yuni-assistant topic=""/>
<import src="./message-notice.wxml"/>
<import src="./runner-card.wxml"/>
<view style="{{motionStyle}}">

<lang-switch></lang-switch>
<view class="flow-page requests-page {{darkClass}}"><view class="orders-header"><view class="flow-title">{{zh?'我的订单':'My orders'}}</view><view class="flow-sub">{{zh?(tab==='running'?'你帮其他同学接的任务':'你请其他同学帮忙代取的订单'):tab==='running'?'Jobs you took for other students':'Things you asked other students to bring'}}</view><view class="service-tabs glass"><view class="glass-thumb of-2" style="transform:translateX({{(tab==='running'?1:0)*100}}%)"><view wx:for="{{[tab]}}" wx:key="*this" class="glass-blob"/></view><button class="service-tab {{tab==='requested'?'active':''}}" data-value="requested" bindtap="switchTab">{{zh?'我发布的':'I requested'}} {{requestedCount}}</button><button class="service-tab {{tab==='running'?'active':''}}" data-value="running" bindtap="switchTab">{{zh?'我接的单':'I’m running'}} {{running.length}}</button></view></view><view class="orders-content">
<block wx:if="{{tab==='running'}}"><view wx:if="{{running.length}}" class="section">{{zh?'进行中':'Running now'}}</view><block wx:for="{{running}}" wx:key="id"><template is="runner-card" data="{{item,zh,replyingId}}"/></block><view wx:if="{{!running.length && !runningPast.length}}" class="orders-empty runner-empty"><view class="runner-empty-icon"><image src="/assets/box-outline.svg" mode="aspectFit"/></view><view class="empty-title">{{zh?'你还没有接过任务':'You haven’t run any jobs'}}</view><view class="hint">{{zh?'顺路帮其他同学代取外卖或快递，就能赚到每个任务标明的赏金。':'Bring other students’ takeaway or parcels when you’re going that way anyway, and earn the price shown on each job.'}}</view><button class="btn find-job" bindtap="findJob">{{zh?'去接单':'Find a job'}}</button></view><view wx:elif="{{!running.length}}" class="hint center">{{zh?'目前没有进行中的任务，已完成的行程在下方。':'No jobs running right now. Your completed trips are below.'}}</view><view wx:if="{{runningPast.length}}" class="section">{{zh?'已完成的行程':'Completed trips'}}</view><block wx:for="{{runningPast}}" wx:key="id"><template is="runner-card" data="{{item,zh,replyingId}}"/></block></block>
<block wx:else><block wx:if="{{!hasRequests}}"><view class="orders-empty"><image src="/assets/yuni-party.png" mode="aspectFit"/><view class="empty-title">{{zh?'还没有订单':'No orders yet'}}</view><view class="hint">{{zh?'发布订单后，可以在这里一步步查看进度：已发布、已接单、已取件、已送达。完成的订单会保留记录。':'When you post one, you’ll follow it here step by step: posted, taken, picked up, delivered. Finished orders keep their receipt.'}}</view></view><view class="post-entry takeaway-entry" bindtap="post"><text class="badge takeout">{{zh?'外卖':'Takeaway'}}</text><text class="strong">{{zh?'外卖代取':'Bring my takeaway'}}</text><text class="entry-price">{{zh?'每袋 ¥4':'¥4 a bag'}}</text></view><view class="post-entry" bindtap="parcelPost"><text class="badge parcel">{{zh?'快递':'Parcel'}}</text><text class="strong">{{zh?'快递代取':'Bring my parcel'}}</text><text class="entry-price">{{zh?'每件 ¥3 起':'from ¥3 a box'}}</text></view><view class="post-entry night-entry" bindtap="nightPost"><text class="badge takeout">{{zh?'夜市':'Night market'}}</text><text class="strong">{{zh?'夜市代买':'Request a night market purchase'}}</text><text class="entry-price">{{zh?'每单 ¥4':'¥4 an order'}}</text></view></block>
<block wx:else><view wx:if="{{active.length}}" class="section">{{zh?'进行中':'Active'}}</view><view wx:for="{{active}}" wx:key="id" class="flow-card order-card no-card {{item.cardTone}} {{item.feedbackOpen?'no-has-issue':''}}" data-id="{{item.id}}" bindtap="open"><view wx:if="{{item.feedbackOpen}}" class="no-issue-corner">{{zh?'该订单有问题':'Order issue'}}</view><view class="row"><text class="strong order-status no-status status-{{item.status}} {{item.feedbackOpen?'no-warn':''}}">● {{item.feedbackOpen?(zh?'问题反馈处理中':'Feedback in progress'):item.statusLabel}}</text><text class="hint">{{zh?'发布于 ':'Posted '}}{{item.createdTime}}</text></view><view class="order-route no-top"><image class="nj-tile sm" mode="aspectFit" src="/assets/icons3d/{{item.icon}}.svg"/><view class="no-title"><text class="strong">{{item.category==='task'?item.title:item.pickupLabel}}</text><text class="hint">{{zh?(item.category==='task'?'任务':item.night?'夜市':item.category==='takeout'?'外卖':'快递'):item.category==='task'?'Task':item.night?'Request a night market purchase':item.category==='takeout'?'Takeaway':'Parcel'}} · {{item.boxes}} {{item.unitLabel}}</text></view><text class="value no-price">¥{{item.total}}</text></view><view wx:if="{{item.feedbackOpen}}" class="no-issue-line">{{item.reportNoticeText||(zh?'UniEarn 团队正在跟进这笔订单。':'The UniEarn team is following up on this order.')}}</view><view wx:else class="progress-strip no-track"><view wx:for="{{item.progress}}" wx:for-item="step" wx:key="label" class="no-step {{step.done?'complete':''}} {{index===item.stepIndex?'now':''}} {{index===item.stepIndex&&item.moving?'moving':''}}"><image wx:if="{{index===item.stepIndex}}" class="no-yuni" mode="aspectFit" src="/assets/yuni-{{item.pose}}.png"/>{{step.label}}</view></view><view wx:if="{{item.hint&&!item.feedbackOpen}}" class="no-hint">{{item.hint}}</view><template is="message-notice" data="{{notice:item.messageNotice,zh,replyingId}}"/><view wx:if="{{item.status==='delivered'&&!item.feedbackOpen}}" class="no-confirm">{{zh?'查看并确认':'Check and confirm'}}</view></view><view class="section row"><text>{{zh?'已完成订单':'Completed'}}</text></view><block wx:if="{{past.length}}"><view wx:for="{{past}}" wx:key="id" wx:if="{{item.status==='confirmed'}}" class="flow-card order-history-card timeline {{item.cardTone}}"><image class="nj-tile sm {{item.status==='confirmed'?'':'mute'}}" mode="aspectFit" src="/assets/icons3d/{{item.icon}}.svg" data-id="{{item.id}}" bindtap="open"/><view class="no-past-main" data-id="{{item.id}}" bindtap="open"><view class="strong">{{item.category==='task'?item.title:(item.category==='takeout'?item.pickupLabel:item.sizeLabel)+' → '+item.destinationLabel}}</view><view class="hint">{{item.boxes}} {{item.unitLabel}} · {{item.statusLabel}}</view><view wx:if="{{item.cancelReasonLabel}}" class="hint">{{zh?'取消原因：':'Cancel reason: '}}{{item.cancelReasonLabel}}</view><view class="history-time">{{item.historyTime}}</view><template is="message-notice" data="{{notice:item.messageNotice,zh,replyingId}}"/></view><view class="no-past-price"><text class="strong">¥{{item.status==='cancelled'||item.status==='refunded'?'0.00':item.total}}</text></view></view></block></block></block></view><app-nav id="app-nav" active="requests"/></view><yuni-assistant topic=""/>

</view>

@import "../../utils/post-form.wxss";
.notice-actions{display:flex;align-items:stretch;gap:14rpx;margin:18rpx 0}.notice-action{display:flex;flex:1;min-width:0;flex-direction:column;align-items:center;text-align:center;padding:18rpx 12rpx;min-height:174rpx;border:1rpx solid #dfdfd8;border-radius:18rpx;background:white}.notice-action.chosen{border-color:#ad5a35;background:#fcf7f3}.action-icon{width:48rpx;height:48rpx;line-height:48rpx;text-align:center;background:#f7f2ed;color:#885132;border-radius:12rpx;font-size:29rpx}.action-title{font-size:25rpx;font-weight:700;margin:10rpx 0 4rpx}.action-help{font-size:22rpx;color:#888780;line-height:1.5}.scan-status{display:flex;justify-content:space-between;gap:10rpx}.private-head{display:flex;justify-content:space-between;align-items:center;gap:14rpx;border-top:1rpx solid #e7e6df;margin-top:18rpx;padding-top:18rpx;font-size:22rpx;font-weight:700}.private-head .link{flex:none}.preview-line{display:flex;justify-content:space-between;align-items:center;gap:16rpx;min-height:80rpx;padding:18rpx;margin:12rpx 0;border-radius:16rpx;background:#f6f6f2;font-size:24rpx}.preview-line>text:first-child{color:#888780;flex:none}.preview-line>text:last-child{text-align:right;font-weight:600}.code-input{width:58%;min-width:0;text-align:right;font-size:24rpx}.code-value{font-family:monospace}.upload-thumbs{display:flex;gap:10rpx}.upload-thumbs image{width:90rpx;height:90rpx;border-radius:12rpx}
.size-options{display:grid;grid-template-columns:1fr 1fr;gap:14rpx;margin:18rpx 0}.size-option{display:flex;flex-direction:column;min-width:0;min-height:228rpx;padding:18rpx;border:1rpx solid #dfdfd8;border-radius:18rpx;background:#fff}.size-option.selected{border-color:#ad5a35;background:#fcf7f3}.size-examples{flex:1;margin:12rpx 0 14rpx;font-size:22rpx;color:#888780;line-height:1.45}.size-bottom{font-size:27rpx;font-weight:700}.size-option .stepper{gap:3rpx;padding:6rpx}.size-option .stepper text{min-width:28rpx}.tip-mark{background:#ad5a35}
.phone-row,.upload-row,.code-line{display:flex;align-items:center;gap:14rpx}.phone-row input{flex:1;min-width:0}.upload-row{flex-wrap:wrap;margin-top:18rpx}.thumb{width:90rpx;height:90rpx;border-radius:12rpx}.upload-add{width:90rpx;height:90rpx;margin:0;padding:0;line-height:90rpx;background:#fff;border:1rpx dashed #ccc}.agreement{display:flex;align-items:center;gap:12rpx;font-size:22rpx;margin:18rpx 0}.tick{font-size:32rpx}.bag-row{margin:18rpx 0}.choice{margin-top:20rpx}

image.action-icon{width:38rpx;height:38rpx;display:block;margin:0 auto 12rpx}
.coupon-unavailable{opacity:.55;border-style:dashed}.coupon-block .pills{flex-wrap:wrap}

.create-page .notice-actions{display:flex;gap:18rpx;margin:22rpx 0}.create-page .notice-action{flex:1;min-width:0;min-height:260rpx;padding:27rpx 18rpx;display:flex;flex-direction:column;align-items:center;justify-content:flex-start;border:2rpx solid #deded8;border-radius:27rpx;background:#fff;text-align:center;gap:12rpx}.create-page .notice-action.chosen{border-color:#b44b22;background:#fcf5ef}.create-page .notice-action .action-icon{box-sizing:content-box;width:32rpx;height:32rpx;background:#fcf0e6;padding:23rpx;border-radius:23rpx;margin:0 0 4rpx}.create-page .notice-action .action-title{font-size:27rpx;font-weight:750;line-height:1.4}.create-page .notice-action .action-help{font-size:22rpx;line-height:1.45;color:#85847c;white-space:normal}.create-page yuni-tip{display:block;margin:22rpx 0}

.address-card{margin-bottom:22rpx!important}.destination-column{width:57%}.room-column{flex:1;min-width:0}.orange-label{color:#ad5a35!important;font-weight:700}.route-tag{background:#fff1e7;border:1rpx solid #ecd4c4;color:#9b472c;padding:6rpx 13rpx;border-radius:9rpx;font-size:22rpx}.drop-pills{flex-wrap:nowrap!important}.drop-pills .pill{flex:1;text-align:center;padding:12rpx 8rpx;font-size:23rpx}.bag-phone{text-align:center;flex:none}.phone-field{flex:1;min-width:0}.phone-digits{background:#191a1d;color:white;border-radius:12rpx;padding:8rpx 16rpx;letter-spacing:3rpx;font-weight:750}.save-route-choice{display:flex;align-items:flex-start;gap:16rpx;padding:20rpx;border:1rpx solid #dfdfd8;border-radius:18rpx;background:white;margin:24rpx 0}.save-route-choice .check{margin-top:6rpx}.save-route-choice>view{flex:1}.privacy-lock{margin-top:24rpx!important}.other-place-link{color:#ad5a35;font-weight:650;margin:22rpx 0}.wechat-number{margin:8rpx 0 12rpx;padding:12rpx 20rpx;background:#f3faf3;border:1rpx solid #a6d8b4;color:#41775b;border-radius:40rpx;font-size:23rpx;line-height:1.5;text-align:left}.wechat-number::after{border:0}
.route-line{border-left:3rpx solid #d7d4ca;padding-left:24rpx;margin:18rpx 0}.route-line .value{margin-bottom:18rpx}
.privacy-lock{display:flex;align-items:center;gap:12rpx}.lock-icon{width:24rpx;height:24rpx;flex:none}.place-tag{background:#fff;border-color:#dfdfd8;color:#65645d}.formatted-phone{font-weight:600;letter-spacing:1rpx}

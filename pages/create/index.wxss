/* 2026-11-17: parcel request page in the same language as the takeaway page: white rounded cards on the warm grey page,
   3D icons for each section, soft grey fields, an orange outline for what is chosen, a fragile switch, quick note chips,
   and "Need it faster?" sharing one card with the bill. Logic and wording unchanged. */
.create-page.pc-v2{background:#eeede8}
.create-page.pc-v2 .step-card{background:#fff;border:0;border-radius:40rpx;padding:30rpx 28rpx;margin:24rpx 0;box-shadow:none}
.create-page.pc-v2 .step-head{gap:16rpx;margin-bottom:20rpx;font-size:29rpx;font-weight:800}
.create-page.pc-v2 .step-title{font-size:29rpx;font-weight:800}
.create-page.pc-v2 .pc-head-icon{flex:none;width:52rpx;height:52rpx;margin:-4rpx 0}
.create-page.pc-v2 .step-count{padding:4rpx 16rpx;border-radius:99rpx;background:#f6f5f1;color:#6b6860;font-size:21rpx;font-weight:700}
.create-page.pc-v2 .step-head .badge{margin-left:auto;padding:4rpx 16rpx;border-radius:99rpx;background:#fdeee4;color:#b4501f;font-weight:700}
.create-page.pc-v2 .field{border:2rpx solid transparent;border-radius:22rpx;background:#f6f5f1;min-height:84rpx}
.create-page.pc-v2 .hint{color:#7a776e;font-size:23rpx;line-height:1.5}

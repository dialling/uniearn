.create-page.pc-v2 .addr-chip{border-radius:28rpx;border:3rpx solid transparent;background:#f6f5f1}
.create-page.pc-v2 .addr-chip.selected{border-color:#c2410c;background:#fff8f3;box-shadow:none}
.create-page.pc-v2 .addr-chip.add{border:2rpx dashed #f2c9ad;background:#fffaf6}
.create-page.pc-v2 .addr-summary{display:flex;align-items:center;gap:18rpx;margin:14rpx 0 6rpx;padding:20rpx 22rpx;border-radius:24rpx;background:#f6f5f1}
.create-page.pc-v2 .pc-sum-icon{flex:none;width:64rpx;height:64rpx}
.create-page.pc-v2 .size-option{border:3rpx solid transparent;border-radius:28rpx;background:#f6f5f1;box-shadow:none}
.create-page.pc-v2 .size-option.selected{border-color:#c2410c;background:#fff8f3;box-shadow:none}
.create-page.pc-v2 .size-option::before{display:none}
.create-page.pc-v2 .size-btn.minus{background:#fff;border:0}
.create-page.pc-v2 .size-btn.plus{background:#fff;color:#c2410c;font-weight:700}
.create-page.pc-v2 .size-private{border-top:2rpx dashed #ebe7df}
.create-page.pc-v2 .parcel-pickup-row{border-radius:22rpx;background:#f6f5f1;border:0}
.create-page.pc-v2 .fragile-toggle{gap:20rpx;padding:20rpx 22rpx;border-radius:22rpx;background:#f6f5f1}
.create-page.pc-v2 .fragile-toggle .check{order:2;flex:none;position:relative;width:84rpx;height:48rpx;margin:0 0 0 auto;border:0;border-radius:99rpx;background:#dcd8cf;font-size:0;color:transparent;transition:var(--ue-transition,background-color .2s ease)}
.create-page.pc-v2 .fragile-toggle .check::after{content:'';position:absolute;top:6rpx;left:6rpx;width:36rpx;height:36rpx;border-radius:50%;background:#fff;box-shadow:0 2rpx 6rpx rgba(22,24,28,.2);transition:var(--ue-transition,transform .22s cubic-bezier(.3,1.3,.5,1))}
.create-page.pc-v2 .fragile-toggle .check.checked{background:#c2410c}
.create-page.pc-v2 .fragile-toggle .check.checked::after{transform:translateX(36rpx)}
.create-page.pc-v2 .fragile-copy{flex:1;min-width:0}
.create-page.pc-v2 .pill{border:3rpx solid transparent;border-radius:99rpx;background:#f6f5f1;color:#44423c;font-weight:650;box-shadow:none}
.create-page.pc-v2 .pill.chosen{border-color:#c2410c;background:#fff8f3;color:#c2410c;font-weight:800;box-shadow:none}
.create-page.pc-v2 .tw-chips{display:flex;flex-wrap:wrap;gap:12rpx;margin-top:14rpx}
.create-page.pc-v2 .tw-chip{padding:10rpx 20rpx;border-radius:99rpx;background:#f6f5f1;color:#44423c;font-size:23rpx;font-weight:650;line-height:1.35}
.create-page.pc-v2 .tw-chip-press{background:#fdeee4;color:#c2410c}
.create-page.pc-v2 .pc-bill{margin:26rpx -28rpx -30rpx;padding:22rpx 28rpx 28rpx;border:0;border-top:2rpx dashed #e6e1d7;border-radius:0;background:transparent;box-shadow:none}

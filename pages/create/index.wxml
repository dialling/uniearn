<lang-switch/>
<view class="post-page create-page {{darkClass}}">
 <view wx:if="{{mode==='choose'}}">
  <view class="title">{{ui['What do you want to do?']}}</view>
  <view class="card choice" data-mode="request" bindtap="choose"><view class="route">{{ui['Pick up food or parcels　›']}}</view><view class="muted">{{ui['Someone collects it and brings it to your dorm.']}}</view></view>
  <view class="card choice" data-mode="trip" bindtap="choose"><view class="route">{{ui['Start a trip　›']}}</view><view class="muted">{{ui['Bring others’ orders back on your way.']}}</view></view>
 </view>
 <block wx:else>
  <view class="post-header"><view class="post-tabs final-tabs glass"><view class="glass-thumb of-3" style="transform:translateX({{(category==='parcel'?1:(category==='night'?2:0))*100}}%)"><view wx:for="{{[category]}}" wx:key="*this" class="glass-blob"/></view><button class="post-tab {{category==='takeout'?'active':''}}" data-category="takeout" bindtap="service" hover-class="glass-press" disabled="{{scanBusy || categoryLocked}}">{{ui['Takeaway']}}</button><button class="post-tab {{category==='parcel'?'active':''}}" data-category="parcel" bindtap="service" hover-class="glass-press" disabled="{{scanBusy || categoryLocked}}">{{ui['Parcels']}}</button><button class="post-tab {{category==='night'?'active':''}}" data-category="night" bindtap="service" hover-class="glass-press" disabled="{{scanBusy || categoryLocked}}">{{zh?'夜市代买':'Night market'}}</button></view></view>

  <block wx:if="{{mode==='request' && category==='parcel'}}">
   <view class="step-card parcel-address-section"><view class="step-head"><text class="step-number">1</text><text class="step-title">{{ui['Deliver to']}}</text></view>
    <view class="addr-label">{{zh?'常用配送地址':'Saved delivery addresses'}}<text wx:if="{{addrCards.length && !routeLocked}}" class="addr-manage" bindtap="manageAddresses">{{zh?'管理':'Manage'}} ›</text></view>
    <view wx:if="{{!addrCards.length}}" class="addr-empty-card" hover-class="addr-press" bindtap="addAddress"><text class="addr-plus big">＋</text><view><view class="strong">{{zh?'添加常用配送地址':'Add a delivery address'}}</view><view class="hint">{{zh?'设置一次，以后下单一键选择':'Set it once, pick it in one tap next time'}}</view></view></view>
    <scroll-view wx:else class="addr-scroll" scroll-x enhanced show-scrollbar="{{false}}" scroll-with-animation scroll-into-view="{{addrInto}}"><view class="addr-track"><view wx:for="{{addrCards}}" wx:key="id" id="ad{{index}}" class="addr-chip {{routeId===item.id?'selected':''}} {{routeLocked&&routeId!==item.id?'dim':''}}" data-id="{{item.id}}" bindtap="chooseAddress"><view class="addr-chip-name">{{item.owner}}<text wx:if="{{item.default}}" class="addr-chip-tag">{{zh?'默认':'Default'}}</text></view><view class="addr-chip-place">{{item.place}}</view><text class="addr-chip-check">✓</text></view><view wx:if="{{!routeLocked}}" class="addr-chip add" hover-class="addr-press" bindtap="addAddress"><text class="addr-plus">＋</text></view></view></scroll-view>
    <view wx:if="{{routeId}}" class="addr-summary"><text class="addr-send">{{zh?'送':'To'}}</text><view class="addr-summary-body"><view class="addr-summary-place">{{destinationDisplay}}</view><view class="hint">{{zh?'收件：':'Recipient: '}}{{name}} {{phoneDisplay}}</view></view></view>
   </view>

   <view class="step-card"><view class="step-head"><text class="step-number dark">2</text><text class="step-title">{{ui['Size of each parcel']}}</text><text class="step-count">{{parcelCount}} / 12 {{ui['boxes']}}</text></view>
    <view class="size-options"><view wx:for="{{sizeOptions}}" wx:key="id" class="size-option {{item.count?'selected':''}}"><view class="size-info"><view class="size-name"><text class="strong">{{sizeText[item.id].label}}</text><text class="size-price">¥{{item.price}} / {{zh?'件':'item'}}</text></view><view class="size-examples">{{sizeText[item.id].hint}}</view></view><view class="size-step"><view class="size-btn minus {{item.count?'':'off'}}" hover-class="size-btn-press" hover-stay-time="60" data-size="{{item.id}}" data-delta="-1" bindtap="sizeCount">−</view><view class="size-num-box"><text wx:for="{{[item.count]}}" wx:for-item="n" wx:key="*this" class="size-num {{n?'on':''}}">{{n}}</text></view><view class="size-btn plus" hover-class="size-btn-press" hover-stay-time="60" data-size="{{item.id}}" data-delta="1" bindtap="sizeCount">＋</view></view></view></view><view class="hint">{{ui['Up to 12 items per request, at most 9 of one size.']}}</view>
    <view class="private-head size-private"><text class="private-title">{{ui['♙　Only the runner who accepts sees these']}}</text><view class="notice-upload {{scanBusy?'busy':''}}" role="button" aria-disabled="{{scanBusy}}" hover-class="addr-press" catchtap="openParcelScreenshot"><image src="/assets/photo.svg"/><text>{{ui['Upload screenshot']}}</text></view></view>
    <view wx:if="{{scanState || foundCodes}}" class="scan-status notice-feedback"><text>{{scanState||(zh?'已填写 '+foundCodes+' 个取件码':foundCodes+' pickup codes entered')}}</text><view class="notice-feedback-actions"><text wx:if="{{foundCodes}}" bindtap="toggleCodes">{{codeEditing?ui['Done']:ui['Edit']}}</text><text wx:if="{{scanState}}" bindtap="clearNotice">{{ui['Clear']}}</text></view></view><view wx:if="{{scanError}}" class="notice-error">{{scanError}}</view>
    <view wx:if="{{scanImages.length}}" class="upload-thumbs"><image wx:for="{{scanImages}}" wx:key="*this" src="{{item}}" mode="aspectFill"/></view>
    <view wx:for="{{codes}}" wx:key="index" class="parcel-pickup-item">
     <view class="preview-line parcel-pickup-row"><text class="parcel-number">{{zh?'包裹 ':'Parcel '}}{{index+1}}</text><picker class="parcel-station-picker" mode="selector" range="{{stationLabels2}}" value="{{parcelStations[index].pick}}" data-i="{{index}}" bindchange="pickStation"><view class="parcel-station-choice"><text class="parcel-station-name {{parcelStations[index].chosen?'':'empty'}}">{{parcelStations[index].chosen?parcelStations[index].label:(zh?'选择驿站':'Station')}}</text><text class="parcel-station-chevron">⌄</text></view></picker><input always-embed placeholder-class="ue-ph" wx:if="{{codeEditing || !item}}" class="code-input" placeholder="{{ui['Enter pickup code']}}" value="{{item}}" data-i="{{index}}" bindinput="code"/><text wx:else class="code-value">{{item}}</text></view>
     <input wx:if="{{parcelStations[index].other}}" always-embed placeholder-class="ue-ph" class="field station-other" placeholder="{{zh?'输入驿站名称':'Enter station name'}}" value="{{parcelStations[index].custom}}" data-i="{{index}}" bindinput="otherStation" maxlength="100"/>
    </view>
   </view>

   <view class="step-card parcel-note-section">
    <view class="step-head"><text class="step-number dark">3</text><text class="step-title">{{ui['Note for the runner']}}</text><text class="badge">{{ui['Optional']}}</text></view>
    <input always-embed placeholder-class="ue-ph" class="field" placeholder="{{ui['e.g. one box is fragile']}}" value="{{description}}" data-field="description" bindinput="text" maxlength="500"/>
    <view class="fragile-toggle {{fragile?'on':''}}" bindtap="toggleFragile"><text class="check {{fragile?'checked':''}}">{{fragile?'✓':''}}</text><view class="fragile-copy"><view class="strong">{{zh?'包裹易碎':'Fragile parcel'}}</view><view class="hint">{{zh?'会提醒跑手轻拿轻放。':'The runner is told to handle it with care.'}}</view></view></view>
   </view>

   <view class="step-card"><view class="step-head"><text class="step-number dark">4</text><text class="step-title">{{ui['Needed by']}}</text></view><view class="pill-row"><text wx:for="{{periods}}" wx:key="id" class="pill {{deadlineChoice===item.id?'chosen':''}} {{item.passed?'passed':''}}" data-value="{{item.id}}" bindtap="deadlineOption">{{zh?item.zh:item.en}}</text></view><view class="hint period-tip">{{zh?'Tips：具体送达时间可以在接单后和跑手沟通。':'Tip: agree the exact time with your runner after they accept.'}}</view></view>
   <view class="step-card"><view class="step-head"><text class="step-number tip-mark">ϟ</text><text class="step-title">{{ui['Need it faster?']}}</text><text class="badge">{{ui['Optional']}}</text></view><view class="hint">{{ui['A tip goes 100% to the runner and puts your parcels higher on the job board.']}}</view><view class="pill-row"><text wx:for="{{tipOptions}}" wx:key="*this" class="pill {{tip===item?'chosen':''}}" data-value="{{item}}" bindtap="tipOption">{{item===0?ui['No tip']:'+¥'+item}}</text></view></view>
   <view class="step-card totals-card"><view class="row"><text>{{parcelCount}} {{ui['parcels']}}</text><text>¥{{offer}}</text></view><view class="coupon-block"><view class="coupon-row" hover-class="coupon-row-press" bindtap="openCoupons"><text class="strong">{{zh?'优惠券':'Coupon'}}</text><view class="coupon-row-right"><block wx:if="{{discount!=='0.00'}}"><text class="coupon-row-name">{{couponText}}</text><text class="coupon-save">−¥{{discount}}</text></block><text wx:elif="{{coupons.length}}" class="hint">{{zh?'不使用':'Not used'}}</text><text wx:else class="hint">{{zh?'暂无可用':'None available'}}</text><text class="coupon-arrow">›</text></view></view><view wx:if="{{couponError}}" class="hint" bindtap="loadCoupons">{{couponError}} {{ui['Tap to retry.']}}</view><view wx:elif="{{auto && couponId}}" class="hint coupon-auto">{{zh?'已自动为你选择最划算的优惠券':'Best coupon applied automatically'}}</view></view><view class="divider"></view><view class="row total-line"><text>{{ui['Total']}}</text><text>¥{{total}}</text></view></view>
   
   <view class="post-footer"><button class="post-submit" disabled="{{!agreed || scanBusy}}" bindtap="post">{{zh?'发布 ·':'Post ·'}} ¥{{total}}</button></view>
  </block>

  <block wx:elif="{{mode==='request'}}">
   <view class="saved-section"><view class="field-label">{{ui['Saved location']}}</view><view class="field saved" bindtap="useSaved">{{savedAddress?savedAddress.pickup+' → '+savedAddress.dorm+(zh?' · 房间 ':' · Room ')+savedAddress.room:ui['Save your usual address in Me']}}　›</view></view>
   <input always-embed placeholder-class="ue-ph" class="field description" placeholder="{{ui['Describe your order (optional)']}}" value="{{description}}" data-field="description" bindinput="text" maxlength="100"/>
   <view class="row"><view class="half"><view class="field-label">{{ui['Collect from']}}</view><picker range="{{stationLabels}}" value="{{stationIndex}}" bindchange="station" disabled="{{categoryLocked}}"><view class="field">{{stationLabels[stationIndex]}}　›</view></picker></view><view class="half"><view class="field-label">{{ui['Deliver to']}}</view><picker range="{{dormLabels}}" value="{{dormIndex}}" bindchange="dorm" disabled="{{categoryLocked}}"><view class="field">{{dormLabels[dormIndex]}}　›</view></picker></view></view>
   <input always-embed placeholder-class="ue-ph" class="field" placeholder="{{ui['Room number']}}" value="{{room}}" data-field="room" bindinput="text"/><input always-embed placeholder-class="ue-ph" class="field" placeholder="{{ui['Leave at the desk (optional)']}}" value="{{note}}" data-field="note" bindinput="text"/><text class="link tiny" bindtap="saveAddress">{{ui['Save as my usual address']}}</text>
   <view class="field-label">{{ui['Phone number']}} <text class="tiny">　{{ui['Filled from your profile']}}</text></view><view class="field phone-row"><input always-embed placeholder-class="ue-ph" type="number" maxlength="11" placeholder="{{ui['Enter phone number']}}" value="{{phone}}" data-field="phone" bindinput="text" focus="{{phoneEditing}}"/><text class="link" bindtap="editPhone">{{ui['Change']}}</text></view>
   <view class="field-label">{{ui['Deliver by']}}</view><view class="row"><picker class="half" mode="date" value="{{date}}" start="{{today}}" data-field="date" bindchange="text"><view class="field ue-select"><text class="ue-select-text">{{date===today?ui['Today']:date}}</text><text class="ue-chev"></text></view></picker><picker class="half" mode="time" value="{{deadline}}" data-field="deadline" bindchange="text"><view class="field ue-select"><text class="ue-select-text">{{deadline}}</text><text class="ue-chev"></text></view></picker></view>
   <view class="row bag-row"><text class="chip orange">{{small}} {{zh?'袋':(small===1?'bag':'bags')}}</text><view class="stepper"><text data-delta="-1" bindtap="count">−</text><text>{{small}}</text><text data-delta="1" bindtap="count">＋</text></view></view>
   <view class="card"><view class="strong">{{ui['Only the runner who accepts sees this']}}</view><view class="upload-row"><button class="upload-add" bindtap="orderPhoto">＋</button><view><view class="strong">{{ui['Waimai order picture']}}</view><view class="tiny">{{ui['Helps the runner identify your food']}}</view></view></view><view class="upload-row"><view wx:for="{{orderPictures}}" wx:key="index"><image class="thumb" src="{{item}}" mode="aspectFill"/><view class="link tiny" data-i="{{index}}" bindtap="removePhoto">{{ui['Remove']}}</view></view></view></view>
   <view class="card"><view class="row"><text class="strong">{{ui['You offer per bag']}}</text><text class="link money">¥{{price}}.00</text></view><slider min="2" max="20" value="{{price}}" activeColor="#c2410c" bindchange="setPrice"/><view class="row tiny"><text>¥2</text><text>¥20</text></view></view>
   <button class="btn orange" disabled="{{!agreed || scanBusy}}" bindtap="post">{{zh?'发布 · ¥'+offer+' + ¥'+fee+' 服务费':'Post · ¥'+offer+' + ¥'+fee+' service'}}</button><view class="tiny">{{ui['Local preview · no real payment']}}</view>
  </block>
  <block wx:else><view class="row"><view class="half"><view class="field-label">{{ui['Collect from']}}</view><picker range="{{stationLabels}}" value="{{stationIndex}}" bindchange="station"><view class="field">{{stationLabels[stationIndex]}}　›</view></picker></view><view class="half"><view class="field-label">{{ui['Deliver to']}}</view><picker range="{{dormLabels}}" value="{{dormIndex}}" bindchange="dorm"><view class="field">{{dormLabels[dormIndex]}}　›</view></picker></view></view><view class="section">{{ui['When are you going?']}}</view><view class="row"><text class="chip {{depart==='Now'?'green':''}}" data-value="Now" bindtap="setDepart">{{ui['Now']}}</text><text class="chip {{depart==='Later today'?'green':''}}" data-value="Later today" bindtap="setDepart">{{ui['Later today']}}</text></view><view class="card row"><text>{{ui['Room for']}}</text><view class="stepper"><text data-delta="-1" bindtap="setCapacity">−</text>{{capacity}}<text data-delta="1" bindtap="setCapacity">＋</text></view></view><view class="card"><view class="strong">{{ui['Waiting on this route']}}</view><view class="route">{{waitingCount}} {{ui['items']}} · ¥{{waitingReward}}</view></view><button class="btn" bindtap="start">{{ui['Start trip']}}</button></block>
 </block>
</view>
<yuni-assistant topic="parcel-post" intro="{{ui['Upload your pickup screenshot or paste the SMS, and I’ll read the station and codes for you.']}}" floating="{{mode==='request' && category==='parcel'}}"/>

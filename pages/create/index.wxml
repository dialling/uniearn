<view class="post-page create-page">
 <view wx:if="{{mode==='choose'}}">
  <view class="title">{{ui['What do you want to do?']}}</view>
  <view class="card choice" data-mode="request" bindtap="choose"><view class="route">{{ui['Pick up food or parcels　›']}}</view><view class="muted">{{ui['Someone collects it and brings it to your dorm.']}}</view></view>
  <view class="card choice" data-mode="trip" bindtap="choose"><view class="route">{{ui['Start a trip　›']}}</view><view class="muted">{{ui['Bring others’ orders back on your way.']}}</view></view>
 </view>
 <block wx:else>
  <view class="post-header"><view class="post-tabs"><button class="post-tab {{category==='takeout'?'active':''}}" data-category="takeout" bindtap="service" disabled="{{scanBusy || categoryLocked}}">{{ui['Takeaway']}}</button><button class="post-tab {{category==='parcel'?'active':''}}" data-category="parcel" bindtap="service" disabled="{{scanBusy || categoryLocked}}">{{ui['Parcels']}}</button></view></view>

  <block wx:if="{{mode==='request' && category==='parcel'}}"><yuni-tip tip-key="parcel-post" pose="think" text="{{ui['Upload your pickup screenshot or paste the SMS, and I’ll read the station and codes for you.']}}"/>
   <view class="step-card notice-card">
    <view class="step-head"><text class="step-number">1</text><text class="step-title">{{ui['Add the pickup notice']}}</text><text class="badge">{{foundCodes?(zh?'已识别 '+foundCodes+' 个取件码':foundCodes+' '+(foundCodes===1?'code':'codes')+' found'):ui['No codes yet']}}</text></view>
    <view class="hint">{{ui['Pick one. We fill in the station and the pickup codes for you.']}}</view>
    <view class="notice-actions"><view class="notice-action" bindtap="openParcelScreenshot"><image class="action-icon" src="/assets/photo.svg"/><text class="action-title">{{ui['Upload screenshot']}}</text><text class="action-help">{{ui['Pickup notice, list or SMS screenshot']}}</text></view><view class="notice-action {{smsText?'chosen':''}}" bindtap="openSms"><image class="action-icon" src="/assets/sms.svg"/><text class="action-title">{{ui['Paste the SMS']}}</text><text class="action-help">{{ui['Copy the station message, then tap']}}</text></view></view>
    <view wx:if="{{smsEditing}}" class="sms-editor"><textarea class="field" placeholder="{{ui['Paste your pickup notice here']}}" value="{{smsText}}" data-field="smsText" bindinput="text" maxlength="1500"/><button class="btn orange" bindtap="parseSms" disabled="{{scanBusy}}" loading="{{scanBusy}}">{{ui['Read pickup codes']}}</button></view>
    <view wx:if="{{scanState}}" class="scan-status"><text>✓　{{scanState}}</text><text bindtap="clearNotice">{{ui['Clear']}}</text></view><view wx:if="{{scanError}}" class="notice-error">{{scanError}}</view>
    <view class="private-head"><text>{{ui['♙　Only the runner who accepts sees these']}}</text><text class="link" bindtap="toggleCodes">{{codeEditing?ui['Done']:ui['Edit']}}</text></view>
    <view class="preview-line"><text>{{ui['Station']}}</text><text>{{pickupPoint || ui['Please confirm pickup station']}}</text></view>
    <view class="preview-line"><text>{{ui['Pickup address']}}</text><text>{{pickupAddress || ui['Add details if needed']}}</text></view>
    <view wx:if="{{codeEditing}}"><input class="field" placeholder="{{ui['Pickup station']}}" value="{{pickupPoint}}" data-field="pickupPoint" bindinput="text"/><input class="field" placeholder="{{ui['Pickup address (optional)']}}" value="{{pickupAddress}}" data-field="pickupAddress" bindinput="text"/></view>
    <view wx:for="{{codes}}" wx:key="index" class="preview-line"><text>{{zh?'包裹 ':'Parcel '}}{{index+1}}</text><input wx:if="{{codeEditing || !item}}" class="code-input" placeholder="{{ui['Enter pickup code']}}" value="{{item}}" data-i="{{index}}" bindinput="code"/><text wx:else class="code-value">{{item}}</text></view>
    <view class="upload-thumbs"><image wx:for="{{scanImages}}" wx:key="index" src="{{item}}" mode="aspectFill"/></view>
   </view>

   <view class="step-card"><view class="step-head"><text class="step-number dark">2</text><text class="step-title">{{ui['Size of each parcel']}}</text><text class="step-count">{{parcelCount}} / 5 {{ui['boxes']}}</text></view><view class="hint">{{zh?'本单共 '+parcelCount+' 件包裹，请为每件选择尺寸。':parcelCount+' '+(parcelCount===1?'parcel':'parcels')+' in this request. Set a size for each one.'}}</view>
    <view class="size-options"><view wx:for="{{sizeOptions}}" wx:key="id" class="size-option {{item.count?'selected':''}}"><view class="strong">{{sizeText[item.id].label}}</view><view class="size-weight">{{sizeText[item.id].weight}}</view><view class="size-examples">{{sizeText[item.id].examples}}</view><view class="row size-bottom"><text>¥{{item.price}}</text><view class="stepper"><text data-size="{{item.id}}" data-delta="-1" bindtap="sizeCount">−</text><text>{{item.count}}</text><text data-size="{{item.id}}" data-delta="1" bindtap="sizeCount">＋</text></view></view></view></view><view class="hint">{{ui['Up to 5 boxes per request, so one runner can carry them in one trip.']}}</view>
   </view>

   <view class="step-card parcel-address-section"><view class="step-head"><text class="step-number dark">3</text><text class="step-title">{{ui['Deliver to']}}</text><text wx:if="{{!firstAddress}}" class="link" bindtap="manageAddresses">{{ui['Manage']}}</text></view>
    <view class="hint">{{firstAddress?ui['First order: add your delivery address. You only do this once.']:ui['Tap a saved address. Add a note for the runner below if you need to.']}}</view>
    <view wx:if="{{!firstAddress}}" class="pills"><text wx:for="{{routes}}" wx:key="id" class="pill {{routeId===item.id?'selected':''}}" data-id="{{item.id}}" bindtap="chooseAddress"><text wx:if="{{item.destinationType==='dorm'}}">⌂　</text>{{names[item.name]||item.name}}</text><text wx:if="{{!hasDormAddress}}" class="pill link" bindtap="addDormAddress">{{ui['⌂　Add my dorm']}}</text><text class="pill link" bindtap="newAddress">{{ui['＋ New address']}}</text></view>
    <view class="soft address-card">
     <block wx:if="{{firstAddress}}"><view class="label orange-label">{{ui['⌂　My dorm']}}</view><view class="row"><view class="destination-column"><picker range="{{dormLabels}}" value="{{dormIndex}}" bindchange="dorm"><view class="field">{{dormLabels[dormIndex]}}　⌄</view></picker></view><view class="room-column"><input class="field" value="{{room}}" placeholder="{{ui['Room']}}" data-field="room" bindinput="text" maxlength="100"/></view></view></block>
     <block wx:else><view class="row"><text class="route-tag {{destinationType==='place'?'place-tag':''}}"><text wx:if="{{destinationType==='dorm'}}">⌂　</text>{{names[routeName]||routeName}}</text><text class="link" bindtap="editAddress">{{ui['Edit for this order']}}</text></view><view class="route-line"><view class="label">{{ui['Deliver to']}}</view><view class="value">{{destinationDisplay}}</view><view class="hint">{{destinationType==='dorm'?ui['Your dorm']:ui['Handed to you there']}}</view><view wx:if="{{note}}" class="hint">{{note}}</view></view></block>
     <block wx:if="{{destinationType==='dorm'}}"><view class="divider"/><view class="label">{{ui['Drop-off']}}</view><view class="pills drop-pills"><text class="pill {{dropMode==='door'?'selected':''}}" data-value="door" bindtap="dropAddress">{{ui['At my door']}}</text><text class="pill {{dropMode==='lobby'?'selected':''}}" data-value="lobby" bindtap="dropAddress">{{ui['Lobby · I’ll come down']}}</text></view><view class="hint">{{ui['If the runner can’t enter your building, they leave it in the lobby and message you. A runner who lives in your building can bring it to your room.']}}</view></block>
     <view class="divider"/><block wx:if="{{firstAddress}}"><view class="row"><view class="half"><view class="field-label">{{ui['Name']}}</view><input class="field" value="{{name}}" data-field="name" bindinput="text" placeholder="{{ui['Your name']}}"/></view><view class="half"><view class="field-label">{{ui['Phone']}}</view><input class="field" type="number" maxlength="11" value="{{phone}}" data-field="phone" bindinput="text" placeholder="{{ui['11-digit number']}}"/></view></view><view class="save-route-choice" bindtap="toggleSaveAddress"><text class="check {{saveFirstAddress?'checked':''}}">{{saveFirstAddress?'✓':''}}</text><view><view class="strong">{{ui['Save as my parcel address']}}</view><view class="hint">{{ui['Next time, just tap My dorm. Manage your parcel addresses separately.']}}</view></view></view></block>
     <view wx:else><view class="value">{{name}}</view><view class="formatted-phone">{{phoneDisplay}}</view></view><view class="hint privacy-lock"><image class="lock-icon" src="/assets/lock-outline.svg"/>{{ui['Name and phone stay hidden until a runner accepts.']}}</view>
    </view>
    <view wx:if="{{firstAddress}}" class="other-place-link" bindtap="newAddress">{{ui['＋　Not going to your dorm? Add another address']}}</view>
    <view class="field-label">{{ui['Note for the runner']}} <text class="hint">{{ui['(optional)']}}</text></view><input class="field" placeholder="{{ui['e.g. one box is fragile']}}" value="{{description}}" data-field="description" bindinput="text" maxlength="500"/>
   </view>

   <view class="step-card"><view class="step-head"><text class="step-number dark">4</text><text class="step-title">{{ui['Needed by']}}</text></view><view class="pill-row"><text class="pill {{deadlineChoice==='anytime'?'chosen':''}}" data-value="anytime" bindtap="deadlineOption">{{ui['Anytime']}}</text><text class="pill {{deadlineChoice==='before18'?'chosen':''}}" data-value="before18" bindtap="deadlineOption">{{ui['Before 18:00']}}</text><text class="pill {{deadlineChoice==='custom'?'chosen':''}}" data-value="custom" bindtap="deadlineOption">{{ui['Pick a time']}}</text></view><view wx:if="{{deadlineChoice==='custom'}}" class="row"><picker class="half" mode="date" value="{{date}}" start="{{today}}" data-field="date" bindchange="text"><view class="field">{{date}}　⌄</view></picker><picker class="half" mode="time" value="{{deadline}}" data-field="deadline" bindchange="text"><view class="field">{{deadline}}　⌄</view></picker></view></view>
   <view class="step-card"><view class="step-head"><text class="step-number tip-mark">ϟ</text><text class="step-title">{{ui['Need it faster?']}}</text><text class="badge">{{ui['Optional']}}</text></view><view class="hint">{{ui['A tip goes 100% to the runner and puts your parcels higher on the job board.']}}</view><view class="pill-row"><text wx:for="{{tipOptions}}" wx:key="*this" class="pill {{tip===item?'chosen':''}}" data-value="{{item}}" bindtap="tipOption">{{item===0?ui['No tip']:'+¥'+item}}</text></view></view>
   <view class="step-card totals-card"><view class="row"><text>{{parcelCount}} {{ui['parcels']}}</text><text>¥{{offer}}</text></view><view class="row"><text>{{ui['Service fee · ¥0.50 per parcel']}}</text><text>¥{{fee}}</text></view><view class="hint">{{ui['The service fee is shown for this preview. No payment is taken.']}}</view><view class="coupon-block"><view class="row"><text>{{ui['Coupon']}} · {{couponText}}</text><text class="strong">−¥{{discount}}</text></view><view class="hint">{{ui['My coupons']}} · {{coupons.length}}</view><view wx:if="{{couponError}}" class="hint" bindtap="loadCoupons">{{couponError}} {{ui['Tap to retry.']}}</view><view wx:elif="{{!coupons.length}}" class="hint">{{ui['No available coupons. Collect coupons in Rewards.']}}</view><view class="pills"><text wx:for="{{coupons}}" wx:key="id" class="pill {{couponId===item.id?'selected':''}} {{item.usable?'':'coupon-unavailable'}}" data-id="{{item.id}}" bindtap="coupon">{{item.shortText}}{{item.usable?'':' · '+item.unavailableText}}</text><text class="pill {{!couponId?'selected':''}}" data-id="" bindtap="coupon">{{ui['None']}}</text></view><view wx:if="{{discount!=='0.00'}}" class="hint">{{zh?'UniEarn 承担 ¥'+discount+'，校园帮手仍可获得全额配送酬劳。':'UniEarn covers ¥'+discount+'. The runner still gets the full delivery fee.'}}</view></view><view class="divider"></view><view class="row total-line"><text>{{ui['Total']}}</text><text>¥{{total}}</text></view><view class="scan-status">{{ui['Orders sync with your team. No real payment or refund is processed.']}}</view></view>
   
   <view class="post-footer"><view class="post-agreement" bindtap="agree"><text class="post-check {{agreed?'checked':''}}">{{agreed?'✓':''}}</text><text>{{zh?'我同意':'I agree to the '}}<text class="link" catchtap="agreement">{{ui['platform rules and user agreement']}}</text>{{zh?'。':'.'}}</text></view><button class="post-submit" disabled="{{!agreed || scanBusy}}" bindtap="post">{{ui['Post · preview']}} ¥{{total}}</button></view>
  </block>

  <block wx:elif="{{mode==='request'}}">
   <view class="saved-section"><view class="field-label">{{ui['Saved location']}}</view><view class="field saved" bindtap="useSaved">{{savedAddress?savedAddress.pickup+' → '+savedAddress.dorm+(zh?' · 房间 ':' · Room ')+savedAddress.room:ui['Save your usual address in Me']}}　›</view></view>
   <input class="field description" placeholder="{{ui['Describe your order (optional)']}}" value="{{description}}" data-field="description" bindinput="text" maxlength="100"/>
   <view class="row"><view class="half"><view class="field-label">{{ui['Collect from']}}</view><picker range="{{stationLabels}}" value="{{stationIndex}}" bindchange="station" disabled="{{categoryLocked}}"><view class="field">{{stationLabels[stationIndex]}}　›</view></picker></view><view class="half"><view class="field-label">{{ui['Deliver to']}}</view><picker range="{{dormLabels}}" value="{{dormIndex}}" bindchange="dorm" disabled="{{categoryLocked}}"><view class="field">{{dormLabels[dormIndex]}}　›</view></picker></view></view>
   <input class="field" placeholder="{{ui['Room number']}}" value="{{room}}" data-field="room" bindinput="text"/><input class="field" placeholder="{{ui['Leave at the desk (optional)']}}" value="{{note}}" data-field="note" bindinput="text"/><text class="link tiny" bindtap="saveAddress">{{ui['Save as my usual address']}}</text>
   <view class="field-label">{{ui['Phone number']}} <text class="tiny">　{{ui['Filled from your profile']}}</text></view><view class="field phone-row"><input type="number" maxlength="11" placeholder="{{ui['Enter phone number']}}" value="{{phone}}" data-field="phone" bindinput="text" focus="{{phoneEditing}}"/><text class="link" bindtap="editPhone">{{ui['Change']}}</text></view>
   <view class="field-label">{{ui['Deliver by']}}</view><view class="row"><picker class="half" mode="date" value="{{date}}" start="{{today}}" data-field="date" bindchange="text"><view class="field">{{date===today?ui['Today']:date}}　⌄</view></picker><picker class="half" mode="time" value="{{deadline}}" data-field="deadline" bindchange="text"><view class="field">{{deadline}}　⌄</view></picker></view>
   <view class="row bag-row"><text class="chip orange">{{small}} {{zh?'袋':(small===1?'bag':'bags')}}</text><view class="stepper"><text data-delta="-1" bindtap="count">−</text><text>{{small}}</text><text data-delta="1" bindtap="count">＋</text></view></view>
   <view class="card"><view class="strong">{{ui['Only the runner who accepts sees this']}}</view><view class="upload-row"><button class="upload-add" bindtap="orderPhoto">＋</button><view><view class="strong">{{ui['Waimai order picture']}}</view><view class="tiny">{{ui['Helps the runner identify your food']}}</view></view></view><view class="upload-row"><view wx:for="{{orderPictures}}" wx:key="index"><image class="thumb" src="{{item}}" mode="aspectFill"/><view class="link tiny" data-i="{{index}}" bindtap="removePhoto">{{ui['Remove']}}</view></view></view></view>
   <view class="card"><view class="row"><text class="strong">{{ui['You offer per bag']}}</text><text class="link money">¥{{price}}.00</text></view><slider min="2" max="20" value="{{price}}" activeColor="#b9552d" bindchange="setPrice"/><view class="row tiny"><text>¥2</text><text>¥20</text></view></view>
   <view class="agreement" bindtap="agree"><text class="tick">{{agreed?'☑':'□'}}</text><text>{{zh?'我已阅读并同意':'I have read and agree to the '}}<text class="link" catchtap="agreement">{{ui['platform rules and user agreement']}}</text>{{zh?'。':'.'}}</text></view><button class="btn orange" disabled="{{!agreed || scanBusy}}" bindtap="post">{{zh?'发布 · ¥'+offer+' + ¥'+fee+' 服务费':'Post · ¥'+offer+' + ¥'+fee+' service'}}</button><view class="tiny">{{ui['Local preview · no real payment']}}</view>
  </block>
  <block wx:else><view class="row"><view class="half"><view class="field-label">{{ui['Collect from']}}</view><picker range="{{stationLabels}}" value="{{stationIndex}}" bindchange="station"><view class="field">{{stationLabels[stationIndex]}}　›</view></picker></view><view class="half"><view class="field-label">{{ui['Deliver to']}}</view><picker range="{{dormLabels}}" value="{{dormIndex}}" bindchange="dorm"><view class="field">{{dormLabels[dormIndex]}}　›</view></picker></view></view><view class="section">{{ui['When are you going?']}}</view><view class="row"><text class="chip {{depart==='Now'?'green':''}}" data-value="Now" bindtap="setDepart">{{ui['Now']}}</text><text class="chip {{depart==='Later today'?'green':''}}" data-value="Later today" bindtap="setDepart">{{ui['Later today']}}</text></view><view class="card row"><text>{{ui['Room for']}}</text><view class="stepper"><text data-delta="-1" bindtap="setCapacity">−</text>{{capacity}}<text data-delta="1" bindtap="setCapacity">＋</text></view></view><view class="card"><view class="strong">{{ui['Waiting on this route']}}</view><view class="route">{{waitingCount}} {{ui['items']}} · ¥{{waitingReward}}</view></view><button class="btn" bindtap="start">{{ui['Start trip']}}</button></block>
 </block>
</view>
<yuni-assistant topic=""/>
<lang-switch/>
<view class="flow-page task-post-page {{darkClass}}"><view class="task-header"><view class="flow-title">{{ui.title}}</view><view class="flow-sub">{{ui.sub}}</view></view><view class="task-content"><view class="flow-card"><view class="flow-head"><text class="step">1</text><text>{{ui.need}}</text></view><textarea class="field task-copy" value="{{title}}" data-field="title" bindinput="text" maxlength="4000" auto-height placeholder="{{ui.placeholder}}"/><view class="hint task-location-hint">{{ui.location}}</view><view class="dash photo-entry" bindtap="handlePhoto"><image src="/assets/photo.svg"/><text>{{photo?ui.photoAdded:ui.addPhoto}}</text><text class="hint" wx:if="{{!photo}}">{{ui.optional}}</text></view><image wx:if="{{photo}}" class="thumb" src="{{photo}}" mode="aspectFill"/><text wx:if="{{photo}}" class="link" bindtap="remove">{{ui.remove}}</text></view><view class="flow-card deadline-card"><view class="flow-head"><text class="step">2</text><text>{{ui.doneBy}}</text></view><view class="deadline-modes"><view class="deadline-mode {{deadlineMode==='timed'?'selected':''}}" data-mode="timed" bindtap="setDeadlineMode"><view class="deadline-mode-dot">{{deadlineMode==='timed'?'✓':''}}</view><view><view class="deadline-mode-title">{{ui.withDeadline}}</view><view class="deadline-mode-hint">{{ui.withDeadlineHint}}</view></view></view><view class="deadline-mode {{deadlineMode==='none'?'selected':''}}" data-mode="none" bindtap="setDeadlineMode"><view class="deadline-mode-dot">{{deadlineMode==='none'?'✓':''}}</view><view><view class="deadline-mode-title">{{ui.noDeadline}}</view><view class="deadline-mode-hint">{{ui.noDeadlineHint}}</view></view></view></view><block wx:if="{{deadlineMode==='timed'}}"><view class="deadline-fields"><picker class="deadline-picker" mode="date" value="{{deadlineDate}}" start="{{today}}" bindchange="deadlineDateChange"><view class="deadline-field"><text class="deadline-label">{{ui.date}}</text><view class="deadline-value"><text>{{deadlineDate}}</text><text class="deadline-chevron">›</text></view></view></picker><picker class="deadline-picker" mode="time" value="{{deadlineTime}}" bindchange="deadlineTimeChange"><view class="deadline-field"><text class="deadline-label">{{ui.time}}</text><view class="deadline-value"><text>{{deadlineTime}}</text><text class="deadline-chevron">›</text></view></view></picker></view><view class="deadline-policy"><view class="deadline-policy-icon">i</view><view><view class="deadline-policy-title">{{ui.expiryPolicy}}</view><view class="deadline-policy-copy">{{ui.closeHint}}</view></view></view></block><view wx:else class="deadline-policy no-deadline-active"><view class="deadline-policy-icon">✓</view><view><view class="deadline-policy-title">{{ui.noDeadlineActive}}</view><view class="deadline-policy-copy">{{ui.noDeadlineActiveHint}}</view></view></view></view><view class="flow-card task-fee-card"><view class="flow-head"><text class="step">3</text><text>{{ui.price}}</text></view><view class="row fee-control"><text class="fee-round" data-delta="-1" bindtap="changePrice">−</text><view class="fee-value"><text class="amount">¥</text><input always-embed class="price-input" type="digit" value="{{priceText}}" bindinput="priceInput" bindblur="priceBlur" maxlength="9"/><view class="hint">{{ui.typeAny}}</view></view><text class="fee-round" data-delta="1" bindtap="changePrice">＋</text></view></view><view class="flow-card total-card"><view class="row hint"><text>{{ui.price}}</text><text class="strong">¥{{priceLabel}}</text></view><view class="divider"/><view class="row total-line"><text>{{ui.total}}</text><text>¥{{total}}</text></view><view class="green-note">{{ui.testNote}}</view></view></view><view class="flow-bottom task-bottom"><button class="btn" disabled="{{!agreed||busy||!validTitle||!validPrice||!deadlineReady}}" loading="{{busy}}" bindtap="post">{{postLabel}}</button></view></view><yuni-assistant topic=""/>
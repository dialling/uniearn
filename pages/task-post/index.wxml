<view style="{{motionStyle}}">
<lang-switch></lang-switch>
<view class="flow-page task-post-page {{darkClass}}"><view class="task-header"><view class="flow-title">{{ui.title}}</view><view class="flow-sub">{{ui.sub}}</view></view><view class="task-content"><view wx:if="{{tripId && trip}}" class="flow-card"><view class="strong">{{trip.station}} → {{trip.destinationType==='place'?(trip.deliveryAddress||trip.dorm):trip.dorm}}</view><view wx:if="{{trip.pickupAddress}}" class="hint">{{trip.pickupAddress}}</view><view wx:if="{{trip.waypoint}}" class="hint">{{zh?'途经：':'Via: '}}{{trip.waypoint}}</view><view class="hint">{{zh?'将加入这位跑手的行程，无需另设截止时间。':'Your task joins this runner’s route. No separate deadline is needed.'}}</view></view><view wx:if="{{tripId && !tripReady}}" class="orange-note">{{tripError}}</view><view class="flow-card"><view class="flow-head task-need-head"><text class="step">1</text><text class="task-need-title">{{ui.need}}</text><view wx:if="{{!tripId}}" class="task-mode-switch"><view class="task-mode-option {{taskMode==='online'?'selected':''}}" data-mode="online" bindtap="setTaskMode" role="button" aria-pressed="{{taskMode==='online'}}">{{zh?'线上':'Online'}}</view><view class="task-mode-option {{taskMode==='offline'?'selected':''}}" data-mode="offline" bindtap="setTaskMode" role="button" aria-pressed="{{taskMode==='offline'}}">{{zh?'线下':'In person'}}</view></view></view><textarea class="field task-copy" value="{{title}}" data-field="title" bindinput="text" maxlength="4000" auto-height placeholder="{{ui.placeholder}}"/><view class="hint task-location-hint">{{taskMode==='online'?(zh?'无需到场，请写明线上完成的内容和交付方式。':'No visit needed. Describe the task and how to deliver it online.'):ui.location}} {{zh?'任务描述至少填写 5 个字。':'Use at least 5 characters.'}}</view><view class="upload-card upload-blue"><view class="upload-head" bindtap="handlePhoto" hover-class="upload-card-press" role="button"><view class="upload-icon"><image src="/assets/photo-blue.svg" mode="aspectFit"/></view><view class="upload-copy"><view class="upload-title">{{zh?'任务参考图片（选填）':'Task reference photos (optional)'}}</view><view class="upload-hint">{{zh?'帮助跑手理解需求，最多 3 张。':'Help explain your task. Up to 3 photos.'}}</view></view></view><text class="upload-count">{{photos.length}}/3</text><view wx:if="{{photos.length>0}}" class="upload-gallery"><view wx:for="{{photos}}" wx:for-item="picture" wx:key="*this" class="upload-tile"><image class="upload-image" src="{{picture}}" mode="aspectFill" data-index="{{index}}" bindtap="previewPhoto"/><view class="upload-remove" data-index="{{index}}" catchtap="removePhoto" role="button" aria-label="{{zh?'删除照片':'Remove photo'}}">×</view></view><view wx:if="{{photos.length<3}}" class="upload-tile upload-more" bindtap="handlePhoto" role="button" aria-label="{{zh?'继续添加照片':'Add another photo'}}">＋</view></view></view></view><view wx:if="{{!tripId}}" class="flow-card deadline-card"><view class="flow-head"><text class="step">2</text><text>{{ui.doneBy}}</text></view><view class="deadline-modes"><view class="deadline-mode {{deadlineMode==='timed'?'selected':''}}" data-mode="timed" bindtap="setDeadlineMode"><view class="deadline-mode-dot">{{deadlineMode==='timed'?'✓':''}}</view><view><view class="deadline-mode-title">{{ui.withDeadline}}</view><view class="deadline-mode-hint">{{ui.withDeadlineHint}}</view></view></view><view class="deadline-mode {{deadlineMode==='none'?'selected':''}}" data-mode="none" bindtap="setDeadlineMode"><view class="deadline-mode-dot">{{deadlineMode==='none'?'✓':''}}</view><view><view class="deadline-mode-title">{{ui.noDeadline}}</view><view class="deadline-mode-hint">{{ui.noDeadlineHint}}</view></view></view></view><block wx:if="{{deadlineMode==='timed'}}"><view class="deadline-fields"><picker class="deadline-picker" mode="date" value="{{deadlineDate}}" start="{{today}}" bindchange="deadlineDateChange"><view class="deadline-field"><text class="deadline-label">{{ui.date}}</text><view class="deadline-value"><text>{{deadlineDate}}</text><text class="deadline-chevron">›</text></view></view></picker><picker class="deadline-picker" mode="time" value="{{deadlineTime}}" bindchange="deadlineTimeChange"><view class="deadline-field"><text class="deadline-label">{{ui.time}}</text><view class="deadline-value"><text>{{deadlineTime}}</text><text class="deadline-chevron">›</text></view></view></picker></view><view class="deadline-policy"><view class="deadline-policy-icon">i</view><view><view class="deadline-policy-title">{{ui.expiryPolicy}}</view><view class="deadline-policy-copy">{{ui.closeHint}}</view></view></view></block><view wx:else class="deadline-policy no-deadline-active"><view class="deadline-policy-icon">✓</view><view><view class="deadline-policy-title">{{ui.noDeadlineActive}}</view><view class="deadline-policy-copy">{{ui.noDeadlineActiveHint}}</view></view></view></view><view class="flow-card task-fee-card"><view class="flow-head"><text class="step">{{tripId?2:3}}</text><text>{{ui.price}}</text></view><view class="row fee-control"><text class="fee-round" data-delta="-1" bindtap="changePrice">−</text><view class="fee-value"><text class="amount">¥</text><input always-embed class="price-input" type="digit" value="{{priceText}}" bindinput="priceInput" bindblur="priceBlur" maxlength="9"/><view class="hint">{{ui.typeAny}}</view></view><text class="fee-round" data-delta="1" bindtap="changePrice">＋</text></view></view><view class="flow-card total-card"><view class="row hint"><text>{{ui.price}}</text><text class="strong">¥{{priceLabel}}</text></view><view class="divider"/><view class="row total-line"><text>{{ui.total}}</text><text>¥{{total}}</text></view><view class="green-note">{{ui.testNote}}</view></view></view><view class="flow-bottom task-bottom"><button class="btn" disabled="{{!agreed||busy||!validTitle||!validPrice||!deadlineReady||(tripId && !tripReady)}}" loading="{{busy}}" bindtap="post">{{postLabel}}</button></view></view><yuni-assistant topic=""/>
</view>

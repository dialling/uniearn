<lang-switch/>
<view class="flow-page task-post-page {{darkClass}}"><view class="task-header"><view class="flow-title">{{ui.title}}</view><view class="flow-sub">{{ui.sub}}</view></view><view class="task-content">
<view class="flow-card"><view class="flow-head"><text class="step">1</text><text>{{ui.need}}</text></view><textarea class="field task-copy" value="{{title}}" data-field="title" bindinput="text" maxlength="4000" auto-height placeholder="{{ui.placeholder}}"/><view class="hint task-location-hint">{{ui.location}}</view><view class="hint example-label">{{ui.exampleLabel}}</view><view class="pills"><text wx:for="{{examples}}" wx:key="*this" class="pill" data-value="{{item}}" bindtap="example">{{item}}</text></view><view class="dash photo-entry" bindtap="handlePhoto"><image src="/assets/photo.svg"/><text>{{photo?ui.photoAdded:ui.addPhoto}}</text><text class="hint" wx:if="{{!photo}}">{{ui.optional}}</text></view><image wx:if="{{photo}}" class="thumb" src="{{photo}}" mode="aspectFill"/><text wx:if="{{photo}}" class="link" bindtap="remove">{{ui.remove}}</text></view>
<view class="flow-card task-fee-card"><view class="flow-head"><text class="step dark">2</text><text>{{ui.price}}</text></view><view class="row fee-control"><text class="fee-round" data-delta="-1" bindtap="changePrice">−</text><view class="fee-value"><text class="amount">¥</text><input always-embed class="price-input" type="digit" value="{{priceText}}" bindinput="priceInput" bindblur="priceBlur" maxlength="9"/><view class="hint">{{ui.typeAny}}</view></view><text class="fee-round" data-delta="1" bindtap="changePrice">＋</text></view></view>
<view class="flow-card total-card"><view class="row hint"><text>{{ui.price}}</text><text class="strong">¥{{priceLabel}}</text></view><view class="divider"/><view class="row total-line"><text>{{ui.total}}</text><text>¥{{total}}</text></view><view class="green-note">{{ui.testNote}}</view></view></view>
<view class="flow-bottom task-bottom"><button class="btn" disabled="{{!agreed||busy||!validTitle||!validPrice}}" loading="{{busy}}" bindtap="post">{{postLabel}}</button></view></view><yuni-assistant topic=""/>

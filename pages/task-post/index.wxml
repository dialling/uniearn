<wxs src="../../utils/dorm-label.wxs" module="dl"/>
<view style="{{motionStyle}}">
<lang-switch></lang-switch>
<!-- 2026-11-15 redesign (same family as Start a trip): help-type tiles, then one quiet card per step, total beside the button. -->
<view class="flow-page task-post-page tp-page {{darkClass}}">
 <view class="tp-head">
  <view class="tp-title">{{ui.title}}</view>
  <view class="tp-lead">{{ui.sub}}</view>
 </view>

 <view wx:if="{{tripId && trip}}" class="tp-trip">
  <image src="/assets/icons3d/trip.svg" mode="aspectFit"/>
  <view class="tp-grow"><view class="tp-trip-route">{{trip.station}} → {{trip.destinationType==='place'?(trip.deliveryAddress||trip.dorm):dl.labels(trip,zh)}}</view><view wx:if="{{trip.pickupAddress}}" class="tp-note">{{trip.pickupAddress}}</view><view wx:if="{{trip.waypoint}}" class="tp-note">{{zh?'途经：':'Via: '}}{{trip.waypoint}}</view><view class="tp-note">{{zh?'将加入这位跑手的行程，无需另设截止时间。':'Your task joins this runnerʼs route. No separate deadline is needed.'}}</view></view>
 </view>
 <view wx:if="{{tripId && !tripReady}}" class="tp-error">{{tripError}}</view>

 <!-- 1 What -->
 <view class="flow-card tp-card">
  <view class="flow-head tp-step-head"><image class="tp-head-icon" mode="aspectFit" src="/assets/icons3d/task.svg"/><text>{{ui.need}}</text></view>
  <view wx:if="{{!tripId}}" class="tp-modes" role="radiogroup" aria-label="{{ui.helpMode}}">
   <view class="tp-mode {{taskMode==='offline'?'on':''}}" role="radio" aria-checked="{{taskMode==='offline'}}" data-mode="offline" bindtap="setTaskMode"><image src="/assets/icons3d/offline.svg" mode="aspectFit"/><text>{{ui.offlineHelp}}</text></view>
   <view class="tp-mode {{taskMode==='online'?'on':''}}" role="radio" aria-checked="{{taskMode==='online'}}" data-mode="online" bindtap="setTaskMode"><image src="/assets/icons3d/online.svg" mode="aspectFit"/><text>{{ui.onlineHelp}}</text></view>
  </view>
  <textarea class="tp-text" value="{{title}}" data-field="title" bindinput="text" maxlength="4000" auto-height placeholder="{{taskMode==='online'?ui.onlinePlaceholder:ui.placeholder}}" placeholder-class="tp-placeholder"/>
  <view class="tp-note">{{taskMode==='online'?ui.onlineLocation:ui.location}}</view>
  <view wx:if="{{!photos.length}}" class="tp-photo-add" hover-class="tp-press" role="button" bindtap="handlePhoto"><image src="/assets/icons/camera-white.svg" mode="aspectFit"/><text>{{zh?'添加图片（选填）':'Add photos (optional)'}}</text><text class="tp-photo-count">0/3</text></view>
  <block wx:else>
   <view class="pg-grid tp-photos"><view wx:for="{{photos}}" wx:key="*this" class="pg-tile" data-index="{{index}}" bindtap="previewPhoto"><image class="pg-img" src="{{item}}" mode="aspectFill"/><view class="pg-x" data-index="{{index}}" catchtap="removePhoto">×</view></view><view wx:if="{{photos.length<3}}" class="pg-add-square" hover-class="pg-add-press" aria-label="{{zh?'继续添加图片':'Add another photo'}}" bindtap="handlePhoto"><text class="pg-add-plus">+</text></view></view>
   <view class="tp-note">{{photos.length}}/3 {{zh?'，点照片右上角的 × 删除':', tap × to remove a photo'}}</view>
  </block>
 </view>

 <!-- 2 When -->
 <view wx:if="{{!tripId}}" class="flow-card deadline-card">
  <view class="flow-head tp-step-head"><image class="tp-head-icon" mode="aspectFit" src="/assets/icons3d/clock.svg"/><text>{{ui.doneBy}}</text></view>
  <view class="tp-seg" role="radiogroup">
   <view class="tp-seg-item {{deadlineMode==='none'?'on':''}}" role="radio" aria-checked="{{deadlineMode==='none'}}" data-mode="none" bindtap="setDeadlineMode">{{ui.noDeadline}}</view>
   <view class="tp-seg-item {{deadlineMode==='timed'?'on':''}}" role="radio" aria-checked="{{deadlineMode==='timed'}}" data-mode="timed" bindtap="setDeadlineMode">{{ui.withDeadline}}</view>
  </view>
  <block wx:if="{{deadlineMode==='timed'}}">
   <!-- Full-width rows (approved 2026-11-15); each opens WeChat's own wheel: date = month | day | year, time = hour | minute | AM/PM. -->
   <view class="tp-pickers">
    <picker mode="date" value="{{deadlineDate}}" start="{{today}}" bindchange="deadlineDateChange"><view class="tp-picker"><text class="tp-picker-label">{{ui.date}}</text><text class="tp-picker-value">{{deadlineDate}}</text><view class="tp-chev"/></view></picker>
    <picker mode="time" value="{{deadlineTime}}" bindchange="deadlineTimeChange"><view class="tp-picker"><text class="tp-picker-label">{{ui.time}}</text><text class="tp-picker-value">{{deadlineTime}}</text><view class="tp-chev"/></view></picker>
   </view>
   <view class="deadline-policy tp-policy"><text class="tp-policy-icon">i</text><text>{{ui.closeHint}}</text></view>
  </block>
  <view wx:else class="deadline-policy no-deadline-active"><text class="tp-policy-icon">✓</text><text>{{ui.noDeadlineActiveHint}}</text></view>
 </view>

 <!-- 3 Offer -->
 <view class="flow-card task-fee-card tp-card">
  <view class="flow-head tp-step-head"><image class="tp-head-icon" mode="aspectFit" src="/assets/icons3d/coin.svg"/><text>{{ui.price}}</text></view>
  <view class="tp-offer">
   <view class="tp-round" role="button" aria-label="{{zh?'减少':'Lower'}}" data-delta="-1" bindtap="changePrice">−</view>
   <view class="tp-amount"><text class="tp-yuan">¥</text><input always-embed class="tp-price" type="digit" value="{{priceText}}" bindinput="priceInput" bindblur="priceBlur" maxlength="9"/></view>
   <view class="tp-round" role="button" aria-label="{{zh?'增加':'Raise'}}" data-delta="1" bindtap="changePrice">+</view>
  </view>
  <view class="tp-note tp-center">{{ui.typeAny}}</view>
 </view>
 <view class="tp-test">{{zh?'团队测试，不会真实扣款。跑手接单前可免费取消。':'Team test: no real payment is taken. Cancel for free until a runner takes it.'}}</view>

 <view class="flow-bottom task-bottom tp-bottom">
  <view class="tp-sum"><text>{{ui.total}}</text><text class="tp-sum-money">¥{{total}}</text></view>
  <button class="btn tp-go" disabled="{{!agreed||busy||!validTitle||!validPrice||!deadlineReady}}" loading="{{busy}}" bindtap="post">{{postLabel}}</button>
 </view>
</view>
<yuni-assistant topic=""/>
<coach-tip name="task" when="{{!tripId}}"/>
</view>

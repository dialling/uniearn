<view style="{{motionStyle}}">
<lang-switch></lang-switch>
<view class="flow-page task-post-page {{darkClass}}"><view class="task-header"><view class="flow-title">{{ui.title}}</view><view class="flow-sub">{{ui.sub}}</view></view><view class="task-content"><view wx:if="{{tripId && trip}}" class="flow-card"><view class="strong">{{trip.station}} → {{trip.destinationType==='place'?(trip.deliveryAddress||trip.dorm):trip.dorm}}</view><view wx:if="{{trip.pickupAddress}}" class="hint">{{trip.pickupAddress}}</view><view wx:if="{{trip.waypoint}}" class="hint">{{zh?'途经：':'Via: '}}{{trip.waypoint}}</view><view class="hint">{{zh?'将加入这位跑手的行程，无需另设截止时间。':'Your task joins this runner’s route. No separate deadline is needed.'}}</view></view><view wx:if="{{tripId && !tripReady}}" class="orange-note">{{tripError}}</view><view class="flow-card"><view class="flow-head"><text class="step">1</text><text>{{ui.need}}</text></view><view wx:if="{{!tripId}}" class="task-help-selector"><view class="task-help-label">{{ui.helpMode}}</view><view class="task-help-modes"><button class="task-help-mode {{taskMode==='offline'?'selected':''}}" data-mode="offline" bindtap="setTaskMode" aria-pressed="{{taskMode==='offline'}}"><image class="task-help-icon" mode="aspectFit" src="/assets/icons3d/offline.svg"/><text>{{ui.offlineHelp}}</text></button><button class="task-help-mode {{taskMode==='online'?'selected':''}}" data-mode="online" bindtap="setTaskMode" aria-pressed="{{taskMode==='online'}}"><image class="task-help-icon" mode="aspectFit" src="/assets/icons3d/online.svg"/><text>{{ui.onlineHelp}}</text></button></view><view wx:if="{{taskMode==='online'}}" class="hint task-help-hint">{{ui.onlineHint}}</view></view><textarea class="field task-copy" value="{{title}}" data-field="title" bindinput="text" maxlength="4000" auto-height placeholder="{{taskMode==='online'?ui.onlinePlaceholder:ui.placeholder}}"/><view class="hint task-location-hint">{{taskMode==='online'?ui.onlineLocation:ui.location}} {{zh?'任务描述至少填写 5 个字。':'Use at least 5 characters.'}}</view><view wx:if="{{!photos.length}}" class="dash photo-entry photo-entry-blue" hover-class="photo-entry-press" bindtap="handlePhoto"><view class="photo-entry-plus"><image class="photo-entry-icon" mode="aspectFit" src="/assets/icons/camera-white.svg"/></view><text class="photo-entry-label">{{zh?'添加图片':'Add photo'}}</text><text class="photo-entry-count">{{photos.length}}/3</text></view><block wx:else><view class="pg-grid"><view wx:for="{{photos}}" wx:key="*this" class="pg-tile" data-index="{{index}}" bindtap="previewPhoto"><image class="pg-img" src="{{item}}" mode="aspectFill"/><view class="pg-x" data-index="{{index}}" catchtap="removePhoto">×</view></view><view wx:if="{{photos.length<3}}" class="pg-add-square" hover-class="pg-add-press" aria-label="{{zh?'继续添加图片':'Add another photo'}}" bindtap="handlePhoto"><text class="pg-add-plus">+</text></view></view><view class="pg-help">{{photos.length}}/3 · {{zh?'点照片右上角的小叉即可删除':'Tap × on a photo to remove it'}}</view></block></view><view wx:if="{{!tripId}}" class="flow-card deadline-card"><view class="flow-head"><text class="step">2</text><text>{{ui.doneBy}}</text></view><view class="deadline-modes"><view class="deadline-mode {{deadlineMode==='timed'?'selected':''}}" data-mode="timed" bindtap="setDeadlineMode"><view class="deadline-mode-dot">{{deadlineMode==='timed'?'✓':''}}</view><view><view class="deadline-mode-title">{{ui.withDeadline}}</view><view class="deadline-mode-hint">{{ui.withDeadlineHint}}</view></view></view><view class="deadline-mode {{deadlineMode==='none'?'selected':''}}" data-mode="none" bindtap="setDeadlineMode"><view class="deadline-mode-dot">{{deadlineMode==='none'?'✓':''}}</view><view><view class="deadline-mode-title">{{ui.noDeadline}}</view><view class="deadline-mode-hint">{{ui.noDeadlineHint}}</view></view></view></view><block wx:if="{{deadlineMode==='timed'}}"><view class="deadline-fields"><picker class="deadline-picker" mode="date" value="{{deadlineDate}}" start="{{today}}" bindchange="deadlineDateChange"><view class="deadline-field"><text class="deadline-label">{{ui.date}}</text><view class="deadline-value"><text>{{deadlineDate}}</text><text class="deadline-chevron">›</text></view></view></picker><picker class="deadline-picker" mode="time" value="{{deadlineTime}}" bindchange="deadlineTimeChange"><view class="deadline-field"><text class="deadline-label">{{ui.time}}</text><view class="deadline-value"><text>{{deadlineTime}}</text><text class="deadline-chevron">›</text></view></view></picker></view><view class="deadline-policy"><view class="deadline-policy-icon">i</view><view><view class="deadline-policy-title">{{ui.expiryPolicy}}</view><view class="deadline-policy-copy">{{ui.closeHint}}</view></view></view></block><view wx:else class="deadline-policy no-deadline-active"><view class="deadline-policy-icon">✓</view><view><view class="deadline-policy-title">{{ui.noDeadlineActive}}</view><view class="deadline-policy-copy">{{ui.noDeadlineActiveHint}}</view></view></view></view><view class="flow-card task-fee-card"><view class="flow-head"><text class="step">{{tripId?2:3}}</text><text>{{ui.price}}</text></view><view class="row fee-control"><text class="fee-round" data-delta="-1" bindtap="changePrice">−</text><view class="fee-value"><text class="amount">Balance ¥</text><input always-embed class="price-input" type="digit" value="{{priceText}}" bindinput="priceInput" bindblur="priceBlur" maxlength="9"/><view class="hint">{{ui.typeAny}}</view></view><text class="fee-round" data-delta="1" bindtap="changePrice">＋</text></view></view><view class="flow-card total-card"><view class="row hint"><text>{{ui.price}}</text><text class="strong">¥{{priceLabel}}</text></view><view class="divider"/><view class="row total-line"><text>{{ui.total}}</text><text>¥{{total}}</text></view><view class="green-note">{{ui.testNote}}</view></view></view><view class="flow-bottom task-bottom"><button class="btn" disabled="{{!agreed||busy||!validTitle||!validPrice||!deadlineReady||(!!tripId && !tripReady)}}" loading="{{busy}}" bindtap="post">{{postLabel}}</button></view></view><yuni-assistant topic=""/>
</view>

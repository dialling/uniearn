<lang-switch/>
<view class="flow-page task-post-page"><view class="task-header"><view class="flow-title">{{ui.title}}</view><view class="flow-sub">{{ui.sub}}</view></view><view class="task-content"><yuni-tip tip-key="task-post" pose="think" text="{{ui.tip}}"/>
<view class="flow-card"><view class="flow-head"><text class="step">1</text><text>{{ui.need}}</text></view><textarea class="field task-copy" value="{{title}}" data-field="title" bindinput="text" maxlength="4000" auto-height placeholder="{{ui.placeholder}}"/><view class="hint task-location-hint">{{ui.location}}</view><view class="hint example-label">{{ui.exampleLabel}}</view><view class="pills"><text wx:for="{{examples}}" wx:key="*this" class="pill" data-value="{{item}}" bindtap="example">{{item}}</text></view><view class="dash photo-entry" bindtap="handlePhoto"><image src="/assets/photo.svg"/><text>{{photo?ui.photoAdded:ui.addPhoto}}</text><text class="hint" wx:if="{{!photo}}">{{ui.optional}}</text></view><image wx:if="{{photo}}" class="thumb" src="{{photo}}" mode="aspectFill"/><text wx:if="{{photo}}" class="link" bindtap="remove">{{ui.remove}}</text></view>
<view class="flow-card"><view class="flow-head"><text class="step">2</text><text>{{ui.doneBy}}</text></view><view class="two-cols deadline-inputs"><view><view class="field-label">{{ui.date}}</view><picker mode="date" value="{{date}}" start="{{today}}" bindchange="handleDate"><view class="field">{{date}}<text>▣</text></view></picker></view><view><view class="field-label">{{ui.time}}</view><picker mode="time" value="{{time}}" bindchange="handleTime"><view class="field">{{time}}<text>◷</text></view></picker></view></view><view class="deadline-summary">◷　{{dueLabel}}</view><view class="pills time-shortcuts"><text class="pill" data-value="hour" bindtap="shortcut">{{ui.inHour}}</text><text class="pill" data-value="tonight" bindtap="shortcut">{{ui.tonight}}</text><text class="pill" data-value="tomorrow" bindtap="shortcut">{{ui.tomorrow}}</text></view><view class="hint">{{ui.closeHint}}</view></view>
<view class="flow-card"><view class="flow-head"><text class="step">3</text><text>{{ui.price}}</text><text class="minimum">{{ui.minimum}}</text></view><view class="price-control"><button data-delta="-1" bindtap="changePrice">−</button><view class="price-entry"><text>¥</text><input class="task-price" type="digit" value="{{priceText}}" bindinput="priceInput" bindblur="priceBlur" maxlength="9"/></view><button data-delta="1" bindtap="changePrice">＋</button></view><view class="hint center price-help">{{ui.typeAny}}</view><view class="pills price-presets"><text wx:for="{{prices}}" wx:key="*this" class="pill {{price===item?'selected':''}}" data-value="{{item}}" bindtap="handlePrice">¥{{item}}</text></view><view class="hint center">{{trusted?ui.trusted:ui.anyRunner}}</view></view>
<view class="flow-card total-card"><view class="row hint"><text>{{ui.price}}</text><text class="strong">¥{{priceLabel}}</text></view><view class="row hint"><text>{{ui.serviceFee}}</text><text class="strong">¥0.00</text></view><view class="hint">{{ui.feeHint}}</view><view class="divider"/><view class="row total-line"><text>{{ui.total}}</text><text>¥{{total}}</text></view><view class="green-note">{{ui.testNote}}</view></view></view>
<view class="flow-bottom task-bottom"><view class="agreement-row" bindtap="agree"><text class="check {{agreed?'checked':''}}">{{agreed?'✓':''}}</text><view>{{ui.agreePre}}<text class="link" catchtap="rules">{{ui.agreeLink}}</text>{{ui.agreePost}}</view></view><button class="btn" disabled="{{!agreed||busy||!validTitle||!validDeadline||!validPrice}}" loading="{{busy}}" bindtap="post">{{postLabel}}</button></view></view><yuni-assistant topic=""/>

@import "../../utils/flow.wxss";
@import "../../utils/fee-control.wxss";
.deadline-modes{display:flex;gap:14rpx;margin-bottom:20rpx}.deadline-mode{display:flex;align-items:center;gap:12rpx;flex:1;min-width:0;padding:17rpx 16rpx;border:1rpx solid #e2e0d9;border-radius:18rpx;background:#f7f6f2}.deadline-mode.selected{border:2rpx solid #1d4ed8;background:#f1f4fc}.deadline-mode-dot{display:flex;align-items:center;justify-content:center;flex:0 0 30rpx;width:30rpx;height:30rpx;border:2rpx solid #b6b2a8;border-radius:50%;color:#fff;font-size:19rpx;font-weight:800}.deadline-mode.selected .deadline-mode-dot{border-color:#1d4ed8;background:#1d4ed8}.deadline-mode-title{font-size:24rpx;font-weight:750;line-height:1.35}.deadline-mode-hint{margin-top:3rpx;color:#6b6860;font-size:19rpx;line-height:1.35}.deadline-fields{display:flex;gap:18rpx}.deadline-picker{flex:1;min-width:0}.deadline-field{padding:18rpx 20rpx;border:1rpx solid #e2e0d9;border-radius:18rpx;background:#f7f6f2}.deadline-label{display:block;margin-bottom:8rpx;color:#6b6860;font-size:21rpx}.deadline-value{display:flex;align-items:center;justify-content:space-between;color:#16181c;font-size:27rpx;font-weight:750}.deadline-chevron{color:#1d4ed8;font-size:36rpx;line-height:1}.deadline-policy{display:flex;align-items:flex-start;gap:14rpx;margin-top:18rpx;padding:19rpx 20rpx;border-radius:18rpx;background:#e7f3ed;color:#0b7a55}.deadline-policy-icon{display:flex;align-items:center;justify-content:center;flex:0 0 34rpx;width:34rpx;height:34rpx;border:2rpx solid currentColor;border-radius:50%;font-size:20rpx;font-weight:800}.deadline-policy-title{font-size:23rpx;font-weight:800}.deadline-policy-copy{margin-top:5rpx;font-size:21rpx;line-height:1.5}.no-deadline-active{margin-top:0;padding:23rpx 20rpx}
.task-post-page{padding:0 0 230rpx}.task-header{background:transparent;padding:28rpx 38rpx 18rpx}.task-header .flow-title{margin:0}.task-header .flow-sub{margin:6rpx 0 0}.task-content{padding:12rpx 38rpx}.task-post-page .flow-card{padding:26rpx;border-radius:26rpx}.task-post-page .step{background:#1d4ed8;border:2rpx solid #44423c;width:46rpx;min-width:46rpx;height:46rpx;line-height:42rpx;border-radius:10rpx}.task-post-page .flow-head{font-size:28rpx}.task-copy{min-height:130rpx;font-size:26rpx}.task-post-page .pill{font-size:22rpx;padding:17rpx 21rpx}.example-label{font-weight:700;color:#5e5c55}.photo-entry{display:flex;align-items:center;gap:11rpx;background:#f7f6f2;border-color:#d6d2c6;padding:24rpx;font-weight:700;color:#44423c}.photo-entry image{width:30rpx;height:30rpx}.photo-entry .hint{font-weight:400;margin:0}.task-post-page .pill.selected{background:#1d4ed8;border-color:#1d4ed8;color:#fff}.total-card .total-line{margin:25rpx 0;font-size:30rpx}.task-bottom{padding:22rpx 38rpx calc(22rpx + env(safe-area-inset-bottom));z-index:20}.task-bottom .check{border-radius:3rpx;flex:none}.task-bottom .check.checked{background:#1d4ed8;border-color:#1d4ed8}.task-post-page .link{color:#1d4ed8}.task-bottom .btn{background:#1d4ed8;border-radius:23rpx;width:100%;margin:16rpx 0 0}.task-bottom .btn[disabled]{background:#e4e1d8;color:#8a877e}.task-bottom .agreement-row{font-size:21rpx;line-height:1.5;align-items:center;margin:0}

.page-dark.task-post-page .pill.selected{background:#9db4f0!important;border-color:#9db4f0!important;color:#16181c!important}
.page-dark.task-post-page .task-bottom .btn,.page-dark.task-post-page .step{background:#9db4f0;color:#16181c}
.page-dark.task-post-page .link{color:#9db4f0!important}

.task-fee-card .flow-head .badge{margin-left:auto;font-size:20rpx;font-weight:400;line-height:1.4;padding:5rpx 10rpx;background:#f0efea;border-radius:9rpx;color:#6b6860}

/* Photo upload entry: long dashed bar in the page accent colour. */
.photo-entry-blue{background:#f3f6fd;border-color:#c3d2f7;color:#1d4ed8}
.photo-entry-plus{display:flex;align-items:center;justify-content:center;flex:none;width:46rpx;height:46rpx;border-radius:12rpx;background:#1d4ed8;color:#fff;font-size:32rpx;font-weight:600;line-height:1}
.photo-entry-label{flex:1;min-width:0;font-size:25rpx;font-weight:700}
.photo-entry-count{flex:none;padding:2rpx 12rpx;border-radius:12rpx;background:#e3eafb;color:#1d4ed8;font-size:21rpx;font-weight:600;line-height:1.6}
.photo-entry-press{background:#e8eefc}
.page-dark .photo-entry-blue{background:#1d2433;border-color:#33406b;color:#9db4ff}
.page-dark .photo-entry-plus{background:#9db4ff;color:#16181c}
.page-dark .photo-entry-count{background:#232c42;color:#9db4ff}
.page-dark .photo-entry-press{background:#233050}

/* Add-more slot that follows the thumbnails once a photo exists. */
.pg-add-square{display:flex;align-items:center;justify-content:center;flex:none;width:168rpx;height:168rpx;box-sizing:border-box;border:2rpx dashed #c3d2f7;border-radius:20rpx;background:#f3f6fd;color:#1d4ed8}
.pg-add-plus{font-size:56rpx;font-weight:600;line-height:1}
.pg-add-press{transform:scale(.96);background:#e8eefc}
.page-dark .pg-add-square{background:#1d2433;border-color:#33406b;color:#9db4ff}
.page-dark .pg-add-press{background:#233050}

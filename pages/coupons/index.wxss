page{min-height:100%;background:#f1f5f0;color:#23342c}.wallet-page{min-height:100vh;padding:26rpx 30rpx 56rpx;box-sizing:border-box;background:linear-gradient(180deg,#e7f0e8 0,#f1f5f0 330rpx)}.wallet-heading{padding:12rpx 4rpx 30rpx}.wallet-title{font-size:40rpx;line-height:1.35;font-weight:700;color:#234b38}.wallet-subtitle{font-size:24rpx;color:#789080;margin-top:8rpx}.wallet-tabs{display:flex;padding:7rpx;background:#e3ebe3;border-radius:24rpx;margin-bottom:26rpx}.wallet-tab{flex:1;text-align:center;padding:17rpx 0;font-size:25rpx;color:#728377;border-radius:19rpx}.wallet-tab.active{background:#fff;color:#315d45;font-weight:650;box-shadow:0 4rpx 14rpx rgba(41,76,54,.09)}.coupon-card{position:relative;background:#fffefa;border-radius:24rpx;margin:0 0 24rpx;overflow:hidden;box-shadow:0 8rpx 22rpx rgba(47,77,57,.08);border:1rpx solid rgba(71,115,81,.08)}.coupon-main{min-height:174rpx;display:flex;align-items:center;padding:22rpx 23rpx 18rpx;box-sizing:border-box;background:linear-gradient(108deg,#fff9f3,#fff)}.coupon-value{width:178rpx;flex-shrink:0;color:#c94d35;font-size:57rpx;line-height:1;font-weight:750;letter-spacing:-2rpx}.currency{font-size:29rpx;margin-right:3rpx;vertical-align:top;line-height:1.6;letter-spacing:0}.coupon-copy{flex:1;min-width:0;padding-left:8rpx}.coupon-name{font-size:27rpx;font-weight:650;color:#34483c;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.coupon-kind{margin-top:9rpx;font-size:22rpx;color:#8c9b8f}.coupon-expiry{margin-top:12rpx;font-size:20rpx;color:#a0aaa1}.coupon-status{position:absolute;right:23rpx;top:21rpx;font-size:19rpx;color:#bd533d;background:#fff0e9;padding:7rpx 13rpx;border-radius:30rpx}.coupon-divider{height:1rpx;position:relative;display:flex;align-items:center;padding:0 22rpx}.coupon-divider .dash{height:1rpx;flex:1;border-top:2rpx dashed #eaded4}.cutout{position:absolute;top:-14rpx;width:28rpx;height:28rpx;border-radius:50%;background:#edf3ed}.cutout.left{left:-15rpx}.cutout.right{right:-15rpx}.coupon-bottom{min-height:78rpx;padding:12rpx 22rpx;display:flex;align-items:center;justify-content:space-between;gap:15rpx}.coupon-note{font-size:21rpx;color:#87958a;line-height:1.45;flex:1}.use-button{margin:0;min-width:136rpx;height:57rpx;line-height:57rpx;padding:0 22rpx;border-radius:32rpx;background:#c94d35;color:#fff;font-size:23rpx;font-weight:600}.use-button::after{border:0}.coupon-muted{filter:saturate(.35);opacity:.82}.used-stamp{font-size:21rpx;color:#9aa49b;padding:6rpx 14rpx;border:1rpx solid #c8d0c8;border-radius:28rpx}.wallet-empty{margin-top:116rpx;text-align:center;color:#819087}.empty-icon{width:100rpx;height:100rpx;line-height:100rpx;border-radius:50%;margin:0 auto 24rpx;background:#e2ebe2;color:#a4b4a5;font-size:40rpx;font-weight:700}.empty-title{font-size:29rpx;color:#53675a;font-weight:600}.empty-sub{font-size:22rpx;margin-top:12rpx;color:#9aa79d}.sheet-mask{position:fixed;inset:0;z-index:20;background:rgba(25,39,30,.38);display:flex;align-items:flex-end}.use-sheet{width:100%;box-sizing:border-box;padding:16rpx 30rpx calc(28rpx + env(safe-area-inset-bottom));border-radius:32rpx 32rpx 0 0;background:#f9fbf8}.sheet-handle{width:68rpx;height:8rpx;border-radius:8rpx;background:#d6ded7;margin:0 auto 23rpx}.sheet-title{font-size:32rpx;font-weight:700;color:#294b38}.sheet-coupon{font-size:22rpx;color:#c1543c;margin:8rpx 0 19rpx}.service-option{display:flex;align-items:center;background:#fff;border-radius:18rpx;padding:18rpx 20rpx;margin:12rpx 0}.service-icon{width:68rpx;height:68rpx;line-height:68rpx;text-align:center;border-radius:18rpx;color:#fff;font-size:27rpx;font-weight:650;margin-right:18rpx}.service-icon.takeaway{background:#d46a48}.service-icon.night{background:#bb593e}.service-icon.parcel{background:#66856b}.service-copy{flex:1;font-size:26rpx;color:#334a3b;font-weight:600}.service-copy text{display:block;margin-top:5rpx;font-size:20rpx;color:#97a298;font-weight:400}.service-arrow{font-size:40rpx;color:#9bac9f}.sheet-cancel{margin:17rpx 0 0;background:transparent;color:#75847a;font-size:25rpx}.sheet-cancel::after{border:0}

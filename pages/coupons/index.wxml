<view class="wallet-page {{darkClass}}">
 <view class="wallet-heading"><view class="wallet-title">{{language==='zh'?'我的卡包':'My wallet'}}</view><view class="wallet-subtitle">{{language==='zh'?'优惠券都收在这里':'All your coupons in one place'}}</view></view>
 <view class="wallet-tabs"><view class="wallet-tab {{tab==='available'?'active':''}}" data-tab="available" bindtap="switchTab">{{language==='zh'?'可使用':'Available'}}</view><view class="wallet-tab {{tab==='used'?'active':''}}" data-tab="used" bindtap="switchTab">{{language==='zh'?'已使用':'Used'}}</view><view class="wallet-tab {{tab==='expired'?'active':''}}" data-tab="expired" bindtap="switchTab">{{language==='zh'?'已过期':'Expired'}}</view></view>
 <view wx:if="{{loading}}" class="wallet-empty">{{language==='zh'?'正在同步优惠券…':'Syncing coupons…'}}</view>
 <block wx:elif="{{items.length}}">
  <view wx:for="{{items}}" wx:key="id" class="coupon-card {{item.status!=='available'?'coupon-muted':''}}">
   <view class="coupon-main"><view class="coupon-value"><text class="currency">¥</text>{{item.displayAmount}}</view><view class="coupon-copy"><view class="coupon-name">{{item.displayName}}</view><view class="coupon-kind">{{item.kindLabel}}</view><view class="coupon-expiry">{{item.expiryLabel}}</view></view><view class="coupon-status">{{item.statusLabel}}</view></view>
   <view class="coupon-bottom"><view class="coupon-note">{{item.descriptionDisplay|| (language==='zh'?'适用范围以发布页面为准':'See service options when using')}}</view><button wx:if="{{item.status==='available'}}" class="use-button" data-id="{{item.id}}" bindtap="openUse">{{language==='zh'?'去使用':'Use now'}}</button><view wx:else class="used-stamp">{{item.statusLabel}}</view></view>
  </view>
 </block>
 <view wx:elif="{{!loading}}" class="wallet-empty"><view class="empty-icon">券</view><view class="empty-title">{{language==='zh'?(tab==='available'?'暂时没有可用优惠券':tab==='used'?'还没有使用记录':'没有过期优惠券'):(tab==='available'?'No available coupons':tab==='used'?'No used coupons yet':'No expired coupons')}}</view><view class="empty-sub">{{language==='zh'?'获得的优惠券会自动放进卡包':'Coupons you receive will appear here'}}</view></view>
 <view wx:if="{{showUseFor}}" class="sheet-mask" bindtap="closeUse"><view class="use-sheet" catchtap="noop"><view class="sheet-handle"></view><view class="sheet-title">{{language==='zh'?'选择要发布的任务':'Choose a service'}}</view><view class="sheet-coupon">{{couponName}}</view><view class="service-option" data-id="{{showUseFor}}" data-channel="takeout" bindtap="goUse"><view class="service-icon takeaway">餐</view><view class="service-copy"><view>{{language==='zh'?'外卖代取':'Takeaway'}}</view><text>{{language==='zh'?'发布外卖配送任务':'Post a takeaway delivery task'}}</text></view><text class="service-arrow">›</text></view><view class="service-option" data-id="{{showUseFor}}" data-channel="night" bindtap="goUse"><view class="service-icon night">夜</view><view class="service-copy"><view>{{language==='zh'?'夜市代买':'Night market'}}</view><text>{{language==='zh'?'发布夜市代买任务':'Post a night market task'}}</text></view><text class="service-arrow">›</text></view><view class="service-option" data-id="{{showUseFor}}" data-channel="parcel" bindtap="goUse"><view class="service-icon parcel">递</view><view class="service-copy"><view>{{language==='zh'?'快递代取':'Parcel pickup'}}</view><text>{{language==='zh'?'发布快递代取任务':'Post a parcel pickup task'}}</text></view><text class="service-arrow">›</text></view><button class="sheet-cancel" bindtap="closeUse">{{language==='zh'?'取消':'Cancel'}}</button></view></view>
</view>

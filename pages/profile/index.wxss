/* Uniearn「我的」页面 — 按 design/profile_final_long.png 定稿重构 */
.me-page{background:#eeede8;padding:38rpx 38rpx 190rpx;min-height:100vh;color:#16181c}
.me-page .title{display:none}
.me-page .flow-card{padding:27rpx;border:1rpx solid #e2e0d9;border-radius:27rpx;margin-bottom:20rpx}

/* ① 个人资料与等级成长 */
.me-header{background:#0b7a55;color:#fff;border-radius:29rpx;padding:27rpx 25rpx 21rpx;margin:8rpx 0 20rpx;box-shadow:0 9rpx 22rpx rgba(11,122,85,.14)}
.me-header-top{display:flex;align-items:center;gap:12rpx;min-width:0}
.avatar{width:108rpx;height:108rpx;line-height:108rpx;font-size:43rpx}
.header-avatar{width:152rpx;height:152rpx;flex:none;display:flex;align-items:center;justify-content:center;background:transparent;border:0;border-radius:0;box-shadow:none;box-sizing:border-box;line-height:normal}
.header-avatar image{display:block;width:100%;height:100%}
.journey-rank{display:flex;align-items:center;gap:10rpx;flex:1;min-width:0}
.rank-badge{display:block;width:100rpx;height:100rpx;flex:none}
.journey-rank-copy{flex:1;min-width:0}
.journey-rank-number{margin-top:7rpx;color:#a77b29;font-size:19rpx;font-weight:750;letter-spacing:2rpx}
.customer-avatar{background:#ffffff24}
.runner-avatar{background:#ffffff24}
.header-main{flex:1;min-width:0}
.header-name{min-width:0;max-width:100%;font-size:32rpx;font-weight:700;line-height:1.2;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;color:#fff}
.header-actions{display:flex;flex:none;flex-direction:row;align-items:center;gap:8rpx}
.header-badge-row{display:flex;align-items:center;margin:5rpx 0 0;min-width:0}
.header-badge{max-width:100%;box-sizing:border-box;overflow:hidden;text-overflow:ellipsis;font-size:16rpx;line-height:1.4;padding:4rpx 10rpx;background:#e7f3ed;border-radius:26rpx;font-weight:600;color:#08523a;display:inline-block;white-space:nowrap}
.header-badge.verified{background:#e7f3ed;color:#08523a}
.runner-tag{display:inline-block;margin:0;font-size:17rpx;font-weight:600;color:#08523a;background:#e7f3ed;border-radius:26rpx;padding:4rpx 10rpx;line-height:1.4;white-space:nowrap}
.level-journey{background:transparent;border:0;border-radius:0;padding:0;margin:20rpx 0 0;box-shadow:none}
.level-journey-press{opacity:.82;transform:scale(.995)}
.journey-heading{display:flex;align-items:center;justify-content:space-between;gap:12rpx;padding:20rpx 18rpx;background:#fffcf3;border-radius:24rpx}
.journey-level{min-width:0;color:#192d49;font-size:28rpx;font-weight:750;line-height:1.35;overflow-wrap:break-word}
.journey-points{display:flex;align-items:baseline;gap:6rpx;flex:none;color:#276c50;font-size:19rpx;font-weight:600}
.journey-points-number{color:#276c50;font-size:41rpx;font-weight:750;line-height:1}
.journey-arrow{font-size:38rpx;line-height:1;margin-left:5rpx;color:#276c50}
.journey-nudge{margin:14rpx 0 0;color:#d3eadf;text-align:right;font-size:19rpx;font-weight:500;line-height:1.4;white-space:nowrap}
.hl-track{height:12rpx;background:#8fc9ae;border-radius:10rpx;overflow:hidden;margin:8rpx 0 8rpx}
.hl-fill{height:100%;background:#e7f3ed;border-radius:10rpx}
.hl-tiers{display:flex;justify-content:space-between;font-size:19rpx;font-weight:600;color:#d3eadf}
.hl-tiers text{flex:1;text-align:left}.hl-tiers .hl-end{text-align:right}
.hl-tiers .cur{color:#fff;font-weight:650}
.level-detail{margin-top:24rpx;border-top:1rpx solid #ffffff30;padding-top:22rpx}
.level-detail .level-grid .hint{color:#d3eadf}
.level-detail .level-nudge{background:#ffffff12;color:#e7f3ed}
.level-detail .mark-note,.level-detail .mark-note .hint{color:#d3eadf}

/* ② 数据卡 */
.me-stats{display:flex;gap:15rpx;margin-bottom:20rpx}
.me-stats>view{flex:1;min-width:0;border:1rpx solid #e2e0d9;border-radius:23rpx;background:#fff;padding:19rpx 21rpx;display:flex;flex-direction:column;gap:8rpx;color:#6b6860;font-size:23rpx}
.me-stats .stats-number{font-size:37rpx;line-height:1.3;color:#08523a;font-weight:800}
.me-stats>view.stat-blue{background:#eef5ff;border-color:#cbdcf3}.me-stats>view.stat-blue .stats-number{color:#2b5c93}
.me-stats>view.stat-green{background:#edf7ef;border-color:#c7e2cf}.me-stats>view.stat-green .stats-number{color:#287347}
.me-stats>view.stat-orange{background:#fff3e8;border-color:#f2d5ba}.me-stats>view.stat-orange .stats-number{color:#a94b17}

/* ③ 收益卡 */
.earnings-summary{border:2rpx solid #0b7a55!important}
.earnings-total{font-family:monospace;font-size:57rpx;line-height:1.1;color:#0b7a55;font-weight:800}
.earnings-body{align-items:flex-end;margin-bottom:24rpx}
.earnings-body .hint{font-size:21rpx}
.mini-bars{display:flex;gap:7rpx;align-items:flex-end;height:85rpx;flex:none}
.mini-bars view{width:12rpx;background:#0b7a55;border-radius:3rpx}
.mini-bars view:last-child{background:#e7f3ed}
.earnings-note{display:flex;gap:15rpx;align-items:flex-start;border-top:1rpx solid #f0eee8;padding-top:21rpx;font-size:23rpx;color:#6b6860;line-height:1.6}
.earnings-note image{width:24rpx;height:27rpx;flex:none;margin-top:5rpx}

/* ④ Yuni 贴纸（折叠入口） */
.stickers-card .row{font-size:27rpx}
.sticker-head{cursor:pointer}
.sticker-head-press{opacity:.7}
.sticker-count{font-family:monospace;color:#0b7a55;font-size:23rpx;font-weight:700}
.stickers-mini{display:flex;gap:14rpx;margin-top:20rpx}
.mini-sticker{width:64rpx;height:64rpx;background:#f3faf6;border-radius:50%;display:flex;align-items:center;justify-content:center;flex:none}
.mini-sticker image{width:44rpx;height:52rpx}
.mini-sticker.locked{opacity:.35;filter:grayscale(1)}
.stickers{gap:8rpx;margin:24rpx 0 15rpx}
.sticker{padding:15rpx 3rpx;min-height:145rpx;font-size:18rpx;line-height:1.3;border-radius:23rpx}
.sticker image{width:68rpx;height:80rpx;margin-bottom:6rpx}
.sticker.locked{opacity:.35;filter:grayscale(1)}
.sticker-hint{margin:0}

/* 成为跑手 */
.become-card{background:#0b7a55;color:#fff;padding:29rpx;border-radius:27rpx;margin-bottom:18rpx}
.become-label{font-size:23rpx;font-weight:750;opacity:.9}
.become-title{font-size:35rpx;line-height:1.35;font-weight:800;margin:22rpx 0}
.become-description{font-size:24rpx;line-height:1.65;color:#fff7ed}
.become-card button{margin:22rpx 0 0;border-radius:20rpx;background:white;color:#0b7a55;font-size:26rpx;font-weight:750;padding:20rpx}
.green-text{color:#0b7a55;font-weight:700}
.card-heading{font-size:23rpx;font-weight:750;letter-spacing:.5rpx;margin-bottom:25rpx}

/* 等级详情（大卡展开区内复用） */
.level-grid{display:flex;gap:8rpx}
.level-grid>view{flex:1;min-width:0}
.level-track{height:10rpx;background:#f3faf6;border-radius:10rpx;overflow:hidden;margin:4rpx 0 13rpx}
.level-track view{height:100%;background:#6fd0a8}
.level-grid .strong{font-size:25rpx}
.level-grid .hint{font-size:20rpx;line-height:1.45;margin:16rpx 0}
.level-nudge{background:#f3faf6;color:#0b7a55;border-radius:20rpx;padding:22rpx;font-size:23rpx;line-height:1.6;margin:12rpx 0 24rpx}
.mark-note{display:flex;align-items:flex-start;gap:15rpx;font-size:22rpx;line-height:1.7;color:#5e5c55}
.mark-count{background:#e7f3ed;color:#0b7a55;font-weight:800;border-radius:50%;width:42rpx;height:42rpx;line-height:42rpx;text-align:center;flex:none}
.mark-note .hint{font-size:20rpx}

/* 编辑卡内的隐私提示 */
.address-privacy{display:flex;align-items:flex-start;gap:15rpx;color:#6b6860;font-size:22rpx;line-height:1.6;margin-top:18rpx}
.address-privacy image{width:24rpx;height:27rpx;flex:none;margin-top:5rpx}

/* ⑥ 邀请同学 */
.invite-card{display:flex;align-items:center;gap:21rpx}
.invite-icon{background:#e7f3ed;width:75rpx;height:75rpx;border-radius:22rpx;display:flex;align-items:center;justify-content:center;flex:none}
.invite-icon image{width:36rpx;height:36rpx}
.invite-copy{flex:1;min-width:0}
.invite-copy .strong{font-size:27rpx}
.invite-copy .hint{font-size:22rpx;margin-bottom:0}
.invite-card .invite-button{flex:none;width:120rpx;min-width:0;height:70rpx;margin:0;padding:0;background:#0b7a55;color:white;border-radius:40rpx;font-size:24rpx;font-weight:750;line-height:70rpx}

/* 菜单组 */
.settings-icon{width:60rpx;height:60rpx;background:#f0efea;border-radius:17rpx;display:flex;align-items:center;justify-content:center;flex:none}
.settings-icon image{width:29rpx;height:29rpx}
.me-page .menu-card{padding:0;overflow:hidden}
.menu-card .menu-row{padding:20rpx 26rpx;min-height:99rpx;gap:22rpx;border-bottom:1rpx solid #f0eee8;font-size:26rpx}
.menu-card .menu-row:last-child{border-bottom:1rpx solid #f0eee8}
.menu-card>view:last-child{border-bottom:0}
.menu-copy{flex:1;min-width:0}
.menu-copy .hint{margin:6rpx 0 0;font-size:21rpx}
.setting-value{color:#6b6860;font-size:23rpx;white-space:nowrap}
.setting-chevron{color:#8a877e;font-size:34rpx;font-weight:400}
.language-picker{display:block}
.notifications-card .menu-row{padding-top:23rpx;padding-bottom:23rpx}
.notifications-card .hint{font-size:21rpx;margin-bottom:0}
.notifications-card switch{flex:none;transform:scale(.83);transform-origin:right center}
.me-page .section{font-size:25rpx;margin:34rpx 4rpx 24rpx}

/* ⑧ 页脚 */
.me-footer{text-align:center;font-size:20rpx;line-height:1.65;color:#8a877e;margin:30rpx 0 10rpx}
.floating-yuni{position:fixed;right:24rpx;bottom:calc(152rpx + env(safe-area-inset-bottom));z-index:98;background:#fff;border:1rpx solid #e2e0d9;box-shadow:0 8rpx 25rpx #0001;border-radius:60rpx;padding:6rpx 20rpx 6rpx 10rpx;display:flex;align-items:center;gap:10rpx;color:#0b7a55;font-size:23rpx;font-weight:750}
.floating-yuni image{width:57rpx;height:66rpx}

/* 深色模式 */
.me-dark{background:#1b1c1a;color:#fff7ed}
.me-dark .flow-card,.me-dark .me-stats>view,.me-dark .floating-yuni{background:#242522;border-color:#3a3b37;color:#fff7ed}
.me-dark .stats-number{color:#fff7ed}
.me-dark .settings-icon,.me-dark .sticker,.me-dark .mini-sticker{background:#a9a69c}
.me-dark .sticker.locked,.me-dark .mini-sticker.locked{opacity:.3}
.me-dark .menu-row{border-color:#3a3b37}
.me-dark .address-privacy{border-color:#3a3b37}
.me-dark .hint,.me-dark .setting-value{color:#a9a69c}
.me-dark .green-text,.me-dark .earnings-total,.me-dark .sticker-count{color:#6fd0a8}
.me-dark .me-header{background:#08523a;border:1rpx solid #0b7a55;color:#e7f3ed}
.me-dark .header-name{color:#fff7ed}
.me-dark .level-journey{background:transparent;border-color:transparent;box-shadow:none}
.me-dark .journey-level,.me-dark .journey-points,.me-dark .journey-nudge,.me-dark .hl-tiers{color:#d3eadf}
.me-dark .journey-points-number{color:#fff7ed}
.me-dark .journey-arrow{color:#b7d0bd}
.me-dark .hl-track{background:#0b7a55}
.me-dark .hl-fill{background:#e7f3ed}
.me-dark .header-badge{background:#e7f3ed;color:#08523a}
.me-dark .header-badge.verified{background:#e7f3ed;color:#08523a}
.me-dark .level-detail{border-color:#ffffff42}
.me-dark .level-detail .level-track{background:#3a3b37}


.wallet-entry{min-height:64rpx;align-items:center}.wallet-entry-value{margin-left:auto;white-space:nowrap;color:#0b7a55;font-weight:650}.page-dark .wallet-entry-value{color:#6fd0a8}


.me-dark .me-stats>view.stat-blue{background:#222f40;border-color:#425c7b}.me-dark .me-stats>view.stat-blue .stats-number{color:#a6c8f0}
.me-dark .me-stats>view.stat-green{background:#25372c;border-color:#44644f}.me-dark .me-stats>view.stat-green .stats-number{color:#9ed5ae}
.me-dark .me-stats>view.stat-orange{background:#352b23;border-color:#66503b}.me-dark .me-stats>view.stat-orange .stats-number{color:#f2b780}
.runner-tag-dot{display:inline-block;width:9rpx;height:9rpx;margin-right:7rpx;border-radius:50%;background:#08523a;vertical-align:middle;transform:translateY(-1rpx)}

/* The avatar is a transparent penguin; only the separate rank plaque has a medal. */
.me-dark .journey-heading .journey-level{color:#192d49}
.me-dark .journey-heading .journey-points,.me-dark .journey-heading .journey-points-number,.me-dark .journey-heading .journey-arrow{color:#276c50}
@media(max-width:350px){.header-avatar{width:128rpx;height:128rpx}.rank-badge{width:82rpx;height:82rpx}.journey-level{font-size:25rpx}.journey-points-number{font-size:36rpx}}


/* 2026-11-15: 按 design/me-preview 定稿的「我的」页（舞台通栏，其余卡片左右留白） */
.me-page.me-v2{padding:0 0 190rpx}
.me-v2 .muted,.me-v2 .notice-error,.me-v2>.card{margin:24rpx 32rpx}
.me-body{padding:0 32rpx}
.me-block{background:#fff;border-radius:40rpx;padding:32rpx;margin-top:28rpx}
.me-press{opacity:.92}
.me-grow{flex:1;min-width:0}
.me-h2{font-size:31rpx;font-weight:800;color:#16181c;line-height:1.3}
.me-sub{font-size:25rpx;color:#6b6860;line-height:1.4;margin-top:2rpx}
.me-chev{width:15rpx;height:15rpx;border-right:4rpx solid #b9b6ab;border-top:4rpx solid #b9b6ab;transform:rotate(45deg);flex:none;margin-left:8rpx}
.me-level-top{display:flex;align-items:center;gap:24rpx}
.me-level-badge{width:116rpx;height:116rpx;flex:none}
.me-track{position:relative;display:flex;justify-content:space-between;align-items:center;margin:36rpx 12rpx 12rpx;height:32rpx}
.me-track-line,.me-track-fill{position:absolute;left:0;top:50%;height:12rpx;margin-top:-6rpx;border-radius:12rpx}
.me-track-line{right:0;background:#e9e7e0}
.me-track-fill{background:linear-gradient(90deg,#0b7a55,#3fbf8d)}
.me-stop{position:relative;width:32rpx;height:32rpx;border-radius:50%;background:#fff;border:6rpx solid #d9d6cc;box-sizing:border-box;z-index:1}
.me-stop.done{border-color:#0b7a55;background:#0b7a55}
.me-stop.now{border-color:#f2b233;background:#fff;box-shadow:0 0 0 8rpx #f2b23340}
.me-track-names{display:flex;justify-content:space-between;font-size:22rpx;color:#6b6860;margin:0 -8rpx}
.me-track-names text{width:20%;text-align:center}
.me-track-names .on{color:#16181c;font-weight:700}
.me-gear{display:flex;align-items:center;gap:16rpx;margin-top:24rpx;padding-top:24rpx;border-top:1rpx solid #f0eee8;font-size:25rpx;color:#6b6860}
.me-gear image{width:52rpx;height:52rpx;flex:none}
.me-v2 .me-stats{display:flex;gap:0;margin:28rpx 0 0;background:#fff;border-radius:40rpx}
.me-v2 .me-stats>view{flex:1;min-width:0;text-align:center;padding:28rpx 8rpx;display:flex;flex-direction:column;gap:0;font-size:24rpx;color:#6b6860;border:0;border-radius:0;background:none}
.me-v2 .me-stats>view+view{border-left:1rpx solid #e2e0d9}
.me-stat-num{font-size:44rpx;font-weight:800;color:#1c2a54;font-variant-numeric:tabular-nums;line-height:1.25}
/* 「开始赚钱」：一张图标 + 一句话的入口卡 */
.me-v2 .me-become{position:relative;display:flex;align-items:center;gap:24rpx;margin-top:28rpx;padding:22rpx 26rpx 22rpx 22rpx;border-radius:40rpx;background:linear-gradient(110deg,#e3f5ec 0%,#f3faf5 55%,#fff6dc 100%);box-shadow:inset 0 0 0 2rpx #cfe9dc;overflow:hidden}
.me-v2 .me-become::after{content:"";position:absolute;right:-40rpx;top:-60rpx;width:220rpx;height:220rpx;border-radius:50%;background:radial-gradient(circle,#ffe7a3 0%,rgba(255,231,163,0) 70%);pointer-events:none}
.me-become-press{transform:scale(.985);opacity:.95}
.me-become-icon{width:104rpx;height:104rpx;flex:none}
.me-become-copy{flex:1;min-width:0;display:flex;flex-direction:column;gap:4rpx;position:relative;z-index:1}
.me-become-text{font-size:34rpx;font-weight:800;color:#08523a;letter-spacing:-.3rpx}
.me-become-sub{font-size:24rpx;line-height:1.4;color:#4c6b5c}
.me-become-go{position:relative;z-index:1;flex:none;width:76rpx;height:76rpx;border-radius:50%;background:#0b7a55;box-shadow:0 8rpx 0 #085c41;display:flex;align-items:center;justify-content:center}
.me-become-arrow{width:18rpx;height:18rpx;border-right:5rpx solid #fff;border-top:5rpx solid #fff;transform:translateX(-3rpx) rotate(45deg)}
.me-group{margin:44rpx 0 16rpx;font-size:26rpx;font-weight:700;color:#6b6860}
.me-list{background:#fff;border-radius:40rpx;overflow:hidden}
.me-row{display:flex;align-items:center;gap:24rpx;padding:22rpx 28rpx;min-height:100rpx;box-sizing:border-box}
.me-list>.me-row+.me-row,.me-list>.me-row+picker .me-row,.me-list>picker+.me-row{border-top:1rpx solid #f0eee8}
.me-row-press{background:#f7f6f2}
.me-ico{width:76rpx;height:76rpx;flex:none}
.me-row-title{font-size:29rpx;font-weight:650;color:#16181c}
.me-val{font-size:25rpx;color:#6b6860;line-height:1.4}
.me-money{font-weight:800;color:#0b7a55;font-size:29rpx;font-variant-numeric:tabular-nums}
.me-link{color:#0b7a55;font-weight:600}
.me-row switch{transform:scale(.85);flex:none}
.me-version{text-align:center;color:#9a978d;font-size:23rpx;margin:44rpx 0 16rpx}

/* 2026-11-16: Yuni guide (same spotlight look as the Jobs page app guide) */
.yg-shade{z-index:100}
.yg-focus{z-index:100;transition:top .42s cubic-bezier(.3,.9,.25,1),left .42s cubic-bezier(.3,.9,.25,1),width .42s cubic-bezier(.3,.9,.25,1),height .42s cubic-bezier(.3,.9,.25,1),border-radius .42s cubic-bezier(.3,.9,.25,1);animation:yg-spot-in .45s cubic-bezier(.3,.9,.25,1) backwards}
.yg-ring{position:absolute;left:-4rpx;top:-4rpx;right:-4rpx;bottom:-4rpx;border:4rpx solid #fff;border-radius:inherit;animation:yg-ring 1.8s ease-out .45s infinite}
.yg-blocker{position:fixed;left:0;top:0;right:0;bottom:0;z-index:101}
.yg-modal{z-index:102;top:auto;bottom:calc(150rpx + env(safe-area-inset-bottom));max-height:calc(100vh - 240rpx);overflow-y:auto;box-sizing:border-box;box-shadow:0 20rpx 50rpx rgba(22,24,28,.18);animation:yg-modal-in .46s cubic-bezier(.22,.9,.3,1) backwards}
.yg-modal.yg-bottom{top:calc(24rpx + env(safe-area-inset-top));bottom:auto}
.yg-top{display:flex;align-items:center;justify-content:space-between}
.yg-dots{display:flex;align-items:center;gap:8rpx}
.yg-dot{width:12rpx;height:12rpx;border-radius:12rpx;background:#e2e0d9;transition:width .32s cubic-bezier(.3,.9,.25,1),background-color .32s ease}
.yg-dot.past{background:#0b7a55;opacity:.4}
.yg-dot.on{width:36rpx;background:#0b7a55}
.yg-skip{font-size:24rpx;font-weight:700;color:#6b6860;padding:6rpx 4rpx}
.yg-step{animation:yg-from-right .34s cubic-bezier(.22,.8,.3,1) backwards}
.yg-step.from-left{animation-name:yg-from-left}
.yg-yuni{flex:none;width:120rpx;height:120rpx;animation:yg-yuni-in .6s cubic-bezier(.3,1.3,.5,1) .06s backwards,yg-float 3.2s ease-in-out .7s infinite}
.yg-name{font-size:24rpx;font-weight:800;color:#0b7a55}
.yg-modal .guide-text{font-size:25rpx;line-height:1.6}
.yg-actions{display:flex;gap:16rpx}
.yg-btn{flex:1;height:88rpx;line-height:88rpx;margin:0!important;padding:0;border-radius:26rpx;font-size:28rpx;font-weight:800}
.yg-btn::after{border:0}
.yg-next{background:#0b7a55;color:#fff;box-shadow:0 6rpx 0 #08603f}
.yg-back{background:#e3f3ea;color:#0b7a55}
.yg-modal.yg-dark{background:#242522;color:#edebe4;border:1rpx solid #3a3b37}
.yg-modal.yg-dark .guide-title,.yg-modal.yg-dark .guide-text{color:#edebe4}
@keyframes yg-spot-in{from{transform:scale(1.35)}to{transform:scale(1)}}
@keyframes yg-ring{0%{opacity:.85;transform:scale(1)}80%,100%{opacity:0;transform:scale(1.22)}}
@keyframes yg-modal-in{0%{opacity:0;transform:translate3d(0,40rpx,0) scale(.96)}70%{opacity:1;transform:translate3d(0,-4rpx,0) scale(1.005)}100%{opacity:1;transform:none}}
@keyframes yg-from-right{from{opacity:0;transform:translate3d(40rpx,0,0)}to{opacity:1;transform:none}}
@keyframes yg-from-left{from{opacity:0;transform:translate3d(-40rpx,0,0)}to{opacity:1;transform:none}}
@keyframes yg-yuni-in{0%{opacity:0;transform:translate3d(0,24rpx,0) scale(.7) rotate(-8deg)}60%{opacity:1;transform:translate3d(0,-6rpx,0) scale(1.08) rotate(3deg)}100%{opacity:1;transform:none}}
@keyframes yg-float{0%,100%{transform:translate3d(0,0,0)}50%{transform:translate3d(0,-8rpx,0)}}

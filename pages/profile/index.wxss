/* Uniearn「我的」页面 — 按 design/profile_final_long.png 定稿重构 */
.me-page{background:#eeede8;padding:38rpx 38rpx 190rpx;min-height:100vh;color:#345c55}
.me-page .title{display:none}
.me-page .flow-card{padding:27rpx;border:1rpx solid #deded7;border-radius:27rpx;margin-bottom:20rpx}

/* ① 顶部大卡：资料 + 双徽章 + 等级进度 */
.me-header{background:#4b8263;color:#fff;border-radius:27rpx;padding:30rpx 27rpx 26rpx;margin-bottom:20rpx}
.me-header-top{display:flex;align-items:center;gap:18rpx}
.avatar{width:108rpx;height:108rpx;line-height:108rpx;font-size:43rpx}
.header-avatar{width:96rpx;height:96rpx;line-height:96rpx;font-size:38rpx;background:#4e8a68;color:#fff;border-radius:50%;text-align:center;flex:none}
.customer-avatar{background:#41775b}
.runner-avatar{background:#41775b}
.header-main{flex:none;max-width:330rpx}
.header-name{font-size:37rpx;font-weight:800;line-height:96rpx;white-space:nowrap;overflow:visible}
.header-badge-row{margin:14rpx 0 0 116rpx}
.header-badge{font-size:21rpx;line-height:1.6;padding:6rpx 15rpx;background:#f0efeb;border-radius:26rpx;font-weight:650;color:#63665d;display:inline-block;white-space:nowrap}
.header-badge.verified{background:#e7f1eb;color:#3f7a52}
.edit-button{margin:0;padding:0;min-width:84rpx;max-width:84rpx;flex:0 0 84rpx;width:84rpx;height:44rpx;line-height:42rpx;display:flex;align-items:center;justify-content:center;gap:5rpx;border:1rpx solid #7bb08f;border-radius:999rpx;background:transparent;color:#ecf5f0;font-size:19rpx;font-weight:650;box-sizing:border-box}
.edit-button::after{border:0}
.edit-button image{width:15rpx;height:15rpx}
.runner-tag{flex:none;font-size:20rpx;font-weight:700;color:#41775b;background:#ecf5f0;border-radius:26rpx;padding:8rpx 14rpx;line-height:1.4}
.badge-row{display:flex;gap:16rpx;margin:24rpx 0 22rpx}
.tier-badge{font-size:23rpx;font-weight:650;color:#ecf5f0;border:1rpx solid #7bb08f;border-radius:26rpx;padding:10rpx 22rpx}
.header-level{display:flex;align-items:center;gap:14rpx}
.hl-label{font-size:22rpx;color:#ecf5f0;font-weight:700;flex:none}
.hl-next{flex:1;min-width:0;font-size:22rpx;color:#ecf5f0;text-align:right}
.hl-caret{flex:none;color:#ecf5f0;font-size:28rpx}
.hl-track{height:10rpx;background:#f4f7f4;border-radius:10rpx;overflow:hidden;margin:16rpx 0 8rpx}
.hl-fill{height:100%;background:#2f6b49;border-radius:10rpx}
.hl-tiers{display:flex;justify-content:space-between;font-size:18rpx;color:#7bb08f}
.hl-tiers text{flex:1;text-align:left}.hl-tiers .hl-end{text-align:right}
.hl-tiers .cur{color:#ecf5f0;font-weight:750}
.level-detail{margin-top:18rpx;border-top:1rpx solid #ffffff42;padding-top:20rpx}
.level-detail .level-grid .hint{color:#c9b3a2}
.level-detail .level-nudge{background:#3a6a50;color:#ecf5f0}
.level-detail .mark-note{color:#c9b3a2}
.level-detail .mark-note .hint{color:#a08a7a}

/* ② 数据卡 */
.me-stats{display:flex;gap:15rpx;margin-bottom:20rpx}
.me-stats>view{flex:1;min-width:0;border:1rpx solid #deded7;border-radius:23rpx;background:#fff;padding:19rpx 21rpx;display:flex;flex-direction:column;gap:8rpx;color:#75766d;font-size:23rpx}
.me-stats .stats-number{font-size:37rpx;line-height:1.3;color:#345c55;font-weight:800}

/* ③ 收益卡 */
.earnings-summary{border:2rpx solid #41775b!important}
.earnings-total{font-family:monospace;font-size:57rpx;line-height:1.1;color:#41775b;font-weight:800}
.earnings-body{align-items:flex-end;margin-bottom:24rpx}
.earnings-body .hint{font-size:21rpx}
.mini-bars{display:flex;gap:7rpx;align-items:flex-end;height:85rpx;flex:none}
.mini-bars view{width:12rpx;background:#41775b;border-radius:3rpx}
.mini-bars view:last-child{background:#e8f2ec}
.earnings-note{display:flex;gap:15rpx;align-items:flex-start;border-top:1rpx solid #eeede6;padding-top:21rpx;font-size:23rpx;color:#77796f;line-height:1.6}
.earnings-note image{width:24rpx;height:27rpx;flex:none;margin-top:5rpx}

/* ④ Yuni 贴纸（折叠入口） */
.stickers-card .row{font-size:27rpx}
.sticker-head{cursor:pointer}
.sticker-head-press{opacity:.7}
.sticker-count{font-family:monospace;color:#41775b;font-size:23rpx;font-weight:700}
.stickers-mini{display:flex;gap:14rpx;margin-top:20rpx}
.mini-sticker{width:64rpx;height:64rpx;background:#f4faf6;border-radius:50%;display:flex;align-items:center;justify-content:center;flex:none}
.mini-sticker image{width:44rpx;height:52rpx}
.mini-sticker.locked{opacity:.35;filter:grayscale(1)}
.stickers{gap:8rpx;margin:24rpx 0 15rpx}
.sticker{padding:15rpx 3rpx;min-height:145rpx;font-size:18rpx;line-height:1.3;border-radius:23rpx}
.sticker image{width:68rpx;height:80rpx;margin-bottom:6rpx}
.sticker.locked{opacity:.35;filter:grayscale(1)}
.sticker-hint{margin:0}

/* 成为跑手 */
.become-card{background:#41775b;color:#fff;padding:29rpx;border-radius:27rpx;margin-bottom:18rpx}
.become-label{font-size:23rpx;font-weight:750;opacity:.9}
.become-title{font-size:35rpx;line-height:1.35;font-weight:800;margin:22rpx 0}
.become-description{font-size:24rpx;line-height:1.65;color:#f4faf6}
.become-card button{margin:22rpx 0 0;border-radius:20rpx;background:white;color:#41775b;font-size:26rpx;font-weight:750;padding:20rpx}
.green-text{color:#41775b;font-weight:700}
.card-heading{font-size:23rpx;font-weight:750;letter-spacing:.5rpx;margin-bottom:25rpx}

/* 等级详情（大卡展开区内复用） */
.level-grid{display:flex;gap:8rpx}
.level-grid>view{flex:1;min-width:0}
.level-track{height:10rpx;background:#f4f7f4;border-radius:10rpx;overflow:hidden;margin:4rpx 0 13rpx}
.level-track view{height:100%;background:#69d39a}
.level-grid .strong{font-size:25rpx}
.level-grid .hint{font-size:20rpx;line-height:1.45;margin:16rpx 0}
.level-nudge{background:#f4faf6;color:#41775b;border-radius:20rpx;padding:22rpx;font-size:23rpx;line-height:1.6;margin:12rpx 0 24rpx}
.mark-note{display:flex;align-items:flex-start;gap:15rpx;font-size:22rpx;line-height:1.7;color:#66675e}
.mark-count{background:#e8f3ed;color:#41775b;font-weight:800;border-radius:50%;width:42rpx;height:42rpx;line-height:42rpx;text-align:center;flex:none}
.mark-note .hint{font-size:20rpx}

/* 编辑卡内的隐私提示 */
.address-privacy{display:flex;align-items:flex-start;gap:15rpx;color:#77796f;font-size:22rpx;line-height:1.6;margin-top:18rpx}
.address-privacy image{width:24rpx;height:27rpx;flex:none;margin-top:5rpx}

/* ⑥ 邀请同学 */
.invite-card{display:flex;align-items:center;gap:21rpx}
.invite-icon{background:#e8f3ed;width:75rpx;height:75rpx;border-radius:22rpx;display:flex;align-items:center;justify-content:center;flex:none}
.invite-icon image{width:36rpx;height:36rpx}
.invite-copy{flex:1;min-width:0}
.invite-copy .strong{font-size:27rpx}
.invite-copy .hint{font-size:22rpx;margin-bottom:0}
.invite-card .invite-button{flex:none;width:120rpx;min-width:0;height:70rpx;margin:0;padding:0;background:#41775b;color:white;border-radius:40rpx;font-size:24rpx;font-weight:750;line-height:70rpx}

/* 菜单组 */
.settings-icon{width:60rpx;height:60rpx;background:#f0efeb;border-radius:17rpx;display:flex;align-items:center;justify-content:center;flex:none}
.settings-icon image{width:29rpx;height:29rpx}
.me-page .menu-card{padding:0;overflow:hidden}
.menu-card .menu-row{padding:20rpx 26rpx;min-height:99rpx;gap:22rpx;border-bottom:1rpx solid #eeede6;font-size:26rpx}
.menu-card .menu-row:last-child{border-bottom:1rpx solid #eeede6}
.menu-card>view:last-child{border-bottom:0}
.menu-copy{flex:1;min-width:0}
.menu-copy .hint{margin:6rpx 0 0;font-size:21rpx}
.setting-value{color:#77796f;font-size:23rpx;white-space:nowrap}
.setting-chevron{color:#8b8c82;font-size:34rpx;font-weight:400}
.language-picker,.appearance-picker{display:block}
.notifications-card .menu-row{padding-top:23rpx;padding-bottom:23rpx}
.notifications-card .hint{font-size:21rpx;margin-bottom:0}
.notifications-card switch{flex:none;transform:scale(.83);transform-origin:right center}
.me-page .section{font-size:25rpx;margin:34rpx 4rpx 24rpx}

/* ⑧ 页脚 */
.me-footer{text-align:center;font-size:20rpx;line-height:1.65;color:#939187;margin:30rpx 0 10rpx}
.floating-yuni{position:fixed;right:24rpx;bottom:calc(152rpx + env(safe-area-inset-bottom));z-index:98;background:#fff;border:1rpx solid #deded7;box-shadow:0 8rpx 25rpx #0001;border-radius:60rpx;padding:6rpx 20rpx 6rpx 10rpx;display:flex;align-items:center;gap:10rpx;color:#41775b;font-size:23rpx;font-weight:750}
.floating-yuni image{width:57rpx;height:66rpx}

/* 深色模式 */
.me-dark{background:#202522;color:#f4faf6}
.me-dark .flow-card,.me-dark .me-stats>view,.me-dark .edit-button,.me-dark .floating-yuni{background:#2c332f;border-color:#465149;color:#f4faf6}
.me-dark .stats-number{color:#f4faf6}
.me-dark .settings-icon,.me-dark .sticker,.me-dark .mini-sticker{background:#bdc4bb}
.me-dark .sticker.locked,.me-dark .mini-sticker.locked{opacity:.3}
.me-dark .menu-row{border-color:#465149}
.me-dark .address-privacy{border-color:#465149}
.me-dark .hint,.me-dark .setting-value{color:#bfc6bd}
.me-dark .green-text,.me-dark .earnings-total,.me-dark .sticker-count{color:#7bb08f}
.me-dark .me-header{background:#40121b}
.me-dark .header-badge{background:#bdc4bb}
.me-dark .header-badge.verified{background:#e7f1eb;color:#3f7a52}
.me-dark .level-detail{border-color:#ffffff42}
.me-dark .level-detail .level-track{background:#465149}

.profile-editor{display:flex;flex-direction:column;gap:20rpx}.edit-hero{position:relative;display:flex;align-items:center;gap:21rpx;padding:28rpx 74rpx 28rpx 26rpx;border-radius:28rpx;background:linear-gradient(135deg,#6f1d2c,#8c2739);color:#fff;box-shadow:0 12rpx 28rpx #40121b24}.edit-avatar{width:82rpx;height:82rpx;line-height:82rpx;border-radius:50%;text-align:center;font-size:34rpx;font-weight:800;color:#fff;flex:none;border:3rpx solid #ffffff66}.edit-heading{flex:1;min-width:0}.edit-title{font-size:34rpx;line-height:1.3;font-weight:800}.edit-subtitle{font-size:22rpx;line-height:1.55;color:#fff1f3;margin-top:7rpx}.edit-close{position:absolute;right:18rpx;top:18rpx;width:50rpx;min-width:50rpx;height:50rpx;min-height:50rpx;line-height:47rpx;margin:0;padding:0;border-radius:50%;background:#ffffff1f;color:#fff;font-size:35rpx;font-weight:400}.edit-section{background:#fff;border:1rpx solid #deded7;border-radius:27rpx;padding:27rpx}.edit-section-title{font-size:25rpx;font-weight:800;margin:0 0 18rpx;color:#30342f}.edit-field+.edit-field{margin-top:18rpx}.edit-section .field-label{font-size:22rpx;line-height:1.4;margin:0 0 9rpx;color:#61655f}.edit-section .field{width:100%;height:82rpx;min-height:82rpx;margin:0;padding:0 21rpx;border-radius:18rpx;background:#f8f8f5;border-color:#dfdfd8;font-size:27rpx}.edit-grid{display:flex;align-items:flex-start;gap:16rpx}.edit-grid .edit-field{flex:1;min-width:0;margin:0}.edit-grid .room-field{flex:0 0 190rpx}.edit-privacy{display:flex;align-items:flex-start;gap:12rpx;margin-top:20rpx;padding-top:19rpx;border-top:1rpx solid #ecece6;color:#77796f;font-size:21rpx;line-height:1.55}.edit-privacy image{width:23rpx;height:25rpx;flex:none;margin-top:3rpx}.edit-actions{display:flex;align-items:center;gap:14rpx}.edit-actions button{margin:0;height:84rpx;min-height:84rpx;line-height:84rpx;border-radius:42rpx;font-size:26rpx}.edit-save{flex:1}.edit-cancel{flex:0 0 180rpx;width:180rpx;min-width:180rpx;padding:0;background:#fff;color:#555b56;border:1rpx solid #d8d9d2;font-weight:700}.me-dark .edit-section,.me-dark .edit-cancel{background:#2c332f;border-color:#465149;color:#edf1ed}.me-dark .edit-section-title{color:#edf1ed}.me-dark .edit-section .field-label,.me-dark .edit-privacy{color:#bfc6bd}.me-dark .edit-section .field{background:#222925;border-color:#465149;color:#edf1ed}.me-dark .edit-privacy{border-color:#465149}

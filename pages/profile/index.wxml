<view style="{{motionStyle}}">
<lang-switch></lang-switch>
<view class="page navpage me-page">
<view wx:if="{{loading}}" class="muted">{{language==='zh'?'正在加载账户…':'Loading your account…'}}</view><view wx:if="{{error}}" class="notice-error">{{error}}</view>
 <view wx:if="{{profile.loggedOut || !profile.onboarded}}" class="card">
  <view class="route">{{language==='zh'?'欢迎来到 UniEarn':'Welcome to UniEarn'}}</view>
  <view class="muted">{{language==='zh'?'你已退出登录。登录后可查看订单和已保存的账户信息。':'You are logged out. Sign in to see your orders and saved account.'}}</view>
  <button class="btn" bindtap="login" disabled="{{loading || loggingOut}}">{{language==='zh'?'登录':'Sign in'}}</button>
 </view>
<block wx:else>
<!-- ① 个人资料与等级成长 -->
<view class="me-header">
 <view class="me-header-top">
  <view class="avatar header-avatar"><image class="rank-avatar" src="{{tierAvatar}}" mode="aspectFit" aria-label="{{tierName}}"/></view>
  <view class="header-main">
   <view class="header-name" bindtap="editUsername" role="button" aria-label="{{language==='zh'?'修改用户名':'Edit username'}}">{{profile.displayName||profile.name||ui.account}}<text class="header-edit-mark">✎</text></view>
   <view class="header-badge-row"><view class="header-badge {{isRunner?'verified':''}}" bindtap="profileEntry">{{isRunner?'✓ '+ui.verified+(verifiedDate?' '+verifiedDate:''):ui.check}}</view></view>
  </view>
  <view wx:if="{{isRunner}}" class="header-actions">
   <view wx:if="{{isRunner}}" class="runner-tag"><text class="runner-tag-dot"></text>{{ui.runnerTag}}</view>
  </view>
 </view>
 <view class="level-journey" bindtap="levels" hover-class="level-journey-press">
 <view class="journey-heading">
  <view class="journey-rank"><image class="rank-badge" src="/assets/profile-ranks/badge-{{tierLevel}}.png" mode="aspectFit" aria-label="{{tierName}}"/><view class="journey-rank-copy"><view class="journey-level">{{tierName}}</view><view class="journey-rank-number">LEVEL {{tierLevel}}</view></view></view>
  <view class="journey-points"><text class="journey-points-number">{{points||0}}</text><text>{{language==='zh'?'积分':'pts'}}</text><text class="journey-arrow">›</text></view>
 </view>
 <view class="journey-nudge">{{nextJobsText}}</view>
 <view class="hl-track"><view class="hl-fill" style="{{'width: '+progress+'%;'}}"></view></view>
 <view class="hl-tiers"><text wx:if="{{levelStartName}}">{{levelStartName}}</text><text wx:if="{{levelEndName}}" class="hl-end">{{levelEndName}}</text></view>
</view>
</view>
<!-- ② 数据卡 -->
<view class="me-stats"><view class="stat-blue" bindtap="firstStat"><text class="stats-number">{{isRunner?profile.jobsDone||0:postedCount}}</text><text>{{isRunner?ui.jobsRun:ui.orders}}</text></view><view class="stat-green" bindtap="past"><text class="stats-number">{{isRunner?postedCount:deliveredCount}}</text><text>{{isRunner?(language==='en'?'Published orders':'已发布订单'):ui.delivered}}</text></view><view class="stat-orange" bindtap="coupons"><text class="stats-number">{{couponCount}}</text><text>{{ui.coupons}}</text></view></view>
<!-- ③ 收益卡（跑手） -->
<block wx:if="{{isRunner}}"><view class="flow-card earnings-summary" bindtap="wallet"><view class="row card-heading"><text>{{language==='en'?'My wallet':'我的钱包'}}</text><text class="green-text" catchtap="earnings">{{ui.earnings}} ›</text></view><view class="row earnings-body"><view><view class="earnings-total">¥{{earnTotal}}</view><view class="hint"><text class="strong">¥{{earnWaiting}}</text> {{ui.waiting}}</view></view><view class="mini-bars"><view wx:for="{{earnBars}}" wx:key="index" style="height:{{item}}rpx"/></view></view><view class="earnings-note wallet-entry" catchtap="wallet"><image src="/assets/balance-outline.svg"/><text>{{language==='en'?'My wallet · test balance':'我的钱包 · 测试余额'}}</text><text class="wallet-entry-value">¥{{walletBalance}} ›</text></view></view></block>
<!-- 非跑手：成为跑手 -->
<block wx:if="{{!isRunner}}"><view class="become-card"><view class="become-label">{{ui.become}}</view><view class="become-title">{{ui.earnTitle}}</view><view class="become-description">{{ui.earnHelp}}</view><button bindtap="studentCheck">{{ui.start}}</button></view></block>
<!-- ⑦ 通知与提醒（已删除考试模式） -->
<view class="section">{{ui.notifyGroup}}</view>
<view class="flow-card menu-card notifications-card">
 <view class="menu-row"><view><view class="strong">{{ui.updates}}</view><view class="hint">{{ui.updatesHelp}}</view><text class="link" catchtap="notifyGuide">{{ui.notifyGuide}} ›</text></view><switch color="#0b7a55" checked="{{preferences.orderUpdates!==false}}" data-key="orderUpdates" bindchange="preference"/></view>
</view>
<!-- ⑧ 账户 -->
<view class="section">{{ui.accountGroup}}</view>
<view class="flow-card menu-card">
 <view class="menu-row" bindtap="campus"><view class="settings-icon"><image src="/assets/university-outline.svg"/></view><view class="menu-copy">{{ui.campusSetting}}</view><text class="setting-value">{{profile.campusId==='sip'?'XJTLU · SIP':ui.campus}}</text><text class="setting-chevron">›</text></view>
 <picker mode="selector" class="language-picker" range="{{languageOptions}}" value="{{languageIndex}}" bindchange="changeLanguage"><view class="menu-row"><view class="settings-icon"><image src="/assets/language-outline.svg"/></view><view class="menu-copy">{{ui.language}}</view><text class="setting-value">{{language==='zh'?'中文':'English'}}</text><text class="setting-chevron">⌄</text></view></picker>
 <view class="menu-row" bindtap="info" data-topic="rules"><view class="settings-icon"><image src="/assets/rules-outline.svg"/></view><view class="menu-copy">{{ui.rules}}<view class="hint">{{profile.runnerRulesAccepted?ui.agreed:ui.readRules}}</view></view><text class="setting-chevron">›</text></view>
 <view class="menu-row" bindtap="info" data-topic="privacy"><view class="settings-icon"><image src="/assets/lock-outline.svg"/></view><view class="menu-copy">{{ui.privacy}}</view><text class="setting-chevron">›</text></view>
 <view class="menu-row" bindtap="info" data-topic="support"><view class="settings-icon"><image src="/assets/support-outline.svg"/></view><view class="menu-copy">{{ui.helpCenter}}<view class="hint">{{ui.helpCenterSub}}</view></view><text class="setting-chevron">›</text></view>
</view>
<view class="me-footer">{{ui.footer}}<view>Uniearn v{{version}}</view></view>
</block></view><app-nav active="profile"></app-nav>
<view wx:if="{{nameEditorOpen}}" class="username-mask" catchtap="closeNameEditor" catchtouchmove="noop"><view class="username-editor" catchtap="noop"><view class="username-title">{{language==='zh'?'修改用户名':'Edit username'}}</view><view class="username-hint">{{language==='zh'?'设置你在 Me 页面显示的名字。':'Choose the name shown on your Me page.'}}</view><input class="username-input" value="{{nameDraft}}" bindinput="nameInput" maxlength="60" focus="{{nameEditorOpen}}" disabled="{{savingName}}" placeholder="{{language==='zh'?'输入用户名':'Enter username'}}" confirm-type="done" bindconfirm="saveUsername"/><view wx:if="{{nameError}}" class="username-error">{{nameError}}</view><view class="username-actions"><button class="username-cancel" bindtap="closeNameEditor" disabled="{{savingName}}">{{language==='zh'?'取消':'Cancel'}}</button><button class="username-save" bindtap="saveUsername" loading="{{savingName}}" disabled="{{savingName||!nameDraft}}">{{language==='zh'?'保存':'Save'}}</button></view></view></view>
<yuni-assistant id="me-yuni" topic="me" language="{{language}}"></yuni-assistant>

</view>

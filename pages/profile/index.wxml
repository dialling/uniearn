<view style="{{motionStyle}}">
<lang-switch id="me-lang"></lang-switch>
<view class="page navpage me-page me-v2">
<view wx:if="{{loading}}" class="muted">{{language==='zh'?'正在加载账户…':'Loading your account…'}}</view><view wx:if="{{error}}" class="notice-error">{{error}}</view>
 <view wx:if="{{profile.loggedOut || !profile.onboarded}}" class="card">
  <view class="route">{{language==='zh'?'欢迎来到 Uniearn':'Welcome to Uniearn'}}</view>
  <view class="muted">{{language==='zh'?'你已退出登录。登录后可查看订单和已保存的账户信息。':'You are logged out. Sign in to see your orders and saved account.'}}</view>
  <button class="btn" bindtap="login" disabled="{{loading || loggingOut}}">{{language==='zh'?'登录':'Sign in'}}</button>
 </view>
<block wx:else>
<!-- 2026-11-15: 按 design/me-preview 定稿：Yuni 舞台在最上方（名字与积分在场景里），下面是等级、数据、钱包与设置 -->
<yuni-stage id="yuni-stage" name="{{profile.displayName||profile.name||ui.account}}" badge="{{badgeText}}" verified="{{isRunner}}" points="{{availablePoints||points||0}}" bind:editname="editUsername" bind:badge="profileEntry" bind:points="levels" bind:changed="yuniChanged"></yuni-stage>
<view class="me-body">
 <!-- 等级 -->
 <view class="me-block me-level" bindtap="levels" hover-class="me-press">
  <view class="me-level-top"><image class="me-level-badge" src="/assets/profile-ranks/badge-{{tierLevel}}.png" mode="aspectFit" aria-label="{{tierName}}"/><view class="me-grow"><view class="me-h2">{{levelTitle}}</view><view class="me-sub">{{levelSub}}</view></view><view class="me-chev"/></view>
  <view class="me-track"><view class="me-track-line"/><view class="me-track-fill" style="width:{{trackFill}}%"/><view wx:for="{{levelStops}}" wx:key="n" class="me-stop {{item.state}}"/></view>
  <view class="me-track-names"><text wx:for="{{levelStops}}" wx:key="n" class="{{item.state==='now'?'on':''}}">{{item.name}}</text></view>
  <view wx:if="{{gearText}}" class="me-gear"><image src="/assets/yuni-play/spin.svg" mode="aspectFit"/><text>{{gearText}}</text></view>
 </view>
 <!-- 数据 -->
 <!-- 2026-11-16: stats row removed; completed orders and trips are in My orders, coupons in My coupons. -->
 <!-- 非跑手：成为跑手 -->
 <view wx:if="{{!isRunner}}" class="me-become" hover-class="me-become-press" role="button" bindtap="studentCheck" aria-label="{{ui.start}}"><image class="me-become-icon" src="/assets/yuni-play/i-earn.svg" mode="aspectFit"/><view class="me-become-copy"><text class="me-become-text">{{ui.start}}</text><text class="me-become-sub">{{language==='en'?'Help other students and earn money with every order.':'帮同学完成订单，每一单都有收入'}}</text></view><view class="me-become-go"><view class="me-become-arrow"/></view></view>
 <!-- 钱包与优惠 -->
 <view class="me-group">{{language==='en'?'Wallet & rewards':'钱包与优惠'}}</view>
 <view class="me-list">
  <view wx:if="{{isRunner}}" class="me-row" hover-class="me-row-press" bindtap="wallet"><image class="me-ico" src="/assets/yuni-play/i-wallet.svg" mode="aspectFit"/><view class="me-grow"><view class="me-row-title">{{language==='en'?'My wallet':'我的钱包'}}</view><view class="me-val"><block wx:if="{{earnWaitingNum>0}}">¥{{earnWaiting}} {{ui.waiting}}</block><block wx:else>{{language==='en'?'Tap to open':'点击查看'}}</block></view></view><text class="me-money">¥{{walletBalance}}</text><view class="me-chev"/></view>
  <view class="me-row" hover-class="me-row-press" bindtap="coupons"><image class="me-ico" src="/assets/yuni-play/shop.svg" mode="aspectFit"/><view class="me-grow"><view class="me-row-title">{{ui.myCoupons}}</view><view class="me-val">{{couponCount}} {{ui.ready}}</view></view><view class="me-chev"/></view>
  <view class="me-row" hover-class="me-row-press" bindtap="inviteFriends"><image class="me-ico" src="/assets/yuni-play/i-invite.svg" mode="aspectFit"/><view class="me-grow"><view class="me-row-title">{{ui.inviteTitle}}</view><view class="me-val">{{language==='en'?'Get a 50% off coupon':'得五折优惠券'}}</view></view><view class="me-chev"/></view>
 </view>
 <!-- 设置 -->
 <view class="me-group">{{language==='en'?'Settings':'设置'}}</view>
 <view class="me-list">
  <view class="me-row"><image class="me-ico" src="/assets/yuni-play/i-bell.svg" mode="aspectFit"/><view class="me-grow"><view class="me-row-title">{{ui.updates}}</view><view class="me-val">{{ui.updatesHelp}} <text class="me-link" catchtap="notifyGuide">{{ui.notifyGuide}} ›</text></view></view><switch color="#0b7a55" checked="{{preferences.orderUpdates!==false}}" data-key="orderUpdates" bindchange="preference"/></view>
  <view class="me-row" hover-class="me-row-press" bindtap="yuni"><image class="me-ico" src="/assets/yuni-play/i-yuni.svg" mode="aspectFit"/><view class="me-grow"><view class="me-row-title">Yuni</view><view class="me-val">{{language==='en'?'Sounds, tips, app guide and how to play':'音效、提示、新手引导和玩法'}}</view></view><view class="me-chev"/></view>
  <view class="me-row" hover-class="me-row-press" bindtap="campus"><image class="me-ico" src="/assets/yuni-play/i-campus.svg" mode="aspectFit"/><view class="me-grow"><view class="me-row-title">{{ui.campusSetting}}</view></view><text class="me-val">{{profile.universityId==='ruc'?(language==='en'?'RUC · Suzhou':'人大苏州 · 苏州校区'):profile.universityId==='suda'?(language==='en'?'Soochow · Gusu':'苏州大学 · 姑苏'):profile.campusId==='sip'?'XJTLU · SIP':ui.campus}}</text><view class="me-chev"/></view>
  <picker mode="selector" range="{{languageOptions}}" value="{{languageIndex}}" bindchange="changeLanguage"><view class="me-row" hover-class="me-row-press"><image class="me-ico" src="/assets/yuni-play/i-globe.svg" mode="aspectFit"/><view class="me-grow"><view class="me-row-title">{{ui.language}}</view></view><text class="me-val">{{language==='zh'?'中文':'English'}}</text><view class="me-chev"/></view></picker>
  <view class="me-row" hover-class="me-row-press" bindtap="info" data-topic="rules"><image class="me-ico" src="/assets/yuni-play/book.svg" mode="aspectFit"/><view class="me-grow"><view class="me-row-title">{{ui.rules}}</view><view class="me-val">{{profile.runnerRulesAccepted?ui.agreed:ui.readRules}}</view></view><view class="me-chev"/></view>
  <view class="me-row" hover-class="me-row-press" bindtap="info" data-topic="privacy"><image class="me-ico" src="/assets/yuni-play/i-shield.svg" mode="aspectFit"/><view class="me-grow"><view class="me-row-title">{{ui.privacy}}</view></view><view class="me-chev"/></view>
  <view class="me-row" hover-class="me-row-press" bindtap="info" data-topic="support"><image class="me-ico" src="/assets/yuni-play/i-help.svg" mode="aspectFit"/><view class="me-grow"><view class="me-row-title">{{ui.helpCenter}}</view><view class="me-val">{{ui.helpCenterSub}}</view></view><view class="me-chev"/></view>
   <view class="me-row" hover-class="me-row-press" bindtap="admin"><image class="me-ico" src="/assets/icons3d/person.svg" mode="aspectFit"/><view class="me-grow"><view class="me-row-title">{{language==='en'?'Admin console':'管理员登录'}}</view></view><view class="me-chev"/></view>
   <view wx:if="{{!profile.loggedOut}}" class="me-row" hover-class="me-row-press" bindtap="logout"><image class="me-ico" src="/assets/icons3d/offline.svg" mode="aspectFit"/><view class="me-grow"><view class="me-row-title">{{language==='en'?'Log out':'退出登录'}}</view></view><view class="me-chev"/></view>
 </view>
 <view class="me-version">{{ui.footer}}<view>Uniearn v{{version}}</view></view>
</view>
</block></view><app-nav active="profile"></app-nav>
<yuni-assistant id="me-yuni" topic="me" language="{{language}}"></yuni-assistant>

<!-- 2026-11-16: Yuni guide, the same spotlight as the Jobs page app guide -->
<block wx:if="{{yg>=0}}">
 <view wx:if="{{ygFocus}}" class="guide-focus yg-focus" style="top:{{ygFocus.top}}px;left:{{ygFocus.left}}px;width:{{ygFocus.width}}px;height:{{ygFocus.height}}px;border-radius:{{ygFocus.radius}}px"><view class="yg-ring"/></view>
 <view wx:else class="guide-shade yg-shade" catchtap="noop"/>
 <view wx:if="{{ygFocus}}" class="yg-blocker" catchtap="noop" catchtouchmove="noop"/>
 <view class="guide-modal yg-modal {{ygBottom?'yg-bottom':''}} {{darkClass?'yg-dark':''}}" catchtap="noop">
  <view class="row yg-top"><view class="yg-dots"><view wx:for="{{ygDots}}" wx:key="*this" class="yg-dot {{item===yg?'on':item<yg?'past':''}}"/></view><text class="yg-skip" hover-class="me-press" bindtap="ygFinish">{{language==='en'?'Skip':'跳过'}}</text></view>
  <view wx:for="{{[yg]}}" wx:key="*this" class="yg-step {{ygDir==='back'?'from-left':''}}"><view class="guide-body"><image class="yg-yuni" src="/assets/yuni-{{ygItem.pose}}.png" mode="aspectFit"/><view><view class="yg-name">Yuni</view><view class="guide-title">{{ygItem.title}}</view><view class="guide-text">{{ygItem.text}}</view></view></view></view>
  <view class="yg-actions"><button wx:if="{{yg>0}}" class="yg-btn yg-back" bindtap="ygBack">{{language==='en'?'Back':'上一步'}}</button><button class="yg-btn yg-next" bindtap="ygNext">{{yg===0?(language==='en'?'Show me':'带我看看'):yg===ygLast?(language==='en'?'Got it':'知道了'):(language==='en'?'Next':'下一步')}}</button></view>
 </view>
</block>
</view>

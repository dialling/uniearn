.name-page{min-height:100vh;padding:32rpx 32rpx calc(190rpx + env(safe-area-inset-bottom));box-sizing:border-box;background:#f4f6f0;color:#17352a}
.np-card{border-radius:40rpx;background:#fff;overflow:hidden}
.np-hero{display:flex;flex-direction:column;align-items:center;padding:56rpx 36rpx 44rpx;background:linear-gradient(#e9f4ee,#fff)}
.np-avatar{position:relative;display:flex;align-items:center;justify-content:center;width:200rpx;height:200rpx;border-radius:50%;background:#0b7a55;color:#fff;box-shadow:0 0 0 8rpx #fff,0 10rpx 28rpx #0b7a5533}
.np-avatar.busy{opacity:.55}
.np-initial{font-size:84rpx;font-weight:800}
.np-avatar-img{width:100%;height:100%;border-radius:50%}
.np-cam{position:absolute;right:-2rpx;bottom:2rpx;width:60rpx;height:60rpx;border-radius:50%;background:#17352a;border:6rpx solid #fff;display:flex;align-items:center;justify-content:center}
.np-cam image{width:28rpx;height:28rpx}
.np-shown{max-width:100%;margin-top:30rpx;font-size:42rpx;font-weight:800;line-height:1.25;text-align:center;overflow-wrap:anywhere}
.np-sub{margin-top:8rpx;max-width:520rpx;font-size:24rpx;line-height:1.5;text-align:center;color:#67776e}
.np-photo-actions{display:flex;justify-content:center;gap:16rpx;margin-top:28rpx}
.np-chip{height:68rpx;line-height:68rpx;padding:0 34rpx;border-radius:99rpx;background:#eef2ec;color:#44594e;font-size:27rpx;font-weight:700;white-space:nowrap}
.np-chip.main{background:#0b7a55;color:#fff}
.np-chip.off{opacity:.5}
.np-press{opacity:.8}
.np-form{padding:8rpx 36rpx 40rpx}
.np-label{display:block;font-size:26rpx;font-weight:800}
.np-input-row{display:flex;align-items:center;gap:16rpx;margin-top:14rpx;padding:0 24rpx;border:3rpx solid transparent;border-radius:24rpx;background:#f4f6f0}
.np-input-row:focus-within{border-color:#0b7a55;background:#fff}
.np-input-row input{flex:1;min-width:0;height:96rpx;font-size:31rpx}
.np-count{font-size:22rpx;color:#67776e;font-variant-numeric:tabular-nums}
.np-error{margin-top:14rpx;font-size:24rpx;color:#a34032}
.np-bottom{position:fixed;left:0;right:0;bottom:0;padding:18rpx 32rpx calc(22rpx + env(safe-area-inset-bottom));background:#f4f6f0;box-shadow:0 -6rpx 24rpx #0000000a}
.np-save{display:flex;align-items:center;justify-content:center;width:100%!important;margin:0;padding:0;height:96rpx;min-height:96rpx;line-height:1.2;border-radius:28rpx;background:#0b7a55;color:#fff;font-size:30rpx;font-weight:800}
.np-save::after{border:0}
.np-save[disabled]{background:#e1e9e2;color:#6b8075}
.dark{background:#192720;color:#e2efe6}
.dark .np-card{background:#24352c}
.dark .np-hero{background:linear-gradient(#2b4337,#24352c)}
.dark .np-avatar{box-shadow:0 0 0 8rpx #24352c}
.dark .np-cam{border-color:#24352c;background:#0b7a55}
.dark .np-sub,.dark .np-count{color:#b3c8bb}
.dark .np-chip{background:#1a2a22;color:#cfe0d5}
.dark .np-chip.main{background:#0b7a55;color:#fff}
.dark .np-input-row{background:#1a2a22}
.dark .np-input-row:focus-within{background:#1a2a22}
.dark .np-error{color:#ffc1ae}
.dark .np-bottom{background:#192720}

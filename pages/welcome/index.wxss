@import "../../utils/flow.wxss";
/* Welcome / sign-in (2026-11-20 redesign): white page with Yuni greeting, a quiet list of what Uniearn does,
   and a sign-in bar that stays at the bottom so the agreement and button are always in reach. */
page{background:#ffffff}
/* Spacing scale: 16 / 24 / 32 / 48 rpx. The page fills the screen above the sign-in bar; the message block
   sits centred in whatever room is left, so short (Chinese) and long (English) copy both look balanced. */
.welcome{display:flex;flex-direction:column;min-height:100vh;box-sizing:border-box;background:#ffffff;color:#1b1d1a;padding-bottom:calc(224rpx + env(safe-area-inset-bottom))}
.welcome.has-error{padding-bottom:calc(432rpx + env(safe-area-inset-bottom))}

/* top: white, Yuni greeting the student */
.hero{flex:none;position:relative;background:#ffffff;padding:32rpx 40rpx 0}
.welcome-body{flex:1;display:flex;flex-direction:column;justify-content:center;padding:40rpx 0 24rpx}
.welcome-header{position:relative;display:flex;align-items:center;justify-content:space-between;min-height:62rpx}
.brand{display:flex;align-items:center;gap:18rpx;font-size:38rpx;font-weight:800;color:#1b1d1a}
.logo{position:relative;width:66rpx;height:66rpx;border-radius:20rpx;background:#0b7a55;color:#ffffff;text-align:center;line-height:66rpx;font-size:44rpx}
.logo text{position:absolute;right:16rpx;top:-8rpx;font-size:12rpx;color:#0b7a55}
.green-word{color:#0b7a55}
.welcome-header .language-switch{flex:none;width:auto!important;min-width:120rpx;display:inline-flex;align-items:center;justify-content:center;height:56rpx;min-height:0;margin:0;padding:0 26rpx;border-radius:28rpx;background:#f3faf6;color:#0b7a55;font-size:23rpx;font-weight:700;line-height:56rpx;white-space:nowrap}
.language-switch::after{border:0}
.welcome-yuni{position:relative;display:flex;align-items:flex-end;gap:16rpx;margin-top:32rpx}
.yuni-pic{flex:none;width:210rpx;height:236rpx}
.hello{flex:1;margin-bottom:32rpx;background:#f3f6f1;border:1rpx solid #e3e9de;border-radius:34rpx 34rpx 34rpx 8rpx;padding:22rpx 26rpx;font-size:27rpx;line-height:1.6;color:#2b2d28}
.yuni-name{font-size:22rpx;font-weight:800;color:#0b7a55;margin-bottom:4rpx}

/* message */
.headline{margin:0 40rpx;font-size:58rpx;font-weight:800;line-height:1.18;color:#1b1d1a}
.intro{margin:24rpx 40rpx 0;font-size:28rpx;line-height:1.7;color:#4a4842}

/* what you can do: a plain list with the same 3D icons as the Post sheet (pickup, task, trip), no tiles */
.features{display:flex;flex-direction:column;gap:28rpx;margin:44rpx 40rpx 0}
.feature{display:flex;align-items:center;gap:24rpx}
.feature-icon{flex:none;width:80rpx;height:80rpx}
.feature-text{flex:1;min-width:0}
.feature-title{font-size:30rpx;font-weight:750;line-height:1.4;color:#1b1d1a}
.feature-sub{margin-top:4rpx;font-size:24rpx;line-height:1.55;color:#6b6860}

/* sign-in bar */
.welcome-footer{position:fixed;left:0;right:0;bottom:0;z-index:20;background:#ffffff;padding:22rpx 40rpx calc(26rpx + env(safe-area-inset-bottom));box-shadow:0 -14rpx 36rpx rgba(30,50,10,.07);border-radius:36rpx 36rpx 0 0}
.welcome-agreement{display:flex;align-items:center;gap:14rpx;font-size:23rpx;line-height:1.55;color:#6b6860}
.agreement-text{flex:1}
.welcome-agreement .link{color:#0b7a55;text-decoration:underline}
.welcome-check{display:inline-flex;align-items:center;justify-content:center;flex:none;width:36rpx;height:36rpx;border:2rpx solid #c9c5b8;border-radius:10rpx;background:#ffffff;color:#ffffff;font-size:24rpx;line-height:1}
.welcome-check.checked{background:#0b7a55;border-color:#0b7a55}
.welcome-footer .welcome-enter{display:flex;align-items:center;justify-content:center;width:100%!important;max-width:none;height:100rpx;margin:20rpx 0 0;padding:0;border-radius:50rpx;background:#0b7a55;color:#ffffff;font-size:32rpx;font-weight:750;line-height:100rpx;white-space:nowrap}
.welcome-enter::after{border:0}
.welcome-footer .welcome-enter[disabled]{background:#0b7a55;color:rgba(255,255,255,.75)}

/* failed sign-in: short reason, the real detail for testers, and a way to copy it */
.welcome-footer .notice-error{margin:0 0 18rpx;padding:20rpx 24rpx;border-radius:22rpx;background:#fff3ec;color:#a8360c}
.notice-error-title{font-size:26rpx;font-weight:750;line-height:1.5}
.notice-error-detail{margin-top:6rpx;font-size:21rpx;line-height:1.5;color:#8a877c;word-break:break-all;display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:3;overflow:hidden}
.notice-error-copy{display:inline-block;margin-top:8rpx;font-size:22rpx;font-weight:700;color:#0b7a55}

/* one entrance: Yuni pops in and the bubble follows; then Yuni floats */
@keyframes welcome-yuni{0%{opacity:0;transform:translate3d(0,30rpx,0) scale(.8) rotate(-6deg)}60%{opacity:1;transform:translate3d(0,-8rpx,0) scale(1.05) rotate(2deg)}100%{opacity:1;transform:translate3d(0,0,0) scale(1) rotate(0)}}
@keyframes welcome-bubble{from{opacity:0;transform:translate3d(-20rpx,10rpx,0) scale(.94)}to{opacity:1;transform:translate3d(0,0,0) scale(1)}}
.yuni-pic{animation:var(--ue-animation,welcome-yuni .6s cubic-bezier(.3,1.3,.5,1) backwards,ue-float 3.4s ease-in-out .6s infinite)}
.hello{animation:var(--ue-animation,welcome-bubble .4s cubic-bezier(.22,.8,.3,1) .2s backwards)}

.welcome-skip{margin-top:18rpx;background:transparent;border:0;color:#7c7768;font-size:26rpx;line-height:1.6}
.welcome-skip::after{border:0}

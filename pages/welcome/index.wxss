@import "../../utils/flow.wxss";
.welcome{min-height:100vh;padding:45rpx 40rpx 45rpx;background:white;display:flex;flex-direction:column}.brand{display:flex;align-items:center;gap:22rpx;font-size:40rpx;font-weight:800}.logo{background:#0b7a55;color:white;width:73rpx;height:73rpx;border-radius:22rpx;text-align:center;line-height:73rpx;font-size:49rpx;position:relative}.logo text{font-size:13rpx;color:#0b7a55;position:absolute;right:19rpx;top:-10rpx}.green-word{color:#0b7a55}.welcome-yuni{display:flex;align-items:center;gap:24rpx;margin:38rpx 0 20rpx}.welcome-yuni image{width:160rpx;height:180rpx;flex:none}.hello{background:#e7f3ed;border:1rpx solid #cfe8dc;border-radius:28rpx;padding:22rpx;font-size:27rpx;line-height:1.6}.yuni-name{color:#0b7a55;font-weight:700;font-size:22rpx}.headline{font-size:47rpx;font-weight:800;line-height:1.2;margin:16rpx 0}.intro{font-size:28rpx;line-height:1.7;color:#44423c;margin-bottom:26rpx}.feature{display:flex;align-items:center;gap:22rpx;background:#f7f6f2;border-radius:24rpx;padding:22rpx 26rpx;margin-bottom:18rpx}.feature-icon{width:64rpx;height:70rpx;border-radius:18rpx;text-align:center;line-height:70rpx;font-size:36rpx;flex:none}.orange{background:#fff1e6;color:#c2410c}.gold{background:#e7f3ed;color:#0b7a55}.green{background:#e7f3ed;color:#0b7a55}.welcome-footer{margin-top:auto;padding-top:60rpx}.manual-link{text-align:center;font-size:22rpx;color:#6b6860;padding:12rpx} 
.welcome{box-sizing:border-box}.welcome-header{display:flex;align-items:center;justify-content:space-between;gap:20rpx}.language-switch{flex:none;margin:0;background:#f3faf6;border-radius:32rpx;padding:10rpx 24rpx;line-height:1.6;color:#0b7a55;font-size:24rpx;font-weight:650}.language-switch::after{border:0}.welcome-enter{width:100%;min-height:96rpx;display:flex;align-items:center;justify-content:center;white-space:nowrap}

.welcome-header{position:relative;min-height:62rpx;padding-right:140rpx}.welcome-header .language-switch{position:absolute;right:0;top:0;display:inline-flex;align-items:center;justify-content:center;width:120rpx;min-width:0;max-width:120rpx;height:54rpx;min-height:0;margin:0;padding:0;flex:0 0 120rpx;font-size:22rpx;line-height:54rpx;border-radius:28rpx;white-space:nowrap}

.welcome-agreement{display:flex;align-items:center;justify-content:center;gap:12rpx;text-align:left;color:#6b6860;font-size:22rpx;line-height:1.6;margin-top:24rpx}.welcome-agreement .link{text-decoration:underline}

@keyframes welcome-yuni{0%{opacity:0;transform:translate3d(0,30rpx,0) scale(.8) rotate(-6deg)}60%{opacity:1;transform:translate3d(0,-8rpx,0) scale(1.05) rotate(2deg)}100%{opacity:1;transform:translate3d(0,0,0) scale(1) rotate(0)}}
@keyframes welcome-bubble{from{opacity:.4;transform:translate3d(-20rpx,0,0) scale(.96)}to{opacity:1;transform:translate3d(0,0,0) scale(1)}}
.welcome-yuni image{animation:welcome-yuni .6s cubic-bezier(.3,1.3,.5,1) backwards,ue-float 3.4s ease-in-out .6s infinite}
.hello{animation:welcome-bubble .36s cubic-bezier(.22,.8,.3,1) .08s backwards}
.headline,.intro,.feature{animation:ue-settle .32s cubic-bezier(.22,.8,.3,1) .1s backwards}
.feature+.feature{animation-delay:.14s}.feature+.feature+.feature{animation-delay:.18s}

.welcome-check{display:inline-flex;align-items:center;justify-content:center;flex:none;width:32rpx;height:32rpx;border:2rpx solid #c9c5b8;border-radius:8rpx;background:#fff;color:#fff;font-size:24rpx;line-height:1}.welcome-check.checked{background:#0b7a55;border-color:#0b7a55}

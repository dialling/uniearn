/* Compact campus route slips: destination, reward, pickup, then action. */
.jobs-page .job-card{padding:26rpx 26rpx 22rpx;margin:18rpx 0;border:1rpx solid #e0e5dd;border-radius:26rpx;background:#fff;box-shadow:0 5rpx 18rpx rgba(32,53,39,.035)}

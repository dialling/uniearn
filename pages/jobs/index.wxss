.guide-ring{position:absolute;left:-4rpx;top:-4rpx;right:-4rpx;bottom:-4rpx;border:4rpx solid #fff;border-radius:29rpx;animation:var(--ue-animation,guide-ring 1.8s ease-out .45s infinite)}

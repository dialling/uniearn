/* Public order detail styles are embedded to avoid a stale DevTools import index.
   Source: utils/public-order.wxss */
.public-order-summary{display:flex;align-items:flex-start;justify-content:space-between;gap:24rpx}
.public-order-heading{min-width:0}
.public-order-type{font-size:28rpx;font-weight:750;color:#16181c;line-height:1.3}
.public-order-status{display:inline-flex;align-items:center;margin-top:12rpx;padding:6rpx 14rpx;border-radius:999rpx;background:#e7f3ed;color:#0b7a55;font-size:22rpx;line-height:1.4;font-weight:650}
.public-order-status.status-waiting{background:#fde8dc;color:#c2410c}
.public-order-price{flex:none;color:#c2410c;font-size:52rpx;font-weight:750;line-height:1;font-variant-numeric:tabular-nums}
.public-order-price text{margin-right:4rpx;font-size:26rpx;font-weight:700}
.public-order-route{margin:28rpx 0 24rpx;padding:24rpx 26rpx;background:#f7f5f0;border-radius:24rpx}
.public-order-route-single{font-size:31rpx;font-weight:750;line-height:1.5;overflow-wrap:anywhere}
.public-order-leg{display:flex;flex-direction:column;gap:6rpx}
.public-order-kicker{font-size:20rpx;color:#8a877e;font-weight:650;letter-spacing:1rpx}
.public-order-place{font-size:30rpx;font-weight:750;color:#16181c;line-height:1.45;overflow-wrap:anywhere}
.public-order-trail{width:3rpx;height:22rpx;margin:12rpx 0 12rpx 6rpx;border-radius:3rpx;background:#d8d3c8}
.public-order-flags{display:flex;flex-wrap:wrap;gap:10rpx;margin:0 0 20rpx}
.public-order-flags text{padding:8rpx 16rpx;border-radius:999rpx;background:#f3f1eb;color:#6b6860;font-size:22rpx}
.public-order-fields{padding:8rpx 24rpx;background:#f7f5f0;border-radius:24rpx}
.public-order-field{display:flex;align-items:baseline;gap:22rpx;padding:20rpx 0;border-bottom:1rpx solid #ebe7de;line-height:1.55;font-size:26rpx}
.public-order-field:last-child{border-bottom:0}
.public-order-label{flex:none;width:168rpx;color:#8a877e}
.public-order-value{flex:1;min-width:0;color:#303930;font-weight:650;overflow-wrap:anywhere;white-space:pre-wrap}
.public-order-section{margin:0 0 10rpx;font-size:22rpx;font-weight:700;color:#8a877e;letter-spacing:1rpx}
.public-order-note{margin-top:24rpx;padding:22rpx 24rpx;background:#f7f5f0;border-radius:24rpx;font-size:26rpx;line-height:1.65;white-space:pre-wrap;overflow-wrap:anywhere;color:#454d43}
.public-order-privacy{margin:24rpx 4rpx 4rpx;font-size:21rpx;line-height:1.65;color:#9a978e}
.public-detail-overlay{position:fixed;inset:0;z-index:300}
.public-detail-mask{position:absolute;inset:0;background:rgba(22,24,28,.44)}
.public-detail-panel{position:absolute;left:0;right:0;bottom:0;display:flex;flex-direction:column;height:auto;max-height:calc(100vh - 100rpx);padding:8rpx 30rpx calc(22rpx + env(safe-area-inset-bottom));border-radius:36rpx 36rpx 0 0;background:#fff;box-sizing:border-box;animation:var(--ue-animation,public-detail-in .24s ease-out both)}
.public-detail-handle{flex:none;width:72rpx;height:8rpx;margin:10rpx auto 18rpx;border-radius:8rpx;background:#d8d3c8}
.public-detail-header{display:flex;align-items:center;justify-content:space-between;gap:20rpx;margin-bottom:26rpx;font-size:30rpx;font-weight:750;color:#16181c}
.public-detail-close{display:flex;align-items:center;justify-content:center;flex:none;width:56rpx;height:56rpx;min-width:56rpx;max-width:56rpx;padding:0;margin:0;border:0;border-radius:50%;background:#efece6;color:#6b6860;font-size:34rpx;font-weight:400;line-height:56rpx;text-align:center;box-sizing:border-box}
.public-detail-scroll{flex:1 1 auto;min-height:0;max-height:56vh;height:auto}
.public-detail-body{padding:0 2rpx 16rpx}
.public-detail-footer{display:flex;gap:16rpx;flex:none;padding-top:20rpx;border-top:1rpx solid #eeede8}
.public-detail-footer .btn{flex:1;min-width:0;margin:0;min-height:84rpx;border-radius:20rpx;font-size:29rpx;font-weight:650}
.public-detail-footer .public-detail-take{border:0;background:linear-gradient(180deg,#1aa36f 0%,#0c7d58 52%,#086847 100%);color:#fff;box-shadow:0 10rpx 20rpx rgba(11,122,85,.28),inset 0 2rpx 0 rgba(255,255,255,.28),inset 0 -3rpx 0 rgba(0,40,24,.1);text-shadow:0 1rpx 0 rgba(0,40,24,.18)}
.public-detail-overlay.page-dark{background:transparent!important}
.page-dark .public-detail-panel{background:#242522}
.page-dark .public-order-type,.page-dark .public-order-place,.page-dark .public-order-value,.page-dark .public-detail-header{color:#edebe4}
.page-dark .public-order-fields,.page-dark .public-order-route,.page-dark .public-order-note{background:#30322c}
.page-dark .public-order-price{color:#f4a06e}
.page-dark .public-order-status{background:#203b30;color:#6fd0a8}
.page-dark .public-order-status.status-waiting{background:#3d2c22;color:#f4b582}
.page-dark .public-order-label,.page-dark .public-order-privacy,.page-dark .public-order-kicker,.page-dark .public-order-section,.page-dark .public-order-note{color:#a9a69c}
.page-dark .public-order-field,.page-dark .public-detail-footer{border-color:#3a3b37}
.page-dark .public-order-flags text,.page-dark .public-detail-close{background:#34372f;color:#c8c7bd}
.page-dark .public-detail-handle,.page-dark .public-order-trail{background:#4a4b45}
.page-dark .public-detail-footer .public-detail-take{background:linear-gradient(180deg,#7ed9b4 0%,#4cbc8c 55%,#2f9d73 100%);color:#10241b;text-shadow:none;box-shadow:0 10rpx 20rpx rgba(0,0,0,.28),inset 0 2rpx 0 rgba(255,255,255,.28)}
@keyframes public-detail-in{from{transform:translateY(35rpx);opacity:0}to{transform:none;opacity:1}}
/* End public order detail styles. */
@import "../../utils/dorm-gender.wxss";
@import "../../utils/flow.wxss";
.filter-chip-track{display:inline-flex;align-items:center;gap:12rpx;white-space:nowrap;padding:2rpx 6rpx 2rpx 0}
.filter-row .filter-chip-track .filter-pill{flex:none;margin:0}
.jobs-page{padding:0 0 160rpx;background:#eeede8}.jobs-header{background:transparent;padding:28rpx 42rpx 18rpx}.jobs-header .flow-title{margin:0;font-size:38rpx}.jobs-header .flow-sub{margin:6rpx 0 0}.filter-trigger{display:flex;align-items:center;gap:10rpx;border:1rpx solid #e2e0d9;border-radius:50rpx;padding:14rpx 25rpx;white-space:nowrap;font-size:26rpx;color:#16181c}.filter-trigger.open{border-color:#16181c}.filter-icon{font-size:35rpx;line-height:25rpx;transform:rotate(180deg)}.filter-panel{margin-top:26rpx}.filter-row{display:flex;align-items:center;min-width:0;gap:14rpx;margin:12rpx 0}.filter-name{width:77rpx;flex:none;font-size:23rpx;font-weight:750;color:#44423c}.filter-row .scroll-pills{flex:1;width:0;margin:0}.filter-row .filter-pill{font-size:23rpx;padding:13rpx 20rpx}.clear-filter{text-align:right;font-size:23rpx;margin:10rpx 0 0}.jobs-content{padding:20rpx 40rpx 0}.jobs-hint{color:#6b6860;font-size:24rpx;line-height:1.55;margin:6rpx 0 26rpx}.jobs-page .flow-card{margin:20rpx 0;padding:27rpx}.jobs-page .flow-card .btn{width:100%;margin:18rpx 0 0}.jobs-page .amount{font-size:40rpx}.jobs-page .route{font-size:30rpx}.jobs-page .green-note{padding:20rpx}.jobs-page .badge{font-size:21rpx}

.jobs-page .own-post{border:2rpx dashed #0b7a55}.jobs-page .taken-card{border:1rpx solid #cfe8dc;background:#fff}.jobs-page .final-tabs view{font-size:23rpx;padding:16rpx 2rpx}.jobs-page .done-card{border-color:#cfe8dc}.jobs-page .own-badge{background:#0b7a55;color:#fff}.jobs-page .done-badge{background:#0b7a55;color:#fff}.jobs-page .taken-badge{background:#e7f3ed;color:#0b7a55}.jobs-page .badge.takeout{background:#e7f3ed;color:#8e3b6e}.jobs-page .badge.parcel{background:#e6edfc;color:#1e40af}.jobs-page .badge.task{background:#e6edfc;color:#1d4ed8}.job-timing{padding:22rpx;background:#f7f6f2;border-radius:20rpx;margin:20rpx 0;font-size:24rpx;font-weight:700;color:#44423c}.taken-card .job-timing{background:#f0eee8}.done-card .job-timing{background:#e7f3ed;color:#0b7a55}.jobs-page .own-order{background:#f3faf6;color:#0b7a55}.done-proof{border-radius:27rpx;padding:30rpx;background:#0b7a55;color:#fff;font-size:22rpx;line-height:1.55;margin:24rpx 0}.proof-count{font-weight:700;margin:20rpx 0}.proof-count text{font-size:60rpx;margin-right:15rpx}.date-heading{font-size:25rpx;font-weight:700;margin:28rpx 4rpx 0}.date-heading .hint{font-weight:400}.taken-heading{margin-top:36rpx;color:#3d6b57}

.guide-modal{top:16%;max-height:calc(100vh - 210rpx);overflow-y:auto;box-sizing:border-box}.guide-modal.bottom-modal{top:auto;bottom:190rpx;max-height:calc(100vh - 230rpx)}.guide-modal .guide-text{font-size:25rpx;line-height:1.6}.guide-example{border:2rpx dashed #6fd0a8;border-radius:22rpx;padding:22rpx;margin:18rpx 0}.guide-example .route{margin:16rpx 0;font-size:27rpx}.example-button{pointer-events:none;text-align:center}.guide-complete{position:fixed;bottom:180rpx;left:26rpx;right:26rpx;z-index:100;background:#16181c;color:#fff;padding:24rpx;border-radius:24rpx;font-size:25rpx;line-height:1.5}.empty-reminder{margin-top:22rpx}.jobs-page .empty-post{background:#0b7a55;width:auto;padding:0 40rpx;display:flex;align-items:center;justify-content:center;min-height:88rpx;line-height:1.2}.nav .item text{white-space:nowrap}

@keyframes guide-spot-in{from{transform:scale(1.35)}to{transform:scale(1)}}
@keyframes guide-ring{0%{opacity:.85;transform:scale(1)}80%,100%{opacity:0;transform:scale(1.22)}}
@keyframes guide-modal-in{0%{opacity:0;transform:translate3d(0,40rpx,0) scale(.96)}70%{opacity:1;transform:translate3d(0,-4rpx,0) scale(1.005)}100%{opacity:1;transform:translate3d(0,0,0) scale(1)}}
@keyframes guide-from-right{from{opacity:0;transform:translate3d(40rpx,0,0)}to{opacity:1;transform:translate3d(0,0,0)}}
@keyframes guide-from-left{from{opacity:0;transform:translate3d(-40rpx,0,0)}to{opacity:1;transform:translate3d(0,0,0)}}
@keyframes guide-yuni-in{0%{opacity:0;transform:translate3d(0,24rpx,0) scale(.7) rotate(-8deg)}60%{opacity:1;transform:translate3d(0,-6rpx,0) scale(1.08) rotate(3deg)}100%{opacity:1;transform:translate3d(0,0,0) scale(1) rotate(0)}}
@keyframes guide-float{0%,100%{transform:translate3d(0,0,0)}50%{transform:translate3d(0,-8rpx,0)}}
@keyframes guide-toast-in{from{opacity:0;transform:translate3d(0,40rpx,0)}to{opacity:1;transform:translate3d(0,0,0)}}
.guide-shade{z-index:100}
.guide-focus{z-index:100;transition:var(--ue-transition,top .42s cubic-bezier(.3,.9,.25,1),left .42s cubic-bezier(.3,.9,.25,1),width .42s cubic-bezier(.3,.9,.25,1),height .42s cubic-bezier(.3,.9,.25,1),border-radius .42s cubic-bezier(.3,.9,.25,1));animation:var(--ue-animation,guide-spot-in .45s cubic-bezier(.3,.9,.25,1) backwards)}
.guide-ring{position:absolute;left:-4rpx;top:-4rpx;right:-4rpx;bottom:-4rpx;border:4rpx solid #fff;border-radius:inherit;animation:var(--ue-animation,guide-ring 1.8s ease-out .45s infinite)}
.guide-blocker{position:fixed;left:0;top:0;right:0;bottom:0;z-index:101}
.guide-modal{z-index:102;box-shadow:0 20rpx 50rpx rgba(22,24,28,.18);animation:var(--ue-animation,guide-modal-in .46s cubic-bezier(.22,.9,.3,1) backwards)}
.guide-step{animation:var(--ue-animation,guide-from-right .34s cubic-bezier(.22,.8,.3,1) backwards)}
.guide-step.from-left{animation-name:var(--ue-animation-name,guide-from-left)}
.guide-step .guide-body image{animation:var(--ue-animation,guide-yuni-in .6s cubic-bezier(.3,1.3,.5,1) .06s backwards,guide-float 3.2s ease-in-out .7s infinite)}
.guide-progress{display:flex;align-items:center;gap:16rpx}
.guide-progress .hint{margin:0}
.guide-dots{display:flex;align-items:center;gap:8rpx}
.guide-dot{width:12rpx;height:12rpx;border-radius:12rpx;background:#e2e0d9;transition:var(--ue-transition,width .32s cubic-bezier(.3,.9,.25,1),background-color .32s ease,opacity .32s ease)}
.guide-dot.past{background:#0b7a55;opacity:.4}
.guide-dot.on{width:36rpx;background:#0b7a55}
.guide-modal .action-row .btn{transition:var(--ue-transition,transform .16s ease,opacity .16s ease)}
.guide-complete{animation:var(--ue-animation,guide-toast-in .4s cubic-bezier(.22,.9,.3,1.15) backwards)}

.order-toggle-row{margin:20rpx 0;gap:16rpx}.order-toggle{flex:none;font-size:24rpx;font-weight:700;color:#44423c;padding:12rpx 0 12rpx 24rpx}.selectable-order{display:flex;align-items:center;gap:18rpx;padding:22rpx;border:1rpx solid #e4e1d8;border-radius:20rpx;background:#fafaf7;margin:12rpx 0}.order-check{flex:none;width:34rpx;height:34rpx;border:2rpx solid #d6d2c6;border-radius:50%;background:white;display:flex;align-items:center;justify-content:center;color:white;font-size:23rpx}.order-check.checked{background:#0b7a55;border-color:#0b7a55}.order-summary{flex:1;min-width:0}.order-summary .hint{margin:6rpx 0 0}.individual-parcels{display:block;color:#0b7a55;text-align:center;font-size:23rpx;padding:18rpx 0 0}.jobs-page .btn[disabled]{background:#e4e1d8;color:#8a877e}
.order-note{margin-top:6rpx;padding:8rpx 14rpx;border-radius:12rpx;background:#f6f5f1;color:#5e5c55;font-size:23rpx;line-height:1.45;word-break:break-all}.page-dark .order-note{background:#242522;color:#a9a69c}

.guide-modal.guide-dark{background:#242522!important;color:#edebe4!important;border:1rpx solid #3a3b37}
.guide-modal.guide-dark .guide-title,.guide-modal.guide-dark .strong,.guide-modal.guide-dark .guide-text{color:#edebe4!important}
.guide-modal.guide-dark .guide-example{background:#242522!important;border-color:#3a3b37!important}
.guide-modal.guide-dark .btn.light{background:#3a2416!important;color:#edebe4!important}

.hall-location{margin:18rpx 0;padding:20rpx 22rpx;background:#f7f6f2;border-radius:18rpx}.hall-location-head{display:flex;align-items:center;justify-content:space-between;gap:14rpx;margin-bottom:18rpx}.hall-location-title{font-size:23rpx;font-weight:650;color:#5e5c55}.hall-gender{font-size:22rpx;font-weight:650;color:#0b7a55;background:#e7f3ed;border-radius:10rpx;padding:5rpx 14rpx}.hall-gender.not-set{color:#8a877e;background:#eeede8;font-weight:400}.hall-location-grid{display:flex;gap:20rpx}.hall-location-grid>view{flex:1;min-width:0}.hall-location-label{display:block;font-size:22rpx;line-height:1.4;color:#8a877e;margin-bottom:7rpx}.hall-location-value{display:block;font-size:27rpx;line-height:1.45;font-weight:650;color:#16181c;overflow-wrap:anywhere;word-break:break-word}.hall-locker{display:flex;gap:18rpx;align-items:flex-start;margin:14rpx 0;font-size:24rpx;line-height:1.5;color:#5e5c55}.hall-locker .hall-location-label{flex:none;width:98rpx;margin:0}.hall-locker>text:last-child{flex:1;min-width:0;overflow-wrap:anywhere}.hall-order-address{color:#5e5c55}.page-dark .hall-location{background:#1b1c1a}.page-dark .hall-location-title,.page-dark .hall-locker,.page-dark .hall-order-address{color:#c2bfb6}.page-dark .hall-location-value{color:#edebe4}.page-dark .hall-location-label{color:#aaa79f}.page-dark .hall-gender{background:#183b2d;color:#6fd0a8}.page-dark .hall-gender.not-set{background:#3a3b37;color:#aaa79f}

 .hall-genders{display:flex;flex-wrap:wrap;justify-content:flex-end;gap:8rpx}

/* Compact campus route slips: destination, reward, pickup, then action. */
.jobs-page{
background:
radial-gradient(90% 58% at 100% -6%,rgba(11,122,85,.10),transparent 58%),
radial-gradient(70% 46% at 0% 16%,rgba(255,255,255,.62),transparent 52%),
radial-gradient(80% 42% at 92% 74%,rgba(210,196,170,.20),transparent 55%),
#eeede8}
.jobs-page .job-card{position:relative;overflow:hidden;padding:26rpx 26rpx 22rpx;margin:18rpx 0;border:1rpx solid rgba(255,255,255,.9);border-radius:26rpx;background:rgba(255,255,255,.92);box-shadow:0 10rpx 28rpx rgba(40,36,28,.06),inset 0 1rpx 0 rgba(255,255,255,.95)}
.jobs-page .job-card::before{content:'';position:absolute;left:0;right:0;top:0;height:6rpx;background:linear-gradient(90deg,#efc09a,#d98955)}
.jobs-page .job-card.job-card-takeout::before{background:linear-gradient(90deg,#f0c49a,#e08a4a)}
.jobs-page .job-card.job-card-parcel::before{background:linear-gradient(90deg,#9bb6e8,#6a8fd0)}
.jobs-page .job-card.job-card-task::before{background:linear-gradient(90deg,#8fb3e8,#4d7fd4)}
.jobs-page .job-card.job-card-night::before,.jobs-page .job-card.job-card-takeout.job-card-night::before{background:linear-gradient(90deg,#f0b27a,#c2410c)}
.jobs-page .job-card.own-post{border:1rpx solid rgba(166,205,184,.9)}
.jobs-page .job-card.taken-card{border-style:solid;border-color:rgba(197,223,209,.8)}
.jobs-page .job-card.taken-card::before{background:linear-gradient(90deg,#7dc4a6,#0b7a55)}
.jobs-page .job-card.done-card{border-color:rgba(207,232,220,.85)}
.jobs-page .job-card.done-card::before{background:linear-gradient(90deg,#9dd4bb,#0b7a55)}
.job-card-header{align-items:flex-start;gap:16rpx}
.job-badges{flex:1;min-width:0;display:flex;flex-wrap:wrap;align-items:center;gap:7rpx}
.jobs-page .job-card .job-badges .badge{margin:0;padding:5rpx 11rpx;border-radius:9rpx;font-size:20rpx;font-weight:550;line-height:1.45}
.jobs-page .job-card .job-badges .state-badge{display:inline-flex;align-items:center;gap:8rpx;background:transparent!important;color:#777d76;padding-left:0;padding-right:3rpx;font-weight:500}
.jobs-page .job-card .job-badges .state-badge.done-badge,.jobs-page .job-card .job-badges .state-badge.own-badge{color:#0b7a55;font-weight:650}
.jobs-page .job-card .job-badges .state-badge.state-live-open{color:#c2410c;font-weight:650}
.jobs-page .job-card .job-badges .state-badge.state-live-running{color:#0b7a55;font-weight:650}
.state-live-dot{position:relative;flex:none;width:12rpx;height:12rpx;border-radius:50%;background:currentColor}
.state-live-ring{position:absolute;left:50%;top:50%;width:12rpx;height:12rpx;margin:-6rpx 0 0 -6rpx;border-radius:50%;background:currentColor;animation:var(--ue-animation,hall-live-pulse 1.7s ease-out infinite)}
@keyframes hall-live-pulse{0%{transform:scale(1);opacity:.55}70%,100%{transform:scale(2.4);opacity:0}}
.page-dark.jobs-page .job-card .job-badges .state-badge.state-live-open{color:#f0a07a}
.page-dark.jobs-page .job-card .job-badges .state-badge.state-live-running{color:#6fd0a8}
.jobs-page .job-card .badge.takeout{color:#8a4b24;background:#f6eadc}
.jobs-page .job-card .badge.orange{background:#fff2e9;color:#b45321}
.jobs-page .job-card .amount{display:flex;align-items:baseline;flex:none;gap:3rpx;font-family:inherit;font-variant-numeric:tabular-nums;font-size:48rpx;font-weight:750;letter-spacing:-1rpx;line-height:1.05;color:#c2410c;white-space:nowrap}
.job-card .job-currency{font-size:27rpx;font-weight:650;letter-spacing:0}
.jobs-page .job-card .route{display:flex;align-items:baseline;gap:13rpx;margin:22rpx 0 0;font-size:31rpx;font-weight:750;line-height:1.45}
.job-route-origin{flex:0 1 auto;max-width:44%;min-width:0;color:#7b817a;font-size:24rpx;font-weight:500;overflow-wrap:anywhere}
.job-route-arrow{flex:none;color:#a0a79f;font-size:24rpx;font-weight:400}
.job-route-destination{flex:1;min-width:0;overflow-wrap:anywhere;color:#16181c}
.job-task-title{min-width:0;overflow-wrap:anywhere}
.job-card .job-timing{margin:13rpx 0 17rpx;padding:0;background:transparent;border-radius:0;gap:12rpx;flex-wrap:wrap;font-size:22rpx;font-weight:550;line-height:1.5;color:#0b7a55}
.job-card .job-timing>text:first-child::before{content:'';display:inline-block;width:8rpx;height:8rpx;margin-right:10rpx;border-radius:50%;background:currentColor;vertical-align:middle}
.job-card .job-timing>text+text{font-size:21rpx;font-weight:400;color:#7b817a}
.job-card .hall-locker{display:flex;align-items:baseline;gap:15rpx;margin:0;font-size:27rpx;line-height:1.5}
.job-card .hall-locker .hall-location-label{flex:none;width:auto;min-width:78rpx;margin:0;font-size:23rpx;color:#7b817a;line-height:1.5}
.job-card .hall-locker-value{flex:1;min-width:0;font-weight:600;color:#303930;overflow-wrap:anywhere}
.jobs-page .job-card .order-note{display:flex;align-items:baseline;gap:15rpx;padding:0;margin:12rpx 0 0;border-radius:0;background:transparent;font-size:23rpx;line-height:1.55;color:#687268;word-break:normal}
.job-note-label{flex:none;min-width:78rpx;color:#7b817a;font-size:22rpx}
.job-note-copy{flex:1;min-width:0;white-space:pre-wrap;overflow-wrap:anywhere}
.job-card>.hint{margin:10rpx 0;font-size:22rpx;line-height:1.5}
.jobs-page .job-card .green-note{margin:12rpx 0;padding:9rpx 14rpx;font-size:22rpx;border-radius:10rpx}
.job-footer{display:flex;align-items:center;justify-content:space-between;gap:24rpx;margin-top:20rpx;padding-top:18rpx;border-top:1rpx solid rgba(70,52,32,.08)}
.jobs-page .job-card.job-card-parcel .job-footer{border-top-color:rgba(40,70,140,.1)}
.jobs-page .job-card.taken-card .job-footer{border-top-color:rgba(11,122,85,.12)}
.job-deadline-label{font-size:21rpx;color:#8a9088}
.job-deadline-value{font-size:24rpx;font-weight:650;font-variant-numeric:tabular-nums;color:#394438}
/* 接单截止跟在同一信息行右侧，不要单独占一行 */
.job-card .job-meta-row{display:flex;align-items:baseline;justify-content:space-between;gap:16rpx}
.job-card .job-meta-row>text{flex:1;min-width:0}
.job-deadline-mini{display:flex;flex:none;align-items:baseline;gap:8rpx;margin-left:auto;padding-left:16rpx;line-height:1.4;text-align:right;white-space:nowrap}
.job-card .job-timing .job-deadline-mini{margin:0 0 0 auto}
.jobs-page .job-card .btn{margin:0;min-height:74rpx;padding:17rpx 20rpx;border-radius:17rpx;font-size:25rpx;line-height:1.5;box-sizing:border-box}
.jobs-page .job-card .btn.job-take-button{display:flex;align-items:center;justify-content:space-between;gap:26rpx;flex:none;width:212rpx;min-width:0;margin:0;padding:15rpx 24rpx;border:1rpx solid rgba(11,122,85,.22);background:rgba(231,243,237,.78);color:#0b7a55;font-size:27rpx;font-weight:650;line-height:1.5;min-height:74rpx;border-radius:17rpx;box-shadow:none;text-shadow:none;transition:background-color .12s ease,opacity .12s ease}
.jobs-page .job-card .btn.job-take-continue{background:rgba(231,243,237,.78);border-color:rgba(11,122,85,.22);color:#0b7a55;box-shadow:none}
.job-take-arrow{font-size:33rpx;font-weight:400;line-height:1}
.job-footer-take{display:flex;align-items:center;justify-content:space-between;gap:20rpx}
.job-poster{display:flex;align-items:center;gap:14rpx;min-width:0;flex:1}
.job-poster-avatar{display:flex;align-items:center;justify-content:center;width:64rpx;height:64rpx;border-radius:50%;background:#e7f3ed;color:#0b7a55;font-size:26rpx;font-weight:700;line-height:1;flex:none}
.job-poster-name{min-width:0;font-size:26rpx;font-weight:650;color:#303930;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.jobs-page .job-card .job-footer-take .job-take-button{justify-content:center;gap:10rpx;width:auto;min-width:168rpx;max-width:48%;padding:15rpx 22rpx;flex:none;white-space:nowrap}
.job-take-press{opacity:.82;background:rgba(11,122,85,.14)!important;box-shadow:none!important}
.job-footer.own-footer,.job-footer.taken-footer,.job-footer.done-footer{display:block}
.job-footer.own-footer>.hint,.job-footer.taken-footer>.hint{margin:0 0 12rpx;font-size:21rpx;line-height:1.5}
.completed-order-footer{display:flex;align-items:center;justify-content:space-between;gap:16rpx;font-size:21rpx;margin:0}
.completed-order-footer>view{flex:1;min-width:0}
.completed-order-link{flex:none;color:#0b7a55;font-weight:650}
.page-dark.jobs-page{background:radial-gradient(90% 58% at 100% -6%,rgba(11,122,85,.16),transparent 58%),radial-gradient(70% 46% at 0% 16%,rgba(255,255,255,.04),transparent 52%),#1b1c1a}
.page-dark.jobs-page .job-card{border-color:rgba(255,255,255,.12)!important;background:rgba(36,37,34,.92)!important;box-shadow:0 10rpx 28rpx rgba(0,0,0,.3),inset 0 1rpx 0 rgba(255,255,255,.08)!important}
.page-dark.jobs-page .job-card.taken-card{border-color:rgba(111,208,168,.22)!important}
.page-dark.jobs-page .job-card .btn.job-take-button{background:rgba(111,208,168,.16);border-color:rgba(111,208,168,.32);color:#6fd0a8;text-shadow:none;box-shadow:inset 0 1rpx 0 rgba(255,255,255,.08)}
.page-dark.jobs-page .job-card .btn.job-take-continue{background:rgba(111,208,168,.16);border-color:rgba(111,208,168,.32);color:#6fd0a8;box-shadow:inset 0 1rpx 0 rgba(255,255,255,.08)}
.page-dark.jobs-page .job-card .badge.takeout{color:#f0c49a;background:#3a2e22}
.page-dark.jobs-page .job-card .job-footer{border-top-color:rgba(237,235,228,.1)}
.page-dark.jobs-page .job-card .job-price{color:#f4a06e}
.page-dark.jobs-page .job-card .job-route-destination,.page-dark.jobs-page .job-card .hall-locker-value{color:#edebe4}
.page-dark.jobs-page .job-card .job-route-origin,.page-dark.jobs-page .job-card .hall-location-label,.page-dark.jobs-page .job-card .job-note-label,.page-dark.jobs-page .job-card .job-deadline-label{color:#aaaF9f}
.page-dark.jobs-page .job-card .job-timing,.page-dark.jobs-page .job-card .job-badges .state-badge.done-badge,.page-dark.jobs-page .job-card .job-badges .state-badge.own-badge{color:#6fd0a8}
.page-dark.jobs-page .job-card .order-note{background:transparent;color:#b7c0b3}
.page-dark.jobs-page .job-card .job-deadline-value{color:#e0e8dc}
.page-dark.jobs-page .job-card .job-footer{border-top-color:#3a4338}
.page-dark.jobs-page .job-card .completed-order-link{color:#6fd0a8}
.page-dark.jobs-page .job-card .job-poster-avatar{background:#1d2f28;color:#6fd0a8}
.page-dark.jobs-page .job-card .job-poster-name{color:#edebe4}

/* Translucent filter controls share the green palette without solid black fills. */
.filter-row .filter-pill{--filter-ink:#0b7a55;--filter-tint:rgba(11,122,85,.12);--filter-border:rgba(11,122,85,.28);display:inline-flex;align-items:center;justify-content:center;flex:none;border:1rpx solid rgba(255,255,255,.76);border-radius:999rpx;background:rgba(255,255,255,.46);color:#5e5c55;line-height:1.4;box-shadow:inset 0 1rpx 0 rgba(255,255,255,.72),0 3rpx 10rpx rgba(22,24,28,.025);-webkit-backdrop-filter:blur(14rpx);backdrop-filter:blur(14rpx);transition:var(--ue-transition,background .18s ease,border-color .18s ease,color .18s ease)}
.filter-row .filter-pill.selected{background:var(--filter-tint);border-color:var(--filter-border);color:var(--filter-ink);font-weight:700;box-shadow:inset 0 1rpx 0 rgba(255,255,255,.8),0 3rpx 12rpx rgba(11,122,85,.06)}
.filter-row .filter-pill.dorm-male{--filter-ink:#1d4ed8;--filter-tint:rgba(37,99,235,.12);--filter-border:rgba(37,99,235,.3);color:#2563eb}
.filter-row .filter-pill.dorm-female{--filter-ink:#be185d;--filter-tint:rgba(219,39,119,.1);--filter-border:rgba(219,39,119,.28);color:#be185d}
.jobs-page .filter-trigger{background:rgba(255,255,255,.46);border-color:rgba(255,255,255,.76);box-shadow:inset 0 1rpx 0 rgba(255,255,255,.72);-webkit-backdrop-filter:blur(14rpx);backdrop-filter:blur(14rpx)}
.jobs-page .filter-trigger.open{background:rgba(11,122,85,.12);border-color:rgba(11,122,85,.28);color:#0b7a55}
.page-dark .filter-row .filter-pill{--filter-ink:#6fd0a8;--filter-tint:rgba(111,208,168,.14);--filter-border:rgba(111,208,168,.34);background:rgba(237,235,228,.065);border-color:rgba(237,235,228,.14);color:#c2bfb6;box-shadow:inset 0 1rpx 0 rgba(255,255,255,.07)}
.page-dark .filter-row .filter-pill.selected{background:var(--filter-tint);border-color:var(--filter-border);color:var(--filter-ink)}
.page-dark .filter-row .filter-pill.dorm-male{--filter-ink:#93c5fd;--filter-tint:rgba(96,165,250,.16);--filter-border:rgba(147,197,253,.35);color:#93c5fd}
.page-dark .filter-row .filter-pill.dorm-female{--filter-ink:#f9a8d4;--filter-tint:rgba(244,114,182,.14);--filter-border:rgba(249,168,212,.32);color:#f9a8d4}
.page-dark.jobs-page .filter-trigger{background:rgba(237,235,228,.065);border-color:rgba(237,235,228,.14);box-shadow:inset 0 1rpx 0 rgba(255,255,255,.07)}
.page-dark.jobs-page .filter-trigger.open{background:rgba(111,208,168,.14);border-color:rgba(111,208,168,.34)}

/* Lobby delivery explicitly welcomes runners of any gender. */
.jobs-page .job-card .job-badges .badge.lobby-eligible{background:#e7f3ed;color:#0b7a55;font-weight:650}
.page-dark.jobs-page .job-card .job-badges .badge.lobby-eligible{background:#203b30;color:#6fd0a8}

.flow-card.group-ticket{padding:0;overflow:hidden}
.group-head{margin:14rpx 14rpx 4rpx;padding:16rpx 20rpx 20rpx;background:#f0f6ee;border:2rpx dashed #a1bda8;border-radius:28rpx}
.group-label,.group-fold{color:#186244;font-size:24rpx;font-weight:700}
.group-fold{display:flex;align-items:center;gap:10rpx;flex:none;padding:8rpx 14rpx;border-radius:99rpx;background:#e0edde;font-size:22rpx}
.group-chevron{width:10rpx;height:10rpx;border-right:2rpx solid currentColor;border-bottom:2rpx solid currentColor;transform:rotate(225deg) translate(-1rpx,-1rpx)}
.group-chevron.folded{transform:rotate(45deg) translate(-1rpx,-1rpx)}
.group-route,.group-foot,.group-order{display:flex;align-items:center;gap:16rpx}
.group-route{justify-content:space-between;margin:12rpx 0;font-size:30rpx;font-weight:750}
.group-route>view{min-width:0}
.group-route>view>text{color:#526759;font-size:21rpx;font-weight:500}
.group-items,.group-foot{padding:0 26rpx}
.group-order{min-height:88rpx;border-bottom:1rpx solid #dde5df;font-size:25rpx}
.group-check{flex:none;width:34rpx;height:34rpx;border:2rpx solid #99ada0;border-radius:8rpx;text-align:center;line-height:30rpx}
.group-check.on{background:#196345;color:white;border-color:#196345}
.group-fee{margin-left:auto;white-space:nowrap;font-weight:750}
.group-foot{justify-content:space-between;padding-top:16rpx;padding-bottom:16rpx}
.group-foot>view{flex:1;min-width:0}
.group-foot button.group-take{flex:0 0 auto;width:auto;min-width:0;max-width:52%;margin:0;padding:14rpx 24rpx;font-size:26rpx}
.page-dark .group-fold{background:#324a39}
.page-dark .group-head{background:#263a2c;border-color:#567361}
.page-dark .group-label,.page-dark .group-fold,.page-dark .group-route>view>text{color:#a5d7b9}

/* ---- Cleaner Jobs cards, 2026-11 (design/jobs-orders-preview) ---- */
.nj-tile{display:block;flex:none;width:84rpx;height:84rpx;padding:11rpx;box-sizing:border-box;border-radius:26rpx;background:linear-gradient(160deg,#fbfaf6,#efede6);box-shadow:inset 0 3rpx 0 rgba(255,255,255,.9),inset 0 -3rpx 0 rgba(22,24,28,.04),0 6rpx 12rpx rgba(22,24,28,.07)}
.nj-tile.sm{width:76rpx;height:76rpx;border-radius:24rpx}

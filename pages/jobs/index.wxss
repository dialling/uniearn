/* Translucent filter controls share the green palette without solid black fills. */
.filter-row .filter-pill{--filter-ink:#0b7a55;--filter-tint:rgba(11,122,85,.12);--filter-border:rgba(11,122,85,.28);display:inline-flex;align-items:center;justify-content:center;flex:none;border:1rpx solid rgba(255,255,255,.76);border-radius:999rpx;background:rgba(255,255,255,.46);color:#5e5c55;line-height:1.4;box-shadow:inset 0 1rpx 0 rgba(255,255,255,.72),0 3rpx 10rpx rgba(22,24,28,.025);-webkit-backdrop-filter:blur(14rpx);backdrop-filter:blur(14rpx);transition:var(--ue-transition,background .18s ease,border-color .18s ease,color .18s ease)}
.filter-row .filter-pill.selected{background:var(--filter-tint);border-color:var(--filter-border);color:var(--filter-ink);font-weight:700;box-shadow:inset 0 1rpx 0 rgba(255,255,255,.8),0 3rpx 12rpx rgba(11,122,85,.06)}
.filter-row .filter-pill.dorm-male{--filter-ink:#1d4ed8;--filter-tint:rgba(37,99,235,.12);--filter-border:rgba(37,99,235,.3);color:#2563eb}
.filter-row .filter-pill.dorm-female{--filter-ink:#be185d;--filter-tint:rgba(219,39,119,.1);--filter-border:rgba(219,39,119,.28);color:#be185d}
.jobs-page .filter-trigger{background:rgba(255,255,255,.46);border-color:rgba(255,255,255,.76);box-shadow:inset 0 1rpx 0 rgba(255,255,255,.72);-webkit-backdrop-filter:blur(14rpx);backdrop-filter:blur(14rpx)}
.jobs-page .filter-trigger.open{background:rgba(11,122,85,.12);border-color:rgba(11,122,85,.28);color:#0b7a55}
.page-dark .filter-row .filter-pill{--filter-ink:#6fd0a8;--filter-tint:rgba(111,208,168,.14);--filter-border:rgba(111,208,168,.34);background:rgba(237,235,228,.065);border-color:rgba(237,235,228,.14);color:#c2bfb6;box-shadow:inset 0 1rpx 0 rgba(255,255,255,.07)}
.page-dark .filter-row .filter-pill.selected{background:var(--filter-tint);border-color:var(--filter-border);color:var(--filter-ink)}
.page-dark .filter-row .filter-pill.dorm-male{--filter-ink:#93c5fd;--filter-tint:rgba(96,165,250,.16);--filter-border:rgba(147,197,253,.35);color:#93c5fd}
.page-dark .filter-row .filter-pill.dorm-female{--filter-ink:#f9a8d4;--filter-tint:rgba(244,114,182,.14);--filter-border:rgba(249,168,212,.32);color:#f9a8d4}
.page-dark.jobs-page .filter-trigger{background:rgba(237,235,228,.065);border-color:rgba(237,235,228,.14);box-shadow:inset 0 1rpx 0 rgba(255,255,255,.07)}
.page-dark.jobs-page .filter-trigger.open{background:rgba(111,208,168,.14);border-color:rgba(111,208,168,.34)}

/* Lobby delivery explicitly welcomes runners of any gender. */
.jobs-page .job-card .job-badges .badge.lobby-eligible{background:#e7f3ed;color:#0b7a55;font-weight:650}
.page-dark.jobs-page .job-card .job-badges .badge.lobby-eligible{background:#203b30;color:#6fd0a8}

.flow-card.group-ticket{padding:0;overflow:hidden}
.group-head{margin:14rpx 14rpx 4rpx;padding:16rpx 20rpx 20rpx;background:#f0f6ee;border:2rpx dashed #a1bda8;border-radius:28rpx}
.group-label,.group-fold{color:#186244;font-size:24rpx;font-weight:700}
.group-fold{display:flex;align-items:center;gap:10rpx;flex:none;padding:8rpx 14rpx;border-radius:99rpx;background:#e0edde;font-size:22rpx}
.group-chevron{width:10rpx;height:10rpx;border-right:2rpx solid currentColor;border-bottom:2rpx solid currentColor;transform:rotate(225deg) translate(-1rpx,-1rpx)}
.group-chevron.folded{transform:rotate(45deg) translate(-1rpx,-1rpx)}
.group-route,.group-foot,.group-order{display:flex;align-items:center;gap:16rpx}
.group-route{justify-content:space-between;margin:12rpx 0;font-size:30rpx;font-weight:750}
.group-route>view{min-width:0}
.group-route>view>text{color:#526759;font-size:21rpx;font-weight:500}
.group-items,.group-foot{padding:0 26rpx}
.group-order{min-height:88rpx;border-bottom:1rpx solid #dde5df;font-size:25rpx}
.group-check{flex:none;width:34rpx;height:34rpx;border:2rpx solid #99ada0;border-radius:8rpx;text-align:center;line-height:30rpx}
.group-check.on{background:#196345;color:white;border-color:#196345}
.group-fee{margin-left:auto;white-space:nowrap;font-weight:750}
.group-foot{justify-content:space-between;padding-top:16rpx;padding-bottom:16rpx}
.group-foot>view{flex:1;min-width:0}
.group-foot button.group-take{flex:0 0 auto;width:auto;min-width:0;max-width:52%;margin:0;padding:14rpx 24rpx;font-size:26rpx}
.page-dark .group-fold{background:#324a39}
.page-dark .group-head{background:#263a2c;border-color:#567361}
.page-dark .group-label,.page-dark .group-fold,.page-dark .group-route>view>text{color:#a5d7b9}

.group-title-row{display:flex;align-items:flex-start;justify-content:space-between;gap:18rpx}
.group-title-row .group-label{flex:1;min-width:0;padding-top:8rpx;line-height:1.5}
.group-total{flex:none;display:flex;flex-direction:column;align-items:flex-end;max-width:60%}
.group-total-label{font-size:20rpx;color:#74766b;line-height:1.4;margin-bottom:3rpx}
.group-total-amount{color:#c4470b;font-size:46rpx;font-weight:850;line-height:1.15;letter-spacing:-1rpx;white-space:nowrap}
.group-total-currency{font-size:27rpx;font-weight:650;letter-spacing:0;margin-right:2rpx}
.group-fold-row{display:flex;justify-content:flex-end;margin-top:10rpx}
.page-dark .group-total-label{color:#b5bbaf}
.page-dark .group-total-amount{color:#f4a06e}
.jobs-page .job-card .job-badges .task-mode-badge{font-size:18rpx;padding:4rpx 9rpx;font-weight:600}.jobs-page .task-mode-online{background:#e8f4ee;color:#27734e}.jobs-page .task-mode-offline{background:#f0eee8;color:#685f4e}.page-dark.jobs-page .task-mode-online{background:#243c30;color:#91d3ac}.page-dark.jobs-page .task-mode-offline{background:#39362f;color:#d8ceba}
/* Give long locker names the full route width. */

.tracked-orders{margin:18rpx 0 24rpx;padding:10rpx 24rpx 4rpx;background:#f7fbf7;border:1rpx solid #dbe8dc;border-radius:24rpx}.tracked-orders-heading{display:flex;justify-content:space-between;align-items:center;gap:12rpx;color:#41664b;font-size:24rpx;font-weight:700}.tracked-orders-heading button{min-height:44px;margin:0;padding:12rpx 0 12rpx 18rpx;background:none;color:#41664b;font-size:21rpx;line-height:1.5;font-weight:600}.tracked-orders-heading button::after{border:0}.tracked-order-row{display:flex;align-items:center;gap:18rpx;min-height:44px;padding:18rpx 0;border-top:1rpx solid #e4ece2}.tracked-order-copy{flex:1;min-width:0}.tracked-order-title{font-size:25rpx;line-height:1.5;font-weight:650;color:#263a2d;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.tracked-order-status{font-size:21rpx;color:#497557;margin-top:4rpx}.tracked-order-chevron{font-size:32rpx;color:#7c987d}.page-dark .tracked-orders{background:#24352c;border-color:#3d5141}.page-dark .tracked-order-row{border-color:#3d5141}.page-dark .tracked-order-title{color:#e1ebe2}.page-dark .tracked-order-status,.page-dark .tracked-orders-heading,.page-dark .tracked-orders-heading button{color:#a2cead}

/* 大厅标题：星光环绕 */
.hall-title-wrap{position:relative;display:inline-block;padding:0 8rpx}
.hall-spark{position:absolute;color:#0b7a55;opacity:.55;line-height:1}
.hall-spark.s1{top:-18rpx;right:-14rpx;font-size:24rpx}
.hall-spark.s2{bottom:-12rpx;left:-18rpx;font-size:16rpx;opacity:.4}
.hall-spark.s3{top:4rpx;left:-30rpx;font-size:13rpx;opacity:.32}
/* 卡片状态胶囊 */
.job-head-side{display:flex;flex-direction:column;align-items:flex-end;gap:8rpx;flex:none}
.state-pill{font-size:21rpx;font-weight:700;line-height:1.5;padding:6rpx 18rpx;border-radius:24rpx;background:#e7f3ed;color:#0b7a55;white-space:nowrap}
.state-pill.taken{background:#d8efe1;color:#08603f}
.state-pill.done{background:#202522;color:#fff}
.state-pill.own{background:#eef1ec;color:#56685b}
.state-pill.fresh{background:#e7f3ed;color:#0b7a55}
/* 卡片头部浅色带，让栏目框更像票根 */
.job-card-header{margin:-8rpx -8rpx 14rpx;padding:12rpx;border-radius:20rpx;background:linear-gradient(90deg,#f3f9f4,#ffffff)}
.page-dark .hall-spark{color:#8fc9ae;opacity:.5}
.page-dark .job-card-header{background:linear-gradient(90deg,#2b332d,#242522)}
.page-dark .state-pill{background:#2f3a33;color:#bfe3cc}
.page-dark .state-pill.taken{background:#33503f;color:#d4f0df}
.page-dark .state-pill.done{background:#e7f3ed;color:#202522}
.page-dark .state-pill.own{background:#333a34;color:#c9d3cb}

/* 参考稿风格：头像 + 大胶囊 + 赏金行 */
.job-avatar{width:64rpx;height:64rpx;border-radius:50%;background:#eef6f0;flex:none}
.job-card-header{align-items:flex-start}
.state-pill{font-size:24rpx;font-weight:800;line-height:1.4;padding:10rpx 26rpx;border-radius:999rpx;background:#c9f06a;color:#23310f}
.state-pill.open{background:#c9f06a;color:#23310f}
.state-pill.taken{background:#a6e86a;color:#1d2a12}
.state-pill.done{background:#1f2420;color:#ffffff}
.state-pill.own{background:#e6ece7;color:#4d5c52}
.state-pill.fresh{background:#c9f06a;color:#23310f}
.job-reward{display:flex;align-items:center;gap:12rpx;margin:14rpx 0 4rpx}
.reward-tag{width:44rpx;height:44rpx;border-radius:12rpx;background:#fde8e4;color:#c0392b;font-size:24rpx;font-weight:800;display:flex;align-items:center;justify-content:center}
.reward-amount{color:#e03131;font-size:38rpx;font-weight:800}
.page-dark .state-pill{background:#c9f06a;color:#23310f}
.page-dark .state-pill.taken{background:#a6e86a;color:#1d2a12}
.page-dark .state-pill.done{background:#f2f5f2;color:#202522}
.page-dark .state-pill.own{background:#333a34;color:#c9d3cb}
.page-dark .job-reward .reward-tag{background:#3a2523;color:#ff9b8f}
.page-dark .reward-amount{color:#ff8b80}

/* 头部：类型胶囊 + 截止时间 */
.job-head-main{flex:1;min-width:0;display:flex;flex-direction:column;gap:6rpx}
.type-chip{align-self:flex-start;background:#c9f06a;color:#23310f;font-size:22rpx;font-weight:800;padding:4rpx 16rpx;border-radius:999rpx;line-height:1.5}
.head-deadline{color:#8a9488;font-size:21rpx}
.job-badges{gap:8rpx;flex-wrap:wrap}
/* 路线框：灰底 + 起/送标签 */
.job-route-box{display:flex;align-items:center;flex-wrap:wrap;gap:10rpx;background:#f4f6f3;border-radius:16rpx;padding:16rpx 18rpx;margin-top:6rpx}
.route-tag{width:36rpx;height:36rpx;border-radius:8rpx;font-size:19rpx;font-weight:800;display:flex;align-items:center;justify-content:center;flex:none}
.route-tag.from{background:#2f3430;color:#fff}
.route-tag.to{background:#3fae6a;color:#fff}
.page-dark .type-chip{background:#c9f06a;color:#23310f}
.page-dark .head-deadline{color:#a9b3a7}
.page-dark .job-route-box{background:#2b332d}

/* 标题再放大 + 手绘弧线，贴近参考稿 */
.jobs-header .flow-title{font-size:48rpx;font-weight:800;letter-spacing:1rpx;color:#14251b}
.hall-spark.s1{font-size:28rpx;opacity:.7}
.hall-spark.s2{font-size:18rpx;opacity:.5}
/* 卡片头部整条淡黄绿底，参考稿的票根头 */
.job-card-header{margin:-26rpx -26rpx 16rpx;padding:18rpx 22rpx;border-radius:26rpx 26rpx 0 0;background:#f7fbe9}
.page-dark .jobs-header .flow-title{color:#edf1ed}
.page-dark .job-card-header{background:#2b3327}

/* 类型胶囊与状态胶囊：改用主题绿，并加从左到右渐变 */
.type-chip{background:linear-gradient(90deg,#0b7a55 0%,#16a273 100%);color:#fff;border:none}
.state-pill.open,.state-pill.fresh,.state-pill.taken{background:linear-gradient(90deg,#0b7a55 0%,#16a273 100%);color:#fff}
.state-pill.own{background:linear-gradient(90deg,#4a6b58 0%,#6f917c 100%);color:#fff}
.state-pill.done{background:linear-gradient(90deg,#1b211d 0%,#39423b 100%);color:#fff}
.page-dark .type-chip{background:linear-gradient(90deg,#0e8a60 0%,#1cb37e 100%);color:#04120b}
.page-dark .state-pill.open,.page-dark .state-pill.fresh,.page-dark .state-pill.taken{background:linear-gradient(90deg,#0e8a60 0%,#1cb37e 100%);color:#04120b}
.page-dark .state-pill.done{background:linear-gradient(90deg,#e9efea 0%,#c9d6cc 100%);color:#202522}

.hall-title-wrap{position:relative;display:inline-block;padding:0}
.hall-spark{display:none}
.jobs-header .flow-title{position:relative;z-index:1;font-size:48rpx;font-weight:900;letter-spacing:2rpx;line-height:1.15;color:#14251b;text-shadow:0 4rpx 12rpx rgba(11,122,85,.12)}
.page-dark .jobs-header .flow-title{color:#edf1ed;text-shadow:0 4rpx 14rpx rgba(0,0,0,.35)}
.page-dark 
/* 栏目主标题：左侧渐变小竖条 + 柔光 */
.hall-title-accent{width:12rpx;height:52rpx;border-radius:8rpx;background:linear-gradient(180deg,#16a273 0%,#0b7a55 100%);box-shadow:0 4rpx 12rpx rgba(11,122,85,.28);flex:none}
.page-dark .hall-title-accent{background:linear-gradient(180deg,#2ecf96 0%,#16a273 100%)}

/* 主标题：左侧渐变小竖条（伪元素，避免额外节点） */

/* Hallmark · 标题印记：双色字 + 渐隐细线，无多余装饰 */
page{--hall-ink:#123024;--hall-ink-soft:#1aa273;--hall-rule:rgba(11,122,85,.35)}
.hall-mark{display:flex;align-items:baseline;flex-wrap:nowrap;font-size:54rpx;font-weight:800;line-height:1.1;letter-spacing:0;color:var(--hall-ink);text-shadow:none}
.hall-mark-a{color:var(--hall-ink)}
.hall-mark-b{color:var(--hall-ink-soft);margin-left:2rpx}
.page-dark{--hall-ink:#eaf3ee;--hall-ink-soft:#3ecf99;--hall-rule:rgba(62,207,153,.4)}

/* 字标胶囊：渐变底 + 白字 + 内描边 + 右上角小星 */
.hall-title-wrap{position:relative;display:inline-block;padding:4rpx 0}
.hall-mark{display:inline-flex;align-items:center;padding:10rpx 30rpx;border-radius:999rpx;background:linear-gradient(100deg,#0b7a55 0%,#18ad79 100%);color:#fff;font-size:44rpx;font-weight:800;letter-spacing:3rpx;line-height:1.18;box-shadow:0 10rpx 24rpx rgba(11,122,85,.28),inset 0 0 0 3rpx rgba(255,255,255,.22);position:relative}
.hall-title-wrap::after{content:"✦";position:absolute;right:-14rpx;top:-18rpx;font-size:26rpx;line-height:1;color:#f0b429;text-shadow:0 2rpx 6rpx rgba(0,0,0,.12)}
.page-dark .hall-mark{background:linear-gradient(100deg,#12956a 0%,#2fd39b 100%);color:#04120b;box-shadow:0 10rpx 24rpx rgba(0,0,0,.35),inset 0 0 0 3rpx rgba(255,255,255,.18)}

/* 覆盖 .jobs-header .flow-title 的字色，保证胶囊内是白字 */
.jobs-header .hall-mark{color:#fff;text-shadow:0 2rpx 4rpx rgba(4,40,26,.25)}
.page-dark .jobs-header .hall-mark{color:#04120b;text-shadow:none}

/* 胶囊配色改为浅薄荷，和奶油底、白卡片同一明度带 */
.jobs-header .hall-mark{background:linear-gradient(100deg,#e9f7f0 0%,#d3eddf 100%);color:#0b5f43;box-shadow:0 6rpx 16rpx rgba(11,122,85,.10),inset 0 0 0 2rpx rgba(11,122,85,.10);text-shadow:none}
.page-dark .jobs-header .hall-mark{background:linear-gradient(100deg,#1e3a2e 0%,#26503e 100%);color:#cfeee0;box-shadow:0 6rpx 16rpx rgba(0,0,0,.3),inset 0 0 0 2rpx rgba(207,238,224,.12)}
.hall-title-wrap::after{color:#d9a12b}

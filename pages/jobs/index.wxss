@import "../../utils/flow.wxss";
.jobs-page{padding:0 0 160rpx;background:#eeede8}.jobs-header{background:#fff;padding:28rpx 42rpx 18rpx}.jobs-header .flow-title{margin:0;font-size:38rpx}.jobs-header .flow-sub{margin:6rpx 0 0}.filter-trigger{display:flex;align-items:center;gap:10rpx;border:1rpx solid #deddd8;border-radius:50rpx;padding:14rpx 25rpx;white-space:nowrap;font-size:26rpx;color:#202126}.filter-trigger.open{border-color:#202126}.filter-icon{font-size:35rpx;line-height:25rpx;transform:rotate(180deg)}.filter-panel{margin-top:26rpx}.filter-row{display:flex;align-items:center;min-width:0;gap:14rpx;margin:12rpx 0}.filter-name{width:77rpx;flex:none;font-size:23rpx;font-weight:750;color:#474742}.filter-row .scroll-pills{flex:1;width:0;margin:0}.filter-row .pill{font-size:23rpx;padding:13rpx 20rpx}.clear-filter{text-align:right;font-size:23rpx;margin:10rpx 0 0}.jobs-content{padding:20rpx 40rpx 0}.jobs-hint{color:#777771;font-size:24rpx;line-height:1.55;margin:6rpx 0 26rpx}.jobs-page .flow-card{margin:20rpx 0;padding:27rpx}.jobs-page .flow-card .btn{width:100%;margin:18rpx 0 0}.jobs-page .amount{font-size:40rpx}.jobs-page .route{font-size:30rpx}.jobs-page .green-note{padding:20rpx}.jobs-page .badge{font-size:21rpx}

.jobs-page .own-post{border:2rpx dashed #b44b22}.jobs-page .taken-card{border:1rpx dashed #d6d5ce;background:#f8f8f5}.jobs-page .done-card{border-color:#b1cebf}.jobs-page .own-badge{background:#b44b22;color:#fff}.jobs-page .done-badge{background:#41775b;color:#fff}.jobs-page .taken-badge{background:#fbefe5;color:#843e27}.jobs-page .badge.takeout{background:#fbefe5;color:#873766}.jobs-page .badge.parcel{background:#eceef8;color:#454d7d}.jobs-page .badge.task{background:#e8edff;color:#3545af}.job-timing{padding:22rpx;background:#f3f3ef;border-radius:20rpx;margin:20rpx 0;font-size:24rpx;font-weight:700;color:#54554d}.taken-card .job-timing{background:#eae9e3}.done-card .job-timing{background:#e8f3ed;color:#41775b}.jobs-page .own-order{background:#fcf0e5;color:#833f28}.done-proof{border-radius:27rpx;padding:30rpx;background:#41775b;color:#fff;font-size:22rpx;line-height:1.55;margin:24rpx 0}.proof-count{font-weight:700;margin:20rpx 0}.proof-count text{font-size:60rpx;margin-right:15rpx}.date-heading{font-size:25rpx;font-weight:700;margin:28rpx 4rpx 0}.date-heading .hint{font-weight:400}

.guide-modal{top:16%;max-height:calc(100vh - 210rpx);overflow-y:auto;box-sizing:border-box}.guide-modal.bottom-modal{top:auto;bottom:190rpx;max-height:calc(100vh - 230rpx)}.guide-modal .guide-text{font-size:25rpx;line-height:1.6}.guide-example{border:2rpx dashed #b1cebf;border-radius:22rpx;padding:22rpx;margin:18rpx 0}.guide-example .route{margin:16rpx 0;font-size:27rpx}.example-button{pointer-events:none;text-align:center}.guide-complete{position:fixed;bottom:180rpx;left:26rpx;right:26rpx;z-index:100;background:#16181c;color:#fff;padding:24rpx;border-radius:24rpx;font-size:25rpx;line-height:1.5}.empty-reminder{margin-top:22rpx}.jobs-page .empty-post{background:#ad4821;width:auto;padding:0 40rpx;display:flex;align-items:center;justify-content:center;min-height:88rpx;line-height:1.2}.nav .item text{white-space:nowrap}

@keyframes guide-spot-in{from{transform:scale(1.35)}to{transform:scale(1)}}
@keyframes guide-ring{0%{opacity:.85;transform:scale(1)}80%,100%{opacity:0;transform:scale(1.22)}}
@keyframes guide-modal-in{0%{opacity:0;transform:translate3d(0,40rpx,0) scale(.96)}70%{opacity:1;transform:translate3d(0,-4rpx,0) scale(1.005)}100%{opacity:1;transform:translate3d(0,0,0) scale(1)}}
@keyframes guide-from-right{from{opacity:0;transform:translate3d(40rpx,0,0)}to{opacity:1;transform:translate3d(0,0,0)}}
@keyframes guide-from-left{from{opacity:0;transform:translate3d(-40rpx,0,0)}to{opacity:1;transform:translate3d(0,0,0)}}
@keyframes guide-yuni-in{0%{opacity:0;transform:translate3d(0,24rpx,0) scale(.7) rotate(-8deg)}60%{opacity:1;transform:translate3d(0,-6rpx,0) scale(1.08) rotate(3deg)}100%{opacity:1;transform:translate3d(0,0,0) scale(1) rotate(0)}}
@keyframes guide-float{0%,100%{transform:translate3d(0,0,0)}50%{transform:translate3d(0,-8rpx,0)}}
@keyframes guide-toast-in{from{opacity:0;transform:translate3d(0,40rpx,0)}to{opacity:1;transform:translate3d(0,0,0)}}
.guide-shade{z-index:100}
.guide-focus{z-index:100;transition:top .42s cubic-bezier(.3,.9,.25,1),left .42s cubic-bezier(.3,.9,.25,1),width .42s cubic-bezier(.3,.9,.25,1),height .42s cubic-bezier(.3,.9,.25,1);animation:guide-spot-in .45s cubic-bezier(.3,.9,.25,1) backwards}
.guide-ring{position:absolute;left:-4rpx;top:-4rpx;right:-4rpx;bottom:-4rpx;border:4rpx solid #fff;border-radius:29rpx;animation:guide-ring 1.8s ease-out .45s infinite}
.guide-blocker{position:fixed;left:0;top:0;right:0;bottom:0;z-index:101}
.guide-modal{z-index:102;box-shadow:0 20rpx 50rpx rgba(0,0,0,.18);animation:guide-modal-in .46s cubic-bezier(.22,.9,.3,1) backwards}
.guide-step{animation:guide-from-right .34s cubic-bezier(.22,.8,.3,1) backwards}
.guide-step.from-left{animation-name:guide-from-left}
.guide-step .guide-body image{animation:guide-yuni-in .6s cubic-bezier(.3,1.3,.5,1) .06s backwards,guide-float 3.2s ease-in-out .7s infinite}
.guide-progress{display:flex;align-items:center;gap:16rpx}
.guide-progress .hint{margin:0}
.guide-dots{display:flex;align-items:center;gap:8rpx}
.guide-dot{width:12rpx;height:12rpx;border-radius:12rpx;background:#deded7;transition:width .32s cubic-bezier(.3,.9,.25,1),background-color .32s ease,opacity .32s ease}
.guide-dot.past{background:#41775b;opacity:.4}
.guide-dot.on{width:36rpx;background:#41775b}
.guide-modal .action-row .btn{transition:transform .16s ease,opacity .16s ease}
.guide-complete{animation:guide-toast-in .4s cubic-bezier(.22,.9,.3,1.15) backwards}

.order-toggle-row{margin:20rpx 0;gap:16rpx}.order-toggle{flex:none;font-size:24rpx;font-weight:700;color:#55574f;padding:12rpx 0 12rpx 24rpx}.selectable-order{display:flex;align-items:center;gap:18rpx;padding:22rpx;border:1rpx solid #e4e4de;border-radius:20rpx;background:#fafaf7;margin:12rpx 0}.order-check{flex:none;width:34rpx;height:34rpx;border:2rpx solid #c7c7bd;border-radius:50%;background:white;display:flex;align-items:center;justify-content:center;color:white;font-size:23rpx}.order-check.checked{background:#41775b;border-color:#41775b}.order-summary{flex:1;min-width:0}.order-summary .hint{margin:6rpx 0 0}.individual-parcels{display:block;color:#41775b;text-align:center;font-size:23rpx;padding:18rpx 0 0}.jobs-page .btn[disabled]{background:#e5e5df;color:#999a91}
.order-note{margin-top:6rpx;padding:8rpx 14rpx;border-radius:12rpx;background:#f6f5f1;color:#5e5d57;font-size:23rpx;line-height:1.45;word-break:break-all}.page-dark .order-note{background:#2c332f;color:#c3c9c4}

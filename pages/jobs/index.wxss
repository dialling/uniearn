@import "../../utils/flow.wxss";
.jobs-page{padding:0 0 160rpx;background:#eeede8}.jobs-header{background:transparent;padding:28rpx 42rpx 18rpx}.jobs-header .flow-title{margin:0;font-size:38rpx}.jobs-header .flow-sub{margin:6rpx 0 0}.filter-trigger{display:flex;align-items:center;gap:10rpx;border:1rpx solid #e2e0d9;border-radius:50rpx;padding:14rpx 25rpx;white-space:nowrap;font-size:26rpx;color:#16181c}.filter-trigger.open{border-color:#0b7a55;color:#0b7a55;background:#f4faf7}.filter-icon{font-size:35rpx;line-height:25rpx;transform:rotate(180deg)}.filter-panel{margin-top:26rpx}.category-scroll{width:100%;white-space:nowrap}.category-track{display:inline-flex;gap:18rpx;padding:2rpx 4rpx 10rpx}.category-pill{flex:none;box-sizing:border-box;min-height:80rpx;padding:0 30rpx;border:2rpx solid #dcdcd8;border-radius:42rpx;background:#fff;color:#363733;font-size:26rpx;font-weight:650;display:flex;align-items:center;justify-content:center}.category-pill.selected{background:#0b7a55;border-color:#0b7a55;color:#fff;box-shadow:0 8rpx 20rpx rgba(11,122,85,.17)}.quick-filter-row{display:flex;gap:18rpx;margin:16rpx 0}.quick-picker{flex:1;min-width:0}.quick-filter{height:86rpx;padding:0 22rpx;border-radius:43rpx;background:#e3e2dd;color:#3f403c;display:flex;align-items:center;gap:12rpx;font-size:25rpx;font-weight:650}.quick-filter>text:nth-child(2){flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.quick-icon{font-size:34rpx;line-height:1}.quick-arrow{font-size:30rpx;line-height:1}.gender-filter{display:flex;align-items:center;gap:18rpx;margin-top:18rpx}.gender-label{flex:none;font-size:24rpx;font-weight:700;color:#565650}.gender-options{display:flex;gap:12rpx}.gender-pill{padding:12rpx 24rpx;border:1rpx solid #dcdcd8;border-radius:30rpx;background:#fff;color:#0b7a55;font-size:23rpx}.gender-pill.selected{background:#0b7a55;border-color:#0b7a55;color:#fff}.building-picker{margin-top:16rpx}.building-filter{height:68rpx;box-sizing:border-box;padding:0 24rpx;border:1rpx solid #d9d8d2;border-radius:34rpx;background:#f8f8f5;color:#555650;display:flex;align-items:center;justify-content:space-between;font-size:23rpx}.clear-filter{text-align:right;font-size:23rpx;margin:14rpx 4rpx 0}.page-dark .category-pill,.page-dark .gender-pill,.page-dark .building-filter{background:#242522;border-color:#3a3b37;color:#edebe4}.page-dark .category-pill.selected,.page-dark .gender-pill.selected{background:#0b7a55;border-color:#0b7a55;color:#fff}.page-dark .quick-filter{background:#30312e;color:#edebe4}.jobs-content{padding:20rpx 40rpx 0}.jobs-hint{color:#6b6860;font-size:24rpx;line-height:1.55;margin:6rpx 0 26rpx}.jobs-page .flow-card{margin:20rpx 0;padding:27rpx}.jobs-page .flow-card .btn{width:100%;margin:18rpx 0 0}.jobs-page .amount{font-size:40rpx}.jobs-page .route{font-size:30rpx}.jobs-page .green-note{padding:20rpx}.jobs-page .badge{font-size:21rpx}

.jobs-page .own-post{border:2rpx dashed #0b7a55}.jobs-page .taken-card{border:1rpx dashed #e2e0d9;background:#f7f6f2}.jobs-page .done-card{border-color:#cfe8dc}.jobs-page .own-badge{background:#0b7a55;color:#fff}.jobs-page .done-badge{background:#0b7a55;color:#fff}.jobs-page .taken-badge{background:#e7f3ed;color:#0b7a55}.jobs-page .badge.takeout{background:#e7f3ed;color:#8e3b6e}.jobs-page .badge.parcel{background:#e6edfc;color:#1e40af}.jobs-page .badge.task{background:#e6edfc;color:#1d4ed8}.job-timing{padding:22rpx;background:#f7f6f2;border-radius:20rpx;margin:20rpx 0;font-size:24rpx;font-weight:700;color:#44423c}.taken-card .job-timing{background:#f0eee8}.done-card .job-timing{background:#e7f3ed;color:#0b7a55}.jobs-page .own-order{background:#f3faf6;color:#0b7a55}.done-proof{border-radius:27rpx;padding:30rpx;background:#0b7a55;color:#fff;font-size:22rpx;line-height:1.55;margin:24rpx 0}.proof-count{font-weight:700;margin:20rpx 0}.proof-count text{font-size:60rpx;margin-right:15rpx}.date-heading{font-size:25rpx;font-weight:700;margin:28rpx 4rpx 0}.date-heading .hint{font-weight:400}

.guide-modal{top:16%;max-height:calc(100vh - 210rpx);overflow-y:auto;box-sizing:border-box}.guide-modal.bottom-modal{top:auto;bottom:190rpx;max-height:calc(100vh - 230rpx)}.guide-modal .guide-text{font-size:25rpx;line-height:1.6}.guide-example{border:2rpx dashed #6fd0a8;border-radius:22rpx;padding:22rpx;margin:18rpx 0}.guide-example .route{margin:16rpx 0;font-size:27rpx}.example-button{pointer-events:none;text-align:center}.guide-complete{position:fixed;bottom:180rpx;left:26rpx;right:26rpx;z-index:100;background:#16181c;color:#fff;padding:24rpx;border-radius:24rpx;font-size:25rpx;line-height:1.5}.empty-reminder{margin-top:22rpx}.jobs-page .empty-post{background:#0b7a55;width:auto;padding:0 40rpx;display:flex;align-items:center;justify-content:center;min-height:88rpx;line-height:1.2}.nav .item text{white-space:nowrap}

@keyframes guide-spot-in{from{transform:scale(1.35)}to{transform:scale(1)}}
@keyframes guide-ring{0%{opacity:.85;transform:scale(1)}80%,100%{opacity:0;transform:scale(1.22)}}
@keyframes guide-modal-in{0%{opacity:0;transform:translate3d(0,40rpx,0) scale(.96)}70%{opacity:1;transform:translate3d(0,-4rpx,0) scale(1.005)}100%{opacity:1;transform:translate3d(0,0,0) scale(1)}}
@keyframes guide-from-right{from{opacity:0;transform:translate3d(40rpx,0,0)}to{opacity:1;transform:translate3d(0,0,0)}}
@keyframes guide-from-left{from{opacity:0;transform:translate3d(-40rpx,0,0)}to{opacity:1;transform:translate3d(0,0,0)}}
@keyframes guide-yuni-in{0%{opacity:0;transform:translate3d(0,24rpx,0) scale(.7) rotate(-8deg)}60%{opacity:1;transform:translate3d(0,-6rpx,0) scale(1.08) rotate(3deg)}100%{opacity:1;transform:translate3d(0,0,0) scale(1) rotate(0)}}
@keyframes guide-float{0%,100%{transform:translate3d(0,0,0)}50%{transform:translate3d(0,-8rpx,0)}}
@keyframes guide-toast-in{from{opacity:0;transform:translate3d(0,40rpx,0)}to{opacity:1;transform:translate3d(0,0,0)}}
.guide-shade{z-index:100}
.guide-focus{z-index:100;transition:top .42s cubic-bezier(.3,.9,.25,1),left .42s cubic-bezier(.3,.9,.25,1),width .42s cubic-bezier(.3,.9,.25,1),height .42s cubic-bezier(.3,.9,.25,1);animation:guide-spot-in .45s cubic-bezier(.3,.9,.25,1) backwards}
.guide-ring{position:absolute;left:-4rpx;top:-4rpx;right:-4rpx;bottom:-4rpx;border:4rpx solid #fff;border-radius:29rpx;animation:guide-ring 1.8s ease-out .45s infinite}
.guide-blocker{position:fixed;left:0;top:0;right:0;bottom:0;z-index:101}
.guide-modal{z-index:102;box-shadow:0 20rpx 50rpx rgba(22,24,28,.18);animation:guide-modal-in .46s cubic-bezier(.22,.9,.3,1) backwards}
.guide-step{animation:guide-from-right .34s cubic-bezier(.22,.8,.3,1) backwards}
.guide-step.from-left{animation-name:guide-from-left}
.guide-step .guide-body image{animation:guide-yuni-in .6s cubic-bezier(.3,1.3,.5,1) .06s backwards,guide-float 3.2s ease-in-out .7s infinite}
.guide-progress{display:flex;align-items:center;gap:16rpx}
.guide-progress .hint{margin:0}
.guide-dots{display:flex;align-items:center;gap:8rpx}
.guide-dot{width:12rpx;height:12rpx;border-radius:12rpx;background:#e2e0d9;transition:width .32s cubic-bezier(.3,.9,.25,1),background-color .32s ease,opacity .32s ease}
.guide-dot.past{background:#0b7a55;opacity:.4}
.guide-dot.on{width:36rpx;background:#0b7a55}
.guide-modal .action-row .btn{transition:transform .16s ease,opacity .16s ease}
.guide-complete{animation:guide-toast-in .4s cubic-bezier(.22,.9,.3,1.15) backwards}

.order-toggle-row{margin:20rpx 0;gap:16rpx}.order-toggle{flex:none;font-size:24rpx;font-weight:700;color:#44423c;padding:12rpx 0 12rpx 24rpx}.selectable-order{display:flex;align-items:center;gap:18rpx;padding:22rpx;border:1rpx solid #e4e1d8;border-radius:20rpx;background:#fafaf7;margin:12rpx 0}.order-check{flex:none;width:34rpx;height:34rpx;border:2rpx solid #d6d2c6;border-radius:50%;background:white;display:flex;align-items:center;justify-content:center;color:white;font-size:23rpx}.order-check.checked{background:#0b7a55;border-color:#0b7a55}.order-summary{flex:1;min-width:0}.order-summary .hint{margin:6rpx 0 0}.individual-parcels{display:block;color:#0b7a55;text-align:center;font-size:23rpx;padding:18rpx 0 0}.jobs-page .btn[disabled]{background:#e4e1d8;color:#8a877e}
.order-note{margin-top:6rpx;padding:8rpx 14rpx;border-radius:12rpx;background:#f6f5f1;color:#5e5c55;font-size:23rpx;line-height:1.45;word-break:break-all}.page-dark .order-note{background:#242522;color:#a9a69c}

.guide-modal.guide-dark{background:#242522!important;color:#edebe4!important;border:1rpx solid #3a3b37}
.guide-modal.guide-dark .guide-title,.guide-modal.guide-dark .strong,.guide-modal.guide-dark .guide-text{color:#edebe4!important}
.guide-modal.guide-dark .guide-example{background:#242522!important;border-color:#3a3b37!important}
.guide-modal.guide-dark .btn.light{background:#3a2416!important;color:#edebe4!important}

.hall-location{margin:18rpx 0;padding:20rpx 22rpx;background:#f7f6f2;border-radius:18rpx}.hall-location-head{display:flex;align-items:center;justify-content:space-between;gap:14rpx;margin-bottom:18rpx}.hall-location-title{font-size:23rpx;font-weight:650;color:#5e5c55}.hall-gender{font-size:22rpx;font-weight:650;color:#0b7a55;background:#e7f3ed;border-radius:10rpx;padding:5rpx 14rpx}.hall-gender.not-set{color:#8a877e;background:#eeede8;font-weight:400}.hall-location-grid{display:flex;gap:20rpx}.hall-location-grid>view{flex:1;min-width:0}.hall-location-label{display:block;font-size:22rpx;line-height:1.4;color:#8a877e;margin-bottom:7rpx}.hall-location-value{display:block;font-size:27rpx;line-height:1.45;font-weight:650;color:#16181c;overflow-wrap:anywhere;word-break:break-word}.hall-locker{display:flex;gap:18rpx;align-items:flex-start;margin:14rpx 0;font-size:24rpx;line-height:1.5;color:#5e5c55}.hall-locker .hall-location-label{flex:none;width:98rpx;margin:0}.hall-locker>text:last-child{flex:1;min-width:0;overflow-wrap:anywhere}.hall-order-address{color:#5e5c55}.page-dark .hall-location{background:#1b1c1a}.page-dark .hall-location-title,.page-dark .hall-locker,.page-dark .hall-order-address{color:#c2bfb6}.page-dark .hall-location-value{color:#edebe4}.page-dark .hall-location-label{color:#aaa79f}.page-dark .hall-gender{background:#183b2d;color:#6fd0a8}.page-dark .hall-gender.not-set{background:#3a3b37;color:#aaa79f}

<import src="../public-job/detail.wxml"/>
<view style="{{motionStyle}}">
<lang-switch id="checkin-host"></lang-switch>
<view class="flow-page jobs-page {{darkClass}}"><view class="jobs-header"><view class="row"><view><view class="hall-title-wrap"><view class="flow-title hall-mark">{{ui["Jobs"]}}</view></view><view class="flow-sub">{{subtitle}} · {{zh?'当前':'now'}} {{nowLabel}}</view></view><view id="filter" class="filter-trigger {{filtersOpen?'open':''}}" bindtap="filter">≡ {{ui.Filter}}</view></view><view class="final-tabs glass"><view class="glass-thumb of-2" style="transform:translateX({{(tab==='done'?1:0)*100}}%)"><view wx:for="{{[tab]}}" wx:key="*this" class="glass-blob"/></view><view class="{{tab==='open'?'active':''}}" hover-class="glass-press" data-value="open" bindtap="handleTab">{{ui.Open}} {{openCount}}</view><view class="{{tab==='done'?'active':''}}" hover-class="glass-press" data-value="done" bindtap="handleTab">{{ui.Done}} {{doneCount}}</view></view><view wx:if="{{filtersOpen}}" class="filter-panel">
 <view class="filter-row"><text class="filter-name">{{zh?'性别':'Gender'}}</text><scroll-view class="scroll-pills" scroll-x show-scrollbar="{{false}}"><view class="filter-chip-track"><view wx:for="{{genderTabs}}" wx:for-item="filterOption" wx:key="key" class="filter-pill dorm-{{filterOption.key}} {{genderFilter===filterOption.key?'selected':''}}" data-key="{{filterOption.key}}" bindtap="onGenderFilter">{{filterOption.label}}</view></view></scroll-view></view>
 <view class="filter-row"><text class="filter-name">{{zh?'宿舍区':'Dorm area'}}</text><scroll-view class="scroll-pills" scroll-x show-scrollbar="{{false}}"><view class="filter-chip-track"><view wx:for="{{areaTabs}}" wx:for-item="filterOption" wx:key="key" class="filter-pill {{areaFilter===filterOption.key?'selected':''}}" data-key="{{filterOption.key}}" bindtap="onAreaFilter">{{filterOption.label}}</view></view></scroll-view></view>
 <view class="filter-row"><text class="filter-name">{{zh?'项目':'Type'}}</text><scroll-view class="scroll-pills" scroll-x show-scrollbar="{{false}}"><view class="filter-chip-track"><view wx:for="{{typeTabs}}" wx:for-item="filterOption" wx:key="key" class="filter-pill {{typeFilter===filterOption.key?'selected':''}}" data-key="{{filterOption.key}}" bindtap="onTypeFilter">{{filterOption.label}}</view></view></scroll-view></view>
 <view wx:if="{{buildingTabs.length}}" class="filter-row"><text class="filter-name">{{zh?'楼栋':'Building'}}</text><scroll-view class="scroll-pills" scroll-x show-scrollbar="{{false}}"><view class="filter-chip-track"><view wx:for="{{buildingTabs}}" wx:for-item="filterOption" wx:key="key" class="filter-pill {{buildingFilter===filterOption.key?'selected':''}}" data-key="{{filterOption.key}}" bindtap="onBuildingFilter">{{filterOption.label}}</view></view></scroll-view></view>
 <view class="filter-row"><text class="filter-name">{{ui["Time"]}}</text><scroll-view class="scroll-pills" scroll-x show-scrollbar="{{false}}"><view class="filter-chip-track"><text wx:for="{{timeOptions}}" wx:key="*this" class="filter-pill {{time===item?'selected':''}}" data-field="time" data-value="{{item}}" bindtap="select">{{optionLabels[item] || item}}</text></view></scroll-view></view>
 <view class="link clear-filter" bindtap="clear">{{ui["Clear filters"]}}</view>
</view></view><view class="jobs-content"><view wx:if="{{needsAddress}}" class="address-nudge" bindtap="address"><text>♧</text><view><view class="strong">{{ui["Where should things be delivered?"]}}</view><view class="hint">{{ui["Add your dorm and room once, and every post fills them in."]}}</view></view><text class="link">{{ui["Add"]}}</text></view>
<view wx:if="{{groupTest}}" class="row flow-card"><text class="strong">Group 测试大厅</text><text class="link" bindtap="switchTestRole">{{testRole==='runner'?'切换为发布者':'切换为跑手'}}</text><text class="link" bindtap="exitGroupTest">退出测试</text></view>
<view wx:if="{{hallHint}}" class="jobs-hint">{{hallHint}}</view>
<block wx:for="{{cards}}" wx:key="key"><view wx:if="{{tab==='done' && item.showDate}}" class="date-heading row"><text>{{item.dateLabel}}</text><text class="hint">{{item.dateCount}} {{zh?'个任务':item.dateCount===1?'job':'jobs'}}</text></view>
<view wx:if="{{item.ids.length>1}}" id="{{index===0?'first-job':'job-'+item.key}}" class="flow-card group-ticket">
  <view class="group-head">
    <view class="group-title-row"><text class="group-label">GROUP · {{item.type}} · {{item.requests}} {{zh?'单':'orders'}}</text><view class="group-total"><text class="group-total-label">{{zh?'合计赏金':'Total reward'}}</text><text class="group-total-amount"><text class="group-total-currency">¥</text>{{item.total}}</text></view></view>
    <view class="group-fold-row"><view class="group-fold" role="button" aria-expanded="{{!item.folded}}" data-key="{{item.key}}" bindtap="flipGroup">{{item.folded?(zh?'展开':'Expand'):(zh?'收起':'Collapse')}}<view class="group-chevron {{item.folded?'folded':''}}"/></view></view>
    <view class="group-route"><view><text>{{zh?'取货点':'Pickup'}}</text><view>{{item.pickupPointDisplay||item.originLabel}}</view></view><text>→</text><view><text>{{zh?'送达楼栋':'Drop-off'}}</text><view>{{item.destinationLabel}}</view></view></view>
    <view class="hint">{{zh?'可取货':'Pickup'}} {{item.pickupRange}} · {{item.spanMinutes}} {{zh?'分钟内':'min apart'}}</view>
  </view>
  <view wx:if="{{!item.folded}}" class="group-items">
    <view wx:for="{{item.items}}" wx:for-item="order" wx:key="id" role="checkbox" aria-checked="{{order.checked}}" class="group-order" data-id="{{order.id}}" bindtap="pickGroupOrder">
      <text class="group-check {{order.checked?'on':''}}">{{order.checked?'✓':''}}</text><view>{{order.pickupTime}} {{zh?'可取':'pickup'}} · {{order.boxes}} {{order.unit}}<view wx:if="{{order.note}}" class="hint">{{order.note}}</view></view><text class="group-fee">¥{{order.reward}}</text>
    </view>
  </view>
  <view class="group-foot"><view><view class="hint">{{zh?'已选':'Selected'}} {{item.selectedIds.length}} {{zh?'单 · 赏金合计':' · total'}}</view><text class="strong">¥{{item.selectedPay}}</text></view><button class="btn group-take" disabled="{{!item.selectedIds.length}}" data-ids="{{item.selectedIds}}" bindtap="take">{{zh?'接所选订单':'Take selected'}}</button></view>
</view>
<view wx:else id="{{index===0?'first-job':'job-'+item.key}}" data-ids="{{item.ids}}" bindtap="completedOrder" class="flow-card job-card {{item.mine&&tab==='open'?'own-post':''}} {{tab==='taken'?'taken-card':tab==='done'?'done-card':''}}"><view class="row job-card-header"><image class="job-avatar" src="/assets/yuni-happy.png" mode="aspectFit"/><view class="job-head-main"><text class="type-chip">{{item.type}}</text><text class="head-deadline">{{item.closes?(zh?'接单截止 ':'Accept by ')+item.closes:(zh?'现在可接':'Open now')}}</text><view class="job-badges"><text wx:if="{{item.category==='task'}}" class="badge task-mode-badge task-mode-{{item.taskMode}}">{{item.taskMode==='online'?(zh?'线上':'Online'):(zh?'线下':'Offline')}}</text><block wx:if="{{item.location.showDorm}}"><text wx:for="{{item.location.genders}}" wx:for-item="genderBadge" wx:key="key" class="badge hall-gender dorm-{{genderBadge.key}}">{{genderBadge.label}}</text><text wx:if="{{!item.location.gender}}" class="badge hall-gender not-set">{{zh?'性别未填写':'Gender not set'}}</text></block><text wx:if="{{item.lobbyPickupAllowed}}" class="badge lobby-eligible">{{zh?'男女均可接单':'Any gender can deliver'}}</text><text wx:if="{{item.category==='parcel'}}" class="badge">{{item.boxes}} {{item.unit}}</text><text wx:if="{{item.raised}}" class="badge orange">{{ui["Offer raised"]}}</text><text wx:if="{{item.soup}}" class="badge">{{ui["Soup or drinks"]}}</text><text wx:if="{{item.needsAdvance}}" class="badge orange">{{zh?'需跑手垫付':'Upfront payment needed'}}</text><text wx:if="{{item.fragile}}" class="badge">{{zh?'易碎':'Fragile'}}</text></view></view><view class="job-head-side"><text class="state-pill {{tab==='done'?'done':tab==='taken'?'taken':item.mine?'own':item.fresh?'fresh':'open'}}">{{tab==='done'?(zh?'已完成':'Done'):tab==='taken'?(zh?'进行中':'In progress'):item.mine?(zh?'你发布的':'Your post'):item.fresh?(zh?'刚发布':'Just posted'):(zh?'待接单':'Open')}}</text></view></view><view class="route job-route-box" aria-label="{{item.route}}"><text wx:if="{{item.category==='task'}}" class="job-task-title">{{item.route}}</text><block wx:else><text class="route-tag from">{{zh?'起':'From'}}</text><text class="job-route-origin">{{item.originLabel}}</text><text class="route-tag to">{{zh?'送':'To'}}</text><text class="job-route-destination">{{item.destinationLabel}}</text></block></view>
<view wx:if="{{item.lobbyPickupAllowed}}" class="green-note">{{zh?'可送至宿舍一楼大厅 · 收件人下楼取':'Ground-floor lobby delivery · customer collects downstairs'}}</view>
<view wx:if="{{!(tab==='open' && item.night)}}" class="job-timing row"><text wx:if="{{!(tab==='open' && item.category==='task')}}">{{tab==='done'?item.completedLabel:tab==='taken'?item.progress:item.arrival}}</text><text wx:if="{{item.closes && tab==='open' && item.mine}}">{{zh?'接单截止':'Accept by'}} {{item.closes}}</text></view>
<view wx:if="{{item.category==='takeout' && item.night}}" class="hint">{{item.items[0].purchaseStatus==='needs_purchase'?(zh?'未下单（需跑手垫付）':'Not ordered · runner pays upfront'):(zh?'已下单':'Already ordered')}}</view>
<view wx:if="{{item.category==='takeout' && item.night}}" class="hall-shop hall-locker"><text class="hall-location-label">{{zh?'店铺':'Shop'}}</text><text class="hall-locker-value">{{item.shop||(zh?'未填写':'Not set')}}</text><view wx:if="{{tab==='open' && !item.mine}}" class="job-deadline-mini"><text class="job-deadline-label">{{item.closes?(zh?'接单截止':'Accept by'):(zh?'任务数量':'Items')}}</text><text class="job-deadline-value">{{item.closes||item.boxes+' '+item.unit}}</text></view></view>
<view wx:if="{{item.items[0].note}}" class="order-note"><text class="job-note-label">{{zh?'备注':'Note'}}</text><text class="job-note-copy">{{item.items[0].note}}</text></view>
<view wx:if="{{tab==='open' && item.category==='parcel'}}" class="hint">{{zh?'接单后显示取件码':'Pickup codes appear after acceptance'}}</view>
<view wx:if="{{tab==='open' && !item.mine && item.category!=='takeout'}}" class="job-deadline-row"><view class="job-deadline-mini"><text class="job-deadline-label">{{item.closes?(zh?'接单截止':'Accept by'):(zh?'任务数量':'Items')}}</text><text class="job-deadline-value">{{item.closes||item.boxes+' '+item.unit}}</text></view></view>
<view class="job-reward"><text class="reward-tag">{{zh?'赏':'Fee'}}</text><text class="reward-amount">¥{{item.total}}</text></view>
<view class="job-footer {{tab==='open' && item.mine?'own-footer':''}} {{tab==='open' && !item.mine?'job-footer-take':''}} {{tab==='done'?'done-footer':tab==='taken'?'taken-footer':''}}"><block wx:if="{{tab==='open' && item.mine}}"><view class="hint">{{ui['Other runners can see it. You can’t take your own post.']}}</view><button class="btn own-order" data-id="{{item.ids[0]}}" catchtap="myPost">{{ui['Waiting for a runner · open your order ›']}}</button></block>
<block wx:elif="{{tab==='open'}}"><button class="btn job-take-button" hover-class="job-take-press" data-ids="{{item.ids}}" catchtap="take"><text>{{zh?'接单':'Take'}}</text><text class="job-take-arrow">›</text></button></block>
<block wx:elif="{{tab==='taken'}}"><view class="hint">{{ui["Settlement waits until confirmation."]}}</view><button class="btn light" data-id="{{item.ids[0]}}" bindtap="public">{{ui["Another runner has it · see progress ›"]}}</button></block><view wx:else class="hint completed-order-footer"><view>{{zh?(item.mine?'你的订单 · 已确认':'同学已确认'):(item.mine?'Your order · confirmed':'Student confirmed')}} · {{zh?'已记录模拟结算':'simulated settlement recorded'}}</view><text class="completed-order-link">{{zh?'查看订单 ›':'View order ›'}}</text></view></view></view></block><view wx:if="{{!cards.length}}" id="empty-hall" class="flow-card empty"><image class="empty-yuni" src="/assets/yuni-happy.png" mode="aspectFit"/><view class="empty-title">{{emptyTitle}}</view><view>{{emptyText}}</view><button wx:if="{{tab==='open' && !filterCount}}" class="btn empty-post" bindtap="postSomething">{{zh?'发布代取':'Post a pick-up'}}</button><button wx:if="{{filterCount}}" class="btn light" bindtap="clear">{{ui['Clear filters']}}</button><view wx:if="{{emptyHall}}" class="hint empty-reminder">{{zh?'想接单赚点零花钱？前往「我的」，开启「附近新任务提醒」。':'Want to earn? Go to Me and turn on “New jobs near me”.'}}</view></view><button wx:if="{{tab==='done' && hasEarlier}}" class="btn light" bindtap="earlier">{{ui["Show earlier jobs"]}}</button></view><app-nav id="app-nav" active="jobs" language="{{language}}"/></view><block wx:if="{{guideStep>=-1}}"><view wx:if="{{focus}}" class="guide-focus" style="top:{{focus.top}}px;left:{{focus.left}}px;width:{{focus.width}}px;height:{{focus.height}}px"><view class="guide-ring"/></view><view wx:else class="guide-shade" catchtap="noop"/><view wx:if="{{focus}}" class="guide-blocker" catchtap="noop"/><view wx:for="{{[guideStep>=2?1:0]}}" wx:key="*this" class="guide-modal {{guideStep>=2?'bottom-modal':''}} {{darkClass?'guide-dark':''}}" catchtap="noop"><view class="row"><view class="guide-progress"><view wx:if="{{guideStep>=0}}" class="guide-dots"><view wx:for="{{[0,1,2,3,4]}}" wx:key="*this" class="guide-dot {{item===guideStep?'on':item<guideStep?'past':''}}"/></view><text class="hint">{{guideStep<0?'':(guideStep+1)+(zh?' / 5':' of 5')}}</text></view><text class="link" hover-class="ue-press" bindtap="guideFinish">{{ui["Skip guide"]}}</text></view><view wx:for="{{[guideStep]}}" wx:key="*this" class="guide-step {{guideDir==='back'?'from-left':'from-right'}}"><view class="guide-body"><image src="/assets/yuni-{{guideStep<0?'wave':(guideItem.pose||'wave')}}.png" mode="aspectFit"/><view><view class="strong" style="color:#0b7a55">Yuni</view><view class="guide-title">{{guideStep<0?ui["Welcome to Uniearn"]:guideItem.title}}</view><view class="guide-text">{{guideStep<0?guideIntro:guideItem.text}}</view></view></view><view wx:if="{{guideStep===0 && guideEmpty}}" class="guide-example"><view class="row"><text class="hint">{{zh?'示例任务':'EXAMPLE TASK'}}</text><text class="strong">¥4.00</text></view><view><text class="badge takeout">{{ui.Takeaway}}</text><text class="badge">1 {{zh?'单':'order'}}</text></view><view class="route">North gate → Dorm 7</view><view class="btn example-button">{{zh?'接单':'Take'}} · ¥4.00</view></view></view><view class="action-row"><button wx:if="{{guideStep>=0}}" class="btn light" bindtap="guideBack">{{ui["Back"]}}</button><button class="btn" bindtap="guideNext">{{guideStep<0?ui["Show me around"]:guideStep===4?ui["Got it"]:ui["Next"]}}</button></view></view></block><yuni-assistant topic="" language="{{language}}"/>
<view wx:if="{{guideComplete}}" class="guide-complete">{{zh?'准备好啦！想再看一遍引导，去「我的」就能找到。':'You’re all set! You can replay the guide in Me.'}}</view>

<view wx:if="{{publicDetail}}" class="public-detail-overlay {{darkClass}}"><view class="public-detail-mask" bindtap="closePublicDetail" catchtouchmove="noop"/><view class="public-detail-panel"><view class="public-detail-header"><text>{{zh?'订单公开详情':'Public order details'}}</text><button class="public-detail-close" aria-label="{{zh?'关闭':'Close'}}" bindtap="closePublicDetail">×</button></view><scroll-view scroll-y class="public-detail-scroll"><view class="public-detail-body"><template is="public-order-detail" data="{{job:publicDetail,zh:zh}}"/></view></scroll-view><view class="public-detail-footer"><button class="btn outline" bindtap="closePublicDetail">{{zh?'关闭':'Close'}}</button><button wx:if="{{publicDetail.canTake}}" class="btn" data-ids="{{[publicDetail.id]}}" bindtap="take">{{zh?'接单':'Take this order'}}</button></view></view></view>
</view>

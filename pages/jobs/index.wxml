<lang-switch/>
<view class="flow-page jobs-page {{darkClass}}"><view class="jobs-header"><view class="row"><view><view class="flow-title">{{ui["Jobs"]}}</view><view class="flow-sub">{{subtitle}} · {{zh?'当前':'now'}} {{nowLabel}}</view></view><view id="filter" class="filter-trigger {{filtersOpen?'open':''}}" bindtap="filter">≡ {{ui.Filter}}</view></view><view class="final-tabs glass"><view class="glass-thumb of-2" style="transform:translateX({{(tab==='done'?1:0)*100}}%)"><view wx:for="{{[tab]}}" wx:key="*this" class="glass-blob"/></view><view class="{{tab==='open'?'active':''}}" hover-class="glass-press" data-value="open" bindtap="handleTab">{{ui.Open}} {{openCount}}</view><view class="{{tab==='done'?'active':''}}" hover-class="glass-press" data-value="done" bindtap="handleTab">{{ui.Done}} {{doneCount}}</view></view><view wx:if="{{filtersOpen}}" class="filter-panel">
 <view class="filter-row"><text class="filter-name">{{zh?'性别':'Gender'}}</text><scroll-view class="scroll-pills" scroll-x show-scrollbar="{{false}}"><view class="filter-chip-track"><view wx:for="{{genderTabs}}" wx:for-item="filterOption" wx:key="key" class="filter-pill dorm-{{filterOption.key}} {{genderFilter===filterOption.key?'selected':''}}" data-key="{{filterOption.key}}" bindtap="onGenderFilter">{{filterOption.label}}</view></view></scroll-view></view>
 <view class="filter-row"><text class="filter-name">{{zh?'宿舍区':'Dorm area'}}</text><scroll-view class="scroll-pills" scroll-x show-scrollbar="{{false}}"><view class="filter-chip-track"><view wx:for="{{areaTabs}}" wx:for-item="filterOption" wx:key="key" class="filter-pill {{areaFilter===filterOption.key?'selected':''}}" data-key="{{filterOption.key}}" bindtap="onAreaFilter">{{filterOption.label}}</view></view></scroll-view></view>
 <view class="filter-row"><text class="filter-name">{{zh?'项目':'Type'}}</text><scroll-view class="scroll-pills" scroll-x show-scrollbar="{{false}}"><view class="filter-chip-track"><view wx:for="{{typeTabs}}" wx:for-item="filterOption" wx:key="key" class="filter-pill {{typeFilter===filterOption.key?'selected':''}}" data-key="{{filterOption.key}}" bindtap="onTypeFilter">{{filterOption.label}}</view></view></scroll-view></view>
 <view wx:if="{{buildingTabs.length}}" class="filter-row"><text class="filter-name">{{zh?'楼栋':'Building'}}</text><scroll-view class="scroll-pills" scroll-x show-scrollbar="{{false}}"><view class="filter-chip-track"><view wx:for="{{buildingTabs}}" wx:for-item="filterOption" wx:key="key" class="filter-pill {{buildingFilter===filterOption.key?'selected':''}}" data-key="{{filterOption.key}}" bindtap="onBuildingFilter">{{filterOption.label}}</view></view></scroll-view></view>
 <view class="filter-row"><text class="filter-name">{{ui["Time"]}}</text><scroll-view class="scroll-pills" scroll-x show-scrollbar="{{false}}"><view class="filter-chip-track"><text wx:for="{{timeOptions}}" wx:key="*this" class="filter-pill {{time===item?'selected':''}}" data-field="time" data-value="{{item}}" bindtap="select">{{optionLabels[item] || item}}</text></view></scroll-view></view>
 <view class="link clear-filter" bindtap="clear">{{ui["Clear filters"]}}</view>
</view></view><view class="jobs-content"><view wx:if="{{needsAddress}}" class="address-nudge" bindtap="address"><text>♧</text><view><view class="strong">{{ui["Where should things be delivered?"]}}</view><view class="hint">{{ui["Add your dorm and room once, and every post fills them in."]}}</view></view><text class="link">{{ui["Add"]}}</text></view>
<view class="jobs-hint">{{hallHint}}</view>
<block wx:for="{{cards}}" wx:key="key"><view wx:if="{{tab==='done' && item.showDate}}" class="date-heading row"><text>{{item.dateLabel}}</text><text class="hint">{{item.dateCount}} {{zh?'个任务':item.dateCount===1?'job':'jobs'}}</text></view>
<view id="{{index===0?'first-job':'job-'+item.key}}" data-ids="{{item.ids}}" bindtap="completedOrder" class="flow-card job-card {{item.mine&&tab==='open'?'own-post':''}} {{tab==='taken'?'taken-card':tab==='done'?'done-card':''}}"><view class="row job-card-header"><view class="job-badges"><text class="badge state-badge {{item.mine&&tab==='open'?'own-badge':tab==='taken'?'taken-badge':tab==='done'||item.fresh?'done-badge':''}}">{{tab==='done'?(zh?'✓ 已完成':'✓ Done'):tab==='taken'?(zh?'● 已接单':'● Taken'):item.mine?(zh?'● 你发布的':'● Your post'):item.fresh?(zh?'● 刚发布':'● Just posted'):(zh?'● 待接单':'● Open')}}</text><text class="badge {{item.category}}">{{item.type}}</text><block wx:if="{{item.location.showDorm}}"><text wx:for="{{item.location.genders}}" wx:for-item="genderBadge" wx:key="key" class="badge hall-gender dorm-{{genderBadge.key}}">{{genderBadge.label}}</text><text wx:if="{{!item.location.gender}}" class="badge hall-gender not-set">{{zh?'性别未填写':'Gender not set'}}</text></block><text wx:if="{{item.category==='parcel'}}" class="badge">{{item.boxes}} {{item.unit}}</text><text wx:if="{{item.raised}}" class="badge orange">{{ui["Offer raised"]}}</text><text wx:if="{{item.soup}}" class="badge">{{ui["Soup or drinks"]}}</text><text wx:if="{{item.needsAdvance}}" class="badge orange">{{zh?'需跑手垫付':'Upfront payment needed'}}</text><text wx:if="{{item.fragile}}" class="badge">{{zh?'易碎':'Fragile'}}</text></view><text class="amount job-price">¥{{item.total}}</text></view><view class="route">{{item.route}}</view>
<view wx:if="{{!!item.rows[0].lobbyPickupAllowed}}" class="green-note">{{zh?'可送至宿舍一楼大厅':'Ground-floor lobby delivery accepted'}}</view>
<view class="job-timing row"><text>{{tab==='done'?item.completedLabel:tab==='taken'?item.progress:item.arrival}}</text><text wx:if="{{item.closes && tab==='open'}}">{{zh?'接单截止':'closes'}} {{item.closes}}</text></view>
<view wx:if="{{item.category==='takeout' && !item.night}}" class="hall-locker"><text class="hall-location-label">{{zh?'外卖柜':'Takeaway locker'}}</text><text class="hall-locker-value">{{item.pickupPointDisplay||(zh?'未填写':'Not set')}}</text></view>
<view wx:if="{{item.category==='takeout' && item.night}}" class="hint">{{item.items[0].purchaseStatus==='needs_purchase'?(zh?'未下单（需跑手垫付）':'Not ordered · runner pays upfront'):(zh?'已下单':'Already ordered')}}</view>
<view wx:if="{{item.items[0].note}}" class="order-note">{{zh?'备注：':'Note: '}}{{item.items[0].note}}</view>
<view wx:if="{{tab==='open' && item.category==='parcel'}}" class="hint">{{zh?'接单后显示取件码':'Pickup codes appear after acceptance'}}</view>
<block wx:if="{{tab==='open' && item.mine}}"><view class="hint">{{ui['Other runners can see it. You can’t take your own post.']}}</view><button class="btn own-order" data-id="{{item.ids[0]}}" bindtap="myPost">{{ui['Waiting for a runner · open your order ›']}}</button></block>
<block wx:elif="{{tab==='open'}}"><button class="btn" data-ids="{{item.ids}}" bindtap="take">{{zh?'接单':'Take'}} · ¥{{item.total}}</button></block>
<block wx:elif="{{tab==='taken'}}"><view class="hint">{{ui["Settlement waits until confirmation."]}}</view><button class="btn light" data-id="{{item.ids[0]}}" bindtap="public">{{ui["Another runner has it · see progress ›"]}}</button></block><view wx:else class="hint completed-order-footer"><view>{{zh?(item.mine?'你的订单 · 已确认':'同学已确认'):(item.mine?'Your order · confirmed':'Student confirmed')}} · {{zh?'已记录模拟结算':'simulated settlement recorded'}}</view><text class="completed-order-link">{{zh?'查看订单 ›':'View order ›'}}</text></view></view></block><view wx:if="{{!cards.length}}" id="empty-hall" class="flow-card empty"><image class="empty-yuni" src="/assets/yuni-happy.png" mode="aspectFit"/><view class="empty-title">{{emptyTitle}}</view><view>{{emptyText}}</view><button wx:if="{{tab==='open' && !filterCount}}" class="btn empty-post" bindtap="postSomething">{{zh?'发布代取':'Post a pick-up'}}</button><button wx:if="{{filterCount}}" class="btn light" bindtap="clear">{{ui['Clear filters']}}</button><view wx:if="{{emptyHall}}" class="hint empty-reminder">{{zh?'想接单赚点零花钱？前往「我的」，开启「附近新任务提醒」。':'Want to earn? Go to Me and turn on “New jobs near me”.'}}</view></view><button wx:if="{{tab==='done' && hasEarlier}}" class="btn light" bindtap="earlier">{{ui["Show earlier jobs"]}}</button></view><app-nav id="app-nav" active="jobs" language="{{language}}"/></view><block wx:if="{{guideStep>=-1}}"><view wx:if="{{focus}}" class="guide-focus" style="top:{{focus.top}}px;left:{{focus.left}}px;width:{{focus.width}}px;height:{{focus.height}}px"><view class="guide-ring"/></view><view wx:else class="guide-shade" catchtap="noop"/><view wx:if="{{focus}}" class="guide-blocker" catchtap="noop"/><view wx:for="{{[guideStep>=2?1:0]}}" wx:key="*this" class="guide-modal {{guideStep>=2?'bottom-modal':''}} {{darkClass?'guide-dark':''}}" catchtap="noop"><view class="row"><view class="guide-progress"><view wx:if="{{guideStep>=0}}" class="guide-dots"><view wx:for="{{[0,1,2,3,4]}}" wx:key="*this" class="guide-dot {{item===guideStep?'on':item<guideStep?'past':''}}"/></view><text class="hint">{{guideStep<0?'':(guideStep+1)+(zh?' / 5':' of 5')}}</text></view><text class="link" hover-class="ue-press" bindtap="guideFinish">{{ui["Skip guide"]}}</text></view><view wx:for="{{[guideStep]}}" wx:key="*this" class="guide-step {{guideDir==='back'?'from-left':'from-right'}}"><view class="guide-body"><image src="/assets/yuni-{{guideStep<0?'wave':guideItem.pose}}.png" mode="aspectFit"/><view><view class="strong" style="color:#0b7a55">Yuni</view><view class="guide-title">{{guideStep<0?ui["Welcome to Uniearn"]:guideItem.title}}</view><view class="guide-text">{{guideStep<0?guideIntro:guideItem.text}}</view></view></view><view wx:if="{{guideStep===0 && guideEmpty}}" class="guide-example"><view class="row"><text class="hint">{{zh?'示例任务':'EXAMPLE TASK'}}</text><text class="strong">¥4.00</text></view><view><text class="badge takeout">{{ui.Takeaway}}</text><text class="badge">1 {{zh?'单':'order'}}</text></view><view class="route">North gate → Dorm 7</view><view class="btn example-button">{{zh?'接单':'Take'}} · ¥4.00</view></view></view><view class="action-row"><button wx:if="{{guideStep>=0}}" class="btn light" bindtap="guideBack">{{ui["Back"]}}</button><button class="btn" bindtap="guideNext">{{guideStep<0?ui["Show me around"]:guideStep===4?ui["Got it"]:ui["Next"]}}</button></view></view></block><yuni-assistant topic="" language="{{language}}"/>
<view wx:if="{{guideComplete}}" class="guide-complete">{{zh?'准备好啦！想再看一遍引导，去「我的」就能找到。':'You’re all set! You can replay the guide in Me.'}}</view>

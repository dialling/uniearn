<import src="../public-job/detail.wxml"/>
<view style="{{motionStyle}}">
<lang-switch id="checkin-host"></lang-switch>
<view class="flow-page jobs-page {{darkClass}}"><view class="jobs-header"><view class="row"><view><view class="flow-title">{{ui["Jobs"]}}</view><view class="flow-sub">{{subtitle}} · {{zh?'当前':'now'}} {{nowLabel}}</view></view><view id="filter" class="filter-trigger {{filtersOpen?'open':''}}" bindtap="filter">≡ {{ui.Filter}}</view></view><view class="final-tabs glass"><view class="glass-thumb of-2" style="transform:translateX({{(tab==='done'?1:0)*100}}%)"><view wx:for="{{[tab]}}" wx:key="*this" class="glass-blob"/></view><view class="{{tab==='open'?'active':''}}" hover-class="glass-press" data-value="open" bindtap="handleTab">{{ui.Open}} {{openCount}}</view><view class="{{tab==='done'?'active':''}}" hover-class="glass-press" data-value="done" bindtap="handleTab">{{ui.Done}} {{doneCount}}</view></view><scroll-view wx:if="{{tab==='open'}}" class="nj-rail" scroll-x show-scrollbar="{{false}}"><view class="nj-rail-track"><view wx:for="{{typeTabs}}" wx:for-item="filterOption" wx:key="key" class="nj-cat {{filterOption.key?'':'nj-cat-all'}} {{typeFilter===filterOption.key?'on':''}}" hover-class="glass-press" data-key="{{filterOption.key}}" bindtap="onTypeFilter"><image wx:if="{{filterOption.key}}" class="nj-cat-icon" mode="aspectFit" src="/assets/icons3d/{{filterOption.key==='food'?'takeout':filterOption.key==='express'?'parcel':filterOption.key==='night'?'night':'task'}}.svg"/><text>{{filterOption.label}}</text></view></view></scroll-view><view wx:if="{{filtersOpen}}" class="filter-panel">
 <view class="filter-row"><text class="filter-name">{{zh?'性别':'Gender'}}</text><scroll-view class="scroll-pills" scroll-x show-scrollbar="{{false}}"><view class="filter-chip-track"><view wx:for="{{genderTabs}}" wx:for-item="filterOption" wx:key="key" class="filter-pill dorm-{{filterOption.key}} {{genderFilter===filterOption.key?'selected':''}}" data-key="{{filterOption.key}}" bindtap="onGenderFilter">{{filterOption.label}}</view></view></scroll-view></view>
 <view class="filter-row"><text class="filter-name">{{zh?'宿舍区':'Dorm area'}}</text><scroll-view class="scroll-pills" scroll-x show-scrollbar="{{false}}"><view class="filter-chip-track"><view wx:for="{{areaTabs}}" wx:for-item="filterOption" wx:key="key" class="filter-pill {{areaFilter===filterOption.key?'selected':''}}" data-key="{{filterOption.key}}" bindtap="onAreaFilter">{{filterOption.label}}</view></view></scroll-view></view>
 <view wx:if="{{buildingTabs.length}}" class="filter-row"><text class="filter-name">{{zh?'楼栋':'Building'}}</text><scroll-view class="scroll-pills" scroll-x show-scrollbar="{{false}}"><view class="filter-chip-track"><view wx:for="{{buildingTabs}}" wx:for-item="filterOption" wx:key="key" class="filter-pill {{buildingFilter===filterOption.key?'selected':''}}" data-key="{{filterOption.key}}" bindtap="onBuildingFilter">{{filterOption.label}}</view></view></scroll-view></view>
 <view class="filter-row"><text class="filter-name">{{ui["Time"]}}</text><scroll-view class="scroll-pills" scroll-x show-scrollbar="{{false}}"><view class="filter-chip-track"><text wx:for="{{timeOptions}}" wx:key="*this" class="filter-pill {{time===item?'selected':''}}" data-field="time" data-value="{{item}}" bindtap="select">{{optionLabels[item] || item}}</text></view></scroll-view></view>
 <view class="link clear-filter" bindtap="clear">{{ui["Clear filters"]}}</view>
</view></view><view class="jobs-content"><view wx:if="{{needsAddress}}" class="address-nudge" bindtap="address"><text>♧</text><view><view class="strong">{{ui["Where should things be delivered?"]}}</view><view class="hint">{{ui["Add your dorm and room once, and every post fills them in."]}}</view></view><text class="link">{{ui["Add"]}}</text></view>
<view wx:if="{{groupTest}}" class="row flow-card"><text class="strong">Group 测试大厅</text><text class="link" bindtap="switchTestRole">{{testRole==='runner'?'切换为发布者':'切换为跑手'}}</text><text class="link" bindtap="exitGroupTest">退出测试</text></view>
<view wx:if="{{hallHint}}" class="jobs-hint">{{hallHint}}</view>
<block wx:for="{{cards}}" wx:key="key"><view wx:if="{{item.showTakenHeading}}" class="date-heading row taken-heading"><text>{{ui["In progress"]}}</text><text class="hint">{{takenCount}} {{zh?'个任务':takenCount===1?'job':'jobs'}}</text></view><view wx:if="{{tab==='done' && item.showDate}}" class="date-heading row"><text>{{item.dateLabel}}</text><text class="hint">{{item.dateCount}} {{zh?'个任务':item.dateCount===1?'job':'jobs'}}</text></view>
<view wx:if="{{item.ids.length>1}}" id="{{index===0?'first-job':'job-'+item.key}}" class="flow-card group-ticket nj-card nj-group">
  <view class="nj-top"><image class="nj-tile" mode="aspectFit" src="/assets/icons3d/{{item.category==='takeout'?'takeout':'parcel'}}.svg"/><view class="nj-kind"><text class="nj-type">{{item.type}} · {{item.requests}} {{zh?'单':'orders'}}</text><text class="nj-sub">{{zh?'同路线 · 相差 '+item.spanMinutes+' 分钟':'Same route · '+item.spanMinutes+' min apart'}}</text></view><text class="nj-trip">{{zh?'可拼单':'Combine orders'}}</text></view>
  <view class="route nj-route"><view class="nj-a"><text class="job-route-origin">{{item.pickupPointDisplay||item.originLabel}}</text></view><view class="nj-b"><text class="job-route-destination">{{item.destinationLabel}}</text><block wx:if="{{item.location.showDorm}}"><text wx:for="{{item.location.genders}}" wx:for-item="genderBadge" wx:key="key" class="badge hall-gender dorm-{{genderBadge.key}}">{{genderBadge.label}}</text></block></view></view>
  <view class="group-items nj-g-items">
    <view wx:for="{{item.items}}" wx:for-item="order" wx:key="id" role="checkbox" aria-checked="{{order.checked}}" class="group-order nj-g-row" data-id="{{order.id}}" bindtap="pickGroupOrder">
      <text class="group-check nj-g-box {{order.checked?'on':''}}">{{order.checked?'✓':''}}</text><view class="nj-g-main">{{order.pickupTime}} {{zh?'可取':'pickup'}} · {{order.boxes}} {{order.unit}}<view wx:if="{{order.note}}" class="hint">{{order.note}}</view></view><text class="group-fee nj-g-fee">¥{{order.reward}}</text>
    </view>
  </view>
  <view class="group-foot nj-g-foot"><view class="nj-due"><block wx:if="{{item.selectedIds.length}}"><text>{{zh?'已选 '+item.selectedIds.length+' 单 ·':'Selected '+item.selectedIds.length+' ·'}}</text><text class="job-deadline-value">¥{{item.selectedPay}}</text></block><text wx:else>{{zh?'勾选你能顺路带的订单':'Tick the orders you can carry'}}</text></view><button class="btn group-take nj-g-take" disabled="{{!item.selectedIds.length}}" data-ids="{{item.selectedIds}}" bindtap="take">{{zh?'接所选订单':'Take selected'}}</button></view>
</view>
<view wx:else id="{{index===0?'first-job':'job-'+item.key}}" data-ids="{{item.ids}}" bindtap="completedOrder" class="flow-card job-card nj-card job-card-{{item.category}} {{item.night?'job-card-night':''}} {{item.mine&&tab==='open'?'own-post':''}} {{item.running?'taken-card':tab==='done'?'done-card':''}}"><view wx:if="{{item.mine&&tab==='open'}}" class="nj-mine"><text class="nj-mine-dot"></text><text>{{zh?'你发布的订单':'Your post'}}</text></view><view class="nj-top"><image class="nj-tile" mode="aspectFit" src="/assets/icons3d/{{item.night?'night':item.category==='takeout'?'takeout':item.category==='task'?'task':'parcel'}}.svg"/><view class="nj-kind"><text class="nj-type">{{item.type}}</text><text class="nj-sub">{{tab==='done'?(zh?'✓ 已完成':'✓ Done'):item.running?item.stateBadge:item.mine?(zh?'你发布的':'Your post'):item.fresh?(zh?'刚发布':'Just posted'):(zh?'待接单':'Open')}}<text wx:if="{{item.category!=='task'}}"> · {{item.boxes}} {{item.unit}}</text></text></view><view class="nj-price"><text class="amount job-price"><text class="job-currency">Balance ¥</text>{{item.total}}</text><text wx:if="{{item.raised}}" class="nj-raised">{{ui["Offer raised"]}}</text></view></view>
<view class="route nj-route {{item.category==='task'?'nj-task':''}}" aria-label="{{item.route}}"><text wx:if="{{item.category==='task'}}" class="job-task-title">{{item.route}}</text><block wx:else><view class="nj-a"><text class="job-route-origin">{{item.originLabel}}</text></view><view class="nj-b"><text class="job-route-destination">{{item.destinationLabel}}</text><block wx:if="{{item.location.showDorm}}"><text wx:for="{{item.location.genders}}" wx:for-item="genderBadge" wx:key="key" class="badge hall-gender dorm-{{genderBadge.key}}">{{genderBadge.label}}</text></block></view></block></view>
<view wx:if="{{item.lobbyPickupAllowed}}" class="green-note">{{zh?'可送至宿舍一楼大厅 · 收件人下楼取':'Ground-floor lobby delivery · customer collects downstairs'}}</view>
<view wx:if="{{!item.running && !(tab==='open' && item.night)}}" class="nj-meta"><text wx:if="{{!item.running && !(tab==='open' && !item.running && item.category==='task')}}">{{tab==='done'?item.completedLabel:item.arrival}}</text><text wx:if="{{item.closes && tab==='open' && item.mine}}">{{zh?'接单截止':'Accept by'}} {{item.closes}}</text></view>
<view wx:if="{{item.category==='takeout' && item.night}}" class="nj-meta"><text>{{item.items[0].purchaseStatus==='needs_purchase'?(zh?'未下单（需跑手垫付）':'Not ordered · runner pays upfront'):(zh?'已下单':'Already ordered')}}</text></view>
<view class="nj-chips"><text wx:if="{{item.lobbyPickupAllowed}}" class="badge lobby-eligible">{{zh?'男女均可接单':'Any gender can deliver'}}</text><text wx:if="{{item.needsAdvance}}" class="badge orange">{{zh?'需跑手垫付':'Upfront payment needed'}}</text><text wx:if="{{item.fragile}}" class="badge">{{zh?'易碎':'Fragile'}}</text></view>
<view wx:if="{{item.items[0].note}}" class="order-note"><text class="job-note-label">{{zh?'备注':'Note'}}</text><text class="job-note-copy">{{item.items[0].note}}</text></view>
<view wx:if="{{tab==='open' && !item.running && item.category==='parcel'}}" class="nj-meta"><text>{{zh?'接单后显示取件码':'Pickup codes appear after acceptance'}}</text></view>
<view class="job-footer {{tab==='open' && item.mine && !item.running?'own-footer':''}} {{(tab==='open' && !item.mine)||item.running?'job-footer-take':''}} {{tab==='done'?'done-footer':''}}"><block wx:if="{{tab==='open' && item.mine && !item.running}}"><view class="hint">{{ui['Other runners can see it. You can’t take your own post.']}}</view><button class="btn own-order" data-id="{{item.ids[0]}}" catchtap="myPost">{{ui['Waiting for a runner · open your order ›']}}</button></block>
<block wx:elif="{{tab==='open' && !item.running}}"><view class="nj-due"><text class="job-deadline-label">{{item.closes?(zh?'接单截止':'Accept by'):(zh?'任务数量':'Items')}}</text><text class="job-deadline-value">{{item.closes||item.boxes+' '+item.unit}}</text></view><button class="btn job-take-button" hover-class="job-take-press" hover-start-time="0" hover-stay-time="40" data-ids="{{item.ids}}" catchtap="take"><text>{{zh?'接单':'Take'}}</text><text class="job-take-arrow">›</text></button></block>
<block wx:elif="{{item.running}}"><view class="job-poster"><view class="job-poster-avatar" aria-hidden="true">{{item.publisherInitial}}</view><text class="job-poster-name">{{item.publisherName}}</text></view><button class="btn job-take-button job-take-continue" hover-class="job-take-press" hover-start-time="0" hover-stay-time="40" data-ids="{{item.ids}}" catchtap="completedOrder"><text>{{item.myRun?(item.status==='delivered'?(zh?'查看订单':'View order'):(zh?'继续配送':'Continue')):(zh?'查看进度':'View progress')}}</text><text class="job-take-arrow">›</text></button></block><view wx:else class="hint completed-order-footer"><view>{{zh?(item.mine?'你的订单 · 已确认':'同学已确认'):(item.mine?'Your order · confirmed':'Student confirmed')}} · {{zh?'已记录模拟结算':'simulated settlement recorded'}}</view><text class="completed-order-link">{{zh?'查看订单 ›':'View order ›'}}</text></view></view></view></block><view wx:if="{{!cards.length}}" id="empty-hall" class="flow-card empty"><image class="empty-yuni" src="/assets/yuni-happy.png" mode="aspectFit"/><view class="empty-title">{{emptyTitle}}</view><view>{{emptyText}}</view><button wx:if="{{tab==='open' && !filterCount}}" class="btn empty-post" bindtap="postSomething">{{zh?'发布代取':'Post a pick-up'}}</button><button wx:if="{{filterCount}}" class="btn light" bindtap="clear">{{ui['Clear filters']}}</button><view wx:if="{{emptyHall}}" class="hint empty-reminder">{{zh?'想接单赚点零花钱？前往「我的」，开启「附近新任务提醒」。':'Want to earn? Go to Me and turn on “New jobs near me”.'}}</view></view><button wx:if="{{tab==='done' && hasEarlier}}" class="btn light" bindtap="earlier">{{ui["Show earlier jobs"]}}</button></view><app-nav id="app-nav" active="jobs" language="{{language}}"/></view><block wx:if="{{guideStep>=-1}}"><view wx:if="{{focus}}" class="guide-focus" style="top:{{focus.top}}px;left:{{focus.left}}px;width:{{focus.width}}px;height:{{focus.height}}px;border-radius:{{focus.radius}}px"><view class="guide-ring"/></view><view wx:else class="guide-shade" catchtap="noop"/><view wx:if="{{focus}}" class="guide-blocker" catchtap="noop"/><view wx:for="{{[guideStep>=2?1:0]}}" wx:key="*this" class="guide-modal {{guideStep>=2?'bottom-modal':''}} {{darkClass?'guide-dark':''}}" catchtap="noop"><view class="row"><view class="guide-progress"><view wx:if="{{guideStep>=0}}" class="guide-dots"><view wx:for="{{[0,1,2,3,4]}}" wx:key="*this" class="guide-dot {{item===guideStep?'on':item<guideStep?'past':''}}"/></view><text class="hint">{{guideStep<0?'':(guideStep+1)+(zh?' / 5':' of 5')}}</text></view><text class="link" hover-class="ue-press" bindtap="guideFinish">{{ui["Skip guide"]}}</text></view><view wx:for="{{[guideStep]}}" wx:key="*this" class="guide-step {{guideDir==='back'?'from-left':'from-right'}}"><view class="guide-body"><image src="/assets/yuni-{{guideStep<0?'wave':guideItem.pose}}.png" mode="aspectFit"/><view><view class="strong" style="color:#0b7a55">Yuni</view><view class="guide-title">{{guideStep<0?ui["Welcome to UniEarn"]:guideItem.title}}</view><view class="guide-text">{{guideStep<0?guideIntro:guideItem.text}}</view></view></view><view wx:if="{{guideStep===0 && guideEmpty}}" class="guide-example"><view class="row"><text class="hint">{{zh?'示例任务':'EXAMPLE TASK'}}</text><text class="strong">¥4.00</text></view><view><text class="badge takeout">{{ui.Takeaway}}</text><text class="badge">1 {{zh?'单':'order'}}</text></view><view class="route">North gate → Dorm 7</view><view class="btn example-button">{{zh?'接单':'Take'}} · ¥4.00</view></view></view><view class="action-row"><button wx:if="{{guideStep>=0}}" class="btn light" bindtap="guideBack">{{ui["Back"]}}</button><button class="btn" bindtap="guideNext">{{guideStep<0?ui["Show me around"]:guideStep===4?ui["Got it"]:ui["Next"]}}</button></view></view></block><yuni-assistant topic="" language="{{language}}"/>
<view wx:if="{{guideComplete}}" class="guide-complete">{{zh?'准备好啦！想再看一遍引导，去「我的」就能找到。':'You’re all set! You can replay the guide in Me.'}}</view>

<view wx:if="{{publicDetail}}" class="public-detail-overlay {{darkClass}}"><view class="public-detail-mask" bindtap="closePublicDetail" catchtouchmove="noop"/><view class="public-detail-panel"><view class="public-detail-handle"></view><view class="public-detail-header"><text>{{zh?'订单公开详情':'Public order details'}}</text><view class="public-detail-close" aria-role="button" aria-label="{{zh?'关闭':'Close'}}" bindtap="closePublicDetail">×</view></view><scroll-view scroll-y class="public-detail-scroll"><view class="public-detail-body"><template is="public-order-detail" data="{{job:publicDetail,zh:zh}}"/></view></scroll-view><view class="public-detail-footer"><button class="btn outline public-detail-dismiss" bindtap="closePublicDetail">{{zh?'关闭':'Close'}}</button><button wx:if="{{publicDetail.canTake}}" class="btn public-detail-take" data-ids="{{[publicDetail.id]}}" bindtap="take">{{zh?'接单':'Take this order'}}</button></view></view></view>
</view>

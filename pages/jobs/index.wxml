<lang-switch/>
<view class="flow-page jobs-page"><view class="jobs-header"><view class="row"><view><view class="flow-title">{{ui["Jobs"]}}</view><view class="flow-sub">{{subtitle}} · {{zh?'当前':'now'}} {{nowLabel}}</view></view><view id="filter" class="filter-trigger" bindtap="filter">≡ {{ui.Filter}}</view></view><view class="final-tabs glass"><view class="glass-thumb of-3" style="transform:translateX({{(tab==='open'?0:tab==='taken'?1:2)*100}}%)"><view wx:for="{{[tab]}}" wx:key="*this" class="glass-blob"/></view><view class="{{tab==='open'?'active':''}}" hover-class="glass-press" data-value="open" bindtap="handleTab">{{ui.Open}} {{openCount}}</view><view class="{{tab==='taken'?'active':''}}" hover-class="glass-press" data-value="taken" bindtap="handleTab">{{ui.Taken}} {{takenCount}}</view><view class="{{tab==='done'?'active':''}}" hover-class="glass-press" data-value="done" bindtap="handleTab">{{ui.Done}} {{doneCount}}</view></view><view wx:if="{{filtersOpen}}" class="filter-panel"><view class="filter-row"><text class="filter-name">{{ui["Type"]}}</text><scroll-view class="scroll-pills" scroll-x><text wx:for="{{['all','takeout','parcel','task']}}" wx:key="*this" class="pill dark {{category===item?'selected':''}}" data-field="category" data-value="{{item}}" bindtap="select">{{item==='all'?ui["All"]:item==='takeout'?ui["Takeaway"]:item==='parcel'?ui["Parcels"]:ui["Tasks"]}}</text></scroll-view></view><view class="filter-row"><text class="filter-name">{{ui["Time"]}}</text><scroll-view class="scroll-pills" scroll-x><text wx:for="{{timeOptions}}" wx:key="*this" class="pill dark {{time===item?'selected':''}}" data-field="time" data-value="{{item}}" bindtap="select">{{optionLabels[item] || item}}</text></scroll-view></view><view class="filter-row"><text class="filter-name">{{ui["From"]}}</text><scroll-view class="scroll-pills" scroll-x><text wx:for="{{fromOptions}}" wx:key="*this" class="pill dark {{from===item?'selected':''}}" data-field="from" data-value="{{item}}" bindtap="select">{{optionLabels[item] || item}}</text></scroll-view></view><view class="filter-row"><text class="filter-name">{{ui["To"]}}</text><scroll-view class="scroll-pills" scroll-x><text wx:for="{{toOptions}}" wx:key="*this" class="pill dark {{to===item?'selected':''}}" data-field="to" data-value="{{item}}" bindtap="select">{{optionLabels[item] || item}}</text></scroll-view></view><view class="link clear-filter" bindtap="clear">{{ui["Clear filters"]}}</view></view></view><view class="jobs-content"><yuni-tip wx:if="{{!emptyHall}}" text="{{hello||''}}" tip-key="hall" language="{{language}}"/><view wx:if="{{needsAddress}}" class="address-nudge" bindtap="address"><text>♧</text><view><view class="strong">{{ui["Where should things be delivered?"]}}</view><view class="hint">{{ui["Add your dorm and room once, and every post fills them in."]}}</view></view><text class="link">{{ui["Add"]}}</text></view><view wx:if="{{tab==='done'}}" class="done-proof"><view class="strong">{{ui["Delivered by students, for students"]}}</view><view class="proof-count"><text>{{week}}</text> {{zh?'单本周已送达':(week===1?'order':'orders')+' delivered on campus this week'}}</view><view>{{ui["Delivery progress is recorded here. Names, rooms and phone numbers are never shown here."]}}</view></view>
<view class="jobs-hint">{{hallHint}}</view>
<block wx:for="{{cards}}" wx:key="key"><view wx:if="{{tab==='done' && item.showDate}}" class="date-heading row"><text>{{item.dateLabel}}</text><text class="hint">{{item.dateCount}} {{zh?'个任务':item.dateCount===1?'job':'jobs'}}</text></view>
<view id="{{index===0?'first-job':'job-'+item.key}}" class="flow-card job-card {{item.mine&&tab==='open'?'own-post':''}} {{tab==='taken'?'taken-card':tab==='done'?'done-card':''}}"><view class="row"><view><text class="badge state-badge {{item.mine&&tab==='open'?'own-badge':tab==='taken'?'taken-badge':tab==='done'||item.fresh?'done-badge':''}}">{{tab==='done'?(zh?'✓ 已完成':'✓ Done'):tab==='taken'?(zh?'● 已接单':'● Taken'):item.mine?(zh?'● 你发布的':'● Your post'):item.fresh?(zh?'● 刚发布':'● Just posted'):(zh?'● 待接单':'● Open')}}</text><text class="badge {{item.category}}">{{item.type}}</text><text wx:if="{{item.category!=='task'}}" class="badge">{{tab==='open'&&expanded[item.key]&&!item.mine?item.selectedCount:item.requests}} {{zh?'单':((tab==='open'&&expanded[item.key]&&!item.mine?item.selectedCount:item.requests)===1?'order':'orders')}} · {{tab==='open'&&expanded[item.key]&&!item.mine?item.selectedBoxes:item.boxes}} {{item.unit}}</text><text wx:if="{{item.raised}}" class="badge orange">{{ui["Offer raised"]}}</text><text wx:if="{{item.soup}}" class="badge">{{ui["Soup or drinks"]}}</text></view><text class="amount">¥{{tab==='open'&&expanded[item.key]&&!item.mine?item.selectedTotal:item.total}}</text></view><view class="route">{{item.route}}</view><view class="job-timing row"><text>{{tab==='done'?item.completedLabel:tab==='taken'?item.progress:item.arrival}}</text><text wx:if="{{item.closes && tab==='open'}}">{{zh?'接单截止':'closes'}} {{item.closes}}</text></view>
<view wx:if="{{tab==='open'}}" class="row order-toggle-row"><text class="hint">{{item.category==='parcel'?(zh?'接单后显示取件码':'Pickup codes appear after acceptance'):item.offerLabel}}</text><text class="order-toggle" data-key="{{item.key}}" bindtap="expand">{{expanded[item.key]?(zh?'收起 ⌃':'Collapse ⌃'):(zh?'展开 ⌄':'Expand ⌄')}}</text></view>
<view wx:if="{{tab==='open' && expanded[item.key]}}"><view wx:for="{{item.items}}" wx:for-item="order" wx:key="id" class="selectable-order {{selected[order.id]&&!item.mine?'order-selected':''}}" data-id="{{order.id}}" bindtap="toggleOrder"><view wx:if="{{!item.mine}}" class="order-check {{selected[order.id]?'checked':''}}">{{selected[order.id]?'✓':''}}</view><view class="order-summary"><view class="strong">{{zh?'第 '+order.index+' 单':'Order '+order.index}} · {{order.boxes}} {{order.unit}}</view><view class="hint">{{order.arrival}}</view></view><text class="strong">¥{{order.reward}}</text></view><view class="hint">{{ui['Names, rooms, phone numbers and pickup codes stay hidden until you take the order.']}}</view></view>
<block wx:if="{{tab==='open' && item.mine}}"><view class="hint">{{ui['Other runners can see it. You can’t take your own post.']}}</view><button class="btn own-order" data-id="{{item.ids[0]}}" bindtap="myPost">{{ui['Waiting for a runner · open your order ›']}}</button></block>
<block wx:elif="{{tab==='open'}}"><button wx:if="{{expanded[item.key]}}" class="btn" disabled="{{!item.selectedCount}}" data-ids="{{item.ids}}" bindtap="takeSelected">{{zh?'接单':'Take selected'}} · ¥{{item.selectedTotal}}</button><button wx:else class="btn" data-ids="{{item.ids}}" bindtap="take">{{zh?(item.requests>1?'接取全部 '+item.requests+' 单':'接单'):(item.requests>1?'Take all '+item.requests:'Take')}} · ¥{{item.total}}</button><text wx:if="{{expanded[item.key] && item.category==='parcel'}}" class="individual-parcels" data-ids="{{item.ids}}" bindtap="open">{{ui['Choose individual parcels']}} ›</text></block>
<block wx:elif="{{tab==='taken'}}"><view class="hint">{{ui["Settlement waits until confirmation."]}}</view><button class="btn light" data-id="{{item.ids[0]}}" bindtap="public">{{ui["Another runner has it · see progress ›"]}}</button></block><view wx:else class="hint">{{zh?(item.mine?'你的订单 · 已确认':'同学已确认'):(item.mine?'Your order · confirmed':'Student confirmed')}} · {{zh?'已记录模拟结算':'simulated settlement recorded'}}</view></view></block><view wx:if="{{!cards.length}}" id="empty-hall" class="flow-card empty"><image class="empty-yuni" src="/assets/yuni-{{emptyHall?'sleep':'look'}}.png" mode="aspectFit"/><view class="empty-title">{{emptyTitle}}</view><view>{{emptyText}}</view><button wx:if="{{tab==='open' && !filterCount}}" class="btn empty-post" bindtap="postSomething">{{zh?'发布任务':'Post a task'}}</button><button wx:if="{{filterCount}}" class="btn light" bindtap="clear">{{ui['Clear filters']}}</button><view wx:if="{{emptyHall}}" class="hint empty-reminder">{{zh?'想接单赚点零花钱？前往「我的」，开启「附近新任务提醒」。':'Want to earn? Go to Me and turn on “New jobs near me”.'}}</view></view><button wx:if="{{tab==='done' && hasEarlier}}" class="btn light" bindtap="earlier">{{ui["Show earlier jobs"]}}</button></view><app-nav id="app-nav" active="jobs" language="{{language}}"/></view><block wx:if="{{guideStep>=-1}}"><view wx:if="{{focus}}" class="guide-focus" style="top:{{focus.top}}px;left:{{focus.left}}px;width:{{focus.width}}px;height:{{focus.height}}px"><view class="guide-ring"/></view><view wx:else class="guide-shade" catchtap="noop"/><view wx:if="{{focus}}" class="guide-blocker" catchtap="noop"/><view wx:for="{{[guideStep>=2?1:0]}}" wx:key="*this" class="guide-modal {{guideStep>=2?'bottom-modal':''}}" catchtap="noop"><view class="row"><view class="guide-progress"><view wx:if="{{guideStep>=0}}" class="guide-dots"><view wx:for="{{[0,1,2,3,4]}}" wx:key="*this" class="guide-dot {{item===guideStep?'on':item<guideStep?'past':''}}"/></view><text class="hint">{{guideStep<0?'':(guideStep+1)+(zh?' / 5':' of 5')}}</text></view><text class="link" hover-class="ue-press" bindtap="guideFinish">{{ui["Skip guide"]}}</text></view><view wx:for="{{[guideStep]}}" wx:key="*this" class="guide-step {{guideDir==='back'?'from-left':'from-right'}}"><view class="guide-body"><image src="/assets/yuni-{{guideStep<0?'wave':guideItem.pose}}.png" mode="aspectFit"/><view><view class="strong" style="color:#41775b">Yuni</view><view class="guide-title">{{guideStep<0?ui["Welcome to Uniearn"]:guideItem.title}}</view><view class="guide-text">{{guideStep<0?guideIntro:guideItem.text}}</view></view></view><view wx:if="{{guideStep===0 && guideEmpty}}" class="guide-example"><view class="row"><text class="hint">{{zh?'示例任务':'EXAMPLE TASK'}}</text><text class="strong">¥4.00</text></view><view><text class="badge takeout">{{ui.Takeaway}}</text><text class="badge">1 {{zh?'袋':'bag'}}</text></view><view class="route">North gate → Dorm 7</view><view class="btn example-button">{{zh?'接单':'Take'}} · ¥4.00</view></view></view><view class="action-row"><button wx:if="{{guideStep>=0}}" class="btn light" bindtap="guideBack">{{ui["Back"]}}</button><button class="btn" bindtap="guideNext">{{guideStep<0?ui["Show me around"]:guideStep===4?ui["Got it"]:ui["Next"]}}</button></view></view></block><yuni-assistant topic="" language="{{language}}"/>
<view wx:if="{{guideComplete}}" class="guide-complete">{{zh?'准备好啦！想再看一遍引导，去「我的」就能找到。':'You’re all set! You can replay the guide in Me.'}}</view>

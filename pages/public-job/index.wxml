<view class="flow-page"><view class="flow-title">{{zh?'任务进度':'Job progress'}}</view><view class="flow-sub">{{zh?'公开进度 · 不含个人信息':'Public progress · no personal details'}}</view><view wx:if="{{job}}" class="flow-card"><view class="route">{{job.label}}</view><view class="row"><text class="badge green">{{job.status==='confirmed'?(zh?'已完成':'Completed'):job.status==='delivered'?(zh?'已送达':'Delivered'):job.status==='collected'?(zh?'配送中':'On the way'):(zh?'已接单':'Taken')}}</text><text class="money">¥{{job.rewardText}}</text></view><view wx:for="{{steps}}" wx:key="name" class="timeline"><text>{{item.done?'●':'○'}}</text><text>{{item.name}}</text><text>{{item.at}}</text></view><view class="hint">{{zh?'照片、姓名、房间号和手机号仅订单双方可见。':'Photos, names, rooms and phone numbers are private to the order participants.'}}</view></view><view wx:else class="flow-card empty">{{zh?'这个任务已无法查看。':'This job is no longer available.'}}</view><button class="btn" bindtap="jobs">{{zh?'查看待接单任务':'See open jobs'}}</button></view><yuni-assistant topic=""/>
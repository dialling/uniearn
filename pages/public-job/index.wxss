@import "../../utils/flow.wxss";
/* Public order detail styles are embedded to avoid a stale DevTools import index.
   Source: utils/public-order.wxss */
.public-order-summary{display:flex;align-items:center;justify-content:space-between;gap:24rpx}.public-order-type{font-size:27rpx;font-weight:750;color:#16181c}.public-order-status{display:inline-block;margin-top:10rpx;padding:6rpx 14rpx;border-radius:12rpx;background:#e7f3ed;color:#0b7a55;font-size:22rpx;line-height:1.4}.public-order-status.status-waiting{background:#fff2e9;color:#b45321}.public-order-price{flex:none;color:#c2410c;font-size:48rpx;font-weight:750;line-height:1.1;font-variant-numeric:tabular-nums}.public-order-price text{margin-right:3rpx;font-size:26rpx}
.public-order-route{margin:24rpx 0 20rpx;font-size:31rpx;font-weight:750;line-height:1.5;overflow-wrap:anywhere}.public-order-flags{display:flex;flex-wrap:wrap;gap:10rpx;margin:0 0 18rpx}.public-order-flags text{padding:7rpx 14rpx;border-radius:12rpx;background:#f5f4ef;color:#6b6860;font-size:22rpx}
.public-order-fields{padding:4rpx 20rpx;background:#f6f5f1;border-radius:20rpx}.public-order-field{display:flex;align-items:baseline;gap:22rpx;padding:15rpx 0;border-bottom:1rpx solid #e8e6df;line-height:1.5;font-size:24rpx}.public-order-field:last-child{border-bottom:0}.public-order-label{flex:none;width:156rpx;color:#77766d}.public-order-value{flex:1;min-width:0;color:#303930;font-weight:600;overflow-wrap:anywhere;white-space:pre-wrap}
.public-order-section{margin:28rpx 0 14rpx;font-size:26rpx;font-weight:750}.public-order-note{font-size:25rpx;line-height:1.6;white-space:pre-wrap;overflow-wrap:anywhere;color:#454d43}.public-order-note .public-order-section{margin-bottom:8rpx}.public-order-step{display:flex;align-items:baseline;gap:12rpx;padding:15rpx 0;border-bottom:1rpx solid #eeede8;font-size:23rpx;line-height:1.5;color:#8a877e}.public-order-dot{flex:none;width:24rpx}.public-order-step.done .public-order-dot{color:#0b7a55}.public-order-step-name{flex:1;min-width:0}.public-order-step.done .public-order-step-name{color:#303930}.public-order-step-time{flex:none;max-width:42%;text-align:right;font-size:20rpx;font-variant-numeric:tabular-nums}.public-order-privacy{margin:20rpx 0 6rpx;font-size:21rpx;line-height:1.6;color:#8a877e}
.public-detail-overlay{position:fixed;inset:0;z-index:300}.public-detail-mask{position:absolute;inset:0;background:rgba(22,24,28,.44)}.public-detail-panel{position:absolute;left:0;right:0;bottom:0;display:flex;flex-direction:column;height:84vh;max-height:calc(100vh - 90rpx);padding:24rpx 30rpx calc(22rpx + env(safe-area-inset-bottom));border-radius:30rpx 30rpx 0 0;background:#fff;box-sizing:border-box;animation:var(--ue-animation,public-detail-in .24s ease-out both)}.public-detail-header{display:flex;align-items:center;justify-content:space-between;gap:20rpx;margin-bottom:22rpx;font-size:31rpx;font-weight:750}.public-detail-close{display:flex;align-items:center;justify-content:center;flex:none;width:64rpx;height:64rpx;padding:0;margin:0;border:0;border-radius:50%;background:#f0efea;color:#6b6860;font-size:38rpx;font-weight:400;line-height:1}.public-detail-close::after{border:0}.public-detail-scroll{flex:1;min-height:0;height:0}.public-detail-body{padding:0 4rpx 12rpx}.public-detail-footer{display:flex;gap:14rpx;flex:none;padding-top:18rpx;border-top:1rpx solid #eeede8}.public-detail-footer .btn{flex:1;min-width:0;margin:0}
.public-detail-overlay.page-dark{background:transparent!important}.page-dark .public-detail-panel,.page-dark .public-order-fields{background:#242522}.page-dark .public-order-type,.page-dark .public-order-value,.page-dark .public-order-step.done .public-order-step-name{color:#edebe4}.page-dark .public-order-fields{background:#30322c}.page-dark .public-order-price{color:#f4a06e}.page-dark .public-order-status{background:#203b30;color:#6fd0a8}.page-dark .public-order-status.status-waiting{background:#3d2c22;color:#f4b582}.page-dark .public-order-label,.page-dark .public-order-privacy,.page-dark .public-order-step,.page-dark .public-order-note{color:#a9a69c}.page-dark .public-order-field,.page-dark .public-order-step,.page-dark .public-detail-footer{border-color:#3a3b37}.page-dark .public-order-flags text,.page-dark .public-detail-close{background:#34372f;color:#c8c7bd}
@keyframes public-detail-in{from{transform:translateY(35rpx);opacity:0}to{transform:none;opacity:1}}
/* End public order detail styles. */

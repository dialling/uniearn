<template name="public-order-detail">
 <view class="public-order-summary"><view><view class="public-order-type">{{job.type}}</view><view class="public-order-status status-{{job.status}}">{{job.statusLabel}}</view></view><view class="public-order-price"><text>¥</text>{{job.rewardText}}</view></view>
 <view class="public-order-route">{{job.label}}</view>
 <view wx:if="{{job.flags.length}}" class="public-order-flags"><text wx:for="{{job.flags}}" wx:for-item="flag" wx:key="*this">{{flag}}</text></view>
 <view class="public-order-fields"><view wx:for="{{job.fields}}" wx:for-item="field" wx:key="label" class="public-order-field"><text class="public-order-label">{{field.label}}</text><text class="public-order-value">{{field.value}}</text></view></view>
 <view wx:if="{{job.note}}" class="public-order-note"><view class="public-order-section">{{zh?'公开备注':'Public note'}}</view><view>{{job.note}}</view></view>
 <view class="public-order-section">{{zh?'订单进度':'Order progress'}}</view>
 <view wx:for="{{job.steps}}" wx:for-item="step" wx:key="name" class="public-order-step {{step.done?'done':''}}"><text class="public-order-dot">{{step.done?'●':'○'}}</text><text class="public-order-step-name">{{step.name}}</text><text class="public-order-step-time">{{step.at}}</text></view>
 <view class="public-order-privacy">{{zh?'姓名、房间号、手机号、照片和取件码仅订单双方可见。':'Names, rooms, phone numbers, photos and pickup codes are private to the order participants.'}}</view>
</template>

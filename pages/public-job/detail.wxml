<template name="public-order-detail">
 <view class="public-order-summary"><view class="public-order-heading"><view class="public-order-type">{{job.type}}</view><view class="public-order-status status-{{job.status}}">{{job.statusLabel}}</view></view><view class="public-order-price"><text>¥</text>{{job.rewardText}}</view></view>
 <view wx:if="{{job.routeTo}}" class="public-order-route"><view class="public-order-leg"><text class="public-order-kicker">{{zh?'取件':'From'}}</text><text class="public-order-place">{{job.routeFrom}}</text></view><view class="public-order-trail"></view><view class="public-order-leg"><text class="public-order-kicker">{{zh?'送达':'To'}}</text><text class="public-order-place">{{job.routeTo}}</text></view></view>
 <view wx:else class="public-order-route public-order-route-single">{{job.label}}</view>
 <view wx:if="{{job.flags.length}}" class="public-order-flags"><text wx:for="{{job.flags}}" wx:for-item="flag" wx:key="*this">{{flag}}</text></view>
 <view class="public-order-fields"><block wx:for="{{job.fields}}" wx:for-item="field" wx:key="label"><view wx:if="{{field.label!=='任务类型' && field.label!=='Type' && field.label!=='取件点' && field.label!=='Pickup point' && field.label!=='送达地点' && field.label!=='Destination'}}" class="public-order-field"><text class="public-order-label">{{field.label}}</text><text class="public-order-value">{{field.value}}</text></view></block></view>
 <view wx:if="{{job.note}}" class="public-order-note"><view class="public-order-section">{{zh?'公开备注':'Public note'}}</view><view>{{job.note}}</view></view>
 <view class="public-order-privacy">{{zh?'姓名、房间号、手机号、照片和取件码仅订单双方可见。':'Names, rooms, phone numbers, photos and pickup codes are private to the order participants.'}}</view>
</template>

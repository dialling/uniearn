<import src="../../utils/contact-identity.wxml"/>
<view style="{{motionStyle}}">
<lang-switch></lang-switch>
<view class="v8-page chat-page {{darkClass}} {{menuOpen?(stickerOpen?'stickers-open':'menu-open'):''}}" wx:if="{{request}}">
<view class="chat-policy">{{zh?'订单聊天 · 送达 24 小时后关闭':'Order chat · closes 24 hours after delivery'}}</view>
<view class="chat-summary-card">
  <view class="chat-order" bindtap="order" role="button" aria-label="{{zh?'查看订单':'View order'}}">
    <view class="chat-order-summary">{{request.sizeLabel}} · {{request.boxes}} {{request.unitLabel}}<text wx:if="{{request.category!=='task' && request.dorm}}"> · {{request.pickupLabel}} → {{request.destinationLabel}}</text></view>
    <view class="chat-order-link">{{zh?'查看订单 ›':'View order ›'}}</view>
  </view>
</view>
<view wx:for="{{messages}}" wx:key="id" class="message-row {{item.mine?'mine':''}}"><view class="bubble {{item.isSticker?'sticker-bubble':''}}"><block wx:if="{{item.isSticker}}"><image wx:if="{{stickersReady}}" class="message-sticker" src="{{item.stickerSrc}}" mode="aspectFit"/><view class="sticker-message-label">{{item.stickerLabel}}</view></block><block wx:elif="{{item.photo}}"><image class="chat-photo" src="{{item.photo}}" mode="widthFix" data-photo="{{item.photo}}" bindtap="previewPhoto"/><text wx:if="{{item.text}}">{{item.text}}</text></block><block wx:else>{{item.text}}</block><view class="message-time">{{item.time}}</view></view></view><view class="chat-compose"><scroll-view class="quick-scroll" scroll-x show-scrollbar="{{false}}"><view class="quick-track"><text wx:for="{{quick}}" wx:key="*this" class="pill" role="button" data-text="{{item}}" bindtap="quickReply">{{item}}</text></view></scroll-view><view class="compose-row"><button class="sticker-toggle photo-send" disabled="{{closed||sending}}" data-source="album" bindtap="sendPhoto" aria-label="{{zh?'发送图片':'Send a photo'}}"><image src="/assets/photo-green.svg" mode="aspectFit"/></button><button class="sticker-toggle {{menuOpen?'active':''}}" disabled="{{closed||sending}}" bindtap="toggleMenu" aria-expanded="{{menuOpen}}" aria-label="{{zh?'照片和贴纸':'Photos and stickers'}}">{{menuOpen?'×':'＋'}}</button><input class="compose-input" value="{{text}}" bindinput="input" bindfocus="closeMenu" bindconfirm="send" confirm-type="send" maxlength="500" cursor-spacing="20" placeholder="{{zh?(closed?'聊天已关闭':'输入消息…'):closed?'Chat closed':'Message…'}}" disabled="{{closed||sending}}"/><button class="send-button {{canSend&&!sending&&!closed?'ready':''}}" disabled="{{closed||!canSend||sending}}" bindtap="send" aria-label="{{zh?'发送消息':'Send message'}}"><image src="/assets/send.svg" mode="aspectFit"/></button></view>
<view wx:if="{{menuOpen}}" class="chat-more-panel">
  <view wx:if="{{!stickerOpen}}" class="chat-tools">
    <button class="chat-tool" disabled="{{closed||sending}}" data-source="camera" bindtap="sendPhoto"><view class="chat-tool-icon"><image src="/assets/photo-green.svg"/></view><view class="chat-tool-copy"><text>{{zh?'拍照发送':'Take a photo'}}</text><text class="chat-tool-hint">{{zh?'拍摄后发送给对方':'Capture and send to your contact'}}</text></view></button>
    <button class="chat-tool" disabled="{{closed||sending}}" data-source="album" bindtap="sendPhoto"><view class="chat-tool-icon"><image src="/assets/photo-green.svg"/></view><view class="chat-tool-copy"><text>{{zh?'从相册发送':'Choose from album'}}</text><text class="chat-tool-hint">{{zh?'选择图片发送给对方':'Select a photo to send'}}</text></view></button>
    <button class="chat-tool" disabled="{{closed||sending}}" bindtap="toggleStickers"><view class="chat-tool-icon"><image class="chat-yuni-icon" src="/assets/yuni-wave.png"/></view><text>{{zh?'Yuni 贴纸':'Yuni stickers'}}</text></button>
  </view>
  <view wx:else class="sticker-picker">
    <view class="sticker-picker-heading"><button class="sticker-back" bindtap="backToMenu">{{zh?'‹ 返回':'‹ Back'}}</button><text class="sticker-picker-title">{{zh?'Yuni 贴纸':'Yuni stickers'}}</text></view>
    <view wx:if="{{!stickersReady}}" class="sticker-load" bindtap="loadStickers">{{stickerError||(zh?'正在加载动态贴纸…':'Loading animated stickers…')}}</view><scroll-view wx:else class="sticker-scroll" scroll-y><view class="sticker-grid"><button wx:for="{{stickers}}" wx:key="id" class="sticker-option" disabled="{{closed||sending}}" data-id="{{item.id}}" bindtap="sendSticker"><image src="{{item.src}}" mode="aspectFit"/><text>{{item.name}}</text></button></view></scroll-view>
  </view>
</view>
</view></view><view wx:else class="empty">{{zh?'这段聊天暂不可用。':'This conversation is unavailable.'}}</view>


</view>

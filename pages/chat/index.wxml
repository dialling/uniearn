<lang-switch/>
<view class="v8-page chat-page {{darkClass}}" wx:if="{{request}}"><view class="summary-head row"><view><view class="flow-title">{{name}}</view><view class="hint">{{zh?'同学':'Student'}} · {{request.dorm}}</view></view><view class="contact-button" bindtap="call"><image src="/assets/phone.svg"/></view></view><view class="green-note" bindtap="order">{{request.sizeLabel}} · {{request.boxes}} {{request.unitLabel}} · {{request.station}} → {{request.dorm}}<view class="strong">{{zh?'查看订单 ›':'View order ›'}}</view></view><view class="hint center">{{zh?'接单后开放聊天，送达 24 小时后关闭。':'Chat opens after acceptance and closes 24 hours after delivery.'}}</view><view wx:for="{{messages}}" wx:key="id" class="message-row {{item.mine?'mine':''}}"><view class="bubble">{{item.text}}<view class="message-time">{{item.time}}</view></view></view><view wx:if="{{!messages.length}}" class="hint center">{{zh?'从这里开始聊天吧。':'Your conversation starts here.'}}</view><view class="chat-compose"><view class="pills"><text wx:for="{{quick}}" wx:key="*this" class="pill" data-text="{{item}}" bindtap="quickReply">{{item}}</text></view><view class="compose-row"><input class="compose-input" value="{{text}}" bindinput="input" maxlength="500" cursor-spacing="20" placeholder="{{zh?(closed?'聊天已关闭':'输入消息…'):closed?'Chat closed':'Message…'}}" disabled="{{closed}}"/><button class="send-button" disabled="{{closed||!text}}" bindtap="send"><image src="/assets/send.svg" mode="aspectFit"/></button></view></view></view><view wx:else class="empty">{{zh?'这段聊天暂不可用。':'This conversation is unavailable.'}}</view>
<yuni-assistant topic=""/>
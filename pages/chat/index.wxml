<import src="../../utils/contact-identity.wxml"/>
<view style="{{motionStyle}}">
<lang-switch></lang-switch>
<view class="v8-page chat-page {{darkClass}} {{stickerOpen?'stickers-open':''}}" wx:if="{{request}}">
  <view class="hint center chat-note">{{zh?'订单对话 · 送达 24 小时后关闭':'Order chat · closes 24 hours after delivery'}}</view>
  <view class="message-row">
    <view class="bubble team-bubble order-intro">
      <view class="intro-person">
        <template is="contactIdentity" data="{{...peer}}"/>
        <view class="call-peer" bindtap="call" hover-class="call-press" role="button" aria-label="{{zh?'打电话':'Call'}}"><image src="/assets/phone.svg" mode="aspectFit"/></view>
      </view>
      <view class="order-link" bindtap="order" hover-class="order-press" role="button">
        <text class="order-summary">{{request.sizeLabel}} · {{request.boxes}} {{request.unitLabel}} · {{request.pickupLabel}} → {{request.destinationLabel}}</text>
        <text class="order-action">{{zh?'查看订单 ›':'View order ›'}}</text>
      </view>
    </view>
  </view>
  <view class="topic-row"><text wx:for="{{quick}}" wx:key="*this" class="pill {{text===item?'on':''}}" data-text="{{item}}" bindtap="quickReply">{{item}}</text></view><view wx:for="{{messages}}" wx:key="id" class="message-row {{item.mine?'mine':''}}"><view class="bubble {{item.isSticker?'sticker-bubble':''}}"><block wx:if="{{item.isSticker}}"><image class="message-sticker" src="/assets/yuni-{{item.stickerPose}}.png" mode="aspectFit"/><view class="sticker-message-label">{{item.stickerLabel}}</view></block><block wx:else>{{item.text}}</block><view class="message-time">{{item.time}}</view></view></view><view class="chat-compose"><view wx:if="{{stickerOpen}}" class="sticker-picker"><view class="sticker-picker-title">{{zh?'选择贴纸':'Choose a sticker'}}</view><view class="sticker-grid"><view wx:for="{{stickers}}" wx:key="id" class="sticker-option" data-id="{{item.id}}" bindtap="sendSticker"><image src="/assets/yuni-{{item.pose}}.png" mode="aspectFit"/><text>{{item.name}}</text></view></view></view><view class="compose-row"><button class="sticker-toggle {{stickerOpen?'active':''}}" disabled="{{closed||sending}}" bindtap="toggleStickers" aria-label="{{zh?'打开贴纸':'Open stickers'}}">＋</button><input class="compose-input" value="{{text}}" bindinput="input" bindconfirm="send" confirm-type="send" maxlength="500" cursor-spacing="20" placeholder="{{zh?(closed?'聊天已关闭':'输入消息…'):closed?'Chat closed':'Message…'}}" disabled="{{closed||sending}}"/><button class="send-button {{canSend&&!sending&&!closed?'ready':''}}" disabled="{{closed||!canSend||sending}}" bindtap="send" aria-label="{{zh?'发送消息':'Send message'}}"><image src="/assets/send.svg" mode="aspectFit"/></button></view></view></view><view wx:else class="empty">{{zh?'这段聊天暂不可用。':'This conversation is unavailable.'}}</view>


</view>

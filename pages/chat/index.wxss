.chat-page{padding-bottom:236rpx}.chat-page.stickers-open{padding-bottom:470rpx}.message-row{display:flex;margin:22rpx 0}.message-row.mine{justify-content:flex-end}.bubble{max-width:82%;padding:22rpx;border-radius:22rpx;background:white;white-space:pre-wrap;word-break:break-word}.mine .bubble{background:#e7f3ed}.bubble.sticker-bubble,.mine .bubble.sticker-bubble{background:transparent;padding:8rpx 12rpx;text-align:center}.message-sticker{display:block;width:142rpx;height:154rpx}.sticker-message-label{font-size:21rpx;font-weight:650;color:#41775b;margin-top:2rpx}.sticker-bubble .message-time{text-align:center}.message-time{font-size:20rpx;color:#8a877e;text-align:right;margin-top:8rpx}.chat-compose{position:fixed;left:0;right:0;bottom:0;z-index:20;background:#f7f7f7;border-top:1rpx solid #e2e0d9;padding:14rpx 24rpx calc(14rpx + env(safe-area-inset-bottom));box-shadow:0 -6rpx 24rpx #0000000d}.chat-compose .pills{justify-content:center;margin:0 0 12rpx}.chat-compose .row{width:100%}.chat-compose input{flex:1;min-width:0}.chat-compose .compose-row{display:flex;align-items:center;gap:12rpx;width:100%}.chat-compose .sticker-toggle{flex:none;width:68rpx;height:68rpx;min-width:68rpx;min-height:68rpx;margin:0;padding:0;border-radius:50%;border:1rpx solid #b8d7c7;background:#fff;color:#0b7a55;font-size:45rpx;font-weight:350;line-height:64rpx}.chat-compose .sticker-toggle::after{border:0}.chat-compose .sticker-toggle.active{background:#e3f2ea}.chat-compose .sticker-toggle[disabled]{opacity:.38}.sticker-picker{background:#fff;border:1rpx solid #dce8e1;border-radius:24rpx;padding:17rpx 14rpx 15rpx;margin:0 0 13rpx}.sticker-picker-title{font-size:22rpx;font-weight:750;color:#4e554f;margin:0 7rpx 12rpx}.sticker-grid{display:flex;gap:7rpx}.sticker-option{flex:1;min-width:0;text-align:center;border-radius:17rpx;padding:8rpx 2rpx 6rpx;color:#41775b;font-size:17rpx}.sticker-option:active{background:#edf7f1}.sticker-option image{display:block;width:64rpx;height:72rpx;margin:0 auto 4rpx}.sticker-option text{display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.chat-compose .compose-input{flex:1;min-width:0;height:72rpx;background:#fff;border:1rpx solid #e2e0d9;border-radius:36rpx;padding:0 28rpx;font-size:28rpx;box-sizing:border-box}.chat-compose .send-button{flex:none;width:68rpx;height:68rpx;min-width:68rpx;min-height:68rpx;margin:0;padding:0;border-radius:50%;background:#b8d7c7;display:flex;align-items:center;justify-content:center;line-height:0;opacity:1}.chat-compose .send-button.ready{background:#0b7a55}.chat-compose .send-button::after{border:0}.chat-compose .send-button image{width:31rpx;height:31rpx;margin-left:3rpx}.chat-compose .send-button[disabled]{background:#b8d7c7;opacity:1}

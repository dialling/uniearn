@import "../support-chat/index.wxss";
@import "../../utils/contact-identity.wxss";
.chat-page.stickers-open{padding-bottom:470rpx}
.bubble.sticker-bubble,.mine .bubble.sticker-bubble{background:transparent;padding:8rpx 12rpx;text-align:center}.message-sticker{display:block;width:142rpx;height:154rpx}.sticker-message-label{font-size:21rpx;font-weight:650;color:#41775b;margin-top:2rpx}.sticker-bubble .message-time{text-align:center}.chat-compose .sticker-toggle{flex:none;width:68rpx;height:68rpx;min-width:68rpx;min-height:68rpx;margin:0;padding:0;border-radius:50%;border:1rpx solid #b8d7c7;background:#fff;color:#0b7a55;font-size:45rpx;font-weight:350;line-height:64rpx}.chat-compose .sticker-toggle::after{border:0}.chat-compose .sticker-toggle.active{background:#e3f2ea}.chat-compose .sticker-toggle[disabled]{opacity:.38}.sticker-picker{background:#fff;border:1rpx solid #dce8e1;border-radius:24rpx;padding:17rpx 14rpx 15rpx;margin:0 0 13rpx}.sticker-picker-title{font-size:22rpx;font-weight:750;color:#4e554f;margin:0 7rpx 12rpx}.sticker-grid{display:flex;gap:7rpx}.sticker-option{flex:1;min-width:0;text-align:center;border-radius:17rpx;padding:8rpx 2rpx 6rpx;color:#41775b;font-size:17rpx}.sticker-option:active{background:#edf7f1}.sticker-option image{display:block;width:64rpx;height:72rpx;margin:0 auto 4rpx}.sticker-option text{display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}

.chat-page{padding-left:0;padding-right:0}
.order-intro{width:82%;white-space:normal}
.intro-person{display:flex;align-items:center;gap:12rpx}
.intro-person .contact-name{overflow:hidden;white-space:nowrap;text-overflow:ellipsis}
.call-peer{flex:none;width:64rpx;height:64rpx;border-radius:50%;background:#f1f2ed;display:flex;align-items:center;justify-content:center}
.call-peer image{width:28rpx;height:28rpx}
.call-press{background:#dce9e0}
.order-link{display:flex;flex-direction:column;gap:8rpx;margin-top:16rpx;padding-top:16rpx;border-top:1rpx solid #e5e4dd}
.order-summary{font-size:24rpx;line-height:1.5;color:#65665e}
.order-action{font-size:24rpx;font-weight:600;color:#0b7152}
.order-press{opacity:.7}
.chat-compose .compose-row .compose-input{flex:1 1 0%;min-width:0;width:0}
.chat-compose .compose-row .send-button,.chat-compose .compose-row .sticker-toggle{flex:0 0 68rpx;width:68rpx;max-width:68rpx;height:68rpx;margin:0;padding:0}
.chat-compose .compose-row .send-button[disabled]{background:#b8d7c7;color:#fff;opacity:1}
.page-dark .order-summary{color:#c2c4bc}
.page-dark .order-action{color:#8cd8b6}

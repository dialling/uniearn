@import "../support-chat/index.wxss";
@import "../../utils/contact-identity.wxss";
.photo-send image{width:34rpx;height:34rpx}.chat-page{padding-bottom:236rpx}.chat-page.stickers-open{padding-bottom:470rpx}
.bubble.sticker-bubble,.mine .bubble.sticker-bubble{background:transparent;padding:8rpx 12rpx;text-align:center}.message-sticker{display:block;width:142rpx;height:154rpx}.sticker-message-label{font-size:21rpx;font-weight:650;color:#41775b;margin-top:2rpx}.sticker-bubble .message-time{text-align:center}.chat-compose .sticker-toggle{flex:none;width:68rpx;height:68rpx;min-width:68rpx;min-height:68rpx;margin:0;padding:0;border-radius:50%;border:1rpx solid #b8d7c7;background:#fff;color:#0b7a55;font-size:45rpx;font-weight:350;line-height:64rpx}.chat-compose .sticker-toggle::after{border:0}.chat-compose .sticker-toggle.active{background:#e3f2ea}.chat-compose .sticker-toggle[disabled]{opacity:.38}.sticker-picker{background:#fff;border:1rpx solid #dce8e1;border-radius:24rpx;padding:17rpx 14rpx 15rpx;margin:0 0 13rpx}.sticker-picker-title{font-size:22rpx;font-weight:750;color:#4e554f;margin:0 7rpx 12rpx}.sticker-grid{display:flex;gap:7rpx}.sticker-option{flex:1;min-width:0;text-align:center;border-radius:17rpx;padding:8rpx 2rpx 6rpx;color:#41775b;font-size:17rpx}.sticker-option:active{background:#edf7f1}.sticker-option image{display:block;width:64rpx;height:72rpx;margin:0 auto 4rpx}.sticker-option text{display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}

.chat-page{padding-left:0;padding-right:0}
.order-intro{width:82%;white-space:normal}
.intro-person{display:flex;align-items:center;gap:12rpx}
.intro-person .contact-name{overflow:hidden;white-space:nowrap;text-overflow:ellipsis}
.call-peer{flex:none;width:64rpx;height:64rpx;border-radius:50%;background:#f1f2ed;display:flex;align-items:center;justify-content:center}
.call-peer image{width:28rpx;height:28rpx}
.call-press{background:#dce9e0}
.order-link{display:flex;flex-direction:column;gap:8rpx;margin-top:16rpx;padding-top:16rpx;border-top:1rpx solid #e5e4dd}
.order-summary{font-size:24rpx;line-height:1.5;color:#65665e}
.order-action{font-size:24rpx;font-weight:600;color:#0b7152}
.order-press{opacity:.7}
.chat-compose .compose-row .compose-input{flex:1 1 0%;min-width:0;width:0}
.chat-compose .compose-row .send-button,.chat-compose .compose-row .sticker-toggle{flex:0 0 68rpx;width:68rpx;max-width:68rpx;height:68rpx;margin:0;padding:0}
.chat-compose .compose-row .send-button[disabled]{background:#b8d7c7;color:#fff;opacity:1}
.page-dark .order-summary{color:#c2c4bc}
.page-dark .order-action{color:#8cd8b6}

.chat-policy{text-align:center;color:#77766e;font-size:24rpx;line-height:1.5;margin:4rpx 0 24rpx}
.chat-summary-card{background:#fff;border-radius:28rpx;padding:26rpx;margin-bottom:24rpx}
.chat-person-row{display:flex;align-items:center;gap:20rpx;padding:4rpx 0 26rpx}
.chat-avatar{flex:0 0 80rpx;width:80rpx;height:80rpx;border-radius:50%;background:#e7f3ed;color:#0b7a55;display:flex;align-items:center;justify-content:center;font-size:34rpx;font-weight:700}
.chat-person-copy{flex:1;min-width:0}
.chat-name{font-size:32rpx;font-weight:750;line-height:1.4;overflow-wrap:break-word}
.chat-person-meta{margin-top:10rpx;font-size:24rpx;color:#77766e;line-height:1.4;overflow-wrap:break-word}
button.chat-call{flex:none;display:flex;align-items:center;justify-content:center;width:68rpx;height:68rpx;min-height:0;margin:0;padding:0;background:#f1f1ed;border-radius:50%}
.chat-call image{width:30rpx;height:30rpx}
.chat-order{padding-top:4rpx}
.chat-order-summary{font-size:25rpx;color:#77766e;line-height:1.5;overflow-wrap:break-word}
.chat-order-link{margin-top:12rpx;font-size:27rpx;font-weight:700;color:#0b7a55}
.page-dark .chat-summary-card{background:#242522}
.page-dark .chat-name{color:#f2f0e9}
.page-dark .chat-person-meta,.page-dark .chat-order-summary,.page-dark .chat-policy{color:#b7b5aa}
.page-dark .chat-avatar{background:#264536;color:#a6d8b8}
.page-dark button.chat-call{background:#35372f}
.page-dark .chat-order{border-color:#41423e}
.page-dark .chat-order-link{color:#76d7b3}
.chat-page.menu-open{padding-bottom:440rpx}
.chat-page.stickers-open{padding-bottom:640rpx}
.chat-more-panel{padding-top:20rpx;animation:var(--ue-animation,chat-panel-up .2s ease-out)}
.chat-tools{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20rpx;padding:10rpx 22rpx 16rpx}
.chat-tools button.chat-tool{display:flex;flex-direction:column;align-items:center;gap:14rpx;width:100%;min-width:0;margin:0;padding:6rpx 0;border-radius:22rpx;background:transparent;color:#4d6255;font-size:24rpx;line-height:1.4}
.chat-tool-icon{display:flex;align-items:center;justify-content:center;width:110rpx;height:104rpx;background:#fff;border:1rpx solid #e3e9e2;border-radius:28rpx}
.chat-tool-icon image{width:48rpx;height:48rpx}
.chat-tool-icon .chat-yuni-icon{width:60rpx;height:74rpx}
.chat-more-panel .sticker-picker{margin:0;padding:12rpx 16rpx}
.sticker-picker-heading{display:flex;align-items:center;gap:16rpx;margin-bottom:8rpx}
.sticker-picker-heading .sticker-picker-title{margin:0}
.sticker-picker-heading button.sticker-back{width:auto;margin:0;padding:8rpx 12rpx;min-height:0;background:#e7f3ed;border-radius:20rpx;color:#0b7a55;font-size:22rpx;line-height:1.5}
.chat-more-panel .sticker-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8rpx 14rpx}
.chat-more-panel button.sticker-option{width:100%;margin:0;padding:10rpx;background:transparent;font-size:22rpx;line-height:1.3}
.chat-more-panel .sticker-option image{width:82rpx;height:88rpx}
.chat-photo{display:block;width:360rpx;max-width:100%;border-radius:14rpx}
@keyframes chat-panel-up{from{transform:translateY(36rpx);opacity:.4}to{transform:translateY(0);opacity:1}}

.page-dark .chat-compose{background:#252b26;border-color:#435046}
.page-dark .chat-tool-icon,.page-dark .sticker-picker{background:#303a32;border-color:#49584d}
.page-dark .chat-tools button.chat-tool,.page-dark .sticker-option,.page-dark .sticker-picker-title{color:#b7d6c1}
.page-dark .compose-row .compose-input{background:#303a32;color:#edf4ee;border-color:#49584d}

.chat-more-panel .sticker-scroll{height:340rpx}
.chat-more-panel .sticker-option image{width:120rpx;height:120rpx;border-radius:14rpx}
.message-sticker{width:240rpx;height:240rpx;border-radius:18rpx}
.sticker-load{height:340rpx;display:flex;align-items:center;justify-content:center;color:#41775b;font-size:24rpx}

.quick-scroll{width:100%;white-space:nowrap;margin-bottom:12rpx}
.quick-track{display:inline-flex;align-items:center;gap:12rpx;padding:2rpx 0}
.quick-track .pill{flex:none;white-space:nowrap;margin:0}

.chat-tools{grid-template-columns:1fr;gap:14rpx;padding:4rpx 0}
.chat-tools button.chat-tool{flex-direction:row;justify-content:flex-start;gap:20rpx;padding:18rpx 22rpx;border:2rpx dashed #a7cbbb;border-radius:24rpx;text-align:left;background:#fff}
.chat-tools .chat-tool-icon{flex:none;width:82rpx;height:82rpx;border:0;border-radius:20rpx;background:#edf6f1}
.chat-tool-copy{display:flex;flex-direction:column;gap:6rpx;flex:1;min-width:0}
.chat-tool-copy>text:first-child{font-size:26rpx;font-weight:650;color:#252a25}
.chat-tool-hint{font-size:21rpx;color:#77786f;line-height:1.5}
.chat-page.menu-open{padding-bottom:700rpx}
.chat-page.stickers-open{padding-bottom:640rpx}
.page-dark .chat-tools button.chat-tool{background:#242522;border-color:#577a64}
.page-dark .chat-tools .chat-tool-icon{background:#283e31}
.page-dark .chat-tool-copy>text:first-child{color:#edece4}.page-dark .chat-tool-hint{color:#b6b7ae}

.chat-page{padding-bottom:250rpx}.message-row{display:flex;margin:22rpx 0}.message-row.mine{justify-content:flex-end}.bubble{max-width:82%;padding:22rpx;border-radius:22rpx;background:white;white-space:pre-wrap;word-break:break-word}.mine .bubble{background:#dfece6}.message-time{font-size:20rpx;color:#888;text-align:right;margin-top:8rpx}.chat-compose{position:fixed;left:0;right:0;bottom:0;z-index:20;background:#fff;border-top:1rpx solid #e6e4dc;padding:18rpx 30rpx calc(20rpx + env(safe-area-inset-bottom));box-shadow:0 -6rpx 24rpx #0000000d}.chat-compose .pills{justify-content:center;margin:0 0 14rpx}.chat-compose .row{width:100%}.chat-compose input{flex:1;min-width:0}.chat-compose button{flex:none;min-width:190rpx;margin:12rpx 0 12rpx 14rpx}

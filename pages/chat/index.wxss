.chat-page{padding-bottom:236rpx}.message-row{display:flex;margin:22rpx 0}.message-row.mine{justify-content:flex-end}.bubble{max-width:82%;padding:22rpx;border-radius:22rpx;background:white;white-space:pre-wrap;word-break:break-word}.mine .bubble{background:#e7f3ed}.message-time{font-size:20rpx;color:#8a877e;text-align:right;margin-top:8rpx}.chat-compose{position:fixed;left:0;right:0;bottom:0;z-index:20;background:#f7f7f7;border-top:1rpx solid #e2e0d9;padding:14rpx 24rpx calc(14rpx + env(safe-area-inset-bottom));box-shadow:0 -6rpx 24rpx #0000000d}.chat-compose .pills{justify-content:center;margin:0 0 12rpx}.chat-compose .row{width:100%}.chat-compose input{flex:1;min-width:0}.chat-compose .compose-row{display:flex;align-items:center;gap:12rpx;width:100%}.chat-compose .compose-input{flex:1;min-width:0;height:72rpx;background:#fff;border:1rpx solid #e2e0d9;border-radius:36rpx;padding:0 28rpx;font-size:28rpx;box-sizing:border-box}.chat-compose .send-button{flex:none;width:68rpx;height:68rpx;min-width:68rpx;min-height:68rpx;margin:0;padding:0;border-radius:50%;background:#0b7a55;display:flex;align-items:center;justify-content:center;line-height:0}.chat-compose .send-button::after{border:0}.chat-compose .send-button image{width:31rpx;height:31rpx;margin-left:3rpx}.chat-compose .send-button[disabled]{opacity:.38}

page{background:#f2f5f3}
.admin-page{
 --brand:#41775b;--brand-50:#eef5f1;--brand-200:#cfe2d7;
 --ink:#14201a;--ink-2:#3c4a42;--ink-3:#77857d;--ink-4:#a9b4ad;
 --line:#e4ebe7;--line-2:#eef2ef;--surface:#fff;--danger:#e5484d;
 --r-lg:30rpx;--r-xl:40rpx;--r-pill:999rpx;
 --sh-1:0 1rpx 2rpx rgba(20,48,34,.04),0 8rpx 24rpx rgba(20,48,34,.05);
 --grad-hero:linear-gradient(150deg,#5f9a7a 0%,#41775b 46%,#2c5a43 100%);
 --grad-icon:linear-gradient(180deg,#86b89c 0%,#5a9174 52%,#41775b 100%);
 min-height:100vh;padding-bottom:80rpx;background:#f2f5f3;color:var(--ink);line-height:1.5
}
.admin-press{opacity:.8;transform:scale(.97)}

/* custom navigation bar; the right side stays clear for the WeChat capsule */
.navbar{position:relative;display:flex;align-items:center;padding-left:28rpx;padding-bottom:12rpx;box-sizing:content-box}
.navbar-btns{position:relative;z-index:1;display:flex;gap:12rpx}
.navbar-title{position:absolute;left:0;right:0;bottom:12rpx;text-align:center;font-size:32rpx;font-weight:700;color:var(--ink);pointer-events:none}
.navbar-home,.navbar-exit{height:60rpx;line-height:60rpx;padding:0 26rpx;border-radius:var(--r-pill);font-size:25rpx;font-weight:600;transition:transform .16s ease}
.navbar-home{color:#fff;background:var(--grad-icon)}
.navbar-exit{color:var(--ink-2);background:var(--surface);box-shadow:inset 0 0 0 1rpx var(--line)}

.admin-body{padding:0 28rpx}
.banner{position:relative;overflow:hidden;margin:12rpx 0 20rpx;padding:40rpx 36rpx;border-radius:var(--r-xl);background:var(--grad-hero);color:#fff;box-shadow:0 24rpx 48rpx -20rpx rgba(44,90,67,.6),inset 0 1rpx 0 rgba(255,255,255,.25)}
.banner::before{content:'';position:absolute;right:-80rpx;top:-100rpx;width:320rpx;height:320rpx;border-radius:50%;background:radial-gradient(circle,rgba(255,255,255,.24) 0%,rgba(255,255,255,0) 70%)}
.banner .hello{position:relative;font-size:40rpx;font-weight:700;letter-spacing:1rpx}
.banner .sub{position:relative;margin-top:8rpx;font-size:24rpx;color:rgba(255,255,255,.82)}

.stat-grid{display:flex;flex-wrap:wrap;gap:16rpx}
.stat-card{box-sizing:border-box;width:calc((100% - 32rpx) / 3);padding:26rpx 24rpx;border-radius:var(--r-lg);background:var(--surface);box-shadow:var(--sh-1);transition:transform .16s ease}
.stat-card .k{display:flex;align-items:center;justify-content:space-between;font-size:23rpx;color:var(--ink-3)}
.stat-card .go{font-size:30rpx;line-height:1;color:var(--ink-4)}
.stat-card .v{margin-top:6rpx;font-size:44rpx;font-weight:700;line-height:1.2;color:var(--ink);font-variant-numeric:tabular-nums}
.stat-card.hl{background:var(--brand-50);box-shadow:inset 0 0 0 1rpx var(--brand-200)}
.stat-card.hl .go,.stat-card.hl .v{color:var(--brand)}
.admin-note{margin:16rpx 8rpx 0;font-size:21rpx;color:var(--ink-3)}

.sec-title{display:flex;align-items:center;gap:12rpx;margin:40rpx 8rpx 18rpx;font-size:29rpx;font-weight:700;color:var(--ink)}
.sec-sub{font-size:22rpx;font-weight:400;color:var(--ink-3)}
.cnt{display:inline-flex;align-items:center;justify-content:center;min-width:36rpx;height:36rpx;padding:0 10rpx;box-sizing:border-box;border-radius:var(--r-pill);background:var(--line-2);color:var(--ink-3);font-size:21rpx;font-weight:700;font-variant-numeric:tabular-nums}
.cnt.on{background:var(--brand);color:#fff}
.empty-card{padding:44rpx 0;border-radius:var(--r-lg);background:var(--surface);box-shadow:var(--sh-1);text-align:center;font-size:25rpx;color:var(--ink-4)}
.card{margin-bottom:14rpx;padding:28rpx;border-radius:var(--r-lg);background:var(--surface);box-shadow:var(--sh-1)}
.muted{font-size:22rpx;color:var(--ink-3)}
.mono{font-family:monospace;font-size:27rpx;font-weight:700}

.admin-login .field{width:100%}.admin-login .btn{margin:28rpx 0 6rpx}
.login-hint{margin-top:12rpx;font-size:22rpx;color:var(--ink-3);text-align:center}

.apply-head{display:flex;align-items:center;gap:14rpx}.apply-name{font-size:30rpx;font-weight:700}.apply-time{margin-left:auto}
.apply-line{display:flex;align-items:center;justify-content:space-between;padding:14rpx 0;border-bottom:1rpx solid var(--line)}
.action-row{display:flex;gap:16rpx;margin-top:18rpx}.action-row .btn{flex:1;margin:0}
.btn.light{background:var(--brand-50);color:var(--brand)}

.cs-conv{margin-bottom:14rpx;padding:26rpx 28rpx;border-radius:var(--r-lg);background:var(--surface);box-shadow:var(--sh-1)}
.cc-head{display:flex;align-items:center;justify-content:space-between;gap:16rpx}
.cc-name{min-width:0;overflow:hidden;white-space:nowrap;text-overflow:ellipsis;font-size:28rpx;font-weight:700;color:var(--ink)}
.cc-user{flex:none;font-size:21rpx;color:var(--ink-4)}
.cc-last{margin-top:10rpx;overflow:hidden;white-space:nowrap;text-overflow:ellipsis;font-size:24rpx;color:var(--ink-2)}
.cs-conv.open .cc-last{white-space:normal}
.cc-time{margin-top:6rpx;font-size:21rpx;color:var(--ink-4);font-variant-numeric:tabular-nums}
.support-thread{display:flex;flex-direction:column;gap:12rpx;margin-top:20rpx;padding-top:20rpx;border-top:1rpx solid var(--line)}
.support-message{max-width:82%;padding:16rpx 18rpx;box-sizing:border-box;border-radius:18rpx;background:#f0f2f0;font-size:24rpx;line-height:1.5;overflow-wrap:anywhere}
.support-message.team{align-self:flex-end;background:var(--brand-50)}
.support-message text{display:block;margin-top:5rpx;font-size:18rpx;color:var(--ink-3)}
.support-photo{width:160rpx;height:160rpx;border-radius:12rpx}
.support-compose{display:flex;align-items:center;gap:12rpx;margin-top:18rpx}
.support-compose input{flex:1;min-width:0;height:68rpx;padding:0 22rpx;box-sizing:border-box;border:1rpx solid var(--line);border-radius:34rpx;background:#fff;font-size:24rpx}
.support-compose button{flex:none;width:104rpx;height:64rpx;min-height:64rpx;margin:0;padding:0;border-radius:32rpx;background:var(--brand);color:#fff;font-size:22rpx;line-height:64rpx}
.support-compose button::after{border:0}.support-compose button[disabled]{opacity:.4}

.order-list{padding:6rpx 28rpx}
.order-row{display:flex;align-items:center;gap:16rpx;padding:20rpx 0;border-bottom:1rpx solid var(--line)}.order-row:last-child{border-bottom:0}
.order-main{flex:1;min-width:0}
.order-title{overflow:hidden;white-space:nowrap;text-overflow:ellipsis;font-size:26rpx;font-weight:700}
.order-badge{margin-left:10rpx;padding:2rpx 12rpx;border-radius:8rpx;background:var(--line-2);font-size:20rpx;font-weight:400;color:var(--ink-3);vertical-align:middle}
.order-side{flex:none;text-align:right}
.order-money{font-size:28rpx;font-weight:700;color:var(--brand)}
.order-status{margin-top:4rpx;font-size:21rpx;font-weight:700;color:var(--ink-3)}

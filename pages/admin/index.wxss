.admin-page{min-height:100vh;padding-bottom:80rpx}.admin-head .row{align-items:flex-start}.admin-logout{flex:none;margin-top:6rpx;padding:12rpx 26rpx;border:1rpx solid #deded7;border-radius:40rpx;background:#fff;color:#41775b;font-size:24rpx;font-weight:700}.admin-press{opacity:.75;transform:scale(.97)}
.admin-login .field{width:100%}.admin-login .btn{margin:28rpx 0 6rpx}
.stat-grid{display:flex;flex-wrap:wrap;gap:16rpx}.stat-card{box-sizing:border-box;width:calc((100% - 32rpx) / 3);background:#fff;border:1rpx solid #deded7;border-radius:27rpx;padding:22rpx 22rpx 24rpx;transition:transform .18s ease,border-color .18s ease,box-shadow .18s ease}.stat-card.active{border:2rpx solid #41775b;background:#f4f8f6;box-shadow:0 8rpx 22rpx #41775b1f}.stat-top{display:flex;align-items:center;justify-content:space-between;color:#75766d;font-size:24rpx}.stat-chevron{font-size:32rpx;line-height:1;color:#b0afa6}.stat-card.active .stat-chevron{color:#41775b}.stat-value{font-family:monospace;font-size:52rpx;line-height:1.25;font-weight:800;color:#191b1d;margin-top:14rpx}.stat-card.active .stat-value{color:#41775b}
.admin-note{margin:16rpx 4rpx 0;font-size:21rpx}
.apply-card .row{align-items:center}.apply-name{font-size:30rpx}.apply-line{padding:14rpx 0;border-bottom:1rpx solid #eeeee8}.apply-line .hint{margin:0}.mono{font-family:monospace;font-weight:700;font-size:27rpx}.apply-card .action-row{display:flex;gap:16rpx;margin-top:18rpx}.apply-card .action-row .btn{flex:1;margin:0}.btn.light{background:#eff6f4;color:#41775b}
.order-list{padding:6rpx 26rpx}.order-row{display:flex;align-items:center;gap:16rpx;padding:20rpx 0;border-bottom:1rpx solid #eeeee8}.order-row:last-child{border-bottom:0}.order-main{flex:1;min-width:0}.order-main .strong{font-size:26rpx;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.order-main .hint{margin:6rpx 0 0;font-size:21rpx}.order-badge{margin-left:10rpx;font-weight:400;vertical-align:middle}.order-side{flex:none;text-align:right}.order-money{font-size:28rpx}.order-status{font-size:21rpx;font-weight:700;margin-top:4rpx}

.phone-tag{margin-left:auto;margin-right:12rpx;padding:2rpx 12rpx;border-radius:8rpx;font-size:20rpx;font-weight:700}.phone-tag.ok{background:#e3f2e8;color:#2f7a4c}.phone-tag.warn{background:#f4faf6;color:#41775b}

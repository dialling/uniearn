<view style="{{motionStyle}}">
<lang-switch></lang-switch>
<view class="admin-page {{darkClass}}">
<view class="navbar" style="padding-top:{{navTop}}px;height:{{navHeight}}px">
 <view class="navbar-btns">
  <view class="navbar-home" hover-class="admin-press" bindtap="home">{{zh?'首页':'Home'}}</view>
  <view wx:if="{{admin}}" class="navbar-exit" hover-class="admin-press" bindtap="logout">{{zh?'退出':'Log out'}}</view>
 </view>
 <view class="navbar-title" style="line-height:{{navHeight}}px">{{zh?'管理后台':'Admin'}}</view>
</view>
<view class="admin-body">
<view wx:if="{{error}}" class="notice-error">{{error}}</view>
<view wx:if="{{checking && !admin}}" class="empty-card">{{zh?'正在检查管理员身份…':'Checking admin access…'}}</view>
<block wx:elif="{{!admin}}">
<view class="banner"><view class="hello">{{zh?'管理员登录':'Admin login'}}</view><view class="sub">{{zh?'仅限 Uniearn 管理员使用':'For Uniearn admins only'}}</view></view>
<view class="card admin-login"><view class="field-label">{{zh?'管理员账号':'Username'}}</view><input class="field" value="{{username}}" data-field="username" bindinput="field" placeholder="{{zh?'输入账号':'Username'}}" disabled="{{busy}}"/><view class="field-label">{{zh?'密码':'Password'}}</view><input class="field" password="{{true}}" value="{{password}}" data-field="password" bindinput="field" bindconfirm="login" placeholder="{{zh?'输入密码':'Password'}}" disabled="{{busy}}"/><button class="btn" bindtap="login" loading="{{motionEnabled && (busy)}}" disabled="{{busy}}">{{zh?'登录':'Log in'}}</button><view class="login-hint">{{zh?'连续输错 5 次将锁定 15 分钟。':'Five wrong attempts lock login for 15 minutes.'}}</view></view>
</block>
<block wx:else>
<view class="banner"><view class="hello">{{zh?'管理后台':'Admin console'}}</view><view class="sub">{{zh?'管理员':'Admin'}}<block wx:if="{{username}}"> · {{username}}</block></view></view>
<view class="stat-grid"><view wx:for="{{cards}}" wx:key="key" class="stat-card {{item.key===bucket?'hl':''}}" hover-class="{{item.tap?'admin-press':'none'}}" data-key="{{item.key}}" bindtap="pick"><view class="k"><text>{{item.label}}</text><text wx:if="{{item.tap}}" class="go">›</text></view><view class="v">{{item.value}}</view></view></view>
<view class="admin-note">{{zh?'未付款：已送达、等待发布人确认结算的订单。':'Unpaid: delivered orders still waiting for the student to confirm.'}}</view>

<view class="sec-title">{{zh?'跑腿员认证审核':'Runner applications'}}<text class="cnt {{applications.length?'on':''}}">{{applications.length}}</text></view>
<view wx:if="{{!applications.length}}" class="empty-card">{{zh?'暂无待审核的跑腿员认证':'No runner applications waiting'}}</view>
<view wx:for="{{applications}}" wx:key="accountId" class="card apply-card"><view class="apply-head"><text class="apply-name">{{item.realName}}</text><text wx:if="{{item.gender}}" class="muted">{{item.gender==='male'?(zh?'男':'Male'):(zh?'女':'Female')}}</text><text class="muted apply-time">{{item.time}}</text></view><view class="apply-line" data-value="{{item.phone}}" bindtap="copy"><text class="muted">{{zh?'手机号':'Phone'}}</text><text class="mono">{{item.phone}}</text></view><view class="apply-line" data-value="{{item.studentId}}" bindtap="copy"><text class="muted">{{zh?'学号':'Student ID'}}</text><text class="mono">{{item.studentId}}</text></view><view class="action-row"><button class="btn light" data-id="{{item.accountId}}" bindtap="reject" disabled="{{!!reviewing}}">{{zh?'驳回':'Reject'}}</button><button class="btn" data-id="{{item.accountId}}" bindtap="approve" loading="{{motionEnabled && (reviewing===item.accountId)}}" disabled="{{!!reviewing}}">{{zh?'通过':'Approve'}}</button></view></view>

<view class="sec-title">{{zh?'客服留言':'Support messages'}}<text class="cnt {{supportInbox.length?'on':''}}">{{supportInbox.length}}</text></view>
<view wx:if="{{!supportInbox.length}}" class="empty-card">{{zh?'暂无客服留言':'No support messages'}}</view>
<view wx:for="{{supportInbox}}" wx:key="id" class="cs-conv {{openTicket===item.id?'open':''}}">
 <view class="cc-tap" hover-class="admin-press" data-id="{{item.id}}" bindtap="toggleTicket">
  <view class="cc-head"><view class="cc-name">{{item.topicLabel}}</view><text class="cc-user">{{zh?'用户':'User'}} {{item.accountLabel}}</text></view>
  <view class="cc-last">{{item.lastText}}</view><view class="cc-time">{{item.time}}</view>
 </view>
 <block wx:if="{{openTicket===item.id}}">
 <view class="support-thread"><view wx:for="{{item.messages}}" wx:for-item="message" wx:key="at" class="support-message {{message.fromUser?'customer':'team'}}"><view>{{message.text}}</view><image wx:if="{{message.photo}}" src="{{message.photo}}" mode="aspectFill" class="support-photo"/><text>{{message.mine?(zh?'用户':'User'):(zh?'团队':'Team')}} · {{message.time}}</text></view></view>
 <view class="support-compose"><input value="{{supportDraft[item.id]}}" data-id="{{item.id}}" data-account="{{item.accountId}}" data-ticket="{{item.id}}" bindinput="supportInput" bindconfirm="supportReply" confirm-type="send" placeholder="{{zh?'回复用户…':'Reply…'}}"/><button class="btn light" data-id="{{item.id}}" bindtap="sendSupportImage" disabled="{{!!replying}}">{{zh?'图片':'Image'}}</button><button data-account="{{item.accountId}}" data-ticket="{{item.id}}" bindtap="supportReply" loading="{{motionEnabled && (replying===item.id)}}" disabled="{{!!replying||!supportDraft[item.id]}}">{{zh?'发送':'Send'}}</button></view>
 </block>
</view>

<view class="sec-title">{{bucketLabel}}<text class="sec-sub">{{zh?'最近 50 单':'Latest 50 orders'}}</text></view>
<view wx:if="{{ordersLoading}}" class="empty-card">{{zh?'加载中…':'Loading…'}}</view>
<view wx:elif="{{!orders.length}}" class="empty-card">{{zh?'暂无订单':'No orders'}}</view>
<view wx:else class="card order-list"><view wx:for="{{orders}}" wx:key="id" class="order-row"><view class="order-main"><view class="order-title">{{item.title||item.categoryText}}<text class="order-badge">{{item.categoryText}}</text></view><view class="muted">{{item.place||'—'}} · {{item.time}}</view></view><view class="order-side"><view class="order-money">¥{{item.reward}}</view><view class="order-status status-{{item.status}}">{{item.statusText}}</view></view></view></view>
</block>
</view>
</view>
</view>

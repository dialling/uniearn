<lang-switch/>
<view class="v8-page admin-page">
<view class="summary-head admin-head"><view class="row"><view><view class="flow-title">{{admin?(zh?'管理后台':'Admin console'):(zh?'管理员登录':'Admin login')}}</view><view class="flow-sub">{{admin?(zh?'订单数据与跑手审核':'Order data and runner reviews'):(zh?'仅限 XP 跑了么管理员使用':'For UniEarn admins only')}}</view></view><view wx:if="{{admin}}" class="admin-logout" hover-class="admin-press" bindtap="logout">{{zh?'退出':'Log out'}}</view></view></view>
<view wx:if="{{error}}" class="notice-error">{{error}}</view>
<view wx:if="{{checking && !admin}}" class="hint center">{{zh?'正在检查管理员身份…':'Checking admin access…'}}</view>
<block wx:elif="{{!admin}}"><view class="flow-card admin-login"><view class="field-label">{{zh?'管理员账号':'Username'}}</view><input class="field" value="{{username}}" data-field="username" bindinput="field" placeholder="{{zh?'输入账号':'Username'}}" disabled="{{busy}}"/><view class="field-label">{{zh?'密码':'Password'}}</view><input class="field" password="{{true}}" value="{{password}}" data-field="password" bindinput="field" bindconfirm="login" placeholder="{{zh?'输入密码':'Password'}}" disabled="{{busy}}"/><button class="btn" bindtap="login" loading="{{busy}}" disabled="{{busy}}">{{zh?'登录':'Log in'}}</button><view class="hint">{{zh?'连续输错 5 次将锁定 15 分钟。':'Five wrong attempts lock login for 15 minutes.'}}</view></view></block>
<block wx:else>
<view class="stat-grid"><view wx:for="{{cards}}" wx:key="key" class="stat-card {{item.tap?'tappable':''}} {{item.key===bucket?'active':''}}" hover-class="{{item.tap?'admin-press':'none'}}" data-key="{{item.key}}" bindtap="pick"><view class="stat-top"><text>{{item.label}}</text><text wx:if="{{item.tap}}" class="stat-chevron">›</text></view><view class="stat-value">{{item.value}}</view></view></view>
<view class="hint admin-note">{{zh?'未付款：已送达、等待发布人确认结算的订单。':'Unpaid: delivered orders still waiting for the student to confirm.'}}</view>
<view class="section row"><text>{{zh?'待审核跑手':'Runner applications'}} · {{applications.length}}</text></view>
<view wx:if="{{!applications.length}}" class="flow-card hint center">{{zh?'暂无待审核申请':'No applications waiting'}}</view>
<view wx:for="{{applications}}" wx:key="accountId" class="flow-card apply-card"><view class="row"><text class="strong apply-name">{{item.realName}}</text><text class="hint">{{item.time}}</text></view><view class="row apply-line" data-value="{{item.phone}}" bindtap="copy"><text class="hint">{{zh?'手机号':'Phone'}}</text><text class="mono">{{item.phone}}</text></view><view class="row apply-line" data-value="{{item.studentId}}" bindtap="copy"><text class="hint">{{zh?'学号':'Student ID'}}</text><text class="mono">{{item.studentId}}</text></view><view class="action-row"><button class="btn light" data-id="{{item.accountId}}" bindtap="reject" disabled="{{!!reviewing}}">{{zh?'拒绝':'Reject'}}</button><button class="btn" data-id="{{item.accountId}}" bindtap="approve" loading="{{reviewing===item.accountId}}" disabled="{{!!reviewing}}">{{zh?'通过':'Approve'}}</button></view></view>
<view class="section row"><text>{{bucketLabel}} · {{zh?'最近 50 单':'latest 50'}}</text></view>
<view wx:if="{{ordersLoading}}" class="flow-card hint center">{{zh?'加载中…':'Loading…'}}</view>
<view wx:elif="{{!orders.length}}" class="flow-card hint center">{{zh?'暂无订单':'No orders'}}</view>
<view wx:else class="flow-card order-list"><view wx:for="{{orders}}" wx:key="id" class="order-row"><view class="order-main"><view class="strong">{{item.title||item.categoryText}}<text class="badge order-badge">{{item.categoryText}}</text></view><view class="hint">{{item.place||'—'}} · {{item.time}}</view></view><view class="order-side"><view class="money order-money">¥{{item.reward}}</view><view class="order-status status-{{item.status}}">{{item.statusText}}</view></view></view></view>
</block>
</view>

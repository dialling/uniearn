@import "../../utils/flow.wxss";
/* 2026-11-15 redesign: trip ticket, three steps, one full-width button. Same family as Start a trip / takeaway. */
.jn-page{padding:0 32rpx calc(260rpx + env(safe-area-inset-bottom));background:#eeede8}
.jn-head{padding:36rpx 4rpx 8rpx}
.jn-title{font-size:44rpx;font-weight:800;color:#16181c;letter-spacing:-.5rpx}
.jn-lead{margin-top:8rpx;font-size:26rpx;line-height:1.5;color:#6b6860}

/* trip ticket: light green, matching the Start a trip card */
.jn-ticket{position:relative;overflow:hidden;margin-top:24rpx;padding:32rpx 30rpx 28rpx;border-radius:40rpx;background:linear-gradient(135deg,#5fd69f 0%,#2fbf83 45%,#1aa56f 100%);color:#fff;box-shadow:0 12rpx 28rpx rgba(31,174,116,.28)}
.jn-ticket::before{content:'';position:absolute;right:-70rpx;top:-80rpx;width:260rpx;height:260rpx;border-radius:50%;background:rgba(255,255,255,.12)}
.jn-route{position:relative;display:flex;gap:20rpx}
.jn-rail{display:flex;flex-direction:column;align-items:center;padding-top:14rpx}
.jn-dot{width:18rpx;height:18rpx;border-radius:50%;box-sizing:border-box}
.jn-dot-from{border:4rpx solid #fff}
.jn-dot-to{background:#fff}
.jn-line{flex:1;min-height:52rpx;margin:6rpx 0;border-left:3rpx dashed rgba(255,255,255,.7)}
.jn-stops{flex:1;min-width:0;display:flex;flex-direction:column;gap:18rpx}
.jn-stop{display:flex;flex-direction:column;gap:2rpx}
.jn-stop-label{font-size:22rpx;color:#e3f7ec}
.jn-stop-place{font-size:32rpx;font-weight:800;line-height:1.3;overflow-wrap:anywhere}
.jn-via{margin:12rpx 0 0 38rpx;font-size:23rpx;color:#e3f7ec}
.jn-facts{position:relative;display:flex;gap:16rpx;margin-top:26rpx}
.jn-fact{flex:1;display:flex;align-items:baseline;gap:10rpx;padding:16rpx 20rpx;border-radius:24rpx;background:rgba(255,255,255,.18)}
.jn-fact.is-hot{background:#ffd34d;color:#5a3b00}
.jn-fact-num{font-size:40rpx;font-weight:800;line-height:1;font-variant-numeric:tabular-nums}
.jn-fact-label{font-size:22rpx;font-weight:600;line-height:1.3}
.jn-runner{position:relative;display:flex;align-items:center;gap:18rpx;margin-top:22rpx;padding-top:22rpx;border-top:2rpx solid rgba(255,255,255,.25)}
.jn-runner-copy{min-width:0}
.jn-runner-name{font-size:28rpx;font-weight:800}
.jn-runner-sub{margin-top:2rpx;font-size:22rpx;color:#e3f7ec}

.jn-closed{margin-top:20rpx;padding:20rpx 24rpx;border-radius:24rpx;background:#fdeee4;color:#b4501f;font-size:25rpx;font-weight:700}

/* steps: a real sequence, so numbered */
.jn-steps{margin-top:24rpx;padding:30rpx 28rpx;border:0;border-radius:40rpx;background:#fff;box-shadow:none}
.jn-steps-title{margin-bottom:8rpx;font-size:30rpx;font-weight:800;color:#16181c}
.jn-step{display:flex;gap:20rpx;padding:20rpx 0}
.jn-step+.jn-step{border-top:2rpx solid #f1f0eb}
.jn-step-no{flex:none;width:48rpx;height:48rpx;line-height:48rpx;border-radius:50%;background:#fdeee4;color:#c2410c;text-align:center;font-size:24rpx;font-weight:800}
.jn-step-copy{flex:1;min-width:0}
.jn-step-name{font-size:28rpx;font-weight:800;color:#16181c}
.jn-step-text{margin-top:4rpx;font-size:24rpx;line-height:1.5;color:#6b6860}
.jn-private{display:flex;align-items:center;gap:14rpx;margin-top:12rpx;padding:18rpx 20rpx;border-radius:22rpx;background:#f6f5f1;font-size:23rpx;line-height:1.45;color:#5e5c55}
.jn-private-icon{flex:none;width:40rpx;height:40rpx}

.jn-bottom{padding:18rpx 32rpx calc(22rpx + env(safe-area-inset-bottom));box-shadow:0 -6rpx 24rpx #0000000d}
.jn-bottom-hint{margin:0 6rpx 12rpx;font-size:23rpx;color:#6b6860}
.jn-go{display:block;width:100%!important;height:96rpx;line-height:96rpx;margin:0 0 12rpx!important;padding:0;border-radius:28rpx;font-size:30rpx;font-weight:800}
.jn-page .jn-go.orange{background:#c2410c;color:#fff;box-shadow:0 8rpx 0 #9a3412}
.jn-go-alt{background:#fff;color:#c2410c;border:2rpx solid #f2c9ad}
.jn-go[disabled]{background:#e4e1d8!important;color:#8a877e!important;box-shadow:none!important}

.jn-gone{display:flex;flex-direction:column;align-items:center;text-align:center;margin-top:60rpx;padding:40rpx 32rpx;border-radius:40rpx}
.jn-gone-yuni{width:160rpx;height:160rpx}
.jn-gone-title{margin-top:10rpx;font-size:30rpx;font-weight:800;color:#16181c}
.jn-gone-text{margin:8rpx 0 26rpx;font-size:24rpx;line-height:1.5;color:#6b6860}

.page-dark.jn-page{background:#1b1d1a}
.page-dark .jn-title,.page-dark .jn-steps-title,.page-dark .jn-step-name,.page-dark .jn-gone-title{color:#edebe4}
.page-dark .jn-steps{background:#252a28}
.page-dark .jn-step+.jn-step{border-top-color:#333832}
.page-dark .jn-private{background:#1f2321;color:#b7c0b3}
.page-dark .jn-ticket{background:linear-gradient(135deg,#2aa874 0%,#178a5c 100%);box-shadow:none}
.jn-go-wechat{background:#07c160!important;color:#fff!important;box-shadow:0 8rpx 0 #05a050}

/* 2026-11-15 Figma: label above the value in each fact pill */
.jn-fact{flex-direction:column;align-items:flex-start;gap:4rpx}
.jn-fact-num{font-size:34rpx}
.jn-fact-label{font-size:21rpx;opacity:.9}
.jn-stop-label{font-size:22rpx}
.jn-consent{margin:0 6rpx 10rpx;font-size:22rpx;line-height:1.5;color:#7a776e;text-align:center}
.jn-consent-link{color:#0b7a55;font-weight:700}

<wxs src="../../utils/dorm-label.wxs" module="dl"/>
<view style="{{motionStyle}}">
<lang-switch></lang-switch>
<!-- 2026-11-15 redesign: the trip as a ticket, then three steps to add and pay, one full-width button. -->
<view class="flow-page jn-page {{darkClass}}">
 <view wx:if="{{trip}}">
  <view class="jn-head">
   <view class="jn-title">{{zh?'加入行程':'Join a trip'}}</view>
   <view class="jn-lead">{{trip.category==='takeout'?(zh?'同学正好去取外卖，把你的也一起带回来。':'A student is picking up takeaway. Add yours to their trip.'):trip.category==='parcel'?(zh?'同学正好去快递站，把你的快递也一起带回来。':'A student is going to the parcel station. Add yours to their trip.'):(zh?'同学正好顺路，把你的需求加到这趟行程。':'A student is on their way. Add what you need to their trip.')}}</view>
  </view>

  <view class="jn-ticket">
   <view class="jn-route">
    <view class="jn-rail"><view class="jn-dot jn-dot-from"/><view class="jn-line"/><view class="jn-dot jn-dot-to"/></view>
    <view class="jn-stops">
     <view class="jn-stop"><text class="jn-stop-label">{{zh?'跑手去这里取':'Runner picks up at'}}</text><text class="jn-stop-place">{{tripStationLabel||names[trip.station]||trip.station}}</text></view>
     <view class="jn-stop"><text class="jn-stop-label">{{zh?'送到这里':'And brings it to'}}</text><text class="jn-stop-place">{{trip.destinationType==='place'?(trip.deliveryAddress||trip.dorm):dl.labels(trip,zh)}}</text></view>
    </view>
   </view>
   <view wx:if="{{trip.waypoint}}" class="jn-via">{{zh?'途经：':'Via: '}}{{trip.waypoint}}</view>
   <view class="jn-facts">
    <view class="jn-fact {{open && minutes<=3?'is-hot':''}}"><text class="jn-fact-label">{{zh?'还可加入':'Join within'}}</text><text class="jn-fact-num">{{minutes}} {{zh?'分钟':'min'}}</text></view>
    <view class="jn-fact"><text class="jn-fact-label">{{zh?'还能带':'Room for'}}</text><text class="jn-fact-num">{{remaining}} {{trip.category==='takeout'?(zh?'袋':(remaining===1?'bag':'bags')):(zh?'件':(remaining===1?'item':'items'))}}</text></view>
   </view>
   <view class="jn-runner"><contact-avatar name="{{trip.runnerName}}" src="{{trip.runnerAvatar}}"/><view class="jn-runner-copy"><view class="jn-runner-name">{{trip.runnerName||(zh?'跑手':'Runner')}}</view><view class="jn-runner-sub">{{zh?'已认证学生 · 已完成 '+(trip.runnerJobs||0)+' 单':'Verified student · '+(trip.runnerJobs||0)+' jobs done'}}</view></view></view>
  </view>

  <view wx:if="{{!open}}" class="jn-closed">{{zh?'这个行程已满或已停止加入。':'This trip is full or closed to new orders.'}}</view>

  <view class="flow-card jn-steps">
   <view class="jn-steps-title">{{zh?'怎么运作':'How it works'}}</view>
   <view class="jn-step"><text class="jn-step-no">1</text><view class="jn-step-copy"><view class="jn-step-name">{{trip.category==='takeout'?(zh?'添加你的外卖':'Add your takeaway'):trip.category==='parcel'?(zh?'添加你的快递':'Add your parcel'):(zh?'写下你的需求':'Say what you need')}}</view><view class="jn-step-text">{{zh?'填写房间号和电话，设置赏金。':'Add your room and phone, and set your offer.'}}</view></view></view>
   <view class="jn-step"><text class="jn-step-no">2</text><view class="jn-step-copy"><view class="jn-step-name">{{zh?'跑手确认':'The runner confirms'}}</view><view class="jn-step-text">{{zh?'订单也会出现在接单大厅，其他跑手也可以接。':'Your order is also on the job board, so another runner can take it too.'}}</view></view></view>
   <view class="jn-step"><text class="jn-step-no">3</text><view class="jn-step-copy"><view class="jn-step-name">{{zh?'送到你手上':'Delivered to you'}}</view><view class="jn-step-text">{{zh?'跑手取到和送达时都会通知你。':'You get a message when itʼs picked up and delivered.'}}</view></view></view>
   <view class="jn-private"><image class="jn-private-icon" mode="aspectFit" src="/assets/icons3d/note.svg"/><text>{{zh?'只有这趟行程的跑手能看到你的取件信息。':'Only this tripʼs runner can see your pickup details.'}}</text></view>
  </view>

  <view class="flow-bottom jn-bottom">
   <view wx:if="{{trip.category==='other'}}" class="jn-bottom-hint">{{zh?'选择要加入的订单类型，首次加入后本趟将固定该类型。':'Choose an order type. The first order sets the type for this trip.'}}</view>
   <button wx:if="{{trip.category==='other'}}" class="btn jn-go jn-go-alt" disabled="{{!open}}" data-category="takeout" bindtap="join">{{zh?'添加我的外卖':'Add my takeaway'}}</button>
   <button class="btn orange jn-go" disabled="{{!open}}" data-category="parcel" bindtap="join">{{trip.category==='takeout'?(zh?'添加我的外卖':'Add my takeaway'):trip.category==='parcel'?(zh?'添加我的快递':'Add my parcel'):(zh?'添加我的订单':'Add my order')}}</button>
   <view wx:if="{{!signedIn}}" class="jn-consent">{{zh?'加入即表示你同意':'By joining you agree to the '}}<text class="jn-consent-link" bindtap="terms">{{zh?'《用户协议》':'Terms'}}</text>{{zh?'和':' and '}}<text class="jn-consent-link" bindtap="privacy">{{zh?'《隐私政策》':'Privacy Policy'}}</text>{{zh?'，将用微信登录。':'. We sign you in with WeChat.'}}</view>
   
  </view>
 </view>
 <view wx:else class="flow-card jn-gone"><image class="jn-gone-yuni" mode="aspectFit" src="/assets/yuni-wave.png"/><view class="jn-gone-title">{{zh?'这个行程不可用或已关闭':'This trip is unavailable or closed'}}</view><view class="jn-gone-text">{{zh?'请检查网络，并询问跑手是否仍可加入。':'Check your connection and ask the runner whether joining is still open.'}}</view><button class="btn jn-go" bindtap="jobs">{{zh?'浏览接单大厅':'Browse Jobs'}}</button></view>
</view>
<yuni-assistant topic=""/>
</view>

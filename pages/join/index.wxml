<view class="flow-page"><view class="flow-title">{{zh?'加入行程':'Join a trip'}}</view><view wx:if="{{trip}}"><view class="banner"><view class="route">{{names[trip.station]||trip.station}} → {{trip.dorm}}</view><view class="row"><text>{{zh?minutes+' 分钟内可加入':'Join within '+minutes+' min'}}</text><text>{{zh?'还能装 '+remaining+(trip.category==='takeout'?' 袋':' 件'):'Room for '+remaining+' '+(trip.category==='takeout'?'bags':'boxes')}}</text></view><view class="divider"/><view>{{zh?(trip.runnerName||'校园帮手')+' · 已完成 '+(trip.runnerJobs||0)+' 单':(trip.runnerName||'Runner')+' · '+(trip.runnerJobs||0)+' done'}}</view></view><view class="flow-card"><view class="strong">{{trip.category==='takeout'?(zh?'添加你的外卖':'Add your takeaway'):(zh?'添加你的取件通知':'Add your pickup notice')}}</view><view class="hint">{{trip.category==='takeout'?(zh?'使用已保存的路线，核对外卖袋上的手机号，并填写送达时间。':'Use a saved route, check the phone on the bag, and add your arrival time.'):(zh?'粘贴取件短信或选择截图，确认快递站和每个取件码。':'Paste your pickup message or choose a screenshot. Confirm the station and each code.')}}</view><view class="hint">{{zh?'只有接单的校园帮手能看到你的取件信息。':'Only the accepting runner can view your pickup details.'}}</view></view><view wx:if="{{!open}}" class="orange-note">{{zh?'这个行程已满或已停止加入。':'This trip is full or closed to new orders.'}}</view><view class="flow-bottom"><button class="btn orange" disabled="{{!open}}" bindtap="join">{{zh?'添加我的订单':'Add my order'}}</button><view class="preview-label">{{zh?'团队测试 · 不会扣款':'Team test · no payment is taken'}}</view></view></view><view wx:else class="flow-card"><view class="strong">{{zh?'这个行程不可用或已关闭':'This trip is unavailable or closed'}}</view><view class="hint">{{zh?'请检查网络，并询问校园帮手是否仍可加入。':'Check your connection and ask the runner whether joining is still open.'}}</view><button class="btn" bindtap="jobs">{{zh?'浏览任务大厅':'Browse Jobs'}}</button></view></view>

<lang-switch/>
<view class="flow-page earnings-page {{darkClass}}"><view class="earnings-header"><view class="flow-title">{{zh?'收益':'Earnings'}}</view><view class="flow-sub">{{runnerName}} · {{runnerLevel}} · {{zh?'从“我的”进入':'opened from Me'}}</view></view><view class="earnings-content"><view class="flow-card"><view class="row"><text class="strong">{{zh?'最近 7 天':'Last 7 days'}}</text><text class="hint">{{zh?tripCount+' 趟行程 · '+week.weekJobs+' 单':tripCount+' trips · '+week.weekJobs+' jobs'}}</text></view><view class="amount money">¥{{week.earnTotal}}</view><view class="earnings-legend"><text class="legend-dot paid-dot"></text><text>{{zh?'已结算':'Paid'}} ¥{{week.earnPaid}}</text><text class="legend-dot waiting-dot"></text><text>{{zh?'待确认':'Waiting'}} ¥{{week.earnWaiting}}</text><text class="legend-dot deduction-dot"></text><text>{{zh?'已扣回':'Taken back'}} −¥{{takenBackTotal}}</text></view><view class="bars"><view wx:for="{{week.weekBars}}" wx:key="day" class="bar-column"><view class="bar-stack"><view class="bar waiting-bar" style="height:{{item.waitingHeight}}rpx"/><view class="bar" style="height:{{item.paidHeight}}rpx"/></view><text>{{item.day}}</text></view></view></view><view class="green-note">{{zh?'仅为预览余额，未接入微信转账或提现。':'Preview balance only. No WeChat transfer or withdrawal is connected.'}}</view><view class="row earnings-section"><text>{{zh?'待确认':'Waiting'}} · ¥{{waiting}}</text><text class="hint">{{zh?'等待同学确认':'Pending confirmation'}}</text></view><view class="flow-card compact" wx:if="{{pending.length}}"><view wx:for="{{pending}}" wx:key="id" class="earning-item"><view><view class="strong">{{item.owner}} · {{zh?'房间号':'Room'}} {{item.room}} · {{item.boxes}} {{zh?(item.unit==='bags'?'袋':item.unit==='boxes'?'件':'个任务'):item.unit}}</view><view class="hint">{{zh?item.deliveredTime+' 送达 · '+item.autoTime+' 自动确认':'Delivered '+item.deliveredTime+' · auto-confirms '+item.autoTime}}</view></view><text class="strong">¥{{item.earnedText}}</text></view></view><view wx:if="{{!pending.length}}" class="hint">{{zh?'暂无待确认的收益。':'No payments waiting for confirmation.'}}</view><view class="flow-card" wx:if="{{held.length}}"><view class="strong">{{zh?'暂停结算':'Settlement paused'}}</view><view wx:for="{{held}}" wx:key="id" class="row hint"><text>{{item.owner}} · {{names[item.dispute.reason]||item.dispute.reason}}</text><text>¥{{item.earnedText}}</text></view></view><view class="row earnings-section"><text>{{zh?'行程与任务':'Trips and tasks'}}</text><text class="hint">{{zh?'最新在前':'newest first'}}</text></view><view class="flow-card compact"><view wx:for="{{trips}}" wx:key="id" class="earning-item trip-item" data-id="{{item.id}}" bindtap="open"><view class="trip-main"><view class="trip-title"><text class="badge {{item.type==='Takeaway'?'orange':item.type==='Task'?'task-badge':'parcel-badge'}}">{{item.typeLabel}}</text><text class="strong">{{item.title}}</text></view><view class="hint">{{zh?item.time+' · '+item.count+' 个订单，'+item.boxes+(item.type==='Task'?' 个任务':item.type==='Takeaway'?' 袋':' 件'):item.time+' · '+item.count+' '+(item.count===1?'order':'orders')+', '+item.boxes+' '+(item.type==='Task'?'task':item.type==='Takeaway'?'bags':'boxes')}}</view></view><view class="trip-right"><text class="strong">¥{{item.reward}}</text><text class="trip-status {{item.label==='Waiting'?'waiting-status':''}}">{{item.statusAmount||item.labelText}}</text></view></view><view wx:if="{{!trips.length}}" class="hint">{{zh?'你的行程会显示在这里。':'Your trips will appear here.'}}</view></view><view class="section row"><text>{{zh?'已扣回':'Taken back'}} · −¥{{takenBackTotal}}</text><text class="hint">{{zh?'本周':'this week'}}</text></view><view wx:for="{{takenBack}}" wx:key="id" class="flow-card"><view class="row strong"><text>{{names[item.reason]||item.reason}} · {{item.date}}</text><text class="link">−¥{{item.amount}}</text></view><view class="hint">{{item.note}}</view></view><view wx:if="{{!takenBack.length}}" class="flow-card hint">{{zh?'暂无扣回记录。有争议的订单在处理完成前会保持审核中。':'No deductions recorded. Disputed orders stay under review until resolved.'}}</view><view class="flow-card"><view class="row strong"><text>{{zh?'你的等级':'Your level'}}</text><text>{{zh?'完成 '+jobsDone+' 单 · '+marks.length+' 次记录':jobsDone+' done · '+marks.length+' marks'}}</text></view><view class="hint">{{levelName}} · {{zh?(levelRemaining?'再完成 '+levelRemaining+' 单升级':'已达最高等级'):(levelRemaining?levelRemaining+' more jobs until the next level':'Top level reached')}}</view><view class="progress-track"><view class="progress-fill" style="width:{{progress}}%"/></view><view class="hint">{{zh?limit+' · 准时 '+onTime+' 单':limit+' · '+onTime+' on time'}}</view><view wx:for="{{marks}}" wx:key="index" class="orange-note">{{zh?item.time+' · '+(names[item.reason]||item.reason)+'。记录不会扣钱。':item.time+' · '+item.reason+'. Marks are recorded; they do not deduct money.'}}</view></view><view class="hint">{{zh?'记录 14 天后失效。累计 3 次会降级，累计 5 次将暂停接单 7 天。':'Marks expire after 14 days. At 3 marks, the level drops. At 5 marks, taking jobs pauses for 7 days.'}}</view></view><app-nav id="app-nav" active="profile"/></view><level-up/><yuni-assistant topic=""/>
<view class="flow-page earnings-page"><view class="earnings-header"><view class="flow-title">Earnings</view><view class="flow-sub">{{runnerName}} · {{runnerLevel}} · opened from Me</view></view><view class="earnings-content"><view class="flow-card"><view class="row"><text class="strong">Last 7 days</text><text class="hint">{{tripCount}} trips · {{week.weekJobs}} jobs</text></view><view class="amount money">¥{{week.earnTotal}}</view><view class="earnings-legend"><text class="legend-dot paid-dot"></text><text>Paid ¥{{week.earnPaid}}</text><text class="legend-dot waiting-dot"></text><text>Waiting ¥{{week.earnWaiting}}</text><text class="legend-dot deduction-dot"></text><text>Taken back −¥{{takenBackTotal}}</text></view><view class="bars"><view wx:for="{{week.weekBars}}" wx:key="day" class="bar-column"><view class="bar-stack"><view class="bar waiting-bar" style="height:{{item.waitingHeight}}rpx"/><view class="bar" style="height:{{item.paidHeight}}rpx"/></view><text>{{item.day}}</text></view></view></view><view class="green-note">Preview balance only. No WeChat transfer or withdrawal is connected.</view><view class="row earnings-section"><text>Waiting · ¥{{waiting}}</text><text class="hint">Pending confirmation</text></view><view class="flow-card compact" wx:if="{{pending.length}}"><view wx:for="{{pending}}" wx:key="id" class="earning-item"><view><view class="strong">{{item.owner}} · Room {{item.room}} · {{item.boxes}} {{item.unit}}</view><view class="hint">Delivered {{item.deliveredTime}} · auto-confirms {{item.autoTime}}</view></view><text class="strong">¥{{item.earnedText}}</text></view></view><view wx:if="{{!pending.length}}" class="hint">No payments waiting for confirmation.</view><view class="flow-card" wx:if="{{held.length}}"><view class="strong">Settlement paused</view><view wx:for="{{held}}" wx:key="id" class="row hint"><text>{{item.owner}} · {{item.dispute.reason}}</text><text>¥{{item.earnedText}}</text></view></view><view class="row earnings-section"><text>Trips and tasks</text><text class="hint">newest first</text></view><view class="flow-card compact"><view wx:for="{{trips}}" wx:key="id" class="earning-item trip-item" data-id="{{item.id}}" bindtap="open"><view class="trip-main"><view class="trip-title"><text class="badge {{item.type==='Takeaway'?'orange':item.type==='Task'?'task-badge':'parcel-badge'}}">{{item.type}}</text><text class="strong">{{item.title}}</text></view><view class="hint">{{item.time}} · {{item.count}} {{item.count===1?'order':'orders'}}, {{item.boxes}} {{item.type==='Task'?'task':item.type==='Takeaway'?'bags':'boxes'}}</view></view><view class="trip-right"><text class="strong">¥{{item.reward}}</text><text class="trip-status {{item.label==='Waiting'?'waiting-status':''}}">{{item.statusAmount||item.label}}</text></view></view><view wx:if="{{!trips.length}}" class="hint">Your trips will appear here.</view></view><view class="section row"><text>Taken back · −¥{{takenBackTotal}}</text><text class="hint">this week</text></view><view wx:for="{{takenBack}}" wx:key="id" class="flow-card"><view class="row strong"><text>{{item.reason}} · {{item.date}}</text><text class="link">−¥{{item.amount}}</text></view><view class="hint">{{item.note}}</view></view><view wx:if="{{!takenBack.length}}" class="flow-card hint">No deductions recorded. Disputed orders stay under review until resolved.</view><view class="flow-card"><view class="row strong"><text>Your level</text><text>{{jobsDone}} done · {{marks.length}} marks</text></view><view class="hint">{{levelName}} · {{levelRemaining?levelRemaining+' more jobs until the next level':'Top level reached'}}</view><view class="progress-track"><view class="progress-fill" style="width:{{progress}}%"/></view><view class="hint">{{limit}} · {{onTime}} on time</view><view wx:for="{{marks}}" wx:key="index" class="orange-note">{{item.time}} · {{item.reason}}. Marks are recorded; they do not deduct money.</view></view><view class="hint">Marks expire after 14 days. At 3 marks, the level drops. At 5 marks, taking jobs pauses for 7 days.</view></view><app-nav active="profile"/></view><yuni-assistant topic=""/>
@import "../../utils/flow.wxss";
.earnings-page{padding:0 0 170rpx;background:#eeede8}.earnings-header{background:#fff;padding:29rpx 40rpx 22rpx}.earnings-header .flow-title{margin:0}.earnings-header .flow-sub{margin:4rpx 0 0}.earnings-content{padding:8rpx 40rpx}.earnings-page .flow-card{padding:26rpx;margin:20rpx 0}.earnings-page .money{display:block;color:#41775b;font-size:53rpx;margin:13rpx 0}.earnings-legend{display:flex;align-items:center;gap:10rpx;flex-wrap:wrap;font-size:22rpx;color:#686964}.legend-dot{display:inline-block;width:17rpx;height:17rpx;border-radius:4rpx;margin-left:12rpx}.legend-dot:first-child{margin-left:0}.paid-dot{background:#41775b}.waiting-dot{background:#b8cbc4}.earnings-section{font-size:27rpx;font-weight:800;margin:32rpx 0 5rpx}.earnings-section .hint{font-weight:400}.earnings-page .compact{padding:0}.earning-item{display:flex;align-items:center;justify-content:space-between;gap:12rpx;padding:22rpx 26rpx;border-bottom:1rpx solid #ebeae5}.earning-item:last-child{border-bottom:0}.earning-item>view:first-child{min-width:0}.earning-item .hint{margin:3rpx 0}.trip-main{flex:1;min-width:0}.trip-title{display:flex;align-items:center;gap:8rpx;min-width:0}.trip-title .badge{margin:0;flex:none}.trip-title .strong{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:24rpx}.parcel-badge{background:#edf0fa;color:#4d5684}.trip-right{display:flex;flex-direction:column;align-items:flex-end;gap:5rpx;flex:none;font-size:23rpx}.trip-status{border-radius:25rpx;padding:5rpx 10rpx;background:#f0efeb;color:#676761;font-size:20rpx}.waiting-status{background:#e6efeb;color:#41775b}.earnings-page .bars{height:145rpx}

.bar-stack{display:flex;flex-direction:column;justify-content:flex-end;width:100%;min-height:3rpx;background:#e4e3db;border-radius:6rpx;overflow:hidden}.bar-stack .bar{border-radius:0}.waiting-bar{background:#b1c8bf!important}
.deduction-dot{background:#b44b22}.task-badge{background:#e8edff;color:#3545af}.earnings-page .bar-stack .bar{margin:0;min-height:0}.earnings-page .bars{height:185rpx}.earnings-page .trip-title .strong{white-space:normal;font-size:23rpx;line-height:1.4}

<view style="{{motionStyle}}">
<lang-switch></lang-switch>
<view class="v8-page rewards-page news-redesign {{screen==='activity'?'ranking-page':''}} {{darkClass}}">
 <view wx:if="{{screen==='home'}}" class="reference-header"><view class="news-heading"><view><view class="news-title">{{zh?'动态':'News'}}</view></view><view class="campus-badge"><image src="/assets/news-campus.svg"/><text>XJTLU</text></view></view></view>
 <view wx:else class="news-back" bindtap="backToNews">‹ {{zh?'返回动态':'Back to News'}}</view>
 <block wx:if="{{screen==='home'}}">
  <view class="reference-section"><view class="news-section-head"><view class="news-section-label">{{zh?'优惠':'Offers'}}</view><text wx:if="{{activeOffers.length}}" data-screen="offers" bindtap="openSection">{{zh?'查看全部':'View all'}} <text class="section-arrow">›</text></text></view><view class="invite-primary" bindtap="invite" hover-class="invite-primary-press"><text class="invite-primary-watermark">UniEarn</text><view class="invite-primary-content"><view class="invite-primary-kicker">{{zh?'和同学一起加入':'BETTER WITH CLASSMATES'}}</view><view class="invite-primary-title">{{zh?'邀请新同学，领五折券':'Invite classmates, unlock 50% off'}}</view><view class="invite-primary-rewards"><view class="invite-primary-coupon"><view class="invite-primary-discount"><text class="invite-primary-number">{{zh?'5':'50'}}</text><text class="invite-primary-off">{{zh?'折':'%'}}</text></view><text class="invite-primary-unit">{{zh?'配送券':'delivery coupon'}}</text></view><view class="invite-primary-points"><view class="invite-primary-points-value"><text>10</text><text>{{zh?'积分':'points'}}</text></view><view class="invite-primary-points-label">{{zh?'绑定邀请码，双方各得':'Link a code · you each get'}}</view></view></view><view class="invite-primary-subtitle">{{zh?'同学完成首单后解锁，最高抵 ¥3.9':'Unlock after their first completed order · up to ¥3.9'}}</view><view class="invite-primary-footer"><text>{{zh?'查看我的邀请码':'View my invite code'}}</text><text>↗</text></view></view></view><view wx:if="{{latestOffer}}" class="coupon-compact analytics-card" data-kind="campaign" data-content-id="{{latestOffer.id}}" data-screen="offers" bindtap="openSection"><view class="reference-icon"><image src="/assets/news-ticket.svg"/></view><view class="coupon-compact-copy"><view class="entry-title">{{latestOffer.title}}</view><view class="news-small">{{zh?'新优惠 · 查看活动详情':'New offer · View campaign details'}}</view></view><text class="coupon-compact-action">{{zh?'查看':'View'}} ›</text></view></view>
  <view class="reference-section"><view class="news-section-head"><view class="news-section-label">{{zh?'活动':'Activities'}}</view><text bindtap="openRules">{{zh?'得分规则':'Scoring rules'}}</text></view><view class="activity-entry" bindtap="openActivity" hover-class="activity-entry-press"><view class="activity-entry-top"><text class="activity-kicker">{{zh?'校园活动 · 排行':'CAMPUS ACTIVITY'}}</text><text class="activity-status {{rankingPhase}}">{{rankingShortStatus}}</text></view><view class="activity-entry-title">{{zh?'校园积分排行榜':'Campus points leaderboard'}}</view><view class="activity-entry-detail">{{activityHomeDetail}}</view><view class="activity-entry-period">{{rankingPeriod}}</view><view wx:if="{{activityPreview.length}}" class="activity-preview"><view wx:for="{{activityPreview}}" wx:key="rank" class="activity-preview-row {{item.mine?'mine':''}}"><text class="activity-preview-rank">{{item.rank}}</text><view class="activity-preview-avatar">{{item.initial}}</view><text class="activity-preview-name">{{item.name}}</text><text class="activity-preview-score">{{item.points}}</text></view></view><view class="activity-entry-footer"><text>{{zh?'查看排行与任务':'View ranking and tasks'}}</text><text>›</text></view></view></view>
  <view class="reference-section"><view class="news-section-head"><view class="news-section-label">{{zh?'校园':'University'}}</view><text data-screen="university" bindtap="openSection">{{zh?'查看全部':'View all'}} <text class="section-arrow">›</text></text></view><view class="reference-row" data-screen="university" bindtap="openSection"><view class="reference-icon"><image src="/assets/news-campus.svg"/></view><view class="reference-row-copy"><view class="entry-title">{{zh?'校园通知与活动':'Campus notices & events'}}</view><view class="news-small">{{zh?'暂无新公告，更新后在这里见':'New campus announcements will appear here'}}</view></view><text class="news-chevron">›</text></view></view>
  <view class="reference-section"><view class="news-section-head"><view class="news-section-label">UniEarn</view><text data-screen="uniearn" bindtap="openSection">{{zh?'查看全部':'View all'}} <text class="section-arrow">›</text></text></view><view class="reference-list"><view wx:if="{{newsLoading || newsError || !news.length}}" class="reference-row" data-screen="uniearn" bindtap="openSection"><view class="reference-icon"><image src="/assets/news-document.svg"/></view><view class="reference-row-copy"><view class="entry-title">{{zh?'最新动态':'Latest updates'}}</view><view class="news-small">{{newsLoading?(zh?'动态加载中…':'Loading updates…'):newsError?(zh?'同步失败，正在重试':'Sync failed. Retrying'):(zh?'暂无新动态':'No new updates yet')}}</view></view><text class="news-chevron">›</text></view><block wx:for="{{news}}" wx:key="_id"><view wx:if="{{index < 3}}" class="reference-row analytics-card" data-kind="news" data-content-id="{{item._id}}" data-id="{{item._id}}" bindtap="openArticle"><view class="reference-icon"><image wx:if="{{item.coverURL}}" src="{{item.coverURL}}" mode="aspectFill"/><image wx:else src="/assets/news-document.svg"/></view><view class="reference-row-copy"><view class="entry-title">{{item.title}}</view><view class="news-small">{{item.date}}</view></view><text class="news-chevron">›</text></view></block></view></view>
 </block>
 <view wx:if="{{screen==='offers'}}"><view class="detail-title">{{zh?'最新优惠':'Latest offers'}}</view><view wx:if="{{!activeOffers.length}}" class="channel-empty news-small">{{zh?'暂无新的优惠活动':'No new offers right now'}}</view><view wx:for="{{activeOffers}}" wx:key="id" class="flow-card public-offer analytics-card" data-kind="campaign" data-content-id="{{item.id}}"><view class="entry-title">{{item.title}}</view><view class="news-small">{{item.description}}</view><view wx:if="{{item.end}}" class="news-small">{{zh?'活动截止：':'Until: '}}{{item.end}}</view><button wx:if="{{!registered}}" class="small-outline" bindtap="register">{{zh?'登录后领取':'Log in to collect'}}</button><button wx:elif="{{!item.collected && item.eligible}}" class="small-outline" data-id="{{item.id}}" bindtap="collect">{{zh?'领取优惠':'Collect offer'}}</button><view wx:else class="news-small">{{item.collected?(zh?'已领取，可在“我的 → 我的优惠券”查看':'Collected · View in Me → My coupons'):(zh?'请查看活动领取条件':'Check the campaign eligibility requirements')}}</view></view></view>
 <view wx:if="{{screen==='university'}}"><view class="detail-title">{{zh?'校园':'University'}}</view><view class="channel-empty news-small">{{zh?'暂无校园活动，敬请期待。':'No campus events yet. Check back soon.'}}</view></view>
 <view wx:if="{{screen==='uniearn'}}"><view class="detail-title">UniEarn</view><view wx:if="{{newsLoading || newsError || !news.length}}" class="channel-empty news-small">{{newsLoading?(zh?'动态加载中…':'Loading…'):newsError?(zh?'同步失败，正在重试。':'Sync failed. Retrying.'):(zh?'暂无动态':'No updates yet')}}</view><view wx:for="{{news}}" wx:key="_id" class="news-feed-row analytics-card" data-kind="news" data-content-id="{{item._id}}" data-id="{{item._id}}" bindtap="openArticle"><view class="news-feed-copy"><view class="entry-title">{{item.title}}</view><view class="news-small">{{item.date}}</view></view><text class="news-chevron">›</text></view></view>
 <view wx:if="{{screen==='article' && selectedNews}}"><view class="news-small" bindtap="closeArticle">‹ UniEarn</view><view class="article-card"><image wx:if="{{selectedNews.coverURL}}" src="{{selectedNews.coverURL}}" mode="widthFix" class="news-cover"/><view class="detail-title">{{selectedNews.title}}</view><view class="news-small">{{selectedNews.date}}</view><text class="news-copy">{{selectedNews.body}}</text></view></view>
 <view wx:if="{{screen==='activity'}}" class="board">
  <view class="board-heading"><view class="board-title">{{activityTitle}}</view><button class="board-rules-button" bindtap="toggleRules">{{zh?'规则':'Rules'}} <text>?</text></button></view>
  <view class="board-period"><text>{{rankingPeriod}}</text><text class="board-status {{rankingPhase}}">{{rankingShortStatus}}</text></view>
  <view wx:if="{{showRules}}" class="board-rule-panel"><view>{{activityIntro}}</view><view class="board-muted">{{rankingRuleText}}</view></view>
  <view class="board-prize-hero"><view class="board-prize-label">{{rankingPrizeLabel}}</view><view class="board-top-prize">{{rankingTopPrize}}</view><view class="board-prize-cap">{{rankingTopCap}} · {{zh?'前 ':'Top '}}{{rankingRewardSeats}}</view></view>
  <view class="board-stats"><view><text>{{zh?'我的等级积分':'My level points'}}</text><text class="board-stat-number">{{rankingLevelPoints}}</text></view><view><text>{{zh?'本期活动分':'This round'}}</text><text class="board-stat-number">{{rankingMyPoints}}</text></view><view><text>{{zh?'上榜同学':'Ranked'}}</text><text class="board-stat-number">{{rankingParticipants}}</text></view><view><text>{{rankingTimingLabel}}</text><text class="board-stat-time">{{rankingClock}}</text></view></view>
  <view wx:if="{{activityError}}" class="board-sync-note">{{zh?'规则暂未同步，正在重试，当前显示上次内容':'Rules could not sync. Retrying with the last available version.'}}</view>
  <view class="board-content">
   <view class="board-tabs"><button class="{{activityTab==='rank'?'selected':''}}" data-tab="rank" bindtap="setActivityTab">{{zh?'积分排行':'Ranking'}}</button><button class="{{activityTab==='tasks'?'selected':''}}" data-tab="tasks" bindtap="setActivityTab">{{zh?'积分任务':'Tasks'}}</button><button class="{{activityTab==='prizes'?'selected':''}}" data-tab="prizes" bindtap="setActivityTab">{{zh?'奖励档位':'Rewards'}}</button></view>
   <block wx:if="{{activityTab==='rank'}}">
    <view wx:if="{{activityBoardState==='loading'}}" class="board-empty"><view class="board-empty-title">{{zh?'榜单加载中':'Loading the board'}}</view><view class="board-muted">{{zh?'正在读取本期真实排名。':'Reading the real rankings for this round.'}}</view></view>
    <view wx:elif="{{activityBoardState==='error'}}" class="board-empty"><view class="board-empty-title">{{zh?'榜单同步失败':'Could not sync the board'}}</view><view class="board-muted">{{zh?'网络恢复后可以重新同步。':'Sync again once the network is back.'}}</view><button class="board-empty-action" bindtap="retryActivity">{{zh?'重新同步':'Sync again'}}</button></view>
    <view wx:elif="{{!rankingRows.length}}" class="board-empty"><image src="/assets/news-trophy.svg" mode="aspectFit"/><view class="board-empty-title">{{rankingEmptyTitle}}</view><view class="board-muted">{{rankingEmptyText}}</view></view>
    <block wx:else>
     <view class="board-list-heading"><view class="board-section-title">{{zh?'本期排名':'This round'}}</view><view class="board-muted">{{zh?'只统计活动期内符合上限的新增积分。':'Only points earned inside the round, within the caps.'}}</view></view>
     <view wx:if="{{rankingUpdated}}" class="board-updated">{{rankingUpdated}}</view>
     <view class="board-table-head"><text>{{zh?'名次':'Rank'}}</text><text class="board-head-person">{{zh?'同学':'Classmate'}}</text><text>{{zh?'本期积分':'Round pts'}}</text></view>
     <view wx:for="{{rankingRows}}" wx:key="rank" class="board-rank-row {{item.rank<=3?'top-three':''}} {{item.mine?'mine':''}}"><text class="board-rank-number">{{item.rank}}</text><view class="board-student board-student-line"><view class="board-avatar">{{item.initial}}</view><view><view class="board-student-name">{{item.name}}<text wx:if="{{item.mine}}" class="board-you">{{zh?'我':'Me'}}</text></view><view wx:if="{{item.reward}}" class="board-rank-reward">{{item.reward}}</view></view></view><text class="board-score">{{item.points}}</text></view>
    </block>
    <view class="board-footnote">{{zh?'榜单使用校园代号，不显示真实姓名和手机号。奖励按名次说明，活动结束后发放，这里不能直接领取。':'The board uses campus aliases, not real names or phone numbers. Rewards follow the rank tiers and are issued after the round. They cannot be claimed here.'}}</view>
   </block>
   <block wx:if="{{activityTab==='tasks'}}">
    <view class="board-list-heading"><view class="board-section-title">{{zh?'怎么得分':'How scoring works'}}</view><view class="board-muted">{{zh?'等级积分长期保留。排行只计入活动期内的新增分。':'Level points stay. Ranking counts only points added during the round.'}}</view></view>
    <view wx:for="{{activityTasks}}" wx:key="id" class="board-task-row"><view class="board-task-copy"><view class="board-section-title">{{item.label}}</view><view class="board-muted">{{item.detail}}</view><view wx:if="{{item.firstLabel}}" class="board-first-label">{{item.firstLabel}}</view><view wx:if="{{item.limitLabel}}" class="board-first-label">{{item.limitLabel}}</view><view wx:if="{{item.progressLabel}}" class="board-muted">{{item.progressLabel}}</view><button wx:if="{{item.action}}" class="board-task-action" data-action="{{item.action}}" bindtap="openTask">{{item.actionLabel}}</button></view><view class="board-task-points"><text>+{{item.points}}</text><text>{{zh?'积分':'pts'}}</text></view></view>
   </block>
   <block wx:if="{{activityTab==='prizes'}}">
    <view class="board-list-heading"><view class="board-section-title">{{zh?'奖励档位':'Reward tiers'}}</view><view class="board-muted">{{zh?'按最终名次对应，不在这里领取。':'Matched to the final rank. Not claimed on this page.'}}</view></view>
    <view wx:for="{{rankingRewards}}" wx:key="range" class="board-prize-row {{index===0?'first':''}}"><text class="board-prize-rank">{{item.range}}</text><view><view class="board-prize-coupon">{{item.prize}}</view><view class="board-muted">{{item.cap}}</view></view></view>
   </block>
  </view>
  <view class="board-personal"><view class="board-personal-copy"><view class="board-personal-title">{{rankingPersonalTitle}}<text wx:if="{{registered}}">{{rankingMyPoints}} {{zh?'本期分':'this round'}}</text></view><view class="board-personal-level">{{zh?'等级积分':'Level points'}} {{rankingLevelPoints}}</view><view class="board-personal-hint">{{rankingPersonalHint}}</view></view><button class="board-personal-button" bindtap="personalAction">{{personalActionLabel}}</button></view>
 </view>

</view><app-nav id="app-nav" active="rewards"/><yuni-assistant topic=""/>
</view>

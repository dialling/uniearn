<view style="{{motionStyle}}">
<template name="roadshowPoster">
<view class="roadshow-poster" bindtap="openRoadshow" hover-class="roadshow-press">
 <text class="roadshow-watermark">{{dateHero}}</text>
 <view class="roadshow-top"><text class="roadshow-kicker">{{kicker}}</text><text class="roadshow-brand">UniEarn</text></view>
 <view class="roadshow-main">
  <view class="roadshow-copy">
   <view class="roadshow-hero">{{dateHero}}</view>
   <view class="roadshow-place">{{place}}</view>
   <view class="roadshow-meta">{{dateLabel}} · {{campus}}</view>
  </view>
  <image class="roadshow-yuni" src="/assets/yuni-party.png" mode="aspectFit"/>
 </view>
 <view class="roadshow-foot"><text>{{subtitle}}</text><text class="roadshow-go">›</text></view>
</view>
</template>
<lang-switch></lang-switch>
<view class="v8-page rewards-page news-redesign {{darkClass}}">
 <view wx:if="{{screen==='home'}}" class="reference-header"><view class="news-heading"><view><view class="news-title">{{zh?'动态':'News'}}</view></view></view></view>
 <view wx:else class="news-back" bindtap="backToNews">‹ {{zh?'返回动态':'Back to News'}}</view>
 <block wx:if="{{screen==='home'}}">
  <view class="reference-section"><view class="news-section-head"><view class="news-section-label">UniEarn</view><text data-screen="uniearn" bindtap="openSection">{{zh?'查看全部':'View all'}} <text class="section-arrow">›</text></text></view><template is="roadshowPoster" wx:if="{{roadshow}}" data="{{...roadshow}}"/><view class="reference-list"><view wx:if="{{!roadshow && (newsLoading || newsError || !news.length)}}" class="reference-row" data-screen="uniearn" bindtap="openSection"><view class="reference-icon"><image src="/assets/news-document.svg"/></view><view class="reference-row-copy"><view class="entry-title">{{zh?'最新动态':'Latest updates'}}</view><view class="news-small">{{newsLoading?(zh?'动态加载中…':'Loading updates…'):newsError?(zh?'同步失败，正在重试':'Sync failed. Retrying'):(zh?'暂无新动态':'No new updates yet')}}</view></view><text class="news-chevron">›</text></view><block wx:for="{{news}}" wx:key="_id"><view wx:if="{{index < 3}}" class="reference-row analytics-card" data-kind="news" data-content-id="{{item._id}}" data-id="{{item._id}}" bindtap="openArticle"><view class="reference-icon"><image wx:if="{{item.coverURL}}" src="{{item.coverURL}}" mode="aspectFill"/><image wx:else src="/assets/news-document.svg"/></view><view class="reference-row-copy"><view class="entry-title">{{item.title}}</view><view class="news-small">{{item.date}}</view></view><text class="news-chevron">›</text></view></block></view></view>
  <view class="reference-section"><view class="news-section-head"><view class="news-section-label">{{zh?'优惠':'Offers'}}</view><text wx:if="{{activeOffers.length}}" data-screen="offers" bindtap="openSection">{{zh?'查看全部':'View all'}} <text class="section-arrow">›</text></text></view><view class="invite-primary" bindtap="invite" hover-class="invite-primary-press"><text class="invite-primary-watermark">UniEarn</text><view class="invite-primary-content"><view class="invite-primary-kicker">{{zh?'和同学一起加入':'BETTER WITH CLASSMATES'}}</view><view class="invite-primary-title">{{zh?'邀请新同学，领五折券':'Invite classmates, unlock 50% off'}}</view><view class="invite-primary-rewards"><view class="invite-primary-coupon"><view class="invite-primary-discount"><text class="invite-primary-number">{{zh?'5':'50'}}</text><text class="invite-primary-off">{{zh?'折':'%'}}</text></view><text class="invite-primary-unit">{{zh?'配送券':'delivery coupon'}}</text></view><view class="invite-primary-points"><view class="invite-primary-points-value"><text>10</text><text>{{zh?'积分':'points'}}</text></view><view class="invite-primary-points-label">{{zh?'绑定邀请码，双方各得':'Link a code · you each get'}}</view></view></view><view class="invite-primary-subtitle">{{zh?'同学完成首单后解锁，最高抵 ¥3.9':'Unlock after their first completed order · up to ¥3.9'}}</view><view class="invite-primary-footer"><text>{{zh?'查看我的邀请码':'View my invite code'}}</text><text>↗</text></view></view></view><view wx:if="{{latestOffer}}" class="coupon-compact analytics-card" data-kind="campaign" data-content-id="{{latestOffer.id}}" data-screen="offers" bindtap="openSection"><view class="reference-icon"><image src="/assets/news-ticket.svg"/></view><view class="coupon-compact-copy"><view class="entry-title">{{latestOffer.title}}</view><view class="news-small">{{zh?'新优惠 · 查看活动详情':'New offer · View campaign details'}}</view></view><text class="coupon-compact-action">{{zh?'查看':'View'}} ›</text></view></view>
  <view class="reference-section"><view class="news-section-head"><view class="news-section-label">{{zh?'活动':'Activities'}}</view></view><view class="rank-coming-soon simple-ranking" aria-disabled="true"><view class="simple-ranking-top"><text class="simple-eyebrow">{{zh?'校园活动 · Rank':'CAMPUS ACTIVITY · Rank'}}</text><text class="simple-status">{{zh?'敬请期待':'Coming soon'}}</text></view><view class="ranking-title-row"><view class="ranking-title-copy"><view class="simple-ranking-title">{{zh?'校园积分排行榜':'Campus points leaderboard'}}</view><view class="simple-ranking-description">{{zh?'活动期间完成任务积攒积分，参与校园排名。':'Earn points by completing tasks during the event and join the campus rankings.'}}</view></view><image class="ranking-white-star" src="/assets/news-white-star.svg" mode="aspectFit"/></view><view class="rank-preview-note">{{zh?'活动筹备中，开放时间另行通知':'In preparation. Launch details will be announced.'}}</view></view></view>
  <view wx:if="{{showCampusNotices}}" class="reference-section"><view class="news-section-head"><view class="news-section-label">{{zh?'校园':'University & campus'}}</view><text data-screen="university" bindtap="openSection">{{zh?'查看全部':'View all'}} <text class="section-arrow">›</text></text></view><view class="reference-row" data-screen="university" bindtap="openSection"><view class="reference-icon"><image src="/assets/news-campus.svg"/></view><view class="reference-row-copy"><view class="entry-title">{{zh?'校园通知与活动':'Campus notices & events'}}</view><view class="news-small">{{zh?'暂无新公告，更新后在这里见':'New campus announcements will appear here'}}</view></view><text class="news-chevron">›</text></view></view>
 </block>
 <view wx:if="{{screen==='offers'}}"><view class="detail-title">{{zh?'最新优惠':'Latest offers'}}</view><view wx:if="{{!activeOffers.length}}" class="channel-empty news-small">{{zh?'暂无新的优惠活动':'No new offers right now'}}</view><view wx:for="{{activeOffers}}" wx:key="id" class="flow-card public-offer analytics-card" data-kind="campaign" data-content-id="{{item.id}}"><view class="entry-title">{{item.title}}</view><view class="news-small">{{item.description}}</view><view wx:if="{{item.end}}" class="news-small">{{zh?'活动截止：':'Until: '}}{{item.end}}</view><button wx:if="{{!registered}}" class="small-outline" bindtap="register">{{zh?'登录后领取':'Log in to collect'}}</button><button wx:elif="{{!item.collected && item.eligible}}" class="small-outline" data-id="{{item.id}}" bindtap="collect">{{zh?'领取优惠':'Collect offer'}}</button><view wx:else class="news-small">{{item.collected?(zh?'已领取，可在“我的 → 我的优惠券”查看':'Collected · View in Me → My coupons'):(zh?'请查看活动领取条件':'Check the campaign eligibility requirements')}}</view></view></view>
 <view wx:if="{{showCampusNotices && screen==='university'}}"><view class="detail-title">{{zh?'校园':'University & campus'}}</view><view class="channel-empty news-small">{{zh?'暂无校园活动，敬请期待。':'No campus events yet. Check back soon.'}}</view></view>
 <view wx:if="{{screen==='uniearn'}}"><view class="detail-title">UniEarn</view><template is="roadshowPoster" wx:if="{{roadshow}}" data="{{...roadshow}}"/><view wx:if="{{!roadshow && (newsLoading || newsError || !news.length)}}" class="channel-empty news-small">{{newsLoading?(zh?'动态加载中…':'Loading…'):newsError?(zh?'同步失败，正在重试。':'Sync failed. Retrying.'):(zh?'暂无动态':'No updates yet')}}</view><view wx:for="{{news}}" wx:key="_id" class="news-feed-row analytics-card" data-kind="news" data-content-id="{{item._id}}" data-id="{{item._id}}" bindtap="openArticle"><view class="news-feed-copy"><view class="entry-title">{{item.title}}</view><view class="news-small">{{item.date}}</view></view><text class="news-chevron">›</text></view></view>
 <view wx:if="{{screen==='article' && selectedNews}}"><view class="news-small" bindtap="closeArticle">‹ UniEarn</view><template is="roadshowPoster" wx:if="{{selectedNews.kind==='roadshow' && roadshow}}" data="{{...roadshow}}"/><view class="article-card"><image wx:if="{{selectedNews.coverURL}}" src="{{selectedNews.coverURL}}" mode="widthFix" class="news-cover"/><view class="detail-title">{{selectedNews.title}}</view><view class="news-small">{{selectedNews.date}}</view><text class="news-copy">{{selectedNews.body}}</text></view></view>

</view><app-nav id="app-nav" active="rewards"/><yuni-assistant topic=""/>
</view>

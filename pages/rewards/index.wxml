<lang-switch/>
<view class="v8-page rewards-page news-redesign {{screen==='activity'?'ranking-page':''}} {{darkClass}}">
 <view wx:if="{{screen==='home'}}" class="reference-header"><view class="news-heading"><view><view class="news-title">{{zh?'资讯':'News'}}</view><view class="news-subtitle">{{zh?'校园生活、优惠与动态':'Campus life, offers & updates'}}</view></view><view class="campus-badge"><image src="/assets/news-campus.svg"/><text>XJTLU</text></view></view></view>
 <view wx:else class="news-back" bindtap="backToNews">‹ {{zh?'返回资讯':'Back to News'}}</view>
 <block wx:if="{{screen==='home'}}">
  <view class="reference-section"><view class="news-section-head"><view class="news-section-label">{{zh?'优惠':'Offers'}}</view><text wx:if="{{activeOffers.length}}" data-screen="offers" bindtap="openSection">{{zh?'查看全部':'View all'}} <text class="section-arrow">›</text></text></view><view class="invite-primary" bindtap="invite" hover-class="invite-primary-press"><text class="invite-primary-watermark">UniEarn</text><view class="invite-primary-content"><view class="invite-primary-kicker">{{zh?'和同学一起加入':'BETTER WITH CLASSMATES'}}</view><view class="invite-primary-title">{{zh?'邀请新同学，领五折券':'Invite classmates, unlock 50% off'}}</view><view class="invite-primary-rewards"><view class="invite-primary-coupon"><view class="invite-primary-discount"><text class="invite-primary-number">{{zh?'5':'50'}}</text><text class="invite-primary-off">{{zh?'折':'%'}}</text></view><text class="invite-primary-unit">{{zh?'配送券':'delivery coupon'}}</text></view><view class="invite-primary-points"><view class="invite-primary-points-value"><text>10</text><text>{{zh?'积分':'points'}}</text></view><view class="invite-primary-points-label">{{zh?'绑定邀请码，双方各得':'Link a code · you each get'}}</view></view></view><view class="invite-primary-subtitle">{{zh?'同学完成首单后解锁，最高抵 ¥3.9':'Unlock after their first completed order · up to ¥3.9'}}</view><view class="invite-primary-footer"><text>{{zh?'查看我的邀请码':'View my invite code'}}</text><text>↗</text></view></view></view><view wx:if="{{latestOffer}}" class="coupon-compact analytics-card" data-kind="campaign" data-content-id="{{latestOffer.id}}" data-screen="offers" bindtap="openSection"><view class="reference-icon"><image src="/assets/news-ticket.svg"/></view><view class="coupon-compact-copy"><view class="entry-title">{{latestOffer.title}}</view><view class="news-small">{{zh?'新优惠 · 查看活动详情':'New offer · View campaign details'}}</view></view><text class="coupon-compact-action">{{zh?'查看':'View'}} ›</text></view></view>
  <view class="reference-section"><view class="news-section-head"><view class="news-section-label">{{zh?'活动':'Activities'}}</view></view><view class="simple-ranking" data-tab="ranking" bindtap="openActivity"><view class="simple-ranking-top"><text class="simple-eyebrow">{{zh?'校园活动':'CAMPUS ACTIVITY'}}</text><text class="simple-status">{{rankingShortStatus}}</text></view><view class="ranking-title-row"><view class="ranking-title-copy"><view class="simple-ranking-title">{{activityTitle}}</view><view class="simple-ranking-description">{{zh?'了解积分任务与排行榜奖励':'Explore points tasks and ranking rewards'}}</view></view><image class="ranking-white-star" src="/assets/news-white-star.svg"/></view><view class="simple-ranking-footer"><text>{{zh?'查看活动':'View activity'}}</text><text>›</text></view></view></view>
  <view class="reference-section"><view class="news-section-head"><view class="news-section-label">{{zh?'校园':'University'}}</view><text data-screen="university" bindtap="openSection">{{zh?'查看全部':'View all'}} <text class="section-arrow">›</text></text></view><view class="reference-row" data-screen="university" bindtap="openSection"><view class="reference-icon"><image src="/assets/news-campus.svg"/></view><view class="reference-row-copy"><view class="entry-title">{{zh?'校园通知与活动':'Campus notices & events'}}</view><view class="news-small">{{zh?'暂无新公告，更新后在这里见':'New campus announcements will appear here'}}</view></view><text class="news-chevron">›</text></view></view>
  <view class="reference-section"><view class="news-section-head"><view class="news-section-label">UniEarn</view><text data-screen="uniearn" bindtap="openSection">{{zh?'查看全部':'View all'}} <text class="section-arrow">›</text></text></view><view class="reference-list"><view wx:if="{{newsLoading || newsError || !news.length}}" class="reference-row" data-screen="uniearn" bindtap="openSection"><view class="reference-icon"><image src="/assets/news-document.svg"/></view><view class="reference-row-copy"><view class="entry-title">{{zh?'最新动态':'Latest updates'}}</view><view class="news-small">{{newsLoading?(zh?'动态加载中…':'Loading updates…'):newsError?(zh?'同步失败，正在重试':'Sync failed. Retrying'):(zh?'暂无新动态':'No new updates yet')}}</view></view><text class="news-chevron">›</text></view><block wx:for="{{news}}" wx:key="_id"><view wx:if="{{index < 3}}" class="reference-row analytics-card" data-kind="news" data-content-id="{{item._id}}" data-id="{{item._id}}" bindtap="openArticle"><view class="reference-icon"><image wx:if="{{item.coverURL}}" src="{{item.coverURL}}" mode="aspectFill"/><image wx:else src="/assets/news-document.svg"/></view><view class="reference-row-copy"><view class="entry-title">{{item.title}}</view><view class="news-small">{{item.date}}</view></view><text class="news-chevron">›</text></view></block></view></view>
 </block>
 <view wx:if="{{screen==='offers'}}"><view class="detail-title">{{zh?'最新优惠':'Latest offers'}}</view><view wx:if="{{!activeOffers.length}}" class="channel-empty news-small">{{zh?'暂无新的优惠活动':'No new offers right now'}}</view><view wx:for="{{activeOffers}}" wx:key="id" class="flow-card public-offer analytics-card" data-kind="campaign" data-content-id="{{item.id}}"><view class="entry-title">{{item.title}}</view><view class="news-small">{{item.description}}</view><view wx:if="{{item.end}}" class="news-small">{{zh?'活动截止：':'Until: '}}{{item.end}}</view><button wx:if="{{!registered}}" class="small-outline" bindtap="register">{{zh?'登录后领取':'Log in to collect'}}</button><button wx:elif="{{!item.collected && item.eligible}}" class="small-outline" data-id="{{item.id}}" bindtap="collect">{{zh?'领取优惠':'Collect offer'}}</button><view wx:else class="news-small">{{item.collected?(zh?'已领取，可在“我的 → 我的优惠券”查看':'Collected · View in Me → My coupons'):(zh?'请查看活动领取条件':'Check the campaign eligibility requirements')}}</view></view></view>
 <view wx:if="{{screen==='university'}}"><view class="detail-title">{{zh?'校园':'University'}}</view><view class="channel-empty news-small">{{zh?'暂无校园活动，敬请期待。':'No campus events yet. Check back soon.'}}</view></view>
 <view wx:if="{{screen==='uniearn'}}"><view class="detail-title">UniEarn</view><view wx:if="{{newsLoading || newsError || !news.length}}" class="channel-empty news-small">{{newsLoading?(zh?'动态加载中…':'Loading…'):newsError?(zh?'同步失败，正在重试。':'Sync failed. Retrying.'):(zh?'暂无动态':'No updates yet')}}</view><view wx:for="{{news}}" wx:key="_id" class="news-feed-row analytics-card" data-kind="news" data-content-id="{{item._id}}" data-id="{{item._id}}" bindtap="openArticle"><view class="news-feed-copy"><view class="entry-title">{{item.title}}</view><view class="news-small">{{item.date}}</view></view><text class="news-chevron">›</text></view></view>
 <view wx:if="{{screen==='article' && selectedNews}}"><view class="news-small" bindtap="closeArticle">‹ UniEarn</view><view class="article-card"><image wx:if="{{selectedNews.coverURL}}" src="{{selectedNews.coverURL}}" mode="widthFix" class="news-cover"/><view class="detail-title">{{selectedNews.title}}</view><view class="news-small">{{selectedNews.date}}</view><text class="news-copy">{{selectedNews.body}}</text></view></view>
 <view wx:if="{{screen==='activity'}}" class="board">
  <view class="board-heading"><view class="board-title">{{activityTitle}}</view><button class="board-rules-button" bindtap="toggleActivityRules" aria-expanded="{{activityRulesOpen}}">{{zh?'规则':'Rules'}}<text>?</text></button></view>
  <view class="board-period"><text>{{rankingPeriod}}</text><text class="board-status {{rankingPhase}}">{{rankingShortStatus}}</text></view>
  <view wx:if="{{activityRulesOpen}}" class="board-rule-panel"><view class="board-section-title">{{zh?'排行怎么算？':'How ranking works'}}</view><view class="board-muted">{{rankingRuleText}}</view><view class="board-muted">{{activityStatusLabel}} · {{rankingDescription}}</view></view>
  <view class="board-prize-hero"><view class="board-prize-label">{{rankingPrizeLabel}}</view><view class="board-top-prize">{{rankingTopPrize}}</view><view class="board-prize-cap">{{rankingTopCap}}</view><view class="board-reward-summary"><text>{{zh?'前 '+rankingRewardSeats+' 名有奖':'Rewards for the top '+rankingRewardSeats}}</text><text class="board-reward-link" data-tab="rewards" bindtap="switchActivity">{{zh?'查看奖励档位':'Reward tiers'}} ›</text></view></view>
  <view class="board-stats"><view><text class="board-muted">{{zh?'上榜同学':'Ranked students'}}</text><text class="board-stat-number">{{rankingParticipants}}</text></view><view><text class="board-muted">{{rankingTimingLabel}}</text><text class="board-stat-time">{{rankingClock}}</text></view></view>
  <view wx:if="{{activitySyncError}}" class="board-sync-note">{{zh?'规则同步暂时失败，正在重试；当前保留上次内容。':'Rule sync failed. Retrying with the last available version.'}}</view>
  <view id="ranking-content" class="board-content">
   <view class="board-tabs"><button class="{{activityTab==='ranking'?'selected':''}}" data-tab="ranking" bindtap="switchActivity">{{zh?'积分排行':'Leaderboard'}}</button><button class="{{activityTab==='tasks'?'selected':''}}" data-tab="tasks" bindtap="switchActivity">{{zh?'积分任务':'Earn points'}}</button><button class="{{activityTab==='rewards'?'selected':''}}" data-tab="rewards" bindtap="switchActivity">{{zh?'奖励档位':'Prizes'}}</button></view>
   <block wx:if="{{activityTab==='ranking'}}">
    <view class="board-list-heading"><view><view class="board-section-title">{{zh?'本期积分榜':'This round’s leaderboard'}}</view><view class="board-muted">{{zh?'按活动期间新增积分排名':'Ranked by points earned during this round'}}</view></view></view>
    <view wx:if="{{rankingUpdated}}" class="board-updated">{{rankingUpdated}}</view>
    <block wx:if="{{rankingRows.length}}"><view class="board-table-head"><text>{{zh?'名次':'Rank'}}</text><text>{{zh?'同学':'Student'}}</text><text>{{zh?'本期积分':'Round points'}}</text></view><view wx:for="{{rankingRows}}" wx:key="rank" class="board-rank-row {{item.mine?'mine':''}} {{item.rank<=3?'top-three':''}}"><text class="board-rank-number">{{item.rank}}</text><view class="board-student"><view class="board-student-name">{{item.name}}<text wx:if="{{item.mine}}" class="board-you">{{zh?'我':'You'}}</text></view><view wx:if="{{item.reward}}" class="board-rank-reward">{{item.reward}}</view></view><text class="board-score">{{item.points}}</text></view></block>
    <view wx:else class="board-empty"><image src="/assets/yuni-earn.png" mode="aspectFit"/><view class="board-empty-title">{{rankingEmptyTitle}}</view><view class="board-muted">{{rankingEmptyText}}</view><button class="board-empty-action" data-tab="tasks" bindtap="switchActivity">{{zh?'了解怎么赚积分':'See how to earn points'}}</button></view>
    <view class="board-footnote">{{zh?'同分时先达到当前积分的同学优先；榜单显示前 100 名。':'Ties go to whoever reached the score first. The board shows the top 100.'}}</view>
   </block>
   <block wx:elif="{{activityTab==='tasks'}}"><view class="board-list-heading"><view class="board-section-title">{{zh?'日常任务，持续成长':'Everyday tasks, lasting progress'}}</view><view class="board-muted">{{activityStatusLabel}} · {{zh?'长期积分在活动结束后保留。':'Level points remain after the round ends.'}}</view></view><view wx:for="{{activityTasks}}" wx:key="id" class="board-task-row"><view class="board-task-copy"><view class="board-student-name">{{item.label}}</view><view class="board-muted">{{item.detail}}</view><view wx:if="{{item.firstLabel}}" class="board-first-label">{{item.firstLabel}}</view></view><view class="board-task-points"><text>+{{item.points}}</text><text>{{zh?'积分':'points'}}</text></view></view><view class="board-footnote">{{zh?'订单须确认完成后计分，仅标记送达不会立即获得积分。':'Orders earn points after completion is confirmed, not when only marked delivered.'}}</view></block>
   <block wx:else><view class="board-list-heading"><view class="board-section-title">{{zh?'本期奖励档位':'This round’s reward tiers'}}</view><view class="board-muted">{{zh?'实物与配送券奖励，按本期最终名次确定。':'Plush toys and delivery coupons, based on final rank.'}}</view></view><view wx:for="{{rankingRewards}}" wx:key="rankFrom" class="board-prize-row {{index===0?'first':''}}"><text class="board-prize-rank">{{item.range}}</text><view><view wx:if="{{item.physical}}" class="board-student-name">{{item.physical}}</view><view class="board-prize-coupon">{{item.coupon}}</view><view class="board-muted">{{item.cap}}</view></view></view><view class="board-footnote">{{zh?'优惠券按实际订单金额和抵扣上限使用，最终以活动公布的奖励为准。':'Coupons follow order totals and discount caps. Final rewards follow the published event rules.'}}</view></block>
  </view>
  <view class="board-personal"><view class="board-personal-copy"><view class="board-personal-title">{{rankingPersonalTitle}}<text>{{rankingMyPoints}} {{zh?'本期积分':'round pts'}}</text></view><view class="board-personal-level">{{zh?'长期积分':'Lifetime points'}} {{rankingLevelPoints}}</view><view class="board-personal-hint">{{rankingPersonalHint}}</view></view><button class="board-personal-button" bindtap="earnActivityPoints">{{registered?(zh?'赚积分':'Earn points'):(zh?'登录':'Log in')}}</button></view>
 </view>
</view><app-nav id="app-nav" active="rewards"/><yuni-assistant topic=""/>
<lang-switch/>
<view class="v8-page rewards-page news-redesign {{darkClass}}">
 <view wx:if="{{screen==='home'}}" class="reference-header"><view class="news-heading"><view><view class="news-title">{{zh?'资讯':'News'}}</view><view class="news-subtitle">{{zh?'校园生活、优惠与动态':'Campus life, offers & updates'}}</view></view><view class="campus-badge"><image src="/assets/news-campus.svg"/><text>XJTLU</text></view></view></view>
 <view wx:else class="news-back" bindtap="backToNews">‹ {{zh?'返回资讯':'Back to News'}}</view>
 <block wx:if="{{screen==='home'}}">
  <view class="reference-section"><view class="news-section-head"><view class="news-section-label">{{zh?'优惠':'Offers'}}</view><text data-screen="offers" bindtap="openSection">{{zh?'查看全部':'View all'}} <text class="section-arrow">›</text></text></view><view class="invite-primary" bindtap="invite"><view class="invite-primary-kicker">{{zh?'和同学一起加入':'BETTER WITH CLASSMATES'}}</view><view class="invite-primary-title">{{zh?'邀请新同学':'Invite new classmates'}}</view><view class="invite-primary-subtitle">{{zh?'加入 UniEarn，双方各得 10 积分':'Join UniEarn · 10 points for both of you'}}</view><view class="invite-primary-footer"><text>{{zh?'查看我的邀请码':'View my invite code'}}</text><text>↗</text></view></view><view class="coupon-compact" bindtap="openCoupons"><view class="reference-icon"><image src="/assets/news-ticket.svg"/></view><view class="coupon-compact-copy"><view class="entry-title">{{featuredTitle}}</view><view class="news-small">{{zh?ready+' 张优惠券可用':ready+' coupons ready'}}</view></view><text class="coupon-compact-action">{{zh?'查看':'View'}} ›</text></view></view>
  <view class="reference-section"><view class="news-section-head"><view class="news-section-label">{{zh?'校园':'University'}}</view><text data-screen="university" bindtap="openSection">{{zh?'查看全部':'View all'}} <text class="section-arrow">›</text></text></view><view class="reference-row" data-screen="university" bindtap="openSection"><view class="reference-icon"><image src="/assets/news-campus.svg"/></view><view class="reference-row-copy"><view class="entry-title">{{zh?'校园通知与活动':'Campus notices & events'}}</view><view class="news-small">{{zh?'暂无新公告，更新后在这里见':'New campus announcements will appear here'}}</view></view><text class="news-chevron">›</text></view><view class="simple-ranking" data-tab="ranking" bindtap="openActivity"><view class="simple-ranking-top"><text class="simple-eyebrow">{{zh?'校园活动':'CAMPUS ACTIVITY'}}</text><text class="simple-status">{{zh?'暂未开放':'Coming soon'}}</text></view><view class="ranking-title-row"><view class="ranking-title-copy"><view class="simple-ranking-title">{{activityTitle}}</view><view class="simple-ranking-description">{{zh?'了解积分任务与排行榜奖励':'Explore points tasks and ranking rewards'}}</view></view><image class="ranking-white-star" src="/assets/news-white-star.svg"/></view><view class="simple-ranking-footer"><text>{{zh?'查看活动':'View activity'}}</text><text>›</text></view></view></view>
  <view class="reference-section"><view class="news-section-head"><view class="news-section-label">UniEarn</view><text data-screen="uniearn" bindtap="openSection">{{zh?'查看全部':'View all'}} <text class="section-arrow">›</text></text></view><view class="reference-list"><view wx:if="{{newsLoading || newsError || !news.length}}" class="reference-row" data-screen="uniearn" bindtap="openSection"><view class="reference-icon"><image src="/assets/news-document.svg"/></view><view class="reference-row-copy"><view class="entry-title">{{zh?'最新动态':'Latest updates'}}</view><view class="news-small">{{newsLoading?(zh?'动态加载中…':'Loading updates…'):newsError?(zh?'同步失败，正在重试':'Sync failed. Retrying'):(zh?'暂无新动态':'No new updates yet')}}</view></view><text class="news-chevron">›</text></view><block wx:for="{{news}}" wx:key="_id"><view wx:if="{{index < 3}}" class="reference-row analytics-card" data-kind="news" data-content-id="{{item._id}}" data-id="{{item._id}}" bindtap="openArticle"><view class="reference-icon"><image wx:if="{{item.coverURL}}" src="{{item.coverURL}}" mode="aspectFill"/><image wx:else src="/assets/news-document.svg"/></view><view class="reference-row-copy"><view class="entry-title">{{item.title}}</view><view class="news-small">{{item.date}}</view></view><text class="news-chevron">›</text></view></block><view class="reference-row" data-tab="tasks" bindtap="openActivity"><view class="reference-icon"><image src="/assets/news-growth.svg"/></view><view class="reference-row-copy"><view class="entry-title">{{zh?'日常积分任务':'Grow with UniEarn'}}</view><view class="news-small">{{zh?'查看任务，积累你的等级积分':'Explore tasks and grow your level'}}</view></view><text class="news-chevron">›</text></view><view class="reference-row" data-tab="ranking" bindtap="openActivity"><view class="reference-icon"><image src="/assets/news-trophy.svg"/></view><view class="reference-row-copy"><view class="entry-title">{{zh?'排行榜奖励预告':'Ranking rewards'}}</view><view class="news-small">{{zh?'玩偶与优惠券 · 活动暂未开放':'Plush toys & coupons · Coming soon'}}</view></view><text class="news-chevron">›</text></view></view></view>
 </block>
 <view wx:if="{{screen==='offers'}}"><view class="detail-title">{{zh?'优惠':'Offers'}}</view><button class="coupon-wallet-link" bindtap="openCoupons">{{zh?'我的优惠券 ›':'My coupons ›'}}</button><view wx:if="{{event}}" class="event-banner analytics-card" data-kind="campaign" data-content-id="{{event.id}}"><text class="event-tag">{{event.bannerLabel}}</text><view class="event-title">{{event.headline}}</view><view>{{event.blurb}}</view><button wx:if="{{!registered}}" class="collect-event" bindtap="register">{{zh?'注册后领取':'Register to collect'}}</button><button wx:elif="{{!event.collected}}" class="collect-event" data-id="{{event.id}}" bindtap="collect" disabled="{{!event.eligible}}">{{zh?(event.eligible?'领取':'已结束'):event.eligible?'Collect':'Ended'}}</button><view wx:else class="collected">{{zh?'✓ 已领取 · 已放入我的优惠券':'✓ Collected · added to your coupons'}}</view></view>
<view id="my-coupons" class="section row"><text>{{zh?'我的优惠券':'My coupons'}} · {{ready}}</text><text class="hint">{{zh?'每单限用一张':'one per order'}}</text></view><view wx:for="{{coupons}}" wx:key="id" class="coupon"><view class="coupon-face {{item.cash?'cash':''}}"><view>{{item.face}}</view><text>{{item.sub}}</text></view><view class="coupon-info"><view class="strong">{{item.title}}</view><view class="hint">{{item.description}}</view><view class="coupon-end">{{item.validity||(zh?item.displayEnd+' 到期':'Ends '+item.displayEnd)}}</view></view><button class="use" data-id="{{item.id}}" bindtap="use">{{zh?'去使用':'Use'}}</button></view>
<view wx:if="{{showExamples}}" class="examples"><view class="examples-title">{{zh?'新人优惠券示例':'Example welcome coupons'}}</view><view class="hint examples-note">{{zh?'注册后即可领取你的优惠券。以下示例暂不能使用。':'Register to receive your own coupons. These examples cannot be used yet.'}}</view><view wx:for="{{examples}}" wx:key="id" class="coupon example-coupon"><view class="coupon-face {{item.cash?'cash':''}}"><view>{{item.face}}</view><text>{{item.sub}}</text></view><view class="coupon-info"><view class="strong">{{item.title}}</view><view class="hint">{{item.description}}</view><view class="coupon-end">{{zh?item.endLabel+'可用':'Available '+item.endLabel}}</view></view><button class="use" bindtap="register">{{zh?'去注册':'Register'}}</button></view></view><view wx:elif="{{!ready}}" class="hint">{{zh?'暂无可用优惠券。看看上方活动，或在下方领取更多。':'No available coupons right now. Check the event above or collect more below.'}}</view>
<view class="section">{{zh?'领取更多':'Collect more'}}</view><view wx:for="{{campaignCards}}" wx:key="id" class="flow-card collect-card analytics-card" data-kind="campaign" data-content-id="{{item.id}}"><view class="collect-copy"><view class="strong">{{item.title}}</view><view class="hint">{{item.description}}</view></view><button wx:if="{{!registered}}" class="small-outline" bindtap="register">{{zh?'注册后领取':'Register to collect'}}</button><button wx:else class="small-outline" disabled="{{item.collected || !item.eligible}}" data-id="{{item.id}}" bindtap="collect">{{zh?(item.collected?'已领取':'领取'):item.collected?'Collected':'Collect'}}</button></view><view class="flow-card collect-card"><view class="invite-icon"><image src="/assets/coupon-outline.svg"/></view><view class="collect-copy"><view class="strong">{{zh?'邀请同学':'Invite a classmate'}}</view><view class="hint">{{zh?'同学绑定邀请码后双方各得 10 积分；他完成首单后，你解锁最高抵 ¥3.9 的 5 折券':'Link a friend with your code for 10 points each. Their first completed order unlocks your 50% coupon, up to ¥3.9'}}</view></view><button class="small-outline" bindtap="invite">{{zh?'邀请':'Invite'}}</button></view>
<view class="section row"><text>{{zh?'跑手专区':'For runners'}}</text><text class="link" bindtap="jobs">{{zh?'接单大厅 ›':'Open jobs ›'}}</text></view><view wx:if="{{weekly.enabled}}" class="flow-card runner-card"><view class="row strong"><text>{{zh?'本周完成 '+(weekly.target||5)+' 单 → 奖励 +¥'+weekly.amount:'This week: '+(weekly.target||5)+' jobs → +¥'+weekly.amount+' bonus'}}</text><text>{{weekly.count||0}}/{{weekly.target||5}}</text></view><view class="segments"><view wx:for="{{weekly.segments}}" wx:key="index" class="{{item?'filled':''}}"/></view><view class="hint">{{zh?(weekly.earned?'已达成目标':'周日 23:59 前完成更多任务'):weekly.earned?'Target reached':'Complete more jobs by Sunday 23:59'}} · {{zh?'测试奖励已记录到你的账号。':'test reward recorded with your account.'}}</view></view><view wx:if="{{rush.enabled}}" class="flow-card runner-card"><view class="strong">{{zh?'午餐高峰 · 每单 +¥'+rush.amount:'Lunch rush · +¥'+rush.amount+' per job'}}</view><view class="hint">{{zh?'从 '+(rush.station||'North gate')+' 取外卖，'+(rush.timeLabel||'')+'。在同学支付的赏金之外额外发放。':'Takeaway from '+(rush.station||'North gate')+', '+(rush.timeLabel||'')+'. Added on top of the student’s fee.'}}</view></view>
</view>
 <view wx:if="{{screen==='university'}}"><view class="detail-title">{{zh?'校园':'University'}}</view><view class="channel-empty news-small">{{zh?'暂无校园活动，敬请期待。':'No campus events yet. Check back soon.'}}</view></view>
 <view wx:if="{{screen==='uniearn'}}"><view class="detail-title">UniEarn</view><view wx:if="{{newsLoading || newsError || !news.length}}" class="channel-empty news-small">{{newsLoading?(zh?'动态加载中…':'Loading…'):newsError?(zh?'同步失败，正在重试。':'Sync failed. Retrying.'):(zh?'暂无动态':'No updates yet')}}</view><view wx:for="{{news}}" wx:key="_id" class="news-feed-row analytics-card" data-kind="news" data-content-id="{{item._id}}" data-id="{{item._id}}" bindtap="openArticle"><view class="news-feed-copy"><view class="entry-title">{{item.title}}</view><view class="news-small">{{item.date}}</view></view><text class="news-chevron">›</text></view></view>
 <view wx:if="{{screen==='article' && selectedNews}}"><view class="news-small" bindtap="closeArticle">‹ UniEarn</view><view class="article-card"><image wx:if="{{selectedNews.coverURL}}" src="{{selectedNews.coverURL}}" mode="widthFix" class="news-cover"/><view class="detail-title">{{selectedNews.title}}</view><view class="news-small">{{selectedNews.date}}</view><text class="news-copy">{{selectedNews.body}}</text></view></view>
 <view wx:if="{{screen==='activity'}}"><view class="activity-hero"><view class="perk-kicker">{{zh?'成长的每一步都算数':'EVERY STEP COUNTS'}}</view><view class="detail-title">{{activityTitle}}</view><view class="news-small">{{activityIntro}}</view><view class="ranking-status">{{rankingStatusLabel}} · {{rankingDescription}}</view></view><view wx:if="{{activitySyncError}}" class="news-small activity-note">{{zh?'规则同步暂时失败，正在重试；当前保留上次内容。':'Rule sync failed. Retrying with the last available version.'}}</view><view wx:if="{{activityPaused}}" class="news-small activity-note">{{activityStatusLabel}}</view><view class="activity-tabs"><button class="{{activityTab==='tasks'?'selected':''}}" data-tab="tasks" bindtap="switchActivity">{{zh?'积分任务':'Points tasks'}}</button><button class="{{activityTab==='ranking'?'selected':''}}" data-tab="ranking" bindtap="switchActivity">{{zh?'排行榜奖励':'Ranking rewards'}}</button></view><block wx:if="{{activityTab==='tasks'}}"><view class="news-small activity-note">{{zh?'日常积分用于长期等级成长，活动结束不会清零。以下为任务规则介绍，实际奖励以账号记录为准。':'Daily points support long-term level growth. Event closure does not reset them. Rewards follow your account records.'}}</view><view wx:for="{{activityTasks}}" wx:key="id" class="activity-row"><view><view class="entry-title">{{item.label}}</view><view class="news-small">{{item.detail}}</view><view wx:if="{{item.firstLabel}}" class="first-label">{{item.firstLabel}}</view></view><text class="task-points">+{{item.points}}</text></view></block><block wx:else><view class="news-small activity-note">{{rankingStatusLabel}} · {{rankingDescription}}</view><view wx:for="{{activityRewards}}" wx:key="range" class="activity-row"><text class="rank-range">{{item.range}}</text><view><view class="entry-title">{{item.prize}}</view><view class="news-small">{{item.cap}}</view></view></view></block></view>
</view><app-nav id="app-nav" active="rewards"/><yuni-assistant topic=""/>
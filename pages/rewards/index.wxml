<lang-switch/>
<view class="v8-page rewards-page {{darkClass}}"><view class="summary-head"><view class="flow-title">{{zh?'动态':'News'}}</view><view class="flow-sub">{{zh?ready+' 张优惠券可用 · '+toCollect+' 张待领取':ready+' coupons ready · '+toCollect+' to collect'}}</view></view>
<view wx:if="{{event}}" class="event-banner"><text class="event-tag">{{event.bannerLabel}}</text><view class="event-title">{{event.headline}}</view><view>{{event.blurb}}</view><button wx:if="{{!registered}}" class="collect-event" bindtap="register">{{zh?'注册后领取':'Register to collect'}}</button><button wx:elif="{{!event.collected}}" class="collect-event" data-id="{{event.id}}" bindtap="collect" disabled="{{!event.eligible}}">{{zh?(event.eligible?'领取':'已结束'):event.eligible?'Collect':'Ended'}}</button><view wx:else class="collected">{{zh?'✓ 已领取 · 已放入我的优惠券':'✓ Collected · added to your coupons'}}</view></view>
<view id="my-coupons" class="section row"><text>{{zh?'我的优惠券':'My coupons'}} · {{ready}}</text><text class="hint">{{zh?'每单限用一张':'one per order'}}</text></view><view wx:for="{{coupons}}" wx:key="id" class="coupon"><view class="coupon-face {{item.cash?'cash':''}}"><view>{{item.face}}</view><text>{{item.sub}}</text></view><view class="coupon-info"><view class="strong">{{item.title}}</view><view class="hint">{{item.description}}</view><view class="coupon-end">{{item.validity||(zh?item.displayEnd+' 到期':'Ends '+item.displayEnd)}}</view></view><button class="use" data-id="{{item.id}}" bindtap="use">{{zh?'去使用':'Use'}}</button></view>
<view wx:if="{{showExamples}}" class="examples"><view class="examples-title">{{zh?'新人优惠券示例':'Example welcome coupons'}}</view><view class="hint examples-note">{{zh?'注册后即可领取你的优惠券。以下示例暂不能使用。':'Register to receive your own coupons. These examples cannot be used yet.'}}</view><view wx:for="{{examples}}" wx:key="id" class="coupon example-coupon"><view class="coupon-face {{item.cash?'cash':''}}"><view>{{item.face}}</view><text>{{item.sub}}</text></view><view class="coupon-info"><view class="strong">{{item.title}}</view><view class="hint">{{item.description}}</view><view class="coupon-end">{{zh?item.endLabel+'可用':'Available '+item.endLabel}}</view></view><button class="use" bindtap="register">{{zh?'去注册':'Register'}}</button></view></view><view wx:elif="{{!ready}}" class="hint">{{zh?'暂无可用优惠券。看看上方活动，或在下方领取更多。':'No available coupons right now. Check the event above or collect more below.'}}</view>
<view class="section">{{zh?'领取更多':'Collect more'}}</view><view wx:if="{{returning.eligible || returning.collected}}" class="flow-card collect-card"><view class="collect-copy"><view class="strong">{{zh?'立减 ¥1 × 3 单':'¥1 off × 3 orders'}}</view><view class="hint">{{zh?'欢迎回来 · 上个月下过单的同学可领':'Welcome back · for students who ordered last month'}}</view></view><button class="small-outline" disabled="{{returning.collected}}" data-id="{{returning.id}}" bindtap="collect">{{zh?(returning.collected?'已领取':'领取'):returning.collected?'Collected':'Collect'}}</button></view><view class="flow-card collect-card"><view class="invite-icon"><image src="/assets/coupon-outline.svg"/></view><view class="collect-copy"><view class="strong">{{zh?'邀请同学':'Invite a classmate'}}</view><view class="hint">{{zh?'新同学填写你的邀请码，你们各得 ¥3.9 配送券':'When a new user enters your code, you each get ¥3.9 off delivery'}}</view></view><button class="small-outline" bindtap="invite">{{zh?'邀请':'Invite'}}</button></view>
<view class="section row"><text>{{zh?'跑手专区':'For runners'}}</text><text class="link" bindtap="jobs">{{zh?'接单大厅 ›':'Open jobs ›'}}</text></view><view class="flow-card runner-card"><view class="row strong"><text>{{zh?'本周完成 '+(weekly.target||5)+' 单 → 奖励 +¥'+(weekly.amount||5):'This week: '+(weekly.target||5)+' jobs → +¥'+(weekly.amount||5)+' bonus'}}</text><text>{{weekly.count||0}}/{{weekly.target||5}}</text></view><view class="segments"><view wx:for="{{weekly.segments}}" wx:key="index" class="{{item?'filled':''}}"/></view><view class="hint">{{zh?(weekly.earned?'已达成目标':'周日 23:59 前完成更多任务'):weekly.earned?'Target reached':'Complete more jobs by Sunday 23:59'}} · {{zh?'测试奖励已记录到你的账号。':'test reward recorded with your account.'}}</view></view><view class="flow-card runner-card"><view class="strong">{{zh?'午餐高峰 · 每单 +¥'+(rush.amount||1):'Lunch rush · +¥'+(rush.amount||1)+' per job'}}</view><view class="hint">{{zh?'从 '+(rush.station||'North gate')+' 取外卖，'+(rush.timeLabel||'')+'。在同学支付的赏金之外额外发放。':'Takeaway from '+(rush.station||'North gate')+', '+(rush.timeLabel||'')+'. Added on top of the student’s fee.'}}</view></view>
<view class="section">{{zh?'动态':'News'}}</view><view class="flow-card"><view wx:for="{{news}}" wx:key="title" class="menu-row"><view><view class="strong">• {{item.title}}</view><view class="hint">{{item.body}}</view><view class="hint">{{item.date}}</view></view></view></view><view class="hint center">{{zh?'每单限用一张优惠券 · 仅限西浦学生。优惠部分由 UniEarn 承担，跑手的赏金全额保留。':'One coupon per order · XJTLU students only. UniEarn covers the coupon part; runners keep their full delivery fee.'}}</view><view class="test-note">{{zh?'团队测试：付款、补贴和奖励均为模拟。':'Team test: payments, subsidies and bonuses are simulated.'}}</view></view><app-nav id="app-nav" active="rewards"/>

<yuni-assistant topic=""/>
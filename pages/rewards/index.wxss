.event-banner{background:#8b1e2b;color:#fff;border-radius:30rpx;padding:30rpx;line-height:1.6;margin-bottom:35rpx}.event-tag{display:inline-block;background:white;color:#8b1e2b;padding:5rpx 18rpx;border-radius:30rpx;font-size:21rpx;font-weight:700}.event-title{font-size:34rpx;font-weight:800;line-height:1.35;margin:18rpx 0}.collect-event{display:inline-block;background:#fff;color:#8b1e2b;border-radius:45rpx;font-size:24rpx;margin-top:24rpx;padding:0 28rpx}.collected{font-weight:700;margin-top:30rpx}.coupon{display:flex;align-items:stretch;background:#fff;border:1rpx solid #e7d9cb;border-radius:27rpx;overflow:hidden;margin-bottom:18rpx;min-height:178rpx}.coupon-face{width:165rpx;flex:none;background:#fdf2f0;border-right:2rpx dashed #e7d9cb;display:flex;flex-direction:column;justify-content:center;align-items:center;color:#8b1e2b;font-weight:800;font-size:34rpx}.coupon-face text{font-size:21rpx;font-weight:600}.coupon-info{flex:1;padding:25rpx 20rpx;min-width:0}.coupon-info .hint{font-size:22rpx;margin:8rpx 0}.coupon-end{font-size:21rpx;color:#7a1a26;font-weight:700}.use{align-self:center;margin:0 24rpx 0 0;padding:0 24rpx;border-radius:50rpx;background:#8b1e2b;color:white;font-size:23rpx;flex:none}.small-outline{margin:0;flex:none;background:white;color:#8b1e2b;border:2rpx solid #8b1e2b;border-radius:40rpx;font-size:23rpx;padding:0 20rpx}.runner-card{border-color:#b4ccc2}.segments{display:flex;gap:7rpx;margin:26rpx 0}.segments view{height:11rpx;flex:1;background:#e5e4dc;border-radius:10rpx}.segments .filled{background:#8b1e2b}
.rewards-page .summary-head{background:#fff;margin:-28rpx -30rpx 22rpx;padding:30rpx 30rpx 18rpx;border-bottom:1rpx solid #e7e5df}.rewards-page .event-banner{margin-top:20rpx;min-height:280rpx}.rewards-page .section{margin:30rpx 0 18rpx}.examples-title{font-weight:700;font-size:26rpx;margin:25rpx 0 4rpx}.examples-note{margin-bottom:16rpx}.example-coupon{border-color:#e5d9d0}.example-coupon .use{font-size:21rpx;padding:0 15rpx}.rewards-page .coupon-info{overflow:hidden}.rewards-page .coupon-info .strong{line-height:1.35}.rewards-page .coupon-face{width:165rpx}.rewards-page .event-banner button{min-height:64rpx;line-height:64rpx}
/* Explicit sizes override WeChat v2 button defaults inside flex cards. */
.rewards-page .coupon{width:100%;min-height:176rpx;align-items:stretch}
.rewards-page .coupon-face{width:165rpx;flex:0 0 165rpx}
.rewards-page .coupon-info{flex:1 1 0;min-width:0;padding:25rpx 24rpx}
.rewards-page .coupon-info .strong{font-size:27rpx;line-height:1.45}
.rewards-page .coupon .use{box-sizing:border-box;display:flex;align-items:center;justify-content:center;align-self:center;flex:0 0 98rpx;width:98rpx;min-width:0;max-width:98rpx;height:74rpx;min-height:74rpx;line-height:1;padding:0;margin:0 24rpx 0 0;border:0;border-radius:42rpx;font-size:24rpx;font-weight:700}
.rewards-page .coupon .use::after{border:0}
.rewards-page .coupon.example-coupon .use{font-size:20rpx}
.rewards-page .coupon-face.cash{background:#f5f5f2;color:#3b2a20}

.rewards-page .collect-card{display:flex;align-items:center;gap:18rpx;padding:26rpx;margin:18rpx 0}.collect-copy{flex:1;min-width:0}.collect-copy .strong{font-size:27rpx;line-height:1.35}.collect-copy .hint{font-size:22rpx;margin:7rpx 0 0}.invite-icon{width:72rpx;height:72rpx;flex:0 0 72rpx;display:flex;align-items:center;justify-content:center;background:#f9e9e6;border-radius:20rpx}.invite-icon image{width:31rpx;height:31rpx}.rewards-page .small-outline{box-sizing:border-box;display:flex;align-items:center;justify-content:center;flex:0 0 126rpx;width:126rpx;min-width:126rpx;max-width:126rpx;height:74rpx;min-height:74rpx;line-height:1;padding:0;margin:0;border:2rpx solid #a02a33;border-radius:42rpx;font-size:24rpx;font-weight:700;background:#fff;color:#a02a33}.rewards-page .small-outline::after{border:0}.rewards-page .small-outline[disabled]{border-color:#d3c5bd;color:#aaa79f;background:#f5f4ef}.rewards-page .coupon-face{width:160rpx;flex-basis:160rpx}.rewards-page .coupon .use{background:#a02a33;width:94rpx;max-width:94rpx;flex-basis:94rpx}.rewards-page .section .link{color:#8b1e2b}.rewards-page .runner-card .row>text:first-child{flex:1;min-width:0}.rewards-page .runner-card .row{gap:16rpx}.rewards-page .runner-card .row>text:last-child{flex:none;color:#8b1e2b}

.news-section-label{font-size:29rpx;font-weight:700;margin:36rpx 0 18rpx}.points-entry{display:flex;gap:24rpx;align-items:center;padding:30rpx 26rpx;background:var(--news-surface);border:1rpx solid var(--news-line);border-radius:30rpx}.trophy-box{width:112rpx;height:130rpx;display:flex;align-items:center;justify-content:center;flex:none;border-radius:24rpx;background:#f9f2e6}.trophy-box image{width:94rpx;height:94rpx}.points-copy{flex:1;min-width:0}.points-status{display:inline-block;background:#fbf0e5;color:#aa542e;font-size:19rpx;border-radius:8rpx;padding:4rpx 10rpx;margin-top:10rpx}.news-small{font-size:23rpx;color:var(--news-muted);line-height:1.7}.points-copy .news-small{margin-top:12rpx}.ranking-status{font-size:21rpx;color:var(--news-muted);line-height:1.6;margin-top:12rpx}.news-chevron{color:#b9b1a7;font-size:40rpx;flex:none}.channel-empty{background:var(--news-surface);border:1rpx solid var(--news-line);border-radius:26rpx;padding:28rpx;margin-top:30rpx}.channel-heading{display:flex;align-items:center;gap:18rpx;font-size:27rpx;font-weight:600}.channel-icon{width:52rpx;height:52rpx;display:flex;align-items:center;justify-content:center;border:1rpx solid var(--news-line);border-radius:14rpx;color:#938575}.channel-heading .news-chevron{margin-left:auto}.channel-summary{font-size:22rpx;line-height:1.7;color:var(--news-muted);margin:12rpx 0 0 70rpx}.news-section-head{display:flex;align-items:center;justify-content:space-between;gap:12rpx}.news-section-head>text{font-size:22rpx;color:var(--news-muted);margin-top:18rpx}.perk-card{background:var(--news-surface);border:1rpx solid var(--news-line);border-radius:26rpx;padding:30rpx}.perk-kicker{font-size:20rpx;color:#b45b31;letter-spacing:2rpx;font-weight:700}.perk-title{font-size:38rpx;font-weight:800;margin:18rpx 0 10rpx}.perk-link{font-size:24rpx;color:var(--news-accent);margin-top:24rpx;font-weight:600}.channel-link{padding:26rpx 10rpx;font-size:26rpx;border-bottom:1rpx solid var(--news-line)}.channel-link text{f
.rewards-page .summary-head{background:transparent;margin:-28rpx -30rpx 22rpx;padding:30rpx 30rpx 18rpx;border-bottom:1rpx solid #e2e0d9}.rewards-page .event-banner{margin-top:20rpx;min-height:280rpx}.rewards-page .section{margin:30rpx 0 18rpx}.examples-title{font-weight:700;font-size:26rpx;margin:25rpx 0 4rpx}.examples-note{margin-bottom:16rpx}.example-coupon{border-color:#cfe8dc}.example-coupon .use{font-size:21rpx;padding:0 15rpx}.rewards-page .coupon-info{overflow:hidden}.rewards-page .coupon-info .strong{line-height:1.35}.rewards-page .coupon-face{width:165rpx}.rewards-page .event-banner button{min-height:64rpx;line-height:64rpx}
/* Explicit sizes override WeChat v2 button defaults inside flex cards. */
.rewards-page .coupon{width:100%;min-height:176rpx;align-items:stretch}
.rewards-page .coupon-face{width:165rpx;flex:0 0 165rpx}
.rewards-page .coupon-info{flex:1 1 0;min-width:0;padding:25rpx 24rpx}
.rewards-page .coupon-info .strong{font-size:27rpx;line-height:1.45}
.rewards-page .coupon .use{box-sizing:border-box;display:flex;align-items:center;justify-content:center;align-self:center;flex:0 0 98rpx;width:98rpx;min-width:0;max-width:98rpx;height:74rpx;min-height:74rpx;line-height:1;padding:0;margin:0 24rpx 0 0;border:0;border-radius:42rpx;font-size:24rpx;font-weight:700}
.rewards-page .coupon .use::after{border:0}

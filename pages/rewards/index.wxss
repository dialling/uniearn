.rewards-page .coupon-face.cash{background:#f7f6f2;color:#16181c}

.rewards-page .collect-card{display:flex;align-items:center;gap:18rpx;padding:26rpx;margin:18rpx 0}.collect-copy{flex:1;min-width:0}.collect-copy .strong{font-size:27rpx;line-height:1.35}.collect-copy .hint{font-size:22rpx;margin:7rpx 0 0}.invite-icon{width:72rpx;height:72rpx;flex:0 0 72rpx;display:flex;align-items:center;justify-content:center;background:#e7f3ed;border-radius:20rpx}.invite-icon image{width:31rpx;height:31rpx}.rewards-page .small-outline{box-sizing:border-box;display:flex;align-items:center;justify-content:center;flex:0 0 126rpx;width:126rpx;min-width:126rpx;max-width:126rpx;height:74rpx;min-height:74rpx;line-height:1;padding:0;margin:0;border:2rpx solid #0b7a55;border-radius:42rpx;font-size:24rpx;font-weight:700;background:#fff;color:#0b7a55}.rewards-page .small-outline::after{border:0}.rewards-page .small-outline[disabled]{border-color:#d6d2c6;color:#c9c5b8;background:#f7f6f2}.rewards-page .coupon-face{width:160rpx;flex-basis:160rpx}.rewards-page .coupon .use{background:#0b7a55;width:94rpx;max-width:94rpx;flex-basis:94rpx}.rewards-page .section .link{color:#0b7a55}.rewards-page .runner-card .row>text:first-child{flex:1;min-width:0}.rewards-page .runner-card .row{gap:16rpx}.rewards-page .runner-card .row>text:last-child{flex:none;color:#0b7a55}

.news-article{overflow:hidden}.news-article .news-cover{width:100%;border-radius:18rpx;margin-bottom:20rpx}.news-headline{font-size:30rpx;word-break:break-word}.news-copy{display:block;white-space:pre-wrap;word-break:break-word;font-size:26rpx;line-height:1.8;margin:18rpx 0;color:inherit}


page{background:#eeede8;color:#16181c}.sms-page{padding:32rpx 28rpx 70rpx}.heading{font-size:42rpx;font-weight:800}.intro{font-size:25rpx;color:#6b6860;line-height:1.6;margin:20rpx 0}.actions{display:flex;gap:18rpx}.actions button{width:auto;flex:1;margin:0;padding:16rpx 10rpx;line-height:1.5;font-size:27rpx;background:#fff;color:#c2410c;border-radius:20rpx}button::after{border:0}.paste-box,.candidate{background:#fff;padding:26rpx;border-radius:24rpx;margin:22rpx 0}.row{display:flex;justify-content:space-between;align-items:center;gap:16rpx;font-size:24rpx}.strong{font-weight:700}.link{color:#c2410c;padding:10rpx}.paste-box textarea{box-sizing:border-box;width:100%;height:150rpx;background:#f7f6f2;padding:18rpx;margin:16rpx 0;font-size:26rpx}.paste-box button{width:100%;font-size:26rpx;background:#e7f3ed;color:#c2410c}.candidate{border:2rpx solid transparent}.candidate.selected{border-color:#0b7a55}.pick{display:flex;align-items:center;gap:18rpx;min-height:70rpx;width:100%}.box{font-size:42rpx;color:#c2410c}input{box-sizing:border-box;width:100%;height:85rpx;padding:12rpx 16rpx;background:#f7f6f2;border-radius:12rpx;margin:14rpx 0;font-size:30rpx}.point{font-size:25rpx;color:#c2410c;line-height:1.6}.message{font-size:23rpx;line-height:1.6;color:#6b6860;margin-top:14rpx}.note,.error{padding:24rpx;border-radius:18rpx;font-size:26rpx;line-height:1.6;margin:22rpx 0}.note{background:#e7f3ed;color:#c2410c}.error{background:#fdf6f2;color:#c2410c}.confirm{width:100%;background:#c2410c;color:#fff;border-radius:22rpx;margin-top:28rpx}.confirm[disabled]{background:#e4e1d8;color:#8a877e}

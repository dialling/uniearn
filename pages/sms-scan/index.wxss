page{background:#f3f2ed;color:#202322}.sms-page{padding:32rpx 28rpx 70rpx}.heading{font-size:42rpx;font-weight:800}.intro{font-size:25rpx;color:#72766d;line-height:1.6;margin:20rpx 0}.actions{display:flex;gap:18rpx}.actions button{width:auto;flex:1;margin:0;padding:16rpx 10rpx;line-height:1.5;font-size:27rpx;background:#fff;color:#6e141f;border-radius:20rpx}button::after{border:0}.paste-box,.candidate{background:#fff;padding:26rpx;border-radius:24rpx;margin:22rpx 0}.row{display:flex;justify-content:space-between;align-items:center;gap:16rpx;font-size:24rpx}.strong{font-weight:700}.link{color:#ad5936;padding:10rpx}.paste-box textarea{box-sizing:border-box;width:100%;height:150rpx;background:#f5f5f1;padding:18rpx;margin:16rpx 0;font-size:26rpx}.paste-box button{width:100%;font-size:26rpx;background:#edf2ef;color:#6e141f}.candidate{border:2rpx solid transparent}.candidate.selected{border-color:#47766b}.pick{display:flex;align-items:center;gap:18rpx;min-height:70rpx;width:100%}.box{font-size:42rpx;color:#6e141f}input{box-sizing:border-box;width:100%;height:85rpx;padding:12rpx 16rpx;background:#f4f4f0;border-radius:12rpx;margin:14rpx 0;font-size:30rpx}.point{font-size:25rpx;color:#6e141f;line-height:1.6}.message{font-size:23rpx;line-height:1.6;color:#7a7d77;margin-top:14rpx}.note,.error{padding:24rpx;border-radius:18rpx;font-size:26rpx;line-height:1.6;margin:22rpx 0}.note{background:#e5efea;color:#6e141f}.error{background:#ffede2;color:#9d4e2a}.confirm{width:100%;background:#6e141f;color:#fff;border-radius:22rpx;margin-top:28rpx}.confirm[disabled]{background:#dcdfd9;color:#888}

<import src="../../utils/customer-cancel-sheet.wxml"/>
<import src="../../utils/waiting-ticket.wxml"/>
<view style="{{motionStyle}}">
<lang-switch></lang-switch>
<view class="flow-page task-page {{zh?'task-cn':''}} {{darkClass}}" wx:if="{{request}}">
<view class="flow-title">{{request.isMine?ui.myTask:ui.yourTask}}</view>
<view class="flow-sub">{{ui.badge}} · {{request.taskMode==='online'?(zh?'线上帮助':'Online help'):(zh?'线下帮助':'Offline help')}}</view>
<view wx:if="{{request.feedbackOpen}}" class="flow-card"><view class="strong" style="color:#b33838">{{zh?'问题反馈处理中':'Feedback in progress'}}</view><view class="hint">{{zh?'该订单的问题尚未解决，请跟进处理。':'This order has an unresolved issue. Please follow up.'}}</view></view>
<view wx:if="{{request.status!=='waiting' && !request.feedbackOpen}}" class="progress-row task-progress-row"><view class="progress-step active">{{request.status==='waiting'?(zh?'1 · 待接单':'1 · Waiting'):(zh?'1 · 完成任务':'1 · Do task')}}</view><view class="progress-step {{request.status==='delivered'||request.status==='confirmed'?'active':''}}">{{zh?'2 · 提交凭证':'2 · Submit proof'}}</view><view class="progress-step {{request.status==='confirmed'?'active':''}}">{{zh?'3 · 完成':'3 · Done'}}</view></view>
<view wx:if="{{request.dueAt && request.status!=='waiting'}}" class="flow-sub">{{ui.doneBy}}{{request.due}}</view>
<view wx:if="{{request.status==='waiting' && !request.feedbackOpen}}" class="journey-ticket task-waiting-ticket">
 <view class="journey-ticket-band"><text class="journey-brand">UniEarn</text><text class="journey-band-divider">|</text><text class="journey-band-title">{{zh?'任务旅程':'Task journey'}}</text><image class="journey-anchor" src="/assets/journey-anchor.svg" mode="aspectFit"/></view>
 <view class="journey-ticket-body"><view class="journey-hero"><image class="journey-mascot" src="/assets/yuni-journey-ticket.png" mode="aspectFit"/><view class="journey-status"><view class="journey-status-title">{{zh?'等待跑手接单':'Waiting for a runner'}}</view><view class="journey-status-note">{{request.cancellation?(zh?'任务已退回大厅，正在等待新的跑手。':'Your task is back on the board, waiting for another runner.'):(zh?'任务已发布，正在等待跑手。':'Your task is on the job board.')}}</view></view></view>
 <view class="journey-progress"><view wx:for="{{taskJourneySteps}}" wx:key="name" class="journey-step {{index===0?'current':''}}"><view class="journey-step-dot">{{index===0?'✓':''}}</view><view class="journey-step-name">{{item.name}}</view><view class="journey-step-time">{{index===0?item.time:''}}</view></view></view>
 <view class="journey-route-section"><view class="task-ticket-type">{{request.taskMode==='online'?(zh?'线上帮助':'Online help'):(zh?'线下帮助':'Offline help')}}</view><view class="task-ticket-title">{{request.title}}</view><view class="journey-times"><view><text>{{zh?'发布：':'Posted: '}}</text><text>{{taskPostedTime}}</text></view><view><text>{{zh?'截止：':'Deadline: '}}</text><text>{{request.dueAt?request.due:(zh?'无截止时间':'No deadline')}}</text></view></view></view>
 </view>
</view>
<view wx:elif="{{!request.feedbackOpen && !(request.isRunner && request.status==='taken')}}" class="flow-card status-card">
<view class="status-stub"><image class="status-yuni" src="/assets/yuni-wave.png" mode="aspectFit"/></view>
<view class="status-copy">
<view class="flow-title">{{request.statusTitle}}</view>
<template is="orderStatusNote" data="{{request,zh}}"/>
</view>
</view>
<view class="flow-card task-detail-card">
<view class="task-card-head">
  <view class="task-person"><view class="task-avatar" aria-hidden="true">{{request.contactInitial}}</view><view class="task-heading"><view class="strong">{{request.contactName}}</view><view class="hint">{{request.dueAt?request.due:(zh?'无截止时间':'No deadline')}}</view></view></view>
  <view class="task-contact-area"><text class="task-type">{{ui.badge}}</text>
    <view wx:if="{{request.runnerId}}" class="task-contact-actions">
      <view class="task-message-action"><button class="task-icon" bindtap="chat" aria-label="{{ui.messages+(request.unread>0?(zh?'，未读 ':', unread ')+request.unread:'')}}"><image src="/assets/message.svg"/></button><text wx:if="{{request.unread>0}}" class="task-unread-badge">{{request.unread>99?'99+':request.unread}}</text></view>
      <button wx:if="{{request.isMine?request.runnerPhone:request.phone}}" class="task-icon" bindtap="phone" aria-label="{{ui.call}}"><image src="/assets/phone.svg"/></button>
    </view>
  </view>
</view>
<view class="task-info-block"><view class="task-info-label">{{zh?'任务内容':'Task details'}} · {{request.taskMode==='online'?(zh?'线上帮助':'Online help'):(zh?'线下帮助':'Offline help')}}</view><view class="task-title">{{request.title}}</view></view>
<view wx:if="{{request.pictures.length}}" class="task-info-block"><view class="task-info-label">{{zh?'参考图片':'Reference photos'}}</view><image wx:for="{{request.pictures}}" wx:key="*this" class="thumb" src="{{item}}" mode="aspectFill" data-photo="{{item}}" bindtap="preview"/></view>
<view wx:if="{{request.isRunner && request.status==='taken'}}" class="task-completion">
<view class="strong">{{ui.whenDone}}</view>
<view class="hint">{{ui.sendHint}}</view>
<view class="task-photo-card"><view class="task-photo-icon"><image src="/assets/camera.svg" mode="aspectFit"/></view><view class="task-photo-copy"><view class="task-photo-title">{{ui.takePhoto}}</view><view class="task-photo-sub">{{zh?'添加任务完成照片':'Add completion photos'}}</view><view class="task-photo-hint">{{zh?'选填 · 拍照或从相册选择':'Optional · Camera or album'}}</view></view><button class="task-photo-add" bindtap="handlePhoto"><text class="task-photo-plus">＋</text><text>{{zh?'上传':'Upload'}}</text></button></view>
<image wx:if="{{photo}}" class="proof" src="{{photo}}" mode="aspectFill"/>
<textarea class="field" data-field="note" bindinput="field" maxlength="500" value="{{note}}" placeholder="{{ui.notePlaceholder}}"/>
<button class="btn task-primary" loading="{{sending}}" disabled="{{sending}}" bindtap="done">{{ui.sendBoth}}</button>
<view class="task-secondary-actions">
<button class="task-small-action" bindtap="giveBack">{{ui.giveBack}}</button>
<button class="task-small-action" data-reason="mismatch" bindtap="giveBack">{{ui.mismatch}}</button>
</view>
</view>

<view class="row task-reward"><text class="hint">{{request.isMine?ui.yourPrice:ui.youGet}}</text><text class="strong">¥{{request.rewardText}}</text></view>
</view>
<view wx:if="{{request.isMine && request.category==='task' && request.runnerId && (request.status==='taken'||request.status==='delivered')}}" class="flow-card task-tip-card"><view class="task-tip-head"><view class="strong">{{zh?'给跑手小费':'Tip your runner'}}</view><text class="task-tip-optional">{{zh?'选填':'Optional'}}</text></view><view class="hint">{{zh?'想表达感谢？金额由你决定，小费计入跑手收益。':'Want to say thanks? Choose any amount to add to your runner’s earnings.'}}</view><view wx:if="{{request.taskTip>0}}" class="task-tip-given">{{zh?'已添加小费':'Tips added'}} ¥{{request.taskTipText}}</view><view class="task-tip-input-row"><text>¥</text><input type="digit" maxlength="12" value="{{tipAmount}}" bindinput="tipInput" placeholder="{{zh?'输入小费金额':'Enter tip amount'}}" disabled="{{tipping}}" aria-label="{{zh?'小费金额':'Tip amount'}}"/><button class="task-tip-add" bindtap="addTip" loading="{{tipping}}" disabled="{{!tipValid||tipping}}">{{zh?'添加小费':'Add tip'}}</button></view></view>
<view wx:if="{{request.isMine && request.status==='waiting'}}" class="flow-card offer-card">
<view class="offer-heading">
<text class="strong">{{zh?'提高赏金':'Add to your offer'}}</text>
<text class="offer-current">{{zh?'当前赏金':'Your offer'}} <text>¥{{request.rewardText}}</text>
</text>
</view>
<view class="hint offer-hint">{{zh?'提高赏金，更容易被跑手接单。加价只对整笔订单计算一次。':'Higher offers get taken sooner. Added once to the whole order.'}}</view>
<view class="offer-options">
<button wx:for="{{offerAmounts}}" wx:key="*this" class="offer-option" hover-class="offer-option-press" data-amount="{{item}}" bindtap="raise">＋¥{{item}}</button>
<button class="offer-option offer-custom" hover-class="offer-option-press" bindtap="customRaise">{{zh?'自定义':'Custom'}}</button>
</view>
<view class="offer-footer">
<view class="offer-footer-copy">

<text class="hint" wx:if="{{request.closesAt}}">{{zh?'若 '+request.closeTime+' 前无人接单，将全额退款。':'Full refund if nobody takes it by '+request.closeTime+'.'}}</text>
<text class="hint" wx:else>{{zh?'无人接单时可免费取消。':'Cancel free before a runner accepts.'}}</text>
<view wx:if="{{request.status!=='waiting' && cancelWindow.phase!=='hidden'}}" class="cancel-tip {{cancelWindow.phase==='grace'?'cancel-tip-live':''}}">{{cancelWindow.tip}}</view>
</view>
<button wx:if="{{cancelWindow.canCancel}}" class="offer-cancel" hover-class="offer-cancel-press" bindtap="cancel">{{cancelWindow.button}}</button>
</view>
</view>
<view wx:if="{{request.photo||request.completionNote}}" class="flow-card">
<image wx:if="{{request.photo}}" class="proof" src="{{request.photo}}" mode="aspectFill" data-photo="{{request.photo}}" bindtap="preview"/>
<view class="hint">{{zh?'完成说明 · ':'Completion · '}}{{request.deliveredTime}}</view>
<view wx:if="{{request.completionNote}}" class="value">“{{request.completionNote}}”</view>
</view>
<view wx:if="{{request.isMine && request.status==='delivered'}}" class="flow-card">
<button class="btn" bindtap="confirm">{{ui.confirmPre}}{{request.rewardText}}</button>


</view>
<view class="flow-card">
<view class="strong">{{zh?'费用明细':'Price details'}}</view>
<view wx:if="{{request.taskTip>0}}" class="row hint"><text>{{zh?'任务赏金':'Task offer'}}</text><text>¥{{request.taskBaseText}}</text></view><view wx:if="{{request.taskTip>0}}" class="row hint"><text>{{zh?'给跑手的小费':'Runner tip'}}</text><text>¥{{request.taskTipText}}</text></view><view class="row hint">
<text>{{ui.serviceFee}}</text>
<text>¥{{request.fee}}</text>
</view>
<view class="row strong">
<text>{{ui.totalSim}}</text>
<text>¥{{request.total}}</text>
</view>
<view wx:if="{{request.status==='refunded'||request.status==='cancelled'}}" class="hint">{{ui.refund}}{{request.refundAmount}}</view>
</view>
<order-feedback order-id="{{request.id}}" resolvable="{{request.canResolveFeedback}}" completes="{{request.feedbackResolutionCompletes}}" zh="{{zh}}" dark="{{darkClass}}"/>
</view>
<view wx:else class="empty">{{ui.unavailable}}</view>
<yuni-assistant topic=""/>
</view>

<template is="customerCancelSheet" data="{{cancelOpen,cancelOptions,cancelReason,cancelNote,cancelNoteOpen,cancelReady,cancelling,zh}}"/>

<view wx:if="{{request.cancelReasonLabel}}" class="flow-card"><view class="strong">{{zh?'取消原因':'Cancellation reason'}}</view><view>{{request.cancelReasonLabel}}</view></view>

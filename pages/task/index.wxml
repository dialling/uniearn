<import src="../../utils/waiting-ticket.wxml"/>
<view style="{{motionStyle}}">
<lang-switch></lang-switch>
<view class="flow-page task-page {{zh?'task-cn':''}} {{darkClass}}" wx:if="{{request}}">
<view class="flow-card order-progress-card">
  <view class="order-progress-label">{{ui.progress}}</view>
  <view class="order-progress-track">
    <view wx:for="{{request.progress}}" wx:key="label" class="order-progress-step {{item.done?'done':''}} {{item.done && (index===3 || !request.progress[index+1].done)?'current':''}}">
      <view class="order-progress-dot"/>
      <view class="order-progress-name">{{ui.labels[item.label]||item.label}}</view>
    </view>
  </view>
</view>
<view class="flow-title">{{request.isMine?ui.myTask:ui.yourTask}}</view>
<view wx:if="{{request.dueAt}}" class="flow-sub">{{ui.doneBy}}{{request.due}}</view>
<template wx:if="{{request.status==='waiting'}}" is="waitingTicket" data="{{request,zh}}"/>
<view wx:else class="flow-card status-card">

<view class="status-copy">
<view class="flow-title">{{request.statusTitle}}</view>
<template is="orderStatusNote" data="{{request,zh}}"/>
</view>
</view>
<view class="flow-card task-detail-card">
<view class="task-card-head">
  <view class="task-person"><view class="task-avatar" aria-hidden="true">{{request.contactInitial}}</view><view class="task-heading"><view class="strong">{{request.contactName}}</view><view class="hint">{{request.dueAt?request.due:(zh?'无截止时间':'No deadline')}}</view></view></view>
  <view class="task-contact-area"><text class="task-type">{{ui.badge}}</text>
    <view wx:if="{{request.runnerId}}" class="task-contact-actions">
      <view class="task-message-action"><button class="task-icon" bindtap="chat" aria-label="{{ui.messages+(request.unread>0?(zh?'，未读 ':', unread ')+request.unread:'')}}"><image src="/assets/message.svg"/></button><text wx:if="{{request.unread>0}}" class="task-unread-badge">{{request.unread>99?'99+':request.unread}}</text></view>
      <button wx:if="{{request.isMine?request.runnerPhone:request.phone}}" class="task-icon" bindtap="phone" aria-label="{{ui.call}}"><image src="/assets/phone.svg"/></button>
    </view>
  </view>
</view>
<view class="task-info-block"><view class="task-info-label">{{zh?'任务内容':'Task details'}}</view><view class="task-title">{{request.title}}</view></view>
<view wx:if="{{request.pictures.length}}" class="task-info-block"><view class="task-info-label">{{zh?'参考图片':'Reference photos'}}</view><image wx:for="{{request.pictures}}" wx:key="*this" class="thumb" src="{{item}}" mode="aspectFill" data-photo="{{item}}" bindtap="preview"/></view>
<view wx:if="{{request.isRunner && request.status==='taken'}}" class="task-completion">
<view class="strong">{{ui.whenDone}}</view>
<view class="hint">{{ui.sendHint}}</view>
<view class="upload-card upload-blue"><view class="upload-head" bindtap="handlePhoto" hover-class="upload-card-press" role="button"><view class="upload-icon"><image src="/assets/photo-blue.svg" mode="aspectFit"/></view><view class="upload-copy"><view class="upload-title">{{zh?'完成照片（选填）':'Completion photo (optional)'}}</view><view class="upload-hint">{{zh?'拍照或从相册选择，展示任务完成情况。':'Take or select a photo showing the completed task.'}}</view></view></view><text class="upload-count">{{(photo?1:0)}}/1</text><view wx:if="{{(photo?1:0)>0}}" class="upload-gallery"><view class="upload-tile"><image class="upload-image" src="{{photo}}" mode="aspectFill" data-photo="{{photo}}" bindtap="preview"/><view class="upload-remove" catchtap="removePhoto" role="button" aria-label="{{zh?'删除照片':'Remove photo'}}">×</view></view></view></view>
<textarea class="field" data-field="note" bindinput="field" maxlength="500" value="{{note}}" placeholder="{{ui.notePlaceholder}}"/>
<button class="btn task-primary" loading="{{sending}}" disabled="{{!validNote||sending}}" bindtap="done">{{ui.sendBoth}}</button>
<view class="task-secondary-actions">
<button class="task-small-action" bindtap="giveBack">{{ui.giveBack}}</button>
<button class="task-small-action" data-reason="mismatch" bindtap="giveBack">{{ui.mismatch}}</button>
</view>
</view>

<view class="row task-reward"><text class="hint">{{request.isMine?ui.yourPrice:ui.youGet}}</text><text class="strong">¥{{request.rewardText}}</text></view>
</view>
<view wx:if="{{request.isMine && (request.status==='waiting' || request.status==='taken' || request.status==='collected')}}" class="flow-card offer-card">
<view class="offer-heading">
<text class="strong">{{zh?'提高赏金':'Add to your offer'}}</text>
<text class="offer-current">{{zh?'当前赏金':'Your offer'}} <text>¥{{request.rewardText}}</text>
</text>
</view>
<view class="hint offer-hint">{{zh?'提高赏金，更容易被跑手接单。加价只对整笔订单计算一次。':'Higher offers get taken sooner. Added once to the whole order.'}}</view>
<view class="offer-options">
<button wx:for="{{offerAmounts}}" wx:key="*this" class="offer-option" hover-class="offer-option-press" data-amount="{{item}}" bindtap="raise">＋¥{{item}}</button>
<button class="offer-option offer-custom" hover-class="offer-option-press" bindtap="customRaise">{{zh?'自定义':'Custom'}}</button>
</view>
<view class="offer-footer">
<view class="offer-footer-copy">
<text class="hint" wx:if="{{request.status!=='waiting'}}">{{zh?'接单后仍可加价，金额计入整笔任务。':'You can still add to the offer after a runner accepts.'}}</text>
<text class="hint" wx:elif="{{request.closesAt}}">{{zh?'若 '+request.closeTime+' 前无人接单，将全额退款。':'Full refund if nobody takes it by '+request.closeTime+'.'}}</text>
<text class="hint" wx:else>{{zh?'无人接单时可免费取消。':'Cancel free before a runner accepts.'}}</text>
<view wx:if="{{cancelWindow.phase!=='hidden'}}" class="cancel-tip {{cancelWindow.phase==='grace'?'cancel-tip-live':''}}">{{cancelWindow.tip}}</view>
</view>
<button wx:if="{{cancelWindow.canCancel}}" class="offer-cancel" hover-class="offer-cancel-press" bindtap="cancel">{{cancelWindow.button}}</button>
</view>
</view>
<view wx:if="{{request.photo||request.completionNote}}" class="flow-card">
<image wx:if="{{request.photo}}" class="proof" src="{{request.photo}}" mode="aspectFill" data-photo="{{request.photo}}" bindtap="preview"/>
<view class="hint">{{zh?'完成说明 · ':'Completion · '}}{{request.deliveredTime}}</view>
<view class="value">“{{request.completionNote}}”</view>
</view>
<view wx:if="{{request.isMine && request.status==='delivered'}}" class="flow-card">
<button class="btn" bindtap="confirm">{{ui.confirmPre}}{{request.rewardText}}</button>
<button class="btn light" bindtap="issue">{{ui.wrong}}</button>
<block wx:if="{{reporting}}">
<view class="upload-card upload-blue"><view class="upload-head" bindtap="chooseIssuePhoto" hover-class="upload-card-press" role="button"><view class="upload-icon"><image src="/assets/photo-blue.svg" mode="aspectFit"/></view><view class="upload-copy"><view class="upload-title">{{zh?'问题凭证':'Issue evidence'}}</view><view class="upload-hint">{{zh?'拍照或从相册选择，帮助说明遇到的问题。':'Take or select a photo to explain the issue.'}}</view></view></view><text class="upload-count">{{(issuePhoto?1:0)}}/1</text><view wx:if="{{(issuePhoto?1:0)>0}}" class="upload-gallery"><view class="upload-tile"><image class="upload-image" src="{{issuePhoto}}" mode="aspectFill" data-photo="{{issuePhoto}}" bindtap="preview"/><view class="upload-remove" catchtap="removeIssuePhoto" role="button" aria-label="{{zh?'删除照片':'Remove photo'}}">×</view></view></view></view>
<textarea class="field" value="{{issueNote}}" data-field="issueNote" bindinput="field" placeholder="{{ui.whatWrong}}"/>
<button class="btn" disabled="{{!reason}}" bindtap="report">{{ui.sendUniearn}}</button>
</block>
</view>
<view class="flow-card">
<view class="strong">{{zh?'费用明细':'Price details'}}</view>
<view class="row hint">
<text>{{ui.serviceFee}}</text>
<text>¥{{request.fee}}</text>
</view>
<view class="row strong">
<text>{{ui.totalSim}}</text>
<text>¥{{request.total}}</text>
</view>
<view wx:if="{{request.status==='refunded'||request.status==='cancelled'}}" class="hint">{{ui.refund}}{{request.refundAmount}}</view>
</view>
<button class="btn light" bindtap="help">{{ui.help}}</button>
</view>
<view wx:else class="empty">{{ui.unavailable}}</view>
<yuni-assistant topic=""/>
</view>

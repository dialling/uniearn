<import src="../../utils/contact-identity.wxml"/>
<view style="{{motionStyle}}">
<lang-switch></lang-switch>
<view class="flow-page task-page {{zh?'task-cn':''}} {{darkClass}}" wx:if="{{request}}"><block wx:if="{{zh}}">
  <view class="task-heading"><view class="flow-title">{{request.isMine?ui.myTask:ui.yourTask}}</view><view class="hint">{{request.title}}</view></view>
  <view class="flow-card task-steps"><view wx:for="{{request.progress}}" wx:key="label" class="task-step {{item.done?'reached':''}} {{index===request.currentStep?'current':''}}">
    <view class="step-line"><view class="step-node"></view></view>
    <text>{{ui.labels[item.label]||item.label}}</text><text wx:if="{{item.time}}" class="step-clock">{{item.time}}</text>
  </view></view>
  <view class="flow-card task-state">
    <view class="state-title">{{request.status==='taken'?(request.runnerName||'跑手')+' 已接下任务':request.status==='delivered'?ui.sent:request.status==='confirmed'?ui.completed:request.statusLabel}}</view>
    <view wx:if="{{request.status==='taken'}}" class="hint">完成后，跑手会提交照片和说明。</view>
    <view wx:elif="{{request.status==='delivered'||request.status==='disputed'}}" class="hint">{{request.status==='delivered'?ui.waitingCheck:ui.underReview}}</view>
    <image class="state-yuni" src="/assets/yuni-wave.png" mode="aspectFit"/>
  </view>
  <view wx:if="{{request.runnerId}}" class="flow-card task-contact">
    <template is="contactIdentity" data="{{...peer}}"/>
    <view class="contact-tools">
      <view class="task-circle" bindtap="chat" hover-class="circle-press" role="button" aria-label="发消息"><image src="/assets/message.svg"/><text wx:if="{{request.unread}}" class="task-unread">{{request.unread}}</text></view>
      <view class="task-circle" bindtap="phone" hover-class="circle-press" role="button" aria-label="打电话"><image src="/assets/phone.svg"/></view>
    </view>
  </view>
  <view wx:if="{{request.dueAt}}" class="flow-card task-deadline"><view class="deadline-row">
    <view class="flow-head">任务截止时间</view>
    <button wx:if="{{!editingDeadline && request.isMine && (request.status==='waiting'||request.status==='taken')}}" class="deadline-change" bindtap="editDeadline" hover-class="deadline-press">更改</button>
  </view>
  <view class="deadline-fields">
    <picker class="deadline-picker" mode="date" start="{{today}}" disabled="{{!editingDeadline}}" value="{{editingDeadline?draftDate:request.dueDate}}" bindchange="pickDate"><view class="deadline-field"><text class="deadline-label">日期</text><view class="deadline-value"><text>{{editingDeadline?draftDate:request.dueDate}}</text><text wx:if="{{editingDeadline}}" class="deadline-chevron">›</text></view></view></picker>
    <picker class="deadline-picker" mode="time" disabled="{{!editingDeadline}}" value="{{editingDeadline?draftTime:request.dueTime}}" bindchange="pickTime"><view class="deadline-field"><text class="deadline-label">时间</text><view class="deadline-value"><text>{{editingDeadline?draftTime:request.dueTime}}</text><text wx:if="{{editingDeadline}}" class="deadline-chevron">›</text></view></view></picker>
  </view>
  <view class="hint deadline-note">此时间由顾客与接单人事先约定，如需更改，请双方协商确认。</view>
  <view wx:if="{{editingDeadline && request.isMine && (request.status==='waiting'||request.status==='taken')}}" class="deadline-actions"><button class="deadline-change" disabled="{{savingDeadline}}" bindtap="closeDeadline">取消</button><button class="deadline-change" disabled="{{savingDeadline}}" bindtap="saveDeadline">保存</button></view>
  </view>
</block><block wx:else><view class="flow-title">{{request.isMine?ui.myTask:ui.yourTask}}</view><view wx:if="{{request.dueAt}}" class="flow-sub">{{ui.doneBy}}{{request.due}}</view><yuni-tip tip-key="task-track" pose="work" text="{{ui.tip}}"/><view class="flow-card status-card"><view class="flow-title">{{request.status==='taken'?ui.took:request.status==='delivered'?ui.sent:request.status==='confirmed'?ui.completed:request.statusLabel}}</view><view class="hint">{{request.status==='delivered'?ui.waitingCheck:request.status==='disputed'?ui.underReview:''}}</view></view></block><view class="flow-card"><text class="badge task">{{ui.badge}}</text><text wx:if="{{zh}}" class="task-status-tag">{{request.statusLabel}}</text><view class="route task-title">{{request.title}}</view><view wx:if="{{zh && request.note}}" class="task-note"><view class="strong">任务备注</view><text>{{request.note}}</text></view><image wx:for="{{request.pictures}}" wx:key="*this" class="thumb" src="{{item}}" mode="aspectFill" data-photo="{{item}}" bindtap="preview"/><view wx:if="{{!zh && request.dueAt}}" class="row hint"><text>{{ui.doneByLabel}}</text><text>{{request.due}}</text></view><view class="row"><text>{{request.isMine?ui.yourPrice:ui.youGet}}</text><text class="money">¥{{request.rewardText}}</text></view><view wx:if="{{!zh && request.runnerId}}" class="action-row"><button class="btn light" bindtap="chat">{{ui.messages}} {{request.unread||''}}</button><button wx:if="{{request.isMine?request.runnerPhone:request.phone}}" class="btn light" bindtap="phone">{{ui.call}}</button></view><view wx:if="{{request.isRunner}}" class="hint">{{request.owner}}{{ui.seeLocation}}</view></view><view wx:if="{{request.isMine && request.status==='waiting'}}" class="flow-card"><view class="strong">{{ui.raiseTitle}}</view><view class="hint">{{zh?'你的赏金为 ¥'+request.rewardText+'。加价只对整笔订单计算一次。':'You’re offering ¥'+request.rewardText+'. A raise is added once to the whole order.'}}</view><view class="pill-row"><text class="pill" hover-class="pill-blue-press" data-amount="1.88" bindtap="raise">＋ ¥1.88</text><text class="pill" hover-class="pill-blue-press" data-amount="2.66" bindtap="raise">＋ ¥2.66</text><text class="pill" hover-class="pill-blue-press" data-amount="5.55" bindtap="raise">＋ ¥5.55</text><text class="pill" hover-class="pill-blue-press" data-amount="6.66" bindtap="raise">＋ ¥6.66</text><text class="pill" hover-class="pill-blue-press" data-amount="8.88" bindtap="raise">＋ ¥8.88</text></view><button class="cancel-order-button" hover-class="cancel-order-press" bindtap="cancel">{{ui.cancel}}</button></view><view wx:if="{{request.isRunner && request.status==='taken'}}" class="flow-card"><view class="strong">{{ui.whenDone}}</view><view class="hint">{{ui.sendHint}}</view><view class="dash" bindtap="handlePhoto">{{photo?ui.retake:ui.takePhoto}}</view><view wx:if="{{photo}}" class="pg-preview"><image class="proof" src="{{photo}}" mode="aspectFill" data-photo="{{photo}}" bindtap="preview"/><view class="pg-x" catchtap="removePhoto">×</view></view><textarea class="field" data-field="note" bindinput="field" maxlength="500" value="{{note}}" placeholder="{{ui.notePlaceholder}}"/><button class="btn" disabled="{{!photo||!note}}" bindtap="done">{{ui.sendBoth}}</button><view class="link" bindtap="giveBack">{{ui.giveBack}}</view><view class="hint link" data-reason="mismatch" bindtap="giveBack">{{ui.mismatch}}</view></view><view wx:if="{{request.photo}}" class="flow-card"><image class="proof" src="{{request.photo}}" mode="aspectFill" data-photo="{{request.photo}}" bindtap="preview"/><view class="hint">{{ui.completionPhoto}}{{request.deliveredTime}}</view><view class="value">“{{request.completionNote}}”</view></view><view wx:if="{{request.isMine && request.status==='delivered'}}" class="flow-card"><button class="btn" bindtap="confirm">{{ui.confirmPre}}{{request.rewardText}}</button><button class="btn light" bindtap="issue">{{ui.wrong}}</button><view class="hint">{{ui.autoHint}}</view><block wx:if="{{reporting}}"><view class="pills"><view wx:for="{{reasons}}" wx:key="*this" class="pill {{reason===item?'selected':''}}" data-value="{{item}}" bindtap="handleReason">{{ui.labels[item]||item}}</view></view><view class="dash" bindtap="chooseIssuePhoto">{{issuePhoto?ui.photoAdded:ui.evidence}}</view><view wx:if="{{issuePhoto}}" class="pg-grid"><view class="pg-tile" data-photo="{{issuePhoto}}" bindtap="preview"><image class="pg-img" src="{{issuePhoto}}" mode="aspectFill"/><view class="pg-x" catchtap="removeIssuePhoto">×</view></view></view><textarea class="field" value="{{issueNote}}" data-field="issueNote" bindinput="field" placeholder="{{ui.whatWrong}}"/><button class="btn" disabled="{{!reason}}" bindtap="report">{{ui.sendUniearn}}</button></block></view><view class="flow-card"><view wx:if="{{!zh}}" class="strong">{{ui.progress}}</view><view wx:if="{{!zh}}" wx:for="{{request.progress}}" wx:key="label" class="timeline"><text>{{item.done?'●':'○'}}</text><text>{{ui.labels[item.label]||item.label}}</text></view><view class="row hint"><text>{{ui.serviceFee}}</text><text>¥{{request.fee}}</text></view><view class="row strong"><text>{{ui.totalSim}}</text><text>¥{{request.total}}</text></view><view wx:if="{{request.status==='refunded'||request.status==='cancelled'}}" class="hint">{{ui.refund}}{{request.refundAmount}}</view></view><button class="btn light" bindtap="help">{{ui.help}}</button></view><view wx:else class="empty">{{ui.unavailable}}</view><yuni-assistant topic=""/>
</view>

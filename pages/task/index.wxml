<lang-switch/>
<view class="flow-page {{darkClass}}" wx:if="{{request}}"><view class="flow-title">{{request.isMine?ui.myTask:ui.yourTask}}</view><view class="flow-sub">{{ui.doneBy}}{{request.due}}</view><yuni-tip tip-key="task-track" pose="work" text="{{ui.tip}}"/><view class="flow-card status-card"><view class="flow-title">{{request.status==='taken'?ui.took:request.status==='delivered'?ui.sent:request.status==='confirmed'?ui.completed:request.statusLabel}}</view><view class="hint">{{request.status==='delivered'?ui.waitingCheck:request.status==='disputed'?ui.underReview:''}}</view></view><view class="flow-card"><text class="badge task">{{ui.badge}}</text><view class="route task-title">{{request.title}}</view><image wx:for="{{request.pictures}}" wx:key="*this" class="thumb" src="{{item}}" mode="aspectFill" data-photo="{{item}}" bindtap="preview"/><view class="row hint"><text>{{ui.doneByLabel}}</text><text>{{request.due}}</text></view><view class="row"><text>{{request.isMine?ui.yourPrice:ui.youGet}}</text><text class="money">¥{{request.rewardText}}</text></view><view wx:if="{{request.runnerId}}" class="action-row"><button class="btn light" bindtap="chat">{{ui.messages}} {{request.unread||''}}</button><button wx:if="{{request.isMine?request.runnerPhone:request.phone}}" class="btn light" bindtap="phone">{{ui.call}}</button></view><view wx:if="{{request.isRunner}}" class="hint">{{request.owner}}{{ui.seeLocation}}</view></view><view wx:if="{{request.isMine && request.status==='waiting'}}" class="flow-card"><view class="strong">{{ui.raiseTitle}}</view><view class="action-row"><button class="btn light" data-amount="1" bindtap="raise">+ ¥1</button><button class="btn light" data-amount="2" bindtap="raise">+ ¥2</button></view><view class="link" bindtap="cancel">{{ui.cancel}}</view></view><view wx:if="{{request.isRunner && request.status==='taken'}}" class="flow-card"><view class="strong">{{ui.whenDone}}</view><view class="hint">{{ui.sendHint}}</view><view class="dash" bindtap="handlePhoto">{{photo?ui.retake:ui.takePhoto}}</view><image wx:if="{{photo}}" class="proof" src="{{photo}}" mode="aspectFill"/><textarea class="field" data-field="note" bindinput="field" maxlength="500" value="{{note}}" placeholder="{{ui.notePlaceholder}}"/><button class="btn" disabled="{{!photo||!note}}" bindtap="done">{{ui.sendBoth}}</button><view class="link" bindtap="giveBack">{{ui.giveBack}}</view><view class="hint link" data-reason="mismatch" bindtap="giveBack">{{ui.mismatch}}</view></view><view wx:if="{{request.photo}}" class="flow-card"><image class="proof" src="{{request.photo}}" mode="aspectFill" data-photo="{{request.photo}}" bindtap="preview"/><view class="hint">{{ui.completionPhoto}}{{request.deliveredTime}}</view><view class="value">“{{request.completionNote}}”</view></view><view wx:if="{{request.isMine && request.status==='delivered'}}" class="flow-card"><button class="btn" bindtap="confirm">{{ui.confirmPre}}{{request.rewardText}}</button><button class="btn light" bindtap="issue">{{ui.wrong}}</button><view class="hint">{{ui.autoHint}}</view><block wx:if="{{reporting}}"><view class="pills"><view wx:for="{{reasons}}" wx:key="*this" class="pill {{reason===item?'selected':''}}" data-value="{{item}}" bindtap="handleReason">{{ui.labels[item]||item}}</view></view><view class="dash" bindtap="chooseIssuePhoto">{{issuePhoto?ui.photoAdded:ui.evidence}}</view><textarea class="field" value="{{issueNote}}" data-field="issueNote" bindinput="field" placeholder="{{ui.whatWrong}}"/><button class="btn" disabled="{{!reason}}" bindtap="report">{{ui.sendUniearn}}</button></block></view><view class="flow-card"><view class="strong">{{ui.progress}}</view><view wx:for="{{request.progress}}" wx:key="label" class="timeline"><text>{{item.done?'●':'○'}}</text><text>{{ui.labels[item.label]||item.label}}</text></view><view class="row hint"><text>{{ui.serviceFee}}</text><text>¥{{request.fee}}</text></view><view class="row strong"><text>{{ui.totalSim}}</text><text>¥{{request.total}}</text></view><view wx:if="{{request.status==='refunded'||request.status==='cancelled'}}" class="hint">{{ui.refund}}{{request.refundAmount}}</view></view><button class="btn light" bindtap="help">{{ui.help}}</button></view><view wx:else class="empty">{{ui.unavailable}}</view><yuni-assistant topic=""/>

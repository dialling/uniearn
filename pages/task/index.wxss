@import "../../utils/order-success.wxss";
@import "../../utils/journey-ticket.wxss";
@import "../../utils/photo-upload.wxss";
@import "../../utils/deadline-fields.wxss";
@import "../../utils/contact-identity.wxss";
@import "../../utils/flow.wxss";
@import "../../utils/order-detail-cards.wxss";
.task-title{white-space:pre-wrap;word-break:break-word}
/* Task details keep the pickup page layout but use the blue accent of the task posting flow. */
.task-page .pill-row .pill{border:2rpx solid #c3d2f7;background:#eef2ff;color:#1d4ed8;font-weight:700}
.task-page .pill-blue-press{background:#dbe5fb;border-color:#9fb6ee}
.task-page .cancel-order-button{display:flex;align-items:center;justify-content:center;width:100%;min-height:88rpx;padding:20rpx 24rpx;margin:24rpx 0 0;border:2rpx solid #c3d2f7;border-radius:20rpx;background:#f3f6fd;color:#1d4ed8;font-size:28rpx;font-weight:700;line-height:1.5;transition:var(--ue-transition,transform .16s ease,background .16s ease)}
.task-page .cancel-order-press{background:#e3eaf9;transform:scale(.99)}
.task-page .btn{background:#1d4ed8;color:#fff}
.task-page .btn.light{background:#eef2ff;color:#1d4ed8;border:1rpx solid #c3d2f7}
.task-page .btn.outline{background:#fff;color:#1d4ed8;border:1rpx solid #c3d2f7}
.task-page .btn[disabled]{background:#e4e1d8;color:#8a877e}
.page-dark .task-page .pill{background:#1d2433!important;border-color:#33406b!important;color:#9db4ff!important}
.page-dark .task-page .pill-blue-press{background:#233050}
.page-dark .task-page .cancel-order-button{background:#1d2433;border-color:#33406b;color:#9db4ff}
.page-dark .task-page .cancel-order-press{background:#233050}
.page-dark .task-page .btn{background:#9db4ff!important;color:#16181c!important}
.page-dark .task-page .btn.light,.page-dark .task-page .btn.outline{background:#1d2433!important;color:#9db4ff!important;border-color:#33406b!important}
.page-dark .task-page .btn[disabled]{background:#242522!important;color:#a9a69c!important}
.task-page .pill.selected{background:#1d4ed8;border-color:#1d4ed8;color:#fff}
.page-dark .task-page .pill.selected{background:#9db4ff!important;border-color:#9db4ff!important;color:#16181c!important}

.task-cn .flow-card{padding:26rpx;border:1rpx solid #e4e1d9;border-radius:24rpx;box-shadow:none}
.task-heading{margin-bottom:24rpx}.task-heading .hint{margin:4rpx 0 0}
.task-steps{display:flex}.task-step{flex:1;min-width:0;text-align:center;color:#827e74;font-size:22rpx}
.step-line{height:24rpx;display:flex;justify-content:center;align-items:center;position:relative;margin-bottom:8rpx}
.step-line::before{content:"";position:absolute;left:-50%;right:50%;height:4rpx;background:#e2dfd6}
.task-step:first-child .step-line::before{display:none}.reached .step-line::before{background:#087751}
.step-node{width:18rpx;height:18rpx;border-radius:50%;background:white;border:3rpx solid #d8d4ca;z-index:1}
.reached .step-node{background:#087751;border-color:#087751}.current .step-node{background:white;border-color:#2854cf}
.reached{color:#252823}.current{font-weight:700}.step-clock{display:block;font-size:20rpx;color:#77736a}
.task-cn .task-state{position:relative;border-left:6rpx solid #087751;padding-right:120rpx;min-height:124rpx}
.state-title{font-size:30rpx;font-weight:700}.state-yuni{position:absolute;right:20rpx;bottom:15rpx;width:82rpx;height:92rpx}
.task-contact,.contact-tools,.task-circle{display:flex;align-items:center}.task-contact{gap:12rpx}
.contact-tools{flex:none;gap:14rpx}.task-circle{width:72rpx;height:72rpx;justify-content:center;border:1rpx solid #dedbd2;border-radius:50%;position:relative}
.task-circle image{width:30rpx;height:30rpx}.circle-press{background:#e7f2eb}
.task-deadline .hint{margin:0 0 8rpx}.task-status-tag{margin-left:10rpx;padding:4rpx 12rpx;background:#efeee9;color:#514f48;border-radius:8rpx;font-size:22rpx}
.task-note{margin:18rpx 0;padding:18rpx;border-radius:16rpx;background:#f2f5fc;color:#34486a;white-space:pre-wrap}


.deadline-row,.deadline-actions{display:flex;align-items:center;justify-content:space-between;gap:16rpx}
.task-cn .deadline-change{flex:none;width:auto;min-width:110rpx;margin:0;padding:0 22rpx;border-radius:40rpx;background:#e7edfc;color:#234bc9;font-size:25rpx;font-weight:600;line-height:64rpx}
.deadline-change::after{border:0}.task-cn .deadline-press{background:#cfddfc}
.task-deadline .deadline-fields,.task-deadline .deadline-actions{margin-top:18rpx}
.deadline-actions{justify-content:flex-end}
.task-deadline .deadline-note{margin:14rpx 0 0;line-height:1.5;word-break:break-word}
.task-detail-card{padding:26rpx}
.task-card-head{display:flex;justify-content:space-between;gap:20rpx;margin-bottom:18rpx}
.task-heading{flex:1;min-width:0;overflow-wrap:break-word;padding-top:8rpx}
.task-person{display:flex;align-items:center;gap:20rpx;flex:1;min-width:0}
.task-avatar{display:flex;align-items:center;justify-content:center;flex:0 0 88rpx;width:88rpx;height:88rpx;border-radius:50%;background:#e7f3ed;color:#0b7a55;font-size:36rpx;font-weight:700;line-height:1}
.task-person .task-heading{padding-top:0}
.page-dark .task-avatar{background:#264536;color:#a6d8b8}
.task-heading .strong{font-size:30rpx}
.task-heading .hint{font-size:23rpx;margin-top:12rpx}
.task-contact-area{display:flex;flex-direction:column;align-items:flex-end;gap:8rpx}
.task-type{padding:5rpx 12rpx;border-radius:24rpx;background:#f0efea;font-size:20rpx;color:#45483f}
.task-contact-actions{display:flex;gap:14rpx}
button.task-icon{position:relative;display:flex;align-items:center;justify-content:center;width:70rpx;height:70rpx;min-height:0;margin:0;padding:0;border-radius:50%;background:#f0efea}
.task-icon image{width:28rpx;height:28rpx}

.task-info-block{background:#f6f5f1;padding:22rpx 24rpx;margin:14rpx 0;border-radius:22rpx}
.task-info-label{font-size:22rpx;color:#77746b;margin-bottom:10rpx}
.task-title{font-size:30rpx;font-weight:700;line-height:1.5}
.task-completion{margin-top:22rpx}
.task-completion .strong{font-size:26rpx}
.task-completion .field{width:100%;box-sizing:border-box;background:#f6f5f1;border:0;border-radius:22rpx}
.task-completion button.task-primary{width:auto;max-width:100%;min-height:84rpx;padding:18rpx 36rpx;margin:22rpx auto;border-radius:20rpx;font-size:28rpx;background:#0b7a55;color:#fff}
.task-completion button.task-primary[disabled]{background:#e5e9e5;color:#8b958b}
.task-reward{margin-top:20rpx}
.task-reward .hint{margin:0;font-size:23rpx}
.task-reward .strong{font-size:29rpx}
.page-dark .task-info-block,.page-dark .task-completion .field{background:#30312c}
.page-dark .task-type,.page-dark button.task-icon{background:#35372f;color:#e5e7df}
.page-dark .task-info-label{color:#b7b5aa}

.task-secondary-actions{display:flex;flex-wrap:wrap;gap:14rpx;margin-top:20rpx;padding-top:18rpx;border-top:1rpx solid #ece9e1}
.task-secondary-actions button.task-small-action{flex:0 1 auto;width:auto;min-width:0;max-width:100%;margin:0;padding:12rpx 20rpx;border:1rpx solid #c9dcd1;border-radius:99rpx;background:#f3f8f4;color:#24694e;font-size:23rpx;line-height:1.5}
.page-dark .task-secondary-actions{border-color:#414b44}
.page-dark .task-secondary-actions button.task-small-action{background:#263b2e;border-color:#526b5b;color:#a6d8b8}

/* Keep the unread badge outside the native round button's clipping area. */
.task-message-action{position:relative;flex:none;width:70rpx;height:70rpx;overflow:visible}
.task-message-action .task-unread-badge{position:absolute;z-index:2;top:-6rpx;right:-7rpx;display:flex;align-items:center;justify-content:center;box-sizing:border-box;min-width:32rpx;height:32rpx;padding:0 7rpx;border:3rpx solid #fff;border-radius:20rpx;background:#c9433c;color:#fff;font-size:19rpx;font-weight:650;line-height:1;white-space:nowrap;pointer-events:none}
.page-dark .task-message-action .task-unread-badge{border-color:#242522;background:#cf5048;color:#fff}
.task-progress-row{margin:22rpx 0 30rpx}.task-progress-row .progress-step{font-size:20rpx}.task-proof-upload{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:10rpx;min-height:144rpx;min-width:44px;width:100%;box-sizing:border-box;margin:18rpx 0;padding:20rpx;border:2rpx dashed #a7cfbd;border-radius:20rpx;background:#f8fcf9;color:#306b50;font-size:23rpx;line-height:1.5}.task-proof-upload::after{border:0}.task-proof-upload image{width:52rpx;height:52rpx}.page-dark .task-proof-upload{background:#26362e;color:#b9dfc8;border-color:#658c76}

.task-tip-head{display:flex;align-items:center;justify-content:space-between;gap:20rpx}.task-tip-optional{font-size:20rpx;color:#8b9388;background:#f0f3ec;border-radius:9rpx;padding:4rpx 12rpx}.task-tip-input-row{display:flex;align-items:center;gap:12rpx;margin-top:20rpx;border:1rpx solid #dce5db;border-radius:16rpx;padding:10rpx 12rpx;background:#fafcf7}.task-tip-input-row>text{font-size:30rpx;color:#52755d}.task-tip-input-row input{flex:1;min-width:0;font-size:25rpx;height:66rpx}.task-tip-input-row .task-tip-add{flex:none;margin:0;background:#41775b;color:#fff;border-radius:12rpx;padding:13rpx 17rpx;font-size:23rpx;line-height:1.6}.task-tip-add::after{border:0}.task-tip-input-row .task-tip-add[disabled]{background:#e5ebe2;color:#9ba595}.task-tip-given{font-size:23rpx;color:#41775b;margin-top:12rpx}.page-dark .task-tip-optional{background:#293e30;color:#a1b1a7}.page-dark .task-tip-input-row{background:#222e26;border-color:#455047}.page-dark .task-tip-input-row input{color:#edf4ef}.page-dark .task-tip-given{color:#98c8a6}

.task-photo-card{display:flex;align-items:center;gap:18rpx;padding:22rpx;margin:18rpx 0;background:#fafbf7;border-radius:22rpx}.task-photo-icon{display:flex;align-items:center;justify-content:center;width:76rpx;height:76rpx;border-radius:18rpx;background:#e8f0e8;flex-shrink:0}.task-photo-icon image{width:40rpx;height:40rpx}.task-photo-copy{flex:1;min-width:0}.task-photo-title{font-size:27rpx;font-weight:700;color:#304d3d}.task-photo-sub{font-size:23rpx;margin-top:4rpx;color:#526758}.task-photo-hint{font-size:19rpx;margin-top:5rpx;color:#879083}.task-photo-add{display:flex;flex-direction:column;align-items:center;justify-content:center;flex-shrink:0;width:100rpx;min-height:100rpx;padding:10rpx;margin:0;border:2rpx dashed #b5cbb9;border-radius:17rpx;background:#fff;color:#63876c;font-size:19rpx;line-height:1.4}.task-photo-add::after{border:0}.task-photo-plus{font-size:35rpx}.page-dark .task-photo-card{background:#28372e}.page-dark .task-photo-title,.page-dark .task-photo-sub{color:#c4deca}.page-dark .task-photo-add{background:#25332a;color:#b7d8bd}

/* Compact upload action; keep the description as the flexible column. */
.task-photo-card{gap:16rpx;padding:20rpx}.task-photo-card .task-photo-icon{width:64rpx;height:64rpx;border-radius:16rpx}.task-photo-card .task-photo-icon image{width:34rpx;height:34rpx}.task-photo-card .task-photo-copy{flex:1 1 0;width:0;min-width:0}.task-photo-card .task-photo-title{font-size:25rpx;line-height:1.4}.task-photo-card .task-photo-sub{font-size:21rpx;line-height:1.4}.task-photo-card .task-photo-hint{font-size:18rpx;line-height:1.4}.task-photo-card button.task-photo-add{box-sizing:border-box;flex:0 0 92rpx;width:92rpx;min-width:0;max-width:92rpx;height:92rpx;min-height:92rpx;margin:0;padding:8rpx;border-radius:16rpx;font-size:18rpx;line-height:1.3}.task-photo-card .task-photo-plus{font-size:30rpx;line-height:1.1}

.task-ticket-type{font-size:22rpx;color:#64735f;margin-bottom:10rpx}.task-ticket-title{font-size:29rpx;line-height:1.6;font-weight:700;color:#233d30;white-space:pre-wrap;word-break:break-word}.task-waiting-ticket .journey-times{flex-wrap:wrap;gap:12rpx}.page-dark .task-ticket-title{color:#edf2e8}

.task-page .completion-card{background:#f0f4ff;border:1rpx solid #cbd7f3;border-left:6rpx solid #4265cf;padding:26rpx;border-radius:23rpx}.completion-head{display:flex;align-items:center;gap:16rpx}.completion-icon{display:flex;align-items:center;justify-content:center;flex:none;width:62rpx;height:62rpx;border-radius:17rpx;background:#dfe8ff}.completion-icon image{width:32rpx;height:32rpx}.completion-heading{flex:1;min-width:0}.completion-title{font-size:28rpx;font-weight:750;line-height:1.4;color:#2b478d}.completion-time{margin-top:5rpx;font-size:21rpx;color:#8793ac}.completion-message{display:block;margin-top:22rpx;font-size:31rpx;font-weight:650;line-height:1.75;color:#263954;white-space:pre-wrap;overflow-wrap:anywhere}.completion-photo{display:block;width:100%;margin-top:22rpx;border-radius:16rpx}.completion-review{margin-top:22rpx;padding-top:16rpx;border-top:1rpx solid #d5def1;color:#6d7fa3;font-size:22rpx;line-height:1.6}.page-dark.task-page .completion-card{background:#26324a!important;border-color:#53678f!important;border-left-color:#9ab3ff!important}.page-dark .completion-icon{background:#384c72}.page-dark .completion-title{color:#c3d3ff}.page-dark .completion-message{color:#edf2ff}.page-dark .completion-time,.page-dark .completion-review{color:#acbad5}.page-dark .completion-review{border-color:#495b7e}

/* Task ticket: type tag, title, then Posted / Deadline side by side with room to breathe. */
.journey-route-section.task-ticket-section{flex-direction:column;align-items:stretch;gap:0;padding:28rpx 40rpx 30rpx}
.task-ticket-section .task-ticket-type{align-self:flex-start;margin:0 0 14rpx;padding:6rpx 16rpx;border-radius:999rpx;background:#e7f3ed;color:#0b7a55;font-size:22rpx;font-weight:700;line-height:1.4}
.task-ticket-section .task-ticket-title{font-size:32rpx;line-height:1.5;margin:0}
.task-ticket-times{display:flex;gap:16rpx;margin-top:22rpx}
.task-ticket-time{flex:1;min-width:0;display:flex;flex-direction:column;gap:4rpx;padding:16rpx 20rpx;border-radius:16rpx;background:rgba(255,255,255,.7);border:1rpx solid #ebe3d3}
.task-ticket-time-label{font-size:21rpx;color:#8a877c}
.task-ticket-time-value{font-size:26rpx;font-weight:700;color:#26332c;line-height:1.4;word-break:break-word}
.page-dark .task-ticket-section .task-ticket-type{background:#1f2d25;color:#8fd3b0}
.page-dark .task-ticket-time{background:#242522;border-color:#3a3b37}
.page-dark .task-ticket-time-value{color:#edf2e8}

/* 取消原因弹层：选项变多后按钮可能被挤出可视区，操作区固定在底部 */
.cancel-sheet{background:#fff;max-height:70vh;overflow-y:auto}
.cancel-sheet .soft{padding:14rpx 0}
.cancel-sheet .action-row{position:sticky;bottom:-30rpx;background:inherit;padding:16rpx 0 4rpx}.cancel-sheet>button.btn{position:sticky;bottom:0;z-index:1}
.page-dark .cancel-sheet{background:#242522}
/* Yuni at work: shown once after a task is posted */
.yt-stage{position:relative;background:linear-gradient(180deg,#eef6f1 0%,#fff6e8 100%)}
.yt-yuni{position:relative;z-index:2;width:290rpx;height:290rpx;animation:var(--ue-animation,yt-work 1.1s ease-in-out .7s infinite)}
.yt-note{position:absolute;z-index:1;right:92rpx;top:56rpx;width:104rpx;height:104rpx;animation:var(--ue-animation,yt-float 2.4s ease-in-out .7s infinite)}
.yt-ground{position:absolute;left:120rpx;right:120rpx;bottom:44rpx;height:18rpx;border-radius:50%;background:rgba(22,24,28,.1);animation:var(--ue-animation,yt-shadow 1.1s ease-in-out .7s infinite)}
.yt-spark{position:absolute;width:16rpx;height:16rpx;border-radius:50%;background:#f0a23a;opacity:0;animation:var(--ue-animation,yt-spark 1.8s ease-out .9s infinite)}
.yt-spark-a{left:110rpx;top:96rpx}
.yt-spark-b{left:168rpx;top:52rpx;background:#0b7a55;animation-delay:1.3s}
.yt-spark-c{right:64rpx;top:190rpx;background:#c2410c;animation-delay:1.7s}
@keyframes yt-work{0%,100%{transform:translateY(0) rotate(-2deg)}50%{transform:translateY(-14rpx) rotate(2deg)}}
@keyframes yt-float{0%,100%{transform:translateY(0) rotate(6deg)}50%{transform:translateY(-18rpx) rotate(-4deg)}}
@keyframes yt-shadow{0%,100%{transform:scaleX(1);opacity:1}50%{transform:scaleX(.86);opacity:.6}}
@keyframes yt-spark{0%{opacity:0;transform:scale(.4)}30%{opacity:1;transform:scale(1.2)}100%{opacity:0;transform:translateY(-36rpx) scale(.6)}}
.order-no{text-transform:uppercase;font-variant-numeric:tabular-nums;letter-spacing:.5rpx}
.task-order-no{display:block;margin-top:4rpx;font-size:28rpx;font-weight:750;color:#16181c}.page-dark .task-order-no{color:#edebe4}

@import "../../utils/deadline-fields.wxss";
@import "../../utils/contact-identity.wxss";
@import "../../utils/flow.wxss";
@import "../../utils/order-detail-cards.wxss";
.task-title{white-space:pre-wrap;word-break:break-word}
/* Task details keep the pickup page layout but use the blue accent of the task posting flow. */
.task-page .pill-row .pill{border:2rpx solid #c3d2f7;background:#eef2ff;color:#1d4ed8;font-weight:700}
.task-page .pill-blue-press{background:#dbe5fb;border-color:#9fb6ee}
.task-page .cancel-order-button{display:flex;align-items:center;justify-content:center;width:100%;min-height:88rpx;padding:20rpx 24rpx;margin:24rpx 0 0;border:2rpx solid #c3d2f7;border-radius:20rpx;background:#f3f6fd;color:#1d4ed8;font-size:28rpx;font-weight:700;line-height:1.5;transition:var(--ue-transition,transform .16s ease,background .16s ease)}
.task-page .cancel-order-press{background:#e3eaf9;transform:scale(.99)}
.task-page .btn{background:#1d4ed8;color:#fff}
.task-page .btn.light{background:#eef2ff;color:#1d4ed8;border:1rpx solid #c3d2f7}
.task-page .btn.outline{background:#fff;color:#1d4ed8;border:1rpx solid #c3d2f7}
.task-page .btn[disabled]{background:#e4e1d8;color:#8a877e}
.page-dark .task-page .pill{background:#1d2433!important;border-color:#33406b!important;color:#9db4ff!important}
.page-dark .task-page .pill-blue-press{background:#233050}
.page-dark .task-page .cancel-order-button{background:#1d2433;border-color:#33406b;color:#9db4ff}
.page-dark .task-page .cancel-order-press{background:#233050}
.page-dark .task-page .btn{background:#9db4ff!important;color:#16181c!important}
.page-dark .task-page .btn.light,.page-dark .task-page .btn.outline{background:#1d2433!important;color:#9db4ff!important;border-color:#33406b!important}
.page-dark .task-page .btn[disabled]{background:#242522!important;color:#a9a69c!important}
.task-page .pill.selected{background:#1d4ed8;border-color:#1d4ed8;color:#fff}
.page-dark .task-page .pill.selected{background:#9db4ff!important;border-color:#9db4ff!important;color:#16181c!important}

.task-cn .flow-card{padding:26rpx;border:1rpx solid #e4e1d9;border-radius:24rpx;box-shadow:none}
.task-heading{margin-bottom:24rpx}.task-heading .hint{margin:4rpx 0 0}
.task-steps{display:flex}.task-step{flex:1;min-width:0;text-align:center;color:#827e74;font-size:22rpx}
.step-line{height:24rpx;display:flex;justify-content:center;align-items:center;position:relative;margin-bottom:8rpx}
.step-line::before{content:"";position:absolute;left:-50%;right:50%;height:4rpx;background:#e2dfd6}
.task-step:first-child .step-line::before{display:none}.reached .step-line::before{background:#087751}
.step-node{width:18rpx;height:18rpx;border-radius:50%;background:white;border:3rpx solid #d8d4ca;z-index:1}
.reached .step-node{background:#087751;border-color:#087751}.current .step-node{background:white;border-color:#2854cf}
.reached{color:#252823}.current{font-weight:700}.step-clock{display:block;font-size:20rpx;color:#77736a}
.task-cn .task-state{position:relative;border-left:6rpx solid #087751;padding-right:120rpx;min-height:124rpx}
.state-title{font-size:30rpx;font-weight:700}.state-yuni{position:absolute;right:20rpx;bottom:15rpx;width:82rpx;height:92rpx}
.task-contact,.contact-tools,.task-circle{display:flex;align-items:center}.task-contact{gap:12rpx}
.contact-tools{flex:none;gap:14rpx}.task-circle{width:72rpx;height:72rpx;justify-content:center;border:1rpx solid #dedbd2;border-radius:50%;position:relative}
.task-circle image{width:30rpx;height:30rpx}.circle-press{background:#e7f2eb}.task-unread{position:absolute;top:-6rpx;right:-4rpx;background:#087751;color:white;border-radius:25rpx;padding:0 8rpx;font-size:19rpx}
.task-deadline .hint{margin:0 0 8rpx}.task-status-tag{margin-left:10rpx;padding:4rpx 12rpx;background:#efeee9;color:#514f48;border-radius:8rpx;font-size:22rpx}
.task-note{margin:18rpx 0;padding:18rpx;border-radius:16rpx;background:#f2f5fc;color:#34486a;white-space:pre-wrap}


.deadline-row,.deadline-actions{display:flex;align-items:center;justify-content:space-between;gap:16rpx}
.task-cn .deadline-change{flex:none;width:auto;min-width:110rpx;margin:0;padding:0 22rpx;border-radius:40rpx;background:#e7edfc;color:#234bc9;font-size:25rpx;font-weight:600;line-height:64rpx}
.deadline-change::after{border:0}.task-cn .deadline-press{background:#cfddfc}
.task-deadline .deadline-fields,.task-deadline .deadline-actions{margin-top:18rpx}
.deadline-actions{justify-content:flex-end}
.task-deadline .deadline-note{margin:14rpx 0 0;line-height:1.5;word-break:break-word}
.task-detail-card{padding:26rpx}
.task-card-head{display:flex;justify-content:space-between;gap:20rpx;margin-bottom:18rpx}
.task-heading{flex:1;min-width:0;overflow-wrap:break-word;padding-top:8rpx}
.task-person{display:flex;align-items:center;gap:20rpx;flex:1;min-width:0}
.task-avatar{display:flex;align-items:center;justify-content:center;flex:0 0 88rpx;width:88rpx;height:88rpx;border-radius:50%;background:#e7f3ed;color:#0b7a55;font-size:36rpx;font-weight:700;line-height:1}
.task-person .task-heading{padding-top:0}
.page-dark .task-avatar{background:#264536;color:#a6d8b8}
.task-heading .strong{font-size:30rpx}
.task-heading .hint{font-size:23rpx;margin-top:12rpx}
.task-contact-area{display:flex;flex-direction:column;align-items:flex-end;gap:8rpx}
.task-type{padding:5rpx 12rpx;border-radius:24rpx;background:#f0efea;font-size:20rpx;color:#45483f}
.task-contact-actions{display:flex;gap:14rpx}
button.task-icon{position:relative;display:flex;align-items:center;justify-content:center;width:70rpx;height:70rpx;min-height:0;margin:0;padding:0;border-radius:50%;background:#f0efea}
.task-icon image{width:28rpx;height:28rpx}
.task-unread{position:absolute;top:-5rpx;right:-7rpx;min-width:30rpx;padding:2rpx 7rpx;border-radius:99rpx;background:#c2410c;color:#fff;font-size:19rpx;line-height:1.4;text-align:center}
.task-info-block{background:#f6f5f1;padding:22rpx 24rpx;margin:14rpx 0;border-radius:22rpx}
.task-info-label{font-size:22rpx;color:#77746b;margin-bottom:10rpx}
.task-title{font-size:30rpx;font-weight:700;line-height:1.5}
.task-completion{margin-top:22rpx}
.task-completion .strong{font-size:26rpx}
.task-completion .field{width:100%;box-sizing:border-box;background:#f6f5f1;border:0;border-radius:22rpx}
.task-completion button.task-primary{width:auto;max-width:100%;min-height:84rpx;padding:18rpx 36rpx;margin:22rpx auto;border-radius:20rpx;font-size:28rpx;background:#0b7a55;color:#fff}
.task-completion button.task-primary[disabled]{background:#e5e9e5;color:#8b958b}
.task-reward{margin-top:20rpx}
.task-reward .hint{margin:0;font-size:23rpx}
.task-reward .strong{font-size:29rpx}
.page-dark .task-info-block,.page-dark .task-completion .field{background:#30312c}
.page-dark .task-type,.page-dark button.task-icon{background:#35372f;color:#e5e7df}
.page-dark .task-info-label{color:#b7b5aa}

.task-secondary-actions{display:flex;flex-wrap:wrap;gap:14rpx;margin-top:20rpx;padding-top:18rpx;border-top:1rpx solid #ece9e1}
.task-secondary-actions button.task-small-action{flex:0 1 auto;width:auto;min-width:0;max-width:100%;margin:0;padding:12rpx 20rpx;border:1rpx solid #c9dcd1;border-radius:99rpx;background:#f3f8f4;color:#24694e;font-size:23rpx;line-height:1.5}
.page-dark .task-secondary-actions{border-color:#414b44}
.page-dark .task-secondary-actions button.task-small-action{background:#263b2e;border-color:#526b5b;color:#a6d8b8}

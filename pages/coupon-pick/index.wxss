.cp-page{min-height:100vh;padding:24rpx 30rpx 60rpx;background:#eeede8;color:#16181c;font-size:26rpx;box-sizing:border-box}
.cp-tabs{position:relative;display:flex;padding:6rpx;margin-bottom:26rpx;border-radius:22rpx;background:#e2e0d9}
.cp-tab{position:relative;z-index:1;flex:1;height:72rpx;line-height:72rpx;text-align:center;color:#8a877e;font-weight:700;transition:color .25s}.cp-tab.on{color:#16181c}
.cp-slider{position:absolute;top:6rpx;bottom:6rpx;left:6rpx;width:calc(50% - 6rpx);border-radius:18rpx;background:#fff;box-shadow:0 4rpx 12rpx rgba(22,24,28,.06);transition:transform .3s cubic-bezier(.22,.8,.3,1)}.cp-slider.right{transform:translate3d(100%,0,0)}
.cp-empty{padding:80rpx 20rpx;text-align:center;color:#6b6860}
.cp-card{position:relative;display:flex;align-items:center;margin-bottom:20rpx;border-radius:24rpx;background:#fff;overflow:hidden;border:2rpx solid transparent;animation:ue-settle .3s cubic-bezier(.22,.8,.3,1) backwards;transition:border-color .2s,box-shadow .2s,transform .15s}
.cp-card:active{transform:scale(.98)}.cp-card.on{border-color:#c2410c;box-shadow:0 10rpx 26rpx rgba(194,65,12,.15)}.cp-card.off{opacity:.55}
.cp-left{flex:none;width:200rpx;padding:30rpx 0;text-align:center;background:#fdf6f2;border-right:2rpx dashed #f2b48a}
.cp-amt{color:#c2410c;font-size:46rpx;font-weight:800;line-height:1.1}.cp-yen{font-size:26rpx;margin-right:2rpx}.cp-sub{margin-top:6rpx;color:#0b7a55;font-size:21rpx}
.cp-right{flex:1;min-width:0;padding:0 24rpx}.cp-name{font-size:29rpx;font-weight:800}.cp-until{margin-top:8rpx;color:#6b6860;font-size:22rpx}
.cp-best{margin-left:12rpx;padding:2rpx 10rpx;border-radius:8rpx;background:#c2410c;color:#fff;font-size:19rpx;vertical-align:middle}
.cp-radio{flex:none;width:40rpx;height:40rpx;margin-right:26rpx;line-height:38rpx;text-align:center;border-radius:50%;border:2rpx solid #d6d2c6;color:#fff;font-size:22rpx;box-sizing:border-box;transition:background .2s,border-color .2s}.cp-card.on .cp-radio{background:#c2410c;border-color:#c2410c}
.cp-none{margin-top:10rpx;height:88rpx;line-height:88rpx;text-align:center;border-radius:22rpx;background:#fff;color:#5e5c55;font-weight:700;border:2rpx solid transparent;transition:border-color .2s}.cp-none.on{border-color:#c2410c;color:#c2410c}
.cp-card.expired{filter:grayscale(1);opacity:.6}.cp-stamp{flex:none;margin-right:24rpx;padding:4rpx 12rpx;border:2rpx solid #8a877e;border-radius:10rpx;color:#8a877e;font-size:21rpx;transform:rotate(-12deg)}
.page-dark.cp-page{background:#1b1c1a;color:#edebe4}.page-dark .cp-tabs{background:#242522}.page-dark .cp-slider{background:#3a3b37}.page-dark .cp-tab.on{color:#edebe4}.page-dark .cp-card,.page-dark .cp-none{background:#242522}.page-dark .cp-left{background:#44423c;border-right-color:#44423c}

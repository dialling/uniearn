<lang-switch/>
<view class="campus-page {{darkClass}}"><view class="campus-top"><text class="campus-brand">Uniearn</text><button class="language-switch" bindtap="toggleLanguage">{{copy.toggle}}</button></view><view class="campus-yuni"><image src="/assets/yuni-{{selectedCampus==='sip'?'happy':'wave'}}.png" mode="aspectFit"/><view class="campus-bubble"><view class="yuni-name">Yuni</view>{{campusMessage}}</view></view><view class="campus-title">{{copy.campusTitle}}</view><view class="campus-intro">{{copy.campusIntro}}</view><view class="search-box"><text>⌕</text><input value="{{query}}" bindinput="search" placeholder="{{copy.search}}" maxlength="100"/></view><block wx:if="{{matches}}"><view class="university"><view class="university-icon">XJTLU</view><view><view class="university-name">{{copy.university}}</view><view class="campus-sub">{{copy.universitySub}}</view></view></view><view class="campus-card {{selectedCampus==='sip'?'chosen':''}}" bindtap="selectSip"><view class="campus-icon sip">SIP</view><view class="campus-copy"><view class="card-title">{{copy.sip}}</view><view class="campus-sub">{{copy.sipSub}}</view></view><view class="radio {{selectedCampus==='sip'?'checked':''}}">{{selectedCampus==='sip'?'✓':''}}</view></view><view class="campus-card unavailable" bindtap="selectTaicang"><view class="campus-icon tc">TC</view><view class="campus-copy"><view class="card-title">{{copy.tc}}</view><view class="coming">{{copy.coming}}</view><view class="campus-sub">{{copy.tcSub}}</view></view><button class="notify" disabled="{{interested}}" catchtap="notify">{{interested?copy.notified:copy.notify}}</button></view></block><view wx:else class="campus-sub no-results">{{copy.noResults}}</view><view class="campus-card request-school"><view class="school-icon">⌂</view><view class="campus-copy"><view class="small-title">{{copy.missing}}</view><view class="campus-sub">{{copy.missingSub}}</view></view><button class="ask" bindtap="requestSchool">{{copy.ask}}</button></view><view wx:if="{{error}}" class="notice-error">{{error}}</view><view class="campus-footer"><view wx:if="{{selectedCampus==='sip'}}" class="selected-campus">⌖ {{copy.university}} · {{copy.sip}}</view><button class="btn" disabled="{{selectedCampus!=='sip'||busy}}" loading="{{busy}}" bindtap="continueToJobs">{{selectedCampus==='sip'?copy.continue:copy.chooseFirst}}</button></view></view><yuni-assistant topic=""/>
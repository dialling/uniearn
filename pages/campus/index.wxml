<view style="{{motionStyle}}">
<lang-switch></lang-switch>
<view class="campus-page {{darkClass}}"><view class="campus-top"><text class="campus-brand">Uniearn</text><button class="language-switch" bindtap="toggleLanguage">{{copy.toggle}}</button></view><view class="campus-yuni"><image src="/assets/yuni-{{selectedCampus==='sip'?'happy':'wave'}}.png" mode="aspectFit"/><view class="campus-bubble"><view class="yuni-name">Yuni</view>{{campusMessage}}</view></view><view class="campus-title">{{copy.campusTitle}}</view><view class="campus-intro">{{copy.campusIntro}}</view><block wx:if="{{matches}}"><view class="university"><view class="university-icon">XJTLU</view><view><view class="university-name">{{copy.university}}</view><view class="campus-sub">{{copy.universitySub}}</view></view></view><view class="campus-card {{uniSelect==='xjtlu'&&selectedCampus==='sip'?'chosen':''}}" bindtap="selectSip"><view class="campus-icon sip">SIP</view><view class="campus-copy"><view class="card-title">{{copy.sip}}</view><view class="campus-sub">{{copy.sipSub}}</view></view><view class="radio {{uniSelect==='xjtlu'&&selectedCampus==='sip'?'checked':''}}">{{uniSelect==='xjtlu'&&selectedCampus==='sip'?'✓':''}}</view></view><view class="university"><view class="university-icon sip">RUC</view><view><view class="university-name">{{language==='zh'?'中国人民大学（苏州校区）':'Renmin University of China, Suzhou'}}</view><view class="campus-sub">{{language==='zh'?'江苏苏州 · 独墅湖高教区':'Suzhou, Jiangsu · Dushu Lake'}}</view></view></view><view class="campus-card {{uniSelect==='ruc'&&selectedCampus==='sip'?'chosen':''}}" bindtap="selectRuc"><view class="campus-icon sip">RUC</view><view class="campus-copy"><view class="card-title">{{language==='zh'?'苏州校区':'Suzhou campus'}}</view><view class="campus-sub">{{language==='zh'?'中国人民大学苏州校区 · 独墅湖':'RUC Suzhou · Dushu Lake'}}</view></view><view class="radio {{uniSelect==='ruc'&&selectedCampus==='sip'?'checked':''}}">{{uniSelect==='ruc'&&selectedCampus==='sip'?'✓':''}}</view></view><view class="university"><view class="university-icon sip">SU</view><view><view class="university-name">{{language==='zh'?'苏州大学':'Soochow University'}}</view><view class="campus-sub">{{language==='zh'?'江苏苏州 · 姑苏区':'Suzhou, Jiangsu · Gusu'}}</view></view></view><view class="campus-card {{uniSelect==='suda'&&selectedCampus==='sip'?'chosen':''}}" bindtap="selectSuda"><view class="campus-icon sip">SU</view><view class="campus-copy"><view class="card-title">{{language==='zh'?'苏州大学校区':'Soochow campus'}}</view><view class="campus-sub">{{language==='zh'?'苏州大学 · 天赐庄校区':'Soochow University · Tiancizhuang'}}</view></view><view class="radio {{uniSelect==='suda'&&selectedCampus==='sip'?'checked':''}}">{{uniSelect==='suda'&&selectedCampus==='sip'?'✓':''}}</view></view><view class="campus-card unavailable" bindtap="selectTaicang"><view class="campus-icon tc">TC</view><view class="campus-copy"><view class="card-title">{{copy.tc}}</view><view class="coming">{{copy.coming}}</view><view class="campus-sub">{{copy.tcSub}}</view></view><button class="notify" disabled="{{interested}}" catchtap="notify">{{interested?copy.notified:copy.notify}}</button></view></block><view wx:else class="campus-sub no-results">{{copy.noResults}}</view><view class="campus-card request-school"><view class="school-icon">⌂</view><view class="campus-copy"><view class="small-title">{{copy.missing}}</view><view class="campus-sub">{{copy.missingSub}}</view></view><button class="ask" bindtap="requestSchool">{{copy.ask}}</button></view><view wx:if="{{error}}" class="notice-error">{{error}}</view><view class="campus-footer"><view wx:if="{{selectedCampus==='sip'}}" class="selected-campus">⌖ {{copy.university}} · {{copy.sip}}</view><button class="btn" disabled="{{selectedCampus!=='sip'||busy}}" loading="{{motionEnabled && (busy)}}" bindtap="continueToJobs">{{selectedCampus==='sip'?(uniSelect==='ruc'?(language==='zh'?'进入人大苏州校区':'Enter RUC Suzhou'):(uniSelect==='suda'?(language==='zh'?'进入苏州大学':'Enter Soochow University'):copy.continue)):copy.chooseFirst}}</button></view></view><yuni-assistant topic=""/>
</view>

@import "../../utils/flow.wxss";
.campus-page{box-sizing:border-box;min-height:100vh;padding:25rpx 40rpx 40rpx;background:white;display:flex;flex-direction:column}.campus-top{display:flex;align-items:center;justify-content:space-between;margin-bottom:20rpx}.campus-brand{font-size:25rpx;color:#41775b;font-weight:750}.language-switch{margin:0;padding:10rpx 22rpx;font-size:24rpx;line-height:1.5;border-radius:30rpx;color:#41775b;background:#f3f5f1}.language-switch::after{border:0}.campus-yuni{display:flex;align-items:center;gap:22rpx;margin:12rpx 0 20rpx}.campus-yuni image{width:126rpx;height:158rpx;flex:none}.campus-bubble{flex:1;border-radius:27rpx;padding:20rpx 24rpx;background:#e8f3ed;color:#41534a;font-size:28rpx;line-height:1.65}.yuni-name{color:#41775b;font-weight:700;font-size:23rpx;margin-bottom:6rpx}.campus-title{font-size:43rpx;font-weight:800;line-height:1.3;margin:10rpx 0 18rpx}.campus-intro{font-size:28rpx;line-height:1.6;color:#64675f}.search-box{background:#f4f4ef;border-radius:22rpx;padding:25rpx 23rpx;display:flex;align-items:center;gap:20rpx;margin:35rpx 0}.search-box text{font-size:34rpx;color:#8a8d85}.search-box input{flex:1;min-width:0;font-size:27rpx}.university{display:flex;align-items:center;gap:22rpx;margin:4rpx 0 25rpx}.university-icon{width:85rpx;height:92rpx;flex:none;display:flex;align-items:center;justify-content:center;border-radius:20rpx;background:#173554;color:white;font-size:20rpx;font-weight:750}.university-name{font-weight:750;font-size:28rpx;line-height:1.45}.campus-sub{color:#7b7e73;font-size:25rpx;line-height:1.5;margin-top:8rpx}.campus-card{display:flex;align-items:center;gap:22rpx;border:2rpx solid #eff0e9;border-radius:30rpx;padding:27rpx 24rpx;margin-bottom:18rpx}.campus-card.chosen{border-color:#41775b;background:#f8fbf8}.campus-icon{width:76rpx;height:82rpx;border-radius:20rpx;display:flex;align-items:center;justify-content:center;flex:none;font-size:25rpx;font-weight:750}.sip{background:#eef0f8;color:#34446d}.tc{background:#efeee6;color:#92958a}.campus-co
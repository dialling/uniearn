<view class="flow-page" wx:if="{{request}}"><view class="flow-title">{{request.isMine?'My request':'Order details'}}</view><view class="flow-sub">{{request.sizeLabel}} · {{request.boxes}} {{request.unit}} · {{request.destinationDisplay}}</view>
<view class="flow-card status-card"><image class="status-yuni" src="/assets/yuni-wave.png" mode="aspectFit"/><view class="flow-title status-{{request.status}}">{{request.status==='taken'?runner+' took your request':request.statusLabel}}</view><view class="hint" wx:if="{{request.cancellation && request.status==='waiting'}}">{{request.cancellation.runner}} cancelled. Your order is back on the board at the same offer. No extra charge.</view><view class="hint" wx:elif="{{request.status==='delivered'}}">{{runner}} left it {{request.deliveryLocation}} at {{request.deliveredTime}}.</view><view class="hint" wx:elif="{{request.status==='disputed'}}">Settlement is paused. Your report is saved in the cloud; this test has no support dashboard yet.</view><view class="hint" wx:elif="{{request.status==='refunded'||request.status==='cancelled'}}">Demo refund: ¥{{request.refundAmount}}</view></view>
<view wx:if="{{request.runnerId}}" class="flow-card row"><view class="value">{{runner}}</view><view class="contact-actions"><view class="contact-button" bindtap="chat"><image src="/assets/message.svg"/><text wx:if="{{request.unread}}" class="unread">{{request.unread}}</text></view><view class="contact-button" bindtap="phone"><image src="/assets/phone.svg"/></view></view></view>
<view wx:if="{{request.isMine && request.status==='waiting'}}" class="flow-card"><view class="row"><text class="strong">No runner yet</text><text wx:if="{{request.closesAt}}" class="link">closes {{request.closeTime}}</text></view><view class="hint">You’re offering ¥{{request.rewardText}}. A raise is added once to the whole order, not per bag.</view><view class="action-row"><button class="btn outline" data-amount="1" bindtap="raise">＋ ¥1</button><button class="btn outline" data-amount="2" bindtap="raise">＋ ¥2</button></view><view class="hint" wx:if="{{request.closesAt}}">If nobody takes it by {{request.closeTime}}, it closes with a full demo refund.</view><view class="cancel-link" bindtap="cancel">Cancel · free until a runner takes it</view></view>
<view wx:if="{{request.isMine && request.category==='takeout' && (request.status==='waiting'||request.status==='taken')}}" class="flow-card"><view class="strong">Food running late?</view><view class="hint">If your food arrives later, move the ETA once.</view><picker mode="time" disabled="{{!request.canMoveEta}}" bindchange="late"><button class="btn outline" disabled="{{!request.canMoveEta}}">{{request.etaMoved?'Arrival time updated':'My food is late'}}</button></picker></view><view wx:if="{{request.isMine && request.category==='takeout' && (request.status==='waiting'||request.status==='taken')}}" class="dash" bindtap="riderPhoto"><view class="strong">{{request.riderPhoto?'Replace the rider’s photo':'Food arrived? Add the rider’s photo'}}</view><view class="hint">From Meituan or Ele.me. It shows where the bag is.</view></view><image wx:if="{{request.riderPhoto}}" class="thumb" src="{{request.riderPhoto}}" mode="aspectFill" bindtap="previewRider"/>
<view wx:if="{{request.photo}}" class="flow-card"><image class="proof" src="{{request.photo}}" mode="aspectFill" bindtap="preview"/><view class="hint">Delivery photo · {{request.deliveredTime}} · {{request.deliveryLocation}}</view></view>
<view wx:if="{{request.isMine && request.status==='delivered'}}" class="flow-card"><view class="soft hint">Demo total ¥{{request.total}}. Confirming settles ¥{{request.rewardText}} to the runner in this preview.</view><block wx:if="{{!reporting}}"><button class="btn orange" bindtap="confirm">Got it · confirm ¥{{request.rewardText}}</button><button class="btn outline" disabled="{{!request.canReport}}" bindtap="issue">Something’s wrong</button><view class="hint">Automatically confirms {{request.autoHours}} {{request.autoHours===1?'hour':'hours'}} after delivery ({{request.autoTime}}). In this preview, the check runs when the app is open.</view></block><block wx:else><view class="strong">What went wrong?</view><view wx:for="{{reasons}}" wx:key="*this" class="pill" style="margin-top:14rpx" data-value="{{item}}" bindtap="chooseReason">{{reason===item?'◉':'○'}} {{item}}</view><view class="dash" bindtap="addIssuePhoto">{{issuePhoto?'✓ Photo added · replace':'Add a photo (needed for spilled food)'}}</view><textarea class="field" placeholder="Describe the issue" value="{{issueNote}}" bindinput="note" maxlength="500"/><view class="action-row"><button class="btn outline" bindtap="backIssue">Back</button><button class="btn" disabled="{{!reason}}" bindtap="report">Submit report</button></view></block></view>
<view wx:if="{{request.dispute}}" class="flow-card"><view class="strong">{{request.dispute.reason}}</view><view class="hint">{{request.dispute.note}}</view></view>
<view class="flow-card"><view class="strong">Progress</view><view wx:for="{{steps}}" wx:key="name" class="timeline"><text style="color:{{item.done?'#31584f':'#ccc'}}">{{item.done?'●':'○'}}</text><text>{{item.name}}</text><text>{{item.time}}</text></view><view wx:for="{{request.history}}" wx:key="index" class="hint">{{item.time}} · {{item.label}}</view></view>
<view class="flow-card"><view class="strong">Details</view><view class="row hint"><text>Route</text><text>{{request.station}} → {{request.destinationDisplay}}</text></view><view class="row hint" wx:if="{{request.category==='takeout'}}"><text>Food arrives</text><text>{{request.arrivalLabel}}</text></view><view wx:if="{{request.closesAt}}" class="row hint"><text>Closes if no one takes it</text><text>{{request.closeTime}}</text></view><view class="row hint"><text>Your offer</text><text class="strong">¥{{request.rewardText}} + ¥{{request.fee}} service</text></view><view wx:if="{{request.discount}}" class="row hint"><text>Coupon</text><text>−¥{{request.discount}}</text></view><view class="divider"/><view class="row strong"><text>Demo total</text><text>¥{{request.total}}</text></view><view class="hint">{{request.note}}</view></view><button wx:if="{{request.isMine && (request.status==='confirmed'||request.status==='cancelled'||request.status==='refunded')}}" class="btn outline" bindtap="repeat">Post again</button></view><view wx:else class="empty">Request unavailable. Check your connection and account.</view>
<yuni-assistant topic=""/>
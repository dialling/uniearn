<view class="flow-page"><view class="flow-title">Join a trip</view><view wx:if="{{trip}}"><view class="banner"><view class="route">{{trip.station}} → {{trip.dorm}}</view><view class="row"><text>Join within {{minutes}} min</text><text>Room for {{remaining}} {{trip.category==='takeout'?'bags':'boxes'}}</text></view><view class="divider"/><view>{{trip.runnerName||'Runner'}} · {{trip.runnerJobs||0}} done</view></view><view class="flow-card"><view class="strong">{{trip.category==='takeout'?'Add your takeaway':'Add your pickup notice'}}</view><view class="hint">{{trip.category==='takeout'?'Use a saved route, check the phone on the bag, and add your arrival time.':'Paste your pickup message or choose a screenshot. Confirm the station and each code.'}}</view><view class="hint">Only the accepting runner can view your pickup details.</view></view><view wx:if="{{!open}}" class="orange-note">This trip is full or closed to new orders.</view><view class="flow-bottom"><button class="btn orange" disabled="{{!open}}" bindtap="join">Add my order</button><view class="preview-label">Team test · no payment is taken</view></view></view><view wx:else class="flow-card"><view class="strong">This trip is unavailable or closed</view><view class="hint">Check your connection and ask the runner whether joining is still open.</view><button class="btn" bindtap="jobs">Browse Jobs</button></view></view>

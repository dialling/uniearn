<view class="post-page create-page">
 <view wx:if="{{mode==='choose'}}">
  <view class="title">What do you want to do?</view>
  <view class="card choice" data-mode="request" bindtap="choose"><view class="route">Pick up food or parcels　›</view><view class="muted">Someone collects it and brings it to your dorm.</view></view>
  <view class="card choice" data-mode="trip" bindtap="choose"><view class="route">Start a trip　›</view><view class="muted">Bring others’ orders back on your way.</view></view>
 </view>
 <block wx:else>
  <view class="post-header"><view class="post-tabs"><button class="post-tab {{category==='takeout'?'active':''}}" data-category="takeout" bindtap="service" disabled="{{scanBusy || categoryLocked}}">Takeaway</button><button class="post-tab {{category==='parcel'?'active':''}}" data-category="parcel" bindtap="service" disabled="{{scanBusy || categoryLocked}}">Parcels</button></view></view>

  <block wx:if="{{mode==='request' && category==='parcel'}}"><yuni-tip tip-key="parcel-post" pose="think" text="Upload your pickup screenshot or paste the SMS, and I’ll read the station and codes for you."/>
   <view class="step-card notice-card">
    <view class="step-head"><text class="step-number">1</text><text class="step-title">Add the pickup notice</text><text class="badge">{{foundCodes?foundCodes+' '+(foundCodes===1?'code':'codes')+' found':'No codes yet'}}</text></view>
    <view class="hint">Pick one. We fill in the station and the pickup codes for you.</view>
    <view class="notice-actions"><view class="notice-action" bindtap="openParcelScreenshot"><image class="action-icon" src="/assets/photo.svg"/><text class="action-title">Upload screenshot</text><text class="action-help">Pickup notice, list or SMS screenshot</text></view><view class="notice-action {{smsText?'chosen':''}}" bindtap="openSms"><image class="action-icon" src="/assets/sms.svg"/><text class="action-title">Paste the SMS</text><text class="action-help">Copy the station message, then tap</text></view></view>
    <view wx:if="{{smsEditing}}" class="sms-editor"><textarea class="field" placeholder="Paste your pickup notice here" value="{{smsText}}" data-field="smsText" bindinput="text" maxlength="1500"/><button class="btn orange" bindtap="parseSms" disabled="{{scanBusy}}" loading="{{scanBusy}}">Read pickup codes</button></view>
    <view wx:if="{{scanState}}" class="scan-status"><text>✓　{{scanState}}</text><text bindtap="clearNotice">Clear</text></view><view wx:if="{{scanError}}" class="notice-error">{{scanError}}</view>
    <view class="private-head"><text>♙　Only the runner who accepts sees these</text><text class="link" bindtap="toggleCodes">{{codeEditing?'Done':'Edit'}}</text></view>
    <view class="preview-line"><text>Station</text><text>{{pickupPoint || 'Please confirm pickup station'}}</text></view>
    <view class="preview-line"><text>Pickup address</text><text>{{pickupAddress || 'Add details if needed'}}</text></view>
    <view wx:if="{{codeEditing}}"><input class="field" placeholder="Pickup station" value="{{pickupPoint}}" data-field="pickupPoint" bindinput="text"/><input class="field" placeholder="Pickup address (optional)" value="{{pickupAddress}}" data-field="pickupAddress" bindinput="text"/></view>
    <view wx:for="{{codes}}" wx:key="index" class="preview-line"><text>Parcel {{index+1}}</text><input wx:if="{{codeEditing || !item}}" class="code-input" placeholder="Enter pickup code" value="{{item}}" data-i="{{index}}" bindinput="code"/><text wx:else class="code-value">{{item}}</text></view>
    <view class="upload-thumbs"><image wx:for="{{scanImages}}" wx:key="index" src="{{item}}" mode="aspectFill"/></view>
   </view>

   <view class="step-card"><view class="step-head"><text class="step-number dark">2</text><text class="step-title">Size of each parcel</text><text class="step-count">{{parcelCount}} / 5 boxes</text></view><view class="hint">{{parcelCount}} {{parcelCount===1?'parcel':'parcels'}} in this request. Set a size for each one.</view>
    <view class="size-options"><view wx:for="{{sizeOptions}}" wx:key="id" class="size-option {{item.count?'selected':''}}"><view class="strong">{{item.label}}</view><view class="size-weight">{{item.weight}}</view><view class="size-examples">{{item.examples}}</view><view class="row size-bottom"><text>¥{{item.price}}</text><view class="stepper"><text data-size="{{item.id}}" data-delta="-1" bindtap="sizeCount">−</text><text>{{item.count}}</text><text data-size="{{item.id}}" data-delta="1" bindtap="sizeCount">＋</text></view></view></view></view><view class="hint">Up to 5 boxes per request, so one runner can carry them in one trip.</view>
   </view>

   <view class="step-card parcel-address-section"><view class="step-head"><text class="step-number dark">3</text><text class="step-title">Deliver to</text><text wx:if="{{!firstAddress}}" class="link" bindtap="manageAddresses">Manage</text></view>
    <view class="hint">{{firstAddress?'First order: add your delivery address. You only do this once.':'Tap a saved address. Add a note for the runner below if you need to.'}}</view>
    <view wx:if="{{!firstAddress}}" class="pills"><text wx:for="{{routes}}" wx:key="id" class="pill {{routeId===item.id?'selected':''}}" data-id="{{item.id}}" bindtap="chooseAddress"><text wx:if="{{item.destinationType==='dorm'}}">⌂　</text>{{item.name}}</text><text wx:if="{{!hasDormAddress}}" class="pill link" bindtap="addDormAddress">⌂　Add my dorm</text><text class="pill link" bindtap="newAddress">＋ New address</text></view>
    <view class="soft address-card">
     <block wx:if="{{firstAddress}}"><view class="label orange-label">⌂　My dorm</view><view class="row"><view class="destination-column"><picker range="{{dorms}}" value="{{dormIndex}}" bindchange="dorm"><view class="field">{{dorms[dormIndex]}}　⌄</view></picker></view><view class="room-column"><input class="field" value="{{room}}" placeholder="Room" data-field="room" bindinput="text" maxlength="100"/></view></view></block>
     <block wx:else><view class="row"><text class="route-tag {{destinationType==='place'?'place-tag':''}}"><text wx:if="{{destinationType==='dorm'}}">⌂　</text>{{routeName}}</text><text class="link" bindtap="editAddress">Edit for this order</text></view><view class="route-line"><view class="label">Deliver to</view><view class="value">{{destinationDisplay}}</view><view class="hint">{{destinationType==='dorm'?'Your dorm':'Handed to you there'}}</view><view wx:if="{{note}}" class="hint">{{note}}</view></view></block>
     <block wx:if="{{destinationType==='dorm'}}"><view class="divider"/><view class="label">Drop-off</view><view class="pills drop-pills"><text class="pill {{dropMode==='door'?'selected':''}}" data-value="door" bindtap="dropAddress">At my door</text><text class="pill {{dropMode==='lobby'?'selected':''}}" data-value="lobby" bindtap="dropAddress">Lobby · I’ll come down</text></view><view class="hint">If the runner can’t enter your building, they leave it in the lobby and message you. A runner who lives in your building can bring it to your room.</view></block>
     <view class="divider"/><block wx:if="{{firstAddress}}"><view class="row"><view class="half"><view class="field-label">Name</view><input class="field" value="{{name}}" data-field="name" bindinput="text" placeholder="Your name"/></view><view class="half"><view class="field-label">Phone</view><input class="field" type="number" maxlength="11" value="{{phone}}" data-field="phone" bindinput="text" placeholder="11-digit number"/></view></view><view class="save-route-choice" bindtap="toggleSaveAddress"><text class="check {{saveFirstAddress?'checked':''}}">{{saveFirstAddress?'✓':''}}</text><view><view class="strong">Save as my parcel address</view><view class="hint">Next time, just tap My dorm. Manage your parcel addresses separately.</view></view></view></block>
     <view wx:else><view class="value">{{name}}</view><view class="formatted-phone">{{phoneDisplay}}</view></view><view class="hint privacy-lock"><image class="lock-icon" src="/assets/lock-outline.svg"/>Name and phone stay hidden until a runner accepts.</view>
    </view>
    <view wx:if="{{firstAddress}}" class="other-place-link" bindtap="newAddress">＋　Not going to your dorm? Add another address</view>
    <view class="field-label">Note for the runner <text class="hint">(optional)</text></view><input class="field" placeholder="e.g. one box is fragile" value="{{description}}" data-field="description" bindinput="text" maxlength="500"/>
   </view>

   <view class="step-card"><view class="step-head"><text class="step-number dark">4</text><text class="step-title">Needed by</text></view><view class="pill-row"><text class="pill {{deadlineChoice==='anytime'?'chosen':''}}" data-value="anytime" bindtap="deadlineOption">Anytime</text><text class="pill {{deadlineChoice==='before18'?'chosen':''}}" data-value="before18" bindtap="deadlineOption">Before 18:00</text><text class="pill {{deadlineChoice==='custom'?'chosen':''}}" data-value="custom" bindtap="deadlineOption">Pick a time</text></view><view wx:if="{{deadlineChoice==='custom'}}" class="row"><picker class="half" mode="date" value="{{date}}" start="{{today}}" data-field="date" bindchange="text"><view class="field">{{date}}　⌄</view></picker><picker class="half" mode="time" value="{{deadline}}" data-field="deadline" bindchange="text"><view class="field">{{deadline}}　⌄</view></picker></view></view>
   <view class="step-card"><view class="step-head"><text class="step-number tip-mark">ϟ</text><text class="step-title">Need it faster?</text><text class="badge">Optional</text></view><view class="hint">A tip goes 100% to the runner and puts your parcels higher on the job board.</view><view class="pill-row"><text wx:for="{{tipOptions}}" wx:key="*this" class="pill {{tip===item?'chosen':''}}" data-value="{{item}}" bindtap="tipOption">{{item===0?'No tip':'+¥'+item}}</text></view></view>
   <view class="step-card totals-card"><view class="row"><text>{{parcelCount}} parcels</text><text>¥{{offer}}</text></view><view class="row"><text>Service fee · ¥0.50 per parcel</text><text>¥{{fee}}</text></view><view class="hint">The service fee is shown for this preview. No payment is taken.</view><view class="coupon-block"><view class="row"><text>Coupon · {{couponTitle}}</text><text class="strong">−¥{{discount}}</text></view><view class="hint">My coupons · {{coupons.length}}</view><view wx:if="{{couponError}}" class="hint" bindtap="loadCoupons">{{couponError}} Tap to retry.</view><view wx:elif="{{!coupons.length}}" class="hint">No available coupons. Collect coupons in Rewards.</view><view class="pills"><text wx:for="{{coupons}}" wx:key="id" class="pill {{couponId===item.id?'selected':''}} {{item.usable?'':'coupon-unavailable'}}" data-id="{{item.id}}" bindtap="coupon">{{item.short}}{{item.usable?'':' · '+item.unavailableLabel}}</text><text class="pill {{!couponId?'selected':''}}" data-id="" bindtap="coupon">None</text></view><view wx:if="{{discount!=='0.00'}}" class="hint">UniEarn covers ¥{{discount}}. The runner still gets the full delivery fee.</view></view><view class="divider"></view><view class="row total-line"><text>Total</text><text>¥{{total}}</text></view><view class="scan-status">Orders sync with your team. No real payment or refund is processed.</view></view>
   
   <view class="post-footer"><view class="post-agreement" bindtap="agree"><text class="post-check {{agreed?'checked':''}}">{{agreed?'✓':''}}</text><text>I agree to the <text class="link" catchtap="agreement">platform rules and user agreement</text>.</text></view><button class="post-submit" disabled="{{!agreed || scanBusy}}" bindtap="post">Post · preview ¥{{total}}</button></view>
  </block>

  <block wx:elif="{{mode==='request'}}">
   <view class="saved-section"><view class="field-label">Saved location</view><view class="field saved" bindtap="useSaved">{{savedAddress?savedAddress.pickup+' → '+savedAddress.dorm+' · Room '+savedAddress.room:'Save your usual address in Me'}}　›</view></view>
   <input class="field description" placeholder="Describe your order (optional)" value="{{description}}" data-field="description" bindinput="text" maxlength="100"/>
   <view class="row"><view class="half"><view class="field-label">Collect from</view><picker range="{{stations}}" value="{{stationIndex}}" bindchange="station" disabled="{{categoryLocked}}"><view class="field">{{stations[stationIndex]}}　›</view></picker></view><view class="half"><view class="field-label">Deliver to</view><picker range="{{dorms}}" value="{{dormIndex}}" bindchange="dorm" disabled="{{categoryLocked}}"><view class="field">{{dorms[dormIndex]}}　›</view></picker></view></view>
   <input class="field" placeholder="Room number" value="{{room}}" data-field="room" bindinput="text"/><input class="field" placeholder="Leave at the desk (optional)" value="{{note}}" data-field="note" bindinput="text"/><text class="link tiny" bindtap="saveAddress">Save as my usual address</text>
   <view class="field-label">Phone number <text class="tiny">　Filled from your profile</text></view><view class="field phone-row"><input type="number" maxlength="11" placeholder="Enter phone number" value="{{phone}}" data-field="phone" bindinput="text" focus="{{phoneEditing}}"/><text class="link" bindtap="editPhone">Change</text></view>
   <view class="field-label">Deliver by</view><view class="row"><picker class="half" mode="date" value="{{date}}" start="{{today}}" data-field="date" bindchange="text"><view class="field">{{date===today?'Today':date}}　⌄</view></picker><picker class="half" mode="time" value="{{deadline}}" data-field="deadline" bindchange="text"><view class="field">{{deadline}}　⌄</view></picker></view>
   <view class="row bag-row"><text class="chip orange">{{small}} {{small===1?'bag':'bags'}}</text><view class="stepper"><text data-delta="-1" bindtap="count">−</text><text>{{small}}</text><text data-delta="1" bindtap="count">＋</text></view></view>
   <view class="card"><view class="strong">Only the runner who accepts sees this</view><view class="upload-row"><button class="upload-add" bindtap="orderPhoto">＋</button><view><view class="strong">Waimai order picture</view><view class="tiny">Helps the runner identify your food</view></view></view><view class="upload-row"><view wx:for="{{orderPictures}}" wx:key="index"><image class="thumb" src="{{item}}" mode="aspectFill"/><view class="link tiny" data-i="{{index}}" bindtap="removePhoto">Remove</view></view></view></view>
   <view class="card"><view class="row"><text class="strong">You offer per bag</text><text class="link money">¥{{price}}.00</text></view><slider min="2" max="20" value="{{price}}" activeColor="#b9552d" bindchange="setPrice"/><view class="row tiny"><text>¥2</text><text>¥20</text></view></view>
   <view class="agreement" bindtap="agree"><text class="tick">{{agreed?'☑':'□'}}</text><text>I have read and agree to the <text class="link" catchtap="agreement">platform rules and user agreement</text>.</text></view><button class="btn orange" disabled="{{!agreed || scanBusy}}" bindtap="post">Post · ¥{{offer}} + ¥{{fee}} service</button><view class="tiny">Local preview · no real payment</view>
  </block>
  <block wx:else><view class="row"><view class="half"><view class="field-label">Collect from</view><picker range="{{stations}}" value="{{stationIndex}}" bindchange="station"><view class="field">{{stations[stationIndex]}}　›</view></picker></view><view class="half"><view class="field-label">Deliver to</view><picker range="{{dorms}}" value="{{dormIndex}}" bindchange="dorm"><view class="field">{{dorms[dormIndex]}}　›</view></picker></view></view><view class="section">When are you going?</view><view class="row"><text class="chip {{depart==='Now'?'green':''}}" data-value="Now" bindtap="setDepart">Now</text><text class="chip {{depart==='Later today'?'green':''}}" data-value="Later today" bindtap="setDepart">Later today</text></view><view class="card row"><text>Room for</text><view class="stepper"><text data-delta="-1" bindtap="setCapacity">−</text>{{capacity}}<text data-delta="1" bindtap="setCapacity">＋</text></view></view><view class="card"><view class="strong">Waiting on this route</view><view class="route">{{waitingCount}} items · ¥{{waitingReward}}</view></view><button class="btn" bindtap="start">Start trip</button></block>
 </block>
</view>
<yuni-assistant topic=""/>
.status-card{display:flex;align-items:center;gap:28rpx;padding:26rpx 32rpx;border:2rpx dashed #c9a77f;border-radius:30rpx;background:#fff6e7;color:#30291f}
.status-stub{flex:none;display:flex;align-items:center;justify-content:center;width:110rpx;padding-right:20rpx;border-right:2rpx dashed #b99161}
.status-yuni{display:block;width:88rpx;height:100rpx}
.status-copy{min-width:0;flex:1}
.status-card .flow-title{margin:0;color:#30291f;font-size:32rpx;font-weight:700;line-height:1.4;overflow-wrap:break-word}
.status-card .hint{margin:8rpx 0 0;color:#72624e;font-size:24rpx;line-height:1.5}
.page-dark .status-card{background:#3d3326;border-color:#94795c;color:#f5e8d4}
.page-dark .status-card .flow-title{color:#f5e8d4}
.page-dark .status-card .hint{color:#d1c0a8}
.order-progress-card{padding:28rpx 18rpx 22rpx;overflow:hidden}
.order-progress-track{display:flex;align-items:flex-start;width:100%}
.order-progress-step{position:relative;flex:1;min-width:0;text-align:center;color:#8a877e}
.order-progress-step::after{position:absolute;z-index:0;content:'';top:11rpx;left:50%;width:100%;height:3rpx;background:#d9d7cf}
.order-progress-step:last-child::after{display:none}
.order-progress-dot{position:relative;z-index:1;width:24rpx;height:24rpx;margin:0 auto 12rpx;border:4rpx solid #d0cec5;border-radius:50%;background:#fff}
.order-progress-step.done::after{background:#0b7a55}
.order-progress-step.done .order-progress-dot{border-color:#0b7a55;background:#0b7a55}
.order-progress-step.current .order-progress-dot{border-color:#0b7a55;box-shadow:0 0 0 7rpx #e7f3ed}
.order-progress-step.current .order-progress-name{color:#16181c;font-weight:800}
.order-progress-name{font-size:20rpx;line-height:1.3;white-space:nowrap}
.order-progress-time{min-height:28rpx;margin-top:7rpx;color:#0b7a55;font-size:18rpx;line-height:1.2}
.offer-card{padding:28rpx}
.offer-heading{display:flex;align-items:baseline;justify-content:space-between;gap:18rpx}
.offer-heading>.strong{font-size:28rpx}
.offer-current{flex:none;color:#6b6860;font-size:22rpx}
.offer-current text{color:#0b7a55;font-size:28rpx;font-weight:850;font-family:monospace}
.offer-hint{margin:14rpx 0 18rpx}
.offer-options{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12rpx}
.offer-card button.offer-option{display:flex;align-items:center;justify-content:center;width:100%;min-width:0;height:82rpx;min-height:82rpx;margin:0;padding:0 4rpx;border:2rpx solid #9ecbb9;border-radius:18rpx;background:#f3faf6;color:#0b7a55;font-size:24rpx;font-weight:800;line-height:1}
.offer-card button.offer-option-press{transform:scale(.96);background:#e0f2e9}
.offer-footer{display:flex;align-items:center;justify-content:space-between;gap:16rpx;margin-top:20rpx;padding-top:20rpx;border-top:1rpx solid #ece9e1}
.offer-footer>.hint{flex:1;margin:0;font-size:20rpx}
.offer-card button.offer-cancel{width:auto;flex:none;min-height:58rpx;margin:0;padding:10rpx 18rpx;border:2rpx solid #b9d6ca;border-radius:15rpx;background:#fff;color:#0b7a55;font-size:21rpx;font-weight:750;line-height:1.35}
.offer-card button.offer-cancel-press{transform:scale(.97);background:#edf7f2}
.page-dark .order-progress-dot{background:#242522}
.page-dark .order-progress-step::after{background:#4a4b46}
.page-dark .order-progress-step.done::after,.page-dark .order-progress-step.done .order-progress-dot{background:#76d7b3;border-color:#76d7b3}
.page-dark .order-progress-step.current .order-progress-dot{border-color:#76d7b3;box-shadow:0 0 0 7rpx #173c31}
.page-dark .order-progress-step.current .order-progress-name{color:#f2f0e9}
.page-dark .order-progress-time,.page-dark .offer-current text{color:#76d7b3}
.page-dark .offer-card button.offer-option{background:#173c31;border-color:#3f6655;color:#76d7b3}
.page-dark .offer-footer{border-color:#41423e}
.page-dark .offer-card button.offer-cancel{background:#242522;border-color:#3f6655;color:#76d7b3}

.offer-custom{grid-column:span 2}

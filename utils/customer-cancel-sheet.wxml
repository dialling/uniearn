<template name="customerCancelSheet">
<block wx:if="{{cancelOpen}}">
<view class="sheet-shade" bindtap="backCancel"/>
<view class="flow-sheet cancel-sheet">
<view class="strong">{{zh?'为什么取消？':'Why are you cancelling?'}}</view>
<view class="hint">{{zh?'请选择一个原因。':'Choose one reason.'}}</view>
<view wx:for="{{cancelOptions}}" wx:key="value" class="soft" data-value="{{item.value}}" bindtap="chooseCancelReason">
<view>{{cancelReason===item.value?'◉':'○'}} {{item.label}}</view>
</view>
<block wx:if="{{cancelNoteOpen}}">
<view class="hint">{{zh?'补充说明（选填）':'A short note is optional.'}}</view>
<textarea class="field" maxlength="200" value="{{cancelNote}}" bindinput="cancelNoteInput" placeholder="{{zh?'补充说明（选填）':'Optional note'}}"/>
<view class="action-row">
<button class="btn outline" bindtap="backCancel" disabled="{{cancelling}}">{{zh?'返回':'Back'}}</button>
<button class="btn" disabled="{{cancelling}}" loading="{{motionEnabled && cancelling}}" bindtap="submitCancel">{{zh?'确认取消':'Confirm cancel'}}</button>
</view>
</block>
<button wx:else class="btn outline" bindtap="backCancel" disabled="{{cancelling}}">{{zh?'返回':'Back'}}</button>
</view>
</block>
</template>

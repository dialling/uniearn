/* Campus leaderboard: one reward focus, compact rows, persistent personal rank. */
.news-redesign.ranking-page{padding-bottom:430rpx}
.board{color:var(--news-ink)}
.board-heading{display:flex;align-items:center;justify-content:space-between;gap:20rpx;margin:4rpx 0 24rpx}
.board-title{font-size:37rpx;line-height:1.35;font-weight:800;flex:1;min-width:0}
.board .board-rules-button{display:flex;align-items:center;justify-content:center;gap:10rpx;flex:none;width:auto;min-height:64rpx;margin:0;padding:8rpx 0 8rpx 16rpx;background:transparent;border-radius:0;color:var(--news-muted);font-size:23rpx;line-height:1.4}
.board-rules-button text{display:flex;align-items:center;justify-content:center;width:32rpx;height:32rpx;border:2rpx solid currentColor;border-radius:50%;font-size:22rpx;font-weight:700}
.board-period{display:flex;align-items:center;justify-content:space-between;gap:16rpx;font-size:23rpx;line-height:1.5}
.board-period>text:first-child{padding:12rpx 20rpx;background:var(--news-surface);border-radius:40rpx}
.board-status{flex:none;color:var(--news-muted);font-size:22rpx}
.board-status.open{color:var(--news-accent);font-weight:700}
.board-status.scheduled{color:#b25b2e}
.board-rule-panel{padding:24rpx;margin-top:18rpx;border:1rpx solid var(--news-line);background:var(--news-surface);border-radius:20rpx}
.board-rule-panel .board-muted{margin-top:12rpx}
.board-muted{font-size:23rpx;line-height:1.6;color:var(--news-muted)}
.board-prize-hero{text-align:center;padding:42rpx 6rpx 28rpx}
.board-prize-label{color:var(--news-muted);font-size:25rpx;line-height:1.5}
.board-top-prize{font-size:46rpx;font-weight:800;line-height:1.3;color:var(--news-accent);margin:13rpx 0 10rpx;letter-spacing:-1rpx}
.board-prize-cap{font-size:24rpx;color:var(--news-muted);line-height:1.5}
.board-reward-summary{display:flex;align-items:center;justify-content:center;flex-wrap:wrap;gap:8rpx 24rpx;font-size:22rpx;line-height:1.5;margin-top:20rpx;color:var(--news-muted)}
.board-reward-link{color:var(--news-accent);font-weight:600}
.board-stats{padding:22rpx 26rpx;border-radius:22rpx;background:var(--news-surface)}
.board-stats>view{display:flex;align-items:center;justify-content:space-between;gap:20rpx}
.board-stats>view+view{margin-top:15rpx}
.board-stat-number{font-size:36rpx;font-weight:750;line-height:1.2;font-variant-numeric:tabular-nums}
.board-stat-time{font-size:26rpx;font-weight:700;font-variant-numeric:tabular-nums;text-align:right;line-height:1.4}
.board-sync-note{margin:18rpx 6rpx 0;color:#a55b34;font-size:22rpx;line-height:1.5}
.board-content{margin-top:24rpx;background:var(--news-surface);border-radius:26rpx;overflow:hidden}
.board-tabs{display:flex;gap:8rpx;padding:10rpx;margin:0 0 4rpx;border-bottom:1rpx solid var(--news-line)}
.news-redesign .board-tabs button{flex:1;min-width:0;margin:0;padding:18rpx 6rpx;background:transparent;border-radius:16rpx;font-size:25rpx;font-weight:600;line-height:1.4;color:var(--news-muted)}
.news-redesign .board-tabs button.selected{color:var(--news-accent);background:rgba(71,111,86,.1)}
.board-list-heading{padding:24rpx 26rpx 0}
.board-section-title{font-size:29rpx;font-weight:750;line-height:1.4}
.board-list-heading .board-muted{margin-top:8rpx}
.board-updated{padding:9rpx 26rpx 0;font-size:21rpx;color:var(--news-muted)}
.board-table-head{display:flex;align-items:center;gap:18rpx;margin:22rpx 26rpx 0;padding-bottom:14rpx;border-bottom:1rpx solid var(--news-line);color:var(--news-muted);font-size:21rpx;line-height:1.4}
.board-table-head>text:first-child{width:62rpx;flex:none}
.board-table-head>text:nth-child(2){flex:1}
.board-table-head>text:last-child{width:130rpx;flex:none;text-align:right}
.board-rank-row{display:flex;align-items:center;gap:18rpx;padding:23rpx 26rpx;border-bottom:1rpx solid var(--news-line)}
.board-rank-number{width:62rpx;flex:none;text-align:center;font-size:26rpx;font-weight:650;color:var(--news-muted);font-variant-numeric:tabular-nums}
.top-three .board-rank-number{color:#c2410c;font-size:32rpx;font-weight:800}
.board-rank-row.mine{background:rgba(71,111,86,.07)}
.board-student{flex:1;min-width:0}
.board-student-name{font-size:26rpx;font-weight:650;line-height:1.45;overflow-wrap:break-word}
.board-you{display:inline-block;font-size:18rpx;font-weight:500;padding:1rpx 8rpx;margin-left:10rpx;border-radius:6rpx;background:rgba(71,111,86,.1);color:var(--news-accent);vertical-align:middle}
.board-rank-reward{font-size:21rpx;line-height:1.5;color:var(--news-muted);margin-top:6rpx}
.board-score{width:130rpx;flex:none;font-size:33rpx;font-weight:750;line-height:1.3;text-align:right;font-variant-numeric:tabular-nums}
.board-empty{text-align:center;padding:28rpx 36rpx 12rpx}
.board-empty image{width:100rpx;height:116rpx;display:block;margin:0 auto 16rpx}
.board-empty-title{font-size:27rpx;font-weight:700;line-height:1.5;margin-bottom:10rpx}
.board .board-empty-action{display:inline-flex;align-items:center;justify-content:center;min-height:64rpx;margin:20rpx 0 0;padding:14rpx 26rpx;background:rgba(71,111,86,.1);color:var(--news-accent);font-size:23rpx;font-weight:650;line-height:1.5;border-radius:34rpx}
.board-footnote{padding:22rpx 26rpx;font-size:21rpx;color:var(--news-muted);line-height:1.6}
.board-task-row{display:flex;align-items:flex-start;gap:22rpx;padding:24rpx 0;margin:0 26rpx;border-bottom:1rpx solid var(--news-line)}
.board-task-copy{flex:1;min-width:0}
.board-task-copy .board-muted{margin-top:7rpx}
.board-first-label{font-size:22rpx;line-height:1.5;margin-top:9rpx;color:var(--news-accent)}
.board-task-points{display:flex;flex-direction:column;align-items:flex-end;gap:3rpx;flex:none;color:var(--news-accent);padding-top:3rpx}
.board-task-points>text:first-child{font-size:36rpx;font-weight:750;line-height:1.2}
.board-task-points>text:last-child{font-size:20rpx;line-height:1.5;color:var(--news-muted)}
.board-prize-row{display:flex;align-items:center;gap:22rpx;padding:25rpx 26rpx;border-bottom:1rpx solid var(--news-line)}
.board-prize-row.first{background:rgba(194,65,12,.04);margin-top:20rpx}
.board-prize-rank{width:136rpx;flex:none;font-size:28rpx;font-weight:750;color:var(--news-accent);font-variant-numeric:tabular-nums}
.board-prize-row.first .board-prize-rank{color:#c2410c;font-size:38rpx}
.board-prize-row>view{flex:1;min-width:0}
.board-prize-coupon{font-size:26rpx;font-weight:650;line-height:1.5}
.board-prize-row .board-student-name+.board-prize-coupon{font-size:23rpx;font-weight:500}
.board-personal{position:fixed;z-index:90;left:24rpx;right:24rpx;bottom:calc(154rpx + env(safe-area-inset-bottom));display:flex;align-items:center;gap:18rpx;padding:22rpx 24rpx;border:1rpx solid rgba(71,111,86,.2);border-radius:26rpx;background:#fffef8;box-shadow:0 5rpx 24rpx rgba(34,48,35,.07)}
.board-personal-copy{flex:1;min-width:0}
.board-personal-title{display:flex;align-items:baseline;flex-wrap:wrap;gap:5rpx 15rpx;font-size:26rpx;font-weight:750;line-height:1.4}
.board-personal-title>text{font-size:21rpx;font-weight:500;color:var(--news-accent)}
.board-personal-level{margin-top:4rpx;font-size:21rpx;color:var(--news-muted);line-height:1.5}
.board-personal-hint{margin-top:5rpx;font-size:21rpx;color:var(--news-muted);line-height:1.4}
.news-redesign .board-personal-button{flex:none;width:auto;max-width:180rpx;min-height:70rpx;margin:0;padding:17rpx 25rpx;border-radius:40rpx;background:#476f56;color:#fff;font-size:24rpx;line-height:1.4;font-weight:650}
.board button:active{opacity:.75}
.news-redesign.page-dark .board-period>text:first-child,.news-redesign.page-dark .board-stats,.news-redesign.page-dark .board-content,.news-redesign.page-dark .board-rule-panel{background:var(--news-surface)}
.news-redesign.page-dark .board-tabs button.selected,.news-redesign.page-dark .board-empty-action,.news-redesign.page-dark .board-you{background:rgba(152,190,160,.13);color:#98bea0}
.news-redesign.page-dark .board-rank-row.mine{background:rgba(152,190,160,.08)}
.news-redesign.page-dark .board-personal{background:#292c26;border-color:#4c604e}
.news-redesign.page-dark .top-three .board-rank-number,.news-redesign.page-dark .board-prize-row.first .board-prize-rank{color:#f4a06e}
.news-redesign.page-dark .board-prize-row.first{background:rgba(244,160,110,.06)}

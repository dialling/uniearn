 <view class="addr-form ad-form">
  <view class="addr-form-head ad-head"><text class="addr-title ad-title">{{orderMode?(zh?'仅修改本单':'Edit for this order'):editing?(zh?'编辑常用地址':'Edit address'):(form.destinationType==='place'?(zh?'添加其他地址':'Add another address'):(zh?'新增常用地址':'New address'))}}</text></view>
  <view wx:if="{{orderMode}}" class="addr-order-note">{{zh?'只修改这笔订单，你的常用地址保持不变。':'Only this order changes. Your saved address stays the same.'}}</view>

  <view class="addr-type-tabs ad-types" role="radiogroup">
   <view class="ad-type {{form.destinationType==='dorm'?'on':''}}" role="radio" aria-checked="{{form.destinationType==='dorm'}}" hover-class="ad-press" data-value="dorm" bindtap="chooseType"><image src="/assets/icons3d/home.svg" mode="aspectFit"/><text>{{zh?'宿舍区':'Dorms'}}</text></view>
   <view class="ad-type {{form.destinationType==='place'?'on':''}}" role="radio" aria-checked="{{form.destinationType==='place'}}" hover-class="ad-press" data-value="place" bindtap="chooseType"><image src="/assets/icons3d/map.svg" mode="aspectFit"/><text>{{zh?'其他':'Other'}}</text></view>
  </view>

  <view hidden="{{form.destinationType!=='dorm'}}" class="ad-set ad-set-dorm">
   <view class="ad-card">
    <view class="ad-card-head"><text class="ad-card-title">{{zh?'收件人':'Recipient'}}</text></view>
    <view class="ad-label">{{zh?'姓名':'Name'}}</view><input always-embed placeholder-class="ue-ph" class="ad-input" value="{{form.owner}}" data-field="owner" bindinput="field" maxlength="40" placeholder="{{zh?'如：张三':'e.g. Ming Li'}}"/>
    <view class="ad-label">{{zh?'性别':'Gender'}}</view><view class="pills ad-pills"><view class="pill dorm-male {{form.dormGender==='male'?'selected':''}}" data-value="male" bindtap="chooseGender">{{zh?'男寝':'Men’s dorms'}}</view><view class="pill dorm-female {{form.dormGender==='female'?'selected':''}}" data-value="female" bindtap="chooseGender">{{zh?'女寝':'Women’s dorms'}}</view></view>
    <view class="ad-label">{{zh?'电话':'Phone'}}</view><input always-embed placeholder-class="ue-ph" class="ad-input" type="number" maxlength="11" value="{{form.phone}}" data-field="phone" bindinput="field" placeholder="{{zh?'方便跑手联系':'So the runner can reach you'}}"/>
   </view>
   <view class="ad-card">
    <view class="ad-card-head"><text class="ad-card-title">{{zh?'送到哪里':'Where to'}}</text></view>
    <picker range="{{areaLabels}}" value="{{form.area}}" bindchange="area"><view class="ad-row {{form.area<0?'empty':''}}"><text class="ad-row-label">{{zh?'宿舍区':'Dorm area'}}</text><text class="ad-row-value">{{form.area>=0?areaLabels[form.area]:(zh?'请选择':'Choose')}}</text><view class="ad-chev"/></view></picker>
    <picker range="{{buildingLabels}}" value="{{form.building}}" bindchange="building"><view class="ad-row {{form.building<0?'empty':''}}"><text class="ad-row-label">{{zh?'楼栋':'Building'}}</text><text class="ad-row-value">{{form.building>=0?buildingLabels[form.building]:(zh?'请选择':'Choose')}}</text><view class="ad-chev"/></view></picker>
    <view class="ad-row ad-row-input"><text class="ad-row-label">{{zh?'房间号':'Room'}}</text><input always-embed placeholder-class="ue-ph" class="ad-row-field" value="{{form.room}}" data-field="room" bindinput="field" maxlength="20" placeholder="{{zh?'如：1218':'e.g. 1218'}}"/></view>
   </view>
  </view>

  <view hidden="{{form.destinationType!=='place'}}" class="ad-set ad-set-place">
   <view class="ad-card addr-place-section">
    <view class="ad-card-head"><text class="ad-card-title">{{zh?'地址信息':'Address details'}}</text></view>
    <view class="ad-sub">{{zh?'名称用于快速查找，具体位置提供给跑手。':'Use a short name for lookup and give the runner exact directions.'}}</view>
    <view class="ad-label">{{zh?'地址名称':'Address name'}}<text class="ad-note">{{zh?'简短名称':'Short label'}}</text></view>
    <input always-embed placeholder-class="ue-ph" class="ad-input ad-strong" value="{{form.name}}" data-field="name" bindinput="field" maxlength="80" placeholder="{{zh?'例如：BS楼':'e.g. BS Building'}}"/>
    <view class="ad-label">{{zh?'具体地点':'Exact location'}}<text class="ad-note">{{zh?'写清入口或门牌':'Add an entrance or room'}}</text></view>
    <textarea always-embed placeholder-class="ue-ph" class="ad-input ad-area" value="{{form.deliveryAddress}}" data-field="deliveryAddress" bindinput="field" maxlength="500" auto-height placeholder="{{zh?'例如：2楼东侧玻璃门，咖啡厅旁':'e.g. Level 2 east glass door, next to the café'}}"/>
   </view>
   <view class="ad-card addr-contact-section">
    <view class="ad-card-head"><text class="ad-card-title">{{zh?'收件信息':'Recipient details'}}</text><text class="ad-tag">{{zh?'已自动填入 · 可修改':'Filled in · Editable'}}</text></view>
    <view class="ad-sub">{{zh?'默认使用个人资料，也可以为这个地址单独修改。':'Uses your profile by default. You can change it for this address.'}}</view>
    <view class="ad-label">{{zh?'姓名':'Name'}}</view>
    <input always-embed placeholder-class="ue-ph" class="ad-input" value="{{form.owner}}" data-field="owner" bindinput="field" maxlength="40" placeholder="{{zh?'请输入收件人姓名':'Enter the recipient name'}}"/>
    <view class="ad-label">{{zh?'性别':'Gender'}}</view>
    <view class="pills ad-pills"><view class="pill dorm-male {{form.recipientGender==='male'?'selected':''}}" data-value="male" bindtap="chooseGender">{{zh?'男':'Male'}}</view><view class="pill dorm-female {{form.recipientGender==='female'?'selected':''}}" data-value="female" bindtap="chooseGender">{{zh?'女':'Female'}}</view></view>
    <view class="ad-label">{{zh?'电话':'Phone'}}</view>
    <input always-embed placeholder-class="ue-ph" class="ad-input" type="number" maxlength="11" value="{{form.phone}}" data-field="phone" bindinput="field" placeholder="{{zh?'请输入 11 位手机号':'Enter an 11-digit phone number'}}"/>
   </view>
  </view>

  <view class="ad-bottom"><button class="btn addr-save ad-save" bindtap="save" loading="{{saving}}" disabled="{{saving}}">{{orderMode?(zh?'用于这笔订单':'Use for this order'):editing?(zh?'保存修改':'Save changes'):(zh?'保存地址':'Save address')}}</button></view>
 </view>

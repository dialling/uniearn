/* Shared dimensions and typography for both pickup forms. */
.post-page{min-height:100vh;padding:0 30rpx calc(230rpx + env(safe-area-inset-bottom));background:#f1e7da;color:#3b2a20;font-size:26rpx;line-height:1.5}
.post-page .post-header{background:transparent;margin:0 -30rpx 20rpx;padding:18rpx 30rpx 22rpx;border-bottom:1rpx solid #e1e1da}
.post-page .post-tabs{display:flex;gap:0;padding:6rpx;border-radius:20rpx;background:#f1e7da}
.post-page .post-tab{display:block;flex:1;min-width:0;height:72rpx;line-height:72rpx;padding:0;margin:0;border-radius:16rpx;background:transparent;color:#85857e;font-size:26rpx;font-weight:700}
.post-page .post-tab.active{background:#8b1e2b;color:#fff}
.post-page .post-tab[disabled]{opacity:.65}
.post-page .flow-card,.post-page .step-card{width:100%;padding:24rpx;margin:0 0 20rpx;border:1rpx solid #e7d9cb;border-radius:24rpx;background:#fff}
.post-page .flow-head,.post-page .step-head{display:flex;align-items:center;gap:12rpx;min-height:40rpx;margin:0 0 12rpx;font-size:28rpx;font-weight:750;line-height:1.35}
.post-page .step-title{flex:1;min-width:0;font-size:28rpx;font-weight:750}
.post-page .flow-head .link,.post-page .step-head .link{flex:none;margin-left:auto;font-size:23rpx;font-weight:600}
.post-page .flow-head .badge,.post-page .step-head .badge,.post-page .step-count{flex:none;margin-left:auto;font-size:20rpx;font-weight:400}
.post-page .step,.post-page .step-number{display:inline-flex;align-items:center;justify-content:center;flex:none;min-width:40rpx;width:40rpx;height:40rpx;line-height:40rpx;border-radius:9rpx;background:#8b1e2b;color:#fff;font-size:23rpx;font-weight:750}
.post-page .step.dark,.post-page .step-number.dark{background:#2e211a}
.post-page .hint,.post-page .tiny{font-size:23rpx;color:#8a7768;line-height:1.5;margin:8rpx 0}
.post-page .strong{font-size:26rpx;font-weight:700}
.post-page .link{color:#8b1e2b;font-size:24rpx}
.post-page .badge{display:inline-block;padding:5rpx 10rpx;margin:0;background:#f5ede3;border-radius:9rpx;color:#8a7768;font-size:20rpx;font-weight:400;line-height:1.4}
.post-page .row{display:flex;align-items:center;justify-content:space-between;gap:14rpx;min-width:0;line-height:1.5}
.post-page .half{width:calc(50% - 7rpx);min-width:0}
.post-page .pills,.post-page .address-chips,.post-page .pill-row{display:flex;flex-wrap:wrap;gap:12rpx;margin:18rpx 0}
.post-page .pill,.post-page .address-chip{display:inline-block;padding:12rpx 20rpx;min-height:60rpx;border:1rpx solid #e7d9cb;border-radius:40rpx;background:#fff;color:#393a36;font-size:24rpx;line-height:1.5}
.post-page .pill.selected,.post-page .pill.chosen,.post-page .address-chip.chosen{background:#8b1e2b;border-color:#8b1e2b;color:#fff;font-weight:600}
.post-page .pill.link,.post-page .address-chip.new{color:#8b1e2b;border-style:dashed}
.post-page .soft,.post-page .delivery-box{padding:20rpx;margin:18rpx 0;background:#f8f2e9;border-radius:18rpx}
.post-page .field{display:block;box-sizing:border-box;width:100%;min-height:80rpx;margin:12rpx 0;padding:18rpx;border:1rpx solid #e1e0da;border-radius:16rpx;background:#fff;color:#3b2a20;font-size:26rpx;line-height:1.5;font-weight:400}
.post-page input.field{height:80rpx}
.post-page textarea.field{height:180rpx}
.post-page .field-label{font-size:24rpx;font-weight:600;margin:18rpx 0 6rpx}
.post-page .value,.post-page .delivery-label{font-size:27rpx;font-weight:700;line-height:1.5}
.post-page .label{font-size:21rpx;color:#8d8b82;text-transform:uppercase;margin:10rpx 0}
.post-page .divider{height:1rpx;background:#e7e6df;margin:18rpx 0}
.post-page .stepper{display:flex;flex:none;align-items:center;gap:10rpx;margin:0;padding:6rpx 10rpx;height:56rpx;border:1rpx solid #deddd7;border-radius:36rpx;background:#fff}
.post-page .stepper text{display:inline-block;min-width:32rpx;height:42rpx;line-height:42rpx;text-align:center;font-size:27rpx}
.post-page .stepper text:nth-child(2){color:#8b1e2b;font-weight:750}
.post-page .check,.post-page .post-check{display:inline-flex;align-items:center;justify-content:center;flex:none;width:32rpx;height:32rpx;border:2rpx solid #a8a89e;border-radius:5rpx;background:#fff;font-size:24rpx;line-height:1}
.post-page .check.checked,.post-page .post-check.checked{background:#8b1e2b;color:#fff;border-color:#8b1e2b}
.post-page .green-note,.post-page .scan-status{padding:18rpx;margin:18rpx 0 0;background:#e8f1ea;color:#3f7a52;border-radius:16rpx;font-size:23rpx;line-height:1.5}
.post-page .totals-card .row{font-size:26rpx;margin:12rpx 0;color:#62635e}
.post-page .totals-card .row text:last-child{color:#3b2a20;font-weight:700;white-space:nowrap}
.post-page .totals-card .total-line{font-size:28rpx;font-weight:750;color:#3b2a20;margin:16rpx 0}
.post-page .total-line text:last-child{font-size:36rpx}
.post-page .btn{display:block;width:100%;min-height:80rpx;padding:18rpx;margin:16rpx 0 0;border-radius:18rpx;background:#8b1e2b;color:#fff;font-size:26rpx;line-height:1.5;font-weight:700}
.post-page .btn.outline{background:white;border:1rpx solid #deddd7;color:#8b1e2b}
.post-page .post-footer{position:fixed;left:0;right:0;bottom:0;z-index:20;padding:16rpx 30rpx calc(18rpx + env(safe-area-inset-bottom));border-top:1rpx solid #e1e0da;background:#fff}
.post-page .post-agreement{display:flex;align-items:flex-start;gap:12rpx;margin:0 0 14rpx;font-size:22rpx;line-height:1.5;color:#62635e}
.post-page .post-agreement .link{font-size:22rpx}
.post-page .post-submit{display:block;width:100%;height:88rpx;line-height:88rpx;padding:0 16rpx;margin:0;background:#8b1e2b;color:#fff;border-radius:20rpx;font-size:27rpx;font-weight:700;white-space:nowrap}
.post-page .post-submit[disabled]{background:#e5e3dd;color:#92928b;opacity:1}

/* Visual refresh shared by the takeaway and parcel forms. */
.ue-ph{color:#b3b1a9;font-weight:400}
.post-page .flow-card,.post-page .step-card{padding:28rpx 26rpx;border:0;border-radius:28rpx;box-shadow:0 6rpx 24rpx rgba(60,48,36,.06)}
.post-page .flow-head,.post-page .step-head{margin-bottom:16rpx;font-size:30rpx}
.post-page .field{border:2rpx solid transparent;border-radius:18rpx;background:#f6f5f1;transition:background .2s ease,border-color .2s ease}
.post-page .soft,.post-page .delivery-box{background:#f8f7f3;border-radius:22rpx}
.post-page .pill,.post-page .address-chip{padding:12rpx 26rpx;border:2rpx solid transparent;background:#f3f2ee;color:#4a4a45;font-weight:600;transition:background .2s ease,color .2s ease,transform .15s ease,box-shadow .2s ease}
.post-page .pill:active,.post-page .address-chip:active{transform:scale(.95)}
.post-page .pill.selected,.post-page .pill.chosen,.post-page .address-chip.chosen{box-shadow:0 6rpx 16rpx rgba(139,30,43,.25)}
.post-page .pill.link,.post-page .address-chip.new{background:#fff;border-color:#e2c7b7}
.post-page .stepper{border:0;background:#f3f2ee}
.page-dark .ue-ph{color:#7f8a83}.page-dark.post-page .field{background:#232926!important;color:#edf1ed}.page-dark.post-page .flow-card,.page-dark.post-page .step-card{box-shadow:none}
/* Inputs: no vertical padding, otherwise the native caret and the placeholder sit on different lines. */
.post-page input.field,.post-page .code-input{box-sizing:border-box;height:88rpx;min-height:88rpx;padding-top:0;padding-bottom:0;line-height:normal}
.post-page input.field{padding:0 24rpx}
.post-page .ue-select{display:flex!important;align-items:center;justify-content:space-between;gap:12rpx;min-height:88rpx;padding:0 24rpx;text-align:left}
.post-page .ue-select-text{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.post-page .ue-chev{flex:none;width:14rpx;height:14rpx;margin:-8rpx 4rpx 0 0;border-right:3rpx solid #a9a8a1;border-bottom:3rpx solid #a9a8a1;transform:rotate(45deg)}
.post-page .empty .ue-select-text{color:#b3b1a9}

.coupon-head{margin-top:18rpx}.coupon-save{color:#8b1e2b;font-size:28rpx;font-weight:800}
.coupon-scroll{margin:14rpx -26rpx 0;width:auto;white-space:nowrap}.coupon-track{display:inline-flex;gap:16rpx;padding:4rpx 26rpx 10rpx}
.coupon-chip{position:relative;display:inline-flex;flex-direction:column;justify-content:center;min-width:180rpx;height:112rpx;padding:0 26rpx;box-sizing:border-box;border:2rpx dashed #e2c7b7;border-radius:20rpx;background:#fffaf6;transition:border-color .2s ease,background .2s ease,box-shadow .2s ease,transform .15s ease}
.coupon-chip:active{transform:scale(.96)}.coupon-chip.on{border-style:solid;border-color:#8b1e2b;background:#fdf2f0;box-shadow:0 8rpx 20rpx rgba(139,30,43,.16)}.coupon-chip.off{opacity:.45}
.coupon-chip.none{min-width:140rpx;align-items:center;border-color:#e3e1da;background:#faf9f6}.coupon-chip.none.on{border-color:#8b1e2b;background:#fdf2f0}
.coupon-amt{color:#8b1e2b;font-size:32rpx;font-weight:800;line-height:1.2}.coupon-name{margin-top:4rpx;color:#5e5d57;font-size:22rpx}
.coupon-tick{position:absolute;top:-2rpx;right:-2rpx;width:36rpx;height:36rpx;line-height:36rpx;text-align:center;border-radius:0 20rpx 0 16rpx;background:#8b1e2b;color:#fff;font-size:19rpx;opacity:0;transform:scale(.6);transition:opacity .2s,transform .25s cubic-bezier(.3,1.5,.5,1)}.coupon-chip.on .coupon-tick{opacity:1;transform:scale(1)}
.coupon-auto{color:#41775b!important}
.page-dark .coupon-chip{background:#2c332f;border-color:#465149}.page-dark .coupon-chip.on{background:#3a332d;border-color:#c25a66}.page-dark .coupon-name{color:#c3c9c4}
.coupon-row{display:flex;align-items:center;justify-content:space-between;margin:18rpx -12rpx 0;padding:18rpx 12rpx;border-radius:16rpx;transition:background .15s}.coupon-row-press{background:#f6f5f1}
.coupon-row-right{display:flex;align-items:center;gap:12rpx;min-width:0}.coupon-row-name{padding:4rpx 12rpx;border-radius:8rpx;background:#fdf2f0;color:#8b1e2b;font-size:22rpx;font-weight:650;max-width:260rpx;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.coupon-row-right .hint{margin:0}.coupon-arrow{color:#b3b1a9;font-size:34rpx;line-height:1}
.page-dark .coupon-row-press{background:#2c332f}.page-dark .coupon-row-name{background:#3a332d}

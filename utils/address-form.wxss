@import "./dorm-gender.wxss";
@import "./post-form.wxss";
.addr-page{padding-top:24rpx;padding-bottom:40rpx}
.addr-form{padding:30rpx 28rpx!important;border-radius:28rpx!important}
.addr-form-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:6rpx}.addr-title{font-size:34rpx;font-weight:800;letter-spacing:-.5rpx}
.addr-type-tabs{margin:24rpx 0 18rpx}
.addr-order-note{margin:18rpx 0 8rpx;padding:18rpx 20rpx;border-radius:18rpx;background:#fff1e6;color:#a33b15;font-size:22rpx;line-height:1.5}
.addr-page .addr-location{box-sizing:border-box;height:154rpx;min-height:154rpx;padding:22rpx;line-height:1.6}
.addr-page .field-label{margin:22rpx 0 10rpx;font-size:24rpx;color:#6b6860;font-weight:600}
.addr-page .field{box-sizing:border-box;background:#f7f6f2;border:2rpx solid transparent;border-radius:18rpx;transition:var(--ue-transition,border-color .2s,background .2s)}
.addr-section{margin-top:18rpx;padding:24rpx 22rpx 26rpx;border:2rpx solid #ebe8df;border-radius:24rpx;background:#fff}
.addr-place-section{margin-top:10rpx}.addr-contact-section{margin-top:20rpx;background:#fcfbf8}
.addr-section-head{display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:6rpx}
.addr-section-title{color:#1d1f22;font-size:28rpx;font-weight:800;line-height:1.35}
.addr-section-sub{margin-top:6rpx;color:#8a877e;font-size:21rpx;line-height:1.5}
.addr-page .addr-field-label{display:flex;align-items:center;margin-top:20rpx}
.addr-label-note{margin-left:auto;color:#9a968d;font-size:20rpx;font-weight:400}
.addr-auto-tag{display:inline-block;margin-left:12rpx;padding:4rpx 10rpx;border-radius:10rpx;background:#e7f5ef;color:#0b7a55;font-size:19rpx;font-weight:650;vertical-align:middle}
.addr-name-input{font-weight:650}
.addr-recipient-gender{margin-top:0}.addr-recipient-gender .pill{min-width:104rpx}
.page-dark .addr-section{background:#1f201e;border-color:#3a3b37}.page-dark .addr-contact-section{background:#242522}.page-dark .addr-section-title{color:#edebe4}.page-dark .addr-auto-tag{background:#173c31;color:#75d7b5}
.page-dark .addr-order-note{background:#3a2416;color:#f4a06e}

.addr-save{margin-top:28rpx!important;transition:var(--ue-transition,transform .15s)}.addr-save:active{transform:scale(.98)}

/* 2026-11-15 redesign: same card family as Start a trip / Post a task. Takeaway orange stays the accent. */
.addr-page{padding:28rpx 32rpx calc(200rpx + env(safe-area-inset-bottom));background:#eeede8}
.ad-head{margin:0 4rpx 22rpx}
.ad-title{font-size:44rpx;font-weight:800;letter-spacing:-.6rpx;color:#16181c}
.ad-types{display:flex;gap:16rpx;margin:0 0 24rpx}
.ad-type{flex:1;min-width:0;display:flex;align-items:center;justify-content:center;gap:12rpx;padding:20rpx 12rpx;background:#fff;border-radius:30rpx;border:3rpx solid transparent;font-size:27rpx;font-weight:700;color:#4c5148;box-shadow:0 6rpx 0 #e2e0d9}
.ad-type image{width:60rpx;height:60rpx;flex:none}
.ad-type.on{border-color:#c2410c;background:#fff8f3;color:#9a3412;box-shadow:0 6rpx 0 #f2d0bb}
.ad-press{transform:translateY(4rpx)}
.ad-card{background:#fff;border-radius:40rpx;padding:30rpx 28rpx;margin-bottom:24rpx}
.ad-card-head{display:flex;align-items:center;gap:14rpx}
.ad-card-title{font-size:30rpx;font-weight:800;color:#16181c}
.ad-tag{padding:4rpx 14rpx;border-radius:99rpx;background:#eef6f1;color:#26624a;font-size:20rpx;font-weight:700}
.ad-sub{margin-top:6rpx;font-size:23rpx;line-height:1.5;color:#7a776e}
.ad-label{display:flex;align-items:center;margin:26rpx 0 10rpx;font-size:25rpx;font-weight:700;color:#4c5148}
.ad-note{margin-left:auto;font-size:22rpx;font-weight:500;color:#9a978d}
.ad-input{box-sizing:border-box;width:100%;min-height:88rpx;padding:22rpx 24rpx;border-radius:22rpx;background:#f6f5f1;font-size:28rpx;line-height:1.4;color:#16181c}
.ad-strong{font-weight:700}
.ad-area{min-height:150rpx}
.ad-pills{display:flex;gap:14rpx;margin:0}
.ad-pills .pill{flex:1;text-align:center;padding:18rpx 10rpx;border-radius:22rpx;font-size:26rpx;font-weight:700;margin:0}
.ad-row{display:flex;align-items:center;gap:16rpx;margin-top:12rpx;padding:22rpx 24rpx;border-radius:22rpx;background:#f6f5f1;font-size:27rpx}
.ad-card-head + picker .ad-row{margin-top:20rpx}
.ad-row-label{flex:none;color:#6b6860;min-width:130rpx}
.ad-row-value{flex:1;min-width:0;text-align:right;font-weight:800;color:#16181c;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.ad-row.empty .ad-row-value{color:#a9a69b;font-weight:600}
.ad-row-field{flex:1;min-width:0;text-align:right;font-size:28rpx;font-weight:800;color:#16181c}
.ad-chev{flex:none;width:14rpx;height:14rpx;border-right:4rpx solid #a9a69b;border-bottom:4rpx solid #a9a69b;transform:translateY(-4rpx) rotate(45deg)}
.ad-bottom{position:fixed;left:0;right:0;bottom:0;z-index:20;background:#fff;border-top:1rpx solid #e2e0d9;padding:18rpx 32rpx calc(22rpx + env(safe-area-inset-bottom));box-shadow:0 -6rpx 24rpx #0000000d}
.ad-bottom .btn.ad-save{display:block;width:100%;margin:0!important;min-height:96rpx;border-radius:28rpx;font-size:29rpx;font-weight:800;background:#c2410c;color:#fff;box-shadow:0 8rpx 0 #9a3412}
.page-dark.addr-page{background:#1b1d1a}
.page-dark .ad-card,.page-dark .ad-type{background:#252a28;box-shadow:none}
.page-dark .ad-input,.page-dark .ad-row{background:#30362f;color:#f0f2ee}
.page-dark .ad-title,.page-dark .ad-card-title,.page-dark .ad-row-value,.page-dark .ad-row-field{color:#f0f2ee}

/* The whole Room row is the input, so a tap anywhere on it starts typing. */
.ad-row.ad-row-input{position:relative;min-height:88rpx}
.ad-row-input .ad-row-label{position:relative;z-index:0;pointer-events:none}
.ad-row-input .ad-row-field{position:absolute;left:0;top:0;right:0;bottom:0;z-index:1;height:auto;padding:0 24rpx 0 180rpx;box-sizing:border-box}

/* Both address types stay on the page; the one not chosen is hidden (reliable switching both ways). */
.ad-set[hidden]{display:none}

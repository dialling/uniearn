.contact-identity{display:flex;align-items:center;gap:16rpx;flex:1;min-width:0}
.contact-avatar{position:relative;flex:none;width:76rpx;height:76rpx;border-radius:50%;overflow:hidden;display:flex;align-items:center;justify-content:center;background:#e7f3ed;color:#0b7152;font-weight:700}
.contact-avatar image{position:absolute;width:100%;height:100%;left:0;top:0}
.contact-copy{min-width:0}.contact-name{font-size:30rpx;font-weight:700;overflow-wrap:anywhere}

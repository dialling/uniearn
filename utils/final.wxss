ion:fixed;top:28%;left:32rpx;right:32rpx;background:white;border-radius:30rpx;padding:32rpx;z-index:91}.guide-modal .guide-body{display:flex;gap:22rpx;margin:30rpx 0}.guide-modal image{width:95rpx;height:110rpx;flex:none}.guide-modal .guide-title{font-size:30rpx;font-weight:750;margin:12rpx 0}.guide-modal .guide-text{color:#555850;line-height:1.7;font-size:27rpx}.guide-modal .link{display:block;text-align:right}.guide-modal .btn{margin-bottom:0}.guide-focus{position:fixed;border-radius:25rpx;border:4rpx solid white;box-shadow:0 0 0 2000rpx #0009;z-index:90;pointer-events:none}.guide-modal.bottom-modal{top:auto;bottom:190rpx} 

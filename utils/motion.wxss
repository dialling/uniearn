/* Shared motion and interaction polish. Colours and artwork stay as defined elsewhere.
   Animations use fill-mode "backwards" so no transform remains after they finish:
   a lingering transform on an ancestor would break position:fixed children (nav, bottom bars). */
@keyframes ue-rise{from{opacity:0;transform:translate3d(0,28rpx,0)}to{opacity:1;transform:translate3d(0,0,0)}}
@keyframes ue-fade{from{opacity:0}to{opacity:1}}
@keyframes ue-drop{from{opacity:0;transform:translate3d(0,-14rpx,0)}to{opacity:1;transform:translate3d(0,0,0)}}
@keyframes ue-sheet{from{transform:translate3d(0,100%,0)}to{transform:translate3d(0,0,0)}}
@keyframes ue-pop{0%{opacity:0;transform:scale(.9)}70%{opacity:1;transform:scale(1.02)}100%{opacity:1;transform:scale(1)}}
@keyframes ue-float{0%,100%{transform:translate3d(0,0,0)}50%{transform:translate3d(0,-8rpx,0)}}

page{-webkit-font-smoothing:antialiased;-webkit-tap-highlight-color:transparent}
::-webkit-scrollbar{width:0;height:0;color:transparent}

/* Page entry: content is painted on the first frame and only settles slightly.
   Starting from opacity 0 would add a visible blank gap on top of the page switch itself. */
@keyframes ue-settle{from{opacity:.55;transform:translate3d(0,14rpx,0)}to{opacity:1;transform:translate3d(0,0,0)}}
.flow-card,.card,.address-nudge,.done-proof{animation:ue-settle .28s cubic-bezier(.22,.8,.3,1) backwards}
.flow-card:nth-child(n+3),.card:nth-child(n+3){animation-delay:.03s}
.flow-card:nth-child(n+5),.card:nth-child(n+5){animation-delay:.06s}

/* Overlays and sheets. */
.sheet-shade,.guide-shade{animation:ue-fade .22s ease-out backwards}
.flow-sheet{animation:ue-sheet .34s cubic-bezier(.2,.9,.3,1) backwards}
.filter-panel{animation:ue-drop .26s ease-out backwards}
.selectable-order{animation:ue-rise .3s ease-out backwards}
.selectable-order:nth-child(2){animation-delay:.03s}.selectable-order:nth-child(3){animation-delay:.06s}.selectable-order:nth-child(n+4){animation-delay:.09s}
.notice-error,.green-note,.orange-note{animation:ue-fade .3s ease-out backwards}

/* Gentle idle motion for mascot artwork (artwork itself is unchanged). */
.empty-yuni{animation:ue-float 3.2s ease-in-out .3s infinite}

/* Press feedback and state transitions. */
button{transition:transform .16s ease,opacity .16s ease,background-color .2s ease,color .2s ease}
button.button-hover{transform:scale(.97)}
.ue-press{transform:scale(.97);opacity:.86}
.final-tabs view,.final-tabs text,.service-tab,.pill,.filter-trigger,.order-toggle,.menu-row,.sheet-choice,.address-nudge{transition:transform .16s ease,opacity .16s ease,background-color .22s ease,color .22s ease,box-shadow .22s ease,border-color .22s ease}
.order-check{transition:background-color .2s ease,border-color .2s ease,transform .2s ease}
.order-check.checked{animation:ue-pop .3s cubic-bezier(.3,1.5,.5,1)}
.progress-fill{transition:width .5s cubic-bezier(.22,.8,.3,1)}

/* Liquid-glass segmented control. A single thumb slides under the tabs; its inner blob is
   re-mounted on every change (wx:key) so the squash-and-stretch keyframes replay. */
@keyframes glass-liquid{0%{transform:scale(1,1)}28%{transform:scale(1.16,.88)}55%{transform:scale(.96,1.05)}78%{transform:scale(1.02,.99)}100%{transform:scale(1,1)}}
@keyframes glass-shine{0%{opacity:0;transform:translate3d(-60%,0,0)}35%{opacity:.9}100%{opacity:0;transform:translate3d(60%,0,0)}}
.final-tabs.glass,.service-tabs.glass{position:relative;overflow:hidden;box-shadow:inset 0 1rpx 4rpx rgba(0,0,0,.06)}
.service-tabs.glass{gap:0}
.final-tabs.glass view,.final-tabs.glass text,.service-tabs.glass .service-tab{position:relative;z-index:1;background:transparent;box-shadow:none;transition:color .3s ease,transform .3s cubic-bezier(.34,1.5,.55,1)}
.final-tabs.glass .active,.service-tabs.glass .service-tab.active{background:transparent;box-shadow:none;transform:scale(1.04)}
.final-tabs.glass .glass-thumb,.service-tabs.glass .glass-thumb{position:absolute;z-index:0;left:5rpx;top:5rpx;bottom:5rpx;padding:0;flex:none;transition:transform .5s cubic-bezier(.34,1.18,.5,1);will-change:transform}
.glass-thumb.of-2{width:calc((100% - 10rpx) / 2)}
.glass-thumb.of-3{width:calc((100% - 10rpx) / 3)}
.final-tabs.glass .glass-blob,.service-tabs.glass .glass-blob{position:absolute;left:0;top:0;right:0;bottom:0;padding:0;border-radius:19rpx;overflow:hidden;
 background:linear-gradient(180deg,rgba(255,255,255,.95) 0%,rgba(255,255,255,.72) 55%,rgba(255,255,255,.86) 100%);
 -webkit-backdrop-filter:blur(12px) saturate(180%);backdrop-filter:blur(12px) saturate(180%);
 border:1rpx solid rgba(255,255,255,.9);
 box-shadow:0 6rpx 18rpx rgba(0,0,0,.08),0 1rpx 3rpx rgba(0,0,0,.06),inset 0 2rpx 1rpx rgba(255,255,255,1),inset 0 -4rpx 8rpx rgba(0,0,0,.035);
 animation:glass-liquid .6s cubic-bezier(.3,.9,.4,1)}
.glass-blob::before{content:'';position:absolute;left:8%;right:8%;top:6%;height:44%;border-radius:16rpx;background:linear-gradient(180deg,rgba(255,255,255,.95),rgba(255,255,255,0))}
.glass-blob::after{content:'';position:absolute;top:0;bottom:0;left:0;right:0;background:linear-gradient(105deg,rgba(255,255,255,0) 30%,rgba(255,255,255,.85) 50%,rgba(255,255,255,0) 70%);opacity:0;animation:glass-shine .7s ease-out .05s}
.glass-press{transform:scale(.94)}

/* Depth: a soft neutral shadow under cards keeps the existing palette. */
.flow-card,.card{box-shadow:0 2rpx 14rpx rgba(0,0,0,.035)}

@media (prefers-reduced-motion:reduce){
 .flow-card,.card,.flow-sheet,.filter-panel,.selectable-order,.empty-yuni,.address-nudge,.done-proof,.glass-blob,.glass-blob::after{animation:none}
}
